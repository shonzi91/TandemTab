<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>


  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="9.0.19" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FinApp.Domain\FinApp.Domain.csproj" />
    <ProjectReference Include="..\FinApp.Contracts\FinApp.Contracts.csproj" />
    <!-- Direct references (not just transitive via Domain): the pure forecast math and the Money value type must
         keep shipping to the WASM bundle after FinApp.Domain is dropped from the client (Path B, docs/DOMAIN-REMOVAL.md). -->
    <ProjectReference Include="..\FinApp.Forecasting\FinApp.Forecasting.csproj" />
    <ProjectReference Include="..\FinApp.Kernel\FinApp.Kernel.csproj" />
  </ItemGroup>

</Project>
