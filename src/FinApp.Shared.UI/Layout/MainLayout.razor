@inherits LayoutComponentBase
@implements IDisposable
@inject AuthState Auth
@inject BudgetingState State
@inject Localizer Loc
@inject FinAppApiClient Api
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject PlanGate Gate

<IconSprite />
<div class="app-shell">
    @if (Auth.IsAuthenticated)
    {
        <header class="app-bar">
            @* The Pro mark only appears once monetization is live AND the account is actually Pro — during beta
               the flag is off and every account reads "unlimited", which deliberately does NOT earn a crown.
               Badging everyone would make the mark meaningless the day it starts meaning something. *@
            <span class="brand"><span class="brand-logo"><TandemLogo Pro="@IsPro" /></span><span class="brand-word">Tandem<span class="brand-tab">Tab</span></span>@if (IsPro) { <span class="brand-pro" title="@Loc["You’re on Pro"]">@Loc["Pro"]</span> }</span>
            <span class="appbar-user">
                <LanguagePicker />
                @* Admin lives in its own door, not buried in profile settings. Only rendered for an admin; the
                   server re-checks the allowlist on every admin endpoint, so this button is convenience, not the gate. *@
                @if (Auth.CurrentUser?.IsAdmin == true)
                {
                    <button class="appbar-admin" title="@Loc["Admin console"]" aria-label="@Loc["Admin console"]" @onclick="OpenAdmin"><Icon Name="shield" /></button>
                }
                <span class="appbar-id">
                    <button class="avatar" title="@Loc["Profile settings"]" @onclick="OpenProfile">
                        @if (Auth.CurrentUser?.Avatar is { } pic)
                        {
                            <img src="@pic" alt="" />
                        }
                        else
                        {
                            <span>@Initial</span>
                        }
                    </button>
                    <button class="user" title="@Loc["Profile settings"]" @onclick="OpenProfile">@Loc["Hello,"] @Auth.CurrentUser!.Username</button>
                </span>
            </span>
        </header>
    }
    <main class="app-body">
        @if (!_restored)
        {
            <div class="loading"><Spinner Block="true" Text="@Loc["Loading…"]" /></div>
        }
        else if (!Auth.IsAuthenticated)
        {
            <Landing />
        }
        else if (_loginConsent == false)
        {
            <div class="consent-gate">
                <div class="consent-card">
                    <h2>@Loc["Before you start"]</h2>
                    <p>@Loc["To use TandemTab, please review and accept our terms."]</p>
                    <p class="consent-links">
                        <a href="@PrivacyUrl" target="_blank" rel="noopener">@Loc["Privacy"]</a> ·
                        <a href="@TermsUrl" target="_blank" rel="noopener">@Loc["Terms"]</a>
                    </p>
                    <label class="check"><input type="checkbox" @bind="_consentChecked" /> @Loc["I have read and accept the Terms of Service and Privacy Policy."]</label>
                    <button class="primary" @onclick="AcceptLoginConsent" disabled="@(!_consentChecked || _consentBusy)">@Loc["Accept & continue"]</button>
                </div>
            </div>
        }
        else if (Auth.CurrentUser?.DeletionPending == true)
        {
            <div class="consent-gate">
                <div class="consent-card">
                    <h2>@Loc["Your account is scheduled for deletion"]</h2>
                    <p>@string.Format(Loc["It will be permanently deleted on {0}. Until then you can keep it and carry on where you left off."], Auth.CurrentUser!.PendingDeletionAt!.Value.LocalDateTime.ToString("dd MMM yyyy"))</p>
                    @if (_deleteError is not null)
                    {
                        <div class="pm-msg pm-error">@_deleteError</div>
                    }
                    <div class="pm-actions">
                        <button class="primary" @onclick="KeepAccount" disabled="@_deleteBusy">@Loc["Keep my account"]</button>
                        <button class="ghost" @onclick="SignOut">@Loc["Sign out"]</button>
                    </div>
                </div>
            </div>
        }
        else
        {
            @Body
        }
    </main>

    @if (_restored)
    {
        @* In-app footer. Feedback used to be reachable only by opening the profile modal and scrolling to it —
           effectively invisible, which is a poor way to run a beta whose whole point is hearing from people. It
           sits here in the open instead, and RETIRES for good once someone has sent something: continuing to ask
           a person who already answered is nagging, not listening. The "sent" flag is local to the device
           (localStorage) — deliberately not a server round-trip on every load for a cosmetic prompt. *@
        @if (Auth.IsAuthenticated && !_feedbackDone)
        {
            <div class="app-fb">
                @if (!_feedbackOpen)
                {
                    <button class="app-fb-open" @onclick="() => _feedbackOpen = true">
                        <Icon Name="note" /> @Loc["We’re in beta — tell us what you think"]
                    </button>
                }
                else
                {
                    <div class="app-fb-card">
                        <div class="app-fb-head">
                            <h4>@Loc["We’re in beta — tell us what you think"]</h4>
                            <button class="app-fb-x" title="@Loc["Close"]" aria-label="@Loc["Close"]"
                                    @onclick="() => _feedbackOpen = false"><span aria-hidden="true">×</span></button>
                        </div>
                        <FeedbackForm Source="app" OnSent="MarkFeedbackDone" />
                    </div>
                }
            </div>
        }
        <footer class="app-legal">
            @* A labelled "Contact" opening the shared card, rather than a bare mailto: — the same shape as the
               landing footer, so reaching a human looks identical signed in or out. *@
            <button class="app-legal-link" @onclick="() => _contactOpen = true">@Loc["Contact"]</button>
            <span>·</span>
            <a href="@PrivacyUrl" target="_blank" rel="noopener">@Loc["Privacy"]</a>
            <span>·</span>
            <a href="@TermsUrl" target="_blank" rel="noopener">@Loc["Terms"]</a>
        </footer>
    }

    @if (_contactOpen)
    {
        <div class="pm-backdrop" @onclick="() => _contactOpen = false">
            <div class="pm" @onclick:stopPropagation="true">
                <h3>@Loc["Contact"]</h3>
                <ContactCard />
                <div class="pm-actions">
                    <button class="ghost" @onclick="() => _contactOpen = false">@Loc["Close"]</button>
                </div>
            </div>
        </div>
    }

    @* The upgrade prompt (P4). Raised BY A GATE, never shown on arrival — see PlanGate for why the ask belongs at
       the moment someone reaches for the feature. Names the specific blocked capability so it reads as an
       explanation of what just happened, not an ad. *@
    @if (_gateBlocked is { } gk)
    {
        @* Uses the profile modal's own shell (.pm-backdrop/.pm) rather than Dashboard's .modal — those base styles
           are scoped to Dashboard.razor.css and simply do not reach this component, so a .modal here would render
           as an unstyled block. *@
        <div class="pm-backdrop" @onclick="() => _gateBlocked = null">
            <div class="pm" @onclick:stopPropagation="true">
                <h3><span class="upg-crown" aria-hidden="true">👑</span> @Loc["That one’s part of Pro"]</h3>
                <p class="upg-feat">@FeatureLabel(gk)</p>
                <p class="pm-hint">@Loc["Everything you already use stays free. Pro adds sharing, unlimited imports, the payoff planner and your full history."]</p>
                @if (Gate.Plans is { } gp)
                {
                    <div class="pm-cycle" role="group" aria-label="@Loc["Billing period"]">
                        <button type="button" class="@(_cycle == BillingInterval.Annual ? "on" : "")" @onclick="() => _cycle = BillingInterval.Annual">
                            @Loc["Yearly"] <strong>@gp.Currency @gp.AnnualPrice</strong>
                        </button>
                        <button type="button" class="@(_cycle == BillingInterval.Monthly ? "on" : "")" @onclick="() => _cycle = BillingInterval.Monthly">
                            @Loc["Monthly"] <strong>@gp.Currency @gp.MonthlyPrice</strong>
                        </button>
                    </div>
                    @if (gp.PaymentSandbox)
                    {
                        <p class="pm-hint">@Loc["Test mode — no card is charged and no real payment is taken."]</p>
                    }
                }
                @if (_checkoutMsg is { } gm) { <p class="pm-hint">@gm</p> }
                <div class="pm-actions">
                    <button class="ghost" @onclick="() => _gateBlocked = null">@Loc["Not now"]</button>
                    <button disabled="@_checkoutBusy" @onclick="StartUpgrade">@Loc["Upgrade to Pro"]</button>
                </div>
            </div>
        </div>
    }

    @* Admin console — its own door, reached from the shield in the top bar (OPEN-BETA P2 metrics + P4 plan test +
       review moderation). Guarded on IsAdmin here for convenience; every admin endpoint re-checks the allowlist
       server-side, so a forced open just meets 403s. Guarded on CurrentUser too — the body dereferences it. *@
    @if (_adminOpen && Auth.CurrentUser is { IsAdmin: true })
    {
        <div class="pm-backdrop" @onclick="CloseAdmin">
            <div class="pm" @onclick:stopPropagation="true">
                <h3>@Loc["Admin console"]</h3>

                @* Usage metrics. Counts + timestamps only — never anyone's financial data (no snapshot is decrypted). *@
                <details class="pm-section" @ontoggle="LoadAdminMetrics">
                    <summary>@Loc["Admin — usage"]</summary>
                    @if (_adminMetrics is { } m)
                    {
                        <div class="pm-admin-grid">
                            <div><span class="pm-admin-n">@m.TotalUsers</span><span class="pm-admin-l">@Loc["Users"]</span></div>
                            <div><span class="pm-admin-n">@m.TotalAccounts</span><span class="pm-admin-l">@Loc["Accounts"]</span></div>
                            <div><span class="pm-admin-n">@m.BetaCohort</span><span class="pm-admin-l">@Loc["Beta cohort"]</span></div>
                            <div><span class="pm-admin-n">@m.NewUsers7d / @m.NewUsers30d</span><span class="pm-admin-l">@Loc["New (7d / 30d)"]</span></div>
                            <div><span class="pm-admin-n">@m.Active7d / @m.Active30d</span><span class="pm-admin-l">@Loc["Active (7d / 30d)"]</span></div>
                        </div>
                        @if (m.SignupsByDay.Count > 0)
                        {
                            var maxc = m.SignupsByDay.Max(d => d.Count);
                            <div class="pm-admin-spark" role="img" aria-label="@Loc["Sign-ups, last 30 days"]">
                                @foreach (var d in m.SignupsByDay)
                                {
                                    <span class="pm-admin-bar" style="height:@(Math.Max(2, (int)((double)d.Count / Math.Max(1, maxc) * 26)))px" title="@d.Day: @d.Count"></span>
                                }
                            </div>
                            <p class="pm-hint">@Loc["Sign-ups, last 30 days"]</p>
                        }
                    }
                    else if (_adminBusy) { <p class="pm-hint">@Loc["Loading…"]</p> }
                    else if (_adminError) { <p class="pm-hint">@Loc["Couldn’t load usage metrics."]</p> }
                </details>

                @* Plan test. Pins THIS account to Free or Pro so the upgrade journey can be walked on demand — the
                   thing you need over and over while wiring a real payment provider. Pinning turns the plan surface
                   on for this account alone; the global Monetization flag stays off and no other user is affected. *@
                <details class="pm-section">
                    <summary>@Loc["Admin — test a plan"]</summary>
                    <p class="pm-hint">@Loc["View the app as a Free or Pro member. Only your account is affected — everyone else stays as they are."]</p>
                    <div class="pm-cycle" role="group" aria-label="@Loc["Test plan"]">
                        <button type="button" class="@(Auth.CurrentUser is { MonetizationEnabled: true, Plan: "free" } ? "on" : "")"
                                disabled="@_overrideBusy" @onclick="@(() => SetPlanOverride("free"))">
                            @Loc["Free"]
                        </button>
                        <button type="button" class="@(Auth.CurrentUser is { MonetizationEnabled: true, Plan: "pro" } ? "on" : "")"
                                disabled="@_overrideBusy" @onclick="@(() => SetPlanOverride("pro"))">
                            @Loc["Pro"]
                        </button>
                    </div>
                    <p class="pm-hint">@Loc["“Free” shows the locked features, the landing pricing and the upgrade prompt when you touch a Pro feature. “Pro” shows the crown."]</p>
                    @if (Auth.CurrentUser?.MonetizationEnabled == true)
                    {
                        <button type="button" class="pm-exit-test" disabled="@_overrideBusy" @onclick="() => SetPlanOverride(null)">@Loc["Exit test mode"]</button>
                    }
                </details>

                @* Review moderation — the second of the two gates a review must pass (the first is the author's
                   own consent). Approve one and it appears in the landing carousel. *@
                <details class="pm-section" @ontoggle="LoadAdminFeedback">
                    <summary>@Loc["Admin — reviews"]</summary>
                    <p class="pm-hint">@Loc["People who agreed their words may be shown. Approve one and it appears in the landing carousel."]</p>
                    @if (_adminFeedback is { Count: > 0 } fb)
                    {
                        <ul class="pm-revs">
                            @foreach (var r in fb)
                            {
                                var rid = r.Id;
                                <li class="pm-rev @(r.Approved ? "on" : "")">
                                    <div class="pm-rev-top">
                                        <span class="pm-rev-stars">@(r.Rating is { } st ? new string('★', st) + new string('☆', 5 - st) : "—")</span>
                                        <span class="pm-rev-src">@r.Source</span>
                                    </div>
                                    <p class="pm-rev-txt">@(string.IsNullOrWhiteSpace(r.Comment) ? Loc["(rating only — nothing to quote)"] : r.Comment)</p>
                                    <button class="pm-rev-btn @(r.Approved ? "on" : "")" disabled="@_revBusy"
                                            @onclick="() => ToggleApproval(rid, !r.Approved)">
                                        @(r.Approved ? Loc["Shown publicly — hide"] : Loc["Approve for the site"])
                                    </button>
                                </li>
                            }
                        </ul>
                    }
                    else if (_adminFeedbackBusy) { <p class="pm-hint">@Loc["Loading…"]</p> }
                    else if (_adminFeedback is not null) { <p class="pm-hint">@Loc["Nothing to review yet — only feedback where the person ticked “you may show this” appears here."]</p> }
                </details>

                <div class="pm-actions">
                    <button class="ghost" @onclick="CloseAdmin">@Loc["Close"]</button>
                </div>
            </div>
        </div>
    }

    @* Guarded on CurrentUser as well as the flag: every line of this modal dereferences the signed-in user, so
       any path that clears it while the modal is open would take the whole layout down with a NullReference. *@
    @if (_profileOpen && Auth.CurrentUser is not null)
    {
        <div class="pm-backdrop">
            <div class="pm">
                <h3>@Loc["Profile settings"]</h3>
                <p class="pm-who">@Auth.CurrentUser!.Username@(SameUsernameAndEmail ? "" : $" · {Auth.CurrentUser!.Email}")</p>
                @if (!InProfileSubflow)
                {
                <h4>@Loc["Appearance"]</h4>
                <div class="pm-theme-row">
                    <span>@Loc[_dark ? "Dark theme" : "Light theme"]</span>
                    <button type="button" class="pm-theme-toggle" title="@Loc[_dark ? "Light theme" : "Dark theme"]" @onclick="ToggleTheme">@(_dark ? "☀️" : "🌙")</button>
                </div>
                <h4>@Loc["Profile picture"]</h4>
                <div class="pm-avatar-row">
                    <span class="pm-avatar">
                        @if (Auth.CurrentUser?.Avatar is { } pic)
                        {
                            <img src="@pic" alt="" />
                        }
                        else
                        {
                            <span>@Initial</span>
                        }
                    </span>
                    @* External (Google/Facebook) logins get their picture from the provider — no upload/remove here. *@
                    @if (!Auth.CurrentUser!.IsExternal)
                    {
                        <button class="ghost" @onclick="PickAvatar" disabled="@_avatarBusy">@Loc["Upload"]</button>
                        @if (Auth.CurrentUser?.Avatar is not null)
                        {
                            <button class="ghost danger" @onclick="RemoveAvatar" disabled="@_avatarBusy">@Loc["Remove"]</button>
                        }
                    }
                    else
                    {
                        <span class="pm-hint">@string.Format(Loc["From your {0} account"], ProviderName)</span>
                    }
                </div>
                @if (_avatarError is not null)
                {
                    <div class="pm-msg pm-error">@_avatarError</div>
                }
                @* External (Google/Facebook) sign-ins have no password — show nothing here rather than a
                   "nothing to manage" note that only takes up space. Two-factor below still applies to them. *@
                @if (!Auth.CurrentUser!.IsExternal)
                {
                    <details class="pm-section">
                        <summary>@Loc["Change password"]</summary>
                        @if (_pwdError is not null)
                        {
                            <div class="pm-msg pm-error">@_pwdError</div>
                        }
                        @if (_pwdOk)
                        {
                            <div class="pm-msg pm-ok">@Loc["Password changed."]</div>
                        }
                        <label>@Loc["Current password"] <input type="password" @bind="_curPwd" /></label>
                        <label>@Loc["New password"] <input type="password" @bind="_newPwd" /></label>
                        <label>@Loc["Confirm new password"] <input type="password" @bind="_confirmPwd" /></label>
                        <div class="pm-actions">
                            <button @onclick="ChangePassword" disabled="@(_pwdBusy || _curPwd.Length == 0 || _newPwd.Length < 8)">@Loc["Change password"]</button>
                        </div>
                    </details>
                }

                @if (!Auth.CurrentUser!.IsExternal)
                {
                    <h4>@Loc["Email"]</h4>
                    @if (Auth.CurrentUser!.EmailVerified)
                    {
                        <p class="pm-hint">✓ @Loc["Your email address is verified."]</p>
                    }
                    else
                    {
                        <p class="pm-hint">@Loc["Your email address isn't verified yet."]</p>
                        @if (_resendOk)
                        {
                            <div class="pm-msg pm-ok">@Loc["Verification email sent. Check your inbox."]</div>
                        }
                        <button class="ghost" @onclick="ResendVerification" disabled="@_resendBusy">@Loc["Resend verification email"]</button>
                    }
                }

                }

                @* Two-factor is available to every user, including external (Google/Facebook) sign-ins. *@
                @if (!_deleteConfirm)
                {
                <h4>@Loc["Two-factor authentication"]</h4>
                @if (_2faError is not null)
                {
                    <div class="pm-msg pm-error">@_2faError</div>
                }
                @if (Auth.CurrentUser!.TwoFactorEnabled && _2faSetup is null && !_2faDisabling)
                {
                    <p class="pm-hint">✓ @Loc["Two-factor authentication is on."]</p>
                    <button class="ghost danger" @onclick="() => { _2faDisabling = true; _2faCode = string.Empty; _2faError = null; }">@Loc["Turn off two-factor"]</button>
                }
                else if (_2faDisabling)
                {
                    <p class="pm-hint">@Loc["Enter a code from your authenticator to turn off two-factor authentication."]</p>
                    <label>@Loc["Authentication code"] <input type="text" inputmode="numeric" placeholder="123456" @bind="_2faCode" /></label>
                    <div class="pm-actions">
                        <button class="ghost" @onclick="() => { _2faDisabling = false; _2faCode = string.Empty; _2faError = null; }">@Loc["Back"]</button>
                        <button class="ghost danger" @onclick="DisableTwoFactor" disabled="@(_2faBusy || string.IsNullOrWhiteSpace(_2faCode))">@Loc["Turn off two-factor"]</button>
                    </div>
                }
                else if (_2faRecoveryCodes is not null)
                {
                    <div class="pm-msg pm-ok">@Loc["Two-factor is on. Save these recovery codes somewhere safe — each works once if you lose your device."]</div>
                    <ul class="pm-recovery">
                        @foreach (var rc in _2faRecoveryCodes)
                        {
                            <li><code>@rc</code></li>
                        }
                    </ul>
                    @if (Auth.CurrentUser!.EmailVerified)
                    {
                        <p class="pm-hint">@Loc["We've also emailed these codes to your verified address."]</p>
                    }
                    <button class="ghost" @onclick="() => { _2faRecoveryCodes = null; }">@Loc["Done"]</button>
                }
                else if (_2faSetup is not null)
                {
                    <p class="pm-hint">@Loc["Scan the QR in your authenticator app, or enter this key manually:"]</p>
                    <p class="pm-hint">@Loc["If your authenticator already lists a TandemTab entry, delete it there first — otherwise it may keep showing the old code and this won't work."]</p>
                    @if (!string.IsNullOrEmpty(_2faSetup.QrImage))
                    {
                        <img class="pm-2fa-qr" src="@_2faSetup.QrImage" alt="@Loc["Two-factor QR code"]" width="180" height="180" />
                    }
                    <p class="pm-2fa-key"><code>@_2faSetup.Secret</code></p>
                    <label>@Loc["Then enter the 6-digit code to confirm"] <input type="text" inputmode="numeric" placeholder="123456" @bind="_2faCode" /></label>
                    <div class="pm-actions">
                        <button class="ghost" @onclick="() => { _2faSetup = null; _2faCode = string.Empty; _2faError = null; }">@Loc["Cancel"]</button>
                        <button @onclick="ConfirmTwoFactor" disabled="@(_2faBusy || string.IsNullOrWhiteSpace(_2faCode))">@Loc["Confirm"]</button>
                    </div>
                }
                else
                {
                    <p class="pm-hint">@Loc["Add a second step at sign-in using an authenticator app (Google Authenticator, Authy, 1Password…)."]</p>
                    <button class="ghost" @onclick="BeginTwoFactor" disabled="@_2faBusy">@Loc["Enable two-factor"]</button>
                }

                }

                @if (!InProfileSubflow && _archived.Count > 0)
                {
                    <details class="pm-section">
                        <summary>@Loc["Archived accounts"] <span class="pm-badge">@_archived.Count</span></summary>
                        <p class="pm-hint">@Loc["Archived accounts are deleted after 30 days. Restore one to bring it back."]</p>
                        <ul class="pm-archived">
                            @foreach (var a in _archived)
                            {
                                var aid = a.Id;
                                <li>
                                    <span class="pm-arch-name">@a.Name <span class="pm-hint">· @DaysLeft(a.PurgeAt)</span></span>
                                    <button class="ghost" @onclick="() => Reactivate(aid)" disabled="@_archiveBusy">@Loc["Restore"]</button>
                                </li>
                            }
                        </ul>
                    </details>
                }
                @if (!InProfileSubflow)
                {
                    @* Feedback moved OUT of here to the app footer. Buried behind "open the profile modal, then
                       expand a collapsed section", almost nobody was going to find it — which defeats the point
                       of B2 in a beta. It lives in the open now and retires once given. *@

                    @* Privacy as a visible feature, not just a landing-page line: state plainly what we do and don't
                       do, and back the "you can always leave with your data" claim with a real one-tap export. *@
                    <details class="pm-section">
                        <summary>@Loc["Your data & privacy"]</summary>
                        <ul class="pm-privacy">
                            <li>🔒 @Loc["Your data is encrypted and stored per account."]</li>
                            <li>🚫 @Loc["We never sell your data, and never feed your raw data to any AI."]</li>
                            <li>📄 @Loc["Statement import runs on your device — a file you choose, not a bank login we hold."]</li>
                            @* The export BUTTON used to sit here too, running the identical
                               State.ExportCurrentAccountAsync() as the account ⋯ menu's "Export to Excel" — two
                               controls, one action, in two places. Kept as a statement of the promise (which is
                               what this privacy section is for) and points at the one place that does it. *@
                            <li>📤 @Loc["You can export any account to a spreadsheet at any time — from the account menu (⋯) → Export to Excel."]</li>
                        </ul>
                        @* A real person to reach — the same address the privacy policy names as the GDPR/data contact. *@
                        <p class="pm-hint">✉️ @Loc["Questions, or a privacy request?"] <a href="mailto:admin@tandemtab.com">admin@tandemtab.com</a></p>
                    </details>

                    @* Plans (OPEN-BETA P4). Shown ONLY when monetization is switched on; during beta the flag is
                       off, so no plan UI appears at all and every account is unlimited. No payment is wired — this
                       is the rails + a testable surface. Beta-cohort accounts are grandfathered to Pro. *@
                    @if (Auth.CurrentUser?.MonetizationEnabled == true)
                    {
                        <details class="pm-section" @ontoggle="LoadPlans">
                            <summary>@Loc["Your plan"]</summary>
                            <p class="pm-hint">@string.Format(Loc["You’re on the {0} plan."], PlanLabel(Auth.CurrentUser!.Plan))</p>
                            @if (_plans is { } pl)
                            {
                                @* What you HAVE, not just what you'd get. A plan screen that only lists the locked
                                   things reads as a nag; listing the included ones first makes the free tier feel
                                   like a product (which it is) and makes the locked rows legible as the delta. *@
                                <ul class="pm-feats">
                                    @foreach (var f in pl.Features)
                                    {
                                        var has = pl.CurrentPlan is "pro" or "unlimited" ? f.InPro : f.InFree;
                                        <li class="pm-feat @(has ? "on" : "off")">
                                            <span class="pm-feat-m" aria-hidden="true">@(has ? "✓" : "🔒")</span>
                                            <span>@FeatureLabel(f.Key)</span>
                                            @if (!has) { <span class="pm-feat-tag">@Loc["Pro"]</span> }
                                        </li>
                                    }
                                </ul>
                                @if (pl.IsBetaCohort)
                                {
                                    <p class="pm-hint">🎉 @Loc["You joined during beta — Pro is on us."]</p>
                                }
                                else if (pl.CurrentPlan == "free")
                                {
                                    <div class="pm-upsell">
                                        <div class="pm-cycle" role="group" aria-label="@Loc["Billing period"]">
                                            <button type="button" class="@(_cycle == BillingInterval.Annual ? "on" : "")"
                                                    @onclick="() => _cycle = BillingInterval.Annual">
                                                @Loc["Yearly"] <strong>@pl.Currency @pl.AnnualPrice</strong>
                                            </button>
                                            <button type="button" class="@(_cycle == BillingInterval.Monthly ? "on" : "")"
                                                    @onclick="() => _cycle = BillingInterval.Monthly">
                                                @Loc["Monthly"] <strong>@pl.Currency @pl.MonthlyPrice</strong>
                                            </button>
                                        </div>
                                        <button class="primary" disabled="@_checkoutBusy" @onclick="StartUpgrade">@Loc["Upgrade to Pro"]</button>
                                        @if (pl.PaymentSandbox)
                                        {
                                            @* Said plainly rather than hidden: a checkout button that quietly does
                                               nothing real is worse than one that admits it. *@
                                            <p class="pm-hint">@Loc["Test mode — no card is charged and no real payment is taken."]</p>
                                        }
                                        @if (_checkoutMsg is { } cm) { <p class="pm-hint">@cm</p> }
                                    </div>
                                }
                            }
                            else if (_plansBusy)
                            {
                                <p class="pm-hint">@Loc["Loading…"]</p>
                            }
                        </details>
                    }

                    @* Admin functions used to live here; they now have their own door — the shield in the top bar
                       (see the admin modal below). Kept out of profile settings so the two concerns don't tangle. *@
                }
                @if (!_2faDisabling && _2faSetup is null && _2faRecoveryCodes is null)
                {
                    <h4 class="pm-danger-h">@Loc["Delete account"]</h4>
                    @if (_deleteError is not null)
                    {
                        <div class="pm-msg pm-error">@_deleteError</div>
                    }
                    @if (!_deleteConfirm)
                    {
                        <p class="pm-hint">@Loc["Permanently deletes your account after a 30-day grace period. Your entries in accounts shared with you are kept."]</p>
                        <button class="ghost danger" @onclick="() => { _deleteConfirm = true; _deleteError = null; }">@Loc["Delete my account"]</button>
                    }
                    else
                    {
                        <p class="pm-hint">@Loc["We'll archive your account for 30 days (sign back in to cancel), then delete it and your solo accounts for good. If you own a shared account, transfer it first."]</p>
                        @if (Auth.CurrentUser!.TwoFactorEnabled)
                        {
                            <label>@Loc["Enter a two-factor code to confirm"] <input type="text" inputmode="numeric" placeholder="123456" @bind="_deleteCode" /></label>
                        }
                        <div class="pm-actions">
                            <button class="ghost" @onclick="() => { _deleteConfirm = false; _deleteCode = string.Empty; _deleteError = null; }">@Loc["Cancel"]</button>
                            <button class="ghost danger" @onclick="DeleteAccount" disabled="@(_deleteBusy || (Auth.CurrentUser!.TwoFactorEnabled && string.IsNullOrWhiteSpace(_deleteCode)))">@Loc["Delete my account"]</button>
                        </div>
                    }
                }

                @* While a focused sub-flow is active it has its own Back — hide the profile's Close so there's one clear action. *@
                @if (!InProfileSubflow)
                {
                    @* Sign out lives here now (moved off the top bar) — left-aligned so it reads as the account action,
                       with Close on the right. *@
                    <div class="pm-actions">
                        <button class="ghost danger" @onclick="SignOut">@Loc["Sign out"]</button>
                        <button class="ghost" @onclick="CloseProfile">@Loc["Close"]</button>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    private bool _restored;
    private bool _avatarBusy;
    private bool _dark;
    private string? _avatarError;
    // Account deletion (danger zone + the "keep my account" gate shown when signing in during the grace period).
    private bool _deleteBusy, _deleteConfirm;
    private string _deleteCode = "";
    private string? _deleteError;
    private bool _2faDisabling;   // focused "turn off two-factor" sub-flow
    // While a focused sub-flow (2FA enroll/recovery/turn-off, or delete) is active, the rest of the settings are
    // hidden so there's one clear task with its own Back — item #7.
    private bool InProfileSubflow => _2faSetup is not null || _2faRecoveryCodes is not null || _2faDisabling || _deleteConfirm;
    private string Initial => (Auth.CurrentUser?.Username ?? "?").Trim() is { Length: > 0 } u ? u[..1].ToUpperInvariant() : "?";

    // Hide the redundant email when it's identical to the username (common for external sign-ups).
    private bool SameUsernameAndEmail =>
        string.Equals(Auth.CurrentUser?.Username, Auth.CurrentUser?.Email, StringComparison.OrdinalIgnoreCase);
    // "google" -> "Google" for the sign-in note.
    private string ProviderName => Auth.CurrentUser?.Provider is { Length: > 0 } p ? char.ToUpperInvariant(p[0]) + p[1..] : "";

    // Static legal pages in wwwroot; serve the Bulgarian variant when the UI is in Bulgarian.
    private string PrivacyUrl => Loc.Culture == "bg" ? "/privacy.bg.html" : "/privacy.html";
    private string TermsUrl => Loc.Culture == "bg" ? "/terms.bg.html" : "/terms.html";

    private bool _profileOpen, _pwdBusy, _pwdOk, _archiveBusy;
    private string _curPwd = "", _newPwd = "", _confirmPwd = "";
    private string? _pwdError;
    private List<ArchivedAccountDto> _archived = [];

    // Security section: email verification + two-factor enrollment.
    private bool _resendBusy, _resendOk, _2faBusy;
    private string _2faCode = "";
    private string? _2faError;
    private TwoFactorSetupDto? _2faSetup;
    private string[]? _2faRecoveryCodes;

    private async Task OpenProfile()
    {
        _profileOpen = true; _curPwd = _newPwd = _confirmPwd = ""; _pwdError = null; _pwdOk = false;
        _resendOk = false; _2faError = null; _2faCode = ""; _2faSetup = null; _2faRecoveryCodes = null;
        try { _archived = await State.GetArchivedAccounts(); } catch { _archived = []; }
        StateHasChanged();
    }
    private void CloseProfile() => _profileOpen = false;

    // Admin console — its own modal, opened from the top-bar shield (admins only). Warm the usage metrics on open
    // so the panel isn't empty; the load guards against a repeat, so the details' @ontoggle can't double-fetch.
    private bool _adminOpen;
    private void OpenAdmin() { _adminOpen = true; _ = LoadAdminMetrics(); }
    private void CloseAdmin() => _adminOpen = false;

    // In-app feedback prompt in the footer. Once sent, it never comes back on this device.
    private const string FeedbackDoneKey = "finapp-feedback-sent";
    private bool _feedbackOpen, _feedbackDone, _contactOpen;

    private async Task MarkFeedbackDone()
    {
        // Let the "Thank you" state show before the whole block disappears — retiring it the instant the request
        // returns would read as the form vanishing on submit rather than as an acknowledgement.
        try { await JS.InvokeVoidAsync("localStorage.setItem", FeedbackDoneKey, "1"); } catch { /* storage off */ }
        await Task.Delay(2200);
        _feedbackDone = true;
        _feedbackOpen = false;
        StateHasChanged();
    }

    private async Task LoadFeedbackDoneAsync()
    {
        try { _feedbackDone = await JS.InvokeAsync<string?>("localStorage.getItem", FeedbackDoneKey) == "1"; }
        catch { /* storage unavailable — showing the prompt is the safe default */ }
    }

    // Owner-only usage metrics (P2). Loaded lazily when the admin section is expanded; the server re-checks the
    // allowlist, so a non-admin who forced this call just gets a 403 (handled as _adminError).
    private AdminMetricsDto? _adminMetrics;
    private bool _adminBusy, _adminError;
    private async Task LoadAdminMetrics()
    {
        if (_adminMetrics is not null || _adminBusy) return;
        _adminBusy = true; _adminError = false; StateHasChanged();
        try { _adminMetrics = await Api.GetAdminMetricsAsync(); }
        catch { _adminError = true; }
        finally { _adminBusy = false; StateHasChanged(); }
    }

    // Admin test switch: pin this account to a plan (or clear). Re-reads /me and drops the cached tiers so the
    // whole surface — feature list, upsell, crown, gates — reflects the new plan immediately.
    private bool _overrideBusy;
    private async Task SetPlanOverride(string? plan)
    {
        _overrideBusy = true; StateHasChanged();
        try
        {
            await Api.SetPlanOverrideAsync(plan);
            _plans = null;
            Gate.Invalidate();
            await Auth.RefreshUserAsync();
            await LoadPlans();
        }
        catch { /* leave the buttons as they were; /me is still the truth */ }
        finally { _overrideBusy = false; StateHasChanged(); }
    }

    // Admin review moderation.
    private List<AdminFeedbackDto>? _adminFeedback;
    private bool _adminFeedbackBusy, _revBusy;
    private async Task LoadAdminFeedback()
    {
        if (_adminFeedback is not null || _adminFeedbackBusy) return;
        _adminFeedbackBusy = true; StateHasChanged();
        try { _adminFeedback = await Api.GetAdminFeedbackAsync(); }
        catch { _adminFeedback = new(); }
        finally { _adminFeedbackBusy = false; StateHasChanged(); }
    }
    private async Task ToggleApproval(string id, bool approved)
    {
        _revBusy = true; StateHasChanged();
        try
        {
            await Api.ApproveReviewAsync(id, approved);
            _adminFeedback = null;
            await LoadAdminFeedback();
        }
        catch { /* the list stays as it was */ }
        finally { _revBusy = false; StateHasChanged(); }
    }

    // Plans (P4). Loaded lazily when the section is opened; only reachable when monetization is switched on.
    private PlansDto? _plans;
    private bool _plansBusy;
    private async Task LoadPlans()
    {
        if (_plans is not null || _plansBusy) return;
        _plansBusy = true; StateHasChanged();
        try { _plans = await Api.GetPlansAsync(); }
        catch { /* leave unset — the section just shows nothing */ }
        finally { _plansBusy = false; StateHasChanged(); }
    }
    private string PlanLabel(string plan) => plan switch { "pro" => Loc["Pro"], "free" => Loc["Free"], _ => Loc["Unlimited"] };

    /// <summary>Whether to wear the Pro mark. Requires monetization to be ON — "unlimited" (the beta state) is
    /// everyone, and a badge everyone has is not a badge.</summary>
    // The Pro tag + logo crown. Server-computed (ProBadge): during beta it follows the lifetime-cohort so the
    // first-N wear the crown while everyone stays ungated; when monetization is live it's a strict Pro plan.
    private bool IsPro => Auth.CurrentUser?.ProBadge == true;

    // The server sends stable feature KEYS and the client owns the wording, so one catalogue localizes into both
    // languages without the server knowing a locale. An unknown key falls back to itself rather than throwing —
    // a server that ships a new feature before the client learns its name degrades to an ugly row, not a crash.
    private string FeatureLabel(string key) => key switch
    {
        PlanFeatures.Budgets  => Loc["Budgets, categories and tags"],
        PlanFeatures.Goals    => Loc["Savings goals"],
        PlanFeatures.Export   => Loc["Export to Excel"],
        PlanFeatures.Security => Loc["Two-factor security"],
        PlanFeatures.Share    => Loc["Share with your household"],
        PlanFeatures.Import   => Loc["Unlimited statement imports"],
        PlanFeatures.Debt     => Loc["Debt payoff planner"],
        PlanFeatures.Insights => Loc["Trends and advanced insights"],
        PlanFeatures.History  => Loc["Full history"],
        PlanFeatures.Caps     => Loc["Unlimited accounts and funds"],
        _ => key,
    };

    // The feature key a gate just refused, or null. Set only by PlanGate.Blocked.
    private string? _gateBlocked;
    private void OnPlanBlocked(string featureKey)
    {
        _gateBlocked = featureKey;
        _checkoutMsg = null;
        // The tier table is what prices the prompt; fetch it now rather than on app start, since during beta
        // (flag off) no gate ever fires and the request would be pure waste.
        _ = LoadGatePlansAsync();
        StateHasChanged();
    }
    private async Task LoadGatePlansAsync()
    {
        await Gate.EnsureLoadedAsync();
        StateHasChanged();
    }
    // Server-side 402 backstop: it can fire off the render thread, so marshal onto it before touching state.
    private void OnServerBlocked(string featureKey) => _ = InvokeAsync(() => OnPlanBlocked(featureKey));

    // Upgrade. The billing period is a client-side choice until checkout starts; the server decides the expiry
    // from the interval it is sent, so the price shown and the term granted can't drift apart.
    private BillingInterval _cycle = BillingInterval.Annual;
    private bool _checkoutBusy;
    private string? _checkoutMsg;
    private async Task StartUpgrade()
    {
        _checkoutBusy = true; _checkoutMsg = null; StateHasChanged();
        try
        {
            var session = await Api.StartCheckoutAsync(_cycle);
            if (session.Sandbox)
            {
                // Sandbox stands in for the hosted-checkout round trip: complete it in place, then re-read /me so
                // the plan (and the Pro badge) reflect the new entitlement immediately.
                await Api.CompleteSandboxCheckoutAsync(_cycle);
                _plans = null;
                Gate.Invalidate();
                await Auth.RefreshUserAsync();
                await LoadPlans();
                _gateBlocked = null;          // whatever they were reaching for is now unlocked — get out of the way
                _checkoutMsg = Loc["You’re on Pro. (Test mode — nothing was charged.)"];
            }
            else
            {
                Nav.NavigateTo(session.RedirectUrl, forceLoad: true);
            }
        }
        catch { _checkoutMsg = Loc["Couldn’t start the upgrade. Try again in a moment."]; }
        finally { _checkoutBusy = false; StateHasChanged(); }
    }

    /// <summary>Schedule the signed-in user's account for deletion; on success /me flips to pending and the app shows the grace gate.</summary>
    private async Task DeleteAccount()
    {
        _deleteBusy = true; _deleteError = null;
        try
        {
            await Api.DeleteMyAccountAsync(Auth.CurrentUser!.TwoFactorEnabled ? _deleteCode : null);
            _deleteConfirm = false; _deleteCode = ""; _profileOpen = false;
            await Auth.RefreshUserAsync();   // now DeletionPending → the grace gate takes over
        }
        catch (ApiException ex) { _deleteError = ex.Message; }
        catch { _deleteError = Loc["Couldn’t reach the server. Check your connection and try again."]; }
        finally { _deleteBusy = false; }
    }

    /// <summary>Cancel a pending deletion (from the grace gate) and return to the app.</summary>
    private async Task KeepAccount()
    {
        _deleteBusy = true; _deleteError = null;
        try { await Api.CancelMyDeletionAsync(); await Auth.RefreshUserAsync(); }
        catch (ApiException ex) { _deleteError = ex.Message; }
        catch { _deleteError = Loc["Couldn’t reach the server. Check your connection and try again."]; }
        finally { _deleteBusy = false; }
    }

    private async Task Reactivate(Guid accountId)
    {
        _archiveBusy = true;
        try
        {
            await State.ReactivateAccount(accountId);
            _archived = _archived.Where(a => a.Id != accountId).ToList();
        }
        catch { /* surfaced elsewhere */ }
        finally { _archiveBusy = false; }
    }

    /// <summary>"5 days left" style copy for the purge deadline.</summary>
    private string DaysLeft(DateTimeOffset purgeAt)
    {
        var days = Math.Max(0, (int)Math.Ceiling((purgeAt - DateTimeOffset.UtcNow).TotalDays));
        return string.Format(Loc["{0} days left"], days);
    }

    private async Task ChangePassword()
    {
        _pwdError = null; _pwdOk = false;
        if (_newPwd != _confirmPwd) { _pwdError = Loc["The new passwords don’t match."]; return; }
        if (_newPwd.Length < 8) { _pwdError = Loc["Password must be at least 8 characters."]; return; }
        _pwdBusy = true;
        try
        {
            await Api.ChangePasswordAsync(_curPwd, _newPwd);
            _pwdOk = true; _curPwd = _newPwd = _confirmPwd = "";
        }
        catch (ApiException ex) { _pwdError = ex.Message; }
        catch { _pwdError = Loc["Couldn’t reach the server. Check your connection and try again."]; }
        finally { _pwdBusy = false; }
    }

    private async Task ResendVerification()
    {
        _resendBusy = true; _resendOk = false;
        try { await Api.ResendVerificationAsync(); _resendOk = true; }
        catch { /* best-effort; a failure just means try again later */ }
        finally { _resendBusy = false; }
    }

    private async Task BeginTwoFactor()
    {
        _2faBusy = true; _2faError = null; _2faCode = "";
        try { _2faSetup = await Api.SetupTwoFactorAsync(); }
        catch (ApiException ex) { _2faError = ex.Message; }
        catch { _2faError = Loc["Couldn’t reach the server. Check your connection and try again."]; }
        finally { _2faBusy = false; }
    }

    private async Task ConfirmTwoFactor()
    {
        _2faBusy = true; _2faError = null;
        try
        {
            var recovery = await Api.ConfirmTwoFactorAsync(_2faCode);
            _2faRecoveryCodes = recovery.RecoveryCodes;
            _2faSetup = null; _2faCode = "";
            await Auth.RefreshProfileAsync();
        }
        catch (ApiException ex) { _2faError = ex.Message; }
        catch { _2faError = Loc["Couldn’t reach the server. Check your connection and try again."]; }
        finally { _2faBusy = false; }
    }

    private async Task DisableTwoFactor()
    {
        _2faBusy = true; _2faError = null;
        try
        {
            await Api.DisableTwoFactorAsync(_2faCode);
            _2faCode = ""; _2faDisabling = false;
            await Auth.RefreshProfileAsync();
        }
        catch (ApiException ex) { _2faError = ex.Message; }
        catch { _2faError = Loc["Couldn’t reach the server. Check your connection and try again."]; }
        finally { _2faBusy = false; }
    }

    protected override async Task OnInitializedAsync()
    {
        Auth.Changed += OnChanged;
        Loc.Changed += OnChanged;
        Gate.Blocked += OnPlanBlocked;
        Api.PaymentRequired += OnServerBlocked;   // a 402 from the server-side gate raises the same prompt
        await Loc.InitializeAsync();
        // An external (Google/Facebook) sign-in redirects back with a one-time code in the query string,
        // which we exchange (over POST) for real session tokens — keeping tokens out of the URL.
        string? authCode = null;
        try { authCode = await JS.InvokeAsync<string?>("finappTakeAuthCode"); } catch { /* host without the helper */ }
        var signedIn = false;
        if (!string.IsNullOrEmpty(authCode))
        {
            // May return a 2FA challenge (Auth.PendingTwoFactorTicket) instead of signing in — the sign-in
            // screen then prompts for the second factor.
            try { signedIn = (await Auth.SignInWithCodeAsync(authCode)).SignedIn; } catch { /* fall through */ }
        }
        if (!signedIn && Auth.PendingTwoFactorTicket is null)
        {
            try { await Auth.TryRestoreAsync(); }
            catch { /* server unreachable on startup — fall through to the sign-in screen */ }
        }
        _restored = true;
        try { _dark = (await JS.InvokeAsync<string>("finappGetTheme")) == "dark"; } catch { /* host without the helper */ }
        await LoadFeedbackDoneAsync();
        await LoadLoginConsentAsync();
    }

    private void OnChanged()
    {
        _ = LoadLoginConsentAsync();
        // Warm the tier table as soon as we know who is signed in. PlanGate fails OPEN when the catalogue is
        // missing (a spurious paywall is far worse than a briefly missing one) — which means a gate reached
        // before the first load would silently pass and the paywall would never fire at all. Loading it here,
        // once, is what makes the gates real. No-ops entirely while monetization is off, which is all of beta.
        _ = Gate.EnsureLoadedAsync();
        InvokeAsync(StateHasChanged);
    }

    // --- Consent (accept the terms once at login) -------------------------
    private bool? _loginConsent;   // null = unknown/not-signed-in, true/false = active?
    private bool _consentChecked, _consentBusy;

    private async Task LoadLoginConsentAsync()
    {
        if (!Auth.IsAuthenticated) { _loginConsent = null; return; }
        if (_loginConsent is not null) return;   // already known this session
        try { _loginConsent = (await Api.GetConsentAsync("login")).Active; }
        catch { _loginConsent = true; }   // consent endpoint unreachable — don't lock the user out
        await InvokeAsync(StateHasChanged);
    }

    private async Task AcceptLoginConsent()
    {
        _consentBusy = true;
        try { await Api.RecordConsentAsync("login", null, true); _loginConsent = true; }
        catch { /* surface via retry */ }
        finally { _consentBusy = false; }
    }

    private async Task ToggleTheme()
    {
        _dark = !_dark;
        try { await JS.InvokeVoidAsync("finappSetTheme", _dark ? "dark" : "light"); } catch { /* ignore */ }
    }

    // --- Profile picture (stored on the server, per user; syncs across devices) ---

    private async Task PickAvatar()
    {
        _avatarError = null;
        try
        {
            var dataUrl = await JS.InvokeAsync<string?>("finappPickImage");
            if (string.IsNullOrEmpty(dataUrl)) return;
            _avatarBusy = true;
            await Api.UpdateAvatarAsync(dataUrl);
            Auth.SetAvatar(dataUrl);
            State.InvalidateMemberAvatars();
        }
        catch (ApiException ex) { _avatarError = ex.Message; }
        catch { _avatarError = Loc["Couldn’t reach the server. Check your connection and try again."]; }
        finally { _avatarBusy = false; }
    }

    private async Task RemoveAvatar()
    {
        _avatarError = null;
        _avatarBusy = true;
        try
        {
            await Api.UpdateAvatarAsync(null);
            Auth.SetAvatar(null);
            State.InvalidateMemberAvatars();
        }
        catch (ApiException ex) { _avatarError = ex.Message; }
        catch { _avatarError = Loc["Couldn’t reach the server. Check your connection and try again."]; }
        finally { _avatarBusy = false; }
    }

    private async Task SignOut()
    {
        // Close the profile modal FIRST. Sign-out is reached from its footer, so the modal is open when the
        // user leaves — and signing out clears Auth.CurrentUser, which the modal body dereferences on every
        // line. Leaving it open meant the post-sign-out re-render threw and the app stalled on "Loading…".
        _profileOpen = false;
        await State.ResetAsync();
        await Auth.SignOutAsync();
    }

    public void Dispose()
    {
        Auth.Changed -= OnChanged;
        Loc.Changed -= OnChanged;
        Gate.Blocked -= OnPlanBlocked;
        Api.PaymentRequired -= OnServerBlocked;
    }
}
