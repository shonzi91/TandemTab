@inject AuthState Auth
@inject Localizer Loc
@inject FinAppApiClient Api
@inject ClientOptions Options
@inject IJSRuntime JS
@implements IDisposable

<div class="auth">
    <div class="auth-lang">
        <LanguagePicker />
    </div>
    <h1 class="auth-brand"><span class="auth-logo"><TandemLogo /></span><span class="brand-word">Tandem<span class="brand-tab">Tab</span></span></h1>
    <p class="auth-slogan">@Loc["Track together, save together."]</p>
    <p class="hint">@Loc["Simple family goals, zero stress. Sign in or create an account to begin."]</p>

    @if (_twoFactorTicket is null)
    {
        <div class="auth-tabs">
            <button class="tab @(_mode == Mode.Login ? "active" : "")" @onclick="() => Switch(Mode.Login)">@Loc["Sign in"]</button>
            <button class="tab @(_mode == Mode.Register ? "active" : "")" @onclick="() => Switch(Mode.Register)">@Loc["Create account"]</button>
        </div>
    }

    @if (_error is not null)
    {
        <div class="alert warn-bg">@_error</div>
    }

    @if (_twoFactorTicket is not null)
    {
        <p class="hint">@Loc["Enter the 6-digit code from your authenticator app, or a recovery code."]</p>
        <label>@Loc["Authentication code"] <input type="text" inputmode="numeric" autocomplete="one-time-code" placeholder="123456" @bind="_twoFactorCode" @bind:event="oninput" @bind:after="ClearError" @onkeydown="OnKey" /></label>
        <button class="primary" @onclick="CompleteTwoFactor" disabled="@(_busy || string.IsNullOrWhiteSpace(_twoFactorCode))">
            @(_busy ? Loc["Verifying…"] : Loc["Verify"])
        </button>
        <button class="auth-provider" @onclick="CancelTwoFactor">@Loc["Back"]</button>
    }
    else if (_mode == Mode.Login)
    {
        <label>@Loc["Username or email"] <input type="text" placeholder="@Loc["you@example.com or username"]" autocomplete="username" @bind="_identifier" @bind:event="oninput" @bind:after="ClearError" /></label>
        <label>@Loc["Password"] <input type="password" placeholder="@Loc["Your password"]" autocomplete="current-password" @bind="_password" @bind:event="oninput" @bind:after="ClearError" @onkeydown="OnKey" /></label>
        <button class="primary" @onclick="SignIn" disabled="@(_busy || string.IsNullOrWhiteSpace(_identifier) || string.IsNullOrEmpty(_password))">
            @(_busy ? Loc["Signing in…"] : Loc["Sign in"])
        </button>
    }
    else
    {
        <label>@Loc["Username"] <input type="text" placeholder="@Loc["Pick a username"]" autocomplete="username" @bind="_username" @bind:event="oninput" @bind:after="ClearError" /></label>
        <label>@Loc["Email"] <input type="email" placeholder="you@example.com" autocomplete="email" @bind="_email" @bind:event="oninput" @bind:after="ClearError" /></label>
        <label>@Loc["Password"] <input type="password" placeholder="@Loc["At least 8 characters"]" autocomplete="new-password" @bind="_password" @bind:event="oninput" @bind:after="ClearError" @onkeydown="OnKey" /></label>
        <button class="primary" @onclick="Register" disabled="@(_busy || !CanRegister)">
            @(_busy ? Loc["Creating…"] : Loc["Create account"])
        </button>
        <small class="hint">@Loc["Password must be at least 8 characters."]</small>
    }

    @if (_twoFactorTicket is null && _providers is { Google: true } or { Facebook: true })
    {
        <div class="auth-or"><span>@Loc["or"]</span></div>
        @if (_providers.Google)
        {
            <button class="auth-provider" @onclick='() => External("google")'><span class="auth-provider-ico">G</span> @Loc["Continue with Google"]</button>
        }
        @if (_providers.Facebook)
        {
            <button class="auth-provider" @onclick='() => External("facebook")'><span class="auth-provider-ico">f</span> @Loc["Continue with Facebook"]</button>
        }
    }

    <div class="auth-legal">
        <a href="@PrivacyUrl" target="_blank" rel="noopener">@Loc["Privacy"]</a>
        <span>·</span>
        <a href="@TermsUrl" target="_blank" rel="noopener">@Loc["Terms"]</a>
    </div>
</div>

@code {
    private enum Mode { Login, Register }
    private Mode _mode = Mode.Login;
    private string _identifier = "", _username = "", _email = "", _password = "";
    private string? _error;
    private bool _busy;
    private ExternalProvidersDto? _providers;

    // Set after a password login when the account has 2FA on — prompts for the second-factor code.
    private string? _twoFactorTicket;
    private string _twoFactorCode = "";

    private bool CanRegister =>
        !string.IsNullOrWhiteSpace(_username) && !string.IsNullOrWhiteSpace(_email) && _password.Length >= 8;

    // Static legal pages live in wwwroot; serve the Bulgarian variant when the UI is in Bulgarian.
    private string PrivacyUrl => Loc.Culture == "bg" ? "/privacy.bg.html" : "/privacy.html";
    private string TermsUrl => Loc.Culture == "bg" ? "/terms.bg.html" : "/terms.html";

    protected override async Task OnInitializedAsync()
    {
        Loc.Changed += OnLocChanged;
        // An external (Google/Facebook) sign-in whose account has 2FA on lands here with a pending challenge —
        // drop straight into the code prompt instead of the username/password form.
        _twoFactorTicket = Auth.PendingTwoFactorTicket;
        try { _providers = await Api.GetProvidersAsync(); } catch { /* providers endpoint unreachable — hide buttons */ }
    }

    /// <summary>Full-page navigate to the server's OAuth start endpoint (it redirects to the provider, then back with a token).</summary>
    private async Task External(string provider)
    {
        var baseUrl = (Options.BaseUrl ?? "").TrimEnd('/');
        await JS.InvokeVoidAsync("finappNavigate", $"{baseUrl}/auth/external/{provider}");
    }

    private void OnLocChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => Loc.Changed -= OnLocChanged;

    private void Switch(Mode mode) { _mode = mode; _error = null; }

    /// <summary>Clear a stale error the moment the user edits a field, so a fixed problem doesn't keep nagging
    /// until the next submit (BACKLOG P0 #2).</summary>
    private void ClearError() => _error = null;

    private Task OnKey(KeyboardEventArgs e)
    {
        if (e.Key != "Enter") return Task.CompletedTask;
        if (_twoFactorTicket is not null) return CompleteTwoFactor();
        return _mode == Mode.Login ? SignIn() : Register();
    }

    private Task SignIn() => Run(async () =>
    {
        // The button is disabled when empty, but Enter can still fire this — give a reason instead of a silent no-op.
        if (string.IsNullOrWhiteSpace(_identifier) || string.IsNullOrEmpty(_password))
        { _error = Loc["Enter your username or email and your password."]; return; }
        var outcome = await Auth.LogInAsync(_identifier, _password);
        if (!outcome.SignedIn) { _twoFactorTicket = outcome.TwoFactorTicket; _twoFactorCode = ""; }
    });
    private Task Register() => Run(() =>
    {
        if (!CanRegister)
        {
            _error = _password.Length is > 0 and < 8
                ? Loc["Password must be at least 8 characters."]
                : Loc["Fill in a username, email and password to continue."];
            return Task.CompletedTask;
        }
        return Auth.RegisterAsync(_username, _email, _password);
    });

    private Task CompleteTwoFactor() => Run(() => Auth.CompleteTwoFactorLoginAsync(_twoFactorTicket!, _twoFactorCode));
    private void CancelTwoFactor() { _twoFactorTicket = null; _twoFactorCode = ""; _password = ""; _error = null; Auth.ClearPendingTwoFactor(); }

    private async Task Run(Func<Task> action)
    {
        if (_busy) return;
        _error = null;
        _busy = true;
        try { await action(); }
        catch (HttpRequestException) { _error = "Couldn’t reach the server. Check your connection and try again."; }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }
}
