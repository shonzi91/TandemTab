@* Category/fund/bucket icon — Option B: a plain monochrome line icon in the brand accent (no colour chip).
   `Name` is an icon name (see CategoryIcons.Effective). Pass Class="cat-chip-lg" for the big ring cards.
   `Color` is accepted for call-site compatibility but ignored in monochrome mode. *@
<span class="cat-ic @Class"><Icon Name="@Name" /></span>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter] public string? Color { get; set; }
    [Parameter] public string? Class { get; set; }
}
