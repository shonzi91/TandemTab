@inject Localizer Loc

@* A category dropdown that shows each option's icon chip + name. Native <option> can only hold text, so where we
   want the category icons visible in the picker we use this instead of a plain <select>. Supports @bind-Value
   (and @bind-Value:after). Options are (Category, depth) — sub-categories indent. *@

@* ★ preventDefault on the backdrop and the options is load-bearing, not tidiness. Wrap this component in a
   <label> (as the edit-expense modal did) and the label's "labeled control" is its first LABELABLE descendant —
   our trigger <button>. Every click inside that label is then re-dispatched onto the button as a DEFAULT ACTION
   of the label: the backdrop's Close() ran, the synthetic click hit Toggle(), and the menu re-opened. Because the
   backdrop covers the whole modal, the dropdown was stuck open with nothing else clickable — no other field, no
   Cancel, no Save.
   preventDefault is what cancels it; stopPropagation does NOT (a default action isn't propagation, and the tell
   is that the re-dispatch survives capture-phase logging on every ancestor). It's applied per-element rather than
   on this root on purpose: the search box needs its default click (focus + caret) intact. The call sites were
   also moved off <label>, which is the real fix — this is the guard that stops it coming back. *@
<div class="cat-picker @(_open ? "open" : "") @Class">
    <button type="button" class="cat-picker-btn" @onclick="Toggle" @onclick:preventDefault="true" disabled="@Disabled">
        <CatIcon Name="@SelectedIcon" />
        <span class="cat-picker-lbl">@SelectedName</span>
        <Icon Name="chevron" Class="cat-picker-caret" />
    </button>
    @if (_open)
    {
        <div class="cat-picker-backdrop" @onclick="Close" @onclick:preventDefault="true"></div>
        <div class="cat-picker-menu">
            @* Type-to-search so the picker scales when there are many categories. Only shown once the list is long
               enough to be worth filtering. *@
            @if (Options.Count > 8)
            {
                <input type="text" class="cat-picker-search" placeholder="@Loc["Search…"]"
                       @bind="_filter" @bind:event="oninput" @onclick:stopPropagation="true" />
            }
            <ul class="cat-picker-opts">
                @foreach (var (cat, depth) in Filtered)
                {
                    <li>
                        <button type="button" class="cat-picker-opt @(cat.Id == Value ? "sel" : "")"
                                style="@(depth > 0 && _filter.Length == 0 ? $"padding-inline-start:{10 + depth * 16}px" : null)"
                                @onclick="() => Pick(cat.Id)" @onclick:preventDefault="true">
                            <CatIcon Name="@CategoryIcons.Effective(cat.Icon, cat.Name)" />
                            <span class="cat-picker-opt-lbl">@cat.Name</span>
                        </button>
                    </li>
                }
                @if (Filtered.Count == 0)
                {
                    <li class="cat-picker-empty">@Loc["No matches"]</li>
                }
            </ul>
        </div>
    }
</div>

@code {
    [Parameter] public Guid Value { get; set; }
    [Parameter] public EventCallback<Guid> ValueChanged { get; set; }
    [Parameter] public IReadOnlyList<(Category Category, int Depth)> Options { get; set; } = [];
    [Parameter] public string? Class { get; set; }
    [Parameter] public bool Disabled { get; set; }

    private bool _open;
    private string _filter = "";

    // Options filtered by the search box (name contains the query, case-insensitive); empty query → the full list.
    private IReadOnlyList<(Category Category, int Depth)> Filtered =>
        _filter.Length == 0
            ? Options
            : Options.Where(o => o.Category.Name.Contains(_filter, StringComparison.CurrentCultureIgnoreCase)).ToList();

    private void Toggle() { if (!Disabled) { _open = !_open; _filter = ""; } }
    private void Close() { _open = false; _filter = ""; }

    private async Task Pick(Guid id)
    {
        _open = false; _filter = "";
        if (id != Value) await ValueChanged.InvokeAsync(id);
    }

    private Category? Selected => Options.FirstOrDefault(o => o.Category.Id == Value).Category;
    private string SelectedIcon => Selected is { } c ? CategoryIcons.Effective(c.Icon, c.Name) : CategoryIcons.Fallback;
    private string SelectedName => Selected?.Name ?? Loc["Choose…"];
}
