@* Circular progress ring with centered content. Solid arc = progress toward a target;
   Dashed=true draws a full dashed ring meaning "no target set" (open). *@
<div class="pring">
    <svg viewBox="0 0 100 100" class="pring-svg" aria-hidden="true">
        @if (!string.IsNullOrEmpty(Ramp) && !Dashed)
        {
            <defs>
                <linearGradient id="@_gid" x1="0" y1="0" x2="1" y2="1">
                    <stop offset="0" stop-color="@RampStop0" />
                    <stop offset="1" stop-color="@RampStop1" />
                </linearGradient>
            </defs>
        }
        <circle class="pring-track" cx="50" cy="50" r="42" />
        @if (Dashed)
        {
            <circle class="pring-arc dashed @Class" cx="50" cy="50" r="42" transform="rotate(-90 50 50)" />
        }
        else
        {
            <circle class="pring-arc @Class" cx="50" cy="50" r="42" transform="rotate(-90 50 50)" stroke-dasharray="@DashArray" style="@RampStyle" />
        }
    </svg>
    <div class="pring-center">@ChildContent</div>
</div>

@code {
    [Parameter] public double Percent { get; set; }            // 0..100 (clamped)
    [Parameter] public string? Class { get; set; }             // ok / warn / over / mint / muted
    [Parameter] public bool Dashed { get; set; }               // true = full dashed ring (no target)
    [Parameter] public string? Ramp { get; set; }              // "spend" = green→red as it fills; "goal" = reverse (green when full)
    [Parameter] public RenderFragment? ChildContent { get; set; }

    // Progress-driven heat GRADIENT: the arc is stroked with a green↔red gradient rather than a single colour,
    // so you read both the direction and how far along it is. "spend" sweeps green → the current heat (red near
    // the cap); "goal"/milestone is reversed so the leading edge is green as it completes. A per-instance
    // gradient id avoids collisions; the inline style wins over the class stroke in either theme.
    private readonly string _gid = "pr" + Guid.NewGuid().ToString("N");
    private static readonly System.Globalization.CultureInfo Inv = System.Globalization.CultureInfo.InvariantCulture;
    private double T => Math.Clamp(Percent, 0, 100) / 100.0;
    private const string Green = "hsl(152 70% 55%)";
    private static string Heat(double x) { var h = 152 - x * 172; if (h < 0) h += 360; return $"hsl({h.ToString("0.#", Inv)} 70% 55%)"; }
    private string RampStop0 => Ramp == "goal" ? Heat(1 - T) : Green;
    private string RampStop1 => Ramp == "goal" ? Green : Heat(T);
    private string? RampStyle => string.IsNullOrEmpty(Ramp) ? null : $"stroke:url(#{_gid})";

    private const double R = 42;
    private static readonly double Circ = 2 * Math.PI * R;

    private string DashArray
    {
        get
        {
            var p = Math.Clamp(Percent, 0, 100);
            var len = Circ * p / 100.0;
            return $"{len.ToString("0.##", Inv)} {(Circ - len).ToString("0.##", Inv)}";
        }
    }
}
