@* Circular progress ring with centered content. Solid arc = progress toward a target;
   Dashed=true draws a full dashed ring meaning "no target set" (open). *@
<div class="pring">
    <svg viewBox="0 0 100 100" class="pring-svg" aria-hidden="true">
        <circle class="pring-track" cx="50" cy="50" r="42" />
        @if (Dashed)
        {
            <circle class="pring-arc dashed @Class" cx="50" cy="50" r="42" transform="rotate(-90 50 50)" />
        }
        else
        {
            <circle class="pring-arc @Class" cx="50" cy="50" r="42" transform="rotate(-90 50 50)" stroke-dasharray="@DashArray" style="@RampStyle" />
        }
    </svg>
    <div class="pring-center">@ChildContent</div>
</div>

@code {
    [Parameter] public double Percent { get; set; }            // 0..100 (clamped)
    [Parameter] public string? Class { get; set; }             // ok / warn / over / mint / muted
    [Parameter] public bool Dashed { get; set; }               // true = full dashed ring (no target)
    [Parameter] public string? Ramp { get; set; }              // "spend" = green→pink as it fills; "goal" = reverse (green when full)
    [Parameter] public RenderFragment? ChildContent { get; set; }

    // Progress-driven colour: the arc shades along a green↔pink heat ramp by how full it is. "spend" reads
    // green when there's room and pink/red as it approaches the cap; "goal" is reversed so a completed goal or
    // milestone finishes green. Emitted as an inline style so it wins over the class stroke in either theme.
    private string? RampStyle
    {
        get
        {
            if (string.IsNullOrEmpty(Ramp)) return null;
            var t = Math.Clamp(Percent, 0, 100) / 100.0;
            if (Ramp == "goal") t = 1 - t;                      // full progress → green
            var hue = 152 - t * 172;                            // 152 green → -20 (=340) pink, via yellow/orange/red
            if (hue < 0) hue += 360;
            return $"stroke:hsl({hue.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)} 70% 55%)";
        }
    }

    private const double R = 42;
    private static readonly double Circ = 2 * Math.PI * R;

    private string DashArray
    {
        get
        {
            var p = Math.Clamp(Percent, 0, 100);
            var len = Circ * p / 100.0;
            var ci = System.Globalization.CultureInfo.InvariantCulture;
            return $"{len.ToString("0.##", ci)} {(Circ - len).ToString("0.##", ci)}";
        }
    }
}
