@* Circular progress ring with centered content. Solid arc = progress toward a target;
   Dashed=true draws a full dashed ring meaning "no target set" (open). *@
<div class="pring">
    <svg viewBox="0 0 100 100" class="pring-svg" aria-hidden="true">
        @if (!string.IsNullOrEmpty(Ramp) && !Dashed)
        {
            <defs>
                <linearGradient id="@_gid" x1="0" y1="0" x2="1" y2="1">
                    <stop offset="0" stop-color="@RampStop0" />
                    <stop offset="1" stop-color="@RampStop1" />
                </linearGradient>
            </defs>
        }
        <circle class="pring-track" cx="50" cy="50" r="42" />
        @if (Dashed)
        {
            <circle class="pring-arc dashed @Class" cx="50" cy="50" r="42" transform="rotate(-90 50 50)" />
        }
        else
        {
            @if (Percent > 0)
            {
                <circle class="pring-arc @Class @(HasRamp ? "ramped" : "") @(Percent2 > 0 ? "seg1" : "")" cx="50" cy="50" r="42" transform="rotate(-90 50 50)" stroke-dasharray="@DashArray" style="@RampStyle" />
            }
            @* Optional second segment, drawn straight after the first in its own colour — e.g. a debt's "set aside
               but not yet paid" sitting past the "already paid off" arc. Butt-capped with a small gap so the two read
               as distinct. Not combined with a ramp. *@
            @if (Percent2 > 0 && !HasRamp)
            {
                <circle class="pring-arc seg2 @Class2" cx="50" cy="50" r="42" transform="rotate(-90 50 50)" stroke-dasharray="@Dash2Array" stroke-dashoffset="@Dash2Offset" />
            }
        }
    </svg>
    @if (HasRamp)
    {
        <div class="pring-ramp ramp-@Ramp" style="--sweep:@SweepDeg" aria-hidden="true"></div>
        @if (SweepRaw > NotchDeg)
        {
            <div class="pring-cap" style="--capc:@CapStart;transform:rotate(@StartCapRot)" aria-hidden="true"></div>
            <div class="pring-cap" style="--capc:@CapTip;transform:rotate(@TipCapRot)" aria-hidden="true"></div>
        }
    }
    <div class="pring-center">@ChildContent</div>
</div>

@code {
    [Parameter] public double Percent { get; set; }            // 0..100 (clamped)
    [Parameter] public string? Class { get; set; }             // ok / warn / over / mint / muted
    [Parameter] public double Percent2 { get; set; }           // optional second segment, drawn after the first
    [Parameter] public string? Class2 { get; set; }            // colour for the second segment
    [Parameter] public bool Dashed { get; set; }               // true = full dashed ring (no target)
    [Parameter] public string? Ramp { get; set; }              // "spend" = green→red as it fills; "goal" = reverse (green when full)
    [Parameter] public RenderFragment? ChildContent { get; set; }

    // Progress-driven heat GRADIENT. The ring is a scale: a full turn == 100% of the budget/goal, so a point's
    // ANGLE encodes how much it represents and its COLOUR encodes the verdict at that much — "spend" runs
    // green→yellow→red clockwise (red = at/over the cap), "goal" is reversed (green = reached). The visible
    // arc is just that scale revealed up to Percent, which is why the tip turns red exactly as the budget runs out.
    //
    // A conic gradient is the only thing that can follow the arc, and an SVG stroke can't take one — so the ramp
    // is drawn as a masked HTML overlay (see .pring-ramp) and the SVG arc below it is hidden where that's
    // supported. Browsers without mask-composite fall back to the SVG arc's linear approximation below.
    private readonly string _gid = "pr" + Guid.NewGuid().ToString("N");
    private static readonly System.Globalization.CultureInfo Inv = System.Globalization.CultureInfo.InvariantCulture;
    private double T => Math.Clamp(Percent, 0, 100) / 100.0;
    private bool HasRamp => !string.IsNullOrEmpty(Ramp) && !Dashed;
    private double SweepRaw => T * 360;
    private string SweepDeg => SweepRaw.ToString("0.##", Inv) + "deg";
    // A small 12-o'clock notch keeps a full spend ring's coral end off its mint start (see ProgressRing.razor.css).
    // The caps sit on the notch edges: the start pins to the notch, the tip can't cross into it.
    private const double NotchDeg = 6;
    private string StartCapRot => NotchDeg.ToString("0.##", Inv) + "deg";
    private string TipCapRot => Math.Clamp(SweepRaw, NotchDeg, 360 - NotchDeg).ToString("0.##", Inv) + "deg";

    // Tandem ramp colours — MUST match the CSS conic ramp (.ramp-spend/.ramp-goal in ProgressRing.razor.css).
    // The rounded end-caps and the SVG fallback gradient sample these so nothing seams against the arc.
    private static readonly (int R, int G, int B) Mint = (0x2F, 0xB9, 0x9A);
    private static readonly (int R, int G, int B) Coral = (0xFF, 0x7A, 0x59);
    private const double CoralFrom = 0.75;   // mint until here, then blend to coral by CoralFull
    private const double CoralFull = 0.90;
    private static string Hex((int R, int G, int B) c) => $"#{c.R:X2}{c.G:X2}{c.B:X2}";
    private static string Mix((int R, int G, int B) a, (int R, int G, int B) b, double t)
    {
        t = Math.Clamp(t, 0, 1);
        return $"#{(int)Math.Round(a.R + (b.R - a.R) * t):X2}{(int)Math.Round(a.G + (b.G - a.G) * t):X2}{(int)Math.Round(a.B + (b.B - a.B) * t):X2}";
    }
    // Spend colour at fraction f along the visible arc: calm mint, blending to coral only near the cap.
    private static string SpendColorAt(double f) =>
        f <= CoralFrom ? Hex(Mint) : f >= CoralFull ? Hex(Coral) : Mix(Mint, Coral, (f - CoralFrom) / (CoralFull - CoralFrom));
    private string CapStart => Hex(Mint);                                   // both ramps begin mint at 12 o'clock
    private string CapTip => Ramp == "goal" ? Hex(Mint) : SpendColorAt(T);  // goal stays mint; spend may reach coral
    private string RampStop0 => Hex(Mint);
    private string RampStop1 => CapTip;
    private string? RampStyle => string.IsNullOrEmpty(Ramp) ? null : $"stroke:url(#{_gid})";

    private const double R = 42;
    private static readonly double Circ = 2 * Math.PI * R;

    private string DashArray
    {
        get
        {
            var p = Math.Clamp(Percent, 0, 100);
            var len = Circ * p / 100.0;
            return $"{len.ToString("0.##", Inv)} {(Circ - len).ToString("0.##", Inv)}";
        }
    }

    // Second segment: starts flush at the end of the first (no gap — paid → set → remaining read as one bar),
    // capped so it can't spill past the ring. Both segments are butt-capped in this mode so the boundary is crisp.
    private double Len1 => Circ * Math.Clamp(Percent, 0, 100) / 100.0;
    private double Len2 => Math.Max(0, Math.Min(Circ * Math.Clamp(Percent2, 0, 100) / 100.0, Circ - Len1));
    private string Dash2Array => $"{Len2.ToString("0.##", Inv)} {(Circ - Len2).ToString("0.##", Inv)}";
    private string Dash2Offset => (-Len1).ToString("0.##", Inv);
}
