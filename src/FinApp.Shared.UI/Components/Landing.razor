@inject Localizer Loc
@inject AuthState Auth
@inject IJSRuntime JS
@inject FinAppApiClient Api
@implements IDisposable

@* Logged-out marketing landing. The sign-in card (<AuthPanel/>) opens as an overlay from the CTA — the auth
   flow itself is unchanged. Copy leads with what every user gets (budgeting solo or shared, goals, recurring,
   import, insights, achievements); bank sync is intentionally not featured (allowlist-gated for the MVP). *@
<div class="lp">

    <div class="lp-topbar">
        <span class="lp-brand-sm"><span class="lp-logo-sm"><TandemLogo /></span><span class="brand-word">Tandem<span class="brand-tab">Tab</span></span></span>
        <span class="lp-topbar-actions">
            <button class="lp-theme-toggle" title="@Loc[_dark ? "Light theme" : "Dark theme"]" @onclick="ToggleTheme">@(_dark ? "☀️" : "🌙")</button>
            <LanguagePicker />
        </span>
    </div>

    <section class="lp-hero">
        <div class="lp-hero-copy">
            <h2 class="lp-headline">@Loc["Goals, better together."]</h2>
            <p class="lp-sub">@Loc["TandemTab is built for sharing — budget with your partner or household in real time, and always know where you both stand. On your own? It works beautifully for one, too."]</p>
            <ul class="lp-ticks">
                <li>@Loc["Free to start"]</li>
                <li>@Loc["Great solo, better together"]</li>
                @* Was "Encrypted — never sold or shared". Same promise, but stated as the business model rather
                   than a security feature: "we sell software, not your data" says why it will stay true. *@
                <li>@Loc["We sell software, not your data."]</li>
            </ul>
            <button class="lp-cta lp-cta-glow" @onclick="OpenAuth">@Loc["Try it free"]</button>
            @* OPEN-BETA B4 — say plainly what beta means for their data (they don't forgive losing it). *@
            @* The beta promise is the single biggest objection-remover on this page ("will I lose my data when
               this stops being free?"), so it is a badge rather than grey small print. Temporary by nature — it
               comes out when beta ends — which is exactly why it is one self-contained element to delete. *@
            <p class="lp-cta-note">
                <span class="lp-beta-pill">@Loc["Free beta"]</span>
                @Loc["Your account and everything in it carries through to launch."]
                @* The lifetime-Pro allowance is deliberately NOT advertised here any more. A live "N spots left"
                   counter is scarcity pressure whichever way it's worded, it invites people to watch a number
                   rather than read the product, and it dates the page the moment the allowance fills. The cap
                   still exists and still works — it just isn't a marketing device. *@
            </p>
        </div>
    </section>

    <section class="lp-features">
        <h3 class="lp-sec-h">@Loc["Everything you need to stay on top of money"]</h3>
        <div class="lp-grid">
            <div class="lp-feat">
                <Icon Name="users" Class="lp-feat-ico" />
                <h4>@Loc["Budget together"]</h4>
                <p>@Loc["Share one budget with your partner or household — every expense and change syncs for everyone in real time. Flying solo works just as well."]</p>
            </div>
            <div class="lp-feat">
                <Icon Name="target" Class="lp-feat-ico" />
                <h4>@Loc["Goals & debt payoff"]</h4>
                <p>@Loc["Set savings goals and debts, then see the exact month you'll reach them at your current pace."]</p>
            </div>
            <div class="lp-feat">
                <Icon Name="repeat" Class="lp-feat-ico" />
                <h4>@Loc["Recurring bills"]</h4>
                <p>@Loc["Add salary, rent and subscriptions once. TandemTab expects them each period and reminds you before they're due."]</p>
            </div>
            <div class="lp-feat">
                <Icon Name="import" Class="lp-feat-ico" />
                <h4>@Loc["Import your statement"]</h4>
                <p>@Loc["Bring in a bank statement (CSV, Excel, XML, OFX or QIF) and file transactions in a couple of taps."]</p>
            </div>
            <div class="lp-feat">
                <Icon Name="pulse" Class="lp-feat-ico" />
                <h4>@Loc["Health score & insights"]</h4>
                <p>@Loc["A simple score and clear trends show whether you're on track — and the quickest ways to improve."]</p>
            </div>
            <div class="lp-feat">
                <Icon Name="trophy" Class="lp-feat-ico" />
                <h4>@Loc["Achievements"]</h4>
                <p>@Loc["Stay motivated with streaks and milestones as your habits improve and your savings grow."]</p>
            </div>
        </div>
    </section>

    <section class="lp-steps">
        <h3 class="lp-sec-h">@Loc["How it works"]</h3>
        <div class="lp-step-row">
            <div class="lp-step">
                <span class="lp-step-n">1</span>
                <h4>@Loc["Create your account"]</h4>
                <p>@Loc["Set up a wallet and your first monthly budget in minutes."]</p>
            </div>
            <div class="lp-step">
                <span class="lp-step-n">2</span>
                <h4>@Loc["Add income & spending"]</h4>
                <p>@Loc["Log expenses as you go, or import them from your bank statement."]</p>
            </div>
            <div class="lp-step">
                <span class="lp-step-n">3</span>
                <h4>@Loc["Watch your goals get closer"]</h4>
                <p>@Loc["Follow insights, reminders and milestones as debt shrinks and savings grow."]</p>
            </div>
        </div>
    </section>

    @* Reviews people explicitly agreed to have shown, AND that a human approved (both gates are enforced in the
       query — /feedback's write side is anonymous, so consent alone would let anyone put text on this page).
       Rendered only when there is something to show: an empty or one-item "carousel" of testimonials looks worse
       than no testimonials, and during beta this list is legitimately empty. *@
    @if (_reviews.Count > 0)
    {
        <section class="lp-reviews">
            <h3 class="lp-sec-h">@Loc["What people are saying"]</h3>
            <div class="lp-carousel">
                <div class="lp-quote" @key="_reviewIx">
                    @if (_reviews[_reviewIx].Rating is { } stars)
                    {
                        <div class="lp-stars" aria-label="@string.Format(Loc["{0} out of 5"], stars)">
                            @for (var s = 0; s < 5; s++) { <span aria-hidden="true">@(s < stars ? "★" : "☆")</span> }
                        </div>
                    }
                    <blockquote>@_reviews[_reviewIx].Comment</blockquote>
                </div>
                @if (_reviews.Count > 1)
                {
                    <div class="lp-carousel-nav">
                        <button type="button" class="lp-car-arrow" aria-label="@Loc["Previous"]"
                                @onclick="() => ShowReview(_reviewIx - 1)"><span aria-hidden="true">‹</span></button>
                        <span class="lp-dots">
                            @for (var d = 0; d < _reviews.Count; d++)
                            {
                                var di = d;
                                <button type="button" class="lp-dot @(di == _reviewIx ? "on" : "")"
                                        aria-label="@string.Format(Loc["Review {0}"], di + 1)"
                                        @onclick="() => ShowReview(di)"></button>
                            }
                        </span>
                        <button type="button" class="lp-car-arrow" aria-label="@Loc["Next"]"
                                @onclick="() => ShowReview(_reviewIx + 1)"><span aria-hidden="true">›</span></button>
                    </div>
                }
            </div>
        </section>
    }

    @* Pricing lives here, before sign-up, so the cost is visible while deciding rather than discovered after.
       Renders ONLY when monetization is switched on — during beta the app is free and a price list would be a
       lie. Inside the app there is no pricing page at all; the ask happens at the gate (see PlanGate). *@
    @if (_plans is { Enabled: true } pp)
    {
        <section class="lp-pricing">
            @* Carries the closing CTA's headline: when pricing renders it IS the end of the page, and a separate
               "Ready to take control…" block below would repeat both the question and the button. *@
            <h3 class="lp-sec-h">@Loc["Ready to take control of your money — together?"]</h3>
            <div class="lp-price-row">
                <div class="lp-price-card">
                    <h4>@Loc["Free"]</h4>
                    <p class="lp-price-n">@pp.Currency 0<span>/@Loc["yr"]</span></p>
                    <p class="lp-price-alt">@Loc["No card, no expiry."]</p>
                    <ul>
                        @foreach (var f in pp.Features.Where(f => f.InFree))
                        {
                            <li>@FeatureLabel(f.Key)</li>
                        }
                    </ul>
                    <button class="lp-cta" @onclick="OpenAuth">@Loc["Try it free"]</button>
                </div>
                <div class="lp-price-card lp-price-pro">
                    <h4>👑 @Loc["Pro"]</h4>
                    <p class="lp-price-n">@pp.Currency @pp.AnnualPrice<span>/@Loc["yr"]</span></p>
                    <p class="lp-price-alt">@string.Format(Loc["or {0} {1} monthly"], pp.Currency, pp.MonthlyPrice)</p>
                    <ul>
                        <li>@Loc["Everything in Free, plus:"]</li>
                        @foreach (var f in pp.Features.Where(f => !f.InFree))
                        {
                            <li>@FeatureLabel(f.Key)</li>
                        }
                    </ul>
                    <p class="lp-price-note">@Loc["One subscription covers everyone on a shared account."]</p>
                    <button class="lp-cta lp-cta-glow" @onclick="OpenAuth">@Loc["Get started"]</button>
                </div>
            </div>
        </section>
    }

    @* Only when there is no pricing section — that one carries the same headline and its own CTAs, so showing
       both would ask the question twice. During beta (flag off) pricing never renders and this is the closer. *@
    @if (_plans is not { Enabled: true })
    {
        <section class="lp-closing">
            <h3>@Loc["Ready to take control of your money — together?"]</h3>
            <button class="lp-cta lp-cta-glow" @onclick="OpenAuth">@Loc["Try it free"]</button>
        </section>
    }

    @* Footer: the contact surface. The feedback form moved in here (it was a floating section above) so that
       everything for "how do I reach you" — write to us, email, legal — sits in the one place people look for it.
       Feedback from the landing page reaches those who looked and decided NOT to sign up: the one group we can
       hear from no other way. Collapsed by default so it never competes with the CTA. *@
    @* The lower section is now ONE thing — "tell us what you think" — because it is the only thing here that
       asks something of the reader. Contact details and legal links were columns competing with it; they are
       reference material, so they moved to the thin link line below (legal) and a modal (contact). *@
    <section class="lp-say">
        <h3 class="lp-sec-h">@Loc["Send us a message"]</h3>
        @if (_feedbackDone)
        {
            @* Retired once sent, same as the in-app prompt. Not a security control — the endpoint is anonymous
               and this is only a device flag — but it removes the standing invitation to keep submitting, which
               is what made it easy to file the same opinion twenty times. The real limits are the per-IP cap on
               /feedback and the fact that nothing reaches this page without an explicit approval. *@
            <p class="lp-say-sub">@Loc["Thanks — we've got your message. Anything else? Write to us at admin@tandemtab.com."]</p>
        }
        else
        {
            <p class="lp-say-sub">@Loc["Didn’t sign up? That’s useful to know too — what put you off?"]</p>
            <div class="lp-say-card">
                <FeedbackForm Source="landing" OnSent="MarkFeedbackSent" />
            </div>
        }
    </section>

    <footer class="lp-footer">
        <span class="lp-brand-sm"><span class="lp-logo-sm"><TandemLogo /></span><span class="brand-word">Tandem<span class="brand-tab">Tab</span></span></span>
        <p class="lp-foot-tag">@Loc["Track together, save together."]</p>
        <div class="lp-foot-links">
            <button class="lp-foot-link" @onclick="() => _contactOpen = true">@Loc["Contact"]</button>
            <span>·</span>
            <a href="@PrivacyUrl" target="_blank" rel="noopener">@Loc["Privacy"]</a>
            <span>·</span>
            <a href="@TermsUrl" target="_blank" rel="noopener">@Loc["Terms"]</a>
        </div>
        <p class="lp-foot-copy">© @DateTime.UtcNow.Year TandemTab</p>
    </footer>

</div>

@if (_contactOpen)
{
    <div class="lp-auth-backdrop" @onclick="() => _contactOpen = false">
        <div class="lp-contact-modal" @onclick:stopPropagation="true">
            <button class="lp-auth-x" title="@Loc["Close"]" aria-label="@Loc["Close"]" @onclick="() => _contactOpen = false"><span aria-hidden="true">×</span></button>
            <h3>@Loc["Contact"]</h3>
            <ContactCard />
        </div>
    </div>
}

@if (_showAuth)
{
    <div class="lp-auth-backdrop" @onclick="CloseAuth">
        <div class="lp-auth-modal" @onclick:stopPropagation="true">
            <button class="lp-auth-x" title="@Loc["Close"]" aria-label="@Loc["Close"]" @onclick="CloseAuth"><span aria-hidden="true">×</span></button>
            <AuthPanel ResetToken="@_resetToken" />
        </div>
    </div>
}

@code {
    private bool _showAuth;
    private bool _feedbackOpen;

    private string PrivacyUrl => Loc.Culture == "bg" ? "/privacy.bg.html" : "/privacy.html";
    private string TermsUrl => Loc.Culture == "bg" ? "/terms.bg.html" : "/terms.html";

    // Public reviews (P1) and public pricing (P4). Both are anonymous endpoints — this page renders before anyone
    // has an account — and both fail silently: a landing page must still render if either call fails, so an
    // outage costs a testimonial strip, never the sign-up button.
    private List<PublicReviewDto> _reviews = new();
    private int _reviewIx;
    private PlansDto? _plans;
    private bool _contactOpen;

    // Shares the key the signed-in footer uses, so telling us what you think once — from either side of the
    // sign-in line — retires both prompts on this device.
    private const string FeedbackDoneKey = "finapp-feedback-sent";
    private bool _feedbackDone;

    private async Task MarkFeedbackSent()
    {
        try { await JS.InvokeVoidAsync("localStorage.setItem", FeedbackDoneKey, "1"); } catch { /* storage off */ }
        await Task.Delay(2200);   // let the "Thank you" land before the form is replaced
        _feedbackDone = true;
        StateHasChanged();
    }

    private void ShowReview(int i)
    {
        if (_reviews.Count == 0) return;
        _reviewIx = ((i % _reviews.Count) + _reviews.Count) % _reviews.Count;   // wraps both ways
    }

    // Mirrors MainLayout's map: the server sends stable keys, the client owns the wording in each language.
    private string FeatureLabel(string key) => key switch
    {
        PlanFeatures.Budgets  => Loc["Budgets, categories and tags"],
        PlanFeatures.Goals    => Loc["Savings goals"],
        PlanFeatures.Export   => Loc["Export to Excel"],
        PlanFeatures.Security => Loc["Two-factor security"],
        PlanFeatures.Share    => Loc["Share with your household"],
        PlanFeatures.Import   => Loc["Unlimited statement imports"],
        PlanFeatures.Debt     => Loc["Debt payoff planner"],
        PlanFeatures.Insights => Loc["Trends and advanced insights"],
        PlanFeatures.History  => Loc["Full history"],
        PlanFeatures.Caps     => Loc["Unlimited accounts and funds"],
        PlanFeatures.Trips    => Loc["Plan several trips, fund them from savings, spend abroad"],
        _ => key,
    };
    private string? _resetToken;   // from a ?resetToken=… reset link → open the auth overlay on the reset form
    // Dark is the app-wide default (see index.html), so start assuming dark and correct from storage on first render.
    private bool _dark = true;

    // The auth overlay always opens on Sign-in (AuthPanel's default); new users pick the Create-account tab there.
    // Clear any reset token first: the "set a new password" form must appear ONLY from a genuine email-link
    // navigation (handled in OnAfterRenderAsync below), never because someone clicked the sign-in CTA.
    private void OpenAuth() { _resetToken = null; _showAuth = true; }
    // Closing also drops any reset token, so reopening shows a normal sign-in rather than the reset form again.
    private void CloseAuth() { _showAuth = false; _resetToken = null; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        var changed = false;
        try
        {
            var saved = (await JS.InvokeAsync<string>("finappGetTheme")) == "dark";
            if (saved != _dark) { _dark = saved; changed = true; }
        }
        catch { /* host without the theme helper — keep the dark default */ }
        try
        {
            var token = await JS.InvokeAsync<string?>("finappTakeResetToken");
            if (!string.IsNullOrEmpty(token)) { _resetToken = token; _showAuth = true; changed = true; }
        }
        catch { /* host without the helper — no reset link to honour */ }
        // Fetched after first render, not in OnInitialized: neither is needed to paint the hero or the CTA, and
        // blocking the landing page's first paint on two network calls would be a poor trade for a quote strip.
        try
        {
            var reviews = await Api.GetPublicReviewsAsync();
            if (reviews.Count > 0) { _reviews = reviews; changed = true; }
        }
        catch { /* no testimonials is a fine state — the section simply doesn't render */ }
        try
        {
            var plans = await Api.GetPublicPlansAsync();
            if (plans.Enabled) { _plans = plans; changed = true; }
        }
        catch { /* no pricing section; during beta it wouldn't render anyway */ }
        // (No /beta/capacity call any more — the seat counter came off the page, so fetching it on every landing
        // view would be a request whose answer nothing renders. The endpoint stays for the admin console.)
        try
        {
            if (await JS.InvokeAsync<string?>("localStorage.getItem", FeedbackDoneKey) == "1")
            { _feedbackDone = true; changed = true; }
        }
        catch { /* storage unavailable — showing the form is the safe default */ }
        if (changed) StateHasChanged();
    }

    private async Task ToggleTheme()
    {
        _dark = !_dark;
        try { await JS.InvokeVoidAsync("finappSetTheme", _dark ? "dark" : "light"); } catch { /* ignore */ }
    }

    protected override void OnInitialized()
    {
        Loc.Changed += OnLocChanged;
        Auth.Changed += OnAuthChanged;
        // An external (Google/Facebook) sign-in that returns a 2FA challenge must show the code prompt straight
        // away — otherwise it's stuck behind the CTA and looks like sign-in did nothing. Auto-open the overlay.
        if (Auth.PendingTwoFactorTicket is not null) _showAuth = true;
    }

    private void OnAuthChanged()
    {
        if (Auth.PendingTwoFactorTicket is not null) _showAuth = true;
        InvokeAsync(StateHasChanged);
    }

    private void OnLocChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() { Loc.Changed -= OnLocChanged; Auth.Changed -= OnAuthChanged; }
}
