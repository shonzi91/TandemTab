@* Thin (domain-free) Goals/Savings surface. Goal/debt/investment/sinking math computed server-side; writes return deltas. *@
@using FinApp.Contracts
@using FinApp.Shared.UI.Services
@implements IDisposable
@inject FinAppApiClient Api

@if (_error is { } err) { <p class="tg-err">@err</p> }
else if (_state is null || !_state.IsReady) { <p>Loading goals…</p> }
else
{
    <div class="tg-tiles">
        <div class="tg-tile"><span>Saved</span><b>@Fmt(_state.Overview.Saved)</b></div>
        <div class="tg-tile"><span>Free to save</span><b>@Fmt(_state.AvailableToSave)</b></div>
    </div>

    <h3>Buckets</h3>
    @if (_state.ActiveBuckets.Count == 0)
    {
        <p class="tg-muted">No savings buckets yet.</p>
    }
    else
    {
        <ul class="tg-list">
            @foreach (var b in _state.ActiveBuckets)
            {
                <li>
                    <span class="tg-ico">@(string.IsNullOrEmpty(b.Icon) ? "•" : b.Icon)</span>
                    <div class="tg-body">
                        <div class="tg-row1">
                            <span class="tg-name">@b.Name</span>
                            <em class="tg-kind tg-@b.Kind">@b.Kind</em>
                            <span class="tg-saved">@Fmt(b.Saved)</span>
                        </div>
                        <div class="tg-detail">@Detail(b)</div>
                        @if (Bar(b) is { } frac)
                        {
                            <div class="tg-bar"><span style="width:@(Pct(frac))"></span></div>
                        }
                    </div>
                    @if (CanWrite)
                    {
                        <span class="tg-actions">
                            <button class="tg-lnk" disabled="@_busy" @onclick="() => Archive(b)">archive</button>
                            <button class="tg-lnk danger" disabled="@_busy" @onclick="() => Remove(b)">remove</button>
                        </span>
                    }
                </li>
            }
        </ul>
    }

    @if (CanWrite)
    {
    <h3>Add to savings</h3>
    <div class="tg-form">
        <select @bind="_bucketId">
            @foreach (var b in _state.ActiveBuckets) { <option value="@b.Id">@b.Name</option> }
        </select>
        <DecimalInput Placeholder="0.00" @bind-Value="_amount" />
        <button @onclick="Allocate" disabled="@(_busy || _amount <= 0 || _bucketId == Guid.Empty)">Save it</button>
    </div>

    <h3>New bucket</h3>
    @if (!_showAdd)
    {
        <button class="tg-addbtn" @onclick="() => _showAdd = true">+ Create a savings bucket</button>
    }
    else
    {
        <div class="tg-newbucket">
            <div class="tg-kinds">
                @foreach (var k in Kinds)
                {
                    <button class="tg-kindbtn @(_nKind == k ? "sel" : "")" @onclick="() => _nKind = k">@KindLabel(k)</button>
                }
            </div>

            <div class="tg-form">
                <input placeholder="Name" @bind="_nName" />
                <input class="tg-icon-in" placeholder="icon" @bind="_nIcon" />
            </div>

            @switch (_nKind)
            {
                case "goal":
                    <div class="tg-form">
                        <label class="tg-lbl">Target <DecimalInput Placeholder="0.00" @bind-Value="_nGoal" /></label>
                        <label class="tg-lbl">Alert at <input type="number" step="1" min="0" max="100" @bind="_nThreshold" />%</label>
                        <Switch @bind-Value="_nNotify" Class="tg-chk">Notify on milestones</Switch>
                    </div>
                    break;
                case "debt":
                    <div class="tg-form">
                        <label class="tg-lbl">Balance owed <DecimalInput Placeholder="0.00" @bind-Value="_nDebtBalance" /></label>
                        <label class="tg-lbl">Rate <DecimalInput @bind-Value="_nDebtRate" />%</label>
                        <label class="tg-lbl">Installment <DecimalInput Placeholder="0.00" @bind-Value="_nDebtInstallment" /></label>
                    </div>
                    break;
                case "investment":
                    <div class="tg-form">
                        <label class="tg-lbl">Return <DecimalInput @bind-Value="_nInvRate" />%/yr</label>
                        <label class="tg-lbl">Term <input type="number" step="1" min="0" @bind="_nInvYears" /> yrs</label>
                        <label class="tg-lbl">Compounds/yr <input type="number" step="1" min="1" @bind="_nInvCompounds" /></label>
                    </div>
                    break;
                case "sinking":
                    <p class="tg-muted tg-hint">A sinking fund sets money aside for planned future costs. Add them below (optional).</p>
                    @if (_costs.Count > 0)
                    {
                        <ul class="tg-list tg-plain">
                            @foreach (var c in _costs)
                            {
                                <li><span class="tg-name">@c.Label</span><span class="tg-note">@c.Cadence</span><span class="tg-saved">@Fmt(c.Amount)</span>
                                    <button class="tg-lnk danger" @onclick="() => _costs.Remove(c)">×</button></li>
                            }
                        </ul>
                    }
                    <div class="tg-form">
                        <input placeholder="Cost label" @bind="_costLabel" />
                        <DecimalInput Placeholder="0.00" @bind-Value="_costAmount" />
                        <select @bind="_costCadence">
                            <option value="monthly">monthly</option>
                            <option value="quarterly">quarterly</option>
                            <option value="yearly">yearly</option>
                            <option value="one-off">one-off</option>
                        </select>
                        <button class="tg-lnk" disabled="@(string.IsNullOrWhiteSpace(_costLabel) || _costAmount <= 0)" @onclick="AddCost">add cost</button>
                    </div>
                    break;
            }

            <div class="tg-form">
                <label class="tg-lbl">Planned/mo <DecimalInput Placeholder="0.00" @bind-Value="_nPlanned" /></label>
                <label class="tg-lbl">Start with <DecimalInput Placeholder="0.00" @bind-Value="_nInitial" /></label>
            </div>

            <div class="tg-form">
                <button @onclick="CreateBucket" disabled="@(_busy || string.IsNullOrWhiteSpace(_nName))">Create</button>
                <button class="tg-lnk" @onclick="() => _showAdd = false">cancel</button>
            </div>
        </div>
    }
    }

    <h3>This period's deposits</h3>
    <ul class="tg-list tg-plain">
        @foreach (var d in _state.Deposits)
        {
            <li><span class="tg-name">@d.BucketName</span><span class="tg-note">@d.Note</span><span class="tg-saved">@Fmt(d.Amount)</span></li>
        }
        @if (_state.Deposits.Count == 0) { <li class="tg-muted">No deposits this period.</li> }
    </ul>
}

@code {
    [Parameter, EditorRequired] public Guid AccountId { get; set; }
    [Parameter] public int? PeriodIndex { get; set; }
    [Parameter] public bool CanWrite { get; set; } = true;

    private SavingsViewState? _state;
    private string? _error;
    private bool _busy;
    private Guid _bucketId;
    private decimal _amount;

    // --- New-bucket form ---
    private static readonly string[] Kinds = ["goal", "debt", "investment", "sinking"];
    private bool _showAdd;
    private string _nKind = "goal";
    private string _nName = "", _nIcon = "";
    private decimal? _nGoal;
    private decimal _nThreshold = 80m;
    private bool _nNotify;
    private decimal _nDebtBalance, _nDebtRate, _nDebtInstallment;
    private decimal _nInvRate, _nInvYears;
    private int _nInvCompounds = 12;
    private decimal? _nPlanned;
    private decimal _nInitial;
    private readonly List<PlannedCostDto> _costs = new();
    private string _costLabel = "";
    private decimal _costAmount;
    private string _costCadence = "monthly";

    private static string KindLabel(string k) => k switch
    { "goal" => "🎯 Goal", "debt" => "💳 Debt", "investment" => "📈 Investment", "sinking" => "🧾 Sinking", _ => k };

    private void AddCost()
    {
        if (string.IsNullOrWhiteSpace(_costLabel) || _costAmount <= 0) return;
        _costs.Add(new PlannedCostDto(_costLabel.Trim(), _costAmount, _costCadence));
        _costLabel = ""; _costAmount = 0;
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _state = new SavingsViewState(Api);
            _state.Changed += OnChanged;
            await _state.LoadAsync(AccountId, PeriodIndex);
            _bucketId = _state.ActiveBuckets.FirstOrDefault()?.Id ?? Guid.Empty;
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private async Task Allocate()
    {
        if (_state is null || _amount <= 0 || _bucketId == Guid.Empty) return;
        _busy = true;
        try { await _state.AllocateAsync(_bucketId, _amount, null); _amount = 0; }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private string? Blank(string s) => string.IsNullOrWhiteSpace(s) ? null : s.Trim();

    private async Task CreateBucket()
    {
        if (_state is null || string.IsNullOrWhiteSpace(_nName)) return;
        _busy = true; _error = null;
        try
        {
            var req = _nKind switch
            {
                "debt" => Base() with { IsDebt = true, DebtBalance = _nDebtBalance, DebtRate = _nDebtRate, DebtInstallment = _nDebtInstallment },
                "investment" => Base() with { IsInvestment = true, InvRate = _nInvRate, InvTermYears = _nInvYears, InvCompounds = _nInvCompounds },
                "sinking" => Base() with { IsExpensesFund = true, Costs = _costs.Count > 0 ? _costs.ToList() : null },
                _ => Base() with { GoalAmount = _nGoal, ThresholdPercent = _nThreshold, NotifyOnMilestone = _nNotify },
            };
            await _state.CreateBucketAsync(req);
            ResetForm();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }

        // Fields common to every kind.
        SaveSavingBucketRequest Base() => new(_nName.Trim(), Blank(_nIcon),
            PlannedContribution: _nPlanned, InitialAmount: _nInitial);
    }

    private void ResetForm()
    {
        _showAdd = false; _nKind = "goal"; _nName = ""; _nIcon = "";
        _nGoal = null; _nThreshold = 80m; _nNotify = false;
        _nDebtBalance = _nDebtRate = _nDebtInstallment = 0m;
        _nInvRate = _nInvYears = 0m; _nInvCompounds = 12;
        _nPlanned = null; _nInitial = 0m;
        _costs.Clear(); _costLabel = ""; _costAmount = 0m; _costCadence = "monthly";
    }

    private async Task Archive(SavingBucketDto b)
    {
        if (_state is null) return;
        _busy = true; _error = null;
        try { await _state.ArchiveBucketAsync(b.Id, true); }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task Remove(SavingBucketDto b)
    {
        if (_state is null) return;
        _busy = true; _error = null;
        try { await _state.RemoveBucketAsync(b.Id); }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    // The kind-specific one-liner the DTO already resolved server-side.
    private string Detail(SavingBucketDto b) => b.Kind switch
    {
        "goal" => b.GoalTarget is { } g ? $"Goal {Fmt(g)} · {PctText(b.GoalProgress)}" : "No goal set",
        "debt" => $"Owed {Fmt(b.DebtBalance ?? 0)} · {PctText(b.DebtProgress)} paid off"
                  + (b.DebtMonthsAhead is { } m ? $" · {m} mo ahead" : ""),
        "investment" => b.InvestmentProjected is { } v ? $"Projected {Fmt(v)}" : "Investment",
        "sinking" => (b.MonthlySetAside is { } s ? $"Set aside {Fmt(s)}/mo" : "Sinking fund")
                     + (b.TargetShortfall is { } sh ? $" · {Fmt(sh)} short" : ""),
        _ => "",
    };

    // The progress bar fraction for kinds that have one (goal + debt); null otherwise.
    private decimal? Bar(SavingBucketDto b) => b.Kind switch
    {
        "goal" => b.GoalProgress,
        "debt" => b.DebtProgress,
        _ => null,
    };

    private string Fmt(decimal amount) => $"{_state?.Currency} {amount:0.00}";
    private static string Pct(decimal frac) => $"{Math.Clamp(frac, 0m, 1m) * 100m:0}%";
    private static string PctText(decimal? frac) => frac is { } f ? $"{f * 100m:0}%" : "0%";

    public void Dispose() { if (_state is not null) _state.Changed -= OnChanged; }
}

<style>
    .tg-err { color: #ff7a59; }
    .tg-muted { opacity: .6; }
    h3 { margin: 1.2rem 0 .4rem; font-size: .9rem; text-transform: uppercase; letter-spacing: .03em; opacity: .7; }
    .tg-tiles { display: flex; gap: .75rem; }
    .tg-tile { flex: 1 1 0; border: 1px solid rgba(128,128,128,.3); border-radius: .6rem; padding: .6rem .8rem; }
    .tg-tile span { display: block; font-size: .7rem; text-transform: uppercase; opacity: .6; }
    .tg-tile b { font-size: 1.1rem; }
    .tg-list { list-style: none; padding: 0; margin: 0; }
    .tg-list li { display: flex; gap: .6rem; padding: .55rem .2rem; border-bottom: 1px solid rgba(128,128,128,.15); }
    .tg-plain li { align-items: center; }
    .tg-ico { width: 1.4rem; text-align: center; padding-top: .1rem; }
    .tg-body { flex: 1 1 auto; }
    .tg-row1 { display: flex; align-items: center; gap: .5rem; }
    .tg-name { font-weight: 600; }
    .tg-kind { font-style: normal; font-size: .62rem; text-transform: uppercase; letter-spacing: .04em; border-radius: .3rem; padding: 0 .35rem; opacity: .85; }
    .tg-goal { background: rgba(47,185,154,.18); }
    .tg-debt { background: rgba(120,110,220,.2); }
    .tg-investment { background: rgba(244,183,61,.2); }
    .tg-sinking { background: rgba(128,128,128,.2); }
    .tg-saved { margin-left: auto; font-variant-numeric: tabular-nums; font-weight: 600; }
    .tg-detail { font-size: .8rem; opacity: .75; margin-top: .15rem; }
    .tg-note { font-size: .8rem; opacity: .7; flex: 1 1 auto; }
    .tg-bar { height: 5px; border-radius: 3px; background: rgba(128,128,128,.2); margin-top: .35rem; overflow: hidden; }
    .tg-bar span { display: block; height: 100%; background: #2fb99a; }
    .tg-form { display: flex; flex-wrap: wrap; gap: .4rem; }
    .tg-form select, .tg-form input { padding: .4rem .5rem; border-radius: .4rem; border: 1px solid rgba(128,128,128,.4); background: transparent; color: inherit; }
    .tg-form input[type=number] { width: 6rem; }
    .tg-form button { padding: .4rem 1rem; border-radius: .4rem; border: none; background: #2fb99a; color: #05201a; font-weight: 600; cursor: pointer; }
    .tg-form button:disabled { opacity: .5; cursor: default; }
    .tg-actions { margin-left: .5rem; display: inline-flex; gap: .5rem; align-items: flex-start; }
    .tg-lnk { border: none; background: none; color: #2fb99a; cursor: pointer; font-size: .78rem; padding: 0; }
    .tg-lnk.danger { color: #ff7a59; }
    .tg-lnk:disabled { opacity: .5; cursor: default; }
    .tg-addbtn { padding: .4rem .8rem; border-radius: .4rem; border: 1px dashed rgba(128,128,128,.5); background: transparent; color: inherit; cursor: pointer; font-size: .85rem; }
    .tg-newbucket { border: 1px solid rgba(128,128,128,.3); border-radius: .6rem; padding: .7rem .8rem; display: flex; flex-direction: column; gap: .55rem; }
    .tg-kinds { display: flex; flex-wrap: wrap; gap: .35rem; }
    .tg-kindbtn { padding: .35rem .7rem; border-radius: .4rem; border: 1px solid rgba(128,128,128,.4); background: transparent; color: inherit; cursor: pointer; font-size: .82rem; }
    .tg-kindbtn.sel { border-color: #2fb99a; background: rgba(47,185,154,.15); font-weight: 600; }
    .tg-icon-in { width: 5rem; }
    .tg-lbl { display: inline-flex; align-items: center; gap: .35rem; font-size: .8rem; opacity: .85; }
    .tg-lbl input { width: 6rem; }
    .tg-chk { display: inline-flex; align-items: center; gap: .3rem; font-size: .8rem; opacity: .85; }
    .tg-hint { font-size: .8rem; margin: 0; }
</style>
