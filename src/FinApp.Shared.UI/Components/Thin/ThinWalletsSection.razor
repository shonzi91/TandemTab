@* Thin (domain-free) Wallets/Funds surface. Balances + transfers computed server-side; writes return deltas. *@
@using FinApp.Contracts
@using FinApp.Shared.UI.Services
@implements IDisposable
@inject FinAppApiClient Api

@if (_error is { } err)
{
    <p class="tw-err">@err</p>
}
else if (_state is null || !_state.IsReady)
{
    <p>Loading wallets…</p>
}
else
{
    <div class="tw-tiles">
        <div class="tw-tile"><span>Current</span><b>@Fmt(_state.Overview.Current)</b></div>
        <div class="tw-tile"><span>Free</span><b>@Fmt(_state.Overview.Free)</b></div>
    </div>

    <h3>Funds</h3>
    <ul class="tw-list">
        @foreach (var f in _state.Funds)
        {
            <li>
                <span class="tw-ico">@(string.IsNullOrEmpty(f.Icon) ? "•" : f.Icon)</span>
                <span class="tw-name">@f.Name @if (f.Synced) { <em class="tw-badge">bank</em> }</span>
                <span class="tw-note">@f.Note</span>
                <span class="tw-bal">@Fmt(f.Balance)</span>
            </li>
        }
    </ul>

    @if (CanWrite)
    {
    <h3>Move money</h3>
    <div class="tw-form">
        <select @bind="_from">
            @foreach (var f in _state.SelectableFunds) { <option value="@f.Id">@f.Name</option> }
        </select>
        <span>→</span>
        <select @bind="_to">
            @foreach (var f in _state.SelectableFunds) { <option value="@f.Id">@f.Name</option> }
        </select>
        <input type="number" step="0.01" min="0" placeholder="0.00" @bind="_amount" />
        <button @onclick="Transfer" disabled="@(_busy || _amount <= 0 || _from == Guid.Empty || _to == Guid.Empty || _from == _to)">Transfer</button>
    </div>

    <h3>Add a fund</h3>
    <div class="tw-form">
        <input type="text" placeholder="fund name" @bind="_newName" />
        <button @onclick="AddFund" disabled="@(_busy || string.IsNullOrWhiteSpace(_newName))">Add fund</button>
    </div>
    }

    <h3>This period's transfers</h3>
    <ul class="tw-list">
        @foreach (var t in _state.Transfers)
        {
            <li>
                <span class="tw-name">@t.FromFundName → @t.ToFundName</span>
                <span class="tw-note">@t.Note</span>
                <span class="tw-bal">@Fmt(t.Amount)</span>
            </li>
        }
        @if (_state.Transfers.Count == 0) { <li class="tw-empty">No transfers this period.</li> }
    </ul>
}

@code {
    [Parameter, EditorRequired] public Guid AccountId { get; set; }
    [Parameter] public int? PeriodIndex { get; set; }
    [Parameter] public bool CanWrite { get; set; } = true;

    private WalletsViewState? _state;
    private string? _error;
    private bool _busy;
    private Guid _from, _to;
    private decimal _amount;
    private string? _newName;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _state = new WalletsViewState(Api);
            _state.Changed += OnChanged;
            await _state.LoadAsync(AccountId, PeriodIndex);
            var sel = _state.SelectableFunds;
            _from = sel.ElementAtOrDefault(0)?.Id ?? Guid.Empty;
            _to = sel.ElementAtOrDefault(1)?.Id ?? _from;
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private async Task Transfer()
    {
        if (_state is null || _amount <= 0 || _from == _to) return;
        _busy = true;
        try { await _state.TransferAsync(_from, _to, _amount, null); _amount = 0; }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task AddFund()
    {
        if (_state is null || string.IsNullOrWhiteSpace(_newName)) return;
        _busy = true;
        try { await _state.AddFundAsync(_newName!, null, null); _newName = null; }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private string Fmt(decimal amount) => $"{_state?.Currency} {amount:0.00}";

    public void Dispose() { if (_state is not null) _state.Changed -= OnChanged; }
}

<style>
    .tw-err { color: #ff7a59; }
    h3 { margin: 1.2rem 0 .4rem; font-size: .9rem; text-transform: uppercase; letter-spacing: .03em; opacity: .7; }
    .tw-tiles { display: flex; gap: .75rem; }
    .tw-tile { flex: 1 1 0; border: 1px solid rgba(128,128,128,.3); border-radius: .6rem; padding: .6rem .8rem; }
    .tw-tile span { display: block; font-size: .7rem; text-transform: uppercase; opacity: .6; }
    .tw-tile b { font-size: 1.1rem; }
    .tw-form { display: flex; flex-wrap: wrap; align-items: center; gap: .4rem; }
    .tw-form select, .tw-form input { padding: .4rem .5rem; border-radius: .4rem; border: 1px solid rgba(128,128,128,.4); background: transparent; color: inherit; }
    .tw-form input[type=number] { width: 6rem; }
    .tw-form button { padding: .4rem 1rem; border-radius: .4rem; border: none; background: #2fb99a; color: #05201a; font-weight: 600; cursor: pointer; }
    .tw-form button:disabled { opacity: .5; cursor: default; }
    .tw-list { list-style: none; padding: 0; margin: 0; }
    .tw-list li { display: flex; align-items: center; gap: .6rem; padding: .45rem .2rem; border-bottom: 1px solid rgba(128,128,128,.15); }
    .tw-ico { width: 1.4rem; text-align: center; }
    .tw-name { font-weight: 600; }
    .tw-badge { font-style: normal; font-size: .65rem; opacity: .6; border: 1px solid rgba(128,128,128,.4); border-radius: .3rem; padding: 0 .3rem; margin-left: .3rem; }
    .tw-note { font-size: .8rem; opacity: .7; flex: 1 1 auto; }
    .tw-bal { margin-left: auto; font-variant-numeric: tabular-nums; }
    .tw-empty { opacity: .6; }
</style>
