@* Thin (domain-free) Income surface. Lists this period's deposits and records income through the delta-returning
   POST /deposits endpoint — see docs/MOBILE.md (Path B). Hosted by ThinDashboard.razor. *@
@using FinApp.Contracts
@using FinApp.Shared.UI.Services
@implements IDisposable
@inject FinAppApiClient Api

@if (_error is { } err)
{
    <p class="ti-err">@err</p>
}
else if (_state is null || !_state.IsReady)
{
    <p>Loading income…</p>
}
else
{
    <div class="ti-tiles">
        <div class="ti-tile"><span>Contributed</span><b>@Fmt(_state.Overview.Contributed)</b></div>
        <div class="ti-tile"><span>Current</span><b>@Fmt(_state.Overview.Current)</b></div>
    </div>

    @if (CanWrite)
    {
        <div class="ti-add">
            <select @bind="_categoryId">
                <option value="@Guid.Empty">General income</option>
                @foreach (var c in _state.Categories)
                {
                    <option value="@c.Id">@(c.Icon) @c.Name</option>
                }
            </select>
            <select @bind="_fundId">
                @foreach (var f in _state.SelectableFunds)
                {
                    <option value="@f.Id">@f.Name</option>
                }
            </select>
            <DecimalInput Placeholder="0.00" @bind-Value="_amount" />
            <input type="date" @bind="_date" />
            <button @onclick="Add" disabled="@(_busy || _amount <= 0)">Add income</button>
        </div>
    }

    <ul class="ti-list">
        @foreach (var d in _state.Deposits)
        {
            <li>
                <span class="ti-ico">@(string.IsNullOrEmpty(d.CategoryIcon) ? "＋" : d.CategoryIcon)</span>
                <span class="ti-cat">@d.CategoryName</span>
                <span class="ti-who">@d.MemberName · @d.FundName</span>
                <span class="ti-amt">@Fmt(d.Amount)</span>
                @if (CanWrite) { <button class="ti-del" title="Remove" @onclick="() => Remove(d.Id)">✕</button> }
            </li>
        }
        @if (_state.Deposits.Count == 0)
        {
            <li class="ti-empty">No income recorded this period.</li>
        }
    </ul>
}

@code {
    [Parameter, EditorRequired] public Guid AccountId { get; set; }
    [Parameter] public int? PeriodIndex { get; set; }
    [Parameter] public bool CanWrite { get; set; } = true;

    private IncomeViewState? _state;
    private string? _error;
    private bool _busy;

    private Guid _categoryId = Guid.Empty;   // general income by default
    private Guid _fundId;
    private decimal _amount;
    private DateOnly _date = DateOnly.FromDateTime(DateTime.Today);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _state = new IncomeViewState(Api);
            _state.Changed += OnChanged;
            await _state.LoadAsync(AccountId, PeriodIndex);
            _fundId = _state.SelectableFunds.FirstOrDefault()?.Id ?? Guid.Empty;
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private async Task Add()
    {
        if (_state is null || _amount <= 0) return;
        _busy = true;
        try
        {
            await _state.AddAsync(_categoryId, _fundId, _amount, _date);
            _amount = 0;
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task Remove(Guid id)
    {
        if (_state is null) return;
        try { await _state.RemoveAsync(id); }
        catch (Exception ex) { _error = ex.Message; }
    }

    private string Fmt(decimal amount) => $"{_state?.Currency} {amount:0.00}";

    public void Dispose() { if (_state is not null) _state.Changed -= OnChanged; }
}

<style>
    .ti-err { color: #ff7a59; }
    .ti-tiles { display: flex; gap: .75rem; margin-bottom: 1rem; }
    .ti-tile { flex: 1 1 0; border: 1px solid rgba(128,128,128,.3); border-radius: .6rem; padding: .6rem .8rem; }
    .ti-tile span { display: block; font-size: .7rem; text-transform: uppercase; opacity: .6; }
    .ti-tile b { font-size: 1.15rem; }
    .ti-tile:first-child b { color: #2fb99a; }
    .ti-add { display: flex; flex-wrap: wrap; gap: .4rem; margin-bottom: 1rem; }
    .ti-add select, .ti-add input { padding: .4rem .5rem; border-radius: .4rem; border: 1px solid rgba(128,128,128,.4); background: transparent; color: inherit; }
    .ti-add input[type=number] { width: 6rem; }
    .ti-add button { padding: .4rem 1rem; border-radius: .4rem; border: none; background: #2fb99a; color: #05201a; font-weight: 600; cursor: pointer; }
    .ti-add button:disabled { opacity: .5; cursor: default; }
    .ti-list { list-style: none; padding: 0; margin: 0; }
    .ti-list li { display: flex; align-items: center; gap: .6rem; padding: .5rem .2rem; border-bottom: 1px solid rgba(128,128,128,.15); }
    .ti-ico { width: 1.4rem; text-align: center; }
    .ti-cat { font-weight: 600; }
    .ti-who { font-size: .75rem; opacity: .6; flex: 1 1 auto; }
    .ti-amt { margin-left: auto; font-variant-numeric: tabular-nums; }
    .ti-del { background: none; border: none; color: inherit; opacity: .5; cursor: pointer; }
</style>
