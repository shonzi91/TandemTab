@page "/thin-dash"
@using FinApp.Contracts
@using FinApp.Shared.UI.Services
@using FinApp.Shared.UI.Components.Thin
@inject FinAppApiClient Api
@inject AuthState Auth

@* Path-B thin Dashboard shell. Composes the six domain-free Section components (each owns its own ViewState and
   talks only to the computed read + delta-write endpoints) behind a single tab bar, with prev/next period
   navigation. No FinApp.Domain, no on-device money model. This is the skeleton that will replace the thick
   Dashboard at "/" once the rest of the chrome (account switch detail, settings, import, onboarding, achievements)
   is built out — see the handoff. *@

<div class="thd">
    <p class="thd-tag">Path-B · thin Dashboard (no on-device domain)</p>

    @if (_invites is { Count: > 0 })
    {
        <div class="thd-invites">
            @foreach (var inv in _invites)
            {
                <div class="thd-invite">
                    <span><strong>@inv.InvitedByUsername</strong> invited you to <strong>@inv.AccountName</strong>.</span>
                    <span class="thd-invite-acts">
                        <button class="thd-inv-accept" disabled="@_inviteBusy" @onclick="() => AcceptInvite(inv)">Accept</button>
                        <button class="thd-inv-decline" disabled="@_inviteBusy" @onclick="() => DeclineInvite(inv)">Decline</button>
                    </span>
                </div>
            }
        </div>
    }

    @if (!Auth.IsAuthenticated)
    {
        <p>Please sign in on the main app first, then return to this page.</p>
    }
    else if (_error is { } err)
    {
        <p class="thd-err">@err</p>
    }
    else if (_accounts is null)
    {
        <p>Loading…</p>
    }
    else if (_accounts.Count == 0)
    {
        <p>No accounts on this user.</p>
    }
    else
    {
        var acct = _accounts.First(a => a.Id == _accountId);
        var period = _periods?.Periods.ElementAtOrDefault(_periodIndex);
        <header class="thd-head">
            <div class="thd-acct">
                @if (_accounts.Count > 1)
                {
                    <select class="thd-acct-sel" @onchange="OnAccountChange">
                        @foreach (var a in _accounts)
                        {
                            <option value="@a.Id" selected="@(a.Id == _accountId)">@a.Name</option>
                        }
                    </select>
                }
                else
                {
                    <span class="thd-acct-nm">@acct.Name</span>
                }
                <small class="thd-acct-sub">@acct.Currency · @(acct.Members.Count) member@(acct.Members.Count == 1 ? "" : "s")</small>
            </div>

            @if (period is { } p)
            {
                <div class="thd-period">
                    <button class="thd-nav" title="Previous period" @onclick="Prev" disabled="@(_periodIndex <= 0)">‹</button>
                    <span class="thd-period-lbl">
                        @p.From.ToString("MMM yyyy")
                        <span class="thd-status @(p.IsOpen ? "" : "closed")">@(p.IsOpen ? "Active" : "Closed")</span>
                    </span>
                    <button class="thd-nav" title="Next period" @onclick="Next" disabled="@(_periods is null || _periodIndex >= _periods.Periods.Count - 1)">›</button>
                </div>
            }

            <div class="thd-bell-wrap">
                <button class="thd-bell" title="Notifications" @onclick="() => _bellOpen = !_bellOpen">
                    🔔
                    @if (_notifications is { Count: > 0 } n)
                    {
                        <span class="thd-bell-badge @(n.UrgentCount > 0 ? "urgent" : "")">@n.Count</span>
                    }
                </button>
                @if (_bellOpen)
                {
                    <div class="thd-bell-backdrop" @onclick="() => _bellOpen = false"></div>
                    <div class="thd-bell-menu">
                        <div class="thd-bell-head">🔔 Notifications</div>
                        @if (_notifications is not { Count: > 0 })
                        {
                            <div class="thd-bell-empty">You're all caught up ✅</div>
                        }
                        else
                        {
                            @foreach (var item in _notifications.Items)
                            {
                                <button class="thd-bell-item @(item.Urgent ? "urgent" : "")" @onclick="() => OnNotificationClick(item)">
                                    <span class="thd-bell-ic">@BellIcon(item.Icon)</span>
                                    <span class="thd-bell-body">
                                        <span class="thd-bell-text">@item.Text</span>
                                        @if (item.Desc is { } d) { <span class="thd-bell-desc">@d</span> }
                                    </span>
                                    @if (item.TargetTab is not null) { <span class="thd-bell-go">›</span> }
                                </button>
                            }
                        }
                    </div>
                }
            </div>
        </header>

        <nav class="thd-tabs">
            @foreach (var t in Tabs)
            {
                <button class="thd-tab @(t == _tab ? "sel" : "")" @onclick="() => _tab = t">@t</button>
            }
        </nav>

        <section class="thd-body">
            @{
                // A fresh component instance per (account, period, tab) so switching any of them reloads from the
                // server. Writes always target the open period server-side, so a non-open period is read-only.
                var key = $"{_accountId}:{_periodIndex}:{_tab}";
                var canWrite = period?.IsOpen ?? true;
            }
            @switch (_tab)
            {
                case "Home":
                    <ThinOnboardingCard @key="_accountId" AccountId="_accountId" OnGoToTab="GoToTab" />
                    <ThinHomeSection @key="key" AccountId="_accountId" PeriodIndex="_periodIndex" />
                    break;
                case "Spending":
                    <ThinSpendingSection @key="key" AccountId="_accountId" PeriodIndex="_periodIndex" CanWrite="canWrite" />
                    break;
                case "Income":
                    <ThinIncomeSection @key="key" AccountId="_accountId" PeriodIndex="_periodIndex" CanWrite="canWrite" />
                    break;
                case "Wallets":
                    <ThinWalletsSection @key="key" AccountId="_accountId" PeriodIndex="_periodIndex" CanWrite="canWrite" />
                    break;
                case "Goals":
                    <ThinGoalsSection @key="key" AccountId="_accountId" PeriodIndex="_periodIndex" CanWrite="canWrite" />
                    break;
                case "Budgets":
                    <ThinBudgetsSection @key="key" AccountId="_accountId" PeriodIndex="_periodIndex" CanWrite="canWrite" />
                    break;
                case "Recurring":
                    <ThinRecurringSection @key="key" AccountId="_accountId" PeriodIndex="_periodIndex" CanWrite="canWrite" />
                    break;
                case "Structure":
                    <ThinStructureSection @key="_accountId" AccountId="_accountId" />
                    break;
                case "Members":
                    <ThinMembersSection @key="_accountId" Account="acct" OnMembershipChanged="ReloadAccounts" OnAccountExited="OnAccountExited" />
                    break;
                case "Awards":
                    <ThinAchievementsSection @key="_accountId" AccountId="_accountId" />
                    break;
                case "Settings":
                    <ThinSettingsSection @key="_accountId" AccountId="_accountId" OnRenamed="OnAccountRenamed" />
                    break;
            }
        </section>
    }
</div>

@code {
    private static readonly string[] Tabs = ["Home", "Spending", "Income", "Wallets", "Goals", "Budgets", "Recurring", "Structure", "Members", "Awards", "Settings"];

    private List<AccountSummaryDto>? _accounts;
    private Guid _accountId;
    private PeriodsViewDto? _periods;
    private int _periodIndex;
    private string _tab = "Home";
    private string? _error;
    private List<InvitationDto>? _invites;
    private bool _inviteBusy;
    private NotificationsViewDto? _notifications;
    private bool _bellOpen;

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsAuthenticated) return;
        try
        {
            _accounts = await Api.GetAccountsAsync();
            if (_accounts.Count > 0) await SelectAccountAsync(_accounts[0].Id);
            await LoadInvites();
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task LoadInvites()
    {
        try
        {
            var all = await Api.GetPendingInvitationsAsync();
            _invites = all.Where(i => string.Equals(i.Status, "Pending", StringComparison.OrdinalIgnoreCase)).ToList();
        }
        catch { /* invitations are non-critical chrome — never block the dashboard on them */ }
    }

    private async Task AcceptInvite(InvitationDto inv)
    {
        if (_inviteBusy) return;
        _inviteBusy = true;
        try
        {
            var accountId = await Api.AcceptInvitationAsync(inv.Id);
            _invites?.RemoveAll(i => i.Id == inv.Id);
            _accounts = await Api.GetAccountsAsync();
            if (_accounts.Any(a => a.Id == accountId)) await SelectAccountAsync(accountId);
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _inviteBusy = false; }
    }

    private async Task DeclineInvite(InvitationDto inv)
    {
        if (_inviteBusy) return;
        _inviteBusy = true;
        try { await Api.DeclineInvitationAsync(inv.Id); _invites?.RemoveAll(i => i.Id == inv.Id); }
        catch (Exception ex) { _error = ex.Message; }
        finally { _inviteBusy = false; }
    }

    // A member/owner change that keeps this account: re-pull the account list + header, keep the selection.
    private async Task ReloadAccounts()
    {
        try
        {
            _accounts = await Api.GetAccountsAsync();
            if (!_accounts.Any(a => a.Id == _accountId) && _accounts.Count > 0)
                await SelectAccountAsync(_accounts[0].Id);
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    // The caller left or deleted this account: drop it and fall back to the first remaining one.
    private async Task OnAccountExited()
    {
        try
        {
            _accounts = await Api.GetAccountsAsync();
            _tab = "Home";
            if (_accounts.Count > 0) await SelectAccountAsync(_accounts[0].Id);
            else _accountId = Guid.Empty;
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task SelectAccountAsync(Guid id)
    {
        _accountId = id;
        _periods = await Api.GetPeriodsAsync(id);
        _periodIndex = _periods.CurrentIndex >= 0 ? _periods.CurrentIndex : 0;   // default to the current period
        await LoadNotifications();
    }

    private async Task LoadNotifications()
    {
        // The bell is optional chrome (current-period alerts) — never block the dashboard on it.
        try { _notifications = await Api.GetNotificationsAsync(_accountId); }
        catch { _notifications = null; }
    }

    // Read-only bell: clicking an item jumps to the tab that addresses it.
    private void OnNotificationClick(NotificationDto item)
    {
        _bellOpen = false;
        if (item.TargetTab is { } tab) GoToTab(tab);
    }

    private static string BellIcon(string icon) => icon switch
    {
        "scale" => "⚖️", "alert" => "⚠️", "info" => "ℹ️", "import" => "📥",
        "repeat" => "🔁", "note" => "📝", "calendar" => "📅", _ => "•",
    };

    private async Task OnAccountChange(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var id))
        {
            try { await SelectAccountAsync(id); }
            catch (Exception ex) { _error = ex.Message; }
        }
    }

    private void Prev() { if (_periodIndex > 0) _periodIndex--; }
    private void Next() { if (_periods is not null && _periodIndex < _periods.Periods.Count - 1) _periodIndex++; }

    // An onboarding step jumps to the tab where you'd complete it.
    private void GoToTab(string tab) { if (Tabs.Contains(tab)) _tab = tab; }

    // Keep the header's account name in sync when Settings renames the account.
    private void OnAccountRenamed(string name)
    {
        var i = _accounts?.FindIndex(a => a.Id == _accountId) ?? -1;
        if (i >= 0 && _accounts is not null) _accounts[i] = _accounts[i] with { Name = name };
    }
}

<style>
    .thd { max-width: 760px; margin: 1rem auto; padding: 0 1rem; }
    .thd-tag { font-size: .75rem; opacity: .7; margin: 0 0 1rem; }
    .thd-err { color: #ff7a59; }
    .thd-invites { display: flex; flex-direction: column; gap: .5rem; margin-bottom: 1rem; }
    .thd-invite { display: flex; align-items: center; justify-content: space-between; gap: .75rem; flex-wrap: wrap; padding: .6rem .8rem; border: 1px solid rgba(47,185,154,.4); border-radius: .5rem; background: rgba(47,185,154,.08); font-size: .9rem; }
    .thd-invite-acts { display: inline-flex; gap: .5rem; }
    .thd-inv-accept { padding: .35rem .9rem; border-radius: .4rem; border: none; background: #2fb99a; color: #05201a; font-weight: 600; cursor: pointer; }
    .thd-inv-decline { padding: .35rem .9rem; border-radius: .4rem; border: 1px solid rgba(128,128,128,.4); background: transparent; color: inherit; cursor: pointer; }
    .thd-inv-accept:disabled, .thd-inv-decline:disabled { opacity: .5; cursor: default; }
    .thd-head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; margin-bottom: .75rem; }
    .thd-acct { display: flex; align-items: baseline; gap: .6rem; flex-wrap: wrap; }
    .thd-acct-nm { font-size: 1.3rem; font-weight: 700; }
    .thd-acct-sel { font-size: 1.1rem; font-weight: 700; padding: .25rem .4rem; border-radius: .4rem; border: 1px solid rgba(128,128,128,.4); background: transparent; color: inherit; }
    .thd-acct-sub { opacity: .6; font-size: .8rem; }
    .thd-period { display: flex; align-items: center; gap: .3rem; }
    .thd-nav { border: 1px solid rgba(128,128,128,.4); background: transparent; color: inherit; cursor: pointer; border-radius: .4rem; width: 1.9rem; height: 1.9rem; font-size: 1.1rem; line-height: 1; }
    .thd-nav:disabled { opacity: .35; cursor: default; }
    .thd-period-lbl { display: inline-flex; align-items: center; gap: .4rem; font-weight: 600; min-width: 6.5rem; justify-content: center; }
    .thd-status { font-size: .62rem; text-transform: uppercase; letter-spacing: .03em; border-radius: .3rem; padding: .05rem .35rem; background: rgba(47,185,154,.18); color: #2fb99a; }
    .thd-status.closed { background: rgba(128,128,128,.2); color: inherit; opacity: .7; }
    .thd-bell-wrap { position: relative; }
    .thd-bell { position: relative; border: 1px solid rgba(128,128,128,.4); background: transparent; color: inherit; cursor: pointer; border-radius: .4rem; width: 2rem; height: 1.9rem; font-size: 1rem; line-height: 1; }
    .thd-bell-badge { position: absolute; top: -.5rem; right: -.5rem; min-width: 1.05rem; height: 1.05rem; padding: 0 .25rem; border-radius: .6rem; background: #2fb99a; color: #05201a; font-size: .68rem; font-weight: 700; display: flex; align-items: center; justify-content: center; }
    .thd-bell-badge.urgent { background: #ff7a59; color: #2a0b03; }
    .thd-bell-backdrop { position: fixed; inset: 0; z-index: 20; }
    .thd-bell-menu { position: absolute; right: 0; top: 2.3rem; z-index: 21; width: min(20rem, 80vw); background: var(--surface, #14201d); border: 1px solid rgba(128,128,128,.35); border-radius: .6rem; box-shadow: 0 8px 30px rgba(0,0,0,.35); overflow: hidden; }
    @@media (prefers-color-scheme: light) { .thd-bell-menu { background: #fff; } }
    :root[data-theme="dark"] .thd-bell-menu { background: #14201d; }
    :root[data-theme="light"] .thd-bell-menu { background: #fff; }
    .thd-bell-head { padding: .55rem .7rem; font-weight: 600; font-size: .82rem; border-bottom: 1px solid rgba(128,128,128,.2); }
    .thd-bell-empty { padding: 1rem .7rem; opacity: .7; font-size: .85rem; text-align: center; }
    .thd-bell-item { display: flex; align-items: flex-start; gap: .5rem; width: 100%; text-align: left; padding: .55rem .7rem; border: none; border-bottom: 1px solid rgba(128,128,128,.12); background: transparent; color: inherit; cursor: pointer; }
    .thd-bell-item:hover { background: rgba(128,128,128,.1); }
    .thd-bell-item.urgent { border-left: 3px solid #ff7a59; }
    .thd-bell-ic { font-size: .95rem; line-height: 1.2; }
    .thd-bell-body { display: flex; flex-direction: column; gap: .1rem; min-width: 0; flex: 1; }
    .thd-bell-text { font-size: .83rem; }
    .thd-bell-desc { font-size: .74rem; opacity: .7; }
    .thd-bell-go { opacity: .5; }
    .thd-tabs { display: flex; flex-wrap: wrap; gap: .3rem; border-bottom: 1px solid rgba(128,128,128,.2); margin-bottom: 1rem; }
    .thd-tab { padding: .45rem .8rem; border: none; background: transparent; color: inherit; cursor: pointer; border-bottom: 2px solid transparent; opacity: .7; font-size: .9rem; }
    .thd-tab.sel { opacity: 1; font-weight: 600; border-bottom-color: #2fb99a; }
    .thd-tab:hover { opacity: 1; }
</style>
