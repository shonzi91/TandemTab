    /// (match-key, kind "category"/"fund", leading icon).</summary>
    private RenderFragment<(string Key, string Kind, string Icon)> BankRuleRow => ctx =>
        @<li class="@(_ruleEditKey == ctx.Key ? "rule-editing" : "")">
            @if (_ruleEditKey == ctx.Key)
            {
                <span class="row-main rule-tokens" title="@Loc["Tap a word to include or exclude it from matching. A transaction matches when all the highlighted words appear in it."]">
                    @ctx.Icon
                    @foreach (var tok in _ruleEditTokens)
                    {
                        <button type="button" class="rule-chip @(_ruleEditOn.Contains(tok) ? "on" : "")" @onclick="() => ToggleRuleToken(tok)">@tok</button>
                    }
                </span>
