    /// <summary>A mutable edit row for one <see cref="PlannedCost"/> — the domain record is immutable, and a half-typed
    /// row (a label with no amount yet) has to be allowed to exist while you're filling it in.</summary>
    private sealed class CostRow
    {
        public string? Label { get; set; }
        public decimal Amount { get; set; }
        public CostCadence Cadence { get; set; } = CostCadence.Yearly;
        public DateOnly? DueDate { get; set; }

        public static CostRow From(PlannedCost c) =>
            new() { Label = c.Label, Amount = c.Amount, Cadence = c.Cadence, DueDate = c.DueDate };

        public PlannedCost ToCost() =>
            new(Label?.Trim() ?? "", Amount, Cadence, Cadence == CostCadence.OneOff ? DueDate : null);
    }

    private List<CostRow> _costRows = new();

    private void AddCostRow() => _costRows.Add(new CostRow());
    private void RemoveCostRow(CostRow row) => _costRows.Remove(row);

    /// <summary>Live preview of the monthly set-aside while editing, net of what the bucket already holds — the same
    /// maths the saved bucket will report, so the number doesn't jump when you press ✓.</summary>
    private decimal EditingSetAside() =>
        PlannedCost.MonthlySetAsideFor(ValidCostRows(), State.Period.From, EditingSaved());

    private decimal EditingSaved() =>
        _modalBucketId == Guid.Empty ? _initialSavings : State.SavingBucketSaved(_modalBucketId).Amount;

    /// <summary>Only complete rows count — same filter <c>ReplaceCosts</c> applies on save, so the preview matches
    /// what actually gets stored while you're still typing a row.</summary>
    private List<PlannedCost> ValidCostRows() =>
        _costRows.Select(r => r.ToCost()).Where(c => !string.IsNullOrWhiteSpace(c.Label) && c.Amount > 0m).ToList();

    private Task SaveBucket() => RunModal(async () =>
    {
        if (string.IsNullOrWhiteSpace(_fName)) return;
        decimal? goal = _goalAmount > 0 ? _goalAmount : null;
        decimal? planned = null;   // planned-contribution field retired; add/edit clears any legacy value
        var isDebt = _bucketKind == SavingKind.Debt;
        var isInv = _bucketKind == SavingKind.Investment;
        var isExpenses = _bucketKind == SavingKind.Expenses;
        if (isExpenses && ValidCostRows().Count == 0) return;   // the cost list is the point of this kind
        // Only an expenses fund carries a cost list; the other kinds clear it rather than keeping an orphaned
        // list alive behind a form that no longer shows it.
        var costs = isExpenses ? ValidCostRows() : [];
        // Debt input mode: "original + already paid" derives what's owed and sends the original as the baseline; the
        // plain mode sends what's owed and lets the original default to it. Due-day/start-date only apply to a debt.
        var debtBal = isDebt && _debtEnterInitial ? Math.Max(0m, _debtOriginal - _debtPaidPrincipal) : _debtBalance;
        decimal? debtOrig = isDebt && _debtEnterInitial ? _debtOriginal : null;
        int? debtDay = isDebt ? _debtDay : null;
        DateOnly? debtStart = isDebt ? _debtStart : null;
        var debtPayDriven = isDebt && _debtPayDriven;
        if (_modal == Modal.AddBucket)
            await State.AddSavingBucket(_fName!, goal, _fThreshold, _fNotify, _initialSavings, _fIcon, isDebt, debtBal, _debtRate, _debtInstallment, planned, isInv, _invRate, _invTermYears, _invCompounds, _bucketFundId, costs, isExpenses, debtOrig, debtDay, debtStart, debtPayDriven);
        else
            await State.SaveSavingBucket(_modalBucketId, _fName!, goal, _fThreshold, _fNotify, _initialSavings, _fIcon, isDebt, debtBal, _debtRate, _debtInstallment, planned, isInv, _invRate, _invTermYears, _invCompounds, _bucketFundId, costs, isExpenses, debtOrig, debtDay, debtStart, debtPayDriven);
        CloseModal();
    });

    // "Add a cost" — one sinking-fund cost edited straight on the bucket (not the create/edit-bucket modal).
    // _editCostIndex is its position in the bucket's cost list; -1 means adding a new one.
    private Guid _costBucketId;
