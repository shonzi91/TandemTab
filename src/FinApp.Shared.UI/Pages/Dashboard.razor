    private void OpenEditExpense(Guid expenseId)
    {
        if (State.FindExpense(expenseId) is not { } e) return;
        _editExpenseId = expenseId;
        _categoryId = e.CategoryId; _amount = e.Amount.Amount; _fundId = e.FundId; _note = e.Note; _expenseDate = e.Date;
        _fTagId = e.TagId; _newTagName = null; _tagFiledTo = null; _expenseHadTag = e.TagId is not null;
        _expenseTime = e.Time; _expenseHadTime = e.Time is not null;
        _expTripId = e.TripId ?? Guid.Empty;   // the trip is editable here — see the picker in the modal
        _expTripAccountId = e.TripAccountId ?? Guid.Empty;
        _editOpenedFromTrip = false;           // TripEditExpense sets it back on, after this call
        _modal = Modal.EditExpense;
        // Fired here, not per render: the other accounts' trips need a fetch, and the picker is markup. The modal
        // opens immediately without the row and grows it when the list lands — which is the right way round, since
        // the overwhelmingly common edit has nothing to do with another account's journey.
        _ = LoadForeignTripOptionsAsync();
    }

    private async Task LoadForeignTripOptionsAsync()
    {
        try { _foreignTrips = await State.ForeignTripOptionsAsync(); }
        catch { _foreignTrips = []; }   // an unreadable account offers no trips; the rest of the form is unaffected
        StateHasChanged();
    }

    /// <summary>Pick a trip that lives in another account (D1). Deliberately does <b>not</b> run
    /// <see cref="ApplyTripCategoryDefault"/> or swap the tag chips: that trip's category and labels are ids in
    /// <i>its</i> account, and filing this expense under one of them would put it in a category this account does
    /// not have. The link is a reporting fact; nothing about where the money sits changes.</summary>
    private void OnForeignTripPicked(BudgetingState.ForeignTripOption option)
    {
        if (_expTripId == option.Trip.Id && _expTripAccountId == option.AccountId)
        {
            _expTripId = Guid.Empty; _expTripAccountId = Guid.Empty;   // tapping the chip again detaches
            return;
        }
        _expTripId = option.Trip.Id;
        _expTripAccountId = option.AccountId;
