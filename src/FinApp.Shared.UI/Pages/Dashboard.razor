            @* While a row is being confirmed the new expense is posted before this pending row is removed, so it
               would momentarily match itself and flash "you already logged this". Suppress the hint mid-save —
               including while pinning (the rule auto-files matching rows, which briefly self-matches too). *@
            @if (isDebit && !_bankBusy && !_dupDismissed.Contains(id) && !_rowSaving.Contains(id) && DupSuggestions.TryGetValue(id, out var dup))
            {
                <div class="dup-hint">
                    <span class="dup-txt">🔁 @string.Format(Loc["Looks like you already logged this: {0} · {1} {2} · {3} · {4}"], Fmt(dup.Amount), dup.CategoryIcon, dup.Category, dup.Fund, dup.Date.ToString("dd MMM"))</span>
