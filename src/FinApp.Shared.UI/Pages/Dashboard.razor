@page "/"
@implements IDisposable
@inject BudgetingState State
@inject AuthState Auth
@inject FinAppApiClient Api
@inject Localizer Loc
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject ClientErrorReporter Errors
@inject PlanGate Gate

@if (_busy)
{
    <div class="save-overlay"><div class="save-overlay-card"><Spinner Block="true" Text="@Loc["Saving…"]" /></div></div>
}

@if (!State.IsReady)
{
    <div class="loading"><Spinner Block="true" Text="@Loc["Loading…"]" /></div>
}
else if (!State.HasAccounts)
{
    <div class="firstrun">
        <div class="firstrun-mascot"><TandemLogo /></div>
        <h1>@Loc["Welcome to TandemTab"]</h1>
        <p class="firstrun-lead">@Loc["Let’s get you rolling. Create your first account to get started (e.g. Personal, Shared, Family)."]</p>
        <InvitationsPanel />
        @if (_error is not null)
        {
            <div class="alert warn-bg"><span>@_error</span><button class="alert-x" title="@Loc["Dismiss"]" aria-label="@Loc["Dismiss"]" @onclick="() => _error = null"><span aria-hidden="true">×</span></button></div>
        }
        <div class="firstrun-form">
            <label>@Loc["Account name"] <input type="text" placeholder="Personal" @bind="_fName" /></label>
            <label>@Loc["Currency"] <input type="text" maxlength="3" @bind="_fCurrency" /></label>
            @SavingsTargetField
            <button @onclick="CreateFirstAccount" disabled="@(string.IsNullOrWhiteSpace(_fName))">@Loc["Create account"]</button>
        </div>
        <small class="hint">@Loc["It starts with a few starter categories and the current month’s period — you can change everything."]</small>
    </div>
}
else
{
<div class="dash @(_busy ? "is-busy" : "")">
    @{
        // Computed once for the whole dashboard: the health report + notification list feed both the bell (in the
        // header, visible on every tab) and the Home overview below.
        var ov = CurrentReport();
        var notifications = HomeNotifications(ov);
        // Split for the two surfaces (UX backlog #4/#5): the urgent "needs attention" items show inline on Home; the
        // bell holds everything else, grouped into time-based "Due" reminders and financial "Suggestions". No item
        // appears in both places, so the bell no longer echoes the Home cards.
        var bellDue = notifications.Where(n => n.Due).ToList();
        var bellSuggest = notifications.Where(n => !n.Due && !n.Urgent).ToList();
        // Settled rows (a skip and its undo) still render, but the badge counts only what's actually outstanding.
        var bellCount = bellDue.Count(n => !n.Settled) + bellSuggest.Count(n => !n.Settled);
    }
    <header class="dash-head">
        <div class="hdr-top">
            <div class="acct-wrap">
                <button class="acct-chip" title="@Loc["Switch account"]" @onclick="() => _acctDropOpen = !_acctDropOpen">
                    <span class="ava-stack">
                        @foreach (var m in State.RealUsers.Take(3))
                        {
                            <Avatar Name="@m.DisplayName" Picture="@State.MemberAvatar(m.UserId)" Size="26" />
                        }
                    </span>
                    <span class="acct-nm">@State.Account.Name<small>@MembersLine(State.RealUsers)</small></span>
                    @* ★ The TripMode badge sits with the ACCOUNT, not with the product wordmark. A trip belongs to
                       one account — switch accounts and it is simply not on — whereas the app bar's brand spans all
                       of them, so a badge up there claimed something wider than it meant.
                       Inside the chip, between the name and the caret: it qualifies the account NAME, and anything
                       outside the button reads as a separate object sitting near it rather than part of it. *@
                    @if (State.ActiveTrip is { } acctTrip)
                    {
                        @TripModeTag(acctTrip)
                    }
                    <span class="acct-car">▾</span>
                </button>
                @if (_acctDropOpen)
                {
                    <div class="acct-menu-backdrop" @onclick="() => _acctDropOpen = false"></div>
                    <div class="acct-drop">
                        @foreach (var a in State.Accounts)
                        {
                            var aid = a.Id;
                            <button class="acct-drop-item @(aid == State.CurrentAccountId ? "sel" : "")" @onclick="() => SwitchAccountTo(aid)">
                                <span class="ava-stack">
                                    @* Pictures are cached for the open account only, so members of the other accounts
                                       listed here fall back to their initials until that account is opened. *@
                                    @foreach (var m in a.Members.Take(3)) { <Avatar Name="@m.DisplayName" Picture="@State.MemberAvatar(m.UserId)" Size="22" /> }
                                </span>
                                <span class="acct-nm">@a.Name<small>@MembersLine(a.Members)</small></span>
                                @if (aid == State.CurrentAccountId) { <span class="acct-check"><Icon Name="check" /></span> }
                            </button>
                        }
                        @* People on the current account live here — with the account identity, not on the Wallets tab.
                           Invite + per-member remove for the owner. *@
                        <div class="acct-drop-people">
                            <div class="acct-drop-sec-head">
                                <span>@Loc["People"]</span>
                                <button class="link" @onclick="@(() => { _acctDropOpen = false; OpenInvite(); })"><Icon Name="plus" /> @Loc["Invite"] <ProLock Feature="@PlanFeatures.Share" Static="true" /></button>
                            </div>
                            @foreach (var m in State.RealUsers)
                            {
                                var mid = m.UserId;
                                <div class="acct-drop-person">
                                    <Avatar Name="@m.DisplayName" Picture="@State.MemberAvatar(mid)" Size="22" />
                                    <span class="acct-drop-person-nm">@m.DisplayName</span>
                                    @if (mid == State.MyUserId) { <span class="person-tag">@Loc["you"]</span> }
                                    else if (mid == State.CurrentOwnerId) { <span class="person-tag">@Loc["owner"]</span> }
                                    @if (State.IsOwnerOfCurrent && mid != State.MyUserId)
                                    {
                                        <button class="person-x" title="@Loc["Remove from account"]" aria-label="@Loc["Remove from account"]" @onclick="() => OpenRemoveMember(mid, m.DisplayName)"><span aria-hidden="true">×</span></button>
                                    }
                                </div>
                            }
                        </div>
                        @* The Free cap is one OWNED account, so the crown only appears once that's used up —
                           a first account is free for everyone and must not look locked. *@
                        <button class="acct-drop-add" @onclick="@(() => { _acctDropOpen = false; OpenAddAccount(); })"><Icon Name="plus" /> @Loc["Add a new account"] @if (State.Accounts.Count(a => a.IsOwner) >= 1) { <ProLock Feature="@PlanFeatures.Caps" Static="true" /> }</button>
                    </div>
                }
            </div>

            @* Period navigation sits in the top row on desktop (dates/edit/remove/start-next + Active label folded
               behind one compact chip); on mobile it wraps to its own row below so the header doesn't crowd. *@
            <div class="period-nav">
                <button class="nav @(State.CanGoPrev ? "" : "nav-hidden")" title="@Loc["Previous period"]" aria-label="@Loc["Previous period"]" @onclick="State.GoPrev" disabled="@(!State.CanGoPrev)"><span aria-hidden="true">‹</span></button>
                <span class="period-menu">
                    <button class="period-chip" title="@Loc["Period options"]" @onclick="() => _periodMenuOpen = !_periodMenuOpen">
                        <span class="period-chip-label">@State.Period.From.ToString("MMM yyyy")</span>
                        <span class="status @(State.IsPeriodOpen ? "" : "status-closed")"><i class="status-dot"></i>@Loc[State.IsPeriodOpen ? "Active" : "Closed"]</span>
                    </button>
                    @if (_periodMenuOpen)
                    {
                        <div class="acct-menu-backdrop" @onclick="() => _periodMenuOpen = false"></div>
                        <div class="acct-menu-pop period-pop">
                            <div class="period-pop-head">
                                <span class="period-pop-range">@State.Period.From.ToString("dd MMM") – @State.Period.To.ToString("dd MMM yyyy")</span>
                            </div>
                            <button @onclick="@(() => { _periodMenuOpen = false; OpenEditPeriod(); })"><Icon Name="pencil" /> @Loc["Edit period dates"]</button>
                            @* "Start next month" is no longer here — once the period's end date passes, the Home
                               period-ended prompt offers it automatically (so this menu item was redundant). *@
                            @if (State.IsLatestPeriod && State.PeriodCount > 1)
                            {
                                <button class="danger" @onclick="@(() => { _periodMenuOpen = false; OpenRemovePeriod(); })"><Icon Name="trash" /> @Loc["Remove this period"]</button>
                            }
                        </div>
                    }
                </span>
                <button class="nav @(State.CanGoNext ? "" : "nav-hidden")" title="@Loc["Next period"]" aria-label="@Loc["Next period"]" @onclick="State.GoNext" disabled="@(!State.CanGoNext)"><span aria-hidden="true">›</span></button>
            </div>

            @* Header utility icons, left→right: notifications · achievements · settings (settings last).
               Import / Recurring / External accounts moved to the labelled action row below the balance. *@
            <span class="hdr-icons">
                <span class="acct-notify">
                    <button class="link bell" title="@Loc["Notifications"]" aria-label="@(bellCount > 0 ? $"{Loc["Notifications"]} ({bellCount})" : Loc["Notifications"])" @onclick="() => _bellOpen = !_bellOpen">
                        <Icon Name="bell" />@if (bellCount > 0) { <span class="bell-badge" aria-hidden="true">@bellCount</span> }
                    </button>
                    @if (_bellOpen)
                    {
                        @* One bell row — reused by the Due and Suggestions groups. *@
                        RenderFragment<Notification> bellRow = n =>
                        @<div class="bell-item @(n.Urgent ? "urgent" : "") @(n.Settled ? "settled" : "")">
                            <span class="bell-ico">@IconOrEmoji(n.Icon)</span>
                            <div class="bell-body">
                                @if (n.Rich is { } rich) { <div class="bell-text">@rich</div> } else { <div class="bell-text">@n.Text</div> }
                                @if (n.Desc is { } d) { <div class="bell-desc">@d</div> }
                                @if (n is { Rich: null, ActionLabel: { } al, Act: { } act })
                                {
                                    <button class="bell-act" @onclick="@(() => { act(); _bellOpen = false; })">@al</button>
                                }
                                @* Stays open: skipping or undoing a bill is often one of several, and closing the
                                   menu after each would make handling the month's list a series of re-openings. *@
                                @if (n is { AltLabel: { } altL, Alt: { } altAct })
                                {
                                    <button class="bell-act bell-act-alt" @onclick="@(() => altAct())">@altL</button>
                                }
                            </div>
                            <span class="bell-item-ops">
                                @if (n.Rotate is { } rot) { <button class="tip-x" title="@Loc["Another idea"]" @onclick="rot"><Icon Name="rotate" /></button> }
                                @if (n.Dismiss is { } dis) { <button class="tip-x" title="@Loc["Dismiss for this period"]" aria-label="@Loc["Dismiss for this period"]" @onclick="dis"><span aria-hidden="true">×</span></button> }
                            </span>
                        </div>;
                        <div class="acct-menu-backdrop" @onclick="() => _bellOpen = false"></div>
                        <div class="bell-menu">
                            <div class="bell-head"><Icon Name="bell" /> @Loc["Notifications"]</div>
                            @if (bellCount == 0)
                            {
                                <div class="bell-empty"><Icon Name="check" /> @Loc["You're all caught up."]</div>
                            }
                            else
                            {
                                @* Two labelled groups (#5): time-based "Due" reminders first (bills/recurring), then the
                                   financial "Suggestions". A group's header only shows when it has items. *@
                                @if (bellDue.Count > 0)
                                {
                                    <div class="bell-group-h">@Loc["Due"]</div>
                                    @foreach (var n in bellDue) { @bellRow(n) }
                                }
                                @if (bellSuggest.Count > 0)
                                {
                                    <div class="bell-group-h">@Loc["Suggestions"]</div>
                                    @foreach (var n in bellSuggest) { @bellRow(n) }
                                }
                            }
                        </div>
                    }
                </span>
                @* Bank transactions awaiting review live next to the bell (they're notification-like), not on the
                   Wallets External-accounts button. Only appears when a synced bank has staged imports. *@
                @{
                    var _reviewCount = _bankStatus is { Enabled: true, Connected: true } ? BankDebits().Count + BankCredits().Count : 0;
                }
                @if (_reviewCount > 0)
                {
                    <button class="link bell hdr-review" title="@string.Format(Loc["{0} bank transactions to review"], _reviewCount)" aria-label="@string.Format(Loc["{0} bank transactions to review"], _reviewCount)" @onclick="OpenBankReview">
                        <Icon Name="bank" /><span class="review-badge" aria-hidden="true">@_reviewCount</span>
                    </button>
                }
                <button class="link hdr-trophy" title="@Loc["Achievements"]" @onclick="() => _modal = Modal.Achievements"><Icon Name="trophy" /></button>
                <span class="acct-menu">
                    <button class="link" title="@Loc["Account actions"]" @onclick="() => _acctMenuOpen = !_acctMenuOpen"><Icon Name="sliders" /></button>
                    @if (_acctMenuOpen)
                    {
                        <div class="acct-menu-backdrop" @onclick="() => _acctMenuOpen = false"></div>
                        <div class="acct-menu-pop">
                            <button @onclick="OpenRecurring"><Icon Name="repeat" /> @Loc["Recurring"]</button>
                            @if (State.IsOwnerOfCurrent)
                            {
                                @* "Edit account", not "Rename": the modal behind this has carried the savings target
                                   for a long time and F4 round-ups since, so "Rename" undersold it into a label
                                   nobody would open to change how much they save each month. *@
                                <button @onclick="() => RunAcct(OpenEditAccount)"><Icon Name="pencil" /> @Loc["Edit account"]</button>
                            }
                            @if (HasArchivedItems)
                            {
                                <button @onclick="() => RunAcct(() => _modal = Modal.Archived)"><Icon Name="archive" /> @Loc["Archived items"]</button>
                            }
                            <button @onclick="MenuExport"><Icon Name="chart" /> @Loc["Export to Excel"]</button>
                            <button class="danger" @onclick="() => RunAcct(OpenLeaveAccount)"><Icon Name="logout" /> @Loc["Leave account"]</button>
                            @if (State.IsOwnerOfCurrent)
                            {
                                <button class="danger" @onclick="() => RunAcct(OpenDeleteAccount)"><Icon Name="trash" /> @Loc["Delete account"]</button>
                            }
                        </div>
                    }
                </span>
            </span>
        </div>

        @{
            var _balCur = State.DisplayClosingBalance(_bankStatus?.Balance, _bankStatus?.BalanceCurrency);
            var _balFree = State.DisplayFreeToAllocate(_bankStatus?.Balance, _bankStatus?.BalanceCurrency);
            // Known bills still expected out this period (recurring, not yet posted). Unlike budgets these are real,
            // near-certain outflows, so "free once they're paid" is an honest look-ahead — the number that answers
            // "what can I actually spend without shorting a bill I already know is coming". Can go negative.
            var _billsDue = State.BillsDueThisPeriod;
            var _safeAfterBills = _balFree - _billsDue;
            // F3 "Left to spend today": the after-bills headroom spread over the days still left in the period —
            // the concrete "can I buy this right now?" number. Numerator is _safeAfterBills (already nets out known
            // upcoming bills), so it can't over-promise before a rent/bill lands. Only on the open latest period,
            // only when there's positive headroom and at least a day to go.
            var _todayD = DateOnly.FromDateTime(DateTime.Today);
            var _daysLeft = State.Period.To.DayNumber - _todayD.DayNumber + 1;
            decimal? _perDay = State.IsLatestPeriod && _daysLeft >= 1 && _safeAfterBills.Amount > 0m
                ? decimal.Round(_safeAfterBills.Amount / _daysLeft, 2)
                : null;
            // The hero is a real money summary — and it's the only header the Home tab shows, so it doubles as Home's
            // "how am I doing" glance (UX backlog #1/#2): what's safe to spend now, what was set aside this period
            // (with its savings rate), what's gone out, and what came in. The running TOTAL balance moved down to the
            // Wallets donut; the all-time saved TOTAL moved to the Goals header — each lives where you'd go looking.
            // "Spent" here means all money out (expenses + account-to-account transfers), matching the Breakdown's
            // "Spent" — a transfer to another account is money gone, so it belongs on the hero. Budget bars/health
            // keep using TotalSpent (expenses only). Savings disbursements are excluded (a bucket payout isn't spend).
            var _spent = State.TotalMoneyOut;
            // The transfer half of "Spent", broken out below the figure the way "Money in" breaks out carry-over —
            // otherwise a big transfer to another account reads as a spending blow-out. Sub-line only when non-zero.
            var _transfersOut = State.TransfersOutThisPeriod;
            var _transfersTip = string.Format(Loc["Of this, {0} was moved to another account rather than spent."], Fmt(_transfersOut));
            var _savedPeriod = State.SavingsThisPeriod;
            // Rate is of "money in" (fresh income + free carry-over), not income alone — otherwise setting aside
            // carried-over cash over-states it. Tooltip breaks the denominator down so the figure is legible.
            var _savedRate = State.PeriodMoneyInRate;
            var _moneyInTip = string.Format(Loc["Money in this period: {0} came in, plus {1} carried over from before."], Fmt(State.FreshInThisPeriod), Fmt(State.CarriedInThisPeriod));
        }
        <div class="hdr-hero">
            @if (State.IsPeriodOpen)
            {
                <div class="bal-part bal-part-main">
                    <span class="bal-label">@Loc["Safe to spend"]@if (LiveBalancePending) { <span class="bal-refreshing" title="@Loc["Updating live balance…"]"></span> }</span>
                    <strong class="@(State.IsOverAllocated ? "warn-text" : "bal-free-v")" title="@Loc["Not set aside for savings. Budgets are plans, so they don't reserve this."]">@Fmt(_balFree)</strong>
                    @* ★ Exactly ONE context line, never two — and it is the "after bills" figure, not the daily
                       allowance. Both answered the same question at different resolutions (the per-day number is
                       already computed after bills), and the absolute one is what the owner actually reads: what
                       is left once the month's known commitments are met. The per-day figure moves into the
                       explainer below, where it costs nothing.
                       Tapped rather than hovered — there is no hover on a phone, which is where this line matters
                       most, so a title attribute hid the explanation from exactly the people who needed it. *@
                    @if (_billsDue.Amount > 0m)
                    {
                        <button type="button" class="bal-sub bal-sub-btn @(_safeAfterBills.IsNegative ? "warn-text" : "")"
                                aria-expanded="@(_safeInfoOpen ? "true" : "false")"
                                @onclick="() => _safeInfoOpen = !_safeInfoOpen" @onclick:stopPropagation="true">@Fmt(_safeAfterBills) @Loc["after bills"] <Icon Name="info" Class="bal-sub-i" /></button>
                    }
                    else if (_perDay is { } _pdOnly)
                    {
                        @* Nothing outstanding, so "after bills" would just restate the headline. *@
                        <button type="button" class="bal-sub bal-sub-btn bal-daily"
                                aria-expanded="@(_safeInfoOpen ? "true" : "false")"
                                @onclick="() => _safeInfoOpen = !_safeInfoOpen" @onclick:stopPropagation="true">@string.Format(Loc["{0} a day left"], Fmt(_pdOnly)) <Icon Name="info" Class="bal-sub-i" /></button>
                    }
                    @if (_safeInfoOpen)
                    {
                        @* A click anywhere else closes it — the backdrop is the whole viewport, so there is no way
                           to leave a stray popover open, which is the failure mode of tap-to-open tooltips. *@
                        <div class="bal-info-backdrop" @onclick="() => _safeInfoOpen = false"></div>
                        <div class="bal-info" role="tooltip">
                            <div class="bal-info-row"><span>@Loc["Safe to spend"]</span><strong>@Fmt(_balFree)</strong></div>
                            @if (_billsDue.Amount > 0m)
                            {
                                <div class="bal-info-row"><span>@Loc["Known bills still due"]</span><strong>−@Fmt(_billsDue)</strong></div>
                                <div class="bal-info-row bal-info-total"><span>@Loc["Left after bills"]</span><strong class="@(_safeAfterBills.IsNegative ? "warn-text" : "")">@Fmt(_safeAfterBills)</strong></div>
                            }
                            @if (_perDay is { } _pdInfo)
                            {
                                <div class="bal-info-note">@string.Format(Loc["That's about {0} a day for the {1} days left in this period."], Fmt(_pdInfo), _daysLeft)</div>
                            }
                            <div class="bal-info-note">@Loc["Money set aside for savings is already excluded. Budgets are plans, so they don't reserve anything here."]</div>
                        </div>
                    }
                </div>
                @* ★ The three reference figures keep their number and lose their sub-lines. Each sub-line was a
                   fourth, fifth and sixth number on the one screen the user lands on, and none of them was the
                   reason they opened the app — the savings RATE lives on Goals, the transfer split and the
                   carry-over on Wallets, in full and in context. They stay one hover away here via the title. *@
                <div class="bal-part">
                    <span class="bal-label">@Loc["Saved"]</span>
                    <strong class="bal-alloc-v" title="@(_savedRate is { } _sr && _sr > 0m ? string.Format(Loc["Set aside for savings this period — reserved, not spent. That's {0}% of money in."], Math.Round(_sr * 100m).ToString("0", System.Globalization.CultureInfo.InvariantCulture)) : Loc["Set aside for savings this period — reserved, not spent."])">@Fmt(_savedPeriod)</strong>
                </div>
                <div class="bal-part">
                    <span class="bal-label">@Loc["Spent"]</span>
                    <strong title="@(_transfersOut.Amount > 0m ? _transfersTip : Loc["All money out this period — spending plus account transfers."])">@Fmt(_spent)</strong>
                </div>
                <div class="bal-part">
                    @* Was "Income" — now "Money in" (fresh income + free carry-over) so it matches the denominator the
                       Saved rate is "% of". When nothing carried over it's just this period's income. *@
                    <span class="bal-label">@Loc["Money in"]</span>
                    <strong title="@_moneyInTip">@Fmt(State.MoneyInThisPeriod)</strong>
                </div>
            }
            else
            {
                @* A closed/past period shows the same shape of cards as an open one, but in its FINAL state: what it
                   closed with, and what came in / went out / was set aside that period. Ledger figures only — no
                   bank-adjust (the live balance reflects now, not this closed period) and no "still due" sub-lines. *@
                <div class="bal-part bal-part-main">
                    <span class="bal-label">@Loc["Closed with"]</span>
                    <strong class="bal-free-v" title="@Loc["What this period closed with — carried into the next."]">@Fmt(State.ClosedFundTotal)</strong>
                    @if (State.NextPeriod is { } _np)
                    {
                        <small class="bal-sub" title="@Loc["Free cash handed to the next period."]">→ @Fmt(State.CarriedInto(_np)) @string.Format(Loc["carried to {0}"], _np.From.ToString("MMM"))</small>
                    }
                    else
                    {
                        <small class="bal-sub">@State.Period.To.ToString("dd MMM yyyy")</small>
                    }
                </div>
                <div class="bal-part">
                    <span class="bal-label">@Loc["Saved"]</span>
                    <strong class="bal-alloc-v" title="@Loc["Set aside for savings this period — reserved, not spent."]">@Fmt(_savedPeriod)</strong>
                    @if (_savedRate is { } _sr && _sr > 0m)
                    {
                        <small class="bal-sub" title="@_moneyInTip">@(Math.Round(_sr * 100m).ToString("0", System.Globalization.CultureInfo.InvariantCulture))% @Loc["of money in"]</small>
                    }
                </div>
                <div class="bal-part">
                    <span class="bal-label">@Loc["Spent"]</span>
                    <strong title="@Loc["All money out this period — spending plus account transfers."]">@Fmt(_spent)</strong>
                    @if (_transfersOut.Amount > 0m)
                    {
                        <small class="bal-sub" title="@_transfersTip">+@Fmt(_transfersOut) @Loc["transferred"]</small>
                    }
                </div>
                <div class="bal-part">
                    <span class="bal-label">@Loc["Money in"]</span>
                    <strong title="@_moneyInTip">@Fmt(State.MoneyInThisPeriod)</strong>
                    @if (State.CarriedInThisPeriod.Amount > 0m)
                    {
                        <small class="bal-sub" title="@_moneyInTip">+@Fmt(State.CarriedInThisPeriod) @Loc["carried"]</small>
                    }
                </div>
            }
        </div>
        @* The old always-visible utilities row was removed to declutter the header (web + mobile): the expense-side
           tools (Import statement, Manage categories) now live in the Spending tab's ⋯ menu; Recurring moved to the
           top Account-actions (⋯) menu; External accounts moved back into the Wallets tab (only shown when a bank
           connection exists). *@
    </header>

    <InvitationsPanel />

    @if (_error is not null)
    {
        <div class="alert warn-bg"><strong>@Loc["Couldn’t do that."]</strong> <span>@_error</span><button class="alert-x" title="@Loc["Dismiss"]" aria-label="@Loc["Dismiss"]" @onclick="() => _error = null"><span aria-hidden="true">×</span></button></div>
    }

    <nav class="tabs">
        @* ⚠️ "Dashboard" is a LABEL change (O9). Tab.Overview and this file's name stay as they are — renaming the
           enum would touch every switch and every saved preference string for no gain the user can see. *@
        <button class="tab @(_tab == Tab.Overview ? "active" : "")" @onclick="() => _tab = Tab.Overview">@Loc["Dashboard"]</button>
        <button class="tab @(_tab == Tab.Budgets ? "active" : "")" @onclick="ShowExpensesTab">@Loc["Spending"]</button>
        <button class="tab @(_tab == Tab.Savings ? "active" : "")" @onclick="() => _tab = Tab.Savings">@Loc["Goals"]</button>
        <button class="tab @(_tab == Tab.Account ? "active" : "")" @onclick="() => _tab = Tab.Account">@Loc["Wallets"]</button>
    </nav>

    @{
        // A small "ⓘ" that explains a figure in plain language — tap to toggle (mobile) or hover the title (desktop).
        // Reused on every projection/simulator label so less confident users can see how the number is worked out.
        RenderFragment<(string Id, string Text)> infoTip = ctx =>
        @<span class="info-wrap">
            <button type="button" class="info-ico" title="@ctx.Text" @onclick="() => _openTip = _openTip == ctx.Id ? null : ctx.Id" @onclick:stopPropagation="true"><Icon Name="info" /></button>
            @if (_openTip == ctx.Id)
            {
                <span class="info-pop">@ctx.Text</span>
            }
        </span>;

        // Shared emoji picker for every add/edit modal (categories, funds, buckets, contributions).
        // Reads/writes the shared _fName/_fIcon fields; the first "auto" chip clears to a name-based guess.
        // Compact icon control: a button showing the current (or name-guessed) icon that sits next to the Name field
        // and toggles a collapsible palette below it. Clicking a swatch sets the icon and closes the palette.
        RenderFragment iconButton =
        @<button type="button" class="name-icon-btn @(_iconOpen ? "open" : "")" title="@Loc["Choose an icon"]" @onclick="() => _iconOpen = !_iconOpen"><CatIcon Name="@CategoryIcons.Effective(_fIcon, _fName)" /></button>;
        RenderFragment iconGrid =
        @<text>
            @if (_iconOpen)
            {
                var curIcon = _fIcon is null ? null : CategoryIcons.Effective(_fIcon, _fName);
                <div class="icon-grid">
                    <button type="button" class="icon-opt @(_fIcon is null ? "sel" : "")" title="@Loc["Auto (from name)"]" @onclick="@(() => { _fIcon = null; _iconOpen = false; })"><CatIcon Name="@(string.IsNullOrEmpty(_fName) ? CategoryIcons.Fallback : CategoryIcons.Guess(_fName))" /></button>
                    @foreach (var ic in CategoryIcons.Palette)
                    {
                        <button type="button" class="icon-opt @(curIcon == ic ? "sel" : "")" @onclick="@(() => { _fIcon = ic; _iconOpen = false; })"><CatIcon Name="@ic" /></button>
                    }
                </div>
            }
        </text>;
    }

    <div class="tab-content">
        <div class="tabpanel" hidden="@(_tab != Tab.Overview)">
            @{
                // First-run "Getting started" checklist. Steps auto-tick from real data, so it disappears on its
                // own as the user completes them; the × persists a dismiss so it never nags. Body-data flag.
                var obSteps = new (bool Done, string Icon, string Title, string Desc, Action Act)[]
                {
                    // Categories first: they're the foundation everything else (budgets, expenses) files into.
                    (State.CategoryOptions.Any(c => c.Depth > 0), "tag", Loc["Add categories"], Loc["Organise your spending with your own categories and sub-categories."], OpenManageCats),
                    (State.TotalContributed.Amount > 0m, "note", Loc["Add your income"], Loc["Tell TandemTab what's coming in this month."], OpenDeposit),
                    (State.TotalBudgeted.Amount > 0m, "target", Loc["Set a budget"], Loc["Cap a category so you know what's safe to spend."], OpenAddBudget),
                    (State.AllExpenses.Count > 0, "receipt", Loc["Log an expense"], Loc["Record your first spend — or import a statement."], OpenAddOrImport),
                    (State.SavingBuckets.Any(b => !b.Bucket.IsArchived), "coins", Loc["Create a savings bucket"], Loc["Set money aside — with or without a goal or debt to pay off."], OpenAddBucket),
                    (State.OtherMembers.Any(), "users", Loc["Invite a partner"], Loc["Share the budget in real time — invite your partner or housemate."], OpenInvite),
                };
                var obDone = obSteps.Count(s => s.Done);
                // "Active" = the two unmistakable in-use signals are both done: income added AND an expense logged.
                // Past that the full checklist stops headlining Home — it collapses to a small "finish setup" link that
                // expands on click (UX backlog #3). Before that (a fresh account) it shows in full.
                var obActive = obSteps[1].Done && obSteps[3].Done;
            }
            @* The current period's end date has passed — prompt to roll into the next month (carrying the balance
               forward). Only on the latest period (viewing a past one shouldn't nag), and only once it's genuinely
               ended (CanStartNextPeriod = CurrentPeriod.To < today). *@
            @if (State.IsLatestPeriod && State.CanStartNextPeriod)
            {
                <section class="panel period-ended">
                    <div class="period-ended-main">
                        <span class="period-ended-ico"><Icon Name="calendar" /></span>
                        <span class="period-ended-txt">
                            <strong>@string.Format(Loc["This period ended {0}."], State.Period.To.ToString("dd MMM"))</strong>
                            <span class="period-ended-sub">@Loc["Start next month to carry your balance forward and keep tracking."]</span>
                        </span>
                    </div>
                    <button class="period-ended-btn" @onclick="OpenNextPeriod"><Icon Name="arrow-right" /> @Loc["Start next month"]</button>
                </section>
            }
            @* Onboarding only headlines the FIRST period. A returning user who starts a second period shouldn't be
               re-onboarded just because this fresh period has no income logged yet (the "Add your income" step reads
               THIS period's contributions, which reset each period). Once there's a previous period, they've clearly
               used the app — the checklist retires. *@
            @if (!State.Account.OnboardingDismissed && obDone < obSteps.Length && State.PeriodCount <= 1)
            {
                @if (obActive && !_setupOpen)
                {
                    <div class="panel onboard-mini">
                        <button type="button" class="onboard-mini-link" @onclick="() => _setupOpen = true">
                            <span class="onboard-mini-ico"><Icon Name="check" /></span>
                            <span>@string.Format(Loc["Finish setup — {0} of {1} done"], obDone, obSteps.Length)</span>
                            <span class="onboard-go">›</span>
                        </button>
                        <button class="onboard-x" title="@Loc["Dismiss"]" aria-label="@Loc["Dismiss"]" @onclick="() => State.DismissOnboarding()"><span aria-hidden="true">×</span></button>
                    </div>
                }
                else
                {
                    <section class="panel onboard-card">
                        <div class="onboard-head">
                            <div>
                                <h2 class="onboard-h"><Icon Name="bulb" /> @Loc["Welcome! Let's get you set up"]</h2>
                                <p class="onboard-sub">@string.Format(Loc["{0} of {1} done — takes a couple of minutes."], obDone, obSteps.Length)</p>
                            </div>
                            @* Once active, the header control collapses back to the mini link (dismiss stays on that link);
                               on a fresh account it dismisses outright. *@
                            @if (obActive)
                            {
                                <button class="onboard-x" title="@Loc["Collapse"]" @onclick="() => _setupOpen = false">▾</button>
                            }
                            else
                            {
                                <button class="onboard-x" title="@Loc["Dismiss"]" aria-label="@Loc["Dismiss"]" @onclick="() => State.DismissOnboarding()"><span aria-hidden="true">×</span></button>
                            }
                        </div>
                        <div class="onboard-prog"><div class="onboard-prog-fill" style="width:@(obDone * 100 / obSteps.Length)%"></div></div>
                        <div class="onboard-steps">
                            @foreach (var s in obSteps)
                            {
                                <button class="onboard-step @(s.Done ? "done" : "")" @onclick="@(() => s.Act())" disabled="@s.Done">
                                    <span class="onboard-check">@if (s.Done) { <Icon Name="check" /> } else { <Icon Name="@s.Icon" /> }</span>
                                    <span class="onboard-body">
                                        <span class="onboard-title">@s.Title</span>
                                        <span class="onboard-desc">@s.Desc</span>
                                    </span>
                                    @if (!s.Done) { <span class="onboard-go">›</span> }
                                </button>
                            }
                        </div>
                    </section>
                }
            }
            @* Home's two everyday moves as plain buttons — no card frame (flattened). On mobile these hide and the
               floating quick-add ＋ (.qfab, below) takes over. Reference figures live in Spending / Wallets / Goals. *@
            <section class="cards cards-2 action-cards">
                <div class="tile-spend action-card">
                    @* Hovering the fast button reveals the most-used categories; clicking one opens Add-expense with
                       that category pre-selected. The button itself still opens the blank modal (and is the only path
                       on touch, where there's no hover). *@
                    @{ var homeRecentCats = State.RecentCategories(5); }
                    <div class="quick-spend">
                        <span class="card-act-row">
                            @* Only the Add-expense button reveals the quick-cats menu (qs-primary is the hover zone) —
                               hovering "Edit last" must not pop it, and the menu bridges the gap so it can't vanish. *@
                            <span class="qs-primary">
                                <button class="card-act card-act-spend" @onclick="OpenAddExpenseTab"><Icon Name="receipt" /> @Loc["Add expense"]</button>
                                @if (homeRecentCats.Count > 0)
                                {
                                    <div class="quick-cats" role="menu">
                                        <span class="quick-cats-label">@Loc["Quick add to"]</span>
                                        @foreach (var cid in homeRecentCats)
                                        {
                                            var catId = cid;
                                            <button type="button" class="quick-cat" role="menuitem" @onclick="() => OpenAddExpense(catId)"><CatIcon Name="@State.CategoryIcon(catId)" /> @State.CategoryName(catId)</button>
                                        }
                                    </div>
                                }
                            </span>
                            @* "Edit last" now lives inside the Add-expense modal (next to Repeat last). *@
                        </span>
                    </div>
                </div>
                <div class="savings action-card">
                    @if (State.IsPeriodOpen)
                    {
                        <span class="card-act-row">
                            <button class="card-act card-act-income" @onclick="OpenDeposit"><Icon Name="note" /> @Loc["Add income"]</button>
                            @* "Edit last" now lives inside the Add-income modal. *@
                        </span>
                    }
                </div>
                @* Third everyday move. Only rendered when there is somewhere to transfer to — with a single fund and
                   no second account the form has no destination, and a button that opens a dead end is worse than
                   no button. The row falls back to two columns in that case (see .action-cards). *@
                @if (CanTransfer)
                {
                    <div class="tile-transfer action-card">
                        <span class="card-act-row">
                            <button class="card-act card-act-transfer" @onclick="OpenTransferFromDefaultFund"><Icon Name="swap" /> @Loc["Transfer"]</button>
                        </span>
                    </div>
                }
            </section>

            @* ★ While a trip is running it sits directly under the three everyday actions — above the score, the
               money glance and everything else on the tab. Not at the very top: the actions are what someone opens
               the app to DO, and a card you read shouldn't come before the buttons you press. Everything below it
               is being distorted by the trip, so the card that explains that belongs ahead of them.
               ★ No dismiss and no pulse. It is self-limiting: it appears the morning the trip starts and is gone
               the moment the trip is over, so there is nothing to dismiss, and a glow above the fold for eight
               straight days would be the nag this whole feature exists not to be.
               The week recap keeps its old slot further down and is suppressed for the duration — displaced into
               the bell, never destroyed. *@
            @if (State.ActiveTrip is { } liveTrip && State.TripRecap(liveTrip.Id) is { } liveRecap)
            {
                var tripDay = liveTrip.DayOn(State.TodayDate) ?? 1;
                // Day 1 of 1 must read as a full bar, not 100% of nothing — hence day/length, both ends inclusive.
                var tripDayPct = Math.Clamp(tripDay * 100.0 / liveTrip.LengthInDays, 0, 100);
                // The spend bar is capped at 100% so an overspend can't run the fill off the end of the card; the
                // figure beside it is what states the overspend, and it is not clamped.
                var tripSpendPct = liveRecap.HasBudget
                    ? Math.Clamp((double)(liveRecap.Spent.Amount / liveRecap.Budget!.Value) * 100.0, 0, 100)
                    : 0.0;
                <section class="trip-hero @(liveRecap.IsOverBudget ? "over" : "")">
                    <button type="button" class="trip-hero-hit" @onclick="() => ShowTripsTab(liveTrip.Id)" title="@Loc["See the whole trip"]">
                        <div class="trip-hero-head">
                            <span class="trip-hero-mark">@TripMark(liveTrip.Icon)</span>
                            <span class="trip-hero-id">
                                <span class="trip-hero-name">@liveTrip.Name</span>
                                <span class="trip-hero-when">
                                    @string.Format(Loc["Day {0} of {1}"], tripDay, liveTrip.LengthInDays)@(string.IsNullOrWhiteSpace(liveTrip.Destination) ? "" : " · " + liveTrip.Destination)
                                </span>
                            </span>
                            <span class="trip-hero-go" aria-hidden="true">›</span>
                        </div>
                        @* How far through the trip you are. Days, not money — it is the one bar on this card that
                           cannot be behind or ahead of anything, so it reads as pure context for the two that can. *@
                        <div class="trip-hero-days" aria-hidden="true"><span class="trip-hero-days-fill" style="width:@F(tripDayPct)%"></span></div>
                        <div class="trip-hero-figs">
                            <span class="trip-hero-fig">
                                <span class="trip-hero-lbl">@Loc["So far"]</span>
                                <strong>@Fmt(liveRecap.Spent)</strong>
                            </span>
                            @if (liveRecap.AgainstBudget is { } tripLeft)
                            {
                                <span class="trip-hero-fig trip-hero-fig-end">
                                    <span class="trip-hero-lbl">@string.Format(Loc["of {0} planned"], Fmt(State.Money(liveRecap.Budget!.Value)))</span>
                                    <strong>@string.Format(liveRecap.IsOverBudget ? Loc["{0} over"] : Loc["{0} left"], Fmt(State.Money(Math.Abs(tripLeft.Amount))))</strong>
                                </span>
                            }
                        </div>
                        @if (liveRecap.HasBudget)
                        {
                            <div class="trip-hero-bar" aria-hidden="true"><span class="trip-hero-bar-fill" style="width:@F(tripSpendPct)%"></span></div>
                        }
                        @* The split is stated on the card, not left to be discovered on the Trips tab: this headline
                           is the one figure in the app that deliberately does NOT mean "what I spent this week" — a
                           flight bought in March is inside it. One line, where the number is actually read. *@
                        @if (!liveRecap.PrePaid.IsZero)
                        {
                            <small class="trip-hero-split">@string.Format(Loc["{0} booked ahead · {1} while away"], Fmt(liveRecap.PrePaid), Fmt(liveRecap.OnTrip))</small>
                        }
                    </button>
                </section>
            }

            @{ var ovBand = ov.Band switch { HealthBand.Healthy => "score-ok", HealthBand.Average => "score-warn", _ => "score-bad" }; }
            @* Just the score header on Home now — a tap opens the modal for the detail (verdict, quick wins, savings
               rate, spending trend, and the per-category trends-over-time sparklines that used to sit here). Moving the
               sparklines into the modal keeps the landing screen light (UX reorg). The urgent "needs attention" strip
               is attached directly below (see home-alerts), so the whole "how am I doing" block reads as one. *@
            <section class="home-health">
                <button id="home-score" class="card card-score card-score-wide home-health-hd" @onclick="OpenHealthScore" title="@Loc["Health score"]">
                    <span class="card-label">@Loc["Health score & trends"] <ProLock Feature="@PlanFeatures.Insights" Static="true" /></span>
                    <span class="card-value @ovBand">@(ov.HasData ? ov.Score.ToString() : "—")</span>
                    <span class="card-sub">@(ov.HasData ? N(ov.Verdict) : "")</span>
                </button>
                @{
                    // Everything the lower Home blocks need, computed once. The urgent "needs attention" items sit
                    // attached under the score (Move 3); the money-glance row + targets read from the rest.
                    var homeTargets = HomeTargets();
                    var homeAlerts = notifications.Where(n => n.Urgent).ToList();
                    var homeSlices = HomePeriodSlices();
                    var homeSpendTotal = homeSlices.Sum(s => s.Amount);
                    var runway = State.IsLatestPeriod ? State.ProjectCashFlow(_balCur) : null;
                }
                @* Urgent "needs attention" strip, attached directly under the score so "how am I doing" reads as one
                   block. The gentler bills-due + suggestions stay in the bell (its badge signals them) — no Home link
                   for them, and never duplicated here (UX backlog #4). When several alerts of a kind exist (e.g. many
                   over-budget categories) the shown one carries a ↻ to cycle the rest. *@
                @if (homeAlerts.Count > 0)
                {
                    <div class="home-alerts">
                        @foreach (var n in homeAlerts)
                        {
                            <div class="home-alert @n.ActionClass">
                                <span class="home-alert-ico">@IconOrEmoji(n.Icon)</span>
                                <div class="home-alert-body">
                                    @if (n.Rich is { } rich)
                                    {
                                        <span class="home-alert-text">@rich</span>
                                    }
                                    else
                                    {
                                        <span class="home-alert-text">@n.Text</span>
                                        @if (n is { ActionLabel: { } al, Act: { } act })
                                        {
                                            <button class="home-alert-act @n.ActionClass" @onclick="@(() => act())">@al</button>
                                        }
                                    }
                                </div>
                                @* When this alert is one of several of its kind (e.g. several over-budget categories), a
                                   ↻ cycles to the next — so the others aren't stuck behind the single shown tip. *@
                                @if (n.Rotate is { } rot)
                                {
                                    <button class="home-alert-rot" title="@Loc["Show the next one"]" @onclick="rot"><Icon Name="rotate" /></button>
                                }
                            </div>
                        }
                    </div>
                }
            </section>

            @* F7 "your week in money" — the last COMPLETED week, at most once a week, dismissed for good with a tap.
               Deliberately not a permanent Home section: it is absent six days out of seven, which is the only reason
               a recap can sit above the fold without becoming another panel to scroll past. Nothing here is computed
               that the Breakdown doesn't already show — it's a read-out, so it can re-engage without making a claim. *@
            @* The card is now a BUTTON that opens the full recap. It keeps only the headline — spent, the
               comparison, and where most of it went — because the card's job is to be worth a tap, and a card
               that already says everything is a section by another name (the thing this deliberately isn't).
               The ✕ keeps its own click, stopping propagation, so dismissing never opens what you're dismissing. *@
            @* The trip card used to sit here, in the week recap's slot. It now leads the whole tab — see the
               .trip-hero block at the top of this panel. The week keeps this slot and is still SUPPRESSED while a
               trip runs (it moves into the bell for the duration, the same place the ✕ sends it), because both
               cards answer "what has money been doing lately" and the trip you are living through wins. *@
            @if (State.ActiveTrip is null && WeekRecapToShow() is { } recap)
            {
                var recapDown = recap.Change.IsNegative;
                <section class="week-recap week-recap-glow">
                    <button type="button" class="week-recap-hit" @onclick="() => _modal = Modal.WeekRecap" title="@Loc["See the whole week"]">
                        <div class="week-recap-head">
                            <span class="week-recap-title"><Icon Name="calendar" /> @Loc["Your week in money"]</span>
                            <span class="week-recap-dates">@recap.From.ToString("d MMM") – @recap.To.ToString("d MMM")</span>
                            <span class="week-recap-go" aria-hidden="true">›</span>
                        </div>
                        <div class="week-recap-body">
                            <div class="week-recap-fig">
                                <span class="week-recap-lbl">@Loc["Spent"]</span>
                                <strong>@Fmt(recap.Spent)</strong>
                                @* Only against a week that actually had spending — "100% less than last week" for a first
                                   week of use is noise wearing the costume of an insight. *@
                                @if (recap.HasComparison)
                                {
                                    <small class="@(recapDown ? "good-text" : "warn-text")">
                                        @string.Format(recapDown ? Loc["{0} less than the week before"] : Loc["{0} more than the week before"], Fmt(Math.Abs(recap.Change.Amount)))
                                    </small>
                                }
                            </div>
                            @if (recap.TopCategoryId is { } topCat)
                            {
                                <div class="week-recap-fig">
                                    <span class="week-recap-lbl">@Loc["Most of it"]</span>
                                    <strong><CatIcon Name="@State.CategoryIcon(topCat)" /> @State.CategoryName(topCat)</strong>
                                    <small>@Fmt(recap.TopCategorySpent)</small>
                                </div>
                            }
                            @if (recap.Saved.Amount > 0m)
                            {
                                <div class="week-recap-fig">
                                    <span class="week-recap-lbl">@Loc["Set aside"]</span>
                                    <strong class="good-text">@Fmt(recap.Saved)</strong>
                                </div>
                            }
                        </div>
                    </button>
                    <button class="week-recap-x" title="@Loc["Dismiss"]" aria-label="@Loc["Dismiss"]"
                            @onclick="DismissWeekRecap" @onclick:stopPropagation="true"><Icon Name="x" /></button>
                </section>
            }

            @* Money-glance row (Move 1): "where your money went" + "at this rate" side by side — half the row each on
               desktop, stacking on mobile. When the runway's "show the math" opens it breaks to full width.
               The donut (UX backlog #6) promotes the full Breakdown; tap it to jump in. Hidden until there's spend. *@
            @if (homeSpendTotal > 0m || runway is not null)
            {
                <div class="home-glance">
                @if (homeSpendTotal > 0m)
                {
                <section class="panel home-brk-card">
                    <button class="home-brk-hit" @onclick="OpenBreakdown">
                        <span class="home-brk-donut-wrap">
                            <svg class="home-brk-donut" viewBox="0 0 120 120" role="img" aria-label="@Loc["Where your money went"]">
                                @if (homeSlices.Count == 1)
                                {
                                    <circle cx="60" cy="60" r="47" fill="none" stroke="@homeSlices[0].Color" stroke-width="18" />
                                }
                                else
                                {
                                    double hacc = 0;
                                    @foreach (var s in homeSlices)
                                    {
                                        var sweep = (double)(s.Amount / homeSpendTotal) * 100.0;
                                        var d = DonutArc(hacc, sweep, 60, 60, 56, 38);
                                        <path d="@d" fill="@s.Color"><title>@s.Label</title></path>
                                        hacc += sweep;
                                    }
                                }
                                <text x="60" y="59" text-anchor="middle" class="home-brk-total">@Fmt(State.Money(homeSpendTotal))</text>
                                @* The ring is the sum of its own slices, and those are spending again — so the word
                                   under the figure is "spent". It said "used" while savings were in the ring (O6b)
                                   and "out" while payouts were; the figure and its label have to move together or
                                   the chart contradicts its own title. *@
                                <text x="60" y="73" text-anchor="middle" class="home-brk-sub">@Loc["spent"]</text>
                            </svg>
                        </span>
                        <span class="home-brk-body">
                            <span class="home-brk-title">@Loc["Where your money went"]</span>
                            <span class="home-brk-legend">
                                @foreach (var s in homeSlices.Take(4))
                                {
                                    <span class="home-brk-leg">
                                        <span class="home-brk-dot" style="background:@s.Color"></span>
                                        <span class="home-brk-leg-name">@s.Label</span>
                                        <span class="home-brk-leg-amt">@Fmt(State.Money(s.Amount))</span>
                                    </span>
                                }
                            </span>
                            <span class="home-brk-cta">@Loc["See full breakdown"] ›</span>
                        </span>
                    </button>
                </section>
                }
                @if (runway is { } rw)
                {
                <section class="panel runway-card @(rw.FirstShortfallMonth is null ? "" : "runway-warn")">
                    <div class="runway-row">
                        <span class="runway-ico"><Icon Name="@(rw.FirstShortfallMonth is null ? "shield" : "alert")" /></span>
                        @* "At this rate" up front, and the basis always named. The old headline ("You're good for
                           the next 6 months") read as a promise, when it only means "at your recent average the
                           balance never went negative over the months I looked ahead" — the user rightly asked how
                           they could be sure it holds. So the qualifier leads, and the sub-line says exactly what the
                           numbers rest on: an average of your last N closed months, or your declared recurring bills.
                           The committed figure stays off here (it reads better per bucket on Goals). *@
                        <span class="runway-text">
                            @if (rw.FirstShortfallMonth is { } sm)
                            {
                                <strong>@string.Format(Loc["At this rate, money runs short in {0}"], sm.ToString("MMM yyyy"))</strong>
                            }
                            else if (rw.Months[0].Income - rw.Months[0].Spending >= 0)
                            {
                                @* Surplus: the balance isn't running down at all — saying it "lasts N months" undersells
                                   and would contradict the math panel's positive net line. Say what's true. *@
                                <strong>@Loc["At this rate, your balance keeps growing"]</strong>
                            }
                            else
                            {
                                @* Declining but survives the whole horizon — it lasts beyond it, not "about" it. *@
                                <strong>@string.Format(Loc["At this rate, your balance lasts beyond {0} months"], rw.Months.Count)</strong>
                            }
                            <span class="runway-sub">
                                @{
                                    // The demonstrated basis averages every actual movement (including one-off spending),
                                    // so it's a fair runway. The recurring basis only knows declared bills — it can't see
                                    // day-to-day spending, so it will read optimistically; say so plainly rather than let
                                    // "covered" imply everything is accounted for.
                                    var basisNote = rw.Basis == CashFlowBasis.Recurring
                                        ? Loc["counts recurring bills only — not day-to-day spending"]
                                        : State.CompletedPeriodCount == 1
                                            ? Loc["based on your last month"]
                                            : string.Format(Loc["based on your last {0} months"], State.CompletedPeriodCount);
                                }
                                @basisNote · @string.Format(Loc["{0} in, {1} out a month"],
                                    Fmt(rw.Months[0].Income), Fmt(rw.Months[0].Spending))@(rw.HasUnknownAmounts ? " · " + Loc["some bills have no amount yet"] : "")
                            </span>
                            @* "Show the math" — the anti-black-box move: no AI, so we can show exactly how the number is
                               built and let you nudge the inputs. Opens a modal (an inline expand shifted the whole page). *@
                            <button type="button" class="runway-toggle" @onclick="OpenRunwayMath">
                                @Loc["Show the math"] <span class="runway-caret">›</span>
                            </button>
                        </span>
                    </div>
                </section>
                }
                </div>
            }
            @if (homeTargets.Count > 0)
            {
                <section class="panel targets-card">
                    <h2 class="targets-h"><Icon Name="target" /> @Loc["You're on track for"]</h2>
                    <div class="targets-list">
                    @* ★ The banked "ahead / interest saved" badge used to live on the debt row here (O8). It now sits
                       on the debt bucket itself, beside "interest left" — the loan it is about, with the prepaid
                       principal that earned it. Home keeps what Home is for: the projected debt-free DATE. That also
                       ends a quiet lie: this row's badge read the account-level aggregate, which sums interest over
                       every loan and takes the longest lead, so with two debts it stated a pair of numbers that
                       belonged to neither of them. Every target row now has one shape. *@
                    @foreach (var t in homeTargets)
                        {
                            <div class="target-row">
                                <CatIcon Name="@t.Icon" />
                                <span class="target-name">@t.Name</span>
                                @if (t.Reached)
                                {
                                    <span class="target-when"><strong class="target-date good-text"><Icon Name="trophy" /> @Loc["reached"]</strong></span>
                                }
                                else
                                {
                                    <span class="target-when">
                                        <strong class="target-date">@PayoffDate(t.Months)</strong>
                                        <span class="target-mo">@MonthsText(t.Months)</span>
                                        @if (t.InterestSaved > 0m)
                                        {
                                            <span class="target-mo good-text" title="@Loc["Interest you save versus paying only the installments, if you keep this pace."]">· @string.Format(Loc["save {0} interest"], Fmt(t.InterestSaved))</span>
                                        }
                                    </span>
                                }
                            </div>
                        }
                    </div>
                    <div class="targets-foot">@Loc["Projections at your current pace — they don't move real money."]</div>
                </section>
            }

            @{ var milestones = HomeMilestones(); }
            @if (milestones.Count > 0)
            {
                @* One line, not a panel of bars: the full progress lives in the 🏆 Achievements modal, so Home just
                   points to it rather than stacking a second motivational section under "You're on track for". *@
                <button class="home-ms-line" @onclick="() => _modal = Modal.Achievements">
                    <span class="home-ms-lead"><Icon Name="trophy" /> @Loc["Milestones in progress"]</span>
                    <span class="home-ms-n">@milestones.Count</span>
                    <span class="home-ms-arrow">›</span>
                </button>
            }

            @if (!ov.HasData)
            {
                <section class="panel insight-empty">
                    <p><Icon Name="chart" /> @Loc["Log some income or expenses to see your account overview here."]</p>
                </section>
            }
        </div>
        <div class="tabpanel" hidden="@(_tab != Tab.Account)">
            @* Wallets leads with the money — funds, then bank, then income — and closes with People. The deficit
               warning that used to sit here now shows on Home, where the eye lands first. *@
            <section class="panel">
                <div class="spending-head">
                    <span class="insight-h">@Loc["Where your money is"]@if (LiveBalancePending) { <span class="bal-refreshing" title="@Loc["Updating live balance…"]"></span> }</span>
                    <span class="wallet-head-actions">
                        <button class="fund-add" @onclick="OpenAddFund"><Icon Name="plus" /> @Loc["Add a fund"]</button>
                        @* External accounts (bank connection) — an account-level manage button at the right end,
                           only when a bank connection exists. Transactions awaiting review are surfaced by the
                           review icon next to the notifications bell, not here. *@
                        @if (_bankStatus?.Enabled == true)
                        {
                            <button class="fund-add" @onclick="ShowBankTab"><Icon Name="bank" /> @Loc["External accounts"]</button>
                        }
                    </span>
                </div>
                @{
                    var funds = State.RootFunds.ToList();
                    var _fundBals = funds.ToDictionary(
                        f => f.Id,
                        f => State.FundIsSynced(f.Id) ? SyncedFundDisplay(f.Id).Amount : State.FundBalance(f.Id));

                    // Per-fund colour: the synced fund is gold, an overdrawn one is red, a near-empty one gets a dashed
                    // (no-slice) swatch, and each remaining fund draws the next colour from a small palette so adjacent
                    // donut slices stay distinguishable (part-to-whole → categorical colour is the right call here).
                    var fundColor = new Dictionary<Guid, string>();
                    int _pi = 0;
                    foreach (var f in funds)
                    {
                        var amt = _fundBals[f.Id].Amount;
                        if (State.FundIsSynced(f.Id)) fundColor[f.Id] = "#eab308";
                        else if (amt < 0m) fundColor[f.Id] = "#dc2626";
                        else if (amt < 1m) fundColor[f.Id] = "";                 // near-empty: dashed swatch, no slice
                        else fundColor[f.Id] = FundPalette[_pi++ % FundPalette.Length];
                    }

                    // Donut geometry: each positive fund's arc = its share of the total money. r=70 → circumference ≈ 439.82.
                    var inv = System.Globalization.CultureInfo.InvariantCulture;
                    const double C = 439.82;
                    var totalPos = funds.Sum(f => Math.Max(0m, _fundBals[f.Id].Amount));
                    var slices = new List<(string Color, string Dash, string Off)>();
                    double _acc = 0;
                    foreach (var f in funds)
                    {
                        var amt = _fundBals[f.Id].Amount;
                        if (totalPos <= 0m || amt < 1m) continue;               // only positive funds get a slice
                        double len = (double)(amt / totalPos) * C;
                        double vis = Math.Max(0, len - 2);                      // 2px gap between slices
                        slices.Add((fundColor[f.Id],
                            $"{vis.ToString("0.##", inv)} {(C - vis).ToString("0.##", inv)}",
                            (-_acc).ToString("0.##", inv)));
                        _acc += len;
                    }
                    var singleSlice = slices.Count == 1;                        // one fund holds everything → full ring
                }
                <div class="fund-panel">
                    <svg class="fund-donut" viewBox="0 0 180 180" role="img" aria-label="@Loc["Where your money is"]">
                        <circle cx="90" cy="90" r="70" fill="none" stroke-width="26" class="fund-donut-track" />
                        <g transform="rotate(-90 90 90)" fill="none" stroke-width="26">
                            @if (singleSlice)
                            {
                                <circle cx="90" cy="90" r="70" stroke="@slices[0].Color" />
                            }
                            else
                            {
                                @foreach (var s in slices)
                                {
                                    <circle cx="90" cy="90" r="70" stroke="@s.Color" stroke-dasharray="@s.Dash" stroke-dashoffset="@s.Off" />
                                }
                            }
                        </g>
                        @* The running total balance — it used to headline the top account bar; now the Wallets donut is
                           its home (UX backlog: total moved out of the header), so it's labelled explicitly here. *@
                        @* On a closed/past period this is a final figure, not the live balance — label it "Closed with"
                           (matching the hero) and use the ledger closing (no bank-adjust — the live balance is now). *@
                        <text x="90" y="76" text-anchor="middle" class="fund-donut-cap">@(State.IsPeriodOpen ? Loc["Total balance"] : Loc["Closed with"])</text>
                        <text x="90" y="96" text-anchor="middle" class="fund-donut-total">@Fmt(State.IsPeriodOpen ? State.DisplayClosingBalance(_bankStatus?.Balance, _bankStatus?.BalanceCurrency) : State.ClosedFundTotal)</text>
                        <text x="90" y="112" text-anchor="middle" class="fund-donut-sub">@(State.IsPeriodOpen ? string.Format(Loc["across {0} funds"], funds.Count) : State.Period.To.ToString("dd MMM yyyy"))</text>
                    </svg>
                    @{
                        // A fund is "empty" (collapsible) when it holds ~nothing and isn't a synced/overdrawn one —
                        // those two always stay visible. If every fund is empty there's nothing to hide, so show all.
                        bool IsEmptyFund(Guid id) => !State.FundIsSynced(id) && _fundBals[id].Amount >= 0m && _fundBals[id].Amount < 1m;
                        var emptyFunds = funds.Where(f => IsEmptyFund(f.Id)).ToList();
                        var collapseEmpty = emptyFunds.Count > 0 && emptyFunds.Count < funds.Count && !_showEmptyFunds;
                    }
                    <div class="fund-legend">
                        @foreach (var f in funds)
                        {
                            var fid = f.Id;
                            if (collapseEmpty && IsEmptyFund(fid)) { continue; }
                            var synced = State.FundIsSynced(fid);
                            var bal = _fundBals[fid];
                            var note = State.FundNote(fid);
                            var over = bal.Amount < 0m;
                            var empty = string.IsNullOrEmpty(fundColor[fid]);
                            <div class="fund-row@(over ? " over" : "")">
                                <span class="fund-sw@(empty ? " empty" : "")" style="@(empty ? "" : $"background:{fundColor[fid]}")"></span>
                                <button class="fund-row-name" title="@(string.IsNullOrEmpty(note) ? Loc["Actions"] : note)" @onclick="() => ToggleFundMenu(fid)">
                                    @if (synced) { <span class="fund-row-ico"><Icon Name="link" /></span> } else { <CatIcon Name="@State.FundIcon(fid)" /> } @f.Name
                                </button>
                                @* ★ A foreign-cash wallet says what it holds in BOTH currencies. The account figure
                                   is the one every total is built from, so it stays the headline; the foreign one
                                   is what you can actually count in your hand, which is the question you open the
                                   wallets list to answer while you are away.
                                   Derived from the wallet's current rate on purpose — unlike an expense, which
                                   records what was typed, a BALANCE is a live figure and the current rate is the
                                   right lens for "what is left". *@
                                <span class="fund-row-amt" title="@(synced ? SyncedFundDisplay(fid).Title : "")">@Fmt(bal)@if (State.ForeignFund(fid) is { } fxF && bal.Amount != 0m)
                                    {
                                        <small class="fund-row-fx">@CurrencyInfo.Symbol(fxF.Currency)@decimal.Round(bal.Amount / fxF.Rate!.Value, 2).ToString("0.00")</small>
                                    }</span>
                                @* The two common actions — move money out, log money in — sit next to the ⋯ (the menu
                                   keeps Movements / Edit / Archive). Only for a spendable, non-synced fund in an open
                                   period. The cluster is a fixed width so every row's amount lines up in one column
                                   whether or not it carries the action buttons (a synced fund has none). *@
                                <span class="fund-row-acts">
                                    @if (!synced && State.IsPeriodOpen)
                                    {
                                        @if (CanTransfer)
                                        {
                                            <button class="exp-edit" title="@Loc["Transfer"]" @onclick="() => OpenTransferFromFund(fid)"><Icon Name="swap" /></button>
                                        }
                                        <button class="exp-edit" title="@Loc["Add income"]" @onclick="() => OpenDepositToFund(fid)"><Icon Name="plus" /></button>
                                    }
                                    <button class="fund-row-more" title="@Loc["Actions"]" @onclick="() => ToggleFundMenu(fid)">⋯</button>
                                </span>
                                @if (_fundMenuId == fid) { @FundCircleMenu(fid) }
                            </div>
                        }
                        @if (emptyFunds.Count > 0 && emptyFunds.Count < funds.Count)
                        {
                            <button type="button" class="fund-empty-toggle" @onclick="() => _showEmptyFunds = !_showEmptyFunds">
                                @(_showEmptyFunds
                                    ? Loc["Hide empty funds"]
                                    : string.Format(emptyFunds.Count == 1 ? Loc["+ {0} empty fund"] : Loc["+ {0} empty funds"], emptyFunds.Count))
                            </button>
                        }
                    </div>
                </div>
            </section>

            @if (MergedTransfers().Count > 0)
            {
                var transfers = MergedTransfers();
                <section class="panel">
                    <div class="panel-head">
                        <h2><Icon Name="repeat" /> @Loc["Money moved"]</h2>
                        <small class="hint">@Loc["Use a fund's ⇄ button to move money."]</small>
                    </div>
                    @if (transfers.Any())
                    {
                        <ul class="list list-even transfer-log">
                            @foreach (var t in transfers)
                            {
                                <li>
                                    <span class="row-main row-stack">
                                        <span class="row-title"><span class="row-title-txt">@t.Label</span>@if (t.AutoFiled) { <span class="row-note" title="@AutoFiledTransferTitle(t.Note)"><Icon Name="bank" Class="ic-s" /></span> }</span>
                                        <span class="row-sub">
                                            <span>@t.Date.ToString("dd MMM")</span>
                                            @if (!string.IsNullOrEmpty(t.Note)) { <span class="sub-note">@t.Note</span> }
                                        </span>
                                    </span>
                                    <span class="amt">@Fmt(t.Amount)</span>
                                    <span class="row-actions">
                                        @if (State.IsPeriodOpen && !t.IsExternal)
                                        {
                                            <button class="exp-edit" title="@Loc["Edit transfer"]" @onclick="() => OpenEditTransfer(t.Id)"><Icon Name="pencil" /></button>
                                            <button class="exp-edit" title="@Loc["Remove transfer"]" @onclick="() => OpenDeleteTransfer(t.Id)"><Icon Name="trash" /></button>
                                        }
                                        else if (State.IsPeriodOpen && t.IsExternal)
                                        {
                                            @* A transfer that can find its other half is edited and removed as ONE
                                               movement. The one-sided route survives only for rows that genuinely
                                               have no counterpart to touch (savings disbursements, and transfers
                                               recorded before the two halves were linked). *@
                                            var xt = State.FindExternalTransfer(t.Id);
                                            @if (xt is not null && State.IsLinkedAccountTransfer(xt))
                                            {
                                                <button class="exp-edit" title="@Loc["Edit transfer"]" @onclick="() => OpenEditAccountTransfer(t.Id)"><Icon Name="pencil" /></button>
                                                <button class="exp-edit" title="@Loc["Remove transfer"]" @onclick="() => OpenDeleteAccountTransfer(t.Id)"><Icon Name="trash" /></button>
                                            }
                                            else
                                            {
                                                <button class="exp-edit" title="@Loc["Remove this transfer (does not reverse the deposit in the other account)"]" @onclick="() => OpenDeleteExternalTransfer(t.Id)"><Icon Name="trash" /></button>
                                            }
                                        }
                                    </span>
                                </li>
                            }
                        </ul>
                    }
                </section>
            }

            <section class="panel">
                <div class="spending-head">
                    <h2>@Loc["Income"]</h2>
                    @if (State.IsPeriodOpen)
                    {
                        <button class="fund-add" @onclick="OpenDeposit"><Icon Name="plus" /> @Loc["Add income"]</button>
                    }
                    <span class="spending-sub">@Fmt(State.TotalContributed) @Loc["this period"]</span>
                    @if (State.IsPeriodOpen)
                    {
                        <span class="head-actions">
                            <button class="link" title="@Loc["Manage categories"]" @onclick="OpenManageContribCats"><Icon Name="tag" /></button>
                        </span>
                    }
                </div>

                <ul class="list list-even">
                    @foreach (var c in State.ContributionsThisPeriod)
                    {
                        var cid = c.Id;
                        <li class="row-menu-host">
                            <span class="row-main row-stack">
                                <span class="row-title"><CatIcon Name="@State.ContributionCategoryIcon(c.CategoryId)" /> <span class="row-title-txt">@ContribCatDisplay(c.CategoryId)</span></span>
                                <span class="row-sub">
                                    <span>@c.Date.ToString("dd MMM")</span>
                                    <span class="sub-to"><Avatar Name="@State.MemberName(c.MemberId)" Picture="@State.MemberAvatar(c.MemberId)" Size="18" /> @State.MemberName(c.MemberId)@(State.IsRealUser(c.MemberId) ? "" : $" ({Loc["imported"]})")</span>
                                    <span class="sub-to">@Loc["to"] <CatIcon Name="@State.FundIcon(c.FundId)" /> @State.FundName(c.FundId)</span>
                                </span>
                            </span>
                            <span class="amt credit">@Fmt(c.Paid)</span>
                            <span class="row-actions">
                                @* Only two actions — show them directly rather than behind a ⋯ menu (matches the expense rows). *@
                                @if (State.IsPeriodOpen && State.CanHandleContribution(c))
                                {
                                    <button class="exp-edit" title="@Loc["Edit"]" @onclick="() => OpenEditDeposit(cid)"><Icon Name="pencil" /></button>
                                    <button class="exp-edit" title="@Loc["Remove"]" @onclick="() => OpenDeleteDeposit(cid)"><Icon Name="trash" /></button>
                                }
                            </span>
                        </li>
                    }
                    @if (!State.ContributionsThisPeriod.Any())
                    {
                        <li><em>@Loc["Nothing on the tab yet — add a contribution."]</em></li>
                    }
                </ul>
            </section>

        </div>
        <div class="tabpanel" hidden="@(_tab != Tab.Budgets)">
            <section class="panel">
                @{
                    var _bnFree = State.DisplayFreeToAllocate(_bankStatus?.Balance, _bankStatus?.BalanceCurrency);
                    var _bnRemaining = State.TotalBudgeted - State.TotalSpent;
                    var overPlanned = _bnRemaining - _bnFree;
                }
                @{
                    // Top-level categories only — sub-categories roll up into their parent's ring.
                    // Rings (and bar segments) are ordered by spend, largest first — where the money actually went.
                    var budgeted = State.CategoryOptions
                        .Where(c => c.Depth == 0 && State.HasBudget(c.Category.Id))
                        .OrderByDescending(c => State.Coverage(c.Category.Id).Spent.Amount)
                        .ToList();
                    var unbudgeted = State.CategoryOptions
                        .Where(c => !State.HasBudget(c.Category.Id)
                                    && State.SpentInCategory(c.Category.Id).Amount > 0)
                        .OrderByDescending(c => State.SpentInCategory(c.Category.Id).Amount)
                        .ToList();

                    // Gate for the totals summary: there's something to sum once any budget or spend exists.
                    var barScale = Math.Max(State.TotalBudgeted.Amount, State.TotalSpent.Amount);

                    // Rings, budgeted and unbudgeted together, ordered by spend — biggest first — so the grid reads in
                    // the same order as the bar. Budgeted with no spend fall to the end (they still show their ring).
                    var ringCards = budgeted.Select(b => (Cat: b.Category, HasBudget: true, Spent: State.Coverage(b.Category.Id).Spent.Amount))
                        .Concat(unbudgeted.Select(u => (Cat: u.Category, HasBudget: false, Spent: State.SpentInCategory(u.Category.Id).Amount)))
                        .OrderByDescending(x => x.Spent)
                        .ToList();
                }
                @* View switch + add action + the ⋯ tools — the fixed anchor at the top of the panel. The summary
                   header and the content below swap per view, so switching to Breakdown (which has no budget header)
                   never yanks the switch upward. *@
                @* Summary on top, styled like the Goals tab's "Saved this period" header; the view switches sit
                   below it (mirroring goal-summary → goal-filters). *@
                <div class="goal-summary spend-summary">
                    @* The view switch leads this row on EVERY view (no per-view stat ahead of it) so it stays fixed in
                       place as you switch tabs; the add-action + ⋯ stay pinned to its right. The By-date period-spend
                       total moved down onto the By-date controls row. *@
                    @* ★ O6(c): Breakdown and Trends are no longer chips in this row. They are the two ANALYSIS views
                       — a window over months, with their own range chips — sitting among three views of the current
                       period's ledger, and the switcher was carrying five (six with a trip) on a phone. The door is
                       the Home chart card, which already lands here (`OpenBreakdown`); while you are in one of them
                       the row becomes their own two-chip header with the way back leading it, the same shape
                       `.brk-drill` uses to get out of a drilled category. *@
                    @{ var _analysing = _spendView is SpendView.Breakdown or SpendView.Trends; }
                    @if (_analysing)
                    {
                        <span class="plan-toggle bview-toggle spend-view-toggle" role="group">
                            @* The arrow is wrapped in a span THIS component owns: scoped CSS stamps its attribute on
                               the last element of a selector, and an <Icon>'s <svg> carries Icon's scope, not the
                               Dashboard's — `.chip-back svg` would match nothing at all. *@
                            <button type="button" class="chip" @onclick="() => _spendView = SpendView.ByDate"><span class="chip-back-ic"><Icon Name="arrow-right" /></span> @Loc["Spending"]</button>
                            <button type="button" class="chip @(_spendView == SpendView.Breakdown ? "on" : "")" @onclick="() => _spendView = SpendView.Breakdown"><Icon Name="pie" /> @Loc["Breakdown"]</button>
                            <button type="button" class="chip @(_spendView == SpendView.Trends ? "on" : "")" @onclick="ShowTrends"><Icon Name="pulse" /> @Loc["Trends"] <ProLock Feature="@PlanFeatures.Insights" Static="true" /></button>
                        </span>
                    }
                    else
                    {
                        <span class="plan-toggle bview-toggle spend-view-toggle" role="group">
                            <button type="button" class="chip @(_spendView == SpendView.ByDate ? "on" : "")" @onclick="() => _spendView = SpendView.ByDate"><Icon Name="list" /> @Loc["By date"]</button>
                            <button type="button" class="chip @(_spendView == SpendView.Categories ? "on" : "")" @onclick="SwitchToByBudgets"><Icon Name="chart" /> @Loc["By budgets"]</button>
                            @* Always here (owner's call). It used to appear only once a trip existed, with "New trip"
                               tucked in the ⋯ menu — so the feature was invisible to exactly the people who had never
                               used it, and the one door to it was behind a dots icon. The empty tab is its own advert:
                               it carries nothing but the New trip button. *@
                            @* ⚠️ No Pro mark on the TAB. Reading trips is free, and so is running one you already have
                               to its end — the crown lives on "New trip", which is the thing Free actually can't do.
                               A crown here would say "you can't use this" to someone mid-journey, which is false. *@
                            <button type="button" class="chip @(_spendView == SpendView.Trips ? "on" : "")" @onclick="ShowTripsView"><Icon Name="plane" /> @Loc["Trips"]</button>
                        </span>
                    }
                    @if (State.IsPeriodOpen)
                    {
                        @if (_spendView == SpendView.Categories)
                        {
                            <button class="fund-add" @onclick="OpenAddBudget"><Icon Name="plus" /> @Loc["Add budget"]</button>
                        }
                        else
                        {
                            <button class="fund-add" @onclick="AddExpenseFromHeader"><Icon Name="receipt" /> @Loc["Add expense"]</button>
                        }
                    }
                    <span class="acct-menu spend-menu">
                        <button class="link" title="@Loc["More"]" @onclick="() => _spendMenuOpen = !_spendMenuOpen"><Icon Name="dots" /></button>
                        @if (_spendMenuOpen)
                        {
                            <div class="acct-menu-backdrop" @onclick="() => _spendMenuOpen = false"></div>
                            <div class="acct-menu-pop">
                                <button @onclick="async () => { _spendMenuOpen = false; await OpenImport(); }"><Icon Name="import" /> @Loc["Import statement"] <ProLock Feature="@PlanFeatures.Import" Static="true" /></button>
                                <button @onclick="() => { _spendMenuOpen = false; OpenManageCats(); }"><Icon Name="tag" /> @Loc["Manage categories"]</button>
                                <button @onclick="() => { _spendMenuOpen = false; OpenManageTags(); }"><Icon Name="tag" /> @Loc["Manage tags"]</button>
                                @* "New trip" left this menu — the Trips tab is always on the switcher now and owns
                                   the button, so a second door here was just a place to lose it. *@
                            </div>
                        }
                    </span>
                </div>
                @* By date's own controls drop to a slim row of their own (the view switch lives up on the summary row).
                   List/calendar toggle + the day-nav/date + the tag filter all sit on this row; opening the tag filter
                   reveals its chips INLINE on the same row (they wrap to a second line only when there are many). *@
                @if (_spendView == SpendView.ByDate)
                {
                    <div class="spend-switches spend-switches-bydate">
                        <span class="bydate-nav">
                            <span class="view-toggle">
                                <button class="view-btn @(_calendar ? "" : "active")" title="@Loc["List"]" @onclick="ShowDayList"><Icon Name="list" /></button>
                                <button class="view-btn @(_calendar ? "active" : "")" title="@Loc["Calendar"]" @onclick="ShowCalendarView"><Icon Name="calendar" /></button>
                            </span>
                            @if (_calendar)
                            {
                                <span class="bydate-ctx">@State.Period.From.ToString("MMMM yyyy")</span>
                            }
                            else if (_dayView is { } dv)
                            {
                                <span class="day-nav">
                                    <button class="exp-edit" title="@Loc["Previous day"]" @onclick="PrevDay" disabled="@(dv <= State.Period.From)">◀</button>
                                    <input type="date" @bind:get="dv" @bind:set="GoToDay" min="@State.Period.From.ToString("yyyy-MM-dd")" max="@State.Period.To.ToString("yyyy-MM-dd")" />
                                    <button class="exp-edit" title="@Loc["Next day"]" @onclick="NextDay" disabled="@(dv >= State.Period.To)">▶</button>
                                </span>
                            }
                            @* One box instead of a row of tag chips. It matches whatever is on the row — the note,
                               the category, the wallet, the label, the trip, the amount, the date — so the same
                               keystrokes answer "what did I spend at Lidl" and "where did that 40 euros go", which
                               chips could never ask. *@
                            <span class="spend-search">
                                <Icon Name="search" />
                                <input type="search" placeholder="@Loc["Search expenses…"]" aria-label="@Loc["Search expenses…"]"
                                       @bind="_spendSearch" @bind:event="oninput" />
                                @if (!string.IsNullOrWhiteSpace(_spendSearch))
                                {
                                    <button type="button" class="spend-search-x" title="@Loc["Clear"]" aria-label="@Loc["Clear"]" @onclick="() => _spendSearch = string.Empty"><Icon Name="x" /></button>
                                }
                            </span>
                        </span>
                    </div>
                }
                @if (barScale > 0m && _spendView == SpendView.Categories)
                {
                    var totHasBudget = State.TotalBudgeted.Amount > 0m;
                    var totPct = totHasBudget ? Math.Clamp((double)(State.TotalSpent.Amount / State.TotalBudgeted.Amount) * 100, 0, 100) : 0;
                    var totCount = State.AllExpenses.Count;
                    @* "All expenses" section header — a summary banner the category cards sit under: a status ring +
                       title + totals on one line, then a FULL-WIDTH bar spanning the whole section (category rows keep
                       their bar indented past the ring, so the full-width bar + tint marks this out as the header). *@
                    <div class="budget-header">
                        <div class="bh-top">
                            <span class="bh-ring">
                                <ProgressRing Percent="@totPct" Class="mint" Color="@(totHasBudget ? SpendBarColorAt(totPct) : null)" Dashed="@(!totHasBudget)">
                                    <CatIcon Name="receipt" Class="cat-chip-ring-ico" />
                                </ProgressRing>
                            </span>
                            <span class="bh-title">@Loc["All expenses"]@if (totCount > 0) { <span class="cat-row-subn">@totCount</span> }</span>
                            <span class="bh-figs">
                                <span class="bh-amt">@Fmt(State.TotalSpent)@if (totHasBudget) { <text> / @Fmt(State.TotalBudgeted)</text> }</span>
                                @if (totHasBudget)
                                {
                                    <span class="bh-remain @(_bnRemaining.IsNegative ? "warn-text" : "good-text")">@(_bnRemaining.IsNegative ? $"{Fmt(-_bnRemaining)} {Loc["over"]}" : $"{Fmt(_bnRemaining)} {Loc["left"]}")</span>
                                }
                            </span>
                        </div>
                        <span class="cbar-track bh-bar"><span class="cbar-grad@(totHasBudget ? "" : " cbar-flat")" style="--pct:@totPct.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></span></span>
                    </div>
                }
                @* Only meaningful while the period is open — you can't trim or top up a closed period. *@
                @if (State.IsPeriodOpen && overPlanned.Amount > 0m && _spendView == SpendView.Categories)
                {
                    <p class="budget-over-note"><Icon Name="bulb" /> @string.Format(Loc["Your remaining budgets ({0}) are {1} more than you have left ({2}) — budgets are plans, not commitments, so trim one or top up when you can."], Fmt(_bnRemaining), Fmt(overPlanned), Fmt(_bnFree))</p>
                }
                @{
                    // One shared expense-row template for both Spending views: the "By date" ledger (title = category)
                    // and a category's own drawer (title = the date, since the category is already the row you tapped).
                    // Same two-line row-main/row-sub layout so they read identically — cleaner on mobile than the old
                    // one-line drawer row.
                    RenderFragment<(FinApp.Domain.Budgeting.Expense E, bool ShowDate)> expenseRow = ctx =>
                    @<li>
                        <span class="row-main row-stack">
                            <span class="row-title">
                                @if (ctx.ShowDate)
                                {
                                    <Icon Name="calendar" /> <span class="row-title-txt">@ctx.E.Date.ToString("ddd, dd MMM")</span>
                                }
                                else
                                {
                                    <CatIcon Name="@State.CategoryIcon(ctx.E.CategoryId)" /> <span class="row-title-txt">@State.CategoryName(ctx.E.CategoryId)</span>
                                }
                            </span>
                            <span class="row-sub">
                                @* When it happened, on rows that know. Leads the sub-line because within a day —
                                   which is how this list is grouped — the clock is what orders the rows, so it is
                                   the one thing that says where you are in the day. Absent, not blank, when unknown. *@
                                @if (ctx.E.Time is { } rowTime) { <span class="exp-time">@rowTime.ToString("HH:mm")</span> }
                                <span class="sub-to">@State.FundName(ctx.E.FundId)</span>
                                @if (ctx.E.IsFromSavings) { <span><Icon Name="coins" /> @Loc["saving"]</span> }
                                @if (!string.IsNullOrEmpty(ctx.E.Note)) { <span class="sub-note">@ctx.E.Note</span> }
                                @if (ctx.E.IsSettlementSource)
                                {
                                    <span class="settle-tag" title="@Loc["Settled onto another account"]">🤝 @Fmt(ctx.E.SettledMoney) → @State.AccountName(ctx.E.SettledToAccountId!.Value)</span>
                                }
                                else if (ctx.E.IsSettlementDestination)
                                {
                                    <span class="settle-tag" title="@Loc["Settled from another account"]">↩ @Loc["from"] @State.AccountName(ctx.E.SettledFromAccountId!.Value)</span>
                                }
                                @* Money that came back. Named on the row rather than folded silently into the amount,
                                   so a €40 dinner that was €60 says why — otherwise the figure disagrees with the
                                   receipt and there is nothing to explain it. *@
                                @if (ctx.E.IsRefunded)
                                {
                                    <span class="settle-tag" title="@string.Format(Loc["{0} came back on this — it was {1}"], Fmt(ctx.E.RefundedMoney), Fmt(ctx.E.AmountBeforeRefund))">↩ @Fmt(ctx.E.RefundedMoney) @Loc["back"]</span>
                                }
                                @if (ctx.E.AutoFiled) { <span class="row-note" title="@AutoFiledTitle(ctx.E)"><Icon Name="bank" Class="ic-s" /></span> }
                                @if (ctx.E.IsInstallmentPart)
                                {
                                    @* Names the payment this row belongs to, so three rows on one date read as one
                                       installment rather than three unexplained expenses. *@
                                    <span class="inst-tag" title="@Loc["Part of one loan installment — editing or removing it affects the whole payment."]">@InstallmentPartLabel(ctx.E)</span>
                                }
                                @foreach (var t in State.ExpenseTags(ctx.E))
                                {
                                    <span class="exp-tag">@TagMark(t.Icon)@t.Name</span>
                                }
                            </span>
                        </span>
                        @* ★ What you actually handed over, under what it cost you. Recorded at entry (see
                           Expense.ForeignAmount), never re-derived — so this row keeps saying "£12.50" even after
                           the wallet is reloaded at a different rate. That is the whole reason it is stored. *@
                        <span class="amt">@Fmt(ctx.E.Amount)@if (ctx.E.HasForeign)
                            {
                                <small class="amt-fx">@CurrencyInfo.Symbol(ctx.E.ForeignCurrency)@ctx.E.ForeignAmount!.Value.ToString("0.00")</small>
                            }</span>
                        <span class="row-actions">
                            @if (State.IsPeriodOpen)
                            {
                                <button class="exp-edit" title="@Loc["Edit expense"]" @onclick="() => OpenEditExpense(ctx.E.Id)"><Icon Name="pencil" /></button>
                                <button class="exp-edit" title="@Loc["Remove expense"]" @onclick="() => OpenDeleteExpense(ctx.E.Id)"><Icon Name="trash" /></button>
                            }
                            else
                            {
                                @* ★ A closed month is closed for the MONEY, not for what a row is called. Labels are
                                   the axis Breakdown-by-tag and the trip recap read history on, and both are done
                                   long after the period shut — the trip's own attach list already carries a tag row
                                   for exactly this reason. This writes ONLY the tag: no amount, date, category or
                                   fund, so nothing a closed period settled can move. *@
                                <button class="exp-edit" title="@Loc["Label expense"]" @onclick="() => OpenTagExpense(ctx.E.Id)"><Icon Name="tag" /></button>
                            }
                        </span>
                    </li>;

                }
                @* Category list: a status-ring chip + a gradient progress bar per row, ordered by spend. Tapping a
                   row opens a drawer with its expenses and actions — so the actions and the spend detail are inline
                   instead of behind a ring popover (which is why the ring's menu is gone). One level: the drawer
                   used to lead with a sub-category block, and that block is what tags carry now. *@
                @if (_spendView == SpendView.Categories)
                {
                <div class="cat-list">
                    @foreach (var rc in ringCards)
                    {
                        var cat = rc.Cat;
                        var catId = cat.Id;
                        var hasBudget = rc.HasBudget;
                        var cov = hasBudget ? State.Coverage(catId) : null;
                        var spent = hasBudget ? cov!.Spent : State.SpentInCategory(catId);
                        var pct = hasBudget ? Math.Clamp((double)(cov!.Percent ?? 0), 0, 100) : 0;
                        var cls = hasBudget ? (cov!.IsOverBudget ? "over" : cov.ThresholdReached ? "warn" : "ok") : "mint";
                        var over = hasBudget && cov!.IsOverBudget;
                        var expCount = State.ExpenseCountInCategory(catId);
                        var open = _expandedCatId == catId;
                        <div class="cat-row@(open ? " open" : "")">
                            <div class="cat-row-head">
                                <button class="cat-row-hit" @onclick="() => ToggleCatRow(catId)">
                                    <span class="cat-chip-ring">
                                        @* Solid ring in the exact colour the row's progress bar has reached — the ring shows
                                           status, the bar (below) shows the gradient fill, so the two don't double up. *@
                                        <ProgressRing Percent="@pct" Class="@cls" Color="@(hasBudget ? SpendBarColorAt(pct) : null)" Dashed="@(!hasBudget)">
                                            <CatIcon Name="@State.CategoryIcon(catId)" Class="cat-chip-ring-ico" />
                                        </ProgressRing>
                                    </span>
                                    <span class="cat-row-main">
                                        <span class="cat-row-top">
                                            <span class="cat-row-name">@cat.Name@if (expCount > 0) { <span class="cat-row-subn" title="@(expCount == 1 ? Loc["1 expense logged"] : string.Format(Loc["{0} expenses logged"], expCount))">@expCount</span> }</span>
                                            <span class="cat-row-amt @(over ? "warn-text" : "")">@Fmt(spent)@if (hasBudget) { <text> / @Fmt(cov!.Allocated)</text> } else { <span class="cat-row-nb"> · @Loc["no budget"]</span> }</span>
                                        </span>
                                        <span class="cbar-track"><span class="cbar-grad@(hasBudget ? "" : " cbar-flat")" style="--pct:@pct.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></span></span>
                                    </span>
                                </button>
                                @* Actions on the right of the row (always visible): add expense / edit budget / remove. *@
                                <div class="cat-row-acts">
                                    @if (State.IsPeriodOpen)
                                    {
                                        <button class="row-ico" title="@Loc["Add expense"]" @onclick="() => OpenAddExpense(catId)"><Icon Name="receipt" /></button>
                                    }
                                    <button class="row-ico" title="@(hasBudget ? Loc["Edit budget"] : Loc["Add budget"])" @onclick="() => OpenEdit(catId)"><Icon Name="pencil" /></button>
                                    @if (hasBudget)
                                    {
                                        <button class="row-ico danger" title="@Loc["Remove budget"]" @onclick="() => OpenDeleteBudget(catId)"><Icon Name="trash" /></button>
                                    }
                                    <button class="row-ico cat-chev-btn" @onclick="() => ToggleCatRow(catId)"><Icon Name="chevron" Class="cat-chev" /></button>
                                </div>
                            </div>
                            @if (open)
                            {
                                <div class="cat-drawer">
                                    @{
                                        var ownExpenses = FilterByTags(State.ExpensesFor(catId));
                                        var shownExpenses = _catShowAllExp ? ownExpenses : ownExpenses.Take(CatDrawerExpenseCap).ToList();
                                    }
                                    <div class="cat-drawer-label">@Loc["Expenses"]</div>
                                    @if (ownExpenses.Count == 0)
                                    {
                                        <p class="cat-drawer-empty">@Loc["No expenses in this category yet."]</p>
                                    }
                                    else
                                    {
                                        <ul class="list list-even cat-drawer-list">
                                            @foreach (var e in shownExpenses)
                                            {
                                                @expenseRow((e, true))
                                            }
                                        </ul>
                                        @if (!_catShowAllExp && ownExpenses.Count > CatDrawerExpenseCap)
                                        {
                                            <button class="cat-viewmore" @onclick="() => _catShowAllExp = true">@string.Format(Loc["View all {0} expenses"], ownExpenses.Count) <Icon Name="chevron" Class="cat-viewmore-chev" /></button>
                                        }
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
                }
                else if (_spendView == SpendView.ByDate)
                {
                @* The date/tag/spent controls now live in the consolidated .bydate-bar above the ledger. *@
                <div class="bydate-body">
                @{
                    // Shared row template (defined above) — title = category in this "By date" ledger.
                    RenderFragment<FinApp.Domain.Budgeting.Expense> row = e => expenseRow((e, false));
                    var ledger = FilterByTags(State.AllExpenses);
                    var shown = _dayView is { } dvf
                        ? ledger.Where(e => e.Date == dvf).ToList()
                        : ledger;
                    @* ★ Money sent to another account belongs in this list. It already counts in the "Spent" tile
                       and has its own Breakdown slice, so leaving it out of the ledger made the one view that is
                       supposed to show every outflow the only one that hid some. Searching filters it by note. *@
                    var xfers = State.AccountTransfersOutThisPeriod
                        .Where(t => TransferMatchesSearch(t, isPayout: false))
                        .ToList();
                    var shownXfers = _dayView is { } dvx ? xfers.Where(t => t.Date == dvx).ToList() : xfers;
                    @* ★ Goal payouts belong here for the same reason account transfers do, and were missing for a
                       worse one: they are excluded from AccountTransfersOut by design (a payout isn't spending), and
                       that exclusion quietly kept them out of the ledger too. Deploying €12,000 at a loan is the
                       largest thing that can happen to a balance in a month, and the one list that promises every
                       outflow showed nothing. Searched by note and by the bucket's name. *@
                    var payouts = State.DisbursementsThisPeriod
                        .Where(t => TransferMatchesSearch(t, isPayout: true))
                        .ToList();
                    var shownPayouts = _dayView is { } dvp ? payouts.Where(t => t.Date == dvp).ToList() : payouts;
                    @* Day totals and calendar counts are built from ALL THREE, so a day header can never disagree
                       with the rows sitting under it. *@
                    var byDay = ledger.Select(e => (e.Date, Amt: e.Amount.Amount))
                        .Concat(xfers.Select(t => (t.Date, Amt: t.Amount.Amount)))
                        .Concat(payouts.Select(t => (t.Date, Amt: t.Amount.Amount)))
                        .GroupBy(x => x.Date)
                        .ToDictionary(g => g.Key, g => (Count: g.Count(), Total: g.Aggregate(0m, (s, x) => s + x.Amt)));
                    @* A transfer row deliberately looks like an expense row and is not one: same columns, but the
                       title names the account the money went to and there is no category unless the user filed it
                       under one. Editing stays on the two-sided editor it already has — a transfer has a counterpart
                       deposit in the other account, so it must never be edited as if it were a local row. *@
                    RenderFragment<FinApp.Domain.Funds.ExternalTransfer> xferRow = t =>
    @<li class="xfer-row">
        <div class="row-main row-stack">
            <span class="row-title"><span class="row-title-txt"><Icon Name="swap" class="ic-s" /> @State.AccountName(t.ToAccountId ?? Guid.Empty)</span></span>
            <span class="row-sub">
                <span class="sub-to">@State.FundName(t.FundId)</span>
                @if (!string.IsNullOrWhiteSpace(t.Note)) { <span class="sub-note">@t.Note</span> }
                @if (t.CategoryId is { } xc) { <span class="settle-tag">@State.CategoryName(xc)</span> }
            </span>
        </div>
        <span class="amt">@Fmt(t.Amount)</span>
        <span class="row-actions">
            <button class="exp-edit" title="@Loc["Edit"]" aria-label="@Loc["Edit"]" @onclick="() => OpenEditAccountTransfer(t.Id)"><Icon Name="pencil" /></button>
            @* Holds the delete column open — a transfer is removed from its wallet's list, not from here. *@
            <span class="exp-edit-slot" aria-hidden="true"></span>
        </span>
    </li>;
                    @* A payout row names the GOAL, not a destination account — that is the fact the reader wants, and
                       the bucket is the only thing distinguishing it from a plain transfer. No edit button: a
                       disbursement is one half of a pair (the drawdown that drained the earmark is the other), and
                       the bucket's own screen is where it is undone. Offering a pencil that edits only the visible
                       half would leave the earmark wrong. *@
                    RenderFragment<FinApp.Domain.Funds.ExternalTransfer> payoutRow = t =>
    @<li class="xfer-row payout-row">
        <div class="row-main row-stack">
            <span class="row-title"><span class="row-title-txt"><Icon Name="target" class="ic-s" /> @(State.DisbursementBucketName(t.Id) ?? Loc["A goal"])</span></span>
            <span class="row-sub">
                <span class="sub-to">@State.FundName(t.FundId)</span>
                @if (!string.IsNullOrWhiteSpace(t.Note)) { <span class="sub-note">@t.Note</span> }
                <span class="settle-tag">@Loc["paid to goal"]</span>
            </span>
        </div>
        <span class="amt">@Fmt(t.Amount)</span>
        @* Both slots empty: a payout has no actions here at all (see above), but the amount still has to line up
           with every other row's. *@
        <span class="row-actions">
            <span class="exp-edit-slot" aria-hidden="true"></span>
            <span class="exp-edit-slot" aria-hidden="true"></span>
        </span>
    </li>;
                    var calToday = DateOnly.FromDateTime(DateTime.Today);
                }
                @if (_calendar)
                {
                    <div class="cal-dow">
                        @foreach (var dow in new[] { "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun" })
                        {
                            <span>@dow</span>
                        }
                    </div>
                    <div class="cal-grid">
                        @foreach (var d in CalendarDays())
                        {
                            var inRange = d >= State.Period.From && d <= State.Period.To;
                            byDay.TryGetValue(d, out var info);
                            // ★ Trips are drawn ON the month. A journey is the one thing in this app that is a RANGE
                            // of days rather than a point, and a calendar is the only view that can show that shape —
                            // seeing the block is how "the flight was before we left" stops being an abstraction.
                            // Any trip covering the day, not just the running one: the grid is as often read about a
                            // month that is finished as about the one you're in.
                            var calTrip = State.AllTrips.FirstOrDefault(t => d >= t.From && d <= t.To);
                            var tripStart = calTrip is not null && d == calTrip.From;
                            var tripEnd = calTrip is not null && d == calTrip.To;
                            // ★ A colour per trip, so two journeys in one month are told apart at a glance rather
                            // than by reading their names. Keyed on the trip's position in the account's own list,
                            // not on a hash: the same trip must keep the same colour every time the month is
                            // opened, and a hash of the id would also have to be checked for collisions.
                            var calTripC = calTrip is null ? 0 : TripColourIndex(calTrip.Id);
                            var cls = "cal-cell"
                                + (inRange ? "" : " cal-out")
                                + (d == calToday ? " cal-today" : "")
                                + (_dayView == d ? " cal-sel" : "")
                                + (calTrip is null ? "" : $" cal-trip cal-trip-c{calTripC}")
                                + (tripStart ? " cal-trip-a" : "")
                                + (tripEnd ? " cal-trip-z" : "");
                            var day = d;
                            <div class="@cls" @onclick="() => OpenDayFromCalendar(day)" title="@(calTrip?.Name)">
                                <span class="cal-top">
                                    <span class="cal-num">@d.Day</span>
                                    @if (inRange && State.IsPeriodOpen)
                                    {
                                        <button class="cal-add" title="@Loc["Add expense"]" @onclick:stopPropagation="true" @onclick="() => OpenAddExpenseOn(day)"><Icon Name="receipt" /></button>
                                    }
                                </span>
                                @if (inRange && info.Count > 0)
                                {
                                    <span class="cal-total">@Fmt(info.Total)</span>
                                }
                                @* The band runs edge to edge across the trip's days and rounds off only at its two
                                   ends, so a week away reads as one bar rather than seven separate marks.
                                   ★ The name is on EVERY day, not just the first. A month grid wraps every seven
                                   days, so a label on day one is off the row (and often off the screen) by the time
                                   you are looking at day five — and the trip you are trying to identify is usually
                                   the one under today, not the one under its own departure date. *@
                                @if (calTrip is not null)
                                {
                                    <span class="cal-trip-band">
                                        @* The icon leads: on a narrow cell the name is the first thing to get cut,
                                           and a flag/emoji still identifies the journey when the text is an ellipsis. *@
                                        <span class="cal-trip-ico">@(calTrip.Icon ?? "✈️")</span>
                                        <span class="cal-trip-nm">@calTrip.Name</span>
                                    </span>
                                }
                            </div>
                        }
                    </div>
                }
                else if (!shown.Any() && !shownXfers.Any() && !shownPayouts.Any())
                {
                    <ul class="list"><li><em>@(!string.IsNullOrWhiteSpace(_spendSearch) ? Loc["Nothing matches that search."] : Loc["Nothing’s perched here yet — add your first expense."])</em></li></ul>
                }
                else if (_dayView is not null)
                {
                    <ul class="list list-even">@foreach (var e in shown) { @row(e) }@foreach (var t in shownXfers) { @xferRow(t) }@foreach (var t in shownPayouts) { @payoutRow(t) }</ul>
                }
                else
                {
                    @* Days come from expenses AND transfers AND payouts, so a day whose only outflow was money sent
                       to another account — or deployed at a goal — still gets a header instead of vanishing. *@
                    @foreach (var day in shown.Select(e => e.Date).Concat(shownXfers.Select(t => t.Date))
                        .Concat(shownPayouts.Select(t => t.Date)).Distinct().OrderByDescending(d => d))
                    {
                        var grp = shown.Where(e => e.Date == day).ToList();
                        var grpX = shownXfers.Where(t => t.Date == day).ToList();
                        var grpP = shownPayouts.Where(t => t.Date == day).ToList();
                        @* A day inside a trip says so, in the trip's own colour — the same lookup and the same
                           palette index the calendar band uses, so the two views agree about which journey a day
                           belongs to. It answers "why was this Tuesday expensive" without opening anything. *@
                        var sepTrip = State.AllTrips.FirstOrDefault(t => day >= t.From && day <= t.To);
                        <button class="date-sep" @onclick="() => GoToDay(day)">
                            <span class="date-sep-lbl">@DateSepLabel(day)</span>
                            @if (sepTrip is not null)
                            {
                                <span class="date-sep-trip cal-trip-c@(TripColourIndex(sepTrip.Id))">
                                    <span class="date-sep-trip-ico">@(sepTrip.Icon ?? "✈️")</span>@sepTrip.Name
                                </span>
                            }
                            @* The day's spend, in the amount column — a running read of "what did today cost". Widths
                               match the row's amt (88) + actions (58) so it sits directly over the expense amounts. *@
                            <span class="date-sep-tot">@Fmt(State.Money(grp.Sum(e => e.Amount.Amount) + grpX.Sum(t => t.Amount.Amount) + grpP.Sum(t => t.Amount.Amount)))</span>
                            <span class="date-sep-pad" aria-hidden="true"></span>
                        </button>
                        <ul class="list list-even">@foreach (var e in grp) { @row(e) }@foreach (var t in grpX) { @xferRow(t) }@foreach (var t in grpP) { @payoutRow(t) }</ul>
                    }
                }
                </div>
                }
                else if (_spendView == SpendView.Breakdown)
                {
                @* Breakdown: a budget-free pie of where the money actually went, over an adjustable window. Tap a
                   category slice/row to re-slice it by sub-category (or tags). *@
                <div class="brk">
                    <div class="brk-ranges" role="group">
                        @{
                            // No "Custom" chip — the editable date row below IS the custom window; typing a date switches
                            // to it. These presets are just quick-fills for those dates.
                            (BreakRange R, string L)[] ranges = new[]
                            {
                                (BreakRange.ThisPeriod, Loc["This period"]),
                                (BreakRange.M3, Loc["3 months"]),
                                (BreakRange.M6, Loc["6 months"]),
                                (BreakRange.M12, Loc["12 months"]),
                                (BreakRange.All, Loc["All time"]),
                            };
                        }
                        @foreach (var (r, l) in ranges)
                        {
                            @* Crown only on the windows Free can't reach (6m/12m/All) — the gate in SetBreakRange
                               uses the same list, so the marks and the enforcement stay in step. *@
                            <button type="button" class="chip @(_breakRange == r ? "on" : "")" @onclick="() => SetBreakRange(r)">@l@if (r is BreakRange.M6 or BreakRange.M12 or BreakRange.All) { <ProLock Feature="@PlanFeatures.History" Static="true" /> }</button>
                        }
                    </div>
                    @{
                        var brkSlices = BreakSlices();
                        var brkTotal = brkSlices.Sum(s => s.Amount);                                    // sum of the drawn slices (donut geometry)
                        var brkPeriods = BreakPeriodCount();                                            // >1 → rows also carry a per-period average
                        var brkCi = System.Globalization.CultureInfo.InvariantCulture;
                        var (brkFrom, brkTo) = BreakWindow();
                        // ⚠️ When the window IS the selected period, this must be the hero's OWN figure, not a
                        // date-filtered rebuild of it. The old line mixed the two rules — a date-based IncomeInRange
                        // plus a membership-based CarriedInThisPeriod — so it could equal neither: any contribution
                        // dated inside the window but owned by a different period was counted here and not up there,
                        // and the two tiles contradicted each other on the same screen (observed: €5,421.77 against
                        // €5,344.38, a €77.39 gap with no way for the reader to tell which was lying).
                        // This is the same trap HomePeriodSlices documents for expenses; membership keeps them in
                        // lockstep. Over a multi-period window there is no single period to take membership from, so
                        // the date-based sum is the right tool and carry-in is not added to it.
                        var brkIncome = _breakRange == BreakRange.ThisPeriod
                            ? State.MoneyInThisPeriod.Amount
                            : State.IncomeInRange(brkFrom, brkTo);
                        // "Spent" = expenses + account transfers out. From the raw rows, not the slices, so it's
                        // identical across the category/tag/fund toggles — and it is exactly the donut's total.
                        // ★ Those two agreeing is the fix. They used to differ by the savings slice, silently: the
                        // ring counted money you had merely earmarked, this line didn't, and nothing on screen said
                        // which question either was answering. Now both answer the same one.
                        var brkMoneyOut = State.ExpensesInRange(brkFrom, brkTo).Sum(e => Math.Abs(e.Amount.Amount))
                            + State.AccountTransfersInRange(brkFrom, brkTo).Sum(t => Math.Abs(t.Amount.Amount));
                        // ⚠️ The hero's OWN figure when the window is the period — the same discipline as brkIncome
                        // above, and for the same reason: a look-alike recomputation is how two tiles about one
                        // number come to disagree. Never negative; see SetAsideInRange.
                        var brkSetAside = _breakRange == BreakRange.ThisPeriod
                            ? State.SavingsThisPeriod.Amount
                            : State.SetAsideInRange(brkFrom, brkTo);
                        // Money deployed at a goal. A REAL outflow (ExpectedClosingBalance subtracts it) and stated
                        // as its own figure — but deliberately not a slice; see the note above BreakSlices for why.
                        var brkPaidOut = State.DisbursedTotal(brkFrom, brkTo);
                        // One expense row, reused by the flat list and the grouped-by-sub/tag lists in an expanded slice.
                        RenderFragment<FinApp.Domain.Budgeting.Expense> brkExpRow = e =>
                        @<li class="brk-exp-row">
                            <span class="brk-exp-date"><span class="brk-exp-d">@e.Date.ToString("dd")</span><span class="brk-exp-m">@e.Date.ToString("MMM")</span></span>
                            <span class="brk-exp-main">
                                <span class="brk-exp-title">@(string.IsNullOrEmpty(e.Note) ? State.CategoryName(e.CategoryId) : e.Note)</span>
                                <span class="brk-exp-sub">@(string.IsNullOrEmpty(e.Note) ? State.FundName(e.FundId) : State.CategoryName(e.CategoryId))@if (e.Time is { } brkTime) { <span class="exp-time">@brkTime.ToString("HH:mm")</span> }</span>
                            </span>
                            <span class="brk-exp-amt">@Fmt(e.Amount)</span>
                        </li>;
                    }
                    @* The window is editable directly: the presets above quick-fill these two dates, and typing in either
                       one makes it a custom window — so there's no separate "Custom" button and no duplicate date set.
                       The group-by axis (Categories / Tags / Funds) shares this row, pinned to its right end. *@
                    <div class="brk-range-lbl brk-range-edit">
                        <Icon Name="calendar" />
                        <input type="date" class="brk-date-in" @bind:get="brkFrom" @bind:set="BreakSetFrom" max="@brkTo.ToString("yyyy-MM-dd")" />
                        <span class="brk-date-dash">–</span>
                        <input type="date" class="brk-date-in" @bind:get="brkTo" @bind:set="BreakSetTo" min="@brkFrom.ToString("yyyy-MM-dd")" />
                        <span class="brk-split brk-split-end">
                            <button type="button" class="chip @(_breakBase == BreakGroup.Category && _breakDrill is null ? "on" : "")" @onclick="() => SetBreakBase(BreakGroup.Category)">@Loc["Categories"]</button>
                            @if (State.ActiveTags.Count > 0)
                            {
                                <button type="button" class="chip @(_breakBase == BreakGroup.Tag ? "on" : "")" @onclick="() => SetBreakBase(BreakGroup.Tag)">@Loc["Tags"]</button>
                            }
                            <button type="button" class="chip @(_breakBase == BreakGroup.Fund ? "on" : "")" @onclick="() => SetBreakBase(BreakGroup.Fund)">@Loc["Funds"]</button>
                        </span>
                    </div>
                    @* One line, two jobs, depending on whether the chart is drilled into a category.
                       Drilled: name the category — the chart below is its tag split, so without this line a
                       single-tag category looks exactly like a broken pie. There's no way-back button: every one of
                       the Categories / Tags / Funds chips above clears the drill, so the exit already exists twice.
                       Not drilled: Income · Spent · % of income for the window. Those three are about the WINDOW, so
                       inside one category's split they'd be three numbers answering a question nobody asked. *@
                    @if (_breakDrill is { } drilledId)
                    {
                        <div class="brk-drill">
                            <span class="brk-drill-cat">
                                <CatIcon Name="@State.CategoryIcon(drilledId)" />
                                <strong>@State.CategoryName(drilledId)</strong>
                                <span class="brk-drill-by">@Loc["by tag"]</span>
                            </span>
                        </div>
                    }
                    else
                    {
                        @* Income · Spent · Set aside · Paid to goals. The last two replace "% of income": a ratio of
                           two numbers already sitting beside it is the least a slot could carry, and these are the
                           two facts the ring deliberately does NOT draw. Together the four reconcile to what the
                           balance did, without any of them distorting the chart.
                           ⚠️ They are two SEPARATE figures because they are two separate facts: what went into
                           buckets, and what left them for its purpose. Folding both into one signed "Set aside" was
                           tried and reverted — it printed −€3,320 beside a hero reading "Saved €450". "Paid to
                           goals" appears only when there is some. *@
                        <div class="brk-summary">
                            <span class="brk-sum"><span class="brk-sum-lbl">@Loc["Income"]</span><span class="brk-sum-val good-text">@Fmt(brkIncome)</span></span>
                            <span class="brk-sum"><span class="brk-sum-lbl">@Loc["Spent"]</span><span class="brk-sum-val">@Fmt(brkMoneyOut)</span></span>
                            <span class="brk-sum"><span class="brk-sum-lbl">@Loc["Set aside"]</span><span class="brk-sum-val @(brkSetAside > 0m ? "good-text" : "")">@(brkSetAside > 0m ? "+" : "")@Fmt(State.Money(brkSetAside))</span></span>
                            @if (brkPaidOut > 0m)
                            {
                                @* Named in the tooltip: "paid to goals" is the fact, "which goals" is the follow-up,
                                   and it is the question the ring used to answer by eating itself. *@
                                <span class="brk-sum" title="@string.Join(" · ", State.DisbursementsByBucket(brkFrom, brkTo).Select(b => $"{(b.Name.Length > 0 ? b.Name : Loc["A goal"])} {Fmt(State.Money(b.Amount))}"))"><span class="brk-sum-lbl">@Loc["Paid to goals"]</span><span class="brk-sum-val">@Fmt(State.Money(brkPaidOut))</span></span>
                            }
                        </div>
                    }
                    @if (brkSlices.Count == 0 || brkTotal <= 0m)
                    {
                        <p class="brk-empty"><Icon Name="pie" /> @Loc["No expenses in this window yet."]</p>
                    }
                    else
                    {
                        <div class="brk-chart">
                            @* @key on the window/axis so Blazor builds a FRESH svg whenever the data set changes —
                               that's what replays the slice entrance animation. Without it Blazor patches the
                               existing paths in place and the CSS animation, already finished, never re-runs. *@
                            @* The viewBox is bigger than the ring so the leader labels have somewhere to live —
                               the ring itself stays at r=90 around (100,100), exactly where it was; the extra
                               space is margin, not a resize.
                               ⚠️ The horizontal margin has to clear the ICON **and the percentage beyond it**: an
                               icon centre reaches x=248 at 3 o'clock, then the text starts 15 further out and runs
                               about 40 wide. A first cut sized to the icon alone clipped the digits and turned
                               "45%" into "459" and "13%" into "3%" — a wrong number, rendered confidently. *@
                            <svg class="brk-donut" @key="(_breakRange, _breakBase, brkSlices.Count)" viewBox="-108 -60 416 320" role="img" aria-label="@Loc["Spending breakdown"]">
                                @if (brkSlices.Count == 1)
                                {
                                    <circle cx="100" cy="100" r="73" fill="none" stroke="@brkSlices[0].Color" stroke-width="34"><title>@brkSlices[0].Label · 100%</title></circle>
                                }
                                else
                                {
                                    double acc = 0;
                                    @foreach (var s in brkSlices)
                                    {
                                        var sweep = (double)(s.Amount / brkTotal) * 100.0;
                                        var d = DonutArc(acc, sweep, 100, 100, 90, 56);
                                        // Pop the slice out along its own bisector when its row is expanded — a focus cue,
                                        // tied to selection not to value, so it never distorts the chart.
                                        var midA = ((acc + sweep / 2) / 100.0) * 2 * Math.PI - Math.PI / 2;
                                        var popped = _breakExpanded.Contains(s.Key);
                                        var tx = popped ? Math.Cos(midA) * 8 : 0;
                                        var ty = popped ? Math.Sin(midA) * 8 : 0;
                                        acc += sweep;
                                        <path class="brk-slice" d="@d" fill="@s.Color" transform="translate(@tx.ToString("0.##", brkCi) @ty.ToString("0.##", brkCi))"><title>@s.Label · @sweep.ToString("0.#", brkCi)%</title></path>
                                    }
                                }
                                @* Leader labels: a hairline out to the slice's own icon on a badge in its colour,
                                   with its share beside it. Decorative — every one of these is a slice already
                                   named, with its money, in the list below — so it's hidden from assistive tech and
                                   transparent to the pointer, and the ring keeps its tooltips.
                                   Skipped for the single-slice ring above: a leader line to "100%" of a complete
                                   circle points at nothing the eye hasn't already worked out. *@
                                @if (brkSlices.Count > 1)
                                {
                                    <g class="brk-labels" aria-hidden="true">
                                        @* The labels ride a long way out (r=148 against a ring of r=90). Close in,
                                           a label that the spread pass had nudged toward its neighbour ended up
                                           sitting ON the ring, because the nudge moves it vertically while its x
                                           stays put — the further out the orbit, the more vertical room a nudge has
                                           before it runs back into the chart. The long leader lines are the price
                                           and they read fine; icons overlapping wedges did not. *@
                                        @foreach (var lb in DonutLabels(brkSlices, brkTotal, 100, 100, 90, 148, -46, 246))
                                        {
                                            var lx = lb.Bx + (lb.Right ? -12 : 12);
                                            <polyline class="brk-lbl-line" fill="none" stroke="@lb.Slice.Color"
                                                      points="@F(lb.Ax),@F(lb.Ay) @F(lx),@F(lb.By)" />
                                            @* A bare line icon, exactly as the list rows draw it (CatIcon: monochrome
                                               stroke, no colour chip) — the first cut put it in white on a filled
                                               disc, which was a second icon idiom invented for one chart.
                                               The colour is the SLICE's, not the app accent: with the chip gone that
                                               is the only thing left tying the mark to its wedge. *@
                                            <use class="brk-lbl-ic" href="#i-@SliceSprite(lb.Slice)" stroke="@lb.Slice.Color"
                                                 x="@F(lb.Bx - 9)" y="@F(lb.By - 9)" width="18" height="18" />
                                            @DonutPct(lb)
                                        }
                                    </g>
                                }
                                @* Counts to the new figure when the window or axis changes, so the centre number
                                   settles with the slices instead of snapping while they animate. *@
                                <text x="100" y="94" class="brk-donut-tot" text-anchor="middle"><Rolling Value="@brkTotal" Format="@(v => Fmt(State.Money(v)))" /></text>
                                @* ★ The caption says what the figure IS, not how many pieces it came in. A count of
                                   categories describes the legend, which is directly below and can be counted; what
                                   the reader could not tell was whether the centre meant income, spending, or
                                   something else — and it disagreed with the "Spent" line beside it. It agrees now,
                                   and says so. Inside a drill the count is still the useful thing: there the total
                                   is one category's, and the question is how many tags split it. *@
                                <text x="100" y="112" class="brk-donut-sub" text-anchor="middle">@(_breakDrill is not null ? string.Format(Loc["{0} tags"], brkSlices.Count) : Loc["spent"])</text>
                            </svg>
                        </div>
                        <ul class="brk-list">
                            @foreach (var s in brkSlices)
                            {
                                var pct = (double)(s.Amount / brkTotal) * 100.0;
                                var expanded = _breakExpanded.Contains(s.Key);
                                <li class="brk-item @(expanded ? "open" : "")">
                                    @* Row body: tap to expand this slice's expenses in place. *@
                                    <div class="brk-item-head" @onclick="() => ToggleBreakExpand(s.Key)">
                                        <span class="brk-sw" style="background:@s.Color"></span>
                                        <span class="brk-item-name">
                                            @if (s.Key == TransfersKey)
                                            {
                                                <Icon Name="swap" />
                                            }
                                            else if (BreakByFund)
                                            {
                                                <CatIcon Name="@State.FundIcon(s.Key)" />
                                            }
                                            else if (BreakByTag)
                                            {
                                                @TagMark(s.Icon)
                                            }
                                            else if (s.Key != Guid.Empty && s.Key != OtherKey)
                                            {
                                                <CatIcon Name="@State.CategoryIcon(s.Key)" />
                                            }
                                            <span class="brk-item-lbl">@s.Label</span>
                                        </span>
                                        @* Over more than one period the total answers the wrong question — "is Food
                                           expensive?" is a per-month question, and a 12-month total is 12× any figure
                                           the reader has a feel for. The average is drawn only when the window
                                           actually spans several periods; over one it would be the same number twice. *@
                                        <span class="brk-item-amt">@Fmt(s.Amount)<span class="brk-item-pct">@pct.ToString("0.#", brkCi)%</span>
                                            @if (brkPeriods > 1)
                                            {
                                                <span class="brk-item-avg">@string.Format(Loc["{0} avg / period"], Fmt(State.Money(decimal.Round(s.Amount / brkPeriods, 2))))</span>
                                            }
                                        </span>
                                        @* Wrapped for the same reason as the tag-section chevron below: the rotation
                                           has to be applied to an element this component owns. *@
                                        <span class="brk-item-chev"><Icon Name="chevron" /></span>
                                    </div>
                                    @if (expanded && s.Key == TransfersKey)
                                    {
                                        var (xFrom, xTo) = BreakWindow();
                                        // Biggest first, like every expense list in this view (date breaks ties).
                                        var xfers = State.AccountTransfersInRange(xFrom, xTo)
                                            .OrderByDescending(t => Math.Abs(t.Amount.Amount)).ThenByDescending(t => t.Date).ToList();
                                        <ul class="brk-exp-list" style="--accent:@s.Color">
                                            @foreach (var t in xfers)
                                            {
                                                <li class="brk-exp-row">
                                                    <span class="brk-exp-date"><span class="brk-exp-d">@t.Date.ToString("dd")</span><span class="brk-exp-m">@t.Date.ToString("MMM")</span></span>
                                                    <span class="brk-exp-main">
                                                        <span class="brk-exp-title">@(string.IsNullOrEmpty(t.Note) ? Loc["Transfer to another account"] : t.Note)</span>
                                                        <span class="brk-exp-sub">@State.FundName(t.FundId)</span>
                                                    </span>
                                                    <span class="brk-exp-amt">@Fmt(t.Amount)</span>
                                                </li>
                                            }
                                        </ul>
                                    }
                                    else if (expanded)
                                    {
                                        var slExps = BreakSliceExpenses(s.Key);
                                        // A real category slice splits its expenses by tag — always, no "Group by"
                                        // switch: a flat list of a whole category is the one thing the row above
                                        // already told you. It can also re-draw the CHART as that split.
                                        // Not while drilled: the slices ARE tags there, so grouping a tag's expenses
                                        // by tag repeats the row header and its total one line below itself.
                                        // Tag / fund / "everything else" slices can't either — already the axis, or a bag.
                                        var isCatSlice = _breakDrill is null && !BreakByTag && !BreakByFund && s.Key != OtherKey && s.Key != Guid.Empty;
                                        var hasTags = isCatSlice && slExps.Any(e => State.ExpenseTags(e).Count > 0);
                                        <div class="brk-exp" style="--accent:@s.Color">
                                            @if (hasTags)
                                            {
                                                @* The drill: the same split, drawn. *@
                                                <div class="brk-exp-group">
                                                    <button type="button" class="chip brk-drill-in" @onclick:stopPropagation="true" @onclick="() => DrillIntoCategory(s.Key)"><Icon Name="pie" /> @Loc["Chart this"]</button>
                                                </div>
                                            }
                                            @if (slExps.Count == 0)
                                            {
                                                <p class="brk-exp-empty">@Loc["No expenses in this window yet."]</p>
                                            }
                                            else if (!hasTags)
                                            {
                                                @* Biggest first, not newest first. Every other level of this view is
                                                   ranked by size — the slices, and the sub-groups inside them — and
                                                   the question a breakdown answers is "what did the money go on",
                                                   which a date order buries. Date breaks the ties. *@
                                                <ul class="brk-exp-list">
                                                    @foreach (var e in slExps.OrderByDescending(x => Math.Abs(x.Amount.Amount)).ThenByDescending(x => x.Date)) { @brkExpRow(e) }
                                                </ul>
                                            }
                                            else
                                            {
                                                @* Each tag is its own collapsed section: the category opens as a short
                                                   list of tag subtotals — the answer to "what inside Food?" — and only
                                                   the tag you press unrolls its receipts. *@
                                                @foreach (var grp in BreakExpandGroups(slExps))
                                                {
                                                    var grpOpen = _brkGrpExpanded.Contains((s.Key, grp.Key));
                                                    <div class="brk-exp-grp-head @(grpOpen ? "open" : "")" @onclick:stopPropagation="true" @onclick="() => ToggleBreakGroup(s.Key, grp.Key)">
                                                        @TagMark(grp.Icon)
                                                        <span class="brk-exp-grp-name">@grp.Label</span>
                                                        <span class="brk-exp-grp-tot">@Fmt(grp.Total)</span>
                                                        @* The chevron is wrapped, and the wrapper is what turns. A scoped
                                                           CSS rule can only reach elements of THIS component, so a rule
                                                           ending at the <Icon>'s own <svg> never matches and the rotation
                                                           silently does nothing — see the sibling .brk-item-chev. *@
                                                        <span class="brk-exp-grp-chev"><Icon Name="chevron" /></span>
                                                    </div>
                                                    @if (grpOpen)
                                                    {
                                                        <ul class="brk-exp-list">
                                                            @foreach (var e in grp.Items) { @brkExpRow(e) }
                                                        </ul>
                                                    }
                                                }
                                            }
                                        </div>
                                    }
                                </li>
                            }
                        </ul>
                    }
                </div>
                }
                else if (_spendView == SpendView.Trends)
                {
                @* Trends: money over time (income / spent / saved / balance) across periods, over the shared window.
                   Answers "how is it moving?" — the question By date / By budgets / Breakdown don't. Reuses the
                   Breakdown range window; also the new home of the per-category trend sparklines (moved out of the
                   Health modal so trends live in one place — BACKLOG #16). *@
                <div class="trend-view">
                    <div class="brk-ranges" role="group">
                        @{
                            (BreakRange R, string L)[] tranges = new[]
                            {
                                (BreakRange.M3, Loc["3 months"]),
                                (BreakRange.M6, Loc["6 months"]),
                                (BreakRange.M12, Loc["12 months"]),
                                (BreakRange.All, Loc["All time"]),
                            };
                        }
                        @foreach (var (r, l) in tranges)
                        {
                            @* Crown only on the windows Free can't reach (6m/12m/All) — the gate in SetBreakRange
                               uses the same list, so the marks and the enforcement stay in step. *@
                            <button type="button" class="chip @(_breakRange == r ? "on" : "")" @onclick="() => SetBreakRange(r)">@l@if (r is BreakRange.M6 or BreakRange.M12 or BreakRange.All) { <ProLock Feature="@PlanFeatures.History" Static="true" /> }</button>
                        }
                    </div>
                    @{
                        var trRows = TrendRows();
                        var trCi = System.Globalization.CultureInfo.InvariantCulture;
                    }
                    @if (trRows.Count < 2)
                    {
                        <p class="brk-empty"><Icon Name="pulse" /> @Loc["Come back after a couple of months — trends need a few periods of history to show."]</p>
                    }
                    else
                    {
                        var trSc = TrendFlowScale(trRows);
                        var trPick = TrendPick;
                        var trBal = TrendBalanceScale(trRows, trPick);
                        var trSeriesColor = TrendSeriesColor();
                        // Does this window straddle a year? Decides whether the axis says "Jan" or "Jan 24" — on
                        // BOTH charts, because two axes over the same months formatted differently would be worse
                        // than the repeated-"Jan" bug being fixed. See TrendLabel.
                        var trMultiYear = trRows.Select(r => r.From.Year).Distinct().Count() > 1;
                        // Cap x-axis labels to avoid crowding — five when the year rides along, six without it.
                        var trStride = Math.Max(1, (trRows.Count + (trMultiYear ? 4 : 5)) / (trMultiYear ? 5 : 6));
                        var trSlotW = (TrX1 - TrX0) / Math.Max(1, trRows.Count);
                        // Three bars a month with a little air either side. In and out are context; net is the point,
                        // so it is the widest of the three and the only saturated one.
                        // Four bars now (in · kept · out · saved), so each is narrower than the three-bar layout.
                        var trBarW = Math.Max(1.8, trSlotW * 0.17);
                        var trNetW = Math.Max(2.4, trSlotW * 0.23);
                        var trZeroY = TrendY(0m, trSc);
                        // Values sit on the bars themselves at short windows. Hover-only numbers mean the chart can't
                        // be read at a glance at all, and 3 months is the window people actually read.
                        var trLabelBars = trRows.Count <= 6;
                        <div class="trend-chart-wrap">
                        <div class="trend-plot-area">
                            <svg class="trend-chart" @key="(_breakRange, trRows.Count)" viewBox="0 0 340 152" role="img" aria-label="@Loc["Money in, spent and kept, month by month"]">
                                @* Gridlines per tick so a bar's height means something without hovering it. The tick
                                   TEXT is HTML overlaid below, not <text> — Razor reserves that tag name and won't
                                   take attributes on it; the x-axis labels already work this way. *@
                                @foreach (var tv in trSc.Ticks)
                                {
                                    var gy = TrendY(tv, trSc);
                                    <line x1="@TrX0.ToString("0.#", trCi)" y1="@gy.ToString("0.#", trCi)" x2="@TrX1.ToString("0.#", trCi)" y2="@gy.ToString("0.#", trCi)" class="@(tv == 0m ? "trend-axis" : "trend-grid")" />
                                }
                                @for (var i = 0; i < trRows.Count; i++)
                                {
                                    var row = trRows[i];
                                    var (cx, _) = TrendSlot(trRows.Count, i);
                                    var (inY, inH) = TrendBar(row.Income, trSc);
                                    var (outY, outH) = TrendBar(row.Expenses, trSc);
                                    var (netY, netH) = TrendBar(row.Net, trSc);
                                    var (savY, savH) = TrendBar(row.Saved, trSc);
                                    var netColor = row.Net < 0m ? TrendNetDownColor : TrendNetUpColor;
                                    var dim = _trendFlowHover is { } hv && hv != i ? "trend-bar-dim" : "";
                                    @* --tb staggers the grow: the months rise left to right, in the order they
                                       happened, so the entrance reads as the story the chart is telling rather than
                                       as everything twitching at once. *@
                                    <g class="trend-bars @dim" style="--tb:@i">
                                        <rect class="trend-bar trend-bar-in" x="@((cx - trNetW / 2 - trBarW - 1).ToString("0.#", trCi))" y="@inY.ToString("0.#", trCi)"
                                              width="@trBarW.ToString("0.#", trCi)" height="@inH.ToString("0.#", trCi)" fill="@TrendInColor" rx="1.5" />
                                        @* A negative "kept" bar hangs BELOW the zero line, so it has to grow
                                           downward from the axis. Growing it from its own bottom edge — the default
                                           for every other bar here — would have it rise up out of the floor of the
                                           chart to meet a baseline it never touches. *@
                                        <rect class="trend-bar trend-bar-net @(row.Net < 0m ? "trend-bar-down" : "")" x="@((cx - trNetW / 2).ToString("0.#", trCi))" y="@netY.ToString("0.#", trCi)"
                                              width="@trNetW.ToString("0.#", trCi)" height="@netH.ToString("0.#", trCi)" fill="@netColor" rx="1.5" />
                                        <rect class="trend-bar trend-bar-out" x="@((cx + trNetW / 2 + 1).ToString("0.#", trCi))" y="@outY.ToString("0.#", trCi)"
                                              width="@trBarW.ToString("0.#", trCi)" height="@outH.ToString("0.#", trCi)" fill="@TrendOutColor" rx="1.5" />
                                        @* Saved sits on the far right, outside the in/kept/out triple: those three
                                           are one arithmetic (in − out = kept) and saved is a decision taken out of
                                           what was kept, not a fourth term in the same sum. *@
                                        <rect class="trend-bar trend-bar-saved" x="@((cx + trNetW / 2 + trBarW + 2).ToString("0.#", trCi))" y="@savY.ToString("0.#", trCi)"
                                              width="@trBarW.ToString("0.#", trCi)" height="@savH.ToString("0.#", trCi)" fill="@TrendSavedColor" rx="1.5" />
                                    </g>
                                }
                                @* Full-height hit columns, one per month. A column reads the whole month at once,
                                   which is the question being asked ("what happened in May?"), and it works on touch
                                   where hovering a 3px bar does not. *@
                                @for (var i = 0; i < trRows.Count; i++)
                                {
                                    var hi = i;
                                    var (hcx, hw) = TrendSlot(trRows.Count, i);
                                    <rect x="@((hcx - hw / 2).ToString("0.#", trCi))" y="@TrY0.ToString("0.#", trCi)" width="@hw.ToString("0.#", trCi)" height="@((TrY1 - TrY0).ToString("0.#", trCi))"
                                          class="trend-hit" @onpointerenter="e => TrendPointerEnter(e, TrendChartId.Flows, hi)" @onpointerleave="e => TrendPointerLeave(e, TrendChartId.Flows)" @onpointerdown="e => TrendPointerDown(e, TrendChartId.Flows, hi)" />
                                }
                            </svg>
                            <div class="trend-ylabels" aria-hidden="true">
                                @foreach (var tv in trSc.Ticks)
                                {
                                    var ly = TrendY(tv, trSc) / 152.0 * 100.0;
                                    <span class="trend-ylbl" style="top:@ly.ToString("0.##", trCi)%">@TrendTick(tv)</span>
                                }
                            </div>
                            @* Net printed above (or below) its own bar at short windows — the one number worth
                               reading without interacting. Positioned in percentages over the plot so it scales
                               with the responsive SVG. *@
                            @if (trLabelBars)
                            {
                                <div class="trend-barlabels" aria-hidden="true">
                                    @for (var i = 0; i < trRows.Count; i++)
                                    {
                                        var row = trRows[i];
                                        var (cx, _) = TrendSlot(trRows.Count, i);
                                        var (nY, nH) = TrendBar(row.Net, trSc);
                                        var down = row.Net < 0m;
                                        var topY = down ? nY + nH : nY;
                                        <span class="trend-barlbl @(down ? "down" : "up")"
                                              style="left:@((cx / 340.0 * 100.0).ToString("0.##", trCi))%; top:@((topY / 152.0 * 100.0).ToString("0.##", trCi))%">@TrendTick(row.Net)</span>
                                    }
                                </div>
                            }
                        </div>
                            @if (_trendFlowHover is { } tp && tp >= 0 && tp < trRows.Count)
                            {
                                var tipX = TrendSlot(trRows.Count, tp).Centre / 340.0 * 100.0;
                                var tipRow = trRows[tp];
                                <div class="trend-tip @(tipX > 60 ? "left" : "")" style="left:@tipX.ToString("0.#", trCi)%">
                                    <span class="trend-tip-h">@TrendLabel(tipRow, trMultiYear)</span>
                                    <span class="trend-tip-row">
                                        <span class="trend-leg-dot" style="background:@TrendInColor"></span>
                                        <span class="trend-tip-n">@Loc["Money in"]</span>
                                        <span class="trend-tip-v">@Fmt(State.Money(tipRow.Income))</span>
                                    </span>
                                    <span class="trend-tip-row">
                                        <span class="trend-leg-dot" style="background:@TrendOutColor"></span>
                                        <span class="trend-tip-n">@Loc["Spent"]</span>
                                        <span class="trend-tip-v">@Fmt(State.Money(tipRow.Expenses))</span>
                                    </span>
                                    <span class="trend-tip-row trend-tip-net">
                                        <span class="trend-leg-dot" style="background:@(tipRow.Net < 0m ? TrendNetDownColor : TrendNetUpColor)"></span>
                                        <span class="trend-tip-n">@Loc["Kept"]</span>
                                        <span class="trend-tip-v">@Fmt(State.Money(tipRow.Net))</span>
                                    </span>
                                    <span class="trend-tip-row">
                                        <span class="trend-leg-dot" style="background:@TrendSavedColor"></span>
                                        <span class="trend-tip-n">@Loc["Saved"]</span>
                                        <span class="trend-tip-v">@Fmt(State.Money(tipRow.Saved))</span>
                                    </span>
                                    <span class="trend-tip-row">
                                        <span class="trend-leg-dot" style="background:@TrendBalColor"></span>
                                        <span class="trend-tip-n">@Loc["Balance"]</span>
                                        <span class="trend-tip-v">@Fmt(State.Money(tipRow.Balance))</span>
                                    </span>
                                    @* The sentence the dip needed. Without it a month that cleared a chunk of a
                                       loan is indistinguishable from a month that overspent by the same amount.
                                       The "balance fell" half only applies while the balance is what's drawn —
                                       on the other three the money leaving is the fact, not the shape of the line. *@
                                    @if (tipRow.DebtPaid > 0m)
                                    {
                                        <span class="trend-tip-note">
                                            @(_trendSeries == TrendSeries.Balance
                                                ? string.Format(Loc["{0} of this went onto a loan — the balance fell because the debt did."], Fmt(State.Money(tipRow.DebtPaid)))
                                                : string.Format(Loc["{0} went onto a loan this month."], Fmt(State.Money(tipRow.DebtPaid))))
                                        </span>
                                    }
                                </div>
                            }
                            <div class="trend-xaxis">
                                @for (var i = 0; i < trRows.Count; i++)
                                {
                                    @if (i % trStride == 0 || i == trRows.Count - 1)
                                    {
                                        var lx = TrendSlot(trRows.Count, i).Centre / 340.0 * 100.0;
                                        <span class="trend-xlbl @(_trendFlowHover == i ? "on" : "")" style="left:@lx.ToString("0.#", trCi)%">@TrendLabel(trRows[i], trMultiYear)</span>
                                    }
                                }
                            </div>
                        </div>
                        @* A key, not a control. The old legend's hide-toggles existed so a giant balance line could
                           be dropped to read the flow lines; with the two on separate axes there is nothing left to
                           work around, and a toggle that only ever removes information is a worse default than none. *@
                        <div class="trend-key">
                            <span class="trend-key-item"><span class="trend-leg-dot" style="background:@TrendInColor"></span>@Loc["Money in"]</span>
                            <span class="trend-key-item"><span class="trend-leg-dot" style="background:@TrendOutColor"></span>@Loc["Spent"]</span>
                            <span class="trend-key-item trend-key-net"><span class="trend-leg-dot" style="background:@TrendNetUpColor"></span>@Loc["Kept (what’s left)"]</span>
                            <span class="trend-key-item"><span class="trend-leg-dot" style="background:@TrendSavedColor"></span>@Loc["Saved"]</span>
                        </div>

                        @* The stock, on its own axis. Same slot centres as the bars above, so a month lines up
                           vertically across both charts and the hover highlights the same column in each. *@
                        @* Four views over the same months. The bars above answer "what happened in May?"; this line
                           answers "which way has it been going?" — and until now it could only ask that of the
                           balance. The debt ring stays on whichever series is shown: the month a loan was paid down
                           is worth marking whether you are looking at the balance that fell or the spending that
                           did not rise. *@
                        @* ⚠️ These four (and the focus pickers below) clear the LOWER chart's readout only. They
                           change what this line draws, so a readout of the old series would be stale — but the bar
                           chart above did not change, and closing its tooltip would be an unexplained loss. *@
                        <div class="trend-series-sw" role="group" aria-label="@Loc["What the lower chart shows"]">
                            @foreach (var s in new[] { TrendSeries.Balance, TrendSeries.Spent, TrendSeries.Saved, TrendSeries.Kept })
                            {
                                var ss = s;
                                <button type="button" class="chip @(_trendSeries == s ? "on" : "")" @onclick="() => { _trendSeries = ss; _trendSeriesHover = null; }">@TrendSeriesLabel(s)</button>
                            }
                        </div>
                        @* ★ O14 — the same line, narrowed to ONE category or ONE bucket. It appears only under the
                           two series it can narrow: Balance and Kept are account-wide by definition, and a picker
                           offering to filter them would be promising something it cannot do.
                           A native <select>, not CategoryPicker: this is a chart control on a dense analysis screen,
                           not a modal field, and it sits inline with a label rather than opening an overlay over
                           the chart it is filtering. "Everything" is the first option and the default — the whole
                           account is what every other figure on this screen means. *@
                        @if (_trendSeries is TrendSeries.Spent or TrendSeries.Saved)
                        {
                            <div class="trend-focus">
                                <label class="trend-focus-lbl">
                                    @(_trendSeries == TrendSeries.Spent ? Loc["Category"] : Loc["Bucket"])
                                    @if (_trendSeries == TrendSeries.Spent)
                                    {
                                        <select class="trend-focus-sel" @bind="_trendCatId" @bind:after="() => _trendSeriesHover = null">
                                            <option value="@Guid.Empty">@Loc["Everything"]</option>
                                            @foreach (var c in State.CategoryOptions.Where(c => c.Category.ParentId is null))
                                            {
                                                <option value="@c.Category.Id">@c.Category.Name</option>
                                            }
                                        </select>
                                    }
                                    else
                                    {
                                        <select class="trend-focus-sel" @bind="_trendBucketId" @bind:after="() => _trendSeriesHover = null">
                                            <option value="@Guid.Empty">@Loc["Everything"]</option>
                                            @foreach (var (b, _) in State.SavingBuckets)
                                            {
                                                <option value="@b.Id">@b.Name</option>
                                            }
                                        </select>
                                    }
                                </label>
                                @if (TrendFocused)
                                {
                                    <button type="button" class="chip trend-focus-clear" @onclick="() => { _trendCatId = Guid.Empty; _trendBucketId = Guid.Empty; _trendSeriesHover = null; }"><Icon Name="x" /> @Loc["Clear"]</button>
                                }
                            </div>
                        }
                        <h5 class="trend-sub-h">@TrendSeriesHeading()</h5>
                        <div class="trend-chart-wrap trend-bal-wrap">
                            <div class="trend-plot-area trend-bal-area">
                                @* The label tracks the series AND the focus, exactly as the visible heading above
                                   does. It used to say "Balance at the end of each month" whatever was drawn, so a
                                   screen-reader user was told the one thing sighted users had just been corrected on. *@
                                <svg class="trend-chart" @key="(_breakRange, trRows.Count, 'b')" viewBox="0 0 340 92" role="img" aria-label="@TrendSeriesHeading()">
                                    @foreach (var tv in trBal.Ticks)
                                    {
                                        var gy = TrendBalY(tv, trBal);
                                        <line x1="@TrX0.ToString("0.#", trCi)" y1="@gy.ToString("0.#", trCi)" x2="@TrX1.ToString("0.#", trCi)" y2="@gy.ToString("0.#", trCi)" class="@(tv == 0m ? "trend-axis" : "trend-grid")" />
                                    }
                                    <polygon class="trend-bal-fill" points="@TrendBalanceArea(trRows, trBal, trPick)" fill="@trSeriesColor" />
                                    <polyline class="trend-line" pathLength="1" points="@TrendBalancePoints(trRows, trBal, trPick)" fill="none" stroke="@trSeriesColor" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round" />
                                    @for (var i = 0; i < trRows.Count; i++)
                                    {
                                        var (bcx, _) = TrendSlot(trRows.Count, i);
                                        @* A month that paid down a loan wears a ring instead of a plain dot. The dip
                                           under it is real — the cash did leave — so it is annotated rather than
                                           flattened: the line keeps telling the truth and the ring says why it fell.
                                           Green, because the reason is the opposite of a bad month. *@
                                        @if (trRows[i].DebtPaid > 0m)
                                        {
                                            <circle cx="@bcx.ToString("0.#", trCi)" cy="@TrendBalY(trPick(trRows[i]), trBal).ToString("0.#", trCi)" r="@(_trendSeriesHover == i ? "6.5" : "5.5")" class="trend-debt-ring" />
                                        }
                                        <circle cx="@bcx.ToString("0.#", trCi)" cy="@TrendBalY(trPick(trRows[i]), trBal).ToString("0.#", trCi)" r="@(_trendSeriesHover == i ? "4" : "2.4")" fill="@trSeriesColor" class="trend-pt" />
                                    }
                                    @for (var i = 0; i < trRows.Count; i++)
                                    {
                                        var hi = i;
                                        var (hcx, hw) = TrendSlot(trRows.Count, i);
                                        <rect x="@((hcx - hw / 2).ToString("0.#", trCi))" y="@BalY0.ToString("0.#", trCi)" width="@hw.ToString("0.#", trCi)" height="@((BalY1 - BalY0).ToString("0.#", trCi))"
                                              class="trend-hit" @onpointerenter="e => TrendPointerEnter(e, TrendChartId.Series, hi)" @onpointerleave="e => TrendPointerLeave(e, TrendChartId.Series)" @onpointerdown="e => TrendPointerDown(e, TrendChartId.Series, hi)" />
                                    }
                                </svg>
                                <div class="trend-ylabels" aria-hidden="true">
                                    @foreach (var tv in trBal.Ticks)
                                    {
                                        var ly = TrendBalY(tv, trBal) / 92.0 * 100.0;
                                        <span class="trend-ylbl" style="top:@ly.ToString("0.##", trCi)%">@TrendTick(tv)</span>
                                    }
                                </div>
                            </div>
                            @* This chart's own readout. ONE row, not a copy of the five above: the bars answer
                               "what happened in May?" and want every term of the arithmetic, while this line draws
                               a single series — restating four numbers already on screen would bury the one the
                               reader came for. That one is trPick(row), the same focus-aware selector the line
                               itself is drawn from, so the tooltip cannot disagree with the shape it annotates:
                               narrowed to Food it says "Food €412", not "Spent €412".
                               No new CSS — .trend-tip is absolute and .trend-chart-wrap is already relative. *@
                            @if (_trendSeriesHover is { } sp && sp >= 0 && sp < trRows.Count)
                            {
                                var sTipX = TrendSlot(trRows.Count, sp).Centre / 340.0 * 100.0;
                                var sTipRow = trRows[sp];
                                <div class="trend-tip @(sTipX > 60 ? "left" : "")" style="left:@sTipX.ToString("0.#", trCi)%">
                                    <span class="trend-tip-h">@TrendLabel(sTipRow, trMultiYear)</span>
                                    <span class="trend-tip-row">
                                        <span class="trend-leg-dot" style="background:@trSeriesColor"></span>
                                        <span class="trend-tip-n">@(TrendFocused ? TrendFocusName : TrendSeriesLabel(_trendSeries))</span>
                                        <span class="trend-tip-v">@Fmt(State.Money(trPick(sTipRow)))</span>
                                    </span>
                                    @* The ring's own sentence, on the chart that draws the ring. Same wording as
                                       the bar chart's, because it is the same fact. *@
                                    @if (sTipRow.DebtPaid > 0m)
                                    {
                                        <span class="trend-tip-note">
                                            @(_trendSeries == TrendSeries.Balance
                                                ? string.Format(Loc["{0} of this went onto a loan — the balance fell because the debt did."], Fmt(State.Money(sTipRow.DebtPaid)))
                                                : string.Format(Loc["{0} went onto a loan this month."], Fmt(State.Money(sTipRow.DebtPaid))))
                                        </span>
                                    }
                                </div>
                            }
                            @* Owner ask: the periods, on the axis. Same stride and same wording as the chart above
                               — one month is one column across both, so they must read the same. *@
                            <div class="trend-xaxis">
                                @for (var i = 0; i < trRows.Count; i++)
                                {
                                    @if (i % trStride == 0 || i == trRows.Count - 1)
                                    {
                                        var slx = TrendSlot(trRows.Count, i).Centre / 340.0 * 100.0;
                                        <span class="trend-xlbl @(_trendSeriesHover == i ? "on" : "")" style="left:@slx.ToString("0.#", trCi)%">@TrendLabel(trRows[i], trMultiYear)</span>
                                    }
                                }
                            </div>
                        </div>
                    }
                    @* Owner ask #7, the half that can be said honestly: WHICH periods ran heavy, and what drove
                       each. It reports; it does not predict. With about a year of history there is one observation
                       per month, so a seasonal pattern cannot be told from a one-off — "next December will be
                       expensive" is a guess in a confident voice, and this app doesn't make those. A second year
                       earns that claim. Lives inside Trends rather than as its own section: it answers the same
                       "how is it moving?" question the rest of this view does. *@
                    @{ var costHeavy = State.CostHeavyPeriods(); }
                    @if (costHeavy.Count > 0 && State.TypicalPeriodSpend() is { } typicalSpend)
                    {
                        <h4 class="insight-h trend-spark-h">@Loc["The periods that cost you most"]</h4>
                        <p class="hint costly-intro">@string.Format(Loc["A typical period costs you {0}. These ran above it — worth a look before the same time next year, though one year of history can't tell a season from a one-off."], Fmt(State.Money(typicalSpend)))</p>
                        <div class="costly-list">
                            @foreach (var ch in costHeavy.Take(4))
                            {
                                <div class="costly-row">
                                    <span class="costly-when">@ch.From.ToString("MMM yyyy")</span>
                                    <span class="costly-main">
                                        <span class="costly-total">@Fmt(State.Money(ch.Total))</span>
                                        <span class="costly-over">+@Fmt(State.Money(ch.Excess)) @Loc["over typical"]</span>
                                    </span>
                                    @if (ch.DriverCategoryId is { } drv && ch.DriverExcess > 0m)
                                    {
                                        @* The category that was unusual FOR ITSELF that period — not simply the
                                           biggest one, or rent would be blamed every time. *@
                                        <span class="costly-driver" title="@string.Format(Loc["{0} ran {1} above its own usual that period."], State.CategoryName(drv), Fmt(State.Money(ch.DriverExcess)))">
                                            <CatIcon Name="@State.CategoryIcon(drv)" /> @State.CategoryName(drv)
                                        </span>
                                    }
                                </div>
                            }
                        </div>
                    }
                    @{ var trReport = CurrentReport(); }
                    @if (trReport.MiniTrends.Count > 0)
                    {
                        <h4 class="insight-h trend-spark-h">@Loc["Trends over time"]</h4>
                        <section class="mini-trends">
                            @foreach (var mt in trReport.MiniTrends)
                            {
                                var mtLabel = N(mt.Label);
                                <div class="mini-trend @(mt.Dir == DeltaDir.Up ? "up" : mt.Dir == DeltaDir.Down ? "down" : "flat")">
                                    <div class="mt-head">
                                        <span class="mt-label"><CatIcon Name="@CategoryIcons.Effective(mt.Icon, mtLabel)" /> @mtLabel</span>
                                        <span class="mt-cur">@N(mt.CurrentText)</span>
                                    </div>
                                    @TrendSparkline(mt.Points)
                                    <div class="mt-note">@N(mt.DeltaNote)</div>
                                </div>
                            }
                        </section>
                    }
                </div>
                }
                else if (_spendView == SpendView.Trips)
                {
                @* Trips: what each journey cost. Gathered by LINK across periods, which is why a flight bought in
                   March shows up under a June trip — and why these totals deliberately don't match any one
                   period's spending. *@
                <div class="trips-view">
                    @* Sort applies to FINISHED trips only. A trip you are on and one you leave for on Friday are
                       answers to "what now?", so they stay pinned at the top in date order however the history
                       below them is arranged — sorting them by size would bury today's trip under a big one from
                       two years ago. The control only appears once there is more than one past trip to order. *@
                    @if (TripHistory().Count > 1)
                    {
                        <div class="trips-sort" role="group">
                            <span class="trips-sort-lbl">@Loc["Past trips"]</span>
                            <button type="button" class="chip @(_tripSort == TripSort.Date ? "on" : "")" @onclick="() => _tripSort = TripSort.Date"><Icon Name="calendar" /> @Loc["By date"]</button>
                            <button type="button" class="chip @(_tripSort == TripSort.Spent ? "on" : "")" @onclick="() => _tripSort = TripSort.Spent"><Icon Name="coins" /> @Loc["By amount"]</button>
                        </div>
                    }
                    @foreach (var tRecap in SortedTripRecaps())
                    {
                        var trip = State.FindTrip(tRecap.TripId)!;
                        var today = State.TodayDate;
                        var open = _expandedTripId == tRecap.TripId;
                        // ⚠️ Finished FIRST, then active. A trip awaiting its start confirmation is neither active
                        // nor upcoming, and testing "upcoming" before "finished" would drop it into the past.
                        var status = trip.IsFinishedOn(today) ? "past" : trip.IsActiveOn(today) ? "now" : "soon";
                        // One icon per state, so the card says which of the three it is before any date is read:
                        // a pin for the one you are standing in, a departing plane for one still ahead, a flag for
                        // one that is over. The colour is the card's own status colour, set in CSS.
                        var statusIcon = status switch { "now" => "pin", "soon" => "plane", _ => "flag" };
                        var awaitingStart = trip.IsAwaitingStart(today);
                        // Lead with tags when enough of the trip is labelled; otherwise categories, the axis every
                        // expense always carries. A pie that is mostly one grey "untagged" wedge tells nobody anything.
                        var byTag = tRecap.TagsAreRepresentative && tRecap.TagBreakdown.Count > 0;
                        @* ⚠️ TripSliceName, not TagName/CategoryName: a slice keyed on an id minted in ANOTHER
                           account resolves to nothing here, so a foreign wedge would be labelled "—" while being
                           perfectly correct underneath. *@
                        var tSlices = (byTag
                                ? tRecap.TagBreakdown.Select(s => (Key: s.Id, Label: State.TripSliceName(tRecap, s.Id, true), Icon: State.TagIcon(s.Id), Amt: s.Total.Amount))
                                : tRecap.CategoryBreakdown.Select(s => (Key: s.Id, Label: State.TripSliceName(tRecap, s.Id, false), Icon: State.CategoryStoredIcon(s.Id), Amt: s.Total.Amount)))
                            .Where(s => s.Amt > 0m)
                            .Take(MaxSlices)
                            .Select((s, i) => new BreakSlice(s.Key, s.Label, s.Icon, s.Amt, SliceColor(i)))
                            .ToList();
                        var tTotal = tSlices.Sum(s => s.Amount);
                        double sweepAt = 0;
                        <div class="trip-card @status @(open ? "open" : "")">
                            @* Edit and delete are icons rather than two more words in the action row: they change
                               what the trip IS, where the row below acts on the money.
                               ⚠️ They sit in the FLOW of the top row, immediately left of the total — they used to be
                               absolutely positioned in the card's corner, which put them straight on top of the
                               amount. Three siblings, not one nested block, because a button inside a button is not
                               clickable: the name and the total are two separate expanders. *@
                            <div class="trip-top">
                                <button type="button" class="trip-head" @onclick="() => _expandedTripId = open ? Guid.Empty : tRecap.TripId">
                                    <span class="trip-mark">@TripMark(trip.Icon)<span class="trip-status" title="@(status == "now" ? Loc["Happening now"] : status == "soon" ? Loc["Still ahead"] : Loc["Finished"])"><Icon Name="@statusIcon" /></span></span>
                                    <span class="trip-id">
                                        <span class="trip-name">@trip.Name</span>
                                        <span class="trip-when">
                                            @trip.From.ToString("d MMM")–@trip.To.ToString("d MMM yyyy")
                                            @if (trip.IsActiveOn(today))
                                            {
                                                <span class="trip-pill now">@string.Format(Loc["Day {0}"], trip.DayOn(today))</span>
                                            }
                                            else if (awaitingStart)
                                            {
                                                @* The dates have arrived; the traveller hasn't said so. Its own pill,
                                                   because "Day 1" would be a claim and "in 0 days" is not an answer. *@
                                                <span class="trip-pill soon">@Loc["Ready to go"]</span>
                                            }
                                            else if (trip.DaysUntil(today) is { } sleeps)
                                            {
                                                <span class="trip-pill soon">@(sleeps == 0 ? Loc["Today"] : string.Format(Loc["in {0} days"], sleeps))</span>
                                            }
                                        </span>
                                    </span>
                                </button>
                                <span class="trip-corner">
                                    <button type="button" class="trip-corner-b" title="@Loc["Edit"]" aria-label="@Loc["Edit"]" @onclick="() => OpenEditTrip(tRecap.TripId)"><Icon Name="pencil" /></button>
                                    <button type="button" class="trip-corner-b danger" title="@Loc["Delete"]" aria-label="@Loc["Delete"]" @onclick="() => ConfirmRemoveTrip(tRecap.TripId)"><Icon Name="trash" /></button>
                                </span>
                                <button type="button" class="trip-total" @onclick="() => _expandedTripId = open ? Guid.Empty : tRecap.TripId">@Fmt(tRecap.Spent)</button>
                            </div>
                            @if (open)
                            {
                                <div class="trip-body">
                                    @if (tRecap.IsEmpty)
                                    {
                                        <p class="hint">@Loc["Nothing logged against this trip yet. Log an expense while you're away, or add something you've already paid for — a flight, a hotel."]</p>
                                    }
                                    else
                                    {
                                        @* The three-way split is the point of the whole feature: the pre-paid half is
                                           the part people forget, because the trip felt like it cost what they spent
                                           while they were there. *@
                                        <div class="trip-when-split">
                                            <span class="tws"><span class="tws-k">@Loc["Booked ahead"]</span><span class="tws-v">@Fmt(tRecap.PrePaid)</span></span>
                                            <span class="tws"><span class="tws-k">@Loc["While away"]</span><span class="tws-v">@Fmt(tRecap.OnTrip)</span></span>
                                            @if (!tRecap.AfterReturn.IsZero)
                                            {
                                                <span class="tws"><span class="tws-k">@Loc["After getting back"]</span><span class="tws-v">@Fmt(tRecap.AfterReturn)</span></span>
                                            }
                                            <span class="tws"><span class="tws-k">@Loc["A day"]</span><span class="tws-v">@Fmt(tRecap.PerDay)</span></span>
                                        </div>
                                        @* ★ What the trip cost in working time. This is the second place in the app
                                           the time cost appears, and the trip is the right one: it is a single,
                                           finished, memorable total that the reader has deliberately opened — "Lisbon
                                           was four days of work" is a sentence, where "this coffee is 24 minutes" on
                                           every ledger row would be nagging. One line inside a card that is already
                                           open, not a section, and it says nothing at all when no rate is set. *@
                                        @if (State.TimeCostLabel(tRecap.Spent.Amount) is { } tripTimeCost)
                                        {
                                            <p class="trip-timecost"><Icon Name="clock" /> @string.Format(Loc["That's about {0} of work."], tripTimeCost)</p>
                                        }

                                        @if (tRecap.AgainstBudget is { } delta)
                                        {
                                            <p class="trip-budget @(tRecap.IsOverBudget ? "over" : "under")">
                                                @(tRecap.IsOverBudget
                                                    ? string.Format(Loc["{0} over the {1} you planned."], Fmt(State.Money(Math.Abs(delta.Amount))), Fmt(State.Money(tRecap.Budget!.Value)))
                                                    : string.Format(Loc["{0} under the {1} you planned."], Fmt(State.Money(Math.Abs(delta.Amount))), Fmt(State.Money(tRecap.Budget!.Value))))
                                            </p>
                                        }
                                        @* ⚠️ D1 — say it, always. The total above folds in spend from another
                                           account, and a combined figure with nothing naming its parts is one
                                           nobody can reconcile against their own ledger. Same discipline as the
                                           savings line below: counted in the total AND reported separately. *@
                                        @if (tRecap.HasOtherAccountSpend)
                                        {
                                            <p class="trip-funded"><Icon Name="swap" /> @string.Format(Loc["{0} of this was paid from {1}."],
                                                Fmt(tRecap.PaidFromOtherAccounts),
                                                string.Join(" · ", tRecap.SourceAccountBreakdown.Where(s => s.Id != State.CurrentAccountId).Select(s => tRecap.ForeignName(s.Id) ?? "—")))</p>
                                        }
                                        @if (!tRecap.FundedFromSavings.IsZero && trip.SavingCategoryId is { } bkt)
                                        {
                                            @* The line the savings link exists for. It never discounts the total — the
                                               money left either way; it just says how much of it had been saved for. *@
                                            <p class="trip-funded"><Icon Name="target" /> @string.Format(Loc["{0} of this came out of {1}."], Fmt(tRecap.FundedFromSavings), State.SavingBucketName(bkt))</p>
                                        }
                                        @* The other half of the same sentence: money released from the pot into this
                                           trip's BUDGET, before any of it was spent. Both lines can show at once and
                                           neither discounts the total — see Trip.SavingsApplied. *@
                                        @if (trip.SavingsApplied > 0m && trip.SavingCategoryId is { } appliedBkt)
                                        {
                                            <p class="trip-funded"><Icon Name="coins" /> @string.Format(Loc["{0} released from {1} into this trip's budget."], Fmt(State.Money(trip.SavingsApplied)), State.SavingBucketName(appliedBkt))</p>
                                        }

                                        @if (tSlices.Count > 0 && tTotal > 0m)
                                        {
                                            <div class="trip-split">
                                                <svg class="trip-donut" viewBox="0 0 100 100" role="img" aria-label="@Loc["Where the trip money went"]">
                                                    @* ⚠️ A single slice has to be a CIRCLE, not an arc. An arc sweeping the
                                                       whole 100% starts and ends at the same point, so the path closes on
                                                       itself and draws nothing — the ring rendered as an empty box.
                                                       Now the ordinary case rather than an edge case: a trip files into one
                                                       category, so unless its labels are used there IS only ever one slice.
                                                       Same special case the Breakdown donut has always had. *@
                                                    @if (tSlices.Count == 1)
                                                    {
                                                        <circle cx="50" cy="50" r="36.5" fill="none" stroke="@tSlices[0].Color" stroke-width="19"><title>@tSlices[0].Label · 100%</title></circle>
                                                    }
                                                    else
                                                    {
                                                        @foreach (var s in tSlices)
                                                        {
                                                            var pct = (double)(s.Amount / tTotal) * 100.0;
                                                            <path d="@DonutArc(sweepAt, pct, 50, 50, 46, 27)" fill="@s.Color"><title>@s.Label · @pct.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)%</title></path>
                                                            sweepAt += pct;
                                                        }
                                                    }
                                                </svg>
                                                <ul class="trip-legend">
                                                    @foreach (var s in tSlices)
                                                    {
                                                        <li>
                                                            <span class="tl-dot" style="background:@s.Color"></span>
                                                            <span class="tl-label"><CatIcon Name="@CategoryIcons.Effective(s.Icon, s.Label)" /> @s.Label</span>
                                                            <span class="tl-amt">@Fmt(State.Money(s.Amount))</span>
                                                        </li>
                                                    }
                                                </ul>
                                            </div>
                                            @* The tag split is still the headline whenever half the trip is labelled
                                               (TagsAreRepresentative) — this is the fallback, and it now needs saying
                                               out loud. A trip files into ONE category, so the category axis draws a
                                               single full ring: true, and useless. Nothing is wrong with the chart;
                                               the trip simply hasn't been labelled, and the label is the only axis
                                               that can answer "what did the hotel cost". *@
                                            @if (!byTag)
                                            {
                                                <p class="hint">@(tRecap.TagBreakdown.Count > 0
                                                    ? Loc["Split by category, because most of this trip isn't labelled. Tag as you go and this becomes stay / travel / food / tickets."]
                                                    : Loc["One ring, because the whole trip files into one category and nothing here is labelled yet. Tag as you go and this becomes stay / travel / food / tickets."])</p>
                                            }
                                        }
                                        @if (tRecap.Biggest is { } big)
                                        {
                                            <p class="trip-biggest">@string.Format(Loc["Biggest single thing: {0} — {1}"], Fmt(big.Amount), string.IsNullOrWhiteSpace(big.Note) ? State.CategoryName(big.CategoryId) : big.Note)</p>
                                        }

                                        @* Everything attached to the trip, in the Breakdown's own row shape — the
                                           donut above says where the money went, and this says what it actually
                                           bought. Biggest first, matching every other expense list in Spending:
                                           the question a recap answers is "what did this cost", which a date order
                                           buries. Date breaks the ties.
                                           ⚠️ Not the period's expenses — the trip's, gathered by LINK across every
                                           period, so March's flight is in this list under a June trip. *@
                                        @* ⚠️ No `@{`: this sits inside the `else` of the IsEmpty check, which is already
                                           a code block — inside one, `@` is the switch back to markup, not into code. *@
                                        @* Newest first, and newest on the clock within a day (owner's call). A trip
                                           is the one list where a single day holds a dozen entries, and a size
                                           order turns a journey into a leaderboard — you read a trip as the days
                                           you lived. SortTime keeps an untimed row at the bottom of its own day
                                           instead of reading as midnight. *@
                                        var tExps = State.TripExpenses(tRecap.TripId)
                                            .OrderByDescending(e => e.Date).ThenByDescending(e => e.SortTime).ToList();
                                        @if (tExps.Count > 0)
                                        {
                                            <div class="trip-exps">
                                                <div class="trip-exps-head">
                                                    <span class="trip-exps-lbl">@Loc["Everything on this trip"]</span>
                                                    <span class="trip-exps-n">@tExps.Count</span>
                                                    @* Two ways to read the same list: down the days, or by what the
                                                       money was for. Neither is the "right" one — a trip you are
                                                       recalling reads by day, a trip you are accounting for reads
                                                       by what it bought.
                                                       ★ By TAG, not by category. A trip files into ONE category by
                                                       design (S101), so grouping by category produced a single group
                                                       containing everything — a control that could not do anything.
                                                       The tag is the axis that actually varies on a journey, and it
                                                       is the one the donut above already splits by. *@
                                                    <span class="trip-exps-sw">
                                                        <button type="button" class="chip @(!_tripByTag ? "on" : "")" @onclick="() => _tripByTag = false">@Loc["By date"]</button>
                                                        <button type="button" class="chip @(_tripByTag ? "on" : "")" @onclick="() => _tripByTag = true">@Loc["By label"]</button>
                                                    </span>
                                                </div>
                                                @if (_tripByTag)
                                                {
                                                    @* Biggest group first — grouped, the question stops being "when"
                                                       and becomes "what did most of this go on". Untagged rows are
                                                       one group of their own rather than being dropped: a trip is
                                                       usually only half-labelled, and hiding the other half would
                                                       make the totals disagree with the header. *@
                                                    foreach (var grp in tExps.GroupBy(e => e.TagId)
                                                        .Select(g => (Id: g.Key, Rows: g.ToList(), Total: g.Sum(x => x.Amount.Amount)))
                                                        .OrderByDescending(g => g.Id is null ? 0 : 1).ThenByDescending(g => g.Total))
                                                    {
                                                        <div class="trip-grp">
                                                            <span class="trip-grp-n">@if (grp.Id is { } gTag)
                                                                {
                                                                    <CatIcon Name="@State.TagIcon(gTag)" />@State.TagName(gTag)
                                                                }
                                                                else
                                                                {
                                                                    <CatIcon Name="tag" />@Loc["No label"]
                                                                }</span>
                                                            <span class="trip-grp-c">@grp.Rows.Count</span>
                                                            <span class="trip-grp-v">@Fmt(State.Money(grp.Total))</span>
                                                        </div>
                                                        <ul class="brk-exp-list">
                                                            @foreach (var te in grp.Rows)
                                                            {
                                                                @TripExpRow(trip, te)
                                                            }
                                                        </ul>
                                                    }
                                                }
                                                else
                                                {
                                                <ul class="brk-exp-list">
                                                    @foreach (var te in tExps)
                                                    {
                                                        @TripExpRow(trip, te)
                                                    }
                                                </ul>
                                                }
                                            </div>
                                        }
                                    }
                                    <div class="trip-acts">
                                        @* Attaching something already paid is a thing you do BEFORE and DURING a
                                           journey — the flight booked in March, the hotel paid on arrival. Once the
                                           last day has passed there is nothing left to bring along, so the door
                                           closes rather than sitting there inviting a late edit to a closed story. *@
                                        @if (trip.To >= today)
                                        {
                                            <button class="btn-soft" @onclick="() => OpenAttachToTrip(tRecap.TripId)"><Icon Name="plus" /> @Loc["Add something already paid"]</button>
                                        }
                                        @* The action the savings link was missing. Only when there is a pot to draw on and
                                           a category to release it into — without either there is nothing this could do,
                                           and a button that opens a dead end is worse than no button. *@
                                        @if (trip.SavingCategoryId is { } useBkt && trip.CategoryId is not null
                                             && State.SavingBucketSaved(useBkt).Amount > 0m && State.IsPeriodOpen)
                                        {
                                            <button class="btn-soft" @onclick="() => OpenUseTripSavings(tRecap.TripId)"><Icon Name="coins" /> @Loc["Use the saved money"] <ProLock Feature="@PlanFeatures.Trips" Static="true" /></button>
                                        }
                                        @* Finish means OVER, not "ends today": it ends the trip on the day it actually
                                           ended AND records that the traveller said so, because a trip whose last day is
                                           today would otherwise go on being worn by the app until midnight. Only on a
                                           running trip — a finished one offers the undo instead, and a future one would
                                           be cancelled rather than finished. *@
                                        @* The opt-in. Trip mode never switches itself on, so the day the dates arrive
                                           this is the tap that does it — the same confirmation the bell and Home
                                           offer, put where someone looking at the trip itself would reach for it. *@
                                        @* "Not finished after all" is gone entirely (owner's call). Un-finishing a
                                           journey is a correction, not an action worth a permanent button on every
                                           finished trip — the dates are editable if one was ended by mistake. *@
                                        @if (awaitingStart)
                                        {
                                            <button class="btn-soft primary" @onclick="() => StartTrip(tRecap.TripId)"><Icon Name="plane" /> @Loc["Let's go — start the trip"]</button>
                                        }
                                        else if (trip.IsActiveOn(today))
                                        {
                                            <button class="btn-soft" @onclick="() => FinishTrip(tRecap.TripId)"><Icon Name="flag" /> @Loc["Finish trip"]</button>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    @* Older trips are behind the same "full history" entitlement as the long Breakdown windows. Said
                       as a count, not a blank space, so it reads as "there is more here" rather than "we lost them". *@
                    @if (_tripsHidden > 0)
                    {
                        <ProLock Feature="@PlanFeatures.History" Bar="true" Label="@string.Format(Loc["{0} older trips — see your whole travel history with Pro"], _tripsHidden)" />
                    }
                    @* The tab is permanent now, so it has to say something when it is empty — otherwise a reader who
                       taps Trips out of curiosity gets a blank panel and a button, and never learns what the feature
                       is FOR. One sentence, and it names the thing that makes trips different from a tag: the flight
                       you paid for in March counts toward the June journey without leaving March's budget. *@
                    @if (SortedTripRecaps().Count == 0)
                    {
                        <p class="hint">@Loc["A trip gathers what a journey cost — even the parts you paid for months before you left. The flight stays in the budget of the month you bought it, and still counts toward the trip."]</p>
                    }
                    <button class="fund-add trips-add" @onclick="OpenAddTrip"><Icon Name="plus" /> @Loc["New trip"]<ProLock Feature="@PlanFeatures.Trips" Static="true" /></button>
                </div>
                }
            </section>

            @* Bank expenses to review moved off the Spending tab into the 🔔 review window (see the External-accounts button). *@
        </div>
        <div class="tabpanel" hidden="@(_tab != Tab.Savings)">
            @{
                var debtBuckets = State.SavingBuckets.Where(x => x.Bucket.IsDebt && !x.Bucket.IsArchived).ToList();
                var investmentBuckets = State.SavingBuckets.Where(x => x.Bucket.IsInvestment && !x.Bucket.IsArchived).ToList();
                var plainBuckets = State.SavingBuckets.Where(x => x.Bucket.Kind == SavingKind.Common && !x.Bucket.IsArchived).ToList();
                var expenseBuckets = State.SavingBuckets.Where(x => x.Bucket.IsExpensesFund && !x.Bucket.IsArchived).ToList();

                // Each goal/debt/investment is an expandable progress-bar row (mirrors the Spending tab's category rows):
                // the bar shows how far along it is, and tapping opens a drawer with the detail + every action. Debt rows
                // get an inline payoff simulator — drag "extra /mo" and the timeline animates to show the earlier payoff.
                RenderFragment<(SavingCategory Bucket, Money Total)> goalRow = ctx =>
                @<div class="cat-row goal-row@((_expandedGoalId == ctx.Bucket.Id ? " open" : "") + (_goalMoreId == ctx.Bucket.Id ? " goal-more-open" : ""))">
                    @{
                        var bucketId = ctx.Bucket.Id;
                        var isDebt = ctx.Bucket.IsDebt;
                        var isInvestment = ctx.Bucket.IsInvestment;
                        var isExpenses = ctx.Bucket.IsExpensesFund;
                        var total = ctx.Total;
                        var g = (!isDebt && !isInvestment && ctx.Bucket.HasGoal) ? State.SavingGoal(bucketId) : (SavingGoalProgress?)null;
                        var debtOwed = isDebt ? State.SavingBucketDebtBalance(bucketId) : 0m;
                        var debtOrig = isDebt ? State.SavingBucketDebtOriginal(bucketId) : 0m;
                        var debtPaid = isDebt ? State.SavingBucketDebtPaidOff(bucketId) : 0m;
                        var debtScale = debtOrig > 0m ? debtOrig : debtOwed;
                        var paidPct = (isDebt && debtScale > 0m) ? Math.Clamp((double)(debtPaid / debtScale) * 100.0, 0, 100) : 0.0;
                        var stagedPct = (isDebt && debtScale > 0m) ? Math.Clamp((double)(total.Amount / debtScale) * 100.0, 0, 100) : 0.0;
                        var goalPct = g is not null ? Math.Clamp((double)(g.Percent ?? 0), 0, 100) : 0.0;
                        // The bar reads positive here (progress toward a goal / down a debt), so a green fill — not the
                        // Spending tab's mint→coral spend-heat ramp. No goal/baseline → a flat, unfilled track.
                        var barPct = isDebt ? paidPct : goalPct;
                        var hasBar = isDebt ? debtScale > 0m : (g is not null);
                        var ringCls = isInvestment ? "invest" : isDebt ? "ok" : (g is null ? "mint" : (g.ThresholdReached && !g.GoalReached ? "warn" : "ok"));
                        var ringDashed = !isDebt && !isInvestment && g is null;
                        var ringRamp = (!isInvestment && !isDebt && !ringDashed) ? "goal" : null;
                        var done = isDebt ? ctx.Bucket.IsDebtCleared : (g is not null && g.GoalReached);
                        var open = _expandedGoalId == bucketId;
                        var barShown = barPct;
                        // Debt payoff sim — drives BOTH the 🏁 finish flag that slides along this row's own progress bar
                        // and the drawer slider's foot text, so they stay in sync (the slider lives in the drawer, the
                        // flag rides the bar above it — no separate timeline track). Only meaningful for an unpaid debt
                        // with an installment; the flag renders only while the row is open (its slider is on screen).
                        FinApp.Forecasting.LoanForecast.Payoff? payBase = null, payFast = null;
                        decimal payInst = 0m, paySliderMax = 0m;
                        int payBaseMonths = 0, payFastMonths = 0, payMonthsSaved = 0;
                        double payFlagPct = 0; var showPayoff = false;
                        if (isDebt && !done)
                        {
                            payInst = State.SavingBucketDebtInstallment(bucketId);
                            if (payInst > 0m)
                            {
                                var payRate = State.SavingBucketDebtRate(bucketId);
                                // On a lease the schedule ends at the residual, not at zero — amortising through it
                                // would put the finish flag months past the contract's own end date.
                                var payRes = State.SavingBucketDebtResidual(bucketId);
                                payBase = FinApp.Forecasting.LoanForecast.PayOff(debtOwed, payRate, payInst, payRes);
                                payFast = FinApp.Forecasting.LoanForecast.PayOff(debtOwed, payRate, payInst + _goalExtra, payRes);
                                payBaseMonths = payBase?.Months ?? 0;
                                payFastMonths = payFast?.Months ?? 0;
                                payMonthsSaved = payBaseMonths > 0 && payFastMonths > 0 ? Math.Max(0, payBaseMonths - payFastMonths) : 0;
                                paySliderMax = Math.Max(50m, Math.Ceiling(payInst * 3m / 10m) * 10m);
                                if (payFast is not null && payBaseMonths > 0)
                                {
                                    // Place the finish flag within the REMAINING part of the bar — between what's already
                                    // paid off (the fill) and 100% — so it can never sit left of the current progress (you
                                    // can't finish before where you already are). At the base installment it's at the far
                                    // end; extra payments slide it back toward the fill as the remaining journey shrinks.
                                    var payTimeRatio = (double)payFastMonths / payBaseMonths;   // 1 at base pace, → 0 with more extra
                                    payFlagPct = Math.Clamp(paidPct + (100.0 - paidPct) * payTimeRatio, paidPct, 100.0);
                                    showPayoff = true;
                                }
                            }
                        }
                    }
                    <div class="cat-row-head">
                        <button class="cat-row-hit" @onclick="() => ToggleGoalRow(bucketId)">
                            <span class="cat-chip-ring">
                                <ProgressRing Percent="@(isDebt ? paidPct : goalPct)" Percent2="@(isDebt ? stagedPct : 0)" Class="@ringCls" Class2="staged" Dashed="@ringDashed" Ramp="@ringRamp">
                                    <CatIcon Name="@State.SavingBucketIcon(bucketId)" Class="cat-chip-ring-ico" />
                                </ProgressRing>
                            </span>
                            <span class="cat-row-main">
                                <span class="cat-row-top">
                                    <span class="cat-row-name">@ctx.Bucket.Name@if (done) { <span class="goal-done-badge" title="@(isDebt ? Loc["Paid off"] : Loc["Goal reached"])">🎉</span> }@if (isDebt && !done && State.IsPeriodOpen)
                                        {
                                            @* Is this month's installment on the ledger? Every payment is money out and
                                               should be an expense, so the answer is worth seeing without opening the row —
                                               and it's the only place the app says whether logging is actually happening,
                                               which is what makes "the balance follows my logs" checkable rather than a
                                               promise. Derived from the rows themselves, so it can't drift.

                                               ⚠️ Both modes get a flag; they do NOT get the same words, and that is the
                                               whole point. On a payment-driven loan "nothing logged yet" is a prompt —
                                               the balance is waiting on the user. On a schedule-driven one nobody is
                                               meant to do anything: DebtBalanceOn carries the loan forward on the due
                                               day whether or not a payment is ever recorded here, so the same prompt
                                               sat there permanently — after the due day and every other day — reporting
                                               a problem that did not exist. What that mode owes the reader is the
                                               mechanics: what the schedule already took off, and when it acts next. *@
                                            @if (State.DebtInstallmentLoggedThisPeriod(bucketId) is not null)
                                            {
                                                <span class="inst-flag inst-flag-on" title="@string.Format(Loc["This period's installment is logged — {0} recorded as an expense."], Fmt(State.DebtPaidThisPeriod(bucketId)))"><Icon Name="check" /></span>
                                            }
                                            else if (State.SavingBucketDebtPaymentDriven(bucketId))
                                            {
                                                <span class="inst-flag" title="@Loc["No installment logged this period yet."]"><Icon Name="note" /></span>
                                            }
                                            else if (State.SavingBucketScheduleStep(bucketId) is { } step)
                                            {
                                                @* Dated from the same counter that moves the balance, so the day named
                                                   here is the day the figure changes — not an inference from the due day
                                                   that could disagree with it. *@
                                                @if (step.LastOn is { } lastOn)
                                                {
                                                    <span class="inst-flag inst-flag-on" title="@string.Format(Loc["Its own schedule: {0}'s installment is already counted — {1} off the principal, {2} interest. Nothing to log. Next on {3}."], lastOn.ToString("MMM"), Fmt(State.Money(step.LastPrincipal)), Fmt(State.Money(step.LastInterest)), step.NextOn.ToString("d MMM"))"><Icon Name="calendar" /></span>
                                                }
                                                else
                                                {
                                                    <span class="inst-flag" title="@string.Format(Loc["Its own schedule: the balance moves next on {0}, on its own. Nothing to log."], step.NextOn.ToString("d MMM"))"><Icon Name="calendar" /></span>
                                                }
                                            }
                                        }</span>
                                    <span class="cat-row-amt">
                                        @if (done) { <span class="good-text">@(isDebt ? Loc["Paid off"] : Loc["Goal reached"])</span> }
                                        else if (isDebt) { var _apr = State.SavingBucketDebtRate(bucketId); <text>@Fmt(debtOwed)<span class="cat-row-nb"> / @Fmt(debtOrig) @Loc["left"]@if (_apr > 0m) { <text> · @_apr.ToString("0.##")% APR</text> }</span></text> }
                                        else if (isInvestment) { <text>@Fmt(total)<span class="cat-row-nb"> · @Loc["invested"]</span></text> }
                                        else if (g is not null) { <text>@Fmt(total) / @Fmt(g.Goal!.Value)</text> }
                                        else { <text>@Fmt(total)<span class="cat-row-nb"> · @Loc["saved"]</span></text> }
                                    </span>
                                </span>
                                @* When a debt row is open, the payoff finish flag rides this same progress bar and slides
                                   left as the drawer's "extra /mo" slider goes up — the bucket bar doubles as the payoff
                                   timeline, so there's no second bar. *@
                                <span class="cbar-wrap @(open && showPayoff ? "cbar-wrap-flag" : "")">
                                    @if (open && showPayoff)
                                    {
                                        @* Near either end the centred date label would spill past the bar (over the row
                                           actions on the right). Anchor it inward at the extremes — the pin still marks the
                                           exact spot. *@
                                        var flagEdge = payFlagPct >= 85 ? " payoff-flag-end" : payFlagPct <= 15 ? " payoff-flag-start" : "";
                                        <span class="payoff-flag@(flagEdge)" style="left:@payFlagPct.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%">
                                            <span class="payoff-flag-lbl">@PayoffDate(payFastMonths)</span>
                                            <span class="payoff-flag-pin"><Icon Name="flag" /></span>
                                        </span>
                                    }
                                    <span class="cbar-track"><span class="cbar-grad @(hasBar ? "cbar-good" : "cbar-flat")" style="--pct:@barShown.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></span></span>
                                </span>
                            </span>
                        </button>
                        @* Actions on the right of the row. For an expenses fund the primary icon is "Add a cost" (a
                           sinking fund is its cost list); Add-to-savings drops into the ⋯. Everything else lives under
                           the ⋯, which tracks a per-bucket id so it opens for one row only. *@
                        <div class="cat-row-acts">
                            @if (isExpenses)
                            {
                                <button class="row-ico" title="@Loc["Add a cost"]" @onclick="() => OpenAddCost(bucketId)"><Icon Name="plus" /></button>
                            }
                            else if (State.IsPeriodOpen && !done)
                            {
                                <button class="row-ico" title="@Loc["Add to savings"]" @onclick="() => OpenAddSaving(bucketId)"><Icon Name="coins" /></button>
                            }
                            <button class="row-ico" title="@Loc["Edit"]" @onclick="() => OpenEditBucket(bucketId)"><Icon Name="pencil" /></button>
                            <span class="goal-more">
                                <button class="row-ico" title="@Loc["More actions"]" @onclick="() => _goalMoreId = _goalMoreId == bucketId ? Guid.Empty : bucketId"><Icon Name="dots" /></button>
                                @if (_goalMoreId == bucketId)
                                {
                                    <div class="row-menu-backdrop" @onclick="() => _goalMoreId = Guid.Empty"></div>
                                    <div class="row-menu goal-more-menu">
                                        @if (State.IsPeriodOpen && !done)
                                        {
                                            @if (isExpenses)
                                            {
                                                <button @onclick="() => GoalMore(() => OpenAddSaving(bucketId))"><Icon Name="coins" /> @Loc["Add to savings"]</button>
                                            }
                                            @if (isDebt)
                                            {
                                                @* Distinct from "Make a payment" (which deploys the set-aside bucket): this logs
                                                   the contractual installment you paid from income, split into its parts. *@
                                                <button @onclick="() => GoalMore(() => OpenLogInstallment(bucketId))"><Icon Name="note" /> @Loc["Log installment"]</button>
                                            }
                                            <button @onclick="() => GoalMore(() => OpenDisburseSaving(bucketId))"><Icon Name="target" /> @(isDebt ? Loc["Make a payment"] : isInvestment ? Loc["Withdraw"] : Loc["Apply to a goal"])</button>
                                            <button @onclick="() => GoalMore(() => OpenBudgetSaving(bucketId))"><Icon Name="arrow-right" /> @Loc["Budget savings"]</button>
                                            <button @onclick="() => GoalMore(() => OpenSpendSaving(bucketId))"><Icon Name="note" /> @Loc["Spend savings"]</button>
                                        }
                                        <button @onclick="() => GoalMore(() => { _ = ArchiveBucket(bucketId); })"><Icon Name="archive" /> @Loc["Archive"]</button>
                                        <button class="danger" @onclick="() => GoalMore(() => OpenDeleteBucket(bucketId))"><Icon Name="trash" /> @Loc["Remove"]</button>
                                    </div>
                                }
                            </span>
                            <button class="row-ico cat-chev-btn" @onclick="() => ToggleGoalRow(bucketId)"><Icon Name="chevron" Class="cat-chev" /></button>
                        </div>
                    </div>
                    @if (open)
                    {
                        <div class="cat-drawer goal-drawer">
                            @* --- Type-specific detail + inline projection (the projection modals moved in here) --- *@
                            @if (isDebt)
                            {
                                var _paidInt = State.SavingBucketDebtPaidInterest(bucketId);
                                var _remInt = State.SavingBucketDebtRemainingInterest(bucketId);
                                var _intEst = State.SavingBucketDebtPaidInterestEstimated(bucketId);
                                var _dueDay = State.SavingBucketDebtInstallmentDay(bucketId);
                                @* APR lives in the row header now; set-aside shows in the one-off header — so the facts
                                   here stay the non-duplicated detail: the installment (+due day) and the interest split. *@
                                <div class="goal-facts">
                                    <span><strong>@Fmt(State.SavingBucketDebtInstallment(bucketId))</strong>/@Loc["mo"]@if (_dueDay is { } _dd) { <span class="cat-row-nb"> · @string.Format(Loc["due on the {0}"], _dd)</span> }</span>
                                    <span title="@(_intEst ? Loc["Estimated from the loan’s terms — add its start date to base it on the real timeline."] : Loc["Reconstructed from the loan’s schedule since it started."])"><strong>@(_intEst ? "≈" : "")@Fmt(_paidInt)</strong> @Loc["interest paid"]</span>
                                    @if (_remInt > 0m)
                                    {
                                        <span title="@Loc["Interest still to pay if you keep to the installment."]"><strong>@Fmt(_remInt)</strong> @Loc["interest left"]</span>
                                    }
                                    @* ★ The banked "ahead" figure lives here now (O8), next to interest left, because
                                       it is a fact about THIS loan — and because Home's version summed interest
                                       across every debt and took the longest lead, so with two loans it told the
                                       reader a number belonging to neither. It carries the prepaid principal that
                                       earned it: without that, "3 months ahead" is a claim with nothing behind it. *@
                                    @if (State.SavingBucketDebtAhead(bucketId) is { } _bAhead)
                                    {
                                        <span class="goal-ahead" title="@Loc["Against this loan’s original schedule — money already paid ahead, not a projection."]">
                                            <Icon Name="trophy" /> <strong>@MonthsText(_bAhead.MonthsAhead)</strong> @Loc["ahead"]
                                            @if (_bAhead.InterestSaved > 0m)
                                            {
                                                <span class="cat-row-nb"> · @string.Format(Loc["{0} interest saved"], Fmt(State.Money(_bAhead.InterestSaved)))</span>
                                            }
                                            @if (State.SavingBucketDebtExtraRepaid(bucketId) is > 0m and var _bExtra)
                                            {
                                                <span class="cat-row-nb"> · @string.Format(Loc["{0} paid ahead"], Fmt(State.Money(_bExtra)))</span>
                                            }
                                        </span>
                                    }
                                </div>
                                @* "Paid off X of Y (Z%)" was dropped as the header's "remaining / initial" inverted,
                                   and the balance-over-time sparkline has now gone the same way (owner's call): the
                                   row head already carries a progress bar with the finish flag on it, so a second
                                   picture of the same descent was a chart competing with the control beside it. *@
                                if (!done && payInst > 0m)
                                {
                                    // Inline payoff projection. The "extra /mo" slider slides the 🏁 finish flag along the
                                    // bucket's own progress bar in the row head above; this drawer holds the control plus
                                    // the resulting debt-free date / how much sooner. (Sim values computed with the row.)
                                    var ci = System.Globalization.CultureInfo.InvariantCulture;
                                    @* Pro: the payoff planner. Header kept on Free so the capability is visible and
                                       honestly labelled; the slider and its projected date are what's withheld. *@
                                    <div class="payoff-sim">
                                        <div class="payoff-sim-head">
                                            <span><Icon Name="trending" /> @Loc["Pay extra on top"] <ProLock Feature="@PlanFeatures.Debt" /></span>
                                            @if (Gate.Allows(PlanFeatures.Debt))
                                            {
                                                <span class="payoff-extra-val">+@Fmt(new Money(_goalExtra, State.Currency))/@Loc["mo"]</span>
                                            }
                                        </div>
                                        @if (Gate.Allows(PlanFeatures.Debt))
                                        {
                                            <input class="payoff-slider" type="range" min="0" max="@paySliderMax.ToString(ci)" step="10" @bind="_goalExtra" @bind:event="oninput" />
                                            <div class="payoff-sim-foot">
                                                @if (payFast is null)
                                                {
                                                    <span class="warn-text">@Loc["At this installment it never clears — it doesn’t cover the interest."]</span>
                                                }
                                                else
                                                {
                                                    <span class="payoff-foot-date"><Icon Name="flag" /> @PayoffDate(payFastMonths)</span>
                                                    @if (payMonthsSaved > 0)
                                                    {
                                                        <span class="good-text">· @MonthsText(payMonthsSaved) @Loc["sooner"]</span>
                                                        @if (payBase is { } bp && payFast is { } fp && bp.TotalInterest > fp.TotalInterest) { <span class="good-text">· @Loc["save"] @Fmt(bp.TotalInterest - fp.TotalInterest)</span> }
                                                    }
                                                    else
                                                    {
                                                        <span class="hint">· @Loc["Drag to pay a little more each month and watch the finish move closer."]</span>
                                                    }
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <ProLock Feature="@PlanFeatures.Debt" Bar="true" Label="@Loc["See how paying more clears it sooner — with Pro"]" />
                                        }
                                    </div>
                                    // One-off: pay what's already set aside now — it lowers the balance, so the interest
                                    // you're charged each period drops. Show the two ways a bank typically applies it.
                                    // (Reuse the row-level payoff sim values rather than recomputing.)
                                    var inst = payInst;
                                    var rate = State.SavingBucketDebtRate(bucketId);
                                    var basePay = payBase;
                                    var baseMonths = payBaseMonths;
                                    var setAside = total.Amount;
                                    var payNow = Math.Min(setAside, debtOwed);
                                    var intNow = FinApp.Forecasting.LoanForecast.MonthlyInterest(debtOwed, rate);
                                    if (payNow > 0m && intNow > 0m)
                                    {
                                        var afterBal = debtOwed - payNow;
                                        var shorter = FinApp.Forecasting.LoanForecast.PayOff(afterBal, rate, inst);
                                        var lowerInst = baseMonths > 0 ? FinApp.Forecasting.LoanForecast.PaymentFor(afterBal, rate, baseMonths) : (decimal?)null;
                                        @* Pro: the one-off comparison. Header (and the tooltip explaining what a
                                           lump payment does) stays on Free — the modelling of the bank's two
                                           offers is the part that's withheld. *@
                                        <h4 class="detail-sub"><Icon Name="note" /> @string.Format(Loc["One-off — pay your {0} set aside now"], Fmt(payNow))
                                            @infoTip(("pp-partial", Loc["A payment lowers the balance right away, so the interest you're charged each period drops from then on. This is a single payment out of what you've already set aside — not a new monthly commitment."]))
                                            <ProLock Feature="@PlanFeatures.Debt" /></h4>
                                        if (!Gate.Allows(PlanFeatures.Debt))
                                        {
                                            <ProLock Feature="@PlanFeatures.Debt" Bar="true" Label="@Loc["Compare what your bank might offer — with Pro"]" />
                                        }
                                        else if (shorter is not null || lowerInst is not null)
                                        {
                                            <p class="hint pm-hint">@Loc["Your bank may offer a choice like:"]</p>
                                            <div class="payoff-opts-scroll">
                                                <table class="payoff-opts">
                                                    <thead>
                                                        <tr><th>@Loc["Their offer"]</th><th>@Loc["Per month"]</th><th>@Loc["Ends"]</th><th>@Loc["New interest"]</th><th>@Loc["Saved interest"]</th></tr>
                                                    </thead>
                                                    <tbody>
                                                        @if (shorter is { } sh)
                                                        {
                                                            var _shNew = decimal.Round(inst * sh.Months - afterBal, 2);
                                                            <tr>
                                                                <td>@Loc["Shorter term"]</td>
                                                                <td>@Fmt(inst)</td>
                                                                <td>@PayoffDate(sh.Months)@if (basePay is { } bl && bl.Months > sh.Months) { <span class="good-text">@string.Format(Loc[" ({0} sooner)"], MonthsText(bl.Months - sh.Months))</span> }</td>
                                                                <td>@Fmt(_shNew)</td>
                                                                <td>@if (basePay is { } _sb && _sb.TotalInterest > _shNew) { <span class="good-text">@Fmt(_sb.TotalInterest - _shNew)</span> } else { <text>—</text> }</td>
                                                            </tr>
                                                        }
                                                        @if (lowerInst is { } lw && baseMonths > 0)
                                                        {
                                                            var _lwNew = decimal.Round(lw * baseMonths - afterBal, 2);
                                                            <tr>
                                                                <td>@Loc["Lower installment"]</td>
                                                                <td>@Fmt(lw) <span class="good-text">(−@Fmt(Math.Max(0m, inst - lw)))</span></td>
                                                                <td>@PayoffDate(baseMonths) <span class="ring-muted">@Loc["(unchanged)"]</span></td>
                                                                <td>@Fmt(_lwNew)</td>
                                                                <td>@if (basePay is { } _lb && _lb.TotalInterest > _lwNew) { <span class="good-text">@Fmt(_lb.TotalInterest - _lwNew)</span> } else { <text>—</text> }</td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        }
                                    }
                                }
                            }
                            else if (isInvestment)
                            {
                                var invBase = State.ProjectInvestment(bucketId, 0m);
                                <div class="goal-facts">
                                    <span><strong>@Fmt(total)</strong> @Loc["invested"]</span>
                                    <span><strong>@State.SavingBucketInvestmentRate(bucketId)%</strong> @Loc["return"]</span>
                                    <span><strong>@State.SavingBucketInvestmentTermYears(bucketId).ToString("0.#")@Loc["y"]</strong> @Loc["term"]</span>
                                </div>
                                if (invBase is { Months: > 0 } b0)
                                {
                                    <p class="goal-proj"><Icon Name="flag" /> @string.Format(Loc["~{0} in {1} ({2} growth)"], Fmt(b0.FutureValue), MonthsText(b0.Months), Fmt(b0.Growth))</p>
                                }
                                else
                                {
                                    <p class="goal-proj-hint">@Loc["Set a horizon (Edit) to project this investment's growth."]</p>
                                }
                            }
                            else
                            {
                                // The saved/goal figure already leads the row headline ("€X · saved") + progress bar, so the
                                // drawer never repeats it — it shows only what the row doesn't: the monthly set-aside and any
                                // shortfall. Rendered only when there's something to say, so a plain no-goal fund shows no
                                // empty strip.
                                var gMonthly = State.BucketMonthlySetAside(bucketId);
                                var gShort = isExpenses ? State.BucketTargetShortfall(bucketId) : null;
                                if ((gMonthly is > 0m) || (gShort is not null))
                                {
                                    <div class="goal-facts">
                                        @if (gMonthly is { } setAside and > 0m) { <span>🗓️ <strong>@Fmt(setAside)</strong>/@Loc["mo"] @Loc["to stay covered"]</span> }
                                        @if (gShort is { } sf) { <span class="cost-short">@string.Format(Loc["{0} still to find"], Fmt(new Money(sf, State.Currency)))</span> }
                                    </div>
                                }
                                if (isExpenses)
                                {
                                    var costs = State.SavingBucketCosts(bucketId);
                                    <div class="goal-costs">
                                        <div class="goal-costs-label">@Loc["Costs to cover"]</div>
                                        @for (var i = 0; i < costs.Count; i++)
                                        {
                                            var idx = i;
                                            var cost = costs[idx];
                                            <div class="goal-cost-row">
                                                <button type="button" class="goal-cost-edit" @onclick="() => OpenEditCost(bucketId, idx)">
                                                    <span class="goal-cost-name">@cost.Label</span>
                                                    <span class="goal-cost-amt">@Fmt(new Money(cost.Amount, State.Currency))<span class="goal-cost-cad"> · @CadenceLabel(cost.Cadence)</span></span>
                                                </button>
                                                <button type="button" class="goal-cost-del" title="@Loc["Remove"]" @onclick="() => ConfirmDeleteCost(bucketId, idx)"><Icon Name="trash" /></button>
                                            </div>
                                        }
                                    </div>
                                }
                                else if (g is not null && !done)
                                {
                                    var gGoalAmt = State.FindSavingBucket(bucketId)?.GoalAmount;
                                    var gPace = State.EffectiveSavingPace(bucketId);
                                    int? gPeriods = gPace is { } gpp && gpp.Amount > 0m && gGoalAmt is { } gga && gga > total.Amount
                                        ? (int)Math.Ceiling((double)((gga - total.Amount) / gpp.Amount)) : null;
                                    if (gPeriods is { } gper)
                                    {
                                        <p class="goal-proj"><Icon Name="flag" /> @string.Format(Loc["Reach your goal in {0} (~{1})"], MonthsText(gper), PayoffDate(gper))</p>
                                    }
                                    else if (gPace is null || gPace.Value.Amount <= 0m)
                                    {
                                        <p class="goal-proj-hint">@Loc["Not enough history yet — set money aside a few times and we’ll project a date."]</p>
                                    }
                                }
                            }
                            @if (State.SavingBucketFundId(bucketId) is { } heldFund)
                            {
                                <div class="goal-held"><Icon Name="bank" /> @Loc["in"] @State.FundName(heldFund)</div>
                            }
                        </div>
                    }
                </div>;
            }
            @{
                // One grid for every goal, filtered by kind — rather than a section per SavingKind, which is the axis
                // that made this tab a wall of near-identical blocks (the same bucketCard rendered three times). Kind
                // stays readable without the split: the ring colour and each card's sub-line already say which it is.
                // A chip is only offered for a kind that has buckets — an "Investments 0" chip filters to a page that
                // says "nothing here yet", which is a control whose only outcome is an empty room. Discovery doesn't
                // suffer: the Add-goal modal's own four-way kind picker is how every kind is reached anyway.
                // Read through goalFilter, not _goalFilter, so removing the last debt while filtered to Debts falls
                // back to All rather than stranding the user on a filter whose chip has just gone. Deriving it here
                // (rather than resetting the field) keeps render free of state changes.
                var goalFilter = _goalFilter switch
                {
                    GoalFilter.Debts when debtBuckets.Count == 0 => GoalFilter.All,
                    GoalFilter.Savings when plainBuckets.Count == 0 => GoalFilter.All,
                    GoalFilter.Investments when investmentBuckets.Count == 0 => GoalFilter.All,
                    GoalFilter.Expenses when expenseBuckets.Count == 0 => GoalFilter.All,
                    var f => f,
                };
                var goalBuckets = goalFilter switch
                {
                    GoalFilter.Debts => debtBuckets,
                    GoalFilter.Savings => plainBuckets,
                    GoalFilter.Investments => investmentBuckets,
                    GoalFilter.Expenses => expenseBuckets,
                    _ => debtBuckets.Concat(plainBuckets).Concat(investmentBuckets).Concat(expenseBuckets).ToList(),
                };
                var goalTotal = debtBuckets.Count + plainBuckets.Count + investmentBuckets.Count + expenseBuckets.Count;
                // With one kind in play, "All" and that kind's chip select the identical list — a filter row that
                // cannot filter. Hide the whole row until there is a second kind to switch between.
                var goalKindsPresent = (debtBuckets.Count > 0 ? 1 : 0) + (plainBuckets.Count > 0 ? 1 : 0)
                                     + (investmentBuckets.Count > 0 ? 1 : 0) + (expenseBuckets.Count > 0 ? 1 : 0);
            }
            <section class="panel">
                @* Saved-summary header: the running TOTAL set aside across all buckets (this figure used to live in the
                   header hero, which now shows only this period's contribution + rate). The "+X this period" tag keeps
                   the period contribution visible here too. *@
                @{
                    var _savedTotal = State.DisplayClosingBalance(_bankStatus?.Balance, _bankStatus?.BalanceCurrency)
                                    - State.DisplayFreeToAllocate(_bankStatus?.Balance, _bankStatus?.BalanceCurrency);
                }
                @* ★ O12: the figure leads, and the two facts about it stop sharing one parenthesis. It read
                   "TOTAL SAVED €1,240.00 (+€120.00 this period · 18% of money in)" on a single baseline — a number
                   the reader wants and two qualifiers of different kinds crammed after it in brackets. The total is
                   a hero now, with a quiet sub-line under it: what went in this period, and the rate as a
                   `.settle-tag` pill (the app's existing "quiet green statement" vocabulary, already themed).
                   ⚠️ `.goal-summary` and `.goal-stat` are SHARED with the Spending tab's view switcher
                   (`.goal-summary.spend-summary`), so this is a modifier on the Goals instance — restyling the base
                   rules would silently redraw a second screen. *@
                <div class="goal-summary goal-summary-hero">
                    <div class="goal-stat goal-stat-hero">
                        <span class="goal-stat-k">@Loc["Total saved"]</span>
                        <span class="goal-stat-v">@Fmt(_savedTotal)</span>
                        @if (State.SavingsThisPeriod.Amount > 0m)
                        {
                            <span class="goal-stat-sub goal-stat-sub-end">
                                <span class="goal-stat-add">+@Fmt(State.SavingsThisPeriod) @Loc["this period"]</span>
                                @if (State.PeriodMoneyInRate is { } prate && prate > 0m)
                                {
                                    <span class="settle-tag" title="@string.Format(Loc["Money in this period: {0} came in, plus {1} carried over from before."], Fmt(State.FreshInThisPeriod), Fmt(State.CarriedInThisPeriod))">@(Math.Round(prate * 100m).ToString("0", System.Globalization.CultureInfo.InvariantCulture))% @Loc["of money in"]</span>
                                }
                            </span>
                        }
                    </div>
                </div>
                @* F4 round-ups live with savings — this is where the mind is on setting money aside, not the spending
                   Breakdown. Only the cumulative painless total, and only once there IS one: it's a reward for using
                   round-ups. The "would have set aside X at step 1 or 5" what-if that used to sit here was retired —
                   two hypothetical figures for a feature the reader hasn't switched on is a projection they didn't
                   ask for, and it landed on the page that is already the densest in the app. *@
                @if (State.RoundUpsOn && State.RoundUpsSweptTotal.Amount > 0m)
                {
                    <div class="brk-roundup"><Icon Name="coins" /> @string.Format(Loc["{0} saved this way so far."], Fmt(State.RoundUpsSweptTotal))</div>
                }
                @* The row is unconditional now because "Add goal" lives in it: the chips still need two kinds to be
                   worth showing, but the action must not disappear on an account that has only one. *@
                <div class="goal-filters">
                    @if (goalKindsPresent > 1)
                    {
                        <span class="goal-filter-chips" role="group">
                        <button type="button" class="chip @(goalFilter == GoalFilter.All ? "on" : "")" @onclick="() => _goalFilter = GoalFilter.All">@Loc["All"] <span class="chip-n">@goalTotal</span></button>
                        @if (debtBuckets.Count > 0)
                        {
                            <button type="button" class="chip @(goalFilter == GoalFilter.Debts ? "on" : "")" @onclick="() => _goalFilter = GoalFilter.Debts"><Icon Name="card" /> @Loc["Debts"] <span class="chip-n">@debtBuckets.Count</span></button>
                        }
                        @if (plainBuckets.Count > 0)
                        {
                            <button type="button" class="chip @(goalFilter == GoalFilter.Savings ? "on" : "")" @onclick="() => _goalFilter = GoalFilter.Savings"><Icon Name="coins" /> @Loc["Savings"] <span class="chip-n">@plainBuckets.Count</span></button>
                        }
                        @if (investmentBuckets.Count > 0)
                        {
                            <button type="button" class="chip @(goalFilter == GoalFilter.Investments ? "on" : "")" @onclick="() => _goalFilter = GoalFilter.Investments"><Icon Name="trending" /> @Loc["Investments"] <span class="chip-n">@investmentBuckets.Count</span></button>
                        }
                        @if (expenseBuckets.Count > 0)
                        {
                            <button type="button" class="chip @(goalFilter == GoalFilter.Expenses ? "on" : "")" @onclick="() => _goalFilter = GoalFilter.Expenses"><Icon Name="calendar" /> @Loc["Expenses"] <span class="chip-n">@expenseBuckets.Count</span></button>
                        }
                        </span>
                    }
                    <button class="fund-add" @onclick="AddGoalForFilter"><Icon Name="plus" /> @Loc["Add goal"]</button>
                </div>
                @if (goalBuckets.Count == 0)
                {
                    <p class="hint">
                        @(goalFilter switch
                        {
                            GoalFilter.Debts => Loc["Track a loan or debt: set money aside toward it, then pay the bank. Figures here are projections — they don't move real money."],
                            GoalFilter.Investments => Loc["Track an investment: fund it with 💰, set an expected return, and project its growth. Figures here are projections — they don't move real money."],
                            GoalFilter.Expenses => Loc["Nothing here yet — add a fund for the costs you know are coming."],
                            _ => Loc["Nothing here yet — add a goal to start putting money aside."],
                        })
                    </p>
                }
                <div class="cat-list goal-list">
                    @foreach (var b in goalBuckets) { @goalRow(b) }
                </div>
            </section>
            @if (debtBuckets.Count >= 2)
            {
                <section class="panel">
                    <div class="panel-head"><h2><Icon Name="target" /> @Loc["Payoff plan"] @infoTip(("plan-how", Loc["One spare amount is thrown at your debts each month on top of every installment. As each debt clears, its installment rolls onto the next one."]))</h2></div>
                    <div class="plan-controls">
                        <label>@Loc["Extra /mo across all debts"] <input type="number" step="10" min="0" @bind="_planExtra" @bind:event="oninput" /></label>
                        <div class="plan-toggle" role="group">
                            <button type="button" class="chip @(_planStrategy == FinApp.Forecasting.LoanForecast.Strategy.Avalanche ? "on" : "")" @onclick="() => _planStrategy = FinApp.Forecasting.LoanForecast.Strategy.Avalanche" title="@Loc["Highest interest rate first — cheapest overall."]">@Loc["Avalanche"]</button>
                            <button type="button" class="chip @(_planStrategy == FinApp.Forecasting.LoanForecast.Strategy.Snowball ? "on" : "")" @onclick="() => _planStrategy = FinApp.Forecasting.LoanForecast.Strategy.Snowball" title="@Loc["Smallest balance first — quickest wins."]">@Loc["Snowball"]</button>
                            @infoTip(("plan-strat", Loc["Avalanche pays the highest-rate debt first (least interest overall). Snowball pays the smallest balance first (a quicker first win)."]))
                        </div>
                    </div>
                    <p class="hint plan-strat-note">@(_planStrategy == FinApp.Forecasting.LoanForecast.Strategy.Avalanche ? Loc["Attacking the highest-rate debt first — least interest overall."] : Loc["Attacking the smallest balance first — a quicker first win."])</p>
                    @if (DebtPlan is { } plan)
                    {
                        <div class="plan-summary">
                            <span class="plan-big"><Icon Name="flag" /> @Loc["Debt-free"] @PayoffDate(plan.Months)</span>
                            <span class="spending-sub">@string.Format(Loc["{0} · total interest {1}"], MonthsText(plan.Months), Fmt(plan.TotalInterest))</span>
                        </div>
                        @if (_planExtra > 0 && DebtBaseline is { } baseNoExtra && (baseNoExtra.Months > plan.Months || baseNoExtra.TotalInterest > plan.TotalInterest))
                        {
                            <p class="hint good-text"><Icon Name="check" /> @string.Format(Loc["That extra clears you {0} sooner and saves {1} in interest."], MonthsText(baseNoExtra.Months - plan.Months), Fmt(Math.Max(0m, baseNoExtra.TotalInterest - plan.TotalInterest)))</p>
                        }
                        <ol class="plan-order">
                            @for (var oi = 0; oi < plan.Order.Count; oi++)
                            {
                                var step = plan.Order[oi];
                                <li class="@(oi == 0 ? "first" : "")"><span class="plan-order-name">@step.Name</span> <span class="pm-hint">@Loc["clear"] @PayoffDate(step.ClearedInMonth) · @MonthsText(step.ClearedInMonth)</span></li>
                            }
                        </ol>
                    }
                    else
                    {
                        <p class="hint warn-text">@Loc["At these installments the stack never clears — the minimums don't cover the interest. Add an extra amount."]</p>
                    }
                </section>
            }
            @if (State.SavingDepositsThisPeriod.Any() || State.SavingMovementsThisPeriod.Any())
            {
                <section class="panel">
                    <h2>@Loc["Goals activity"]</h2>
                    <ul class="list list-even">
                        @foreach (var d in State.SavingDepositsThisPeriod)
                        {
                            <li>
                                <span class="row-main row-stack">
                                    <span class="row-title"><Icon Name="coins" /> <span class="row-title-txt">@State.SavingBucketName(d.SavingCategoryId)</span></span>
                                    <span class="row-sub"><span>@d.Date.ToString("dd MMM")</span></span>
                                </span>
                                <span class="amt credit">@Fmt(d.Amount)</span>
                                <span class="row-actions">
                                    @if (State.IsPeriodOpen)
                                    {
                                        <button class="exp-edit" title="@Loc["Edit"]" @onclick="() => OpenEditSavingDeposit(d.Id)"><Icon Name="pencil" /></button>
                                        <button class="exp-edit" title="@Loc["Remove"]" @onclick="() => OpenDeleteSavingDeposit(d.Id)"><Icon Name="trash" /></button>
                                    }
                                </span>
                            </li>
                        }
                        @foreach (var m in State.SavingMovementsThisPeriod)
                        {
                            <li>
                                <span class="row-main row-stack">
                                    <span class="row-title">@MovementIcon(m) <span class="row-title-txt">@State.SavingMovementTarget(m)</span></span>
                                    <span class="row-sub"><span>@m.Date.ToString("dd MMM")</span></span>
                                </span>
                                @* A disbursement is the saving doing its job — the loan prepaid, the bill the fund
                                   was filling up for. It leaves the account like spending, but red is the one
                                   colour here that means "this hurt you", so it goes amber instead. *@
                                <span class="amt @(m.IsDisbursement ? "deploy" : "debit")">@Fmt(-m.Amount.Amount)</span>
                                <span class="row-actions">
                                    @if (State.IsPeriodOpen)
                                    {
                                        @if (!m.IsDisbursement)
                                        {
                                            <button class="exp-edit" title="@Loc["Edit"]" @onclick="() => OpenEditSavingMovement(m.Id)"><Icon Name="pencil" /></button>
                                        }
                                        <button class="exp-edit" title="@Loc["Remove"]" @onclick="() => OpenDeleteSavingMovement(m.Id)"><Icon Name="trash" /></button>
                                    }
                                </span>
                            </li>
                        }
                    </ul>
                </section>
            }
        </div>
    </div>
</div>

@* Floating quick-add — mobile web only (CSS hides it on desktop, where the inline Home buttons stay). One ＋ that
   expands to Add expense / Add income from any tab, mirroring the native app's FAB. Hidden while a modal is open. *@
@if (_modal == Modal.None && State.IsPeriodOpen)
{
    <div class="qfab @(_fabOpen ? "open" : "")">
        @if (_fabOpen)
        {
            <div class="qfab-backdrop" @onclick="() => _fabOpen = false"></div>
            @* Order is bottom-up from the ＋: the most-used action sits nearest the thumb.
               No "Edit last" here. Each modal already carries its own — Add expense, Add income and now Transfer —
               where it can name what it would edit. A single FAB entry had to guess between the three, and a
               destructive-ish action that picks its own target is the wrong thing to put under a ＋. *@
            <div class="qfab-menu">
                @if (CanTransfer)
                {
                    <button class="qfab-item" @onclick="FabTransfer"><Icon Name="swap" /> @Loc["Transfer"]</button>
                }
                <button class="qfab-item" @onclick="FabAddIncome"><Icon Name="note" /> @Loc["Add income"]</button>
                <button class="qfab-item" @onclick="FabAddExpense"><Icon Name="receipt" /> @Loc["Add expense"]</button>
            </div>
        }
        <button class="qfab-main" title="@Loc["Add"]" @onclick="() => _fabOpen = !_fabOpen"><Icon Name="plus" /></button>
    </div>
}

@* F6: the goal-milestone moment. Sits above the FAB and below the modal layer — it should never cover a form the
   user is mid-way through, and CheckCelebrationsAsync only fires from the render loop, not from a save handler. *@
<GoalCelebration Item="_celebrating"
                 Together="@(State.IsReady && State.HasAccounts && State.RealUsers.Count > 1)"
                 Others="@(State.IsReady && State.HasAccounts ? OtherMemberNames() : null)"
                 OnDismiss="DismissCelebration" />

@* What the payment just bought. Deliberately AFTER the fact and dismissible, not a modal: the decision is already
   made, so this is a receipt, not a question. It states interest saved and the new finish date — the two things a
   lump sum actually changes, and the two a bank statement will never tell you. *@
@if (_paydownResult is { } pr)
{
    <div class="paydown-toast" role="status" @onclick="() => _paydownResult = null">
        <button type="button" class="paydown-toast-x" aria-label="@Loc["Dismiss"]" @onclick="() => _paydownResult = null"><Icon Name="x" /></button>
        @if (pr.Outcome.ClearsTheLoan)
        {
            <div class="paydown-toast-hero"><Icon Name="trophy" />@string.Format(Loc["{0} is paid off."], pr.Name)</div>
            <div class="paydown-toast-sub">@string.Format(Loc["You've just avoided {0} of interest."], Fmt(State.Money(pr.Outcome.InterestSaved)))</div>
        }
        else
        {
            <div class="paydown-toast-hero"><Icon Name="trophy" />@string.Format(Loc["You've just saved {0} in interest."], Fmt(State.Money(pr.Outcome.InterestSaved)))</div>
            <div class="paydown-toast-sub">
                @string.Format(Loc["{0} now finishes {1}"], pr.Name, PayoffDate(pr.Outcome.AfterKeepingInstallment.Months))@if (pr.Outcome.MonthsSaved > 0) { <text> — @MonthsText(pr.Outcome.MonthsSaved) @Loc["sooner than before"]</text> }.
            </div>
        }
    </div>
}

@if (_modal != Modal.None)
{
    <div class="modal-backdrop">
        @* Review modals hold rows of data rather than a column of fields, so they get the wider box.
           A trip picked on the expense form puts the whole modal into trip mode — the same blue the app bar and the
           Home hero wear while you're away, so the form you log into looks like the trip it logs against. *@
        <div class="modal @(_modal is Modal.BankReview or Modal.Import ? "modal-wide" : "") @((_modal is Modal.AddExpense or Modal.EditExpense or Modal.BankConfirm) && _expTripId != Guid.Empty ? "modal-trip" : "")">
            @if (_modalError is not null)
            {
                <div class="modal-error">@_modalError</div>
            }
            @{
                // Shared tag selector for the add/edit-expense modals: single-select chips for existing tags (one tag
                // per expense — picking another replaces it, tapping the selected one clears it) + an inline "new tag"
                // input that creates and selects. Selection lives in _fTagId; the save handlers pass it to Add/EditExpense.
                // On a trip the chips become the trip labels (Stay / Travel / Food & drink / Tickets & tours…) and
                // the everyday ones step aside. That swap is what makes the trip cost split work at all: tagging is
                // normally extra work ON TOP of categorising, so it doesn't happen — but a trip label is bound to a
                // category, so here one tap does both, and the recap gets its axis for free.
                // Off a trip the trip labels are hidden, because "Tickets & tours" is noise at the supermarket.
                var onTrip = _expTripId != Guid.Empty && State.TripTags.Count > 0;
                var pickTags = onTrip ? State.TripTags : State.EverydayTags;
                // ★ Whatever is selected is always in the row, even when it belongs to the other axis. The two lists
                // are disjoint by design, so without this a tag picked before the trip was chosen — or an everyday
                // tag reached by typing its name into the "new tag" box — stays attached to the expense while its
                // chip is nowhere on screen: the form would be lying about what it is about to save.
                if (_fTagId is { } selTag && pickTags.All(t => t.Id != selTag) && State.FindTag(selTag) is { } selEntity)
                    pickTags = pickTags.Append(selEntity).ToList();
                @* Amount and Fund are fragments so the expense form can render them in EITHER order: money-first on
                   a trip (amount → fund → label), and the original order off one. Each renders exactly once. *@
                RenderFragment amountField =
                @<text>
                    @* F1: DecimalInput raises the phone's decimal keypad AND accepts the "," that keypad offers — a
                       type="number" field rejects it outright, which is why decimals couldn't be typed on mobile.
                       @ref so the cursor can land here when the category was already chosen (see OpenAddExpense). *@
                    @* ★ The Amount label follows the FUND, not the trip. Paying by card means paying from the bank
                       fund, which holds account-currency money, so it says "Amount" and nothing converts — the
                       statement already did. Paying from a foreign-cash wallet says "Amount in GBP". *@
                    <label>@(FormForeignFund is { } cur ? string.Format(Loc["Amount in {0}"], cur.Currency) : Loc["Amount"]) <DecimalInput @ref="_amountInput" @bind-Value="_amount" /></label>
                    @if (_amount < 0)
                    {
                        <small class="hint warn-text">@Loc["Amount can't be negative — enter what you spent."]</small>
                    }
                    @* What will actually be stored. Shown rather than silently applied: the rate is the user's own
                       fixed guess, so the honest thing is to put the converted figure in front of them before it
                       becomes a ledger entry. *@
                    @if (_amount > 0 && FormForeignFund is { } fxFund)
                    {
                        <small class="hint trip-fx"><Icon Name="swap" /> @string.Format(Loc["logs as {0} — {1}'s rate"], Fmt(State.Money(ExpenseAmountToLog(_amount))), fxFund.Name)</small>
                    }
                    @* Time cost, live as you type (the amount binds on oninput). This is the moment it earns its
                       place — a price is easiest to reconsider before it's logged, not in a recap afterwards.
                       Time cost is read off the CONVERTED figure — hours of work against £20 would be nonsense. *@
                    @if (_amount > 0 && State.TimeCostLabel(ExpenseAmountToLog(_amount)) is { } timeCost)
                    {
                        <small class="hint time-cost"><Icon Name="clock" /> @string.Format(Loc["≈ {0} of work"], timeCost)</small>
                    }
                    @* Recent amounts for this category as tappable hints. Never pre-filled — the amount is the one
                       field that really changes each time, so a wrong default here writes a wrong ledger entry.
                       Suppressed while converting: these are past amounts in the ACCOUNT currency, and tapping one
                       into a field being read as pounds would log a number nobody meant. *@
                    @{
                        var amtHints = FormForeignFund is not null
                            ? Array.Empty<decimal>() : (IReadOnlyList<decimal>)State.RecentAmountsForCategory(_categoryId);
                    }
                    @if (amtHints.Count > 0 && _expenseDrafts.Count == 0)
                    {
                        <div class="qp-row amt-hints">
                            @foreach (var h in amtHints)
                            {
                                var hint = h;
                                <button type="button" class="tag-chip amt-hint @(_amount == hint ? "tag-chip-on" : "")" @onclick="() => UseAmountHint(hint)">@Fmt(hint)</button>
                            }
                        </div>
                    }
                </text>;

                RenderFragment fundField =
                @<text>
                    <div class="modal-field"><span class="lbl-row">@Loc["Fund"] <button type="button" class="lbl-add" title="@Loc["New fund"]" @onclick="ExpenseAddFund">+</button></span>
                        @* Funds are few, so the whole list is chips — no dropdown. Selected one highlighted; 🏦 = synced. *@
                        <div class="qp-row">
                            @foreach (var f in State.ExpensableFunds)
                            {
                                var qpFund = f.Id;
                                <button type="button" class="tag-chip @(_fundId == qpFund ? "tag-chip-on" : "")" @onclick="() => _fundId = qpFund"><CatIcon Name="@State.FundIcon(qpFund)" /> @f.Name@(f.IsSynced ? " 🏦" : "")@if (State.ForeignFund(qpFund) is { } ffx) { <span class="fund-chip-ccy">@ffx.Currency</span> }</button>
                            }
                        </div>
                    </div>
                    @if (State.FundIsSynced(_fundId))
                    {
                        <small class="hint"><Icon Name="bank" /> @Loc["This is a bank-synced fund — logging here records the expense without changing the synced balance (the bank stays the source). If the same charge later imports, you can dismiss the duplicate."]</small>
                    }
                </text>;

                RenderFragment tagPicker =
                @<div class="modal-field">
                    <span class="lbl-row">@(onTrip ? Loc["What kind of spend?"] : Loc["Tag (optional)"])</span>
                    @if (pickTags.Count > 0)
                    {
                        <div class="tag-pick">
                            @foreach (var t in pickTags)
                            {
                                var tid = t.Id;
                                var on = _fTagId == tid;
                                <button type="button" class="tag-chip @(on ? "tag-chip-on" : "")" @onclick="() => ToggleTagSel(tid)">
                                    @TagMark(t.Icon)@t.Name
                                </button>
                            }
                        </div>
                    }
                    @* ★ The "new tag" box is behind the ＋ now. Creating a tag is the rare case — the chips above
                       cover almost every entry — and an always-open text field read as something that wanted
                       filling in, on a form whose whole job this round was to stop asking. The ＋ keeps it one tap
                       away and the row collapses back once the tag is made. *@
                    @if (_tagNewOpen)
                    {
                        <div class="tag-new-row">
                            <input type="text" class="tag-new-in" placeholder="@Loc["New tag…"]" maxlength="30" @bind="_newTagName" @bind:event="oninput" @onkeydown="TagNewKey" />
                            <button type="button" class="lbl-add" title="@Loc["Add tag"]" disabled="@string.IsNullOrWhiteSpace(_newTagName)" @onclick="AddTagFromModal">+</button>
                        </div>
                    }
                    else
                    {
                        <button type="button" class="link tag-new-open" @onclick="() => _tagNewOpen = true"><Icon Name="plus" /> @Loc["New tag"]</button>
                    }
                    @* F2: say it out loud when a tag moved the category — the category chips above do update, but a
                       silent change to where money is filed is exactly the kind of "helpful" nobody asked for. *@
                    @if (_tagFiledTo is { } filed)
                    {
                        <small class="hint tag-filed"><Icon Name="check" /> @string.Format(Loc["Filed under {0} — change it above if that's not right."], State.CategoryName(filed))</small>
                    }
                </div>;
            }
            @switch (_modal)
            {
                case Modal.BankReview:
                    var reviewDebits = BankDebits();
                    var reviewCredits = BankCredits();
                    <h3><Icon Name="bank" /> @Loc["Review bank transactions"]</h3>
                    <p class="hint">@string.Format(Loc["{0} imported from {1} need a quick review."], reviewDebits.Count + reviewCredits.Count, _bankStatus?.InstitutionName ?? Loc["your bank"])</p>
                    @if (reviewDebits.Count > 0)
                    {
                        <h4 class="detail-sub">@Loc["Expenses"] <span class="pm-hint">· @reviewDebits.Count</span></h4>
                        <ul class="list bank-tx-list">@foreach (var t in reviewDebits) { @BankTxRow(t) }</ul>
                    }
                    @if (reviewCredits.Count > 0)
                    {
                        <h4 class="detail-sub">@Loc["Money in"] <span class="pm-hint">· @reviewCredits.Count</span></h4>
                        <ul class="list bank-tx-list">@foreach (var t in reviewCredits) { @BankTxRow(t) }</ul>
                    }
                    @if (reviewDebits.Count == 0 && reviewCredits.Count == 0)
                    {
                        <p class="hint">@Loc["All caught up — nothing left to review."]</p>
                    }
                    @* Every refusal raised while reviewing used to be set and never rendered — `_bankError` was only
                       drawn by the External-accounts modal. "Pick where this money came from first." and "Pick
                       something to map to first." have both been invisible here, so the button simply did nothing
                       and the user had no way to learn why. *@
                    @if (_bankError is not null)
                    {
                        <div class="alert warn-bg"><span>@_bankError</span><button class="alert-x" title="@Loc["Dismiss"]" aria-label="@Loc["Dismiss"]" @onclick="() => _bankError = null"><span aria-hidden="true">×</span></button></div>
                    }
                    <div class="modal-actions">
                        <button class="ghost" @onclick="DismissBankReview">@Loc["Close"]</button>
                    </div>
                    break;

                @* ★ Confirming an imported transaction is a full entry form now, not a category dropdown on a list row.
                   The row could set exactly one thing — the category — so a card charge picked up during a trip could
                   not be attached to that trip, could not be labelled, and could not teach the app anything about the
                   merchant without a separate ＋ tap. Everything the manual add-expense form asks, this asks, in the
                   same order, with the bank's own facts (merchant, amount, date, time) stated rather than requested. *@
                case Modal.BankConfirm:
                    @if (_bcTx is { } bc)
                    {
                        <h3 class="modal-h-trip">
                            <span><Icon Name="bank" /> @Loc["Add this expense"]</span>
                            @if (State.FindTrip(_expTripId) is { } bcHdrTrip)
                            {
                                @TripModeTag(bcHdrTrip)
                            }
                        </h3>
                        @* The bank's facts, stated. None of them is a question: the merchant, what left the account,
                           and when. The time shows only when the bank actually reported one. *@
                        <div class="bank-confirm-head">
                            <span class="vendor-badge" style="background:@VendorColor(bc.Description)">@VendorInitial(bc.Description)</span>
                            <span class="bank-confirm-desc">@bc.Description</span>
                            <span class="amt">−@Fmt(new Money(Math.Abs(bc.Amount), State.Currency))</span>
                        </div>
                        <p class="hint bank-confirm-when">
                            <Icon Name="calendar" /> @bc.Date.ToString("ddd, dd MMM")@if (bc.Time is { } bcTime) { <text> · @bcTime.ToString("HH:mm")</text> }
                            @if (bc.Date != ClampToPeriod(bc.Date))
                            {
                                <text> — @string.Format(Loc["filed on {0}, the nearest day in this period"], ClampToPeriod(bc.Date).ToString("dd MMM"))</text>
                            }
                        </p>
                        @* The trip leads, exactly as it does on the manual form and for the same reason: a trip that
                           files into one category settles the category below, and it swaps the labels. Defaulted from
                           the TRANSACTION's date, not today — you review the statement after you are home. *@
                        @if (EditTripOptions.Count > 0)
                        {
                            <div class="modal-field trip-pick-field">
                                <span class="lbl-row">@Loc["Part of a trip"]</span>
                                <div class="qp-row">
                                    <button type="button" class="tag-chip @(_expTripId == Guid.Empty ? "tag-chip-on" : "")" @onclick="() => OnExpenseTripPicked(Guid.Empty)">@Loc["Not a trip"]</button>
                                    @foreach (var t in EditTripOptions)
                                    {
                                        var bcTrip = t;
                                        <button type="button" class="tag-chip @(_expTripId == bcTrip.Id ? "tag-chip-on" : "")" @onclick="() => OnExpenseTripPicked(bcTrip.Id)">
                                            @TripMark(bcTrip.Icon)@bcTrip.Name
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                        <div class="modal-field"><span class="lbl-row">@Loc["Category"]</span>
                            <CategoryPicker @bind-Value="_categoryId" Options="State.CategoryOptions" />
                        </div>
                        @tagPicker
                        <label>@Loc["Note (optional)"] <input type="text" @bind="_note" /></label>
                        @* The auto-file rule, in the form itself rather than behind a pin on a list row. Turning it on
                           reveals which words are matched, because "remember this" and "remember it by WHICH words"
                           are one decision — a rule keyed on the whole description matches one transaction for ever. *@
                        @if (MappedLabel(bc.Description) is { } bcMapped)
                        {
                            <div class="modal-field bank-rule-known">
                                <small class="hint"><Icon Name="pin" /> @string.Format(Loc["Auto-files to {0} from now on."], bcMapped)</small>
                                @* Without this line the screen contradicts itself: it says "auto-files to Groceries"
                                   while the category above reads *Rome* because the trip settled it. Nothing on this
                                   branch writes a rule, so the rule really is untouched — say so rather than leaving
                                   the reader to work out which of the two statements is about this row. *@
                                @if (_expTripId != Guid.Empty)
                                {
                                    <small class="hint">@string.Format(Loc["This one is going to {0} instead. The rule isn't changed."], State.TripName(_expTripId))</small>
                                }
                                <button type="button" class="link" @onclick="() => ConfirmForgetMapping(bc)" disabled="@_busy">@Loc["Forget this rule"]</button>
                            </div>
                        }
                        else
                        {
                            <div class="modal-field">
                                @if (BankRuleOffered)
                                {
                                    <Switch Value="_bcRemember" ValueChanged="OnBankRememberChanged" Label="@Loc["Always file this merchant here"]" />
                                    @if (_bcRemember)
                                    {
                                        <span class="rule-tokens" title="@Loc["Tap a word to include or exclude it from matching. A transaction matches when all the highlighted words appear in it."]">
                                            @foreach (var tok in _pinTokens)
                                            {
                                                var bcTok = tok;
                                                <button type="button" class="rule-chip @(_pinOn.Contains(bcTok) ? "on" : "")" @onclick="() => TogglePinToken(bcTok)">@bcTok</button>
                                            }
                                        </span>
                                        <small class="hint">@Loc["Future transactions matching the highlighted words file themselves here."]</small>
                                    }
                                }
                                else
                                {
                                    <small class="hint"><Icon Name="note" /> @Loc["No merchant rule while a trip is picked — a trip's category and labels belong to the trip, not to the shop. File it here, and reach for the trip's own “attach something you've already paid” when an auto-filed expense turns out to belong to a journey."]</small>
                                }
                            </div>
                        }
                        @* The way out for a charge that shouldn't become an expense at all — a refund line, a
                           duplicate, a transfer the app already knows about. Deliberately NOT in .modal-actions:
                           that bar is a sticky title strip that collapses its buttons to ✕ and ✓ glyphs, and the one
                           slot that keeps its text (.ghost.danger) pins a red pill to the far left of the heading —
                           which is right for a one-word "Unsettle" and wrong for a sentence. As a link in the body
                           it reads as what it is: a secondary path, next to the thing it is an alternative to.
                           Same verb as the ✗ on the review row, so it is one action with one name. *@
                        <button type="button" class="link settle-link" @onclick="ConfirmDismissFromBankConfirm" disabled="@_busy">
                            <Icon Name="x" /> @Loc["Not an expense — dismiss it"]
                        </button>
                        <div class="modal-actions">
                            <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                            <button @onclick="ConfirmBankFromModal" disabled="@(_busy || _categoryId == Guid.Empty)"><Icon Name="check" /> @Loc["Add expense"]</button>
                        </div>
                    }
                    break;

                case Modal.BankConsent:
                    <h3>@_consentTitle</h3>
                    <p class="hint">@_consentBody</p>
                    <p class="hint"><a href="@PrivacyUrl" target="_blank" rel="noopener">@Loc["Privacy"]</a> · <a href="@TermsUrl" target="_blank" rel="noopener">@Loc["Terms"]</a></p>
                    <Switch @bind-Value="_consentChecked">@Loc["I understand and consent."]</Switch>
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                        <button @onclick="ConfirmBankConsent" disabled="@(!_consentChecked || _bankBusy)">@Loc["Consent & continue"]</button>
                    </div>
                    break;

                case Modal.AddCat:
                    <h3>@Loc["Add category"]</h3>
                    <div class="name-icon-row">
                        @iconButton
                        <label class="grow">@Loc["Name"] <input type="text" @bind="_fName" @bind:after="() => _fEssential = BudgetingState.GuessEssential(_fName)" /></label>
                    </div>
                    @iconGrid
                    <label>@Loc["Budget for this period (optional)"] <DecimalInput @bind-Value="_fBudget" /></label>
                    @* Same move as the savings box: the most this budget can hold before the app's own over-planned
                       warning fires, offered as a tap rather than a number to do arithmetic against. *@
                    @if (State.SuggestedBudget(Guid.Empty, _bankStatus?.Balance, _bankStatus?.BalanceCurrency) is { } _sugNewBudget)
                    {
                        <div class="suggest-row">
                            <button type="button" class="suggest-chip" @onclick="() => _fBudget = _sugNewBudget.Amount">
                                <Icon Name="bulb" /> @string.Format(Loc["Suggested {0}"], Fmt(_sugNewBudget))
                            </button>
                            <span class="suggest-why">@Loc["the most that still fits what you have left"]</span>
                        </div>
                    }
                    <Switch @bind-Value="_fEssential">@Loc["Essential spend (rent, groceries, health…)"]</Switch>
                    <small class="hint">@Loc["Essential budgets are never suggested for redirecting toward a debt."]</small>
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                        <button @onclick="SaveAddCat" disabled="@(string.IsNullOrWhiteSpace(_fName))">@Loc["Add"]</button>
                    </div>
                    break;

                case Modal.AddBudget:
                    <h3>@Loc["Add budget"]</h3>
                    // Only categories that don't have a budget yet can get one here.
                    var withoutBudget = State.CategoryOptions.Where(c => !State.HasBudget(c.Category.Id)).ToList();
                    @if (withoutBudget.Count == 0)
                    {
                        <p class="hint">@Loc["Every category already has a budget. Add a new category to budget for it."]</p>
                        <div class="modal-actions">
                            <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                            <button @onclick="BudgetAddCategory">@Loc["Add category"]</button>
                        </div>
                    }
                    else
                    {
                        <label for="addbudget-cat"><span class="lbl-row">@Loc["Category"] <button type="button" class="lbl-add" title="@Loc["Add category"]" @onclick="BudgetAddCategory">+</button></span>
                            <select id="addbudget-cat" @bind="_budgetCatId">
                                @foreach (var (cat, depth) in withoutBudget)
                                {
                                    <option value="@cat.Id">@CatOption(cat.Id, cat.Name, depth)</option>
                                }
                            </select>
                        </label>
                        <label>@Loc["Budget amount"] <DecimalInput @bind-Value="_fBudget" /></label>
                        <div class="modal-actions">
                            <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                            <button @onclick="SaveAddBudget" disabled="@(_budgetCatId == Guid.Empty || _fBudget < 0)">@Loc["Add"]</button>
                        </div>
                    }
                    break;

                case Modal.EditCat:
                    @* Cancel/Save live in the head, not at the foot: this modal has its own sticky header, so the
                       floating ✕/✓ would land on top of it. Same ✕/✓ language as every other modal. *@
                    <div class="modal-head">
                        <h3><CatIcon Name="@State.CategoryIcon(_modalCatId)" /> @Loc["Edit"] @State.CategoryName(_modalCatId)</h3>
                        <span class="modal-head-actions">
                            @* This modal is opened from the budgets list, so its trash removes the BUDGET. The
                               category itself is deleted from Manage categories — one destructive action per
                               surface, and never the bigger one by surprise. *@
                            @if (State.HasBudget(_modalCatId))
                            {
                                <button class="exp-edit" title="@Loc["Remove budget"]" @onclick="EditRemoveBudget"><Icon Name="trash" /></button>
                            }
                            <button class="exp-edit" title="@Loc["Cancel"]" @onclick="Back"><Icon Name="x" /></button>
                            <button class="exp-edit head-ok" title="@Loc["Save"]" @onclick="SaveEditCat" disabled="@(string.IsNullOrWhiteSpace(_fName))"><Icon Name="check" /></button>
                        </span>
                    </div>
                    <div class="name-icon-row">
                        @iconButton
                        <label class="grow">@Loc["Name"] <input type="text" @bind="_fName" /></label>
                    </div>
                    @iconGrid
                    <label>@Loc["Budget amount"] <DecimalInput @bind-Value="_fBudget" /></label>
                    @if (State.SuggestedBudget(_modalCatId, _bankStatus?.Balance, _bankStatus?.BalanceCurrency) is { } _sugEditBudget)
                    {
                        <div class="suggest-row">
                            <button type="button" class="suggest-chip" @onclick="() => _fBudget = _sugEditBudget.Amount">
                                <Icon Name="bulb" /> @string.Format(Loc["Suggested {0}"], Fmt(_sugEditBudget))
                            </button>
                            <span class="suggest-why">@Loc["the most that still fits what you have left"]</span>
                        </div>
                    }
                    <label>@Loc["Alert at %"] <input type="number" step="1" min="0" max="100" @bind="_fThreshold" /></label>
                    <Switch @bind-Value="_fNotify">@Loc["Notify on every expense"]</Switch>
                    <Switch @bind-Value="_fEssential">@Loc["Essential spend (rent, groceries, health…)"]</Switch>
                    @if (_editCatVendors.Count > 0)
                    {
                        @* Folded by default — it's reference detail, not something you edit every visit; the count is
                           visible on the summary so you know it's there without it taking over the modal. *@
                        <details class="cat-fold">
                            <summary class="detail-sub">@Loc["Auto-categorized merchants"] <span class="cat-fold-n">@_editCatVendors.Count</span></summary>
                            <small class="hint">@Loc["Imported transactions from these are filed here automatically. Unmapping only stops future auto-filing."]</small>
                            <ul class="list">
                                @foreach (var v in _editCatVendors)
                                {
                                    @BankRuleRow((v, "category", "bookmark"))
                                }
                            </ul>
                        </details>
                    }
                    break;

                case Modal.DeleteCat:
                    <h3>@Loc["Delete"] @State.CategoryName(_modalCatId)?</h3>
                    var catArchived = State.CategoryIsArchived(_modalCatId);
                    @if (State.CategoryRemovalBlocker(_modalCatId) is {} blocker)
                    {
                        @* History pointing at it is no longer a refusal — it's a question of where the history goes.
                           The expenses keep their id, amount, date and tags; they're re-filed, and only the caps are
                           dropped. Archive stays offered first: it's the non-destructive answer to the same problem. *@
                        var moveCount = State.ExpensesUnderCategory(_modalCatId);
                        var moveTargets = State.ReassignTargetsFor(_modalCatId);
                        <p class="hint">
                            @if (moveCount > 0)
                            {
                                @string.Format(moveCount == 1
                                    ? Loc["1 expense is filed here. Deleting moves it to another category — same amount, same date, same tags."]
                                    : Loc["{0} expenses are filed here. Deleting moves them to another category — same amounts, same dates, same tags."], moveCount)
                            }
                            @* No "…takes its sub-categories with it" branch any more: with the tree gone, the only
                               blocker left that isn't expenses is a budget, which the next sentence already says. *@
                            @((MarkupString)" ")@Loc["Any budget it has is dropped — spending moves, caps don’t."]
                        </p>
                        @if (moveTargets.Count == 0)
                        {
                            <p class="hint">@Loc["There's nowhere to move them — this is your only category. Add another one first, or archive this."]</p>
                            <div class="modal-actions">
                                <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                                @if (!catArchived) { <button @onclick="ArchiveCat"><Icon Name="archive" /> @Loc["Archive"]</button> }
                            </div>
                        }
                        else
                        {
                            <label>@Loc["Move its history to"]
                                <select @bind="_reassignCatId">
                                    @foreach (var (cat, depth) in moveTargets)
                                    {
                                        <option value="@cat.Id">@CatOption(cat.Id, cat.Name, depth)</option>
                                    }
                                </select>
                            </label>
                            <div class="modal-actions">
                                <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                                @if (!catArchived) { <button @onclick="ArchiveCat"><Icon Name="archive" /> @Loc["Archive instead"]</button> }
                                <button class="danger-btn" @onclick="ConfirmDeleteMoving" disabled="@(_reassignCatId == Guid.Empty)">@Loc["Move & delete"]</button>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="hint">@Loc["This removes the category permanently."] @if (!catArchived) { @Loc["Prefer to keep its history? Archive it instead."] }</p>
                        <div class="modal-actions">
                            <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                            @if (!catArchived) { <button @onclick="ArchiveCat"><Icon Name="archive" /> @Loc["Archive"]</button> }
                            <button class="danger-btn" @onclick="ConfirmDelete">@Loc["Delete"]</button>
                        </div>
                    }
                    break;

                case Modal.DeleteBudget:
                    @* Removing a cap, not a category — say so plainly, and say what survives. Confirmed rather than
                       done on the tap, because the trash sits inline on a row where a mis-tap is one pixel away. *@
                    <h3>@Loc["Remove the budget for"] @State.CategoryName(_budgetCatId)?</h3>
                    <p class="hint">
                        @if (State.BudgetFor(_budgetCatId) is { } delBud)
                        {
                            @string.Format(Loc["Its {0} cap for this period goes away."], Fmt(delBud.Allocated))<text> </text>
                        }
                        @Loc["The category and every expense in it stay exactly as they are."]
                    </p>
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                        <button class="danger-btn" @onclick="ConfirmRemoveBudget">@Loc["Remove budget"]</button>
                    </div>
                    break;

                case Modal.CategoryDetail:
                    <div class="modal-head">
                        <h3><CatIcon Name="@State.CategoryIcon(_modalCatId)" /> @State.CategoryName(_modalCatId)</h3>
                        <span class="modal-head-actions">
                            <button class="exp-edit" title="@Loc["Edit / budget"]" @onclick="DetailEdit"><Icon Name="pencil" /></button>
                            <button class="exp-edit" title="@Loc["Delete"]" @onclick="DetailDelete"><Icon Name="trash" /></button>
                            <button class="exp-edit" title="@Loc["Close"]" @onclick="Back"><Icon Name="x" /></button>
                        </span>
                    </div>
                    @if (State.BudgetFor(_modalCatId) is { } cb)
                    {
                        <p class="hint">@Fmt(State.Coverage(_modalCatId).Spent) @Loc["spent of"] @Fmt(cb.Allocated) @Loc["budgeted"].</p>
                    }
                    else
                    {
                        <p class="hint">@Loc["No budget set for this category."]</p>
                    }
                    RenderFragment<FinApp.Domain.Budgeting.Expense> detailRow = e =>
                        @<li>
                            <span class="row-main row-stack">
                                <span class="row-title"><CatIcon Name="@State.FundIcon(e.FundId)" /> <span class="row-title-txt">@State.FundName(e.FundId)</span></span>
                                <span class="row-sub">
                                    <span>@e.Date.ToString("dd MMM")</span>
                                    @if (!string.IsNullOrEmpty(e.Note)) { <span class="sub-note">@e.Note</span> }
                                </span>
                            </span>
                            <span class="amt">@Fmt(e.Amount)</span>
                            <span class="row-actions">
                                @if (State.IsPeriodOpen)
                                {
                                    <button class="exp-edit" title="@Loc["Edit"]" @onclick="() => DetailEditExpense(e.Id)"><Icon Name="pencil" /></button>
                                    <button class="exp-edit" title="@Loc["Remove"]" @onclick="() => DetailDeleteExpense(e.Id)"><Icon Name="trash" /></button>
                                }
                            </span>
                        </li>;
                    // Everything filed here, one list. The labelled per-sub-category blocks that used to follow went
                    // with the tree; the Breakdown's tag drill is where that split lives now, and it can show a
                    // split this list never could (a tag that spans two categories).
                    var ownExpenses = State.ExpensesFor(_modalCatId);
                    <h4 class="detail-sub">@Loc["Expenses"]</h4>
                    <ul class="list list-even">
                        @foreach (var e in ownExpenses) { @detailRow(e) }
                        @if (ownExpenses.Count == 0)
                        {
                            <li><em>@Loc["No expenses in this category yet."]</em></li>
                        }
                    </ul>
                    break;

                @* The full week (F7). Everything here is a READ-OUT of entries already logged — nothing is
                   projected, scored or advised. That is what lets it be a re-engagement surface without making a
                   claim it would have to defend, and it's why the modal can afford to be generous where the card
                   can't: opening it is a choice, so the cost of extra detail is paid only by whoever wanted it. *@
                case Modal.WeekRecap:
                    @if (State.WeeklyRecap() is { } wr)
                    {
                        var wrDown = wr.Change.IsNegative;
                        <div class="modal-head">
                            <h3><Icon Name="calendar" /> @Loc["Your week in money"]</h3>
                            <span class="modal-head-actions">
                                <button class="exp-edit" title="@Loc["Close"]" @onclick="Back"><Icon Name="x" /></button>
                            </span>
                        </div>
                        <p class="hint">@wr.From.ToString("d MMM") – @wr.To.ToString("d MMM")</p>

                        @* Four tiles, in the order the questions get asked: what went out, what came in, what that
                           left, what was set aside. Net carries the colour because it's the one figure that is
                           good or bad rather than merely large. *@
                        <div class="wk-tiles">
                            <div class="wk-tile">
                                <span class="wk-tile-l">@Loc["Spent"]</span>
                                <strong>@Fmt(wr.Spent)</strong>
                                @if (wr.HasComparison)
                                {
                                    <small class="@(wrDown ? "good-text" : "warn-text")">
                                        @string.Format(wrDown ? Loc["{0} less than the week before"] : Loc["{0} more than the week before"], Fmt(Math.Abs(wr.Change.Amount)))
                                    </small>
                                }
                            </div>
                            @* When we have a steady income figure, "money in" shows that typical weekly income (not the
                               literal deposits, which are zero most weeks) so it reconciles with "left over" below —
                               otherwise a €0 "money in" beside a positive "left over" would contradict itself. *@
                            <div class="wk-tile">
                                <span class="wk-tile-l">@(wr.IncomeIsTypical ? Loc["Typical income"] : Loc["Money in"])</span>
                                <strong>@Fmt(wr.EffectiveIncome)</strong>
                            </div>
                            <div class="wk-tile">
                                <span class="wk-tile-l">@Loc["Left over"]</span>
                                <strong class="@(wr.Net.IsNegative ? "warn-text" : "good-text")">@Fmt(wr.Net)</strong>
                                <small>@(wr.IncomeIsTypical ? Loc["vs a typical week"] : Loc["in minus out"])</small>
                            </div>
                            <div class="wk-tile">
                                <span class="wk-tile-l">@Loc["Set aside"]</span>
                                <strong class="@(wr.Saved.Amount > 0m ? "good-text" : "")">@Fmt(wr.Saved)</strong>
                                @* The painless slice: money that rounded up into savings without a decision. Only drawn
                                   when there is some, so it's a reward for using round-ups, not a nag to turn them on. *@
                                @if (wr.RoundUpsSaved.Amount > 0m)
                                {
                                    <small>@string.Format(Loc["{0} via round-ups"], Fmt(wr.RoundUpsSaved))</small>
                                }
                            </div>
                        </div>

                        @* The weekly round-up what-if ("would have set aside X or Y — switch them on") was retired
                           along with its twin on Goals: the recap is a look back at what happened, and a hypothetical
                           for a feature that isn't on is neither news nor something the reader can act on here.
                           Adopters still get their real figure on the Set-aside tile above. *@

                        @* How OFTEN, not just how much — one big week and forty small days are different habits and
                           a total alone can't tell them apart. The average is only drawn when there's more than one
                           entry, since "average of 1" is the same number twice. *@
                        <p class="wk-count">
                            <Icon Name="receipt" />
                            @string.Format(wr.ExpenseCount == 1 ? Loc["{0} transaction"] : Loc["{0} transactions"], wr.ExpenseCount)
                            @if (wr.ExpenseCount > 1)
                            {
                                <span class="wk-count-sub">@string.Format(Loc["{0} on average"], Fmt(wr.Spent.Amount / wr.ExpenseCount))</span>
                            }
                        </p>

                        @if (wr.Biggest is { } big)
                        {
                            <h4 class="wk-h">@Loc["Biggest single expense"]</h4>
                            <div class="wk-big">
                                <CatIcon Name="@State.CategoryIcon(big.CategoryId)" />
                                <span class="wk-big-main">
                                    <strong>@State.CategoryName(big.CategoryId)</strong>
                                    @* The note is usually the only thing that names the purchase — without it the
                                       row says "Food, €80" and the user is left to remember which €80. *@
                                    @if (!string.IsNullOrWhiteSpace(big.Note)) { <small>@big.Note</small> }
                                </span>
                                <span class="wk-big-amt">
                                    <strong>@Fmt(big.Amount)</strong>
                                    <small>@big.Date.ToString("ddd d MMM")</small>
                                </span>
                            </div>
                        }

                        @if (wr.CategoryBreakdown.Count > 0)
                        {
                            var wkMax = wr.CategoryBreakdown.Max(c => c.Total.Amount);
                            <h4 class="wk-h">@Loc["Where it went"]</h4>
                            <ul class="wk-bars">
                                @foreach (var slice in wr.CategoryBreakdown)
                                {
                                    <li>
                                        <span class="wk-bar-top">
                                            <span class="wk-bar-nm"><CatIcon Name="@State.CategoryIcon(slice.Id)" /> @State.CategoryName(slice.Id)</span>
                                            <span class="wk-bar-amt">@Fmt(slice.Total)</span>
                                        </span>
                                        <span class="wk-bar-track"><span class="wk-bar-fill" style="width:@(WeekBarPct(slice.Total.Amount, wkMax))%"></span></span>
                                    </li>
                                }
                            </ul>
                        }

                        @* Tags only when the account actually tags. Most don't, and an empty "Tags" heading would
                           read as a feature that's broken rather than one that's unused. *@
                        @if (wr.TagBreakdown.Count > 0)
                        {
                            <h4 class="wk-h">@Loc["Tags"]</h4>
                            <div class="wk-tags">
                                @foreach (var t in wr.TagBreakdown)
                                {
                                    <span class="wk-tag"><CatIcon Name="@State.TagIcon(t.Id)" /> @State.TagName(t.Id) <strong>@Fmt(t.Total)</strong></span>
                                }
                            </div>
                        }

                        @* ONE action, deliberately. `.modal-actions` collapses its buttons to ✕/✓ glyphs — a
                           treatment that only works for the "cancel or confirm" shape (the CSS says so itself).
                           A second button here would have turned "Dismiss for this week" into a wordless ✕ sitting
                           where every other modal's *close* lives: same glyph, same place, different meaning, and
                           the user finds out by losing the card. Dismissal stays on the card's own ✕, which is
                           where it already was and where it already reads correctly. *@
                        <div class="modal-actions">
                            <button @onclick="Back">@Loc["Done"]</button>
                        </div>
                    }
                    break;

                case Modal.Achievements:
                    <div class="modal-head">
                        <h3><Icon Name="trophy" /> @Loc["Achievements"]</h3>
                        <span class="modal-head-actions">
                            <button class="exp-edit" title="@Loc["Close"]" @onclick="Back"><Icon Name="x" /></button>
                        </span>
                    </div>
                    var achLog = State.Account.AchievementLog;
                    var achAll = CurrentAchievements();
                    var achEarned = achAll.Where(a => a.Earned).ToList();
                    var achLocked = achAll.Where(a => !a.Earned).OrderByDescending(a => a.Percent ?? 0).ToList();
                    <p class="hint">@string.Format(Loc["{0} of {1} earned"], achEarned.Count, achAll.Count)</p>
                    <div class="ring-grid ach-ring-grid">
                        @foreach (var a in achEarned)
                        {
                            <div class="ring-card">
                                @AchievementBadge(a)
                                <div class="ring-label ach-ring-label">
                                    <span class="ach-ring-title">@a.Title</span>
                                    <span class="ach-ring-desc">@a.Desc</span>
                                    @if (achLog.TryGetValue(a.Key, out var earnedOn))
                                    {
                                        <span class="ach-ring-sub">@earnedOn.ToString("dd MMM yyyy")</span>
                                    }
                                </div>
                            </div>
                        }
                        @foreach (var a in achLocked)
                        {
                            <div class="ring-card">
                                @AchievementBadge(a)
                                <div class="ring-label ach-ring-label">
                                    <span class="ach-ring-title ach-locked-title">@a.Title</span>
                                    <span class="ach-ring-desc">@a.Desc</span>
                                    @if (a.Percent is { } pct)
                                    {
                                        <span class="ach-ring-sub">@pct%</span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                    break;

                case Modal.AddAccount:
                    <h3>@Loc["New account"]</h3>
                    <label>@Loc["Name"] <input type="text" @bind="_fName" /></label>
                    @* The same searchable picker as a wallet's, minus the "same as the account" row — this IS the
                       account, so there is nothing above it to inherit from. It replaces a bare three-letter text
                       box that accepted any typo silently and offered no help at all. *@
                    <div class="modal-field"><span class="lbl-row">@Loc["Currency"]</span>
                        <CurrencyPicker Value="@_fCurrency" ValueChanged="@(v => _fCurrency = v ?? _fCurrency)"
                                        AccountCurrency="@_fCurrency" AllowNone="false" />
                    </div>
                    @SavingsTargetField
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                        <button @onclick="SaveAddAccount" disabled="@(string.IsNullOrWhiteSpace(_fName))">@Loc["Create"]</button>
                    </div>
                    break;

                case Modal.EditAccount:
                    @* Three sections, because this modal has grown past the point where a flat stack of fields reads
                       as one thought: what the account IS, how it saves, and how it prices time. The headings are
                       the navigation — there are no tabs, so nothing is hidden behind a click. *@
                    <h3>@Loc["Edit account"]</h3>

                    <h4 class="modal-sec">@Loc["Account"]</h4>
                    <label>@Loc["Name"] <input type="text" @bind="_fName" /></label>
                    <small class="hint">@Loc["Currency"] (@State.Currency) @Loc["can't be changed once an account exists."]</small>

                    <h4 class="modal-sec">@Loc["Saving"]</h4>
                    @SavingsTargetField
                    <small class="hint">@Loc["Your monthly savings goal — drives the Insights score."]</small>
                    @* F4 round-ups sit under Saving with the target — one account-level idea about setting money aside. *@
                    var ruBuckets = State.SavingBuckets.Where(b => !b.Bucket.IsArchived).ToList();
                    <div class="modal-field">
                        <span class="lbl-row">@Loc["Round up spending"]</span>
                        @if (ruBuckets.Count == 0)
                        {
                            <small class="hint">@Loc["Create a savings bucket first — round-ups need somewhere to go."]</small>
                        }
                        else
                        {
                            <div class="qp-row">
                                @foreach (var (step, label) in new (decimal, string)[] { (0m, Loc["Off"]), (1m, Fmt(1m)), (5m, Fmt(5m)) })
                                {
                                    var ruStep = step;
                                    <button type="button" class="tag-chip @(_fRoundUpTo == ruStep ? "tag-chip-on" : "")" @onclick="() => _fRoundUpTo = ruStep">@label</button>
                                }
                            </div>
                            @if (_fRoundUpTo > 0m)
                            {
                                <label>@Loc["Into"]
                                    <select @bind="_fRoundUpBucketId">
                                        @foreach (var (bucket, _) in ruBuckets)
                                        {
                                            <option value="@bucket.Id">@bucket.Name</option>
                                        }
                                    </select>
                                </label>
                                <small class="hint">@string.Format(Loc["Every expense rounds up to the next {0}, and the difference is set aside. A {1} coffee saves {2}."], Fmt(_fRoundUpTo), Fmt(RoundUpExample), Fmt(_fRoundUpTo - decimal.Remainder(RoundUpExample, _fRoundUpTo)))</small>
                            }
                            else
                            {
                                <small class="hint">@Loc["Off. Turn this on to round each expense up and quietly save the change."]</small>
                            }
                            @if (State.RoundUpsSweptTotal.Amount > 0m)
                            {
                                <small class="hint"><Icon Name="check" /> @string.Format(Loc["{0} saved this way so far."], Fmt(State.RoundUpsSweptTotal))</small>
                            }
                        }
                    </div>

                    <h4 class="modal-sec">@Loc["Time cost"]</h4>
                    @* Two ways to get a rate, and the choice is explicit rather than a silent default. Working out
                       the rate from income is the easier ask, so it leads — but it MOVES WITH INCOME, and a thin
                       month makes every purchase look longer. That's arithmetic, not a bug, which is exactly why the
                       computed figure is shown rather than the division being hidden. Typing a rate wins over it,
                       and is the honest choice for anyone freelance, part-time or on irregular pay. *@
                    <div class="modal-field">
                        <span class="lbl-row">@Loc["Show what an amount costs in hours worked"]</span>
                        <div class="qp-row">
                            @foreach (var (mode, label) in new (TimeCostMode, string)[]
                                { (TimeCostMode.Off, Loc["Off"]), (TimeCostMode.FromIncome, Loc["From my income"]), (TimeCostMode.Manual, Loc["I'll set the rate"]) })
                            {
                                var tcm = mode;
                                <button type="button" class="tag-chip @(_fTimeCostMode == tcm ? "tag-chip-on" : "")" @onclick="() => _fTimeCostMode = tcm">@label</button>
                            }
                        </div>
                    </div>
                    @if (_fTimeCostMode == TimeCostMode.FromIncome)
                    {
                        <div class="two-col">
                            <label>@Loc["Working days a month"] <input type="number" step="1" min="1" max="31" @bind="_fWorkDays" /></label>
                            <label>@Loc["Hours a day"] <DecimalInput @bind-Value="_fWorkHours" /></label>
                        </div>
                        <small class="hint">
                            @if (DerivedRatePreview() is { } derived)
                            {
                                <text>@string.Format(Loc["This period's income over that pattern works out at {0} an hour — a {1} coffee reads as {2} of work."],
                                    Fmt(State.Money(decimal.Round(derived, 2))), Fmt(State.Money(HourlyExampleAmount)), HourlyExampleLabel(derived))</text>
                                <br />
                                <text>@Loc["It's recalculated each period, so a lean month makes everything look more expensive in hours."]</text>
                            }
                            else if (_fWorkDays is > 0 && _fWorkHours is > 0m)
                            {
                                @Loc["Nothing has come in this period yet, so there's no income to divide — the time cost stays hidden until there is."]
                            }
                            else
                            {
                                @Loc["Fill both in and the rate is worked out from what you've been paid this period."]
                            }
                        </small>
                    }
                    else if (_fTimeCostMode == TimeCostMode.Manual)
                    {
                        <label>@string.Format(Loc["What an hour of your time earns ({0})"], State.Currency)
                            <DecimalInput @bind-Value="_fHourlyRate" />
                        </label>
                        <small class="hint">
                            @if (_fHourlyRate is { } hr && hr > 0m)
                            {
                                @string.Format(Loc["Amounts will also show the time behind them — a {0} coffee reads as {1} of work."],
                                    Fmt(State.Money(HourlyExampleAmount)), HourlyExampleLabel(hr))
                            }
                            else
                            {
                                @Loc["A fixed rate, unaffected by how much came in this month."]
                            }
                        </small>
                        @* The working pattern stays available here on purpose. A typed rate is what an hour is
                           WORTH; income over hours is what an hour actually PAID — unpaid overtime, a lean month
                           and time off land only in the second. Filling this in doesn't change what prices your
                           time (the typed rate still wins); it buys the reality check below. *@
                        <div class="two-col">
                            <label>@Loc["Working days a month"] <input type="number" step="1" min="1" max="31" @bind="_fWorkDays" /></label>
                            <label>@Loc["Hours a day"] <DecimalInput @bind-Value="_fWorkHours" /></label>
                        </div>
                        @if (DerivedRatePreview() is { } actual && _fHourlyRate is { } typed && typed > 0m)
                        {
                            var drift = typed / actual;
                            @* A gap under ~15% either way is noise — pay dates and part-months move the divisor
                               around. Past that it's telling the user something they can act on. *@
                            <small class="hint @(drift < 0.85m || drift > 1.18m ? "warn-text" : "")">
                                @if (drift < 0.85m)
                                {
                                    @string.Format(Loc["Heads up: your hours this period actually paid about {0} an hour — more than the {1} you typed, so amounts are showing MORE time than they really cost you."],
                                        Fmt(State.Money(decimal.Round(actual, 2))), Fmt(State.Money(typed)))
                                }
                                else if (drift > 1.18m)
                                {
                                    @string.Format(Loc["Heads up: your hours this period actually paid about {0} an hour — less than the {1} you typed, so amounts are showing LESS time than they really cost you."],
                                        Fmt(State.Money(decimal.Round(actual, 2))), Fmt(State.Money(typed)))
                                }
                                else
                                {
                                    @string.Format(Loc["Checks out — your hours this period paid about {0} an hour."], Fmt(State.Money(decimal.Round(actual, 2))))
                                }
                            </small>
                        }
                        else
                        {
                            <small class="hint">@Loc["Optional — fill these in and we'll tell you when your typed rate drifts from what you're really taking home per hour."]</small>
                        }
                    }
                    else
                    {
                        <small class="hint">@Loc["Off — amounts stay as money only."]</small>
                    }

                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                        <button @onclick="SaveEditAccount" disabled="@(string.IsNullOrWhiteSpace(_fName))">@Loc["Save"]</button>
                    </div>
                    break;

                case Modal.Archived:
                    <div class="modal-head">
                        <h3><Icon Name="archive" /> @Loc["Archived items"]</h3>
                        <span class="modal-head-actions">
                            <button class="exp-edit" title="@Loc["Close"]" @onclick="Back"><Icon Name="x" /></button>
                        </span>
                    </div>
                    var arFunds = State.ArchivedFunds;
                    var arCats = State.ArchivedCategories;
                    var arBuckets = State.SavingBuckets.Where(x => x.Bucket.IsArchived).ToList();
                    @if (arFunds.Any() || arCats.Any() || arBuckets.Count > 0)
                    {
                        <p class="hint">@Loc["Archived items keep their history and stay out of the way. Restore one to use it again."]</p>
                    }
                    @if (arFunds.Any())
                    {
                        <h4 class="archived-h"><Icon Name="coins" /> @Loc["Funds"]</h4>
                        <ul class="list">
                            @foreach (var f in arFunds)
                            {
                                var fid = f.Id;
                                <li class="row-menu-host">
                                    <span class="row-main"><CatIcon Name="@State.FundIcon(fid)" /> @f.Name</span>
                                    <span class="row-actions">
                                        <button class="exp-edit" title="@Loc["Restore"]" @onclick="() => State.RestoreFund(fid)"><Icon Name="rotate" /></button>
                                        <button class="exp-edit" title="@Loc["Remove"]" @onclick="() => OpenDeleteFund(fid)"><Icon Name="trash" /></button>
                                    </span>
                                </li>
                            }
                        </ul>
                    }
                    @if (arCats.Any())
                    {
                        <h4 class="archived-h"><Icon Name="tag" /> @Loc["Spending categories"]</h4>
                        <ul class="list">
                            @foreach (var c in arCats)
                            {
                                <li class="row-menu-host">
                                    <span class="row-main"><CatIcon Name="@State.CategoryIcon(c.Id)" /> @c.Name</span>
                                    <span class="row-actions">
                                        <button class="exp-edit" title="@Loc["Restore"]" @onclick="() => State.RestoreCategory(c.Id)"><Icon Name="rotate" /></button>
                                        <button class="exp-edit" title="@Loc["Remove"]" @onclick="() => OpenDelete(c.Id)"><Icon Name="trash" /></button>
                                    </span>
                                </li>
                            }
                        </ul>
                    }
                    @if (arBuckets.Count > 0)
                    {
                        <h4 class="archived-h"><Icon Name="target" /> @Loc["Debts & savings"]</h4>
                        <ul class="list">
                            @foreach (var a in arBuckets)
                            {
                                var aid = a.Bucket.Id;
                                <li>
                                    <span class="row-lead"><CatIcon Name="@State.SavingBucketIcon(aid)" /> @a.Bucket.Name <span class="row-note">· @(a.Bucket.IsDebt ? Loc["debt"] : Loc["savings"])</span></span>
                                    <span class="row-actions">
                                        <button class="exp-edit" title="@Loc["Restore"]" @onclick="() => RestoreBucket(aid)">↩️</button>
                                        <button class="exp-edit" title="@Loc["Remove"]" @onclick="() => OpenDeleteBucket(aid)"><Icon Name="trash" /></button>
                                    </span>
                                </li>
                            }
                        </ul>
                    }
                    @if (!arFunds.Any() && !arCats.Any() && arBuckets.Count == 0)
                    {
                        <p class="hint">@Loc["Nothing archived."]</p>
                    }
                    break;

                case Modal.DeleteAccount:
                    <h3>@Loc["Delete"] @State.Account.Name?</h3>
                    <p class="hint">@Loc["The account is archived and hidden for 30 days — you can restore it from your profile — then it and"] <strong>@Loc["all its periods, budgets, expenses and savings"]</strong> @Loc["are permanently deleted."]</p>
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                        <button class="danger-btn" @onclick="ConfirmDeleteAccount">@Loc["Delete account"]</button>
                    </div>
                    break;

                case Modal.RemoveMember:
                    <h3>@Loc["Remove"] @_removeMemberName?</h3>
                    <p class="hint">@string.Format(Loc["{0} will lose access to this account. Their recorded contributions and expenses stay."], _removeMemberName)</p>
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                        <button class="danger-btn" @onclick="ConfirmRemoveMember">@Loc["Remove from account"]</button>
                    </div>
                    break;

                case Modal.LeaveAccount:
                    <h3>@Loc["Leave"] @State.Account.Name?</h3>
                    @if (State.RealUsers.Count <= 1)
                    {
                        <p class="hint">@Loc["You're the only person here, so the account will be archived for 30 days. You can restore it from your profile before then; after that it's deleted."]</p>
                    }
                    else if (State.CurrentOwnerId == State.MyUserId)
                    {
                        <p class="hint">@Loc["You own this account, so hand it to another member before you go."]</p>
                        <label>@Loc["New owner"]
                            <select @bind="_leaveNewOwnerId">
                                <option value="@Guid.Empty">@Loc["Choose a member…"]</option>
                                @foreach (var m in State.OtherMembers)
                                {
                                    <option value="@m.UserId">@m.DisplayName</option>
                                }
                            </select>
                        </label>
                    }
                    else
                    {
                        <p class="hint">@Loc["You'll lose access to this account. Your recorded contributions and expenses stay for the others."]</p>
                    }
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                        <button class="danger-btn" @onclick="ConfirmLeaveAccount"
                                disabled="@(State.RealUsers.Count > 1 && State.CurrentOwnerId == State.MyUserId && _leaveNewOwnerId == Guid.Empty)">
                            @(State.RealUsers.Count <= 1 ? Loc["Archive account"] : Loc["Leave account"])
                        </button>
                    </div>
                    break;

                case Modal.Invite:
                    <h3>@Loc["Invite to"] @State.Account.Name</h3>
                    <p class="hint">@Loc["Enter the username of an existing FinApp user. They'll get a prompt to accept; once they do, they can edit everything except deleting the account."]</p>
                    <label>@Loc["Username"] <input type="text" @bind="_inviteUsername" @bind:event="oninput" /></label>
                    @if (_inviteMessage is not null)
                    {
                        <div class="alert">@_inviteMessage</div>
                    }
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Close"]</button>
                        <button @onclick="SendInvite" disabled="@(string.IsNullOrWhiteSpace(_inviteUsername))">Send invite</button>
                    </div>
                    break;

                case Modal.AddExpense:
                    @* The title says what is being logged AGAINST when that isn't just "this month": the flag and
                       the trip's name, in the trip's own blue. It is the one piece of context that changes where
                       every figure below lands, so it goes where a title goes rather than into a hint. *@
                    @* The same TripMode badge the account carries, so "this form is filing against a trip" is said
                       in one visual language wherever it appears. The trip's NAME is not repeated here — the chip
                       row immediately below shows it, selected, and the badge carries it in its tooltip. *@
                    <h3 class="modal-h-trip">
                        <span>@Loc["Add expense"]</span>
                        @if (State.FindTrip(_expTripId) is { } hdrTrip)
                        {
                            @TripModeTag(hdrTrip)
                        }
                    </h3>
                    @* ★ The trip leads the form. It is the first question because it decides the answers to the next
                       two — a trip that files into one category settles the category, and the labels replace the
                       everyday tags — so asking it after them would mean answering them twice. When nothing is
                       running or booked the whole block renders nothing and the form is exactly as it was.
                       Past trips are deliberately absent: attaching something you forgot is the rarer case and it
                       has its own door, "Add something already paid" on the trip's own card. *@
                    @if (FormTripOptions.Count > 0)
                    {
                        <div class="modal-field trip-pick-field">
                            <span class="lbl-row">@Loc["Part of a trip"]</span>
                            <div class="qp-row">
                                <button type="button" class="tag-chip @(_expTripId == Guid.Empty ? "tag-chip-on" : "")" @onclick="() => OnExpenseTripPicked(Guid.Empty)">@Loc["Not a trip"]</button>
                                @foreach (var t in FormTripOptions)
                                {
                                    var tripOpt = t;
                                    <button type="button" class="tag-chip @(_expTripId == tripOpt.Id ? "tag-chip-on" : "")" @onclick="() => OnExpenseTripPicked(tripOpt.Id)">
                                        @TripMark(tripOpt.Icon)@tripOpt.Name
                                    </button>
                                }
                            </div>
                        </div>
                    }
                    @* Staged expenses: "+ Add another expense" parks the current entry here as a compact row and clears
                       the editor for the next; the ✓ in the header saves them all at once. Tap a row to pull it back
                       into the editor to fix it; 🗑 drops it. *@
                    @if (_expenseDrafts.Count > 0)
                    {
                        <ul class="draft-list">
                            @foreach (var d in _expenseDrafts)
                            {
                                var draft = d;
                                <li class="draft-row">
                                    <button type="button" class="draft-main" title="@Loc["Edit"]" @onclick="() => EditDraft(draft)">
                                        <CatIcon Name="@State.CategoryIcon(draft.CategoryId)" />
                                        <span class="draft-cat">@State.CategoryName(draft.CategoryId)</span>
                                        <span class="draft-sub">@State.FundName(draft.FundId)@(string.IsNullOrEmpty(draft.Note) ? "" : " · " + draft.Note)</span>
                                        <span class="draft-amt">@Fmt(draft.Amount)</span>
                                    </button>
                                    <button type="button" class="exp-edit" title="@Loc["Remove"]" @onclick="() => RemoveDraft(draft)"><Icon Name="trash" /></button>
                                </li>
                            }
                            <li class="draft-total"><span>@string.Format(Loc["{0} to add"], _expenseDrafts.Count)</span><span class="draft-total-amt">@Fmt(_expenseDrafts.Sum(d => d.Amount))</span></li>
                        </ul>
                    }
                    @if (State.LastExpense is { } lastExp && _expenseDrafts.Count == 0)
                    {
                        @* Repeat = log a fresh copy; Edit = change that same last entry. Kept on ONE row: the "last"
                           word is dropped (icon + short verb carry it, full label in the tooltip) and the category·amount
                           context truncates so two buttons always fit the row. *@
                        <div class="last-actions">
                            <button type="button" class="repeat-last" title="@Loc["Repeat last"]" @onclick="RepeatLastExpense"><Icon Name="rotate" /> <span class="last-act-verb">@Loc["Repeat"]</span> <span class="last-act-ctx"><strong>@State.CategoryName(lastExp.CategoryId)</strong> · @Fmt(lastExp.Amount)</span></button>
                            <button type="button" class="repeat-last" title="@Loc["Edit last"]" @onclick="() => OpenEditExpense(lastExp.Id)"><Icon Name="pencil" /> <span class="last-act-verb">@Loc["Edit"]</span> <span class="last-act-ctx"><strong>@State.CategoryName(lastExp.CategoryId)</strong> · @Fmt(lastExp.Amount)</span></button>
                        </div>
                    }
                    @* ★ MONEY FIRST on a trip. The trip is picked above; after that the thing someone opened the app
                       to type is the number, and then which pocket it came out of. The label follows, because it is
                       a two-tap afterthought — and it moved BELOW the fund on purpose: on a foreign-cash wallet the
                       fund is what decides the currency the amount is read in, so it has to be settled first.
                       Off a trip the order is untouched.
                       (The labels used to sit here, above the category. The category no longer asks a question on a
                       trip — see the settled line below — so there is nothing left for them to lead into.) *@
                    @if (onTrip)
                    {
                        @amountField
                        @fundField
                        @tagPicker
                    }
                    @* ★ On a trip the category is SETTLED, so the form states it instead of asking for it. The trip
                       files into one category by design — that is the whole point of the setting — yet the picker
                       and its chip row were still the tallest block on the screen, displaying an answer the user
                       cannot usefully change without breaking the thing they turned on.
                       One line, with a way out for the rare exception. Nothing is removed: "Change" brings the
                       whole picker back exactly as it was, for this one expense. *@
                    var tripSettlesCategory = FormTrip is not null && _categoryId != Guid.Empty;
                    @if (tripSettlesCategory && !_expShowCategory)
                    {
                        <div class="modal-field exp-settled">
                            <span class="exp-settled-txt">@Loc["Files into"] <CatIcon Name="@State.CategoryIcon(_categoryId)" /> <strong>@State.CategoryName(_categoryId)</strong></span>
                            <button type="button" class="link" @onclick="() => _expShowCategory = true">@Loc["Change"]</button>
                        </div>
                    }
                    else
                    {
                    var qpCats = State.RecentCategories(6);
                    <div class="modal-field"><span class="lbl-row">@Loc["Category"] <button type="button" class="lbl-add" title="@Loc["Add category"]" @onclick="ExpenseAddCategory">+</button></span>
                        @* Most-used categories as one-tap chips right above the picker; the picker (type to search)
                           covers everything else, so it scales when there are many categories. *@
                        @if (qpCats.Count > 0)
                        {
                            <div class="qp-row">
                                @foreach (var cid in qpCats)
                                {
                                    var qpCat = cid;
                                    <button type="button" class="tag-chip @(_categoryId == qpCat ? "tag-chip-on" : "")" @onclick="() => OnExpenseCategoryPicked(qpCat)"><CatIcon Name="@State.CategoryIcon(qpCat)" /> @State.CategoryName(qpCat)</button>
                                }
                            </div>
                        }
                        <CategoryPicker Value="_categoryId" ValueChanged="OnExpenseCategoryPicked" Options="State.CategoryOptions" />
                    </div>
                    }
                    @* Off a trip these keep their old position, after the category. On a trip they were rendered
                       above (money first) — each renders in exactly one of the two places. *@
                    @if (!onTrip)
                    {
                        @amountField
                    }
                    @* ★ On a trip the date is today in almost every case — you are logging the coffee you just
                       bought — and it already defaults there. Shown as a line rather than a date input: a full
                       picker for a field nobody changes is the single largest control on the form earning nothing.
                       Off a trip it keeps its input, where back-dating is a normal thing to do. *@
                    @if (FormTrip is not null && !_expShowDate)
                    {
                        <div class="modal-field exp-settled">
                            <span class="exp-settled-txt"><Icon Name="calendar" />
                                @(_expenseDate == State.TodayDate ? Loc["Today"] : _expenseDate.ToString("d MMM"))@if (_expenseTime is { } collapsedTime) { <text> · @collapsedTime.ToString("HH:mm")</text> }
                            </span>
                            <button type="button" class="link" @onclick="() => _expShowDate = true">@Loc["Change"]</button>
                        </div>
                    }
                    else
                    {
                        @* Date and time on one row. The time is optional in the strict sense — blank it and the row
                           simply carries no clock — but it arrives filled in with "now" for an expense being logged
                           today, which is the overwhelming case and the one where the value is free and accurate. *@
                        <div class="field-row">
                            <label>@Loc["Date"] <input type="date" @bind="_expenseDate" @bind:after="OnExpenseDateChanged" min="@State.Period.From.ToString("yyyy-MM-dd")" max="@State.Period.To.ToString("yyyy-MM-dd")" /></label>
                            <label>@Loc["Time (optional)"] <input type="time" @bind="_expenseTime" /></label>
                        </div>
                    }
                    @if (!onTrip)
                    {
                        @fundField
                    }
                    @* Same treatment as the date: on a trip the note is genuinely optional and usually skipped, so
                       it collapses to a link until it is wanted. Only while it is EMPTY — a note that had been
                       typed and then hidden behind a link would be a note nobody could see they had written. *@
                    @if (FormTrip is not null && !_expShowNote && string.IsNullOrEmpty(_note))
                    {
                        <button type="button" class="link exp-add-note" @onclick="() => _expShowNote = true"><Icon Name="plus" /> @Loc["Add a note"]</button>
                    }
                    else
                    {
                        <label>@Loc["Note (optional)"] <input type="text" @bind="_note" /></label>
                    }
                    @* Off a trip the tag picker keeps its old place down here — an optional label belongs after the
                       facts. On a trip it has already been rendered above the category, because there it is not a
                       label but the thing that does the filing. Rendered in exactly one of the two spots. *@
                    @if (!onTrip)
                    {
                        @tagPicker
                    }
                    <button type="button" class="add-another" @onclick="StageCurrentExpense" disabled="@(_amount <= 0)"><Icon Name="plus" /> @Loc["Add another expense"]</button>
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                        <button @onclick="AddExpenseFromModal" disabled="@(_expenseDrafts.Count == 0 && _amount <= 0)">@Loc["Add"]</button>
                    </div>
                    break;

                case Modal.RemovePeriod:
                    <h3>@Loc["Remove this period?"]</h3>
                    <p class="hint">@Loc["This deletes period"] @State.PeriodNumber (@State.Period.From.ToString("dd MMM") – @State.Period.To.ToString("dd MMM yyyy")) @Loc["and everything in it, then re-opens the previous period as active."] @Loc["This can't be undone."]</p>
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                        <button class="danger-btn" @onclick="ConfirmRemovePeriod">@Loc["Remove period"]</button>
                    </div>
                    break;

                case Modal.NextPeriod:
                    <h3>@Loc["Start next month"]</h3>
                    <p class="hint">@Loc["Enter what each fund really holds now (previous closing balance:"] <strong>@Fmt(State.Period.ExpectedClosingBalance)</strong>). @Loc["These become the new period's opening balances — that money carries over and is fully available to budget or save."]</p>
                    @foreach (var f in State.SelectableFunds)
                    {
                        <label>@f.Name <input type="text" inputmode="text" @bind:get="RealOpeningText(f.Id)" @bind:set="v => SetRealOpeningText(f.Id, v)" /></label>
                    }
                    <Switch @bind-Value="_copyBudgets">Copy this period’s budgets forward</Switch>
                    @if (_copyBudgets)
                    {
                        <Switch @bind-Value="_adjustBudgets">@Loc["Adjust budgets to this period’s spending"]</Switch>
                        <small class="hint">@Loc["Each budget moves halfway toward what was actually spent, rounded up to the nearest 10."]</small>
                    }
                    @if (_reconcileGaps is { Count: > 0 } gaps)
                    {
                        <div class="alert warn-bg">
                            <span>@Loc["Some funds don’t match what you logged — that usually means a transaction wasn’t recorded:"]</span>
                            <ul class="list">
                                @foreach (var g in gaps)
                                {
                                    <li>
                                        <span class="row-main">@State.FundName(g.FundId)</span>
                                        <span>@Fmt(Math.Abs(g.Gap)) @(g.Gap < 0 ? Loc["less than expected (unlogged spending)"] : Loc["more than expected (unlogged money-in)"])</span>
                                    </li>
                                }
                            </ul>
                        </div>
                        @* Three genuinely different outcomes, so this row keeps its labels (see modal-actions-labelled).
                           As icons it read ✕ ✕ ✓, and the ✓ — which looks like plain confirmation — was the one that
                           writes Adjustment entries into the closing period. *@
                        <p class="hint">@Loc["Logging an adjustment adds a matching entry to this period so its books balance. Ignoring carries the difference forward untracked."]</p>
                        <div class="modal-actions modal-actions-labelled">
                            <button class="ghost" @onclick="() => { _reconcileGaps = null; CloseModal(); }">@Loc["I’ll add it myself"]</button>
                            <button class="ghost" disabled="@_busy" @onclick="RolloverIgnoringGaps">@Loc["Ignore"]</button>
                            <button disabled="@_busy" @onclick="RolloverWithAdjustments">@Loc["Log as adjustment"]</button>
                        </div>
                    }
                    else
                    {
                        <div class="modal-actions">
                            <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                            <button disabled="@_busy" @onclick="StartNextMonth">@Loc["Start next month"] →</button>
                        </div>
                    }
                    break;

                case Modal.EditExpense:
                    @* Wears the trip exactly as the add form does — the badge and the blue rail. An expense that
                       belongs to a journey should look like it in every form that shows it, not only the one that
                       created it; otherwise the trip reads as something you can set but never see. *@
                    <h3 class="modal-h-trip">
                        <span>@Loc["Edit expense"]</span>
                        @if (State.FindTrip(_expTripId) is { } editHdrTrip)
                        {
                            @TripModeTag(editHdrTrip)
                        }
                    </h3>
                    @* ★ The trip leads here as it does on the add form, and for the same reason: it decides which
                       labels the picker below offers (trip labels on a trip, everyday ones off it), so asking it
                       after them would mean answering them twice.
                       Unlike the add form this offers FINISHED trips too — that is the whole point of editing:
                       attaching the flight you booked in March, or the card charge that landed while you were away
                       and got filed on your return, to a journey that is now over. Until now the only door to that
                       was the trip card's own "add something already paid", which you had to know existed.
                       Unlike the add form it does NOT re-file the category: see OnExpenseTripPicked. *@
                    @* ⚠️ …but only when a trip is the question being asked — see EditShowsTripPicker. It used to
                       render whenever the account had EVER had a trip, so every ordinary grocery edit carried a row
                       of dead trip chips reading "Not a trip", forever. *@
                    @if (EditShowsTripPicker)
                    {
                        <div class="modal-field trip-pick-field">
                            <span class="lbl-row">@Loc["Part of a trip"]</span>
                            <div class="qp-row">
                                <button type="button" class="tag-chip @(_expTripId == Guid.Empty ? "tag-chip-on" : "")" @onclick="() => OnExpenseTripPicked(Guid.Empty)">@Loc["Not a trip"]</button>
                                @foreach (var t in EditTripOptions)
                                {
                                    var editTripOpt = t;
                                    <button type="button" class="tag-chip @(_expTripId == editTripOpt.Id && _expTripAccountId == Guid.Empty ? "tag-chip-on" : "")" @onclick="() => OnExpenseTripPicked(editTripOpt.Id)">
                                        @TripMark(editTripOpt.Icon)@editTripOpt.Name
                                    </button>
                                }
                            </div>
                            @* ★ D1 — a journey the household is taking together, where the trip lives in the other
                               account and this card paid for part of it. The expense does NOT move: it stays in
                               this account's period, spending and budgets, because this account paid. It simply
                               starts counting toward that trip's total, labelled with where it came from.
                               ⚠️ Same-currency accounts only (ForeignTripOptionsAsync), and each chip names its
                               account — two households can easily both have a "Rome". *@
                            @if (_foreignTrips.Count > 0)
                            {
                                <span class="lbl-row trip-other-lbl">@Loc["Or a trip in another account"]</span>
                                <div class="qp-row">
                                    @foreach (var ft in _foreignTrips)
                                    {
                                        var fTrip = ft;
                                        <button type="button" class="tag-chip @(_expTripId == fTrip.Trip.Id && _expTripAccountId == fTrip.AccountId ? "tag-chip-on" : "")" @onclick="() => OnForeignTripPicked(fTrip)">
                                            @TripMark(fTrip.Trip.Icon)@fTrip.Trip.Name <span class="fund-chip-ccy">@fTrip.AccountName</span>
                                        </button>
                                    }
                                </div>
                                @if (_expTripAccountId != Guid.Empty)
                                {
                                    <small class="hint"><Icon Name="swap" /> @string.Format(Loc["This stays in {0}'s spending and budgets — it just counts toward that trip's total too."], State.AccountName(State.CurrentAccountId))</small>
                                }
                            }
                        </div>
                    }
                    @* NOT a <label> — see CategoryPicker: a label re-dispatches every click inside it onto the
                       picker's trigger button, which pinned the dropdown open with the whole modal unreachable.
                       This is the same modal-field/lbl-row pairing the add-expense modal uses. *@
                    <div class="modal-field"><span class="lbl-row">@Loc["Category"]</span>
                        <CategoryPicker @bind-Value="_categoryId" Options="State.CategoryOptions" />
                    </div>
                    <label>@Loc["Amount"] <DecimalInput @bind-Value="_amount" /></label>
                    <div class="field-row">
                        <label>@Loc["Date"] <input type="date" @bind="_expenseDate" /></label>
                        <label>@Loc["Time (optional)"] <input type="time" @bind="_expenseTime" /></label>
                    </div>
                    @if (State.FindExpense(_editExpenseId) is { FundSynced: true })
                    {
                        // A bank-synced expense lives in the synced fund (its balance mirrors the real account) — its
                        // fund can't be reassigned without breaking that mirror, so show it read-only.
                        <label>@Loc["Fund"] <input type="text" value="@State.FundName(_fundId) 🏦" disabled /></label>
                    }
                    else
                    {
                        <label>@Loc["Fund"]
                            <select @bind="_fundId">
                                @foreach (var f in State.ExpensableFunds)
                                {
                                    <option @key="f.Id" value="@f.Id">@f.Name@(f.IsSynced ? " 🏦" : "")</option>
                                }
                            </select>
                        </label>
                    }
                    <label>@Loc["Note (optional)"] <input type="text" @bind="_note" /></label>
                    @if (State.FindExpense(_editExpenseId) is { AutoFiled: true } editExp)
                    {
                        @if (!string.IsNullOrEmpty(editExp.Note) && MappedLabel(editExp.Note!) is { } target)
                        {
                            <p class="hint"><Icon Name="bank" /> @Loc["Auto-filed from a saved bank rule:"] <strong>@editExp.Note</strong> → <strong>@target</strong></p>
                            <ul class="list">@BankRuleRow((BudgetingState.BankMatchKey(editExp.Note!), "category", "bookmark"))</ul>
                        }
                        else
                        {
                            <p class="hint"><Icon Name="bank" /> @Loc["Filed automatically from your bank."]</p>
                        }
                    }
                    @tagPicker
                    @if (State.FindExpense(_editExpenseId) is { IsSettlementDestination: false } && State.TransferableAccounts.Any())
                    {
                        <button type="button" class="link settle-link" @onclick="() => OpenSettleExpense(_editExpenseId)"><Icon Name="users" /> @(State.FindExpense(_editExpenseId)!.IsSettlementSource ? Loc["Edit settlement onto another account"] : Loc["Settle part onto another account"])</button>
                    }
                    @* The undo for a refund. It lives here rather than on the row because the bank transaction it
                       came from is already acknowledged and will not come back — this restores the charge, and the
                       user needs to see which charge that is while they do it. *@
                    @if (State.FindExpense(_editExpenseId) is { IsRefunded: true } refExp)
                    {
                        <button type="button" class="link settle-link" @onclick="() => OpenUndoRefund(_editExpenseId)"><Icon Name="swap" /> @string.Format(Loc["{0} came back on this — undo"], Fmt(refExp.RefundedMoney))</button>
                    }
                    @* Recording a refund by hand. It used to be reachable only by matching a bank credit in the
                       review list, which made "money came back" a feature of having a synced wallet — no help at
                       all when a friend hands you cash for their share. *@
                    @if (State.FindExpense(_editExpenseId) is { } refundable && refundable.Amount.Amount > 0m)
                    {
                        <button type="button" class="link settle-link" @onclick="() => OpenRecordRefund(_editExpenseId)"><Icon Name="swap" /> @Loc["Money came back on this"]</button>
                    }
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                        <button @onclick="SaveEditExpense" disabled="@(_amount <= 0)">@Loc["Save"]</button>
                    </div>
                    break;

                case Modal.DeleteExpense:
                    <h3>@Loc["Remove this expense?"]</h3>
                    @if (State.FindExpense(_editExpenseId) is { } ex)
                    {
                        <p class="hint">@ex.Date.ToString("dd MMM") · @State.CategoryName(ex.CategoryId) · @Fmt(ex.Amount)@(ex.IsFromSavings ? " — the savings drawdown will be restored." : "")</p>
                    }
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                        <button class="danger-btn" @onclick="ConfirmDeleteExpense">@Loc["Remove"]</button>
                    </div>
                    break;

                case Modal.RecordRefund:
                    <h3>@Loc["Money came back"]</h3>
                    @if (State.FindExpense(_editExpenseId) is { } rfx)
                    {
                        <p class="hint">@rfx.Date.ToString("dd MMM") · @State.CategoryName(rfx.CategoryId) · @Fmt(rfx.Amount)</p>
                        <label>@Loc["How much came back"] <DecimalInput @bind-Value="_refundAmount" /></label>
                        @* Which wallet actually received it. Defaulting to the expense's own wallet is the common
                           case and needs no movement at all — shrinking the expense already credits it. Naming a
                           different one is what makes "paid by card, handed back in cash" expressible. *@
                        <div class="modal-field">
                            <span class="lbl-row">@Loc["Into which wallet"]</span>
                            <select @bind="_refundFundId">
                                @foreach (var f in State.ExpensableFunds)
                                {
                                    <option value="@f.Id">@f.Name@(f.Id == rfx.FundId ? $" ({Loc["where it was paid from"]})" : "")</option>
                                }
                            </select>
                        </div>
                        <small class="hint">@Loc["The expense shrinks by this much — it is not logged as income, so \"money in\" stays honest and the category's budget corrects itself."]</small>
                        @if (_refundAmount > rfx.AmountBeforeRefund.Amount - rfx.RefundedAmount)
                        {
                            <small class="hint warn-text">@string.Format(Loc["That is more than the {0} still on this expense."], Fmt(rfx.Amount))</small>
                        }
                    }
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                        <button @onclick="ConfirmRecordRefund" disabled="@(_refundAmount <= 0)">@Loc["Take it off"]</button>
                    </div>
                    break;

                case Modal.UndoRefund:
                    <h3>@Loc["Put the money back on this expense?"]</h3>
                    @if (State.FindExpense(_editExpenseId) is { } rex)
                    {
                        <p class="hint">@rex.Date.ToString("dd MMM") · @State.CategoryName(rex.CategoryId) · @Fmt(rex.Amount) → <strong>@Fmt(rex.AmountBeforeRefund)</strong></p>
                        @* Says plainly what is not undone. The bank row was acknowledged when the refund was
                           recorded and syncing again will not bring it back, so anyone expecting this to restore
                           the review row would otherwise be waiting for something that never arrives. *@
                        <p class="hint">@Loc["The expense goes back to its full amount. The bank transaction stays acknowledged — this doesn't return it to the review list."]</p>
                    }
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                        <button @onclick="ConfirmUndoRefund">@Loc["Put it back"]</button>
                    </div>
                    break;

                case Modal.TagExpense:
                    <h3>@Loc["Label this expense"]</h3>
                    @if (State.FindExpense(_tagExpenseId) is { } tex)
                    {
                        <p class="hint">@tex.Date.ToString("dd MMM yyyy") · @State.CategoryName(tex.CategoryId) · @Fmt(tex.Amount)</p>
                    }
                    <p class="hint">@Loc["This month is closed, so the money can't change — but what it's called still can."]</p>
                    <div class="modal-field">
                        <div class="tag-pick">
                            @foreach (var t in State.ActiveTags)
                            {
                                var ttid = t.Id;
                                var ton = _tagOnlyId == ttid;
                                <button type="button" class="tag-chip @(ton ? "tag-chip-on" : "")" @onclick="() => _tagOnlyId = ton ? null : ttid">
                                    @TagMark(t.Icon)@t.Name
                                </button>
                            }
                        </div>
                        @* The same collapsed ＋ the expense form uses. Filing an old month is exactly when a label
                           that doesn't exist yet gets invented ("Reimbursable", "That move") — sending the user to
                           Manage tags and back would lose the row they were standing on. *@
                        @if (_tagNewOpen)
                        {
                            <div class="tag-new-row">
                                <input type="text" class="tag-new-in" placeholder="@Loc["New tag…"]" maxlength="30" @bind="_newTagName" @bind:event="oninput" @onkeydown="TagOnlyNewKey" />
                                <button type="button" class="lbl-add" title="@Loc["Add tag"]" disabled="@string.IsNullOrWhiteSpace(_newTagName)" @onclick="AddTagFromTagOnly">+</button>
                            </div>
                        }
                        else
                        {
                            <button type="button" class="link tag-new-open" @onclick="() => _tagNewOpen = true"><Icon Name="plus" /> @Loc["New tag"]</button>
                        }
                    </div>
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                        <button @onclick="SaveTagOnly">@Loc["Save"]</button>
                    </div>
                    break;

                @* ★ O10: one confirm modal for every destructive action that never had one, instead of a
                   twenty-first bespoke case in this switch. The twenty that exist are each a *different question*
                   with its own fields (which category do the expenses move to? which member?); these are all the
                   same question — "this cannot be undone, do it?" — and writing them out one by one is how eight of
                   them came to be missing in the first place. ⚠️ Deliberately NOT a native window.confirm: the app
                   has exactly one of those, browsers style it as a page-level alert, and it cannot carry the
                   sentence that says what will actually be lost. *@
                case Modal.Confirm:
                    <h3>@_confirmTitle</h3>
                    @if (_confirmBody is { } confBody) { <p class="hint">@confBody</p> }
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                        <button class="danger-btn" @onclick="ConfirmAndRun" disabled="@_busy">@_confirmVerb</button>
                    </div>
                    break;

                case Modal.DeleteInstallment:
                    <h3>@Loc["Remove this installment?"]</h3>
                    <p class="hint">@string.Format(Loc["All {0} rows of this payment will be removed."], _instDeleteCount)</p>
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                        <button class="danger-btn" @onclick="RemoveInstallmentFromModal">@Loc["Remove"]</button>
                    </div>
                    break;

                case Modal.SettleExpense:
                    <h3>@Loc["Settle onto another account"]</h3>
                    @if (State.FindExpense(_settleExpenseId) is { } se)
                    {
                        <p class="hint">@se.Date.ToString("dd MMM") · @State.CategoryName(se.CategoryId) · @Loc["Original:"] @Fmt(se.OriginalAmount)</p>
                    }
                    @if (!State.TransferableAccounts.Any())
                    {
                        <p class="hint">@Loc["You have no other same-currency account to settle onto."]</p>
                        <div class="modal-actions"><button class="ghost" @onclick="Back">@Loc["Close"]</button></div>
                    }
                    else
                    {
                        <label>@Loc["Account"]
                            <select @bind="_settleDestId" @bind:after="OnSettleDestChanged">
                                @foreach (var a in State.TransferableAccounts)
                                {
                                    <option value="@a.Id">@a.Name</option>
                                }
                            </select>
                        </label>
                        <label>@Loc["Destination fund"]
                            <select @bind="_settleDestFundId">
                                @foreach (var f in DestFundsFor(_settleDestId))
                                {
                                    <option value="@f.Id">@f.Name</option>
                                }
                            </select>
                        </label>
                        <label>@Loc["Category"]
                            <select @bind="_settleDestCatId">
                                @foreach (var c in DestCatsFor(_settleDestId))
                                {
                                    <option value="@c.Id">@c.Name</option>
                                }
                            </select>
                        </label>
                        <label>@Loc["Amount"] <DecimalInput @bind-Value="_settleAmount" /></label>
                        <label>@Loc["Note (optional)"] <input type="text" @bind="_settleNote" /></label>
                        <small class="hint">@Loc["Records this amount as an expense on the chosen account (in that fund and category) and reduces this expense by the same amount."]</small>
                        <div class="modal-actions">
                            @if (_settleIsEdit)
                            {
                                <button class="ghost danger" @onclick="ConfirmUnsettle">@Loc["Unsettle"]</button>
                            }
                            <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                            <button @onclick="ConfirmSettleExpense" disabled="@(_settleAmount <= 0 || _settleDestId == Guid.Empty)"><Icon Name="users" /> @(_settleIsEdit ? Loc["Save"] : Loc["Settle"])</button>
                        </div>
                    }
                    break;

                case Modal.AddBucket:
                case Modal.EditBucket:
                    <h3>@(_modal == Modal.AddBucket ? Loc["New savings bucket"] : $"{Loc["Edit"]} {State.FindSavingBucket(_modalBucketId)?.Name}")</h3>
                    <div class="name-icon-row">
                        @iconButton
                        <label class="grow">@Loc["Name"] <input type="text" @bind="_fName" /></label>
                    </div>
                    @iconGrid
                    @* Type is chosen only at creation. In edit it's fixed — the kinds have different fields, actions and
                       projections, so switching would strand data; to change kind, delete and create a new bucket. *@
                    @if (_modal == Modal.AddBucket)
                    {
                        <label>@Loc["Type"]</label>
                        <div class="plan-toggle bucket-type" role="group">
                            <button type="button" class="chip @(_bucketKind == SavingKind.Common ? "on" : "")" @onclick="() => _bucketKind = SavingKind.Common"><Icon Name="coins" /> @Loc["Savings goal"]</button>
                            <button type="button" class="chip @(_bucketKind == SavingKind.Debt ? "on" : "")" @onclick="() => _bucketKind = SavingKind.Debt"><Icon Name="card" /> @Loc["Debt payoff"]</button>
                            <button type="button" class="chip @(_bucketKind == SavingKind.Investment ? "on" : "")" @onclick="() => _bucketKind = SavingKind.Investment"><Icon Name="trending" /> @Loc["Investment"]</button>
                            <button type="button" class="chip @(_bucketKind == SavingKind.Expenses ? "on" : "")" @onclick="() => _bucketKind = SavingKind.Expenses"><Icon Name="calendar" /> @Loc["Expenses fund"]</button>
                        </div>
                    }
                    @if (_bucketKind == SavingKind.Debt)
                    {
                        @* Two ways to state the balance: what's owed now, or the original principal + how much of it you've
                           already cleared (the app derives what's owed). The latter gives an honest progress baseline.
                           ★ It has a label of its own now (O7). Without one it appeared directly under the four wrapping
                           type chips and the two rows read as a single band of six — as if "Debt payoff" and "What's
                           owed now" were alternatives to each other. The third chip row in this modal ("What moves the
                           balance") always had its label; this is the same shape, said the same way. *@
                        <label class="chip-row-lbl">@Loc["How you'll state the balance"]</label>
                        <div class="plan-toggle" role="group">
                            <button type="button" class="chip @(!_debtEnterInitial ? "on" : "")" @onclick="() => _debtEnterInitial = false">@Loc["What's owed now"]</button>
                            <button type="button" class="chip @(_debtEnterInitial ? "on" : "")" @onclick="() => _debtEnterInitial = true">@Loc["Original + already paid"]</button>
                        </div>
                        @if (!_debtEnterInitial)
                        {
                            <label>@Loc["Balance owed"] <DecimalInput @bind-Value="_debtBalance" /></label>
                        }
                        else
                        {
                            <label>@Loc["Original principal"] <DecimalInput @bind-Value="_debtOriginal" /></label>
                            <label>@Loc["Already paid off (principal)"] <DecimalInput @bind-Value="_debtPaidPrincipal" /></label>
                            <small class="hint">@string.Format(Loc["Owed now: {0}"], Fmt(new Money(Math.Max(0m, _debtOriginal - _debtPaidPrincipal), State.Currency)))</small>
                        }
                        <label>@Loc["Interest rate (% APR)"] <DecimalInput @bind-Value="_debtRate" /></label>
                        <label>@Loc["Monthly installment"] <DecimalInput @bind-Value="_debtInstallment" /></label>
                        <div class="field-row">
                            <label>@Loc["Installment due day"] <input type="number" step="1" min="1" max="31" placeholder="—" @bind="_debtDay" /></label>
                            <label>@Loc["Loan start date"] <input type="date" @bind="_debtStart" /></label>
                        </div>
                        <small class="hint">@Loc["The start date bases “interest paid so far” on the real timeline — otherwise we infer it from the balance."]</small>
                        @* A lease is not a loan that happens to end early: its instalments are sized to leave a
                           stated sum owed on the last scheduled date. Without this the payoff projection amortises
                           to zero and overshoots the contract's own end by months. *@
                        <label>@Loc["Final / residual payment (leases only)"] <DecimalInput @bind-Value="_debtResidual" /></label>
                        <small class="hint">@(_debtResidual > 0m
                            ? string.Format(Loc["The schedule will finish once {0} is left — that last lump is paid separately (or the item handed back), so it isn't spread across the instalments."], Fmt(State.Money(_debtResidual)))
                            : Loc["Leave at 0 for an ordinary loan. On a car lease this is the balloon / buy-out value stated in the contract."])</small>
                        @* This was a switch reading "I log each installment here", which named the wrong thing: it
                           does not decide where anything is logged (installments log the same either way) — it
                           decides which source of truth owns the balance. Stated as a two-way choice with the
                           consequence of each, because both are right in different situations and the trade-off
                           (a stale balance vs. an assumed one) is the whole decision. *@
                        <label class="chip-row-lbl">@Loc["What moves the balance"]</label>
                        <div class="plan-toggle" role="group">
                            <button type="button" class="chip @(!_debtPayDriven ? "on" : "")" @onclick="() => _debtPayDriven = false"><Icon Name="calendar" /> @Loc["Its own schedule"]</button>
                            <button type="button" class="chip @(_debtPayDriven ? "on" : "")" @onclick="() => _debtPayDriven = true"><Icon Name="note" /> @Loc["The payments I log"]</button>
                        </div>
                        <small class="hint">
                            @(_debtPayDriven
                                ? Loc["The balance drops only when an installment is logged here — accurate while you keep logging, and it simply goes stale if you stop. Best when this loan is paid from a wallet this app tracks."]
                                : Loc["The balance is carried forward over the installments due since it was last stated, whether or not you log them. Best when the loan is paid from an account this app can't see."])
                        </small>
                        @if (_debtPayDriven && _modal == Modal.EditBucket && !State.DebtHasLinkedBill(_modalBucketId))
                        {
                            @* The promise this mode makes is "I will keep logging", and nothing in the app is set up
                               to help them keep it. Naming the gap beats letting the balance quietly freeze. *@
                            <small class="hint warn-text">@Loc["Nothing is set to log this loan automatically yet — set up a recurring bill for it, or log each installment by hand, or the balance will stop moving."]</small>
                        }
                        <small class="hint">@Loc["Used only to project your payoff — never changes budgets, savings or balances. Set money aside with 💰, then pay the bank with 🎯."]</small>
                    }
                    else if (_bucketKind == SavingKind.Investment)
                    {
                        <label>@Loc["Expected return (% / year)"] <DecimalInput @bind-Value="_invRate" /></label>
                        <label>@Loc["Horizon (years)"] <input type="number" step="1" min="0" @bind="_invTermYears" /></label>
                        <label>@Loc["Compounding"]
                            <select @bind="_invCompounds">
                                <option value="12">@Loc["Monthly"]</option>
                                <option value="4">@Loc["Quarterly"]</option>
                                <option value="1">@Loc["Yearly"]</option>
                                <option value="365">@Loc["Daily"]</option>
                            </select>
                        </label>
                        <small class="hint">@Loc["Used only to project growth — never changes budgets, savings or balances. Fund it with 💰; the projection grows your accumulated balance at this rate."]</small>
                    }
                    else if (_bucketKind == SavingKind.Expenses && _modal == Modal.EditBucket)
                    {
                        @* Costs are managed from the bucket itself (expand it → "Add a cost"), not here — so the edit
                           form stays to name / icon / held-in-fund. *@
                        <small class="hint">@Loc["Add or change the costs this fund covers from the bucket — expand it and use “Add a cost”."]</small>
                    }
                    else if (_bucketKind == SavingKind.Expenses)
                    {
                        @* A sinking fund is its cost list, so the list is required rather than optional and there's
                           no goal field: an expenses fund never completes — next year's insurance follows this
                           year's — so a goal would give the ring a meaning it can't keep. *@
                        <div class="cost-head">
                            <label>@Loc["Costs this covers"]</label>
                            <button type="button" class="fund-add" @onclick="AddCostRow"><Icon Name="plus" /> @Loc["Add a cost"]</button>
                        </div>
                        @foreach (var costRow in _costRows)
                        {
                            <div class="cost-row">
                                <input type="text" class="cost-label" placeholder="@Loc["e.g. Insurance"]" @bind="costRow.Label" />
                                <DecimalInput Class="cost-amt" Placeholder="0.00" @bind-Value="costRow.Amount" />
                                <select class="cost-cad" @bind="costRow.Cadence">
                                    <option value="@CostCadence.Monthly">@Loc["Monthly"]</option>
                                    <option value="@CostCadence.Quarterly">@Loc["Quarterly"]</option>
                                    <option value="@CostCadence.Yearly">@Loc["Yearly"]</option>
                                    <option value="@CostCadence.OneOff">@Loc["One-off"]</option>
                                </select>
                                @if (costRow.Cadence == CostCadence.OneOff)
                                {
                                    <input type="date" class="cost-due" @bind="costRow.DueDate" />
                                }
                                <button type="button" class="exp-edit cost-del" title="@Loc["Remove"]" @onclick="() => RemoveCostRow(costRow)"><Icon Name="trash" /></button>
                            </div>
                        }
                        @if (_costRows.Count > 0)
                        {
                            var setAside = EditingSetAside();
                            var shortfall = PlannedCost.TargetShortfallFor(ValidCostRows(), EditingSaved());
                            <div class="cost-total">
                                <span>@Loc["Set aside"] <strong>@Fmt(setAside)</strong> @Loc["/ month"]</span>
                                @if (shortfall > 0m)
                                {
                                    <small class="cost-short">@string.Format(Loc["{0} still to find"], Fmt(shortfall))</small>
                                }
                            </div>
                            <small class="hint">@Loc["An amount to aim for, not a reservation — nothing moves on its own. Repeating costs are averaged over the year; a dated one-off is spread over the months until it's due, less what this bucket already holds."]</small>
                        }
                        else
                        {
                            <small class="hint">@Loc["Add the costs this fund covers — insurance, tax, a lease residual — and it works out the monthly set-aside."]</small>
                        }
                    }
                    else
                    {
                        @* The emergency fund is the one bucket whose goal the app works out rather than asks for:
                           three months of what the essential categories actually cost, rounded up to 500. So the
                           amount field gives way to the derived figure — showing both would be two numbers claiming
                           to be the same target. *@
                        <Switch @bind-Value="_fEmergency">@Loc["This is my emergency fund"]</Switch>
                        @if (_fEmergency)
                        {
                            var _emTarget = State.EmergencyTarget();
                            var _emBasis = State.EssentialSpendPerPeriod();
                            @if (_emTarget is { } _emT && _emBasis is { } _emB)
                            {
                                @* The basis comes from the domain, NOT from _emT / 3 — the target is rounded up, so
                                   dividing it back would report a monthly figure the user never actually spent. *@
                                <div class="modal-field">
                                    <span>@Loc["Goal amount"]</span>
                                    <p class="hint"><Icon Name="shield" /> @string.Format(Loc["{0} — three months of essential spending ({1} a period), rounded up to the nearest 500. It follows your essentials, so you don't have to revisit it."], Fmt(_emT), Fmt(_emB))</p>
                                </div>
                            }
                            else
                            {
                                @* Refusing to invent one: deriving from total spending would quietly redefine
                                   "essential" as "everything", which is exactly the number an emergency fund
                                   shouldn't be built on. *@
                                <small class="hint warn-text">@Loc["No categories are marked essential yet, so there's nothing to size this from. Mark the ones you'd still have to pay (rent, food, utilities) and the target works itself out."]</small>
                                <label>@Loc["Goal amount (optional)"] <DecimalInput @bind-Value="_goalAmount" /></label>
                            }
                            @if (State.OtherEmergencyFundName(_modalBucketId) is { } _otherEm)
                            {
                                <small class="hint">@string.Format(Loc["“{0}” is currently your emergency fund — saving this will move the label here."], _otherEm)</small>
                            }
                        }
                        else
                        {
                            <label>@Loc["Goal amount (optional)"] <DecimalInput @bind-Value="_goalAmount" /></label>
                        }
                        <label>@Loc["Alert at %"] <input type="number" step="1" min="0" max="100" @bind="_fThreshold" /></label>
                        <Switch @bind-Value="_fNotify">@Loc["Notify on milestone"]</Switch>
                    }
                    <label>@Loc["Held in fund (optional)"]
                        <select @bind:get="_bucketFundId?.ToString()" @bind:set="v => _bucketFundId = Guid.TryParse(v, out var g) ? g : (Guid?)null">
                            <option value="">@Loc["— none —"]</option>
                            @foreach (var f in State.SelectableFunds)
                            {
                                <option value="@f.Id">@f.Name</option>
                            }
                        </select>
                    </label>
                    <small class="hint">@Loc["Which fund this bucket's money sits in. It moves no money — it just labels the bucket and picks the fund by default when you pay from it."]</small>
                    @if (State.CanSetInitialSavings)
                    {
                        <label>@Loc["Already saved (starting balance)"] <DecimalInput @bind-Value="_initialSavings" /></label>
                        <small class="hint">@Loc["Money you already had in this bucket before using FinApp. It counts toward the balance and goal, but not toward your savings rate."]</small>
                    }
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                        @* An expenses fund with no costs would compute a €0 set-aside and nudge about nothing —
                           the cost list is what the kind is for, so it's required rather than optional. *@
                        <button @onclick="SaveBucket" disabled="@(string.IsNullOrWhiteSpace(_fName) || (_modal == Modal.AddBucket && _bucketKind == SavingKind.Expenses && ValidCostRows().Count == 0))">@(_modal == Modal.AddBucket ? "Add" : "Save")</button>
                    </div>
                    break;

                case Modal.EditCost:
                    <h3>@(_editCostIndex >= 0 ? Loc["Edit cost"] : Loc["Add a cost"])@(State.FindSavingBucket(_costBucketId) is { } costBkt ? $" · {costBkt.Name}" : "")</h3>
                    <label>@Loc["Name"] <input type="text" placeholder="@Loc["e.g. Insurance"]" @bind="_editCost.Label" /></label>
                    <label>@Loc["Amount"] <DecimalInput @bind-Value="_editCost.Amount" /></label>
                    <label>@Loc["How often"]
                        <select @bind="_editCost.Cadence">
                            <option value="@CostCadence.Monthly">@Loc["Monthly"]</option>
                            <option value="@CostCadence.Quarterly">@Loc["Quarterly"]</option>
                            <option value="@CostCadence.Yearly">@Loc["Yearly"]</option>
                            <option value="@CostCadence.OneOff">@Loc["One-off"]</option>
                        </select>
                    </label>
                    @if (_editCost.Cadence == CostCadence.OneOff)
                    {
                        <label>@Loc["Due date"] <input type="date" @bind="_editCost.DueDate" /></label>
                    }
                    <small class="hint">@Loc["Repeating costs are averaged over the year; a dated one-off is spread over the months until it's due, less what this bucket already holds."]</small>
                    <div class="modal-actions">
                        @if (_editCostIndex >= 0)
                        {
                            <button class="ghost danger" @onclick="() => ConfirmDeleteCost(_costBucketId, _editCostIndex)"><Icon Name="trash" /> @Loc["Remove"]</button>
                        }
                        <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                        <button @onclick="SaveCost" disabled="@(string.IsNullOrWhiteSpace(_editCost.Label) || _editCost.Amount <= 0m)">@(_editCostIndex >= 0 ? Loc["Save"] : Loc["Add"])</button>
                    </div>
                    break;

                case Modal.Transfer:
                    <h3>@Loc["Transfer from"] @State.FundName(_mTransferFromId)</h3>
                    @* "Edit last" belongs to the thing it edits, not to the ＋ menu — the same pattern Add expense
                       and Add income already use. Between wallets only: an account-to-account transfer has two
                       halves and its own two-sided editor, so it must not be quietly edited from here. *@
                    @if (State.LastFundTransfer is { } _lastXfer)
                    {
                        <div class="last-actions">
                            <button type="button" class="repeat-last" title="@Loc["Edit last transfer"]" @onclick="() => OpenEditTransfer(_lastXfer.Id)"><Icon Name="pencil" /> <span class="last-act-verb">@Loc["Edit"]</span> <span class="last-act-ctx"><strong>@State.FundName(_lastXfer.FromFundId) → @State.FundName(_lastXfer.ToFundId)</strong> · @Fmt(_lastXfer.Amount)</span></button>
                        </div>
                    }
                    <label>@Loc["To"]
                        <select @bind="_mTransferDestId" @bind:after="OnModalDestChanged">
                            <optgroup label="@Loc["Wallets"]">
                                @foreach (var f in State.RootFunds.Where(f => f.Id != _mTransferFromId))
                                {
                                    <option value="@f.Id">@f.Name</option>
                                }
                            </optgroup>
                            @if (State.TransferableAccounts.Any())
                            {
                                <optgroup label="@Loc["Other accounts"]">
                                    @foreach (var a in State.TransferableAccounts)
                                    {
                                        <option value="@a.Id">📤 @a.Name</option>
                                    }
                                </optgroup>
                            }
                        </select>
                    </label>
                    @if (MTransferDestIsAccount && DestFundsFor(_mTransferDestId).Count > 0)
                    {
                        <label>@Loc["Destination fund"]
                            <select @bind="_mTransferDestFundId">
                                @foreach (var f in DestFundsFor(_mTransferDestId))
                                {
                                    <option value="@f.Id">@f.Name</option>
                                }
                            </select>
                        </label>
                    }
                    <label>@Loc["Amount"] <DecimalInput @bind-Value="_mTransferAmount" /></label>
                    @* ★ Loading a foreign-cash wallet DERIVES its rate instead of asking for one. "€234 out, £200
                       in" is what actually happened at the exchange office — the user is holding a receipt, not a
                       rate — and 234/200 = 1.17 is the TRUE rate for that pile of notes, margin and fees included,
                       which a typed mid-market figure never is.
                       Only when the destination wallet already names a currency: the currency is a property of the
                       wallet (set once, on the wallet), the rate is a property of this particular purchase. *@
                    @if (!MTransferDestIsAccount && State.Account.FindFund(_mTransferDestId) is { Currency: not null } fxDest)
                    {
                        <label>@string.Format(Loc["And you received ({0})"], fxDest.Currency) <DecimalInput T="decimal?" @bind-Value="_mTransferReceived" placeholder="@Loc["optional"]" /></label>
                        @if (_mTransferReceived is > 0m && _mTransferAmount > 0m)
                        {
                            <small class="hint trip-fx"><Icon Name="swap" />
                                @string.Format(Loc["Rate: 1 {0} = {1}. Saved on {2}, and used for everything you spend from it."],
                                    fxDest.Currency, Fmt(State.Money(decimal.Round(_mTransferAmount / _mTransferReceived.Value, 4, MidpointRounding.AwayFromZero))), fxDest.Name)</small>
                        }
                        else
                        {
                            <small class="hint">@string.Format(Loc["What you got in {0}, so we can work out the rate you actually paid. Leave it blank to keep {1}'s current rate."], fxDest.Currency, fxDest.Name)</small>
                        }
                    }
                    @if (MTransferDestIsAccount)
                    {
                        @* Optional, and only about budgets. Money sent to another account already counts in "Spent"
                           and gets its own Breakdown slice — the one place it went missing was budgets, because a
                           budget caps a category and this had none. Naming one lets a standing household transfer
                           be planned for; leaving it blank keeps the old behaviour exactly. *@
                        <div class="modal-field">
                            <span class="lbl-row">@Loc["Count against a budget"] <small class="hint">@Loc["optional"]</small>
                                <button type="button" class="lbl-add" title="@Loc["Add category"]" @onclick="TransferAddCategory">+</button></span>
                            @* Not a <label>: it would trap this picker's clicks and pin the menu open. *@
                            <CategoryPicker @bind-Value="_mTransferCategoryId" Options="State.CategoryOptions"
                                            AllowNone="true" NoneLabel="@Loc["Not budgeted"]" />
                        </div>
                        <small class="hint @(MTransferDipsSavings ? "warn-text" : "")">@Loc["In this fund:"] <strong>@Fmt(State.FundBalance(_mTransferFromId))</strong>. @(MTransferDipsSavings ? Loc["⚠ This dips into money earmarked for savings."] : "")</small>
                    }
                    else
                    {
                        <small class="hint">@Loc["Available in this fund:"] <strong>@Fmt(State.FundBalance(_mTransferFromId))</strong></small>
                    }
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                        <button @onclick="ConfirmTransfer" disabled="@(_mTransferAmount <= 0 || _mTransferDestId == Guid.Empty || _mTransferDestId == _mTransferFromId || _mTransferAmount > MTransferMax)"><Icon Name="swap" /> @Loc["Transfer money"]</button>
                    </div>
                    break;

                case Modal.BankTransfer:
                    <h3><Icon Name="swap" /> @Loc["Transfer this money-out"]</h3>
                    @if (_bankXferTx is { } bx)
                    {
                        <p class="hint">@string.Format(Loc["{0} left {1} on {2}. Send it to another fund or account instead of logging an expense."], Fmt(new Money(Math.Abs(bx.Amount), State.Currency)), State.SyncedFundName, bx.Date.ToString("dd MMM"))</p>
                    }
                    <label>@Loc["To"]
                        <select @bind="_mTransferDestId" @bind:after="OnModalDestChanged">
                            <optgroup label="@Loc["Wallets"]">
                                @foreach (var f in State.RootFunds.Where(f => f.Id != State.SyncedFundId))
                                {
                                    <option value="@f.Id">@f.Name</option>
                                }
                            </optgroup>
                            @if (State.TransferableAccounts.Any())
                            {
                                <optgroup label="@Loc["Other accounts"]">
                                    @foreach (var a in State.TransferableAccounts)
                                    {
                                        <option value="@a.Id">📤 @a.Name</option>
                                    }
                                </optgroup>
                            }
                        </select>
                    </label>
                    @if (MTransferDestIsAccount && DestFundsFor(_mTransferDestId).Count > 0)
                    {
                        <label>@Loc["Destination fund"]
                            <select @bind="_mTransferDestFundId">
                                @foreach (var f in DestFundsFor(_mTransferDestId))
                                {
                                    <option value="@f.Id">@f.Name</option>
                                }
                            </select>
                        </label>
                    }
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                        <button @onclick="ConfirmBankTransferRow" disabled="@(_bankBusy || _mTransferDestId == Guid.Empty || _mTransferDestId == State.SyncedFundId)"><Icon Name="swap" /> @Loc["Record transfer"]</button>
                    </div>
                    break;

                case Modal.Deposit:
                    <h3>@Loc["Add income"]</h3>
                    @if (State.LastContribution is { } lastInc && State.CanHandleContribution(lastInc))
                    {
                        <div class="last-actions">
                            <button type="button" class="repeat-last" title="@Loc["Edit last"]" @onclick="() => OpenEditDeposit(lastInc.Id)"><Icon Name="pencil" /> <span class="last-act-verb">@Loc["Edit"]</span> <span class="last-act-ctx"><strong>@State.ContributionCategoryName(lastInc.CategoryId)</strong> · @Fmt(lastInc.Paid)</span></button>
                        </div>
                    }
                    <label for="dep-cat"><span class="lbl-row">@Loc["Category"] <button type="button" class="lbl-add" title="@Loc["New contribution category"]" @onclick="DepositAddCategory">+</button></span>
                        <select id="dep-cat" @bind="_depCategoryId">
                            @foreach (var cc in State.ContributionCategories)
                            {
                                <option value="@cc.Id">@cc.Name</option>
                            }
                        </select>
                    </label>
                    <label for="dep-fund"><span class="lbl-row">@Loc["Fund"] <button type="button" class="lbl-add" title="@Loc["New fund"]" @onclick="DepositAddFund">+</button></span>
                        <select id="dep-fund" @bind="_depFundId">
                            @foreach (var f in State.SelectableFunds)
                            {
                                <option value="@f.Id">@f.Name</option>
                            }
                        </select>
                    </label>
                    <label>@Loc["Amount"] <DecimalInput @bind-Value="_depAmount" /></label>
                    <label>@Loc["Date"] <input type="date" @bind="_depDate" min="@State.Period.From.ToString("yyyy-MM-dd")" max="@State.Period.To.ToString("yyyy-MM-dd")" /></label>
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                        <button @onclick="RecordDeposit" disabled="@(_depAmount <= 0)">@Loc["Add income"]</button>
                    </div>
                    break;

                case Modal.ManageCats:
                    @* Manage spending categories without going through a budget. Top-level only — a category's
                       sub-categories are managed inside its own Edit modal (reached via the pencil). *@
                    <div class="modal-head">
                        <h3><Icon Name="tag" /> @Loc["Categories"]</h3>
                        <span class="modal-head-actions">
                            <button class="exp-edit" title="@Loc["Close"]" @onclick="Back"><Icon Name="x" /></button>
                        </span>
                    </div>
                    var topCats = State.CategoryOptions.Where(c => c.Depth == 0).ToList();
                    <button class="fund-add" @onclick="ManageAddCat"><Icon Name="plus" /> @Loc["Add category"]</button>
                    @if (topCats.Count == 0)
                    {
                        <p class="hint">@Loc["No categories yet — add one to start filing expenses."]</p>
                    }
                    else
                    {
                        @* ★ A grid, not a list. A category IS its icon in this app — the picker leads with it, every
                           expense row leads with it, the breakdown colours by it — so a list spent a whole row on
                           each one and still made the icon incidental. The tile itself is the edit affordance (the
                           pencil was one of two identical grey glyphs); delete keeps its own corner control so a
                           mis-tap cannot remove a category. *@
                        <div class="cat-grid">
                            @foreach (var (cat, _) in topCats)
                            {
                                var catId = cat.Id;
                                <div class="cat-tile">
                                    <button type="button" class="cat-tile-main" title="@Loc["Edit"]" @onclick="() => ManageEditCat(catId)">
                                        <CatIcon Name="@State.CategoryIcon(catId)" />
                                        <span class="cat-tile-name">@cat.Name</span>
                                    </button>
                                    <button type="button" class="exp-edit cat-tile-del" title="@Loc["Remove"]" @onclick="() => ManageDeleteCat(catId)"><Icon Name="trash" /></button>
                                </div>
                            }
                        </div>
                    }
                    break;

                case Modal.ManageContribCats:
                    <div class="modal-head">
                        <h3><Icon Name="tag" /> @Loc["Contribution categories"]</h3>
                        <span class="modal-head-actions">
                            <button class="exp-edit" title="@Loc["Close"]" @onclick="Back"><Icon Name="x" /></button>
                        </span>
                    </div>
                    <button class="fund-add" @onclick="OpenAddContribCat"><Icon Name="plus" /> @Loc["Add category"]</button>
                    <ul class="list">
                        @foreach (var cc in State.ContributionCategories)
                        {
                            <li>
                                <span class="row-lead">
                                    <button class="exp-edit" title="@Loc["Rename"]" @onclick="() => OpenEditContribCat(cc.Id)"><Icon Name="pencil" /></button>
                                    <button class="exp-edit" title="@Loc["Remove"]" @onclick="() => OpenDeleteContribCat(cc.Id)"><Icon Name="trash" /></button>
                                    <span><CatIcon Name="@State.ContributionCategoryIcon(cc.Id)" /> @cc.Name</span>
                                </span>
                            </li>
                        }
                    </ul>
                    break;

                case Modal.ManageTags:
                    <div class="modal-head">
                        <h3><Icon Name="tag" /> @Loc["Tags"]</h3>
                        <span class="modal-head-actions">
                            <button class="exp-edit" title="@Loc["Close"]" @onclick="Back"><Icon Name="x" /></button>
                        </span>
                    </div>
                    <p class="hint">@Loc["Flat labels you attach to expenses alongside categories — to track things that cut across them (a trip, work, reimbursable)."]</p>
                    <div class="tag-new-row">
                        <input type="text" class="tag-new-in grow" placeholder="@Loc["New tag…"]" maxlength="30" @bind="_manageTagName" @bind:event="oninput" @onkeydown="ManageTagKey" />
                        <button class="fund-add" disabled="@string.IsNullOrWhiteSpace(_manageTagName)" @onclick="AddTagFromManage"><Icon Name="plus" /> @Loc["Add tag"]</button>
                    </div>
                    var allTags = State.AllTags;
                    @if (allTags.Count == 0)
                    {
                        <p class="hint">@Loc["No tags yet — add one above, or from the tag box when logging an expense."]</p>
                    }
                    else
                    {
                        <ul class="list">
                            @foreach (var t in allTags)
                            {
                                var tid = t.Id;
                                var archived = t.IsArchived;
                                var tagCat = State.TagCategory(tid);
                                <li>
                                    @* The F2 binding is shown on the row, not just inside the edit modal — a tag that
                                       silently changes the category on pick has to be visible from the list that owns it. *@
                                    <span class="row-main"><span class="exp-tag @(archived ? "exp-tag-off" : "")">@t.Name</span>@if (tagCat is { } tc) { <span class="row-note"> · <Icon Name="arrow-right" /> @State.CategoryName(tc)</span> }@if (archived) { <span class="row-note"> · @Loc["archived"]</span> }</span>
                                    <span class="row-actions">
                                        <button class="exp-edit" title="@Loc["Edit"]" @onclick="() => OpenEditTag(tid)"><Icon Name="pencil" /></button>
                                        <button class="exp-edit" title="@(archived ? Loc["Restore"] : Loc["Archive"])" @onclick="() => (archived ? State.RestoreTag(tid) : State.ArchiveTag(tid))"><Icon Name="@(archived ? "rotate" : "archive")" /></button>
                                        <button class="exp-edit" title="@Loc["Remove"]" @onclick="() => ConfirmRemoveTag(tid)"><Icon Name="trash" /></button>
                                    </span>
                                </li>
                            }
                        </ul>
                    }
                    break;

                case Modal.EditTag:
                    <h3>@Loc["Edit tag"]</h3>
                    <label>@Loc["Name"] <input type="text" maxlength="30" @bind="_editTagName" @bind:event="oninput" @onkeydown="EditTagKey" /></label>
                    @* F2: bind the tag to a category so applying it files the expense automatically. Optional and
                       off by default — a tag with no binding behaves exactly as it always has. *@
                    <label>@Loc["Files into"]
                        <select @bind="_editTagCatId">
                            <option value="@Guid.Empty">@Loc["— no category —"]</option>
                            @foreach (var (c, depth) in State.CategoryOptions)
                            {
                                <option value="@c.Id">@(new string(' ', depth * 3))@c.Name</option>
                            }
                        </select>
                    </label>
                    <small class="hint">@Loc["Picking this tag on a new expense will select that category for you. Expenses you already logged keep the category they have."]</small>
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                        <button @onclick="SaveEditTag" disabled="@string.IsNullOrWhiteSpace(_editTagName)">@Loc["Save"]</button>
                    </div>
                    break;

                case Modal.TripEdit:
                    <h3>@(_tripId == Guid.Empty ? Loc["New trip"] : Loc["Edit trip"])</h3>
                    <label>@Loc["Name"] <input type="text" maxlength="40" @bind="_tripName" @bind:event="oninput" placeholder="@Loc["Rome"]" /></label>
                    <label>@Loc["Where"] <input type="text" maxlength="60" @bind="_tripDestination" @bind:event="oninput" placeholder="@Loc["Rome, Italy"]" /></label>
                    @* ⚠️ `min` on the To field does two jobs at once: it greys out every day before departure (a trip
                       cannot end before it starts, and the Save button's guard shouldn't be the first time anyone
                       hears that), and it makes the picker OPEN on the departure month instead of today's — the
                       browser opens an empty/earlier date input at its minimum. One attribute, both asks. *@
                    <div class="row2">
                        <label>@Loc["From"] <input type="date" @bind="_tripFrom" /></label>
                        <label>@Loc["To"] <input type="date" @bind="_tripTo" min="@_tripFrom.ToString("yyyy-MM-dd")" /></label>
                    </div>
                    @* Overlap warning. Overlapping trips are ALLOWED — people really do fly straight from one to
                       the next — but the app resolves "which trip is running today" to the most recent departure,
                       so on the shared days one of them silently stops being the default on the expense form.
                       Saying so is the whole fix: it is a consequence to know about, not an error to block. *@
                    @if (OverlappingTrips() is { Count: > 0 } clash)
                    {
                        <small class="hint warn-text"><Icon Name="info" />
                            @string.Format(Loc["These dates overlap {0}. Both stay pickable on the expense form — on the shared days new expenses just default to whichever started later."], string.Join(", ", clash.Select(t => t.Name)))
                        </small>
                    }
                    <label>@Loc["Mark"] <input type="text" maxlength="4" @bind="_tripIcon" @bind:event="oninput" placeholder="@Loc["pick one below, or type an emoji"]" /></label>
                    @* Tap-to-fill rather than a typeahead: the field takes any emoji, and the only ones worth
                       suggesting are the flag for the place named above plus a handful of trip shapes. A guessed
                       flag leads when there is one. *@
                    <div class="icon-picks">
                        @foreach (var pick in TripIconSuggestions())
                        {
                            var ico = pick;
                            <button type="button" class="icon-pick @(_tripIcon == ico ? "on" : "")" @onclick="() => _tripIcon = ico">@TagMark(ico)</button>
                        }
                    </div>

                    <h4 class="modal-sec">@Loc["Money"]</h4>
                    <label>@Loc["What you expect it to cost"] <DecimalInput T="decimal?" class="num" @bind-Value="_tripBudget" placeholder="@Loc["optional"]" /></label>
                    @* Where the trip's spending lands in the ordinary budget. ★ ONE category, always — the
                       per-label option that used to head this list is gone. You budget a trip as a trip; spreading
                       it across Food, Transport and Housing means keeping four budgets to describe one holiday and
                       breaking all four the same fortnight. The trip labels still carry stay / travel / food /
                       tickets, so nothing is lost: the detail lives on the axis built for it, and the trip's own
                       recap is where it gets read. *@
                    <label>@Loc["Files into"]
                        <select @bind="_tripCategoryId">
                            @foreach (var (c, depth) in State.CategoryOptions)
                            {
                                <option value="@c.Id">@IndentLabel(c.Name, depth)</option>
                            }
                        </select>
                    </label>
                    <small class="hint">@Loc["The whole trip lands in this one category and every trip label files there, so one budget covers the journey and your everyday budgets keep describing everyday life. The trip's own recap still splits it by stay, travel, food and tickets."]</small>
                    var tripBuckets = State.SavingBuckets.Where(b => !b.Bucket.IsArchived && !b.Bucket.IsDebt).ToList();
                    @* Funding a trip from a pot is the planning half of trips, and planning is where Pro sits. Shown
                       rather than hidden on Free: the field explains what the paid tier is FOR, which a missing row
                       can't. The gate that matters is the server's, on use-savings. *@
                    @if (tripBuckets.Count > 0 && !Gate.Allows(PlanFeatures.Trips))
                    {
                        <ProLock Feature="@PlanFeatures.Trips" Bar="true" Label="@Loc["Save up for a trip and spend it as a trip — with Pro"]" />
                    }
                    else if (tripBuckets.Count > 0)
                    {
                        <label>@Loc["Paid for from"]
                            <select @bind="_tripBucketId">
                                <option value="@Guid.Empty">@Loc["— nothing set aside —"]</option>
                                @foreach (var (bucket, _) in tripBuckets)
                                {
                                    <option value="@bucket.Id">@bucket.Name</option>
                                }
                            </select>
                        </label>
                        <small class="hint">@Loc["The recap will say how much of the trip came out of that pot. It never discounts the total — the money still left."]</small>
                    }

                    @* ⛔ The trip's own currency + rate are GONE from this form. They converted EVERY expense on the
                       trip, including the card payments the bank had already converted — read €50 off your
                       statement, type 50, and the app stored €58.50.
                       A rate is attached to a specific pile of foreign notes bought at a specific price, which is a
                       WALLET, so that is where it lives now: Wallets → the wallet → Foreign cash, where it is also
                       derived from the transfer that loaded it rather than typed. Asking for it again here would be
                       asking the same question in the place that gets the answer wrong.
                       The domain fields stay (every existing trip must keep loading); nothing reads or writes them. *@
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                        <button @onclick="SaveTripForm" disabled="@(string.IsNullOrWhiteSpace(_tripName) || _tripTo < _tripFrom)">@Loc["Save"]</button>
                    </div>
                    break;

                case Modal.UseTripSavings:
                    // Inside the switch, which is already a code block — no `@{` here (see the trip expense list).
                    var usTrip = State.FindTrip(_useSavingsTripId);
                    var usPot = usTrip?.SavingCategoryId is { } usBkt ? State.SavingBucketSaved(usBkt) : State.Money(0m);
                    <h3><Icon Name="coins" /> @Loc["Use the saved money"]</h3>
                    @if (usTrip is not null)
                    {
                        @* Said plainly, because "no money moves" is the surprising part: the pot is an earmark, not a
                           separate wallet, so releasing it changes what you're allowed to spend rather than where the
                           money is. Nothing leaves the account and the period still reconciles. *@
                        <p class="hint">@string.Format(Loc["This releases money you'd set aside in {0} into {1}'s budget for this month, so the trip's spending has its own money instead of eating your everyday budget. No money actually moves between wallets."],
                            State.SavingBucketName(usTrip.SavingCategoryId!.Value), State.CategoryName(usTrip.CategoryId!.Value))</p>
                        <div class="trip-when-split">
                            <span class="tws"><span class="tws-k">@Loc["Set aside"]</span><span class="tws-v">@Fmt(usPot)</span></span>
                            @if (usTrip.Budget is { } usBudget)
                            {
                                <span class="tws"><span class="tws-k">@Loc["Trip budget"]</span><span class="tws-v">@Fmt(State.Money(usBudget))</span></span>
                            }
                            @if (usTrip.SavingsApplied > 0m)
                            {
                                <span class="tws"><span class="tws-k">@Loc["Already released"]</span><span class="tws-v">@Fmt(State.Money(usTrip.SavingsApplied))</span></span>
                            }
                        </div>
                        <label>@Loc["Amount"] <DecimalInput @bind-Value="_useSavingsAmount" /></label>
                        @if (_useSavingsAmount > usPot.Amount)
                        {
                            <small class="hint warn-text">@string.Format(Loc["That's more than the {0} you've set aside."], Fmt(usPot))</small>
                        }
                    }
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                        <button @onclick="UseTripSavingsConfirmed" disabled="@(_useSavingsAmount <= 0 || _useSavingsAmount > usPot.Amount)"><Icon Name="arrow-right" /> @Loc["Release it"]</button>
                    </div>
                    break;

                case Modal.AttachToTrip:
                    <h3>@string.Format(Loc["Add to {0}"], State.TripName(_tripId))</h3>
                    @* The flow that makes pre-payment work: the flight was bought in March, the trip is in June,
                       and by now March is closed. Attaching writes only the link, so a closed period is no
                       obstacle — nothing here edits the expense itself. *@
                    <p class="hint">@Loc["Pick anything you've already paid for this trip — flights, a hotel, tickets. It stays in the month you paid it; it just starts counting toward the trip."]</p>
                    @* ★ Search, because a cap is not a history. The list shows the most recent 60, which on an active
                       account is about two months — and a flight for a June trip is routinely bought in January. The
                       search runs over EVERY period before the cap is applied, so anything is reachable by typing;
                       and rows already on this trip are exempt from the CAP — but not from the search, or ticking a
                       row buries the next match under the rows you just filtered out. Amounts match too: what you
                       remember about a booking is often the number and nothing else. *@
                    <label class="attach-search">
                        <Icon Name="search" />
                        <input type="text" placeholder="@Loc["Search every month — “flight”, “hotel”, 46.80…"]" @bind="_attachSearch" @bind:event="oninput" />
                    </label>
                    var attachable = State.RecentExpensesAcrossPeriods(60, _attachSearch, _tripId);
                    @if (attachable.Count == 0)
                    {
                        <p class="hint">@(string.IsNullOrWhiteSpace(_attachSearch) ? Loc["Nothing logged yet."] : Loc["Nothing matches that."])</p>
                    }
                    else
                    {
                        <ul class="attach-list">
                            @foreach (var candidate in attachable)
                            {
                                var row = candidate;
                                var mine = row.TripId == _tripId;
                                var elsewhere = row.TripId is { } other && other != _tripId;
                                <li class="attach-row @(mine ? "on" : "")">
                                    <button type="button" class="attach-main" disabled="@elsewhere" @onclick="() => ToggleAttachToTrip(row.Id, mine)">
                                        <CatIcon Name="@State.CategoryIcon(row.CategoryId)" />
                                        <span class="attach-id">
                                            <span class="attach-cat">@(string.IsNullOrWhiteSpace(row.Note) ? State.CategoryName(row.CategoryId) : row.Note)</span>
                                            <span class="attach-when">
                                                @row.Date.ToString("d MMM yyyy")
                                                @if (elsewhere)
                                                {
                                                    <span class="attach-taken">· @string.Format(Loc["on {0}"], State.TripName(row.TripId!.Value))</span>
                                                }
                                            </span>
                                        </span>
                                        <span class="attach-amt">@Fmt(row.Amount)</span>
                                        @if (mine) { <Icon Name="check" /> }
                                    </button>
                                    @* ★ Label it here, on the row, the moment it is attached. The trip's recap is
                                       drawn on the tag axis, so a booking that joins the trip untagged lands in the
                                       "untagged" share and drags the whole split below the threshold where it is
                                       worth showing — and the ordinary edit form can't fix it, because the month it
                                       was paid in has been closed for six months. This writes only the tag. *@
                                    @if (mine && State.TripTags.Count > 0)
                                    {
                                        <div class="attach-tags">
                                            @foreach (var tt in State.TripTags)
                                            {
                                                var attTag = tt;
                                                var tagOn = row.TagId == attTag.Id;
                                                <button type="button" class="tag-chip @(tagOn ? "tag-chip-on" : "")"
                                                        @onclick="() => SetAttachedTag(row.Id, tagOn ? null : attTag.Id)">
                                                    @TagMark(attTag.Icon)@attTag.Name
                                                </button>
                                            }
                                        </div>
                                    }
                                </li>
                            }
                        </ul>
                        @if (string.IsNullOrWhiteSpace(_attachSearch) && State.AllExpensesCount > attachable.Count)
                        {
                            <small class="hint">@string.Format(Loc["Showing the most recent {0} of {1}. Search to reach anything older."], attachable.Count, State.AllExpensesCount)</small>
                        }
                    }
                    <div class="modal-actions">
                        <button @onclick="Back">@Loc["Done"]</button>
                    </div>
                    break;

                case Modal.DeleteTrip:
                    <h3>@Loc["Delete this trip?"]</h3>
                    <p>@string.Format(Loc["“{0}” will be removed. The expenses stay exactly where they are — they just stop being counted as part of a trip."], State.TripName(_tripId))</p>
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                        <button class="danger" @onclick="RemoveTripConfirmed">@Loc["Delete"]</button>
                    </div>
                    break;

                case Modal.AddSaving:
                    <h3>@Loc["Add to savings"]</h3>
                    var saveBuckets = State.SavingBuckets.Where(b => !b.Bucket.IsArchived).ToList();
                    @if (saveBuckets.Count > 1)
                    {
                        <label>@Loc["Bucket"]
                            <select @bind="_savingBucketId">
                                @foreach (var (bucket, _) in saveBuckets)
                                {
                                    <option value="@bucket.Id">@bucket.Name</option>
                                }
                            </select>
                        </label>
                    }
                    else
                    {
                        <p class="hint">@State.SavingBucketName(_savingBucketId)</p>
                    }
                    <label>@Loc["Amount"] <DecimalInput @bind-Value="_savingAmount" /></label>
                    @* A figure to read became an amount to take. The old line reported cash "not already set aside
                       for savings", which still counted money the budgets are relying on — so it read as spare and
                       taking it was what pushed the budgets over. The chip offers what nothing else is counting on,
                       and fills the box in one tap. Absent when the answer is nothing: a €0 offer is not an offer. *@
                    @if (State.SuggestedSaving(_bankStatus?.Balance, _bankStatus?.BalanceCurrency) is { } _sugSave)
                    {
                        <div class="suggest-row">
                            <button type="button" class="suggest-chip" @onclick="() => _savingAmount = _sugSave.Amount">
                                <Icon Name="coins" /> @string.Format(Loc["Suggested {0}"], Fmt(_sugSave))
                            </button>
                            <span class="suggest-why">@Loc["what's left after your budgets"]</span>
                        </div>
                    }
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                        <button @onclick="AllocateSaving" disabled="@(_savingAmount <= 0)"><Icon Name="coins" /> @Loc["Add"]</button>
                    </div>
                    break;

                case Modal.Reallocate:
                    <h3>@Loc["Move budget to your debt"]</h3>
                    <p>@string.Format(Loc["Move {0} from your {1} budget toward {2}?"], Fmt(_reallocAmount), _reallocBudgetName, _reallocDebtName)</p>
                    <ul class="realloc-effects">
                        <li>✂️ @string.Format(Loc["{0} budget trimmed to {1}"], _reallocBudgetName, Fmt(_reallocNewBudget))</li>
                        <li>💰 @string.Format(Loc["{0} set aside toward {1}"], Fmt(_reallocAmount), _reallocDebtName)</li>
                    </ul>
                    <small class="hint">@Loc["This moves real money into your debt earmark and lowers this budget. You can change both later."]</small>
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                        <button @onclick="DoReallocate"><Icon Name="arrow-right" /> @Loc["Move it"]</button>
                    </div>
                    break;

                case Modal.Recurring:
                    <div class="modal-head">
                        <h3><Icon Name="repeat" /> @Loc["Recurring"]</h3>
                        <span class="modal-head-actions">
                            <button class="exp-edit" title="@Loc["Close"]" @onclick="Back"><Icon Name="x" /></button>
                        </span>
                    </div>
                    <p class="hint">@Loc["Bills, salary and standing transfers that repeat monthly. They remind you when due — you confirm the real amount, so bills that vary stay accurate."]</p>
                    <button class="fund-add" @onclick="OpenAddRecurring"><Icon Name="plus" /> @Loc["Add recurring"]</button>
                    @if (State.RecurringItems.Count == 0)
                    {
                        <p class="hint">@Loc["Nothing recurring yet. Add your rent, salary or a monthly bill."]</p>
                    }
                    else
                    {
                        @* ★ O5: two sections, because the list is read as two questions — "what is still coming?"
                           and "what has already gone through?" — and it used to render in raw storage order, which
                           answers neither. Soonest first above (an overdue item has a negative gap, so it leads),
                           most recent first below. Android sorted but never sectioned; it does now too. *@
                        RenderFragment<RecurringItem> recRow = r =>
                        @<li>
                            @{
                                var rid = r.Id;
                                var amountText = r.AmountMode == RecurringAmountMode.ReminderOnly
                                    ? Loc["reminder only"]
                                    : (r.AmountMode == RecurringAmountMode.Typical ? "~" : "") + Fmt(r.ExpectedAmount);
                            }
                            <span class="row-main">
                                <span class="cat-ico">@IconOrEmoji(r.Icon ?? (r.Kind == RecurringKind.Income ? "note" : "repeat"))</span> @r.Name
                                <span class="row-note">· @amountText · @Loc["day"] @r.DayOfMonth@(r.AutoPost ? " · ⚡" + @Loc["auto"] : "")@(r.Active ? "" : " · " + @Loc["paused"])@(State.RecurringStartsLater(r) ? " · " + @Loc["starts next period"] : "")</span>
                                @if (r.LinkedDebtBucketId is { } rdebt)
                                {
                                    <span class="inst-tag" title="@Loc["Each payment will be split into interest and principal rows against that loan, instead of one lump expense."]">🧾 @State.SavingBucketName(rdebt)</span>
                                }
                            </span>
                            <span class="row-actions">
                                <button class="exp-edit" title="@Loc["Edit"]" @onclick="() => OpenEditRecurring(rid)"><Icon Name="pencil" /></button>
                                <button class="exp-edit" title="@Loc["Remove"]" @onclick="() => ConfirmRemoveRecurring(rid)"><Icon Name="trash" /></button>
                            </span>
                        </li>;
                        var (recComing, recPast) = State.RecurringSections();
                        @if (recComing.Count > 0)
                        {
                            <h4 class="detail-sub">@Loc["Coming up"] <span class="pm-hint">· @recComing.Count</span></h4>
                            <ul class="list">@foreach (var r in recComing) { @recRow(r) }</ul>
                        }
                        @if (recPast.Count > 0)
                        {
                            <h4 class="detail-sub">@Loc["Already this period"] <span class="pm-hint">· @recPast.Count</span></h4>
                            <ul class="list">@foreach (var r in recPast) { @recRow(r) }</ul>
                        }
                    }
                    break;

                case Modal.RecurringEdit:
                    <h3>@(_recEditId == Guid.Empty ? Loc["Add recurring"] : Loc["Edit recurring"])</h3>
                    <div class="plan-toggle" role="group">
                        <button type="button" class="chip @(_recKind == RecurringKind.Expense ? "on" : "")" @onclick="() => SetRecurringKind(RecurringKind.Expense)"><Icon Name="note" /> @Loc["Bill"]</button>
                        <button type="button" class="chip @(_recKind == RecurringKind.Income ? "on" : "")" @onclick="() => SetRecurringKind(RecurringKind.Income)"><Icon Name="coins" /> @Loc["Income"]</button>
                    </div>
                    <label>@Loc["Name"] <input type="text" @bind="_recName" placeholder="@(_recKind == RecurringKind.Income ? "Salary" : "Rent")" /></label>
                    <label>@Loc["Category"]
                        <select @bind="_recCategoryId">
                            @if (_recKind == RecurringKind.Income)
                            {
                                @foreach (var c in State.ContributionCategories) { <option value="@c.Id">@c.Name</option> }
                            }
                            else
                            {
                                @foreach (var (cat, depth) in State.CategoryOptions) { <option value="@cat.Id">@CatOption(cat.Id, cat.Name, depth)</option> }
                            }
                        </select>
                    </label>
                    <label>@Loc["Fund"]
                        <select @bind="_recFundId">
                            @foreach (var f in State.SelectableFunds) { <option value="@f.Id">@f.Name</option> }
                        </select>
                    </label>
                    <label>@Loc["Amount"]</label>
                    <div class="plan-toggle" role="group">
                        <button type="button" class="chip @(_recMode == RecurringAmountMode.Fixed ? "on" : "")" @onclick="() => _recMode = RecurringAmountMode.Fixed">@Loc["Fixed"]</button>
                        <button type="button" class="chip @(_recMode == RecurringAmountMode.Typical ? "on" : "")" @onclick="() => _recMode = RecurringAmountMode.Typical">@Loc["Typical"]</button>
                        <button type="button" class="chip @(_recMode == RecurringAmountMode.ReminderOnly ? "on" : "")" @onclick="() => _recMode = RecurringAmountMode.ReminderOnly">@Loc["Reminder only"]</button>
                    </div>
                    @if (_recMode != RecurringAmountMode.ReminderOnly)
                    {
                        <label>@(_recMode == RecurringAmountMode.Typical ? Loc["Typical amount"] : Loc["Amount"]) <DecimalInput @bind-Value="_recAmount" /></label>
                        <small class="hint">@(_recMode == RecurringAmountMode.Typical ? Loc["An estimate that self-tunes toward what you actually pay."] : Loc["The same amount every month."])</small>
                    }
                    else
                    {
                        <small class="hint">@Loc["No amount — you'll enter the real figure each time it's due (good for a variable salary)."]</small>
                    }
                    @* One due date, not two. A loan's installment day is a contractual fact, so when the linked debt
                       states one it takes over the field rather than sitting beside it disagreeing — which is what
                       used to happen (the debt row saying "due on the 30th" over a bill set to day 15). With no day
                       on the loan, the bill's own day fills it in on save. *@
                    var _recLoanDay = State.LoanDueDayFor(_recDebtId == Guid.Empty ? null : _recDebtId);
                    @if (_recLoanDay is { } _rld)
                    {
                        <div class="modal-field">
                            <span>@Loc["Day of month"]</span>
                            <p class="hint"><Icon Name="card" /> @string.Format(Loc["The {0} — taken from the loan's installment day. Change it on the loan to move both."], _rld)</p>
                        </div>
                    }
                    else
                    {
                        <label>@Loc["Day of month"] <input type="number" step="1" min="1" max="31" @bind="_recDay" /></label>
                    }
                    @if (_recMode == RecurringAmountMode.Fixed)
                    {
                        <Switch @bind-Value="_recAutoPost">@Loc["Post automatically when due (don't ask me)"]</Switch>
                    }
                    @* A bill can service a loan. Only offered for expenses, and only when there's a debt to point at. *@
                    @if (_recKind == RecurringKind.Expense && State.LinkableDebts.Count > 0)
                    {
                        <label>@Loc["This is a loan installment for"]
                            <select @bind="_recDebtId">
                                <option value="@Guid.Empty">@Loc["Not a loan payment"]</option>
                                @foreach (var d in State.LinkableDebts)
                                {
                                    <option value="@d.Id">@d.Name</option>
                                }
                            </select>
                        </label>
                        @if (_recDebtId != Guid.Empty)
                        {
                            <small class="hint">@Loc["Each payment will be split into interest and principal rows against that loan, instead of one lump expense."]</small>
                            @* Linking says "I pay this loan through this app", so the loan switches onto logged
                               payments on save. Announced rather than done silently — it changes what moves the
                               balance. It only fires on the transition into a link, so a user who later sets the
                               loan back to its own schedule keeps that choice. *@
                            var _recLinkSwitches = State.LinkingWouldSwitchLoanToPaymentDriven(_recDebtId, _recEditId == Guid.Empty ? null : State.RecurringItems.FirstOrDefault(x => x.Id == _recEditId)?.LinkedDebtBucketId);
                            @if (_recLinkSwitches)
                            {
                                <small class="hint"><Icon Name="note" /> @Loc["Saving this will also switch that loan's balance onto the payments you log, since you're telling us you pay it from here. What's owed today is kept exactly as it is; only what moves it from now on changes — and you can set it back on the loan."]</small>
                            }
                            else if (!State.SavingBucketDebtPaymentDriven(_recDebtId))
                            {
                                <small class="hint">@Loc["That loan's balance follows its own schedule by your choice, so confirming this bill will log the payment but won't move the balance. Change it on the loan under “What moves the balance”."]</small>
                            }
                            @* ★ The bill can be bigger than the loan, and the gap is usually not an overpayment —
                               a bank commonly bundles health or property insurance into the same direct debit. So
                               it gets its own ledger line under its own category rather than being credited to a
                               loan it never touched. Leaving this on "extra payment onto the loan" keeps exactly
                               what happened before this existed, which is why the null state is written as a
                               CHOICE: the option says what it does, so nobody has to read silence as an omission.
                               Offered whenever the loan states an installment, including while the amount is
                               under it — a field that appears and disappears as a number is typed reads as a bug,
                               and the amount can be raised at confirm time anyway. *@
                            var _recInst = State.SavingBucketDebtInstallment(_recDebtId);
                            @if (_recInst > 0m)
                            {
                                <label>@Loc["Anything above the installment is"]
                                    <select @bind="_recExcessCatId">
                                        <option value="@Guid.Empty">@Loc["Extra payment onto the loan"]</option>
                                        @foreach (var (cat, depth) in State.CategoryOptions) { <option value="@cat.Id">@CatOption(cat.Id, cat.Name, depth)</option> }
                                    </select>
                                </label>
                                @if (_recExcessCatId != Guid.Empty)
                                {
                                    <label>@Loc["Call it (optional)"] <input type="text" maxlength="40" @bind="_recExcessLabel" placeholder="@Loc["Insurance"]" /></label>
                                }
                                @* The live sentence, read off the same rule the post uses, so it cannot promise a
                                   split that doesn't happen. *@
                                <small class="hint">
                                    @(_recAmount > _recInst && _recExcessCatId != Guid.Empty
                                        ? string.Format(Loc["{0} of this {1} will be filed as {2}; {3} services the loan."],
                                            Fmt(State.Money(_recAmount - _recInst)), Fmt(State.Money(_recAmount)),
                                            string.IsNullOrWhiteSpace(_recExcessLabel) ? State.CategoryName(_recExcessCatId) : _recExcessLabel!, Fmt(State.Money(_recInst)))
                                      : _recAmount > _recInst
                                        ? string.Format(Loc["{0} of this {1} is above the {2} installment and goes onto the loan as extra payment. Name a category if it's something else."],
                                            Fmt(State.Money(_recAmount - _recInst)), Fmt(State.Money(_recAmount)), Fmt(State.Money(_recInst)))
                                        : string.Format(Loc["This is at or under the {0} installment, so all of it goes onto the loan."], Fmt(State.Money(_recInst))))
                                </small>
                            }
                        }
                    }
                    <div class="modal-actions">
                        <button class="ghost" @onclick="() => _modal = Modal.Recurring">@Loc["Cancel"]</button>
                        <button @onclick="SaveRecurring" disabled="@(string.IsNullOrWhiteSpace(_recName))">@Loc["Save"]</button>
                    </div>
                    break;

                case Modal.RecurringConfirm:
                    var rc = State.RecurringItems.FirstOrDefault(x => x.Id == _recConfirmId);
                    <h3>@(rc?.Kind == RecurringKind.Income ? Loc["Confirm income"] : Loc["Confirm bill"])@(rc is null ? "" : " — " + rc.Name)</h3>
                    @if (rc is not null)
                    {
                        <p class="hint">@(rc.AmountMode == RecurringAmountMode.ReminderOnly
                            ? Loc["Enter what actually came in or went out."]
                            : string.Format(Loc["Expected about {0}. Adjust to the real amount if it differs."], Fmt(rc.ExpectedAmount)))</p>
                    }
                    <label>@Loc["Actual amount"] <DecimalInput @bind-Value="_recConfirmAmount" /></label>
                    @* What this amount is about to become, before it becomes it. Read off State.RecurringExcessOn,
                       which is the domain's own rule — the preview and the post cannot disagree. *@
                    @if (rc is not null && State.RecurringExcessOn(rc, _recConfirmAmount) is var rcExcess && rcExcess > 0m)
                    {
                        <small class="hint"><Icon Name="card" /> @string.Format(Loc["{0} onto the loan · {1} as {2}"],
                            Fmt(State.Money(_recConfirmAmount - rcExcess)), Fmt(State.Money(rcExcess)),
                            string.IsNullOrWhiteSpace(rc.ExcessLabel) ? State.CategoryName(rc.ExcessCategoryId!.Value) : rc.ExcessLabel!)</small>
                    }
                    <div class="modal-actions">
                        <button class="ghost" @onclick="DoSkipRecurring">@Loc["Skip this month"]</button>
                        <button @onclick="DoConfirmRecurring" disabled="@(_recConfirmAmount <= 0)">@Loc["Confirm"]</button>
                    </div>
                    break;

                case Modal.AddOrImport:
                    <h3><Icon Name="plus" /> @Loc["Add a transaction"]</h3>
                    <p class="hint">@Loc["Record a single entry, or import many at once from a bank statement (expenses and income)."]</p>
                    <button class="qa-choice" @onclick="OpenAddExpenseTab"><Icon Name="receipt" /> <span><strong>@Loc["Log an expense"]</strong><small>@Loc["Enter one spend by hand."]</small></span></button>
                    <button class="qa-choice" @onclick="OpenImport"><Icon Name="import" /> <span><strong>@Loc["Import statement"] <ProLock Feature="@PlanFeatures.Import" Static="true" /></strong><small>@Loc["Bring in many from a bank file."]</small></span></button>
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Close"]</button>
                    </div>
                    break;

                case Modal.Import:
                    <h3><Icon Name="import" /> @Loc["Import statement"]</h3>
                    @if (_importError is not null)
                    {
                        <div class="alert warn-bg"><span>@_importError</span></div>
                    }
                    @if (_importStep == ImportStep.Upload)
                    {
                        <p class="hint">@Loc["Parsed on your device — nothing is sent until you confirm the rows."]</p>
                        <div class="fmt-chips" aria-label="@Loc["Supported formats"]">
                            <span class="fmt-chip">Excel</span>
                            <span class="fmt-chip">CSV</span>
                            <span class="fmt-chip">XML</span>
                            <span class="fmt-chip">OFX</span>
                            <span class="fmt-chip">QIF</span>
                        </div>
                        <label class="file-drop">
                            <span class="file-drop-ic"><Icon Name="import" /></span>
                            <span class="file-drop-main">@Loc["Choose a file"]</span>
                            <span class="file-drop-sub">@Loc["or drop it here"]</span>
                            <InputFile class="file-drop-input" OnChange="OnImportFileSelected" accept=".xlsx,.xlsm,.xls,.htm,.html,.csv,.tsv,.txt,.xml,.camt,.ofx,.qfx,.qif" />
                        </label>
                        <p class="hint import-tip"><Icon Name="info" /> @Loc["Only a PDF? Use your bank's \"export transactions\" — it usually offers Excel or CSV too."]</p>
                        <div class="modal-actions"><button class="ghost" @onclick="Back">@Loc["Cancel"]</button></div>
                    }
                    else if (_importStep == ImportStep.MapCsv)
                    {
                        <p class="hint">@Loc["Tell us which columns to use."]</p>
                        <label>@Loc["Date"] <select @bind="_csvDate">@foreach (var (h, i) in _csvHeaders.Select((h, i) => (h, i))) { <option value="@i">@h</option> }</select></label>
                        <label>@Loc["Description"] <select @bind="_csvDesc">@foreach (var (h, i) in _csvHeaders.Select((h, i) => (h, i))) { <option value="@i">@h</option> }</select></label>
                        @if (CsvHasSplit)
                        {
                            <label>@Loc["Money out (debit)"] <select @bind="_csvDebit">@foreach (var (h, i) in _csvHeaders.Select((h, i) => (h, i))) { <option value="@i">@h</option> }</select></label>
                            <label>@Loc["Money in (credit)"] <select @bind="_csvCredit">@foreach (var (h, i) in _csvHeaders.Select((h, i) => (h, i))) { <option value="@i">@h</option> }</select></label>
                        }
                        else
                        {
                            <label>@Loc["Amount"] <select @bind="_csvAmount">@foreach (var (h, i) in _csvHeaders.Select((h, i) => (h, i))) { <option value="@i">@h</option> }</select></label>
                            <small class="hint">@Loc["Money out is negative, money in positive."]</small>
                        }
                        <div class="modal-actions">
                            <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                            <button @onclick="ApplyCsvMapping">@Loc["Preview"] →</button>
                        </div>
                    }
                    else
                    {
                        var incl = _importRows.Count(r => r.Include);
                        <p class="hint">@string.Format(Loc["{0} of {1} rows will import into this period. Uncheck anything you don't want."], incl, _importRows.Count)@(_importSkipped > 0 ? " " + string.Format(Loc["({0} dated outside this period were skipped.)"], _importSkipped) : "")</p>
                        <label>@Loc["Fund"] <select @bind="_importFund">@foreach (var f in State.SelectableFunds) { <option value="@f.Id">@f.Name</option> }</select></label>
                        <div class="import-head">
                            <button type="button" class="link" @onclick="() => SetAllImport(true)">@Loc["Select all"]</button>
                            <span>·</span>
                            <button type="button" class="link" @onclick="() => SetAllImport(false)">@Loc["Deselect all"]</button>
                            <span class="import-head-hint"><Icon Name="pin" /> @Loc["pin a merchant to auto-file it (and similar names) here next time"]</span>
                        </div>
                        <ul class="list import-list">
                            @foreach (var imp in _importRows)
                            {
                                var r = imp;
                                var pinned = r.Tx.Amount < 0m && MappingFor(r.Tx.Description) is { Kind: "category" };
                                <li>
                                    <span class="row-lead">
                                        <Switch @bind-Value="r.Include" />
                                        <span class="import-when">@r.Tx.Date.ToString("dd MMM")</span>
                                        <span class="import-desc">@(string.IsNullOrWhiteSpace(r.Tx.Description) ? Loc["(no description)"] : r.Tx.Description)</span>
                                    </span>
                                    <span class="row-ops">
                                        @if (r.Duplicate) { <span class="row-note" title="@Loc["Looks already logged"]"><Icon Name="alert" Class="ic-s" /></span> }
                                        <select @bind="r.CategoryId">
                                            @if (r.Tx.Amount < 0m)
                                            {
                                                @foreach (var (cat, depth) in State.CategoryOptions) { <option value="@cat.Id">@CatOption(cat.Id, cat.Name, depth)</option> }
                                            }
                                            else
                                            {
                                                @foreach (var cc in State.ContributionCategories) { <option value="@cc.Id">@cc.Name</option> }
                                            }
                                        </select>
                                        @if (r.Tx.Amount < 0m && !string.IsNullOrWhiteSpace(r.Tx.Description))
                                        {
                                            <button type="button" class="icon-btn pin @(pinned ? "on" : "")" title="@(pinned ? Loc["Auto-files this merchant here — click to forget"] : Loc["Always file this merchant here in future"])" @onclick="() => ToggleImportPin(r)"><Icon Name="pin" /></button>
                                        }
                                        <span class="amt @(r.Tx.Amount < 0m ? "" : "good-text")">@Fmt(r.Tx.Amount)</span>
                                    </span>
                                </li>
                            }
                        </ul>
                        <div class="modal-actions">
                            <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                            <button @onclick="ConfirmImport" disabled="@(incl == 0)">@string.Format(Loc["Import {0}"], incl)</button>
                        </div>
                    }
                    break;

                case Modal.ExternalAccounts:
                    <h3><Icon Name="bank" /> @Loc["External accounts"]</h3>
                    @if (Auth.CurrentUser is { EmailVerified: false })
                    {
                        <div class="alert warn-bg"><span>@Loc["Verify your email address before you can link a bank or view its data — bank connections show real financial information."]</span></div>
                        @if (_resendOk)
                        {
                            <p class="hint">✓ @Loc["Verification email sent. Check your inbox."]</p>
                        }
                        <button class="primary" @onclick="ResendVerificationFromBank" disabled="@_resendBusy">@Loc["Resend verification email"]</button>
                    }
                    else if (_bankStatus?.Enabled == true)
                    {
                        @if (!State.IsOwnerOfCurrent && _bankSharedAckKnown && !_bankSharedAck)
                        {
                            <div class="alert warn-bg">
                                <span>@Loc["This shared account shows a linked bank's real balances and transactions. Please keep it confidential; we recommend turning on two-factor authentication."]</span>
                                <button class="link" @onclick="AckBankShared" disabled="@_bankBusy">@Loc["Got it"]</button>
                            </div>
                        }
                        @if (!Auth.CurrentUser!.TwoFactorEnabled && !_2faRecDismissed)
                        {
                            <div class="alert warn-bg">
                                <span>@Loc["We strongly recommend turning on two-factor authentication (Profile → Two-factor) — this account is connected to real financial data."]</span>
                                <button class="alert-x" title="@Loc["Dismiss"]" aria-label="@Loc["Dismiss"]" @onclick="() => _2faRecDismissed = true"><span aria-hidden="true">×</span></button>
                            </div>
                        }
                        <p class="pm-who">@State.Account.Name</p>
                        @if (!_bankStatus.Connected)
                        {
                            <p class="hint">@Loc["Link your Revolut account to pull transactions in automatically."] @Loc["Each account links its own bank."]</p>
                            <button class="primary" @onclick="LinkBankAsync" disabled="@_bankBusy"><Icon Name="link" /> @Loc["Link Revolut"]</button>
                        }
                        else
                        {
                            <p class="bank-conn">
                                <span>@if (_bankStatus.InstitutionLogo is { } logo) { <img class="bank-logo-img" src="@logo" alt="" /> } else { <Icon Name="bank" /> } @_bankStatus.InstitutionName</span>
                                @if (_bankStatus.Balance is { } bal)
                                {
                                    <span class="bank-balance" title="@Loc["Live account balance"]">@Fmt(new Money(bal, _bankStatus.BalanceCurrency ?? State.Currency))</span>
                                }
                                @if (_bankStatus.LastSyncedAt is { } synced)
                                {
                                    <span class="row-note">· @Loc["last synced"] @synced.LocalDateTime.ToString("dd MMM HH:mm")</span>
                                }
                                <button class="link danger bank-disconnect" @onclick="ConfirmDisconnectBank" disabled="@_bankBusy">@Loc["Disconnect"]</button>
                            </p>
                            <p class="hint">@Loc["Map a fund to one of this bank's accounts by editing the fund and turning on sync."]</p>
                            @if (_bankStatus.ConsentExpiresAt is { } exp && exp <= DateTimeOffset.UtcNow)
                            {
                                <div class="alert warn-bg">
                                    <span>@Loc["Your bank consent has expired (banks require re-approval every 90 days)."]</span>
                                    <button class="link" @onclick="LinkBankAsync" disabled="@_bankBusy">@Loc["Reconnect"]</button>
                                </div>
                            }
                            @if (!State.HasSyncedFund)
                            {
                                <div class="alert warn-bg"><span>@Loc["Mark a fund as synced to this bank (a fund → Edit) so imports file automatically."]</span></div>
                            }
                            <p class="hint">@Loc["Imported expenses are reviewed in the Spending tab; money-in under Funds → Move money."]</p>
                        }
                        @if (_bankError is not null)
                        {
                            <div class="alert warn-bg"><span>@_bankError</span><button class="alert-x" title="@Loc["Dismiss"]" aria-label="@Loc["Dismiss"]" @onclick="() => _bankError = null"><span aria-hidden="true">×</span></button></div>
                        }
                    }
                    else
                    {
                        <p class="hint">@Loc["Connecting a bank isn't available on this account."]</p>
                    }
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Close"]</button>
                    </div>
                    break;

                case Modal.BudgetSaving:
                    <h3>@Loc["Budget savings"] — @State.SavingBucketName(_spendBucketId)</h3>
                    <label>@Loc["Destination"]
                        <select @bind="_spendDestId">
                            <optgroup label="@Loc["Budgets"]">
                                @foreach (var (cat, depth) in State.CategoryOptions)
                                {
                                    <option value="@cat.Id">@CatOption(cat.Id, cat.Name, depth)</option>
                                }
                            </optgroup>
                            @if (State.SavingBuckets.Count > 1)
                            {
                                <optgroup label="@Loc["Savings buckets"]">
                                    @foreach (var (bucket, _) in State.SavingBuckets)
                                    {
                                        @if (bucket.Id != _spendBucketId)
                                        {
                                            <option value="@bucket.Id">@bucket.Name</option>
                                        }
                                    }
                                </optgroup>
                            }
                        </select>
                    </label>
                    <label>@Loc["Amount"] <DecimalInput @bind-Value="_spendAmount" /></label>
                    <small class="hint">@Loc["A budget matures the saving into this month's plan; another bucket just shifts it across. The source bucket drops either way."]</small>
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                        <button @onclick="MoveSaving" disabled="@(_spendAmount <= 0 || _spendDestId == Guid.Empty || _spendDestId == _spendBucketId)"><Icon Name="arrow-right" /> @Loc["Move"]</button>
                    </div>
                    break;

                case Modal.SpendSaving:
                    <h3>@Loc["Spend savings"] — @State.SavingBucketName(_spendExpBucketId)</h3>
                    @* Same reason as the edit-expense modal: no <label> around a CategoryPicker. *@
                    <div class="modal-field"><span class="lbl-row">@Loc["Category"]</span>
                        <CategoryPicker @bind-Value="_spendExpCategoryId" Options="State.CategoryOptions" />
                    </div>
                    <label>@Loc["Amount"] <DecimalInput @bind-Value="_spendExpAmount" /></label>
                    <small class="hint">@Loc["Records a real expense paid straight from this bucket (dated today)."]</small>
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                        <button @onclick="SpendBucketAsExpense" disabled="@(_spendExpAmount <= 0 || _spendExpCategoryId == Guid.Empty)"><Icon Name="note" /> @Loc["Spend"]</button>
                    </div>
                    break;

                case Modal.DisburseSaving:
                    var disBucketBal = DisburseBucketBalance();
                    <h3><Icon Name="target" /> @Loc["Apply to a goal"] — @State.SavingBucketName(_disburseBucketId)</h3>
                    <label>@Loc["Amount"] <DecimalInput @bind-Value="_disburseAmount" /></label>
                    <small class="hint">@Loc["Saved in this bucket:"] <strong>@Fmt(disBucketBal)</strong></small>
                    <label>@Loc["Take the money from"]
                        <select @bind="_disburseFundId">
                            @foreach (var f in State.RootFunds)
                            {
                                <option value="@f.Id">@f.Name@(State.FundIsSynced(f.Id) ? Loc[" (synced)"] : "")</option>
                            }
                        </select>
                    </label>
                    <label>@Loc["What for? (e.g. loan prepayment)"] <input type="text" @bind="_disburseNote" /></label>
                    <small class="hint">@Loc["Money leaves that fund for this goal — it’s not counted as an expense and doesn’t dent your savings figures."]</small>
                    @* On a loan, a payment this size is a decision, not just a transfer: the same money either
                       finishes the loan sooner or lowers every remaining payment, and the two are different goods.
                       Shown live as the amount is typed — before it's committed, which is when the choice exists. *@
                    @if (LumpSumOutcome() is { } _ls)
                    {
                        <div class="paydown-preview">
                            @if (_ls.ClearsTheLoan)
                            {
                                <div class="paydown-hero"><Icon Name="trophy" /> @Loc["This clears the loan outright."]</div>
                                <div class="paydown-line">@string.Format(Loc["You avoid the {0} of interest the remaining schedule would have cost."], Fmt(State.Money(_ls.InterestSaved)))</div>
                            }
                            else
                            {
                                <div class="paydown-hero"><Icon Name="trending" /> @string.Format(Loc["Keeping your {0} installment, this saves {1} in interest."], Fmt(State.SavingBucketDebtInstallment(_disburseBucketId)), Fmt(State.Money(_ls.InterestSaved)))</div>
                                <div class="paydown-line">
                                    @string.Format(Loc["Paid off {0} instead of {1}"], PayoffDate(_ls.AfterKeepingInstallment.Months), PayoffDate(_ls.Before.Months))
                                    @if (_ls.MonthsSaved > 0) { <span class="good-text"> · @MonthsText(_ls.MonthsSaved) @Loc["sooner"]</span> }
                                </div>
                                @if (_ls.LoweredInstallment is { } _lower && _lower > 0m)
                                {
                                    @* Two different goods bought with the same money, so it is a choice rather than
                                       a note. Finishing sooner needs no write at all — it is simply what happens —
                                       which is why it was the only outcome for so long; the other re-prices the
                                       schedule, and the app can now do that instead of telling you to ask. *@
                                    <div class="paydown-choice">
                                        <label class="paydown-opt @(!_disburseKeepEndDate ? "on" : "")">
                                            <input type="radio" name="paydownmode" checked="@(!_disburseKeepEndDate)" @onchange="() => _disburseKeepEndDate = false" />
                                            <span class="paydown-opt-t">@Loc["Keep my installment"]</span>
                                            <span class="paydown-opt-s">@string.Format(Loc["Finish {0} sooner"], MonthsText(_ls.MonthsSaved))</span>
                                        </label>
                                        <label class="paydown-opt @(_disburseKeepEndDate ? "on" : "")">
                                            <input type="radio" name="paydownmode" checked="@_disburseKeepEndDate" @onchange="() => _disburseKeepEndDate = true" />
                                            <span class="paydown-opt-t">@Loc["Keep the end date"]</span>
                                            <span class="paydown-opt-s">@string.Format(Loc["Pay {0} a month instead"], Fmt(State.Money(_lower)))</span>
                                        </label>
                                    </div>
                                    @if (_disburseKeepEndDate)
                                    {
                                        <div class="paydown-alt">@Loc["We'll drop the installment here. Your lender has to agree to it too — this doesn't tell them."]</div>
                                    }
                                }
                            }
                        </div>
                    }
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                        <button @onclick="DisburseSavingFromModal" disabled="@(_disburseAmount <= 0 || _disburseAmount > disBucketBal.Amount || _disburseFundId == Guid.Empty)"><Icon Name="target" /> @Loc["Apply"]</button>
                    </div>
                    break;

                case Modal.LogInstallment:
                    @* One payment, several linked rows. The split is shown live and computed by the same code that
                       posts it (State.InstallmentSplit), so what you see here is what lands in the ledger. *@
                    var _instExtras = _instRows.Where(r => r.Amount > 0m).Sum(r => r.Amount);
                    var (_instInt, _instPrin, _) = State.InstallmentSplit(_instBucketId, _instTotal, _instExtras, _instDate);
                    var _instOver = _instExtras > _instTotal;
                    <h3><Icon Name="note" /> @Loc["Log installment"] — @State.SavingBucketName(_instBucketId)</h3>
                    <label>@Loc["Amount paid"] <DecimalInput @bind-Value="_instTotal" /></label>
                    <div class="field-row">
                        <label>@Loc["Date"] <input type="date" @bind="_instDate" /></label>
                        <label>@Loc["Paid from"]
                            <select @bind="_instFundId">
                                @foreach (var f in State.ExpensableFunds)
                                {
                                    <option value="@f.Id">@f.Name@(State.FundIsSynced(f.Id) ? Loc[" (synced)"] : "")</option>
                                }
                            </select>
                        </label>
                    </div>
                    @* The interest and principal rows share one category — they're the same budget line ("Loan"); it's
                       the auto-applied tags that split them apart in the Breakdown. *@
                    <label>@Loc["Budget category for the loan"]
                        <select @bind="_instCategoryId">
                            @foreach (var (c, depth) in State.CategoryOptions)
                            {
                                <option value="@c.Id">@(new string('—', depth))@(depth > 0 ? " " : "")@c.Name</option>
                            }
                        </select>
                    </label>

                    @* Extras first: they come off the top, and the loan split is whatever's left. *@
                    <h4>@Loc["Anything else in this payment?"]</h4>
                    @for (var i = 0; i < _instRows.Count; i++)
                    {
                        var row = _instRows[i];
                        var idx = i;
                        <div class="inst-extra-row">
                            <DecimalInput Placeholder="0.00" AriaLabel="@Loc["Amount"]" @bind-Value="row.Amount" />
                            <select aria-label="@Loc["Category"]" @bind="row.CategoryId">
                                @foreach (var (c, depth) in State.CategoryOptions)
                                {
                                    <option value="@c.Id">@(new string('—', depth))@(depth > 0 ? " " : "")@c.Name</option>
                                }
                            </select>
                            <select aria-label="@Loc["Tag"]" @bind="row.TagId">
                                <option value="@Guid.Empty">@Loc["No tag"]</option>
                                @foreach (var t in State.ActiveTags)
                                {
                                    <option value="@t.Id">@t.Name</option>
                                }
                            </select>
                            <button class="row-ico danger" title="@Loc["Remove"]" aria-label="@Loc["Remove"]" @onclick="() => _instRows.RemoveAt(idx)"><Icon Name="trash" /></button>
                        </div>
                    }
                    <button class="add-another" @onclick="AddInstallmentRow"><Icon Name="plus" /> @Loc["Add a line (insurance, tax…)"]</button>

                    @* The split read-out — the whole point of the feature. *@
                    <div class="inst-split">
                        <div class="inst-split-row"><span>@Loc["Interest"]</span><strong>@Fmt(new Money(_instInt, State.Currency))</strong></div>
                        <div class="inst-split-row"><span>@Loc["Principal"]</span><strong>@Fmt(new Money(_instPrin, State.Currency))</strong></div>
                        @if (_instExtras > 0m)
                        {
                            <div class="inst-split-row"><span>@Loc["Other lines"]</span><strong>@Fmt(new Money(_instExtras, State.Currency))</strong></div>
                        }
                    </div>
                    @if (_instOver)
                    {
                        <small class="hint warn-text">@Loc["Those lines add up to more than the payment."]</small>
                    }
                    else if (_instPrin <= 0m && _instTotal > 0m)
                    {
                        <small class="hint warn-text">@Loc["This payment doesn’t cover the interest, so it clears no principal."]</small>
                    }
                    <small class="hint">@Loc["Posts one row per part so each lands in its own budget and Breakdown slice. The whole payment is money out, counted once."]</small>
                    @* ⚠️ The split above shows a principal figure, and on a schedule-driven loan that principal does
                       NOT come off the balance here — the schedule already advanced the loan for this month, so
                       Period.LogInstallment deliberately skips RecordDebtPayment and doing both would count the month
                       twice. Said out loud because the read-out invites exactly the wrong conclusion. The recurring
                       bill's confirm has carried this warning for a while; this door had none. *@
                    @if (!State.SavingBucketDebtPaymentDriven(_instBucketId))
                    {
                        <small class="hint">@Loc["This loan's balance follows its own schedule, so logging this records the payment but doesn't move what's owed — the schedule already counts this month's installment. Change that on the loan under “What moves the balance”."]</small>
                    }
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                        <button @onclick="LogInstallmentFromModal" disabled="@(_instTotal <= 0m || _instOver || _instFundId == Guid.Empty || _instCategoryId == Guid.Empty || _instRows.Any(r => r.Amount > 0m && r.CategoryId == Guid.Empty))"><Icon Name="note" /> @Loc["Log it"]</button>
                    </div>
                    break;

                case Modal.HealthScore:
                    var hs = CurrentReport();
                    <h3><Icon Name="pulse" /> @Loc["Health score"] @infoTip(("score-how", Loc["How your score works: four equal parts (25 pts each) — how much you saved vs your target, how well you kept to budget, living within your income, and your spending vs your recent average."]))</h3>
                    @if (!hs.HasData)
                    {
                        <p class="hint"><Icon Name="chart" /> @Loc["Log some income or expenses to see your account overview here."]</p>
                    }
                    else
                    {
                        var hsBand = hs.Band switch { HealthBand.Healthy => "ok", HealthBand.Average => "warn", _ => "bad" };
                        @* Everything the score is built from — verdict, quick wins, savings rate, and the trend charts —
                           lives in one section under the single "Health score" header, rather than four stacked cards. *@
                        <section class="score-panel">
                            <div class="score-detail">
                                <div class="score-verdict score-@hsBand">@N(hs.Verdict)</div>
                                <p class="score-line">@N(hs.Summary)</p>
                                <div class="score-bar-wrap">
                                    <div class="score-bar-track">
                                        <div class="score-bar-needle" style="left:@(Math.Clamp(hs.Score, 2, 98))%"></div>
                                    </div>
                                    <div class="score-bar-labels">
                                        <span>@Loc["At risk"]</span><span>@Loc["Average"]</span><span>@Loc["Healthy"]</span>
                                    </div>
                                </div>
                            </div>

                        @if (hs.QuickWins.Count > 0)
                        {
                            <h4 class="insight-h">@Loc["Quick wins"]</h4>
                            <div class="win-list">
                                @{ var qn = 0; }
                                @foreach (var w in hs.QuickWins)
                                {
                                    qn++;
                                    <div class="win"><div class="win-bullet">@qn</div><div class="win-text">@N(w.Message)</div></div>
                                }
                            </div>
                        }

                        @* The detail graphics — savings rate and the spending trend — live here in the modal; Home keeps
                           the score header + trends-over-time sparklines so it stays light. *@
                        <h4 class="insight-h">@Loc["Savings rate"]</h4>
                        @{
                            var hsRateW = Math.Clamp((double)(hs.SavingsRate ?? 0m) * 100, 0, 100);
                            var hsGoalW = Math.Clamp((double)hs.SavingsTarget * 100, 0, 100);
                            var hsRateVal = hs.SavingsRate ?? 0m;
                            var hsRateStatus = hsRateVal >= hs.SavingsTarget ? "rate-good"
                                : hsRateVal >= hs.SavingsTarget * 0.6m ? "rate-mid" : "rate-low";
                        }
                        <section class="savings-rate-card @hsRateStatus">
                            @* The reached rate rides the scale itself (a bubble above the fill); the target already shows
                               as the goal line on the bar + the "Goal X%" footer, so the old header row (which repeated
                               reached % + Target %) is gone. *@
                            <div class="savings-scale">
                                <div class="savings-track">
                                    <div class="savings-fill" style="width:@hsRateW%"></div>
                                    <div class="savings-goal-line" style="left:@hsGoalW%"></div>
                                </div>
                                <span class="savings-pct" style="left:@(Math.Clamp(hsRateW, 6, 94).ToString(System.Globalization.CultureInfo.InvariantCulture))%">@PctOrDash(hs.SavingsRate)</span>
                            </div>
                            <div class="savings-footer">
                                <span>0%</span><span class="goal-label">@Loc["Goal"] @PctText(hs.SavingsTarget)</span><span>100%</span>
                            </div>
                            <div class="savings-critique"><Icon Name="bulb" /> @N(hs.SavingsCritique)</div>
                        </section>

                        @if (hs.Trend.Count > 1)
                        {
                            <h4 class="insight-h">@Loc["Spending trend"]</h4>
                            <section class="trend-card">
                                <div class="trend-head">
                                    <span>@Loc["Outgoings"] · @Loc["avg"] @Fmt(hs.TrendAverage)</span>
                                    <span class="trend-dir @(hs.TrendUp ? "up" : "down")">@(hs.TrendUp ? "↑" : "↓") @(hs.TrendUp ? Loc["above average"] : Loc["below average"])</span>
                                </div>
                                <div class="trend-plot">
                                    <div class="trend-avg" style="bottom:@((Math.Clamp((double)hs.TrendAvgFraction, 0, 1) * 72).ToString(System.Globalization.CultureInfo.InvariantCulture))px"></div>
                                    @foreach (var t in hs.Trend)
                                    {
                                        <div class="trend-bar @(t.IsCurrent ? "current" : "")" style="height:@(Math.Max(3.0, (double)t.BarFraction * 72).ToString(System.Globalization.CultureInfo.InvariantCulture))px" title="@t.Label: @Fmt(t.Outgoings)"></div>
                                    }
                                </div>
                                <div class="trend-labels">
                                    @foreach (var t in hs.Trend)
                                    {
                                        <span class="@(t.IsCurrent ? "cur" : "")">@t.Label</span>
                                    }
                                </div>
                                <div class="trend-note">@N(hs.TrendNote)</div>
                            </section>
                        }

                        @* The per-category trends-over-time sparklines moved to the Spending → Trends tab, so trends
                           live in one place (BACKLOG #16). The score modal stays focused on this period's verdict. *@
                        </section>
                    }
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Close"]</button>
                    </div>
                    break;

                case Modal.RunwayMath:
                {
                    // "Show the math" now lives in a modal (an inline expand shifted the whole page). Same content as
                    // before: the arithmetic behind the runway + the live what-if sliders, recomputed from the forecast.
                    var rmRw = State.IsLatestPeriod ? State.ProjectCashFlow(_balCur) : null;
                    if (rmRw is { } rw)
                    {
                        var mathTitle = rw.FirstShortfallMonth is { } msm
                            ? string.Format(Loc["At this rate, money runs short in {0}"], msm.ToString("MMM yyyy"))
                            : rw.Months[0].Income - rw.Months[0].Spending >= 0
                                ? Loc["At this rate, your balance keeps growing"]
                                : string.Format(Loc["At this rate, your balance lasts beyond {0} months"], rw.Months.Count);
                        var inBase = rw.Months[0].Income;
                        var outBase = rw.Months[0].Spending;
                        var canEarn = State.HasEarningInvestment;
                        var invEarn = State.InvestmentMonthlyEarnings;
                        // The sliders are live inputs: they nudge the money-in / money-out shown below and re-run the
                        // whole projection. Extra income of +X/month moves the balance exactly like spending −X/month.
                        var spendDelta = decimal.Round(outBase * _whatIfPct / 100m, 2);
                        var earnDelta = canEarn ? Math.Max(0m, _whatIfEarnAmt) : 0m;
                        var earnMax = Math.Max(500m, Math.Ceiling(inBase / 100m) * 100m);
                        var inM = Math.Max(0m, inBase + earnDelta);
                        var outM = Math.Max(0m, outBase + spendDelta);
                        var scenario = _whatIfPct != 0 || (canEarn && earnDelta != 0m);
                        var proj = scenario ? State.ProjectCashFlow(_balCur, spendDelta - earnDelta) : rw;
                        var inSrc = rw.Basis == CashFlowBasis.Recurring
                            ? Loc["your recurring income"]
                            : State.CompletedPeriodCount <= 1
                                ? Loc["average of your last month"]
                                : string.Format(Loc["average of your last {0} months"], State.CompletedPeriodCount);
                        <h3><Icon Name="@(rw.FirstShortfallMonth is null ? "shield" : "alert")" /> @mathTitle</h3>
                        <div class="runway-detail">
                                <div class="runway-math">
                                    <span>@Loc["Starting balance"]</span><span class="rm-num">@Fmt(_balCur)</span>
                                    <span>@Loc["Money in / month"]<span class="rm-src">@inSrc@(canEarn && earnDelta > 0m ? $" · +{Fmt(State.Money(earnDelta))}" : "")</span></span><span class="rm-num credit">+ @Fmt(State.Money(inM))</span>
                                    <span>@Loc["Money out / month"]@if (_whatIfPct != 0) { <span class="rm-src">@(_whatIfPct > 0 ? "+" : "")@(_whatIfPct)%</span> }</span><span class="rm-num debit">− @Fmt(State.Money(outM))</span>
                                    <span class="rm-net">@Loc["Net / month"]</span><span class="rm-num rm-net @(inM - outM < 0 ? "debit" : "credit")">@(inM - outM < 0 ? "− " : "+ ")@Fmt(State.Money(Math.Abs(inM - outM)))</span>
                                </div>
                                <p class="runway-basis">@Loc["Each month adds the money in and takes the money out; the runway is how long your balance stays above zero. No AI, no guesswork — just this arithmetic on your own numbers."]</p>
                                @* Pro: modelling a different future is the "intelligence" half of the paywall line.
                                   The HEADER stays visible on Free — you can see the tool exists and what it does,
                                   which is the honest version of a paywall; only the controls and their output are
                                   withheld. Same shape at the two debt planners below. *@
                                @if (Gate.Allows(PlanFeatures.Insights))
                                {
                                <div class="whatif-row">
                                    <div class="whatif">
                                        <label class="whatif-label">@Loc["What if I spent differently?"]</label>
                                        <input type="range" class="whatif-slider" min="-50" max="50" step="5" @bind:event="oninput" @bind="_whatIfPct" />
                                    </div>
                                    @if (canEarn)
                                    {
                                        <div class="whatif">
                                            <label class="whatif-label">@Loc["Additional income"] <span class="whatif-val">+@Fmt(State.Money(earnDelta))/@Loc["mo"]</span></label>
                                            <input type="range" class="whatif-slider" min="0" max="@earnMax.ToString(System.Globalization.CultureInfo.InvariantCulture)" step="25" @bind:event="oninput" @bind="_whatIfEarnAmt" />
                                            @if (invEarn > 0m)
                                            {
                                                <span class="whatif-sub">@string.Format(Loc["≈ {0}/mo from your investments"], Fmt(State.Money(invEarn)))</span>
                                            }
                                        </div>
                                    }
                                </div>
                                }
                                else
                                {
                                    <div class="whatif-row">
                                        <div class="whatif">
                                            <label class="whatif-label">@Loc["What if I spent differently?"] <ProLock Feature="@PlanFeatures.Insights" /></label>
                                            <ProLock Feature="@PlanFeatures.Insights" Bar="true" Label="@Loc["Model spending and earning changes with Pro"]" />
                                        </div>
                                    </div>
                                }
                                @* Suppressed on Free along with the sliders — "Slide to spend less or more" beside
                                   no slider would be an instruction you can't follow. *@
                                @if (Gate.Allows(PlanFeatures.Insights))
                                {
                                    <div class="whatif-out">
                                        @if (!scenario)
                                        {
                                            <span class="whatif-hint">@(canEarn ? Loc["Slide to model spending or earning and see the runway change."] : Loc["Slide to spend less or more and see the runway change."])</span>
                                        }
                                        else if (proj is { } wi)
                                        {
                                            @if (wi.FirstShortfallMonth is { } wsm)
                                            {
                                                <span class="whatif-bad">@string.Format(Loc["Runs short in {0}"], wsm.ToString("MMM yyyy"))</span>
                                            }
                                            else
                                            {
                                                <span class="whatif-good">@string.Format(Loc["Balance holds ~{0} months, ending near {1}"], wi.Months.Count, Fmt(wi.Months[^1].Closing))</span>
                                            }
                                        }
                                    </div>
                                }
                            </div>
                    }
                    else
                    {
                        <p class="hint">@Loc["No forecast to show yet."]</p>
                    }
                    <div class="modal-actions"><button class="ghost" @onclick="Back">@Loc["Close"]</button></div>
                    break;
                }

                case Modal.PayoffProjection:
                    var pjBal = State.SavingBucketDebtBalance(_projBucketId);
                    var pjRate = State.SavingBucketDebtRate(_projBucketId);
                    var pjInst = State.SavingBucketDebtInstallment(_projBucketId);
                    var pjPace = State.EffectiveSavingPace(_projBucketId);
                    var pjPlanned = false;   // planned-contribution field retired — projections always use the demonstrated pace
                    var pjExtra = _payoffExtra > 0m ? _payoffExtra : 0m;
                    var pjTotal = pjInst + pjExtra;                       // installment is always there; extra is on top
                    var pjAtInst = FinApp.Forecasting.LoanForecast.PayOff(pjBal, pjRate, pjInst);
                    var pjAtTotal = FinApp.Forecasting.LoanForecast.PayOff(pjBal, pjRate, pjTotal);
                    // What changes the moment you actually pay what's set aside: the balance drops, so you're charged
                    // less interest every period from then on.
                    var pjSetAside = State.SavingBucketSaved(_projBucketId).Amount;
                    var pjPayNow = Math.Min(pjSetAside, pjBal);
                    var pjIntNow = FinApp.Forecasting.LoanForecast.MonthlyInterest(pjBal, pjRate);
                    var pjIntAfter = FinApp.Forecasting.LoanForecast.MonthlyInterest(pjBal - pjPayNow, pjRate);
                    // The two ways a lender can apply a lump-sum overpayment. Same money, same rate — the choice is
                    // only whether the saving lands as time or as monthly headroom, so show both and let the numbers
                    // argue. Shorter term always costs less interest; lower installment buys breathing room instead.
                    var pjAfterBal = pjBal - pjPayNow;
                    var pjShorter = FinApp.Forecasting.LoanForecast.PayOff(pjAfterBal, pjRate, pjInst);
                    var pjKeepMonths = pjAtInst?.Months ?? 0;
                    var pjLowerInst = pjKeepMonths > 0
                        ? FinApp.Forecasting.LoanForecast.PaymentFor(pjAfterBal, pjRate, pjKeepMonths)
                        : null;
                    <h3><Icon Name="trending" /> @Loc["Payoff projection"] — @State.SavingBucketName(_projBucketId)</h3>
                    <div class="proj-grid">
                        <span class="proj-k">@Loc["Balance owed"]</span><span class="proj-v">@Fmt(pjBal)</span>
                        <span class="proj-k">@Loc["Set aside"]</span><span class="proj-v">@Fmt(State.SavingBucketSaved(_projBucketId))</span>
                        <span class="proj-k">@Loc["Rate"]</span><span class="proj-v">@pjRate% APR</span>
                        <span class="proj-k">@Loc["Installment"]</span><span class="proj-v">@Fmt(pjInst)/@Loc["mo"]</span>
                        @* Was its own "At your installment" section; it's really just two more facts about the loan
                           as it stands, so it belongs in the summary rather than in a heading of its own. *@
                        @if (pjAtInst is { } ai)
                        {
                            <span class="proj-k">@Loc["Ends"]</span><span class="proj-v">@PayoffDate(ai.Months) <span class="ring-muted">(@MonthsText(ai.Months))</span></span>
                            <span class="proj-k">@Loc["Total interest"]</span><span class="proj-v">@Fmt(ai.TotalInterest)</span>
                        }
                        else
                        {
                            <span class="proj-k">@Loc["Ends"]</span><span class="proj-v warn-text">@Loc["At this installment it never clears — it doesn’t cover the interest."]</span>
                        }
                    </div>
                    @if (pjPayNow > 0m && pjIntNow > 0m)
                    {
                        @* Two questions, deliberately kept apart: this one is "the money I have, once"; the next is
                           "money I'd add every month, forever". They used to read as one because the same set-aside
                           figure defaulted into both — the second then quoted an implausible per-month total. *@
                        <h4 class="detail-sub"><Icon Name="note" /> @string.Format(Loc["One-off — pay your {0} set aside now"], Fmt(pjPayNow))
                            @infoTip(("pp-partial", Loc["A payment lowers the balance right away, so the interest you're charged each period drops from then on. This is a single payment out of what you've already set aside — not a new monthly commitment."]))</h4>
                        @if (pjShorter is not null || pjLowerInst is not null)
                        {
                            <p class="hint pm-hint">@Loc["Your bank may offer a choice like:"]</p>
                            <table class="payoff-opts">
                                <thead>
                                    <tr>
                                        <th>@Loc["Their offer"]</th>
                                        <th>@Loc["Per month"]</th>
                                        <th>@Loc["Ends"]</th>
                                        <th>@Loc["Total interest"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (pjShorter is { } shorter)
                                    {
                                        <tr>
                                            <td>@Loc["Shorter term"]</td>
                                            <td>@Fmt(pjInst)</td>
                                            <td>@PayoffDate(shorter.Months)
                                                @if (pjAtInst is { } baseline && baseline.Months > shorter.Months)
                                                {
                                                    <span class="good-text">@string.Format(Loc[" ({0} sooner)"], MonthsText(baseline.Months - shorter.Months))</span>
                                                }
                                            </td>
                                            <td>@Fmt(decimal.Round(pjInst * shorter.Months - pjAfterBal, 2))</td>
                                        </tr>
                                    }
                                    @if (pjLowerInst is { } lower && pjKeepMonths > 0)
                                    {
                                        <tr>
                                            <td>@Loc["Lower installment"]</td>
                                            <td>@Fmt(lower) <span class="good-text">(−@Fmt(Math.Max(0m, pjInst - lower)))</span></td>
                                            <td>@PayoffDate(pjKeepMonths) <span class="ring-muted">@Loc["(unchanged)"]</span></td>
                                            <td>@Fmt(decimal.Round(lower * pjKeepMonths - pjAfterBal, 2))</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    }
                    <h4 class="detail-sub"><Icon Name="repeat" /> @Loc["Ongoing — add more every month"]
                        @infoTip(("pp-pace", Loc["A recurring amount you'd pay on top of the installment every month, month after month — separate from the one-off above. Starts from your recent saving pace; change it to see how paying more (or less) moves the date and interest."]))
                        <button type="button" class="info-ico reset-ico" title="@(pjPlanned ? Loc["Reset to your planned contribution"] : Loc["Reset to your saving pace"])" @onclick="() => _payoffExtra = State.EffectiveSavingPace(_projBucketId)?.Amount ?? 0m"><Icon Name="rotate" /></button>
                    </h4>
                    <label class="proj-extra">@Loc["Extra on top /mo"] <input type="number" step="10" min="0" @bind="_payoffExtra" @bind:event="oninput" /></label>
                    <p class="hint pm-hint">@string.Format(Loc["{0} installment + {1} extra = {2}/mo"], Fmt(pjInst), Fmt(pjExtra), Fmt(pjTotal))@(pjPace is { } pc && pc.Amount > 0m ? string.Format(pjPlanned ? Loc[" · your plan {0}/period"] : Loc[" · your pace ~{0}/period"], Fmt(pc)) : "")</p>
                    @if (pjAtTotal is { } ap)
                    {
                        <p class="proj-result"><Icon Name="flag" /> @string.Format(Loc["Clear in {0} (~{1}) · interest {2}"], MonthsText(ap.Months), PayoffDate(ap.Months), Fmt(ap.TotalInterest))</p>
                        @if (pjAtInst is { } bi && (bi.Months > ap.Months || bi.TotalInterest > ap.TotalInterest))
                        {
                            <p class="proj-result good-text">➡️ @string.Format(Loc["{0} sooner · {1} less interest than the installment alone"], MonthsText(bi.Months - ap.Months), Fmt(Math.Max(0m, bi.TotalInterest - ap.TotalInterest)))</p>
                        }
                    }
                    else
                    {
                        <p class="hint warn-text">@Loc["At this amount it wouldn’t cover the interest."]</p>
                    }
                    <div class="proj-disclaimer"><Icon Name="alert" /> @Loc["For planning only — these figures are estimates, not financial advice. Your lender's actual terms (fees, rate changes, payment timing) can differ. For exact numbers, please check with your loan provider."]</div>
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Close"]</button>
                    </div>
                    break;

                case Modal.GoalProjection:
                    var gpSaved = State.SavingBucketSaved(_projBucketId);
                    var gpGoal = State.FindSavingBucket(_projBucketId)?.GoalAmount;
                    var gpPace = State.EffectiveSavingPace(_projBucketId);
                    var gpPlanned = false;   // planned-contribution field retired — see pjPlanned
                    int? gpPeriods = gpPace is { } gpp && gpp.Amount > 0m && gpGoal is { } gpg && gpg > gpSaved.Amount
                        ? (int)Math.Ceiling((double)((gpg - gpSaved.Amount) / gpp.Amount)) : null;
                    <h3><Icon Name="calendar" /> @Loc["Goal projection"] — @State.SavingBucketName(_projBucketId)</h3>
                    <div class="proj-grid">
                        <span class="proj-k">@Loc["Saved so far"]</span><span class="proj-v">@Fmt(gpSaved)</span>
                        <span class="proj-k">@Loc["Goal"]</span><span class="proj-v">@(gpGoal is { } gg ? Fmt(gg) : "—")</span>
                    </div>
                    <h4 class="detail-sub">@(gpPlanned ? Loc["At your planned contribution"] : Loc["At your saving pace"]) @infoTip(("gp-pace", gpPlanned ? Loc["Uses the contribution you planned for this bucket, then counts how many periods until you reach the goal."] : Loc["Uses the average you actually set aside each period, then counts how many periods until you reach the goal."]))</h4>
                    @if (gpPace is { } gpace && gpace.Amount > 0m)
                    {
                        <p class="hint">@string.Format(gpPlanned ? Loc["You plan to set aside {0}/period."] : Loc["You set aside about {0}/period."], Fmt(gpace))</p>
                        @if (gpPeriods is { } gper)
                        {
                            <p class="proj-result"><Icon Name="flag" /> @string.Format(Loc["Reach your goal in {0} (~{1})"], MonthsText(gper), PayoffDate(gper))</p>
                        }
                        else if (gpGoal is not null)
                        {
                            <p class="proj-result good-text">✓ @Loc["Goal already reached."]</p>
                        }
                        else
                        {
                            <p class="hint">@Loc["Set a goal amount on this bucket (Edit) to see a target date."]</p>
                        }
                    }
                    else
                    {
                        <p class="hint">@Loc["Not enough history yet — set money aside a few times and we’ll project a date."]</p>
                    }
                    <small class="hint">@Loc["Projection only — it never changes your budgets, savings or balances."]</small>
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Close"]</button>
                    </div>
                    break;

                case Modal.InvestmentProjection:
                    var ivSaved = State.SavingBucketSaved(_projBucketId);
                    var ivRate = State.SavingBucketInvestmentRate(_projBucketId);
                    var ivTerm = State.SavingBucketInvestmentTermYears(_projBucketId);
                    var ivPace = State.EffectiveSavingPace(_projBucketId);
                    var ivPlanned = false;   // planned-contribution field retired — see pjPlanned
                    var ivExtra = _invExtra > 0m ? _invExtra : 0m;
                    var ivBase = State.ProjectInvestment(_projBucketId, 0m);
                    var ivWith = State.ProjectInvestment(_projBucketId, ivExtra);
                    <h3><Icon Name="trending" /> @Loc["Growth projection"] — @State.SavingBucketName(_projBucketId)</h3>
                    <div class="proj-grid">
                        <span class="proj-k">@Loc["Invested so far"]</span><span class="proj-v">@Fmt(ivSaved)</span>
                        <span class="proj-k">@Loc["Expected return"]</span><span class="proj-v">@ivRate% / @Loc["yr"]</span>
                        <span class="proj-k">@Loc["Horizon"]</span><span class="proj-v">@ivTerm.ToString("0.#") @Loc["years"]</span>
                    </div>
                    <h4 class="detail-sub">@Loc["Just what's invested now"] @infoTip(("iv-base", Loc["Grows only your current balance at the expected return over the horizon — no further contributions."]))</h4>
                    @if (ivBase is { Months: > 0 } b0)
                    {
                        <p class="proj-result"><Icon Name="flag" /> @string.Format(Loc["~{0} in {1} ({2} growth)"], Fmt(b0.FutureValue), MonthsText(b0.Months), Fmt(b0.Growth))</p>
                    }
                    else
                    {
                        <p class="hint">@Loc["Set a horizon (Edit) to project this investment's growth."]</p>
                    }
                    <h4 class="detail-sub">@Loc["Adding more each month"]
                        @infoTip(("iv-extra", Loc["Money you add on top each month. Starts from your saving pace — change it to see how investing more grows the total."]))
                        <button type="button" class="info-ico reset-ico" title="@(ivPlanned ? Loc["Reset to your planned contribution"] : Loc["Reset to your saving pace"])" @onclick="() => _invExtra = State.EffectiveSavingPace(_projBucketId)?.Amount ?? 0m"><Icon Name="rotate" /></button>
                    </h4>
                    <label class="proj-extra">@Loc["Extra /mo"] <input type="number" step="10" min="0" @bind="_invExtra" @bind:event="oninput" /></label>
                    @if (ivPace is { } ivp && ivp.Amount > 0m)
                    {
                        <p class="hint pm-hint">@string.Format(ivPlanned ? Loc["Your plan: {0}/period"] : Loc["Your pace: ~{0}/period"], Fmt(ivp))</p>
                    }
                    @if (ivWith is { Months: > 0 } bw)
                    {
                        <p class="proj-result"><Icon Name="flag" /> @string.Format(Loc["~{0} in {1} — {2} your contributions, {3} growth"], Fmt(bw.FutureValue), MonthsText(bw.Months), Fmt(bw.Contributed), Fmt(bw.Growth))</p>
                        @if (ivBase is { } b1 && bw.FutureValue > b1.FutureValue)
                        {
                            <p class="proj-result good-text">➡️ @string.Format(Loc["{0} more than leaving it alone."], Fmt(bw.FutureValue - b1.FutureValue))</p>
                        }
                    }
                    <div class="proj-disclaimer"><Icon Name="alert" /> @Loc["For planning only — returns aren't guaranteed and real investments fluctuate. This isn't financial advice."]</div>
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Close"]</button>
                    </div>
                    break;

                case Modal.EditDeposit:
                    <h3>@Loc["Edit contribution"]</h3>
                    <label>@Loc["Category"]
                        <select @bind="_editContribCategoryId">
                            @foreach (var cc in State.ContributionCategories)
                            {
                                <option value="@cc.Id">@cc.Name</option>
                            }
                        </select>
                    </label>
                    <label>@Loc["Fund"]
                        <select @bind="_editContribFundId">
                            @foreach (var f in State.SelectableFunds)
                            {
                                <option value="@f.Id">@f.Name</option>
                            }
                        </select>
                    </label>
                    <label>@Loc["Amount"] <DecimalInput @bind-Value="_editContribAmount" /></label>
                    <label>@Loc["Date"] <input type="date" @bind="_editContribDate" min="@State.Period.From.ToString("yyyy-MM-dd")" max="@State.Period.To.ToString("yyyy-MM-dd")" /></label>
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                        <button @onclick="SaveEditDeposit" disabled="@(_editContribAmount <= 0)">@Loc["Save"]</button>
                    </div>
                    break;

                case Modal.DeleteDeposit:
                    <h3>@Loc["Delete contribution?"]</h3>
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                        <button class="danger-btn" @onclick="ConfirmDeleteDeposit">@Loc["Delete"]</button>
                    </div>
                    break;

                case Modal.ContribCat:
                    <h3>@(_contribCatId == Guid.Empty ? Loc["New contribution category"] : Loc["Rename category"])</h3>
                    <div class="name-icon-row">
                        <button type="button" class="name-icon-btn @(_iconOpen ? "open" : "")" title="@Loc["Choose an icon"]" @onclick="() => _iconOpen = !_iconOpen"><CatIcon Name="@CategoryIcons.Effective(_fIcon, _contribCatName)" /></button>
                        <label class="grow">@Loc["Name"] <input type="text" @bind="_contribCatName" /></label>
                    </div>
                    @if (_iconOpen)
                    {
                        var curContribIcon = _fIcon is null ? null : CategoryIcons.Effective(_fIcon, _contribCatName);
                        <div class="icon-grid">
                            <button type="button" class="icon-opt @(_fIcon is null ? "sel" : "")" title="@Loc["Auto (from name)"]" @onclick="@(() => { _fIcon = null; _iconOpen = false; })"><CatIcon Name="@(string.IsNullOrEmpty(_contribCatName) ? CategoryIcons.Fallback : CategoryIcons.Guess(_contribCatName))" /></button>
                            @foreach (var ic in CategoryIcons.Palette)
                            {
                                <button type="button" class="icon-opt @(curContribIcon == ic ? "sel" : "")" @onclick="@(() => { _fIcon = ic; _iconOpen = false; })"><CatIcon Name="@ic" /></button>
                            }
                        </div>
                    }
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                        <button @onclick="SaveContribCat" disabled="@(string.IsNullOrWhiteSpace(_contribCatName))">@(_contribCatId == Guid.Empty ? Loc["Add"] : Loc["Save"])</button>
                    </div>
                    break;

                case Modal.DeleteContribCat:
                    <h3>@Loc["Remove category?"]</h3>
                    @if (State.ContributionCategoryRemovalBlocker(_contribCatId) is { } ccBlocker)
                    {
                        <p class="hint">@Loc["Can’t remove —"] @ccBlocker.</p>
                        <div class="modal-actions"><button class="ghost" @onclick="Back">@Loc["Close"]</button></div>
                    }
                    else
                    {
                        <p class="hint">@Loc["This removes the category permanently."]</p>
                        <div class="modal-actions">
                            <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                            <button class="danger-btn" @onclick="ConfirmDeleteContribCat">@Loc["Remove"]</button>
                        </div>
                    }
                    break;

                case Modal.EditSavingDeposit:
                    <h3>@Loc["Edit savings deposit —"] @State.SavingBucketName(_savingDepositBucketId)</h3>
                    <label>@Loc["Amount"] <DecimalInput @bind-Value="_savingDepositAmount" /></label>
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                        <button @onclick="SaveEditSavingDeposit" disabled="@(_savingDepositAmount <= 0)">@Loc["Save"]</button>
                    </div>
                    break;

                case Modal.DeleteSavingDeposit:
                    <h3>@Loc["Remove this savings deposit?"]</h3>
                    @if (State.FindSavingDeposit(_savingDepositId) is { } sd)
                    {
                        <p class="hint">@sd.Date.ToString("dd MMM") · @State.SavingBucketName(sd.SavingCategoryId) · @Fmt(sd.Amount)</p>
                    }
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                        <button class="danger-btn" @onclick="ConfirmDeleteSavingDeposit">@Loc["Remove"]</button>
                    </div>
                    break;

                case Modal.DeleteBucket:
                    <h3>@Loc["Remove"] @State.FindSavingBucket(_modalBucketId)?.Name?</h3>
                    @if (State.SavingBucketRemovalBlocker(_modalBucketId) is {} bucketBlocker)
                    {
                        <p class="hint">@Loc["Can’t remove —"] @bucketBlocker. @Loc["Spend or move its savings first."]</p>
                        <div class="modal-actions"><button class="ghost" @onclick="Back">@Loc["Close"]</button></div>
                    }
                    else
                    {
                        <p class="hint">@Loc["This removes the empty bucket permanently."]</p>
                        <div class="modal-actions">
                            <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                            <button class="danger-btn" @onclick="ConfirmDeleteBucket">@Loc["Remove"]</button>
                        </div>
                    }
                    break;

                case Modal.AddFund:
                    <h3>@Loc["New fund"]</h3>
                    <div class="name-icon-row">
                        @iconButton
                        <label class="grow">@Loc["Name"] <input type="text" @bind="_fName" /></label>
                    </div>
                    @iconGrid
                    <label>@Loc["Note (optional)"] <input type="text" @bind="_fundNote" /></label>
                    <label>@Loc["Opening balance this period (optional)"] <input type="text" inputmode="text" @bind:get="_openingAmount.ToString(System.Globalization.CultureInfo.InvariantCulture)" @bind:set="v => _openingAmount = EvalSum(v)" /></label>
                    @* ★ The currency belongs at CREATION, not only in Edit. A holiday wallet is made for the trip —
                       "new wallet, Lisbon cash, GBP" is one thought — and making someone save it first and then
                       reopen it to say what it holds is asking the same question in two sittings.
                       Defaults to the account's currency, which is what almost every wallet is, so the ordinary
                       case is untouched: leave it alone and nothing about the wallet changes. *@
                    <h4 class="modal-sec">@Loc["Foreign cash"]</h4>
                    @if (!Gate.Allows(PlanFeatures.Trips))
                    {
                        <ProLock Feature="@PlanFeatures.Trips" Bar="true" Label="@Loc["Hold a wallet in another currency — with Pro"]" />
                    }
                    else
                    {
                        <div class="row2">
                            <div class="modal-field"><span class="lbl-row">@Loc["Currency"]</span>
                                <CurrencyPicker @bind-Value="_fundCurrency" AccountCurrency="@State.Currency" />
                            </div>
                            @if (!string.IsNullOrWhiteSpace(_fundCurrency))
                            {
                                <label>@string.Format(Loc["1 {0} is"], _fundCurrency!.ToUpperInvariant()) <DecimalInput T="decimal?" class="num" @bind-Value="_fundRate" placeholder="1.00" /></label>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(_fundCurrency))
                        {
                            <small class="hint">@Loc["You can leave the rate blank and let it work itself out: transfer money into this wallet and tell us what you received, and we'll take the rate from that."]</small>
                        }
                    }
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                        <button @onclick="SaveFund" disabled="@(string.IsNullOrWhiteSpace(_fName))">@Loc["Add"]</button>
                    </div>
                    break;

                case Modal.EditFund:
                    <h3><CatIcon Name="@State.FundIcon(_modalFundId)" /> @Loc["Edit"] @State.FundName(_modalFundId)</h3>
                    <div class="name-icon-row">
                        @iconButton
                        <label class="grow">@Loc["Name"] <input type="text" @bind="_fName" /></label>
                    </div>
                    @iconGrid
                    <label>@Loc["Note (optional)"] <input type="text" @bind="_fundNote" /></label>
                    @if (!_fSynced)
                    {
                        <label>@Loc["Opening balance this period"] <input type="text" inputmode="text" @bind:get="_openingAmount.ToString(System.Globalization.CultureInfo.InvariantCulture)" @bind:set="v => _openingAmount = EvalSum(v)" /></label>
                    }
                    @* Funds-6: only offer syncing when there's an unsynced bank account to attach — i.e. this fund is
                       already the synced one (so you can unsync), or nothing is synced yet. Hidden when another fund
                       already owns the bank link. *@
                    @if (_bankStatus?.Connected == true && (State.FundIsSynced(_modalFundId) || !State.HasSyncedFund))
                    {
                        <Switch @bind-Value="_fSynced">@string.Format(Loc["Sync this fund with {0}"], _bankStatus.InstitutionName)</Switch>
                        @if (_fSynced)
                        {
                            <label>@Loc["Bank account"]
                                <select @bind="_fBankAccountRef">
                                    @if (_bankAccounts.Count == 0)
                                    {
                                        <option value="@(_bankStatus.AccountRef ?? "")">@Loc["Loading…"]</option>
                                    }
                                    @foreach (var a in _bankAccounts)
                                    {
                                        <option value="@a.Ref">@a.Label@(a.Balance is { } b ? $" · {Fmt(new Money(b, a.Currency ?? State.Currency))}" : "")</option>
                                    }
                                </select>
                            </label>
                            <small class="hint">@Loc["Bank imports post here, and its balance mirrors the real account — expenses, transfers and deposits won’t change it (only affects entries created from now on)."]</small>
                        }
                    }
                    else if (_bankStatus?.Enabled == true)
                    {
                        <small class="hint">@Loc["Link a bank first (Money → Bank sync) to sync a fund with it."]</small>
                    }
                    @* ★ Where the exchange rate lives now (S101). A wallet of foreign cash IS the rate: you bought a
                       specific pile of notes at a specific price, and everything spent out of it converts at that
                       price. Money you pay by card never comes through here — it leaves the bank fund, which holds
                       account-currency money, and the bank has already done the conversion.
                       ⚠️ This replaced a rate on the TRIP, which converted card payments too and inflated every one
                       of them. Do not put a rate back on the journey. *@
                    <h4 class="modal-sec">@Loc["Foreign cash"]</h4>
                    @if (!Gate.Allows(PlanFeatures.Trips))
                    {
                        <ProLock Feature="@PlanFeatures.Trips" Bar="true" Label="@Loc["Hold a wallet in another currency — with Pro"]" />
                    }
                    else
                    {
                        @* A real dropdown, not a <datalist>: see CurrencyPicker for why the native one had to go
                           (unstyleable, and unreliable-to-invisible on mobile). *@
                        <div class="row2">
                            <div class="modal-field"><span class="lbl-row">@Loc["Currency"]</span>
                                <CurrencyPicker @bind-Value="_fundCurrency" AccountCurrency="@State.Currency" />
                            </div>
                            <label>@(string.IsNullOrWhiteSpace(_fundCurrency) ? Loc["Rate"] : string.Format(Loc["1 {0} is"], _fundCurrency!.ToUpperInvariant())) <DecimalInput T="decimal?" class="num" @bind-Value="_fundRate" placeholder="1.00" /></label>
                        </div>
                        <small class="hint">
                            @(string.IsNullOrWhiteSpace(_fundCurrency)
                                ? Loc["Leave this empty for an ordinary wallet. Set it for a pile of foreign cash — a holiday wallet — and everything you spend from it converts at the rate you bought it at."]
                                : string.Format(Loc["Amounts spent from this wallet are typed in {0} and stored in {1}. Card payments don't come through here — they leave your bank, already converted."], _fundCurrency!.ToUpperInvariant(), State.Currency))
                        </small>
                    }
                    var fundRules = FundRulesFor(_modalFundId).ToList();
                    @if (fundRules.Count > 0)
                    {
                        <h4 class="detail-sub">@Loc["Auto money-in rules"]</h4>
                        <small class="hint">@Loc["Imported money-in from these merchants is auto-filed as a transfer from this fund. Unmapping only stops future auto-filing."]</small>
                        <ul class="list">
                            @foreach (var key in fundRules)
                            {
                                @BankRuleRow((key, "fund", "bank"))
                            }
                        </ul>
                    }
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                        <button @onclick="SaveFundGated" disabled="@(string.IsNullOrWhiteSpace(_fName))">@Loc["Save"]</button>
                    </div>
                    break;

                case Modal.DeleteFund:
                    <h3>@Loc["Remove"] @State.FundName(_modalFundId)?</h3>
                    @if (State.FundRemovalBlocker(_modalFundId) is {} fundBlocker)
                    {
                        <p class="hint">@Loc["Can’t remove —"] @fundBlocker.</p>
                        <div class="modal-actions"><button class="ghost" @onclick="Back">@Loc["Close"]</button></div>
                    }
                    else
                    {
                        @if (State.FundHasOpeningBalance(_modalFundId))
                        {
                            <p class="hint">@Loc["This fund has an opening balance. Move it to another fund, or remove it as-is (the balance is dropped)."]</p>
                            <label>@Loc["Move balance to"]
                                <select @bind="_moveBalanceToId">
                                    <option value="@Guid.Empty">@Loc["— don’t move —"]</option>
                                    @foreach (var f in State.RootFunds.Where(f => f.Id != _modalFundId))
                                    {
                                        <option value="@f.Id">@f.Name</option>
                                    }
                                </select>
                            </label>
                        }
                        else
                        {
                            <p class="hint">@Loc["This removes the fund permanently."]</p>
                        }
                        <div class="modal-actions">
                            <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                            <button class="danger-btn" @onclick="ConfirmDeleteFund">@Loc["Remove"]</button>
                        </div>
                    }
                    break;

                case Modal.ArchiveFund:
                    <h3><Icon Name="archive" /> @Loc["Archive"] @State.FundName(_modalFundId)</h3>
                    var _arcBal = State.FundBalance(_modalFundId);
                    var _arcFx = State.Account.FindFund(_modalFundId) is { HasRate: true } af ? af : null;
                    @if (_arcBal.Amount > 0m)
                    {
                        <p class="hint">@string.Format(Loc["This fund still holds {0}. Move it to another fund before archiving — its history stays intact and you can restore it anytime."], Fmt(_arcBal))</p>
                        <label>@Loc["Move balance to"]
                            <select @bind="_moveBalanceToId">
                                <option value="@Guid.Empty">@Loc["— choose a fund —"]</option>
                                @foreach (var f in State.RootFunds.Where(f => f.Id != _modalFundId && !State.FundIsSynced(f.Id)))
                                {
                                    <option value="@f.Id">@f.Name</option>
                                }
                            </select>
                        </label>
                        @* ★ Coming home with foreign cash left over is the interesting case, and it must not be
                           fudged. The ledger says this wallet holds €35.10 because that is what the notes cost at
                           the rate you bought them. Change them back and you will not get €35.10 — the rate has
                           moved and the office takes its cut. The difference is a REAL gain or loss and has to
                           land somewhere honest, not vanish into a rounding line.
                           Defaulted to the book value, so someone who spent the wallet down to nothing or doesn't
                           care simply presses Archive and nothing is invented. *@
                        @if (_arcFx is { } arcFx)
                        {
                            <label>@Loc["What you actually got back"] <DecimalInput T="decimal?" @bind-Value="_arcGotBack" placeholder="@Fmt(_arcBal)" /></label>
                            <small class="hint">
                                @string.Format(Loc["At {0}'s rate the {1} left is worth {2}. Change it back at a different rate and the difference is a real gain or loss — tell us what you got and we'll book it."],
                                    arcFx.Name,
                                    arcFx.Rate is { } rr && rr > 0m ? $"{decimal.Round(_arcBal.Amount / rr, 2)} {arcFx.Currency}" : arcFx.Currency,
                                    Fmt(_arcBal))
                            </small>
                            @if (_arcGotBack is { } got && got > 0m && got != _arcBal.Amount)
                            {
                                var diff = got - _arcBal.Amount;
                                <small class="hint @(diff < 0 ? "warn-text" : "good-text")">
                                    @string.Format(diff < 0 ? Loc["{0} exchange loss — logged as an expense."] : Loc["{0} exchange gain — logged as money in."], Fmt(State.Money(Math.Abs(diff))))
                                </small>
                            }
                        }
                    }
                    else
                    {
                        <p class="hint">@Loc["Archiving hides this fund but keeps all of its history. You can restore it anytime."]</p>
                    }
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                        <button class="danger-btn" @onclick="ConfirmArchiveFund" disabled="@(_arcBal.Amount > 0m && _moveBalanceToId == Guid.Empty)"><Icon Name="archive" /> @Loc["Archive"]</button>
                    </div>
                    break;

                case Modal.FundMovements:
                    <h3>@if (State.FundIsSynced(_modalFundId)) { <span class="fund-row-ico"><Icon Name="link" /></span> } else { <CatIcon Name="@State.FundIcon(_modalFundId)" /> } @State.FundName(_modalFundId)</h3>
                    var _fmBal = State.FundIsSynced(_modalFundId) ? SyncedFundDisplay(_modalFundId).Amount : State.FundBalance(_modalFundId);
                    var _fmEarmarks = FundEarmarks(_modalFundId);
                    var _fmEarmarked = _fmEarmarks.Aggregate(State.Money(0), (s, e) => s + e.Total);
                    var _fmMoves = FundMovements(_modalFundId);
                    <div class="fund-move-summary">
                        <span>@Loc["In this fund"]</span><strong class="amt">@Fmt(_fmBal)</strong>
                    </div>
                    @if (State.FundNote(_modalFundId) is { Length: > 0 } _fmNote)
                    {
                        <p class="hint">@_fmNote</p>
                    }
                    @if (_fmEarmarks.Count > 0)
                    {
                        <h4 class="detail-sub">@Loc["Earmarked here"]</h4>
                        <small class="hint">@string.Format(Loc["{0} of this fund is set aside for savings buckets — {1} is free."], Fmt(_fmEarmarked), Fmt(_fmBal - _fmEarmarked))</small>
                        <ul class="list">
                            @foreach (var (bucket, total) in _fmEarmarks)
                            {
                                <li><span class="row-main"><CatIcon Name="@State.SavingBucketIcon(bucket.Id)" /> @bucket.Name</span><span class="amt">@Fmt(total)</span></li>
                            }
                        </ul>
                    }
                    <h4 class="detail-sub">@Loc["This period"]</h4>
                    @if (_fmMoves.Count == 0)
                    {
                        <p class="hint">@Loc["No movements in or out this period."]</p>
                    }
                    else
                    {
                        <ul class="list list-even">
                            @foreach (var m in _fmMoves)
                            {
                                <li>
                                    <span class="row-main row-stack">
                                        <span class="row-title"><span class="row-title-txt">@m.Label</span></span>
                                        <span class="row-sub"><span>@m.Date.ToString("dd MMM")</span></span>
                                    </span>
                                    <span class="amt @(m.In ? "credit" : "debit")">@(m.In ? "+" : "−")@Fmt(m.Amount)</span>
                                </li>
                            }
                        </ul>
                    }
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Close"]</button>
                    </div>
                    break;

                case Modal.EditTransfer:
                    <h3>@Loc["Edit transfer"]</h3>
                    @* A synced (bank) side mirrors the real account — it can't be reassigned, so show it read-only. *@
                    @if (State.FindFundTransfer(_editTransferId) is { FromSynced: true })
                    {
                        <label>@Loc["From"] <input type="text" value="@State.FundName(_editTransferFromId) 🏦" disabled /></label>
                    }
                    else
                    {
                        <label>@Loc["From"]
                            <select @bind="_editTransferFromId">
                                @foreach (var f in State.SelectableFunds)
                                {
                                    <option value="@f.Id">@f.Name</option>
                                }
                            </select>
                        </label>
                    }
                    @if (State.FindFundTransfer(_editTransferId) is { ToSynced: true })
                    {
                        <label>@Loc["To"] <input type="text" value="@State.FundName(_editTransferToId) 🏦" disabled /></label>
                    }
                    else
                    {
                        <label>@Loc["To"]
                            <select @bind="_editTransferToId">
                                @foreach (var f in State.SelectableFunds)
                                {
                                    <option value="@f.Id">@f.Name</option>
                                }
                            </select>
                        </label>
                    }
                    <label>@Loc["Amount"] <DecimalInput @bind-Value="_editTransferAmount" /></label>
                    <label>@Loc["Note (optional)"] <input type="text" @bind="_editTransferNote" /></label>
                    @if (State.FindFundTransfer(_editTransferId) is { AutoFiled: true } autoTr)
                    {
                        @if (!string.IsNullOrEmpty(autoTr.Note) && MappingFor(autoTr.Note!) is { Kind: "fund" })
                        {
                            <p class="hint"><Icon Name="bank" /> @Loc["Auto-filed from a saved money-in rule:"] <strong>@autoTr.Note</strong> → <strong>@State.FundName(autoTr.FromFundId)</strong></p>
                            <ul class="list">@BankRuleRow((BudgetingState.BankMatchKey(autoTr.Note!), "fund", "bank"))</ul>
                        }
                        else
                        {
                            <p class="hint"><Icon Name="bank" /> @Loc["Filed automatically from your bank."]</p>
                        }
                    }
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                        <button @onclick="SaveEditTransfer" disabled="@(_editTransferAmount <= 0 || _editTransferFromId == _editTransferToId)">@Loc["Save"]</button>
                    </div>
                    break;

                case Modal.DeleteTransfer:
                    <h3>@Loc["Remove this transfer?"]</h3>
                    @if (State.FindFundTransfer(_editTransferId) is { } tr)
                    {
                        <p class="hint">@tr.Date.ToString("dd MMM") · @State.FundName(tr.FromFundId) → @State.FundName(tr.ToFundId) · @Fmt(tr.Amount)</p>
                    }
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                        <button class="danger-btn" @onclick="ConfirmDeleteTransfer">@Loc["Remove"]</button>
                    </div>
                    break;

                case Modal.EditPeriod:
                    <h3>@Loc["Edit period dates"]</h3>
                    <label>@Loc["From"] <input type="date" @bind="_periodFrom" /></label>
                    <label>@Loc["To"] <input type="date" @bind="_periodTo" /></label>
                    <p class="hint">@Loc["Later periods shift to stay contiguous, keeping their own lengths."]</p>
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                        <button @onclick="SaveEditPeriod" disabled="@(_periodTo < _periodFrom)">@Loc["Save"]</button>
                    </div>
                    break;

                case Modal.EditSavingMovement:
                    <h3>@Loc["Edit savings movement"]</h3>
                    @if (State.FindSavingMovement(_savingMovementId) is { } mv)
                    {
                        <p class="hint">@State.SavingMovementTarget(mv)</p>
                    }
                    <label>@Loc["Amount"] <DecimalInput @bind-Value="_savingMovementAmount" /></label>
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                        <button @onclick="SaveEditSavingMovement" disabled="@(_savingMovementAmount <= 0)">@Loc["Save"]</button>
                    </div>
                    break;

                case Modal.DeleteSavingMovement:
                    <h3>@Loc["Undo this savings movement?"]</h3>
                    @if (State.FindSavingMovement(_savingMovementId) is { } mvd)
                    {
                        <p class="hint">@mvd.Date.ToString("dd MMM") · @State.SavingMovementTarget(mvd) · @Fmt(-mvd.Amount.Amount). @(mvd.BudgetCategoryId is not null ? "The funded budget is reduced by this amount." : "Both buckets are restored.")</p>
                    }
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                        <button class="danger-btn" @onclick="ConfirmDeleteSavingMovement">@Loc["Undo"]</button>
                    </div>
                    break;

                case Modal.EditAccountTransfer:
                    @* Both halves are edited as one movement, so the modal says which account is on the other end
                       and what will follow the change there. The destination fund is deliberately NOT offered: it's
                       the other account's business, and the server keeps whatever fund the deposit already sits in. *@
                    <h3>@Loc["Edit transfer"]</h3>
                    @if (State.FindExternalTransfer(_extTransferId) is { } aet)
                    {
                        <p class="hint">@State.FundName(aet.FundId) → <strong>@State.AccountName(aet.ToAccountId ?? Guid.Empty)</strong></p>
                        <label>@Loc["Amount"] <DecimalInput @bind-Value="_extAmount" /></label>
                        <label>@Loc["Date"] <input type="date" @bind="_extDate" /></label>
                        <label>@Loc["From fund"]
                            <select @bind="_extFundId">
                                @foreach (var f in State.SelectableFunds)
                                {
                                    <option value="@f.Id">@f.Name</option>
                                }
                            </select>
                        </label>
                        <label>@Loc["Note (optional)"] <input type="text" @bind="_extNote" /></label>
                        @* The same optional budget the create modal offers — but this is the only way to name one on a
                           transfer that already exists, which until now meant deleting and re-entering it to fix a
                           missed category. Not a <label>: it would trap the picker's clicks and pin the menu open. *@
                        <div class="modal-field">
                            <span class="lbl-row">@Loc["Count against a budget"] <small class="hint">@Loc["optional"]</small>
                                <button type="button" class="lbl-add" title="@Loc["Add category"]" @onclick="EditTransferAddCategory">+</button></span>
                            <CategoryPicker @bind-Value="_extCategoryId" Options="State.CategoryOptions"
                                            AllowNone="true" NoneLabel="@Loc["Not budgeted"]" />
                        </div>
                        @* Only true of a linked transfer. An unlinked one has no deposit to update, and promising to
                           update one would be the second untrue thing this modal said about that case. *@
                        @if (State.IsLinkedAccountTransfer(aet))
                        {
                            <small class="hint">@string.Format(Loc["The deposit this created in {0} is updated to match."], State.AccountName(aet.ToAccountId ?? Guid.Empty))</small>
                        }
                        else
                        {
                            <small class="hint">@Loc["This transfer has no linked counterpart, so only this side changes."]</small>
                        }
                    }
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                        <button @onclick="SaveAccountTransfer" disabled="@(_extAmount <= 0)">@Loc["Save"]</button>
                    </div>
                    break;

                case Modal.DeleteAccountTransfer:
                    <h3>@Loc["Remove this transfer?"]</h3>
                    @if (State.FindExternalTransfer(_extTransferId) is { } adt)
                    {
                        <p class="hint">@adt.Date.ToString("dd MMM") · @State.FundName(adt.FundId) → @State.AccountName(adt.ToAccountId ?? Guid.Empty) · @Fmt(adt.Amount)</p>
                        <p class="hint">@string.Format(Loc["Both sides go: this outflow and the matching deposit in {0}."], State.AccountName(adt.ToAccountId ?? Guid.Empty))</p>
                    }
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                        <button class="danger-btn" @onclick="ConfirmDeleteAccountTransfer">@Loc["Remove"]</button>
                    </div>
                    break;

                case Modal.DeleteExternalTransfer:
                    <h3>@Loc["Remove this outgoing transfer?"]</h3>
                    @if (State.FindExternalTransfer(_extTransferId) is { } et)
                    {
                        <p class="hint">@et.Date.ToString("dd MMM") · @State.FundName(et.FundId) → @State.AccountName(et.ToAccountId ?? Guid.Empty) · @Fmt(et.Amount)</p>
                    }
                    <p class="hint warn-text">This only removes the outflow on this side. It does not reverse the deposit already recorded in the other account.</p>
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                        <button class="danger-btn" @onclick="ConfirmDeleteExternalTransfer">@Loc["Remove"]</button>
                    </div>
                    break;
            }
        </div>
    </div>
}
}

