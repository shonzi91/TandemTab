    private Task SaveAddCat() => RunModal(async () =>
    {
        if (string.IsNullOrWhiteSpace(_fName)) return;
        var newId = await State.AddCategory(_fName!, _addParentId, _fIcon, _fEssential);
        if (_fBudget > 0)
            await State.SaveBudget(newId, _fBudget, 80, false);
        var after = _afterCreate; _afterCreate = null;
        Back();
        after?.Invoke(newId);
    });

    // ★ Zero is a budget, not "no budget". Guarding on `> 0` (as this did) silently discarded the save and left the
    // old cap in place — the one figure a user is most likely to want on a category they've decided to stop spending
    // in. Only a NEGATIVE amount is rejected now; "no budget at all" is a separate act (Remove budget).
    private Task SaveAddBudget() => RunModal(async () =>
    {
        if (_budgetCatId == Guid.Empty || _fBudget < 0) return;
        await State.SaveBudget(_budgetCatId, _fBudget, 80, false);
        CloseModal();
    });

    private Task SaveEditCat() => RunModal(async () =>
    {
        if (string.IsNullOrWhiteSpace(_fName)) return;
        await State.EditCategory(_modalCatId, _fName!, _fIcon);
        await State.SetCategoryEssential(_modalCatId, _fEssential);
        // 0 saves when there's already a budget to change (a deliberate "cap this at nothing"); on a category with
        // no budget it stays a no-op, so opening Edit and pressing Save doesn't mint a 0 budget nobody asked for.
        if (_fBudget > 0 || State.HasBudget(_modalCatId))
            await State.SaveBudget(_modalCatId, _fBudget, _fThreshold, _fNotify);
        CloseModal();
    });

