    private DateOnly ClampToPeriod(DateOnly d) =>
        d < State.Period.From ? State.Period.From : d > State.Period.To ? State.Period.To : d;

    private void OnChanged()
    {
        ResetPickers();
        // Account switched (e.g. via the account switcher) → refresh the per-account bank connection. Swap straight to
        // the NEW account's last-known bank figures (cached, or null if never loaded) so the previous account's values
        // can't bleed onto it AND there's no blank flash while the network call runs — then refresh in the background.
        // Claim the account id up front so a repeat OnChanged before the reload finishes can't re-fire it.
        if (_bankStatus is not null && _bankAccountId != State.CurrentAccountId)
        {
            _bankAccountId = State.CurrentAccountId;
            _bankStatus = _bankStatusByAccount.GetValueOrDefault(_bankAccountId);
            _ = ReloadBankOnAccountChangeAsync();
        }
        InvokeAsync(StateHasChanged);
    }

    private async Task ReloadBankOnAccountChangeAsync()
    {
        await LoadBankAsync();
        if (_modal == Modal.ExternalAccounts && _bankStatus?.Enabled != true) _modal = Modal.None;   // vanished for this account
        await SyncOnOpenAsync();   // opening/switching to this account fetches fresh transactions (throttled)
        await InvokeAsync(StateHasChanged);
    }
    private void OnLocChanged() => InvokeAsync(StateHasChanged);

    // --- Expenses day view -----------------------------------------------
    private void GoToDay(DateOnly d)
    {
        if (d < State.Period.From) d = State.Period.From;
        else if (d > State.Period.To) d = State.Period.To;
        _dayView = d;
        _expenseDate = d;
    }

    private void PrevDay() { if (_dayView is { } d && d > State.Period.From) GoToDay(d.AddDays(-1)); }
    private void NextDay() { if (_dayView is { } d && d < State.Period.To) GoToDay(d.AddDays(1)); }

    // --- Expenses calendar (month grid) ----------------------------------
    /// <summary>Every day shown in the calendar — the period's range padded out to whole Mon–Sun weeks.</summary>
    private IEnumerable<DateOnly> CalendarDays()
    {
        var from = State.Period.From;
        var to = State.Period.To;
        var start = from.AddDays(-(((int)from.DayOfWeek + 6) % 7));      // back to Monday of the first week
        var end = to.AddDays(6 - (((int)to.DayOfWeek + 6) % 7));         // forward to Sunday of the last week
        for (var d = start; d <= end; d = d.AddDays(1)) yield return d;
    }

    private void ShowDayList() { _calendar = false; _dayView = null; } // grouped all-dates list
    private void ShowCalendarView() => _calendar = true;
    private void OpenDayFromCalendar(DateOnly d) { _calendar = false; GoToDay(d); }

    /// <summary>Open the add-expense modal pre-dated to a specific calendar day.</summary>
    private void OpenAddExpenseOn(DateOnly d)
    {
        _categoryId = State.AllCategories.FirstOrDefault()?.Id ?? Guid.Empty;
        _amount = 0; _note = null;
        _expenseDate = ClampToPeriod(d);
        _fundId = State.SelectableFunds.FirstOrDefault()?.Id ?? Guid.Empty;
        _modal = Modal.AddExpense;
    }

    private void ResetPickers()
    {
        if (!State.IsReady || !State.HasAccounts) return;
        // Keep the focused day across saves (feature 6) — only re-clamp it into the current period's range.
        if (_dayView is { } dv) _dayView = ClampToPeriod(dv);
        _categoryId = State.AllCategories.FirstOrDefault()?.Id ?? Guid.Empty;
        _savingBucketId = State.SavingBuckets.FirstOrDefault().Bucket?.Id ?? Guid.Empty;
        _spendBucketId = _savingBucketId;
        _spendDestId = _categoryId;
        _spendExpBucketId = _savingBucketId;
        _spendExpCategoryId = _categoryId;
        _fundId = State.SelectableFunds.FirstOrDefault()?.Id ?? Guid.Empty;
        _depCategoryId = State.ContributionCategories.FirstOrDefault()?.Id ?? Guid.Empty;
        _depFundId = _fundId;
        _depDate = DateOnly.FromDateTime(DateTime.Today);
        _transferFromId = _fundId;
        _transferDestId = State.RootFunds.Skip(1).FirstOrDefault()?.Id
            ?? State.TransferableAccounts.FirstOrDefault()?.Id ?? Guid.Empty;
        if (State.TransferableAccounts.Any(a => a.Id == _transferDestId))
            _ = OnInlineDestChanged();   // preload the destination account's funds for the picker (feature 4)
        else
            _transferDestFundId = Guid.Empty;
    }

    private async Task Run(Func<Task> action)
    {
        if (_busy) return;                 // ignore re-entrant clicks while a save is already in flight
        _error = null;
        _busy = true;
        StateHasChanged();                 // paint the "Saving…" state before the (networked) round-trip
        await Task.Yield();
        try { await action(); }
        catch (Exception ex) { _error = Describe(ex); }
        finally { _busy = false; }
    }

    /// <summary>Like <see cref="Run"/>, but routes failures to the open modal (<c>_modalError</c>) so the
    /// validation message shows inside the popup and the modal stays open instead of closing.</summary>
    private async Task RunModal(Func<Task> action)
    {
        if (_busy) return;
        _modalError = null;
        _busy = true;
        StateHasChanged();
        await Task.Yield();
        try { await action(); }
        catch (Exception ex) { _modalError = Describe(ex); }
        finally { _busy = false; }
    }

    /// <summary>Turn an exception into a message a person can act on (instead of raw .NET text).</summary>
    private static string Describe(Exception ex) => ex switch
    {
        ApiException { Status: System.Net.HttpStatusCode.Conflict } =>
            "Someone else updated this account just now. Reload and try again.",
        ApiException { Status: System.Net.HttpStatusCode.Unauthorized } =>
            "Your session has expired — please sign out and back in.",
        ApiException api => api.Message,
        HttpRequestException => "Couldn’t reach the server. Check your connection and try again.",
        _ => ex.Message,
    };

    private Task OnAccountChange(ChangeEventArgs e) => Run(async () =>
    {
        if (Guid.TryParse(e.Value?.ToString(), out var id)) await State.SwitchAccount(id);
    });

    private Task AddExpense() => Run(async () =>
