        State.FundTransfers
            .Select(t => (t.Date, Label: $"{State.FundName(t.FromFundId)} 🏦 → {State.FundName(t.ToFundId)} 🏦", t.Amount, t.Id, IsExternal: false, t.Note, t.AutoFiled))
            .Concat(State.ExternalTransfers
                .Select(t => (t.Date, Label: $"{State.FundName(t.FundId)} 🏦 📤 {State.AccountName(t.ToAccountId ?? Guid.Empty)}", t.Amount, t.Id, IsExternal: true, t.Note, AutoFiled: false)))
            .OrderByDescending(t => t.Date)
            .ToList();

