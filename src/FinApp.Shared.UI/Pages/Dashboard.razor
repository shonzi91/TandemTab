    /// <summary>Prefill the add-expense modal from the most recent manual expense — the "repeat last" quick action (#11).</summary>
    private void RepeatLastExpense()
    {
        if (State.LastExpense is not { } e) return;
        _categoryId = e.CategoryId;
        _amount = e.Amount.Amount;
        _note = e.Note;
        _fTagId = e.TagId; _newTagName = null; _tagFiledTo = null;
