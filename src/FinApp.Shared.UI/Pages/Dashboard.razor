    // Multi-expense: a locally-staged list of expenses the user is building; the ✓ saves them all at once. Each draft
    // is a snapshot of the editor fields at the moment "Add another expense" was pressed.
    private sealed record ExpenseDraft(Guid CategoryId, decimal Amount, Guid FundId, string? Note, DateOnly Date, List<Guid> TagIds);
    private readonly List<ExpenseDraft> _expenseDrafts = new();

    /// <summary>Park the current editor entry as a staged draft row, then clear the per-item fields (keeping
    /// category/fund/date) so the next one is quick to enter.</summary>
    private void StageCurrentExpense()
    {
        if (_amount <= 0) return;
        _expenseDrafts.Add(new ExpenseDraft(_categoryId, _amount, _fundId, _note, _expenseDate, _fTagIds.ToList()));
        _amount = 0; _note = null; _fTagIds.Clear(); _newTagName = null;
    }

    /// <summary>Pull a staged draft back into the editor to fix it (removing it from the list). If the editor already
    /// holds a valid entry, stage that first so it isn't lost.</summary>
    private void EditDraft(ExpenseDraft d)
    {
        if (_amount > 0) StageCurrentExpense();
        _expenseDrafts.Remove(d);
        _categoryId = d.CategoryId; _amount = d.Amount; _fundId = d.FundId; _note = d.Note; _expenseDate = d.Date;
        _fTagIds.Clear(); foreach (var t in d.TagIds) _fTagIds.Add(t); _newTagName = null;
    }

    private void RemoveDraft(ExpenseDraft d) => _expenseDrafts.Remove(d);

    /// <summary>Save everything: the staged drafts plus the in-progress editor entry (if it has an amount).</summary>
    private Task AddExpenseFromModal() => RunModal(async () =>
    {
        if (_amount > 0) StageCurrentExpense();
        if (_expenseDrafts.Count == 0) { CloseModal(); return; }
        var lastDate = _expenseDate;
        foreach (var d in _expenseDrafts)
        {
            await State.AddExpense(d.CategoryId, d.Amount, d.FundId, d.Note, d.Date, tagIds: d.TagIds);
            lastDate = d.Date;
        }
        _dayView = ClampToPeriod(lastDate); // keep the Expenses tab on the day just used (feature 6)
        CloseModal();
    });

