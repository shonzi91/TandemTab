    // Currency formatting. Two entry points during the Money→decimal migration (Path B, docs/DOMAIN-REMOVAL.md):
    // Fmt(decimal) formats in the account currency (the common case — the whole account is single-currency), while
    // Fmt(Money) honours the value's own currency (needed for cross-currency figures like settlement amounts). Both
    // share one core, so the rendered string is byte-identical however a figure is sourced.
    private static string FmtCurrency(decimal amount, string currency)
    {
        var symbol = currency switch { "EUR" => "€", "USD" => "$", "GBP" => "£", _ => currency + " " };
        return $"{symbol}{amount:N2}";
    }

    private string Fmt(decimal amount) => FmtCurrency(amount, State.Currency);

    private static string Fmt(Money m) => FmtCurrency(m.Amount, m.Currency);

    // Render the domain's language-independent insight messages (code + args) into the active UI language.
    private string MoneyN(decimal amount) => Fmt(new Money(amount, State.Currency));
    private string N(InsightMessage m) => InsightNarrator.Render(m, Loc, MoneyN);
    private string N(IReadOnlyList<InsightMessage> parts) => InsightNarrator.Render(parts, Loc, MoneyN);

    /// <summary>Indent a category name in a flat &lt;select&gt; so the tree shape reads (sub-categories under parents).</summary>
    private string CatOption(Guid id, string name, int depth) =>
        (depth == 0 ? "" : new string(' ', depth * 3) + "↳ ") + name;

    private static string IndentLabel(string name, int depth) =>
        depth == 0 ? name : new string(' ', depth * 3) + "↳ " + name;

    private static string PctOrDash(decimal? ratio) =>
        ratio is { } r ? $"{decimal.Round(r * 100m, 0, MidpointRounding.AwayFromZero)}%" : "—";

    /// <summary>Hue on the green→red heat ramp for total spending against total budget — the same scale the budget
    /// rings use (see ProgressRing), so the Home "Spent" tile and the Spending header colour one fact one way.
    /// Extracted rather than copied: two hand-rolled ramps would drift the moment either is tuned.</summary>
    private string SpendHeatHue()
    {
        var budgeted = State.TotalBudgeted.Amount;
        var t = budgeted > 0m ? Math.Clamp((double)(State.TotalSpent.Amount / budgeted), 0, 1) : 0d;
        var hue = 152 - t * 172;
        if (hue < 0) hue += 360;
        return hue.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);
    }

    private static string PctText(decimal ratio) =>
        $"{decimal.Round(ratio * 100m, 0, MidpointRounding.AwayFromZero)}%";

    // The colour a category's progress bar (.cbar-grad) has reached at fill pct — mirrors that gradient's stops
    // (mint to 68%, amber #ffab73 at 88%, coral at 100%) so the status ring is tinted to exactly where the bar ends.
    private static readonly (int R, int G, int B) BarMint = (0x2F, 0xB9, 0x9A);
    private static readonly (int R, int G, int B) BarAmber = (0xFF, 0xAB, 0x73);
    private static readonly (int R, int G, int B) BarCoral = (0xFF, 0x7A, 0x59);
    private static string SpendBarColorAt(double pct)
    {
        pct = Math.Clamp(pct, 0, 100);
        if (pct <= 68) return HexColor(BarMint);
        if (pct <= 88) return MixColor(BarMint, BarAmber, (pct - 68) / 20.0);
        return MixColor(BarAmber, BarCoral, (pct - 88) / 12.0);
    }
    private static string HexColor((int R, int G, int B) c) => $"#{c.R:X2}{c.G:X2}{c.B:X2}";
    private static string MixColor((int R, int G, int B) a, (int R, int G, int B) b, double t)
    {
        t = Math.Clamp(t, 0, 1);
        return $"#{(int)Math.Round(a.R + (b.R - a.R) * t):X2}{(int)Math.Round(a.G + (b.G - a.G) * t):X2}{(int)Math.Round(a.B + (b.B - a.B) * t):X2}";
    }

    // Set on dispose so the fire-and-forget on-entry bank sync can't re-render a component that's gone
    // (it outlives the page when you navigate away mid-call).
    private bool _disposed;

    public void Dispose() { _disposed = true; State.Changed -= OnChanged; Loc.Changed -= OnLocChanged; Auth.Changed -= OnLocChanged; _backRef?.Dispose(); }
