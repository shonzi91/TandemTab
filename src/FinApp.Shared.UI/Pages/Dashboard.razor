    // trip when the form opens — a default the user can clear, never a rule: the weekly shop still happens on
    // the day you fly home, and a mode that insisted otherwise would quietly corrupt the recap.
    private Guid _expTripId;

    // D1: set when the picked trip lives in ANOTHER account. Guid.Empty — the ordinary case — means one of this
    // account's own. Kept beside _expTripId rather than folded into it because a trip id alone cannot say which
    // account minted it, and every read of the pair has to agree about that.
    private Guid _expTripAccountId;

    // The other accounts' trips this form may offer. Loaded when the edit modal opens (see OpenEditExpense) and
    // empty for a single-account user, so the row simply doesn't render.
    private IReadOnlyList<BudgetingState.ForeignTripOption> _foreignTrips = [];

    /// <summary>The trip currently picked on the expense form, when there is one <b>in this account</b>. A trip in
    /// another account is deliberately not resolved here: every caller of this uses it to read this account's own
    /// trip settings (its category, its labels), none of which apply across the boundary.</summary>
    private FinApp.Domain.Budgeting.Trip? FormTrip =>
        _expTripId == Guid.Empty || _expTripAccountId != Guid.Empty ? null : State.FindTrip(_expTripId);

    /// <summary>The fund being paid from, when it holds foreign money — null for an ordinary fund, which is nearly
    /// always. This is what decides whether the Amount field converts.</summary>
    private FinApp.Domain.Funds.Fund? FormForeignFund => State.ForeignFund(_fundId);

    /// <summary>
    /// What actually gets logged: the typed figure converted at the <b>fund's</b> rate, or the typed figure itself.
    /// <para>
    /// ⛔ <b>This used to convert at the TRIP's rate, and that was a live correctness bug.</b> A trip-wide rate
    /// converts everything, including the payments your bank already converted: read €50 off your card statement on
    /// a rated trip, type 50, and the app stored €58.50. For most travellers card is the majority of the spend, so
    /// a rated trip's totals were wrong in the common case.
    /// </para>
    /// <para>
    /// The rate belongs to the money, not to the journey — see <c>Fund.Currency</c>. Card → the bank already
    /// converted, the statement is in the account currency, the bank fund carries no rate, nothing converts, and
    /// you type what the statement says. Cash from an exchange office → a specific pile of foreign notes bought at
    /// a specific rate, which is a wallet, which this app already models as a fund. Choosing the currency is
    /// choosing the wallet, a choice the user is already making on every expense.
    /// </para>
    /// <para>
    /// <b>Converting here and storing the result is unchanged and still right.</b> Every total in the app stays in
    /// one currency — budgets, safe-to-spend, the hero — and editing a rate afterwards can never rewrite what a
    /// past expense cost. That part of S99 was correct; only the thing holding the rate was wrong.
    /// </para>
    /// </summary>
    private decimal ExpenseAmountToLog(decimal typed) =>
        FormForeignFund is { } f ? f.ToAccountCurrency(typed) : typed;

    /// <summary>Trips the expense form offers: every one running now, plus anything upcoming — because the whole
    /// point is that a flight bought today belongs to next summer. Past trips are left out; attaching to one is
    /// the rarer "I forgot this" case, and that goes through the expense row's own menu.
    /// <para>★ <b>All</b> the running ones, not just <c>ActiveTrip</c>. This used to offer the single resolved
    /// winner, so with two overlapping trips the one you happened not to start later became unpickable while you
    /// were on it — found by driving the form with a real overlap.</para></summary>
    /// <para>★ Now "everything not finished" rather than running + upcoming: with trip mode opt-in, a trip whose
    /// dates have arrived but which nobody has confirmed leaving on is in neither of those lists, and it was
    /// exactly the trip you'd be logging the taxi to the airport against.</para>
    private IReadOnlyList<FinApp.Domain.Budgeting.Trip> FormTripOptions =>
        State.AllTrips.Where(t => !t.IsFinishedOn(State.TodayDate))
            .OrderBy(t => t.From).ToList();

    /// <summary>How the finished trips are ordered. Date is the default because a list of journeys is a diary
    /// first; by amount is the comparison ("what did Rome cost against Vienna?") that a diary can't answer.</summary>
    private enum TripSort { Date, Spent }
    private TripSort _tripSort = TripSort.Date;

    /// <summary>
    /// Which of the calendar's trip colours a trip wears: its position among the account's trips ordered by
    /// departure, <b>oldest first</b>, wrapped into the palette.
    /// <para>
    /// ⚠️ Ordering matters and the obvious choice is the wrong one. <c>AllTrips</c> is newest-departure-first, so
    /// indexing off it would re-colour every existing trip the moment a later one was booked. Counting from the
    /// oldest instead means a new trip only ever appends: <b>booking a future trip never changes the colour of one
    /// already on the calendar.</b> Backdating a trip still shifts the ones after it — that is the honest limit
    /// here, and it is cosmetic and rare, which is why it buys simplicity over a hash (a hash is perfectly stable
    /// but lets two trips in the same month land on the same colour, defeating the point).
    /// </para>
    /// </summary>
    private int TripColourIndex(Guid tripId)
    {
        var byDeparture = State.AllTrips.OrderBy(t => t.From).ThenBy(t => t.Id).ToList();
        for (var i = 0; i < byDeparture.Count; i++)
            if (byDeparture[i].Id == tripId) return i % CalTripColours;
        return 0;
    }

    private const int CalTripColours = 5;

    /// <summary>The finished trips — everything the sort control applies to.</summary>
    private IReadOnlyList<TripRecap> TripHistory() =>
        State.TripRecaps().Where(r => State.FindTrip(r.TripId)?.IsFinishedOn(State.TodayDate) == true).ToList();

    /// <summary>The trips list in display order: everything live or still ahead first, always by date, then the
    /// history in whichever order was asked for.
    /// <para>★ The split is the point. Sorting the whole list by size would push the trip you are ON below a
    /// bigger one from two years ago — and "what am I spending right now" is not a question the history can
    /// answer. So the sort owns the past and never touches the present.</para>
    /// <para>★ <b>The two halves run in opposite directions, because they answer opposite questions.</b> The future
    /// is read forwards — the trip you are on, then the one you leave for next — so it sorts <i>ascending</i> and the
    /// nearest departure is always at the top. The past is read backwards, most recent first. Sorting both the same
    /// way put the journey furthest away at the top of the list, above the one you were actually packing for.</para></summary>
    private IReadOnlyList<TripRecap> SortedTripRecaps()
    {
        var today = State.TodayDate;
        var all = State.TripRecaps();
        // Soonest first: an active trip (departed on or before today) naturally leads, then the next one up.
        var live = all.Where(r => State.FindTrip(r.TripId)?.IsFinishedOn(today) != true)
            .OrderBy(r => r.From).ToList();
        var past = all.Where(r => State.FindTrip(r.TripId)?.IsFinishedOn(today) == true);
        // Date order is already BuildAll's (newest departure first), so only the amount sort re-orders — with the
        // departure date breaking ties so two equal totals can't swap places between renders.
        past = _tripSort == TripSort.Spent
            ? past.OrderByDescending(r => r.Spent.Amount).ThenByDescending(r => r.From)
            : past.OrderByDescending(r => r.From);
        var shown = past.ToList();
        // Free keeps the last two finished trips — enough to answer "what did the last one cost", which is the
        // question a first trip raises. Comparing a run of journeys across years is the same argument as the
        // Breakdown's 6/12-month windows, so it reuses that entitlement rather than inventing a second one.
        // ⚠️ Nothing is deleted or unlinked: the trips are still there, still counted in every total, just not
        // listed. Downgrading can never lose data.
        if (!Gate.Allows(PlanFeatures.History) && shown.Count > FreeTripHistory)
        {
            _tripsHidden = shown.Count - FreeTripHistory;
            shown = shown.Take(FreeTripHistory).ToList();
        }
        else
        {
            _tripsHidden = 0;
        }
        return live.Concat(shown).ToList();
    }

    private const int FreeTripHistory = 2;
    private int _tripsHidden;

    /// <summary>Where one expense sits against the trip's own dates — the three-way split the recap headline is
    /// built on, said again per row so a March flight in a June list explains itself.</summary>
    private string TripWhenLabel(FinApp.Domain.Budgeting.Trip trip, DateOnly date) =>
        date < trip.From ? Loc["booked ahead"] : date > trip.To ? Loc["after getting back"] : Loc["while away"];

    /// <summary>End a running trip today. Not a delete and not an archive: everything about trip mode — the shell,
    /// Home's hero, the expense form's default — is derived from the dates, so pulling the end date to today is the
    /// entire switch. Undone by editing the date back, which is why it doesn't stop to confirm.</summary>
    /// <summary>End a running trip. "Finish" means OVER, so this is a stored fact and not just a shorter end date —
    /// the hero disappears, the shell drops the trip theme, the expense form stops defaulting to it and the card
    /// moves into the history, all from the moment it's tapped. Reversible from the finished card.</summary>
    // ⚠️ Ungated, and so are Start and Reopen below — ending a journey is the exit, and an exit is never sold.
    // See PlanFeatures.Trips: Free cannot CREATE a trip, but must be able to run one it already has to its end.
    private Task FinishTrip(Guid tripId) => Run(() => State.FinishTrip(tripId));

    /// <summary>Confirm a departure — the tap that turns trip mode on. Deliberately the only way in: see
    /// <c>Trip.StartedOn</c> for why a date arriving isn't enough.</summary>
    private Task StartTrip(Guid tripId) => Run(() => State.StartTrip(tripId));

    /// <summary>Put a finished trip back on the road (the undo for the above). Ungated for the same reason detach
    /// is: finishing pulls the end date in irreversibly, so tapping it by accident must not be a one-way door.</summary>
    private Task ReopenTrip(Guid tripId) => Run(() => State.FinishTrip(tripId, finished: false));

