    /// <summary>
    /// The one category a trip files into by default.
    /// <para>
    /// ★ <b>A trip always files into one category now</b> — the "each label files into its own everyday category"
    /// mode is gone from the form. It was the original behaviour and it does not survive contact with a real trip:
    /// you are budgeting the journey, not auditing it, and spreading a fortnight across Food / Transport / Housing
    /// means setting four budgets to describe one holiday and watching all four break at once.
    /// </para>
    /// <para>
    /// Travel-ish names win when the account has one, then entertainment/leisure — a trip is discretionary spending
    /// and that is the budget it belongs beside. Falling back to the first category is deliberate: with one category
    /// as the rule, "we found nothing to point at" must still resolve to something the user can then change, and the
    /// picker is right there in the same form.
    /// </para>
    /// </summary>
    private Guid TripCategoryGuess()
    {
        string[] names =
        [
            "travel", "trips", "trip", "holiday", "holidays", "vacation", "пътуване", "пътувания", "почивка",
            "entertainment", "leisure", "fun", "going out", "развлечения", "забавления", "свободно време",
        ];
        var cats = State.CategoryOptions.Select(c => c.Category).ToList();
        // Ordered by the list, not by the account: a category named "Travel" beats one named "Entertainment"
        // whatever order the account happens to hold them in.
        foreach (var n in names)
            if (cats.FirstOrDefault(c => string.Equals(c.Name, n, StringComparison.CurrentCultureIgnoreCase)) is { } hit)
                return hit.Id;
        return cats.FirstOrDefault()?.Id ?? Guid.Empty;
    }

