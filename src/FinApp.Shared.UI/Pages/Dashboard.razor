    // SVG donut: turn the slices into arc <path> d-strings over a 0–100 sweep. Returns (Slice, PathD) pairs.
    private static string DonutArc(double startPct, double sweepPct, double cx, double cy, double rOuter, double rInner)
    {
        double A(double pct) => (pct / 100.0) * 2 * Math.PI - Math.PI / 2;   // 0% at 12 o'clock, clockwise
        var a0 = A(startPct); var a1 = A(startPct + sweepPct);
        var large = sweepPct > 50 ? 1 : 0;
        double x(double a, double r) => cx + r * Math.Cos(a);
        double y(double a, double r) => cy + r * Math.Sin(a);
        var ci = System.Globalization.CultureInfo.InvariantCulture;
        return string.Format(ci,
            "M {0:0.##} {1:0.##} A {2:0.##} {2:0.##} 0 {3} 1 {4:0.##} {5:0.##} L {6:0.##} {7:0.##} A {8:0.##} {8:0.##} 0 {3} 0 {9:0.##} {10:0.##} Z",
            x(a0, rOuter), y(a0, rOuter), rOuter, large, x(a1, rOuter), y(a1, rOuter),
            x(a1, rInner), y(a1, rInner), rInner, x(a0, rInner), y(a0, rInner));
    }

    /// <summary>A coordinate for an SVG attribute. <b>Invariant, always</b> — the app runs in Bulgarian too, and a
    /// culture that writes "12,5" turns one number into two in an SVG points list, which fails silently as a line
    /// drawn somewhere else entirely.</summary>
    private static string F(double v) => v.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    /// <summary>One leader-line label around a donut: where the line touches the arc, where the badge sits, and the
    /// share it states. <see cref="By"/> is settable because the spread pass moves it — see <see cref="DonutLabels"/>.</summary>
    private sealed record DonutLabel(BreakSlice Slice, double Pct, double Ax, double Ay, double Bx, bool Right)
    {
        /// <summary>The badge's centre y. Starts on the slice's own bisector, then gets nudged clear of its neighbours.</summary>
        public double By { get; set; }
    }

    /// <summary>
    /// Lay a leader-line label around each slice of a donut — the slice's own icon on a badge in its colour, with
    /// its share beside it.
    /// <para>
    /// ★ Why it's worth the arithmetic: a legend makes the reader carry a colour from a swatch to a wedge and back
    /// again, for every row. A label attached to the wedge removes that lookup, and an icon does it without a word
    /// to read or translate. The legend below stays — it carries the money, which is what a label this size can't.
    /// </para>
    /// <para>
    /// ★★ The spread pass is what makes this usable rather than a demo. Two adjacent 4% slices have almost the same
    /// bisector, so their badges land on top of one another: the naive version looks correct on whatever data it was
    /// written against and falls apart on a real month. Labels are pushed apart down their own side to a minimum
    /// spacing, then pulled back inside the box — and only the badge moves, never the point on the arc, so a nudged
    /// label still visibly points at its own wedge.
    /// </para>
    /// <para>
    /// Slices below <paramref name="minPct"/> get no label: the badge would be wider than the wedge it points at,
    /// and they are all in the list underneath with their exact figures anyway.
    /// </para>
    /// </summary>
    private static List<DonutLabel> DonutLabels(IReadOnlyList<BreakSlice> slices, decimal total,
        double cx, double cy, double rOuter, double rBadge, double minY, double maxY, double minPct = 2.0)
    {
        var labels = new List<DonutLabel>();
        if (total <= 0m) return labels;
        double acc = 0;
        foreach (var s in slices)
        {
            var sweep = (double)(s.Amount / total) * 100.0;
            var mid = ((acc + sweep / 2) / 100.0) * 2 * Math.PI - Math.PI / 2;
            acc += sweep;
            if (sweep < minPct) continue;
            double cos = Math.Cos(mid), sin = Math.Sin(mid);
            labels.Add(new DonutLabel(s, sweep, cx + cos * (rOuter + 2), cy + sin * (rOuter + 2),
                cx + cos * rBadge, cos >= 0) { By = cy + sin * rBadge });
        }

        // Spread, per side, top to bottom. Sides are independent: a label on the left can never collide with one on
        // the right, and treating them as one list would shuffle labels across the chart to fix a clash that isn't.
        const double gap = 27;
        foreach (var isRight in new[] { true, false })
        {
            var side = labels.Where(l => l.Right == isRight).OrderBy(l => l.By).ToList();
            if (side.Count == 0) continue;
            for (var i = 1; i < side.Count; i++)
                side[i].By = Math.Max(side[i].By, side[i - 1].By + gap);
            // Pushing down can run the last one off the bottom; walk back up from a pinned bottom, then re-pin the
            // top. A side would have to hold more labels than the box has room for to still collide after that,
            // which eight slices across two sides cannot do.
            if (side[^1].By > maxY)
            {
                side[^1].By = maxY;
                for (var i = side.Count - 2; i >= 0; i--)
                    side[i].By = Math.Min(side[i].By, side[i + 1].By - gap);
            }
            if (side[0].By < minY)
            {
                side[0].By = minY;
                for (var i = 1; i < side.Count; i++)
                    side[i].By = Math.Max(side[i].By, side[i - 1].By + gap);
            }
        }
        return labels;
    }

    /// <summary>
    /// A leader label's "34%", as an SVG <c>&lt;text&gt;</c> with the sign set smaller beside the figure.
    /// <para>
    /// ⚠️ Built with the render-tree builder rather than written as markup because <b>Razor reserves
    /// <c>&lt;text&gt;</c></b> as its explicit-markup delimiter inside a code block, and rejects any attributes on
    /// it (RZ1023). The chart's centre total gets away with a plain <c>&lt;text&gt;</c> only because it sits in
    /// straight markup; anything inside a <c>@foreach</c> has to come this way. Same reason the Trends tick labels
    /// are HTML overlaid on the chart instead of SVG text.
    /// </para>
    /// </summary>
    private RenderFragment DonutPct(DonutLabel lb) => builder =>
    {
        var ci = System.Globalization.CultureInfo.InvariantCulture;
        var i = 0;
        builder.OpenElement(i++, "text");
        builder.AddAttribute(i++, "class", "brk-lbl-pct");
        // The figure takes the slice's colour so the label reads as part of the wedge rather than as another
        // number floating near the chart. Set as an attribute, which means the CSS class must NOT declare `fill`
        // or it would win outright — a presentation attribute loses to any stylesheet declaration.
        builder.AddAttribute(i++, "fill", lb.Slice.Color);
        builder.AddAttribute(i++, "x", F(lb.Bx + (lb.Right ? 15 : -15)));
        builder.AddAttribute(i++, "y", F(lb.By + 5));
        builder.AddAttribute(i++, "text-anchor", lb.Right ? "start" : "end");
        builder.AddContent(i++, lb.Pct.ToString("0", ci));
        builder.OpenElement(i++, "tspan");
        builder.AddAttribute(i++, "class", "brk-lbl-sign");
        builder.AddContent(i++, "%");
        builder.CloseElement();
        builder.CloseElement();
    };

    /// <summary>The mark that labels a slice — the same choice the legend rows make, in one place so the donut and
    /// the list underneath can never show a different icon for the same slice. Always resolves to a real sprite
    /// name: <c>CategoryIcons.Effective</c> falls back rather than returning nothing.</summary>
    private string SliceSprite(BreakSlice s) =>
        s.Key == TransfersKey ? "swap"
        : s.Key == OtherKey ? "list"
        : BreakByFund ? CategoryIcons.Effective(State.FundIcon(s.Key), s.Label)
        : CategoryIcons.Effective(s.Icon, s.Label);

    /// <summary>
    /// One search box over the Spending tab, replacing the tag-chip filter it grew out of.
    /// <para>
    /// The chips could only answer "which of my labels is this?", which is the question you can already answer by
    /// looking — the ones you cannot are "where did that 40 euros at the airport go" and "what have I spent at
    /// Lidl". A box that matches the note, the category, the wallet, the label, the trip and the amount answers all
    /// of those with the same keystrokes, and needs no chips on screen to do it.
    /// </para>
    /// Bars and totals stay unfiltered: this finds expenses, it does not re-budget the period.
    /// </summary>
    private string _spendSearch = "";

    /// <summary>
    /// Every word must match something on the row, though not all the same thing — "lidl june" finds a June expense
    /// noted Lidl. Matching the whole phrase against one field instead would fail on exactly the two-word queries
    /// people actually type.
    /// </summary>
    private bool ExpenseMatchesSearch(FinApp.Domain.Budgeting.Expense e)
    {
        if (string.IsNullOrWhiteSpace(_spendSearch)) return true;
        var ci = System.Globalization.CultureInfo.InvariantCulture;
        // The amount goes in twice: as typed with a decimal point, and as the month name of its date, so "12.5"
        // and "jun" both reach a row that carries neither as text.
        var hay = string.Join(' ',
            e.Note ?? "",
            State.CategoryName(e.CategoryId),
            State.FundName(e.FundId),
            string.Join(' ', e.TagIds.Select(State.TagName)),
            e.TripId is { } tid ? State.TripName(tid) : "",
            e.Amount.Amount.ToString("0.##", ci),
            e.Date.ToString("d MMM yyyy", ci));

        foreach (var word in _spendSearch.Split(' ', StringSplitOptions.RemoveEmptyEntries))
            if (hay.IndexOf(word, StringComparison.CurrentCultureIgnoreCase) < 0) return false;
        return true;
    }

    /// <summary>
    /// The same search over a transfer-out or a goal payout as <see cref="ExpenseMatchesSearch"/> runs over an
    /// expense — every word must appear somewhere in the row, and the haystack carries the amount and the date.
    /// <para>⚠️ These rows used to run their own one-line <c>Note.Contains(query)</c>, which broke two ways: a
    /// two-word search matched nothing at all (it looked for the whole phrase as one literal), and neither the
    /// amount, the date, the wallet, nor — since transfers gained one — the CATEGORY was searchable. Typing
    /// "rent 275" filtered the expenses and left the transfers sitting there.</para>
    /// </summary>
    private bool TransferMatchesSearch(FinApp.Domain.Funds.ExternalTransfer t, bool isPayout)
    {
        if (string.IsNullOrWhiteSpace(_spendSearch)) return true;
        var ci = System.Globalization.CultureInfo.InvariantCulture;
        var hay = string.Join(' ',
            t.Note ?? "",
            State.FundName(t.FundId),
            isPayout
                ? string.Join(' ', State.DisbursementBucketName(t.Id) ?? "", Loc["paid to goal"])
                : State.AccountName(t.ToAccountId ?? Guid.Empty),
            t.CategoryId is { } c ? State.CategoryName(c) : "",
            t.Amount.Amount.ToString("0.##", ci),
            t.Date.ToString("d MMM yyyy", ci));

        foreach (var word in _spendSearch.Split(' ', StringSplitOptions.RemoveEmptyEntries))
            if (hay.IndexOf(word, StringComparison.CurrentCultureIgnoreCase) < 0) return false;
        return true;
    }

    private List<FinApp.Domain.Budgeting.Expense> FilterByTags(IEnumerable<FinApp.Domain.Budgeting.Expense> src) =>
        string.IsNullOrWhiteSpace(_spendSearch) ? src.ToList() : src.Where(ExpenseMatchesSearch).ToList();

