    // pie was never able to do.

    // Build the slices for the current window + drill state, largest first. Amounts use the absolute expense value.
    /// <summary>Put <paramref name="slice"/> where its size says it belongs, ahead of the first slice it outranks —
    /// but never ahead of nothing, and always before the "Everything else"/"Saved" tail if it is smaller than the
    /// head. Used for the transfers slice, which has no category to be grouped with but is still money out.</summary>
    private static void InsertByAmount(List<BreakSlice> slices, BreakSlice slice)
    {
        var at = slices.FindIndex(s => s.Key != OtherKey && s.Amount < slice.Amount);
        if (at < 0) at = slices.FindIndex(s => s.Key == OtherKey);      // above "Everything else" if it beats nothing
        if (at < 0) at = slices.Count;
        slices.Insert(at, slice);
    }

    private List<BreakSlice> BreakSlices()
    {
        var (from, to) = BreakWindow();
        if (_breakDrill is { } drillId) return BreakDrillSlices(drillId);
        var expenses = State.ExpensesInRange(from, to);
        // Group key: by fund → the expense's fund; by tag → each tag id (an expense can appear under several tags);
        // otherwise → the top-level (root) category.
        var byTag = BreakByTag;
        var byFund = BreakByFund;
        var groups = new Dictionary<Guid, decimal>();
        string LabelFor(Guid k) => k == Guid.Empty ? (byTag ? Loc["Untagged"] : Loc["Uncategorised"])
            : byFund ? State.FundName(k) : byTag ? State.TagName(k) : State.CategoryName(k);
        string? IconFor(Guid k) => k == Guid.Empty ? null
            : byFund ? State.FundStoredIcon(k) : byTag ? State.TagIcon(k) : State.CategoryStoredIcon(k);

        foreach (var e in expenses)
        {
            var amt = Math.Abs(e.Amount.Amount);
            if (amt == 0) continue;
            if (byFund)
            {
                groups[e.FundId] = groups.GetValueOrDefault(e.FundId) + amt;   // which wallet the money left from
            }
            else if (byTag)
            {
                // An expense counts under each of its tags (untagged → the Empty bucket).
                var ids = State.ExpenseTags(e).Select(t => t.Id).ToList();
                if (ids.Count == 0) { groups[Guid.Empty] = groups.GetValueOrDefault(Guid.Empty) + amt; }
                else foreach (var id in ids) groups[id] = groups.GetValueOrDefault(id) + amt;
            }
            else
            {
                var root = State.RootCategoryId(e.CategoryId);
                groups[root] = groups.GetValueOrDefault(root) + amt;
            }
        }

        var ordered = groups.OrderByDescending(kv => kv.Value).ToList();
        var slices = new List<BreakSlice>();
        // Roll a long tail into "Everything else" — but only at category levels (top / drill-by-sub), where each
        // expense maps to exactly one key so the bucket is well-defined. Skipped for tags (an expense has many).
        var groupTail = ordered.Count > MaxSlices && !byTag;
        var head = groupTail ? ordered.Take(MaxSlices - 1).ToList() : ordered;
        for (var i = 0; i < head.Count; i++)
        {
            var k = head[i].Key;
            slices.Add(new BreakSlice(k, LabelFor(k), IconFor(k), head[i].Value, SliceColor(i)));
        }
        if (groupTail)
        {
            var tailSum = ordered.Skip(MaxSlices - 1).Sum(kv => kv.Value);
            slices.Add(new BreakSlice(OtherKey, Loc["Everything else"], null, tailSum, OtherColor));
        }
        // Money transferred out to other accounts is outflow too — its own standalone slice in every grouping
        // (transfers carry no category/tag/… of their own), so the donut total stays consistent across the toggles.
        // ★ RANKED IN, not appended. Appending sorted a transfer last however large it was, which for anyone who
        // moves real money between accounts meant the single biggest outflow of the period sat at the bottom of a
        // list ordered by size. It keeps its own colour (it isn't a category) but takes its rightful place.
        // Deliberately not eligible for the "Everything else" rollup: that bucket is category-only, so its
        // drill-down list stays well-defined.
        var xfer = State.AccountTransfersInRange(from, to).Sum(t => Math.Abs(t.Amount.Amount));
        if (xfer > 0m) InsertByAmount(slices, new BreakSlice(TransfersKey, Loc["Transfers out"], null, xfer, TransfersColor));
        return slices;
    }

    /// <summary>
    /// The chart drilled into one category: the same window, re-sliced by the tags used INSIDE that category, with
    /// everything untagged gathered under the category's own name.
    /// </summary>
    /// <remarks>
    /// <para>★ The untagged bucket is labelled with the <b>category</b>, not "Untagged" — that is the fallback, and
    /// it is what makes the drill safe to offer on every category. Spend nobody labelled is not a gap in the data,
    /// it is just "Food", and a slice reading "Untagged" invites people to go and fix something that isn't broken.
    /// A category with no tags at all therefore draws as a single ring of itself rather than an empty chart.</para>
    /// <para>Tags are the axis sub-categories used to be, so this is the old drill-by-sub-category — except a tag
    /// can appear in two categories, which a sub-category never could.</para>
    /// </remarks>
    private List<BreakSlice> BreakDrillSlices(Guid categoryId)
    {
        var expenses = BreakSliceExpenses(categoryId);
        var groups = new Dictionary<Guid, decimal>();
        foreach (var e in expenses)
        {
            var amt = Math.Abs(e.Amount.Amount);
            if (amt == 0) continue;
            var ids = State.ExpenseTags(e).Select(t => t.Id).ToList();
            if (ids.Count == 0) groups[Guid.Empty] = groups.GetValueOrDefault(Guid.Empty) + amt;
            else foreach (var id in ids) groups[id] = groups.GetValueOrDefault(id) + amt;
        }
        var slices = new List<BreakSlice>();
        var i = 0;
        foreach (var kv in groups.OrderByDescending(kv => kv.Value))
        {
            var label = kv.Key == Guid.Empty ? State.CategoryName(categoryId) : State.TagName(kv.Key);
            var icon = kv.Key == Guid.Empty ? State.CategoryStoredIcon(categoryId) : State.TagIcon(kv.Key);
            slices.Add(new BreakSlice(kv.Key, label, icon, kv.Value, SliceColor(i++)));
        }
        return slices;
    }

    /// <summary>Which category the Breakdown chart is drilled into, or null for the whole window.</summary>
    private Guid? _breakDrill;

    private void DrillIntoCategory(Guid categoryId)
    {
        _breakDrill = categoryId;
        // Collapse the expanded rows: they belong to the chart we just left, and an expansion carried across would
        // point at a key that means something different now (a tag id, not a category id).
        BreakCollapseAll();
    }

    // Open the Trends view. A single-period ("This period") window is a 1-point chart, so default Trends to a
    // multi-period window when arriving from it — the range chips then re-narrow as the user wishes.
    private void ShowTrends()
    {
        if (!Gate.Require(PlanFeatures.Insights)) return;   // Pro: multi-period intelligence (P4)
        _spendView = SpendView.Trends;
        if (_breakRange == BreakRange.ThisPeriod) SetBreakRange(BreakRange.M6);
    }

    // Pro: the health score + trends drill-in (P4). Its own opener so the gate lives in one place.
    private void OpenHealthScore()
    {
        if (!Gate.Require(PlanFeatures.Insights)) return;
        _modal = Modal.HealthScore;
    }

    // --- Trends (P3): money over time across periods -------------------------------------------------
    // One row per period in the shared Breakdown window, each carrying the four series the chart plots. Income /
    // spent / saved use the period's own totals (so they match the hero); balance is the ledger closing.
    // "Spent" is ALL money out (expenses + account-to-account transfers), matching the Home "Spent" tile
    // (TotalMoneyOut) and the Breakdown's "money out" — a transfer to another account left this account, so a
    // per-account "kept" that ignored it would overstate what the month actually held on to.
    /// <param name="DebtPaid">Money deployed at a loan this month. It leaves the balance like spending does, so the
    /// line dips — but nothing was consumed: the same money came off a debt. The chart marks those months rather
    /// than hiding the dip, because the cash really did go.</param>
    /// <param name="Focus">The same month narrowed to <b>one</b> category or one bucket (O14) — whichever the
    /// lower chart is currently focused on, zero when it is focused on nothing. One field rather than two because
    /// only one series is drawn at a time, and a per-series copy would be two chances to draw the wrong one.
    /// <para>⚠️ It deliberately does NOT narrow <see cref="Expenses"/> or <see cref="Saved"/>. Those feed the bar
    /// chart above, where "money in" and "kept" sit beside them — and a filtered Spent bar next to a whole-account
    /// Income bar would make Kept read as a subtraction nobody performed.</para></param>
    /// <param name="From">The period's first day. ★ The DATE, not a pre-formatted label: how a month is written
    /// depends on the window it is being drawn in (see <see cref="TrendLabel"/>), and carrying both a date and a
    /// string would be two chances for the axis and the tooltip to word the same month differently.</param>
    private sealed record TrendRow(DateOnly From, decimal Income, decimal Expenses, decimal Saved, decimal Balance,
        decimal DebtPaid = 0m, decimal Focus = 0m)
    {
        /// <summary>What the month actually kept. The chart's headline: it is the question the four-line version
        /// made people answer for themselves by eyeballing the gap between two wiggly lines, which nobody can do.</summary>
        public decimal Net => Income - Expenses;
    }

    private List<TrendRow> TrendRows()
    {
        var (from, to) = BreakWindow();
        var rows = new List<TrendRow>();
        foreach (var p in State.Account.Periods)
        {
            // "All time" = every period regardless of activity dates; the month ranges include periods that
            // overlap the window. (All can't lean on the window because it anchors on the earliest activity date,
            // which may sit inside a later period if dates were edited.)
            if (_breakRange != BreakRange.All && (p.To < from || p.From > to)) continue;
            rows.Add(new TrendRow(
                p.From,
                decimal.Round(p.ContributionsPaidTotal.Amount, 2),
                // Expenses + transfers OUT to other accounts = all money out, so "Spent"/"Kept" agree with the hero
                // and the Breakdown (both count an out-transfer as money that left; disbursements are already excluded
                // from AccountTransfersOutTotal, since a bucket payout isn't spending).
                decimal.Round(p.ExpensesTotal.Amount + p.AccountTransfersOutTotal.Amount, 2),
                decimal.Round(Math.Max(0m, p.SavingsNetTotal.Amount), 2),
                decimal.Round(p.ExpectedClosingBalance.Amount, 2),
                // Only disbursements onto a DEBT bucket. Deploying a holiday fund at a holiday is spending by
                // another route; deploying one at a loan is the balance falling because the debt did.
                decimal.Round(p.SavingAllocations
                    .Where(a => a.IsDisbursement && State.FindSavingBucket(a.SavingCategoryId) is { IsDebt: true })
                    .Sum(a => Math.Abs(a.Amount.Amount)), 2),
                TrendFocusValue(p)));
        }
        return rows;
    }

    /// <summary>
    /// One month narrowed to the focused category or bucket (O14). Zero when nothing is focused — the caller only
    /// reads it when something is.
    /// <para>★ <b>Spending counts a categorised transfer out</b>, exactly as the budget rings and the By-budgets
    /// header do since O4. If it didn't, the trend for "Food" would quietly disagree with the Food budget on the
    /// screen next door, and the reader would have no way to tell which one was lying.</para>
    /// <para>★ <b>Set aside is the bucket's NET</b> for the month, floored at zero — the same rule the account-wide
    /// "Saved" uses, so focusing one bucket narrows the question without changing it. A month in which a sinking
    /// fund paid the bill it had been filling reads as nothing set aside, not as negative saving.</para>
    /// </summary>
    private decimal TrendFocusValue(FinApp.Domain.Periods.Period p)
    {
        if (_trendSeries == TrendSeries.Spent && _trendCatId != Guid.Empty)
        {
            var spent = p.Expenses.Where(e => State.RootCategoryId(e.CategoryId) == _trendCatId)
                            .Sum(e => Math.Abs(e.Amount.Amount))
                      + p.AccountTransfersOut.Where(t => t.CategoryId is { } c && State.RootCategoryId(c) == _trendCatId)
                            .Sum(t => Math.Abs(t.Amount.Amount));
            return decimal.Round(spent, 2);
        }
        if (_trendSeries == TrendSeries.Saved && _trendBucketId != Guid.Empty)
        {
            var net = p.SavingAllocations.Where(a => a.SavingCategoryId == _trendBucketId).Sum(a => a.Amount.Amount);
            return decimal.Round(Math.Max(0m, net), 2);
        }
        return 0m;
    }

    // Which category the Spent line is narrowed to, and which bucket the Set-aside line is (O14). Empty = the whole
    // account, which is where both start and what every other figure on the screen means.
    private Guid _trendCatId;
    private Guid _trendBucketId;

    /// <summary>True when the lower chart is drawing one category or one bucket rather than the account.</summary>
    private bool TrendFocused =>
        (_trendSeries == TrendSeries.Spent && _trendCatId != Guid.Empty)
        || (_trendSeries == TrendSeries.Saved && _trendBucketId != Guid.Empty);

    /// <summary>The focused thing's name, for the heading and the empty state.</summary>
    private string TrendFocusName => _trendSeries == TrendSeries.Spent
        ? State.CategoryName(_trendCatId)
        : State.SavingBucketName(_trendBucketId);

    // ★ Two charts, not four lines on one axis. Money in / spent / net are FLOWS (what moved during a month);
    // balance is a STOCK (what was left standing at the end of it) and is routinely an order of magnitude bigger.
    // Sharing one linear axis let the balance line own the scale and flattened the three lines actually being
    // compared — and the old fix for that was asking the user to hide a series to rescale, which is a workaround
    // for a category error, not a chart. They now get an axis each, and the legend's hide-toggles are gone with
    // the problem they existed to work around.
    private const string TrendInColor = "#13a06e";
    private const string TrendOutColor = "#ff7a59";
    private const string TrendBalColor = "#4da6ff";
    // Net is drawn in whichever direction it went, so the colour IS the answer: kept money, or spent more than
    // came in. Deliberately not the "money in" green — a green net bar beside a green in bar would read as the
    // same measurement twice.
    private const string TrendNetUpColor = "#0e7c55";
    private const string TrendNetDownColor = "#dc2626";
    // Saved gets the savings violet the rest of the app uses for set-aside money, not another green: it is neither
    // income nor what was kept, and a third green bar in the same group would be unreadable.
    private const string TrendSavedColor = "#8b7fd4";

    /// <summary>
    /// Which series the lower Trends chart draws. Balance is the original and stays the default — it answers the
    /// slow question ("is the pile growing?") that the chart was built for; the other three are the same flows the
    /// bars above show, seen as a line over time rather than month by month.
    /// </summary>
    /// <summary>Whether the trip ledger is grouped by label rather than run down the days. Not per-trip: only
    /// one card is open at a time, and carrying the choice between them is the less surprising behaviour.</summary>
    private bool _tripByTag;

    /// <summary>
    /// One row of a trip's ledger, shared by both the by-date and by-category renderings so the two cannot drift
    /// into showing different things about the same expense.
    /// <para>
    /// Edit and delete act on the expense itself — the same doors the Spending ledger offers. A trip is where a
    /// mis-typed holiday total is actually noticed, and until now the only way to correct one was to go and find it
    /// in the month it was paid.
    /// </para>
    /// </summary>
    private RenderFragment TripExpRow(FinApp.Domain.Budgeting.Trip trip, FinApp.Domain.Budgeting.Expense te) => __builder =>
    {
        @* ⚠️ Names resolved through TripRowNames, not the plain lookups: a row paid from another account carries
           THAT account's category and tag ids, which resolve to "—" here. And `paidFrom` is not decoration — an
           unlabelled foreign row reads as this account's spending, the one thing a cross-account link must never
           be able to claim. *@
        var (teCat, teTag) = State.TripRowNames(trip.Id, te);
        var tePaidFrom = State.TripExpensePaidFrom(trip.Id, te.Id);
        <li class="brk-exp-row">
            <span class="brk-exp-date"><span class="brk-exp-d">@te.Date.ToString("dd")</span><span class="brk-exp-m">@te.Date.ToString("MMM")</span></span>
            <span class="brk-exp-main">
                <span class="brk-exp-title">@(string.IsNullOrEmpty(te.Note) ? teCat : te.Note)</span>
                @* The sub-line carries the trip's OWN axis (the label) when there is one, falling back to the
                   category. On a trip that files into one category the category is the same word on every row, so
                   printing it there would be a column of "Entertainment" saying nothing. *@
                <span class="brk-exp-sub">
                    @if (te.Time is { } tt)
                    {
                        <span class="brk-exp-clock">@tt.ToString("HH:mm")</span>
                    }
                    @if (teTag is { } teTagName)
                    {
                        @TagMark(te.TagId is { } tid ? State.TagIcon(tid) : null)<span>@teTagName</span>
                    }
                    else
                    {
                        <span>@teCat</span>
                    }
                    <span class="brk-exp-when">@TripWhenLabel(trip, te.Date)</span>
                    @if (tePaidFrom is { } paidFrom)
                    {
                        <span class="brk-exp-when trip-from-acct"><Icon Name="swap" /> @paidFrom</span>
                    }
                </span>
            </span>
            <span class="brk-exp-amt">@Fmt(te.Amount)@if (te.HasForeign)
                {
                    <small class="amt-fx">@CurrencyInfo.Symbol(te.ForeignCurrency)@te.ForeignAmount!.Value.ToString("0.00")</small>
                }</span>
            @* Only while the period the expense lives in is open — a trip spans months, so some of its rows are in
               closed periods the domain refuses to rewrite. Offering a control that can only fail is worse than
               offering none. *@
            @if (State.IsPeriodOpen && State.FindExpense(te.Id) is not null)
            {
                <span class="brk-exp-acts">
                    <button class="exp-edit" title="@Loc["Edit"]" aria-label="@Loc["Edit"]" @onclick="() => TripEditExpense(te.Id)"><Icon Name="pencil" /></button>
                    <button class="exp-edit" title="@Loc["Remove expense"]" aria-label="@Loc["Remove expense"]" @onclick="() => TripDeleteExpense(te.Id)"><Icon Name="trash" /></button>
                </span>
            }
        </li>
    };

    /// <summary>Editing or removing from the trip card pushes a return to the Trips tab, so closing the modal lands
    /// back on the journey rather than dumping the reader on Home.</summary>
    private void TripEditExpense(Guid id)
    {
        var back = _expandedTripId;
        _modalBack.Push(() => ShowTripsTab(back));
        OpenEditExpense(id);
        _editOpenedFromTrip = true;   // ⚠️ after, not before: OpenEditExpense clears it
    }

    private void TripDeleteExpense(Guid id)
    {
        var back = _expandedTripId;
        _modalBack.Push(() => ShowTripsTab(back));
        OpenDeleteExpense(id);
    }

    private enum TrendSeries { Balance, Spent, Saved, Kept }

    private TrendSeries _trendSeries = TrendSeries.Balance;

    /// <summary>The selector for the chosen series — one place, so the axis, the line, the fill, the points and the
    /// tooltip cannot disagree about which number is being drawn.</summary>
    private Func<TrendRow, decimal> TrendPick => _trendSeries switch
    {
        // The focus is read here and nowhere else, for the same reason this selector exists at all: the axis, the
        // line, the fill, the points and the tooltip all go through it, so they cannot disagree about whether they
        // are drawing a category or an account.
        TrendSeries.Spent => TrendFocused ? r => r.Focus : r => r.Expenses,
        TrendSeries.Saved => TrendFocused ? r => r.Focus : r => r.Saved,
        TrendSeries.Kept => r => r.Net,
        _ => r => r.Balance,
    };

    private string TrendSeriesLabel(TrendSeries s) => s switch
    {
        TrendSeries.Spent => Loc["Spent"],
        TrendSeries.Saved => Loc["Saved"],
        TrendSeries.Kept => Loc["Kept"],
        _ => Loc["Balance"],
    };

    /// <summary>The heading under the switcher — it names the same thing the buttons do, in a sentence.
    /// <para>★ When the line is narrowed (O14) it says so <b>here</b>, not only in the picker above: the heading is
    /// what a reader glancing at the chart reads, and a line labelled "Spent in each month" that is actually one
    /// category's spending is the chart telling them something untrue.</para></summary>
    private string TrendSeriesHeading() => _trendSeries switch
    {
        TrendSeries.Spent => TrendFocused
            ? string.Format(Loc["{0} spent in each month"], TrendFocusName)
            : Loc["Spent in each month"],
        TrendSeries.Saved => TrendFocused
            ? string.Format(Loc["Set aside toward {0} in each month"], TrendFocusName)
            : Loc["Set aside in each month"],
        TrendSeries.Kept => Loc["Kept at the end of each month"],
        _ => Loc["Balance at the end of each month"],
    };

    /// <summary>How one period is written on the x-axis and in the tooltip header.
    /// <para>★ The year rides along only when the window straddles one. A 12-month or All-time window used to print
    /// three columns all reading "Jan" — a chart lying about its own axis — while "Jan 24" in every slot of a
    /// three-month window is width spent restating a fact the reader already has.</para>
    /// <para>⚠️ Decided over the ROWS, not the window: <see cref="BreakRange.All"/> ignores the window entirely
    /// (see <see cref="TrendRows"/>), so asking the window would get the wrong answer on the one range where the
    /// years are most likely to differ.</para>
    /// <para>⚠️ <see cref="System.Globalization.CultureInfo.InvariantCulture"/>, so a Bulgarian reader sees "Jan"
    /// rather than "яну" — pre-existing, kept deliberately for now because month-name width differs between the
    /// two languages and the stride cap is tuned to these.</para></summary>
    private static string TrendLabel(TrendRow r, bool multiYear) =>
        r.From.ToString(multiYear ? "MMM yy" : "MMM", System.Globalization.CultureInfo.InvariantCulture);

    /// <summary>Each series keeps the colour it already wears on the bars above, so switching the line doesn't
    /// re-teach the reader what a colour means. Balance keeps its own blue.</summary>
    private string TrendSeriesColor() => _trendSeries switch
    {
        TrendSeries.Spent => TrendOutColor,
        TrendSeries.Saved => TrendSavedColor,
        TrendSeries.Kept => TrendNetUpColor,
        _ => TrendBalColor,
    };

    /// <summary>Which of the two Trends charts a readout belongs to.
    /// <para>★ They answer different questions over the same months, so each carries its own open column. Sharing
    /// one field is how hovering the LOWER chart came to pop the UPPER chart's five numbers, above the upper chart,
    /// dim the upper chart's bars — and show nothing at all on the chart the pointer was actually over. Worst
    /// exactly where it mattered most: with a category or bucket focused (O14), the focused number was the one
    /// figure missing from the screen.</para></summary>
    private enum TrendChartId { Flows, Series }

    // The period column each chart has open (index into TrendRows). Drives the dimming, the enlarged points and the
    // value tooltip. ★ Two fields rather than one keyed pair: every read site is a plain `== i` comparison the
    // compiler checks, and neither chart can leak a highlight into the other by omission — "no cross-highlight" is
    // structural here rather than a rule someone has to remember at five call sites.
    private int? _trendFlowHover;
    private int? _trendSeriesHover;

    private int? TrendHover(TrendChartId c) => c == TrendChartId.Flows ? _trendFlowHover : _trendSeriesHover;
    private void SetTrendHover(TrendChartId c, int? column)
    {
        if (c == TrendChartId.Flows) _trendFlowHover = column; else _trendSeriesHover = column;
    }

    /// <summary>
    /// ★ The readout used to be wired as <c>mouseover</c> + <c>mouseout</c> + <c>click</c> on the same rect, and on
    /// a touchscreen that combination cannot work: the browser synthesises a compatibility <c>mouseover</c>
    /// <b>before</b> the click, so mouseover opened the column and the click that followed saw it already open and
    /// toggled it straight back shut. <b>The tooltip opened and closed on the first tap</b>, every time, and it was
    /// invisible to anyone testing with a mouse. <c>mouseout</c> also never fires reliably after a tap, so one that
    /// did open could stick with no way to dismiss it.
    /// <para>Pointer events say which device is asking, so each gets the interaction it actually has: a mouse
    /// hovers, a finger taps — and tapping the same column again closes it, which is the dismissal touch was
    /// missing. One event per gesture, so nothing can toggle itself.</para>
    /// <para>⚠️ Dragging along the chart to scrub the readout is <b>not</b> implemented. Touch pointers are
    /// implicitly captured by the element the press started on, so a <c>pointermove</c> over the next column never
    /// reaches it — freeing that needs <c>releasePointerCapture</c> through JS interop plus hit-testing by
    /// coordinate, which is a bigger change than the bug being fixed here.</para>
    /// </summary>
    private static bool IsMousePointer(PointerEventArgs e) =>
        string.Equals(e.PointerType, "mouse", StringComparison.OrdinalIgnoreCase);

    private void TrendPointerEnter(PointerEventArgs e, TrendChartId chart, int column)
    {
        if (IsMousePointer(e)) SetTrendHover(chart, column);
    }

    private void TrendPointerLeave(PointerEventArgs e, TrendChartId chart)
    {
        // Touch keeps its readout until it is tapped away — there is no "moving off" a finger already lifted.
        if (IsMousePointer(e)) SetTrendHover(chart, null);
    }

    private void TrendPointerDown(PointerEventArgs e, TrendChartId chart, int column)
    {
        if (IsMousePointer(e)) return;             // the mouse already answered on enter
        // ⚠️ Toggles on THIS chart's open column. With one shared field, tapping column 3 on the lower chart while
        // column 3 was open on the upper one closed the upper one and opened nothing — a tap that made the screen
        // emptier, which reads as the control being broken rather than as a dismissal.
        SetTrendHover(chart, TrendHover(chart) == column ? null : column);
    }

    // Plot area inside the 340×152 viewBox (leaves a left gutter for the value scale + a bottom strip for months).
    private const double TrX0 = 40, TrX1 = 312, TrY0 = 12, TrY1 = 132;

    /// <summary>The Y axis: the value range the visible series occupy, snapped out to round tick numbers.</summary>
    private sealed record TrendScale(decimal Min, decimal Max, decimal[] Ticks);

    /// <summary>An axis over whatever values are handed in, snapped out to round ticks. Always includes zero:
    /// money charts that float off the baseline exaggerate small movements, and on the flows chart the zero line
    /// is what makes a negative net readable at a glance rather than merely "lower".</summary>
    private static TrendScale TrendScaleOver(IEnumerable<decimal> values)
    {
        decimal lo = 0m, hi = 0m;
        foreach (var v in values)
        {
            if (v < lo) lo = v;
            if (v > hi) hi = v;
        }
        if (hi <= lo) hi = lo + 1m;                       // a dead-flat zero series still needs a drawable span
        var step = TrendNiceStep((hi - lo) / 4m);
        var nlo = Math.Floor(lo / step) * step;
        var nhi = Math.Ceiling(hi / step) * step;
        var ticks = new List<decimal>();
        for (var t = nlo; t <= nhi + step / 2m; t += step) ticks.Add(t);
        return new TrendScale(nlo, nhi, ticks.ToArray());
    }

    /// <summary>The flows axis: money in, spent and net. Net can be negative, which is exactly the case the axis
    /// has to leave room for — a month that spent more than it earned is the one worth seeing.</summary>
    private static TrendScale TrendFlowScale(IReadOnlyList<TrendRow> rows) =>
        TrendScaleOver(rows.SelectMany(r => new[] { r.Income, r.Expenses, r.Net }));

    /// <summary>The lower chart's axis. Takes the series selector, because that chart now draws whichever of the
    /// four the user picked and each has its own range — one shared axis would flatten "saved" to a flat line
    /// beside a balance an order of magnitude bigger, which is the mistake the two-chart split exists to avoid.</summary>
    private static TrendScale TrendBalanceScale(IReadOnlyList<TrendRow> rows, Func<TrendRow, decimal> pick) =>
        TrendScaleOver(rows.Select(pick));

    // Rounds a raw step up to the next 1 / 2 / 2.5 / 5 × 10ⁿ so axis labels read as round money, not 1,237.4.
    private static decimal TrendNiceStep(decimal raw)
    {
        if (raw <= 0m) return 1m;
        var mag = (decimal)Math.Pow(10, Math.Floor(Math.Log10((double)raw)));
        var norm = raw / mag;
        var mult = norm <= 1m ? 1m : norm <= 2m ? 2m : norm <= 2.5m ? 2.5m : norm <= 5m ? 5m : 10m;
        return mult * mag;
    }

    // Axis tick text. Compact (1.2k / 3M) because the gutter is ~36 viewBox units wide; the tooltip and the legend
    // carry the exact formatted amount, so nothing is lost to the abbreviation.
    private static string TrendTick(decimal v)
    {
        var ci = System.Globalization.CultureInfo.InvariantCulture;
        var a = Math.Abs(v);
        if (a >= 1_000_000m) return (v / 1_000_000m).ToString("0.#", ci) + "M";
        if (a >= 1_000m) return (v / 1_000m).ToString("0.#", ci) + "k";
        return v.ToString("0.##", ci);
    }

    // (x, y) of point i for a given value on the supplied scale. A single point sits centred.
    private (double X, double Y) TrendXY(IReadOnlyList<TrendRow> rows, int i, decimal value, TrendScale sc)
    {
        var x = rows.Count <= 1 ? (TrX0 + TrX1) / 2 : TrX0 + (TrX1 - TrX0) * i / (rows.Count - 1);
        var span = sc.Max - sc.Min;
        var y = span <= 0m ? TrY1 : TrY1 - (TrY1 - TrY0) * (double)((value - sc.Min) / span);
        return (x, y);
    }

    // "x,y x,y …" points string for one series' polyline.
    private string TrendPoints(IReadOnlyList<TrendRow> rows, Func<TrendRow, decimal> val, TrendScale sc)
    {
        var ci = System.Globalization.CultureInfo.InvariantCulture;
        var sb = new System.Text.StringBuilder();
        for (var i = 0; i < rows.Count; i++)
        {
            var (x, y) = TrendXY(rows, i, val(rows[i]), sc);
            if (i > 0) sb.Append(' ');
            sb.Append(x.ToString("0.#", ci)).Append(',').Append(y.ToString("0.#", ci));
        }
        return sb.ToString();
    }

    // --- Bars ------------------------------------------------------------------------------------------
    // ⚠️ Bars need their OWN x mapping. TrendXY spreads points edge to edge (i / count-1) because that is right
    // for a line; used for bars it would hang the first and last columns half outside the plot. Bars occupy
    // equal slots instead, each centred in its share of the width.

    /// <summary>The centre and full width of month <paramref name="i"/>'s slot.</summary>
    private static (double Centre, double Width) TrendSlot(int count, int i)
    {
        var w = (TrX1 - TrX0) / Math.Max(1, count);
        return (TrX0 + w * (i + 0.5), w);
    }

    /// <summary>Y for a value on a scale, within the flows plot.</summary>
    private static double TrendY(decimal value, TrendScale sc)
    {
        var span = sc.Max - sc.Min;
        return span <= 0m ? TrY1 : TrY1 - (TrY1 - TrY0) * (double)((value - sc.Min) / span);
    }

    /// <summary>A bar drawn from the zero line to <paramref name="value"/>: its top edge and its height. Works in
    /// both directions, so a negative net hangs below the axis instead of being clamped to it.</summary>
    private static (double Y, double H) TrendBar(decimal value, TrendScale sc)
    {
        var zero = TrendY(0m, sc);
        var v = TrendY(value, sc);
        var y = Math.Min(zero, v);
        // A floor of 1.5 units so a small-but-real month is still a visible mark rather than nothing at all —
        // "we earned €4 more than we spent" and "we broke exactly even" must not draw identically.
        var h = Math.Max(Math.Abs(zero - v), value == 0m ? 0 : 1.5);
        return (y, h);
    }

    // The balance chart's own plot box — shorter than the flows chart because it carries one series and answers a
    // slower question ("is the pile growing?"), so it earns less vertical room.
    private const double BalY0 = 10, BalY1 = 74;

    private static double TrendBalY(decimal value, TrendScale sc)
    {
        var span = sc.Max - sc.Min;
        return span <= 0m ? BalY1 : BalY1 - (BalY1 - BalY0) * (double)((value - sc.Min) / span);
    }

    /// <summary>Balance polyline points, on the balance chart's slot centres so its dots line up with the bars above.</summary>
    private static string TrendBalancePoints(IReadOnlyList<TrendRow> rows, TrendScale sc, Func<TrendRow, decimal> pick)
    {
        var ci = System.Globalization.CultureInfo.InvariantCulture;
        var sb = new System.Text.StringBuilder();
        for (var i = 0; i < rows.Count; i++)
        {
            var (cx, _) = TrendSlot(rows.Count, i);
            if (i > 0) sb.Append(' ');
            sb.Append(cx.ToString("0.#", ci)).Append(',').Append(TrendBalY(pick(rows[i]), sc).ToString("0.#", ci));
        }
        return sb.ToString();
    }

    /// <summary>The same points closed down to the baseline, so the line can be filled as an area — a stock reads
    /// as an accumulation, and the fill says "this is a level" where a bare line says "this is a rate".
    /// <para>⚠️ The baseline is the axis FLOOR, not zero. Closing on zero looks right until a balance goes
    /// negative: the polygon then crosses its own base, the two lobes wind in opposite directions, and the fill
    /// cancels out from the crossing onwards — the area silently disappears for the second half of the chart.
    /// A floor at or below every point can't self-intersect.</para></summary>
    private static string TrendBalanceArea(IReadOnlyList<TrendRow> rows, TrendScale sc, Func<TrendRow, decimal> pick)
    {
        var ci = System.Globalization.CultureInfo.InvariantCulture;
        var baseY = TrendBalY(sc.Min, sc).ToString("0.#", ci);
        var first = TrendSlot(rows.Count, 0).Centre.ToString("0.#", ci);
        var last = TrendSlot(rows.Count, rows.Count - 1).Centre.ToString("0.#", ci);
        return $"{first},{baseY} {TrendBalancePoints(rows, sc, pick)} {last},{baseY}";
    }

    // The Home mini-donut: this period's spend by top-level category, top 4 + "Everything else" + transfers-out.
    // Computed independently of the Breakdown tab's window/axis so Home always shows the current period by category,
    // whatever the user last left the Breakdown filters on. Tapping the card deep-links into the full Breakdown.
    //
    // Scoped by period MEMBERSHIP (the period's own collections), NOT a [From,To] date window — deliberately, so it
    // sums exactly the expenses the hero "Spent" tile does (Period.ExpensesTotal). A date window flattened across all
    // periods (as ExpensesInRange does) disagrees with the hero whenever a transaction's date falls outside its own
    // period's dates: right after "Start next month" the new period is empty (hero Spent €0) but a transaction dated
    // into its window but owned by the previous period would still show here — hero and donut then contradict on the
    // same screen. Membership keeps them in lockstep.
    private List<BreakSlice> HomePeriodSlices()
    {
        var groups = new Dictionary<Guid, decimal>();
        foreach (var e in State.Period.Expenses)
        {
            var amt = Math.Abs(e.Amount.Amount);
            if (amt == 0) continue;
            var root = State.RootCategoryId(e.CategoryId);
            groups[root] = groups.GetValueOrDefault(root) + amt;
        }
        var ordered = groups.OrderByDescending(kv => kv.Value).ToList();
        var slices = new List<BreakSlice>();
        var groupTail = ordered.Count > 5;                     // top 4 + one "everything else" once it'd be the 6th
        var head = groupTail ? ordered.Take(4).ToList() : ordered;
        for (var i = 0; i < head.Count; i++)
            slices.Add(new BreakSlice(head[i].Key, State.CategoryName(head[i].Key), State.CategoryStoredIcon(head[i].Key), head[i].Value, SliceColor(i)));
        if (groupTail)
            slices.Add(new BreakSlice(OtherKey, Loc["Everything else"], null, ordered.Skip(4).Sum(kv => kv.Value), OtherColor));
        // Ranked in rather than appended — see InsertByAmount. Home only lists the top 4, so an appended transfer
        // was invisible here entirely, however much money it moved.
        var xfer = State.Period.AccountTransfersOut.Sum(t => Math.Abs(t.Amount.Amount));
        if (xfer > 0m) InsertByAmount(slices, new BreakSlice(TransfersKey, Loc["Transfers out"], null, xfer, TransfersColor));
        return slices;
    }

