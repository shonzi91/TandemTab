    private void OpenEditAccountTransfer(Guid id)
    {
        if (State.FindExternalTransfer(id) is not { } t) return;
        _extTransferId = id;
        _extAmount = t.Amount.Amount; _extDate = t.Date; _extFundId = t.FundId; _extNote = t.Note;
        _extCategoryId = t.CategoryId ?? Guid.Empty;
        _modal = Modal.EditAccountTransfer;
    }

    private Task SaveAccountTransfer() => RunModal(async () =>
    {
        if (_extAmount <= 0 || State.FindExternalTransfer(_extTransferId) is not { } t) return;
        // ⚠️ Two spines, chosen by whether this transfer has a counterpart to keep in step. The linked case must go
        // through the server so both accounts move together; the unlinked case has no other side and would be
        // silently dropped by that route — see EditUnlinkedTransfer for the bug that caused.
        // The category is always SENT, never omitted: the modal renders the current value, so what it holds IS the
        // user's answer — including Guid.Empty, which is how a category gets cleared.
        if (State.IsLinkedAccountTransfer(t))
            await State.EditAccountTransfer(t, _extAmount, _extDate, _extFundId, _extNote, _extCategoryId);
        else
            await State.EditUnlinkedTransfer(t, _extAmount, _extDate, _extFundId, _extNote,
                _extCategoryId == Guid.Empty ? null : _extCategoryId);
        CloseModal();
    });

    private void OpenDeleteAccountTransfer(Guid id) { _extTransferId = id; _modal = Modal.DeleteAccountTransfer; }

