    /// <summary>Just the other members' names, for the "You and {0} got here together" line. Not <see cref="MembersLine"/>,
    /// which formats the whole membership ("you &amp; Maria") and would read as "You and you & Maria".</summary>
    private string OtherMemberNames()
    {
        var others = State.RealUsers.Where(m => m.UserId != State.MyUserId).Select(m => m.DisplayName).ToList();
        return others.Count switch
        {
            0 => "",
            1 => others[0],
            2 => string.Format(Loc["{0} and {1}"], others[0], others[1]),
            _ => string.Join(", ", others.Take(others.Count - 1)) + " " + string.Format(Loc["and {0}"], others[^1]),
        };
    }

