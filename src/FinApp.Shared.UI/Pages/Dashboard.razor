        await State.ReschedulePeriod(_periodFrom, _periodTo);
        CloseModal();
    });

    /// <summary>Open Add-expense for a category. When <paramref name="focusAmount"/> (F1: the category was a deliberate
    /// choice — a quick-add chip, a budget row, a category detail) the Amount field takes focus, so category/fund/date
    /// are all settled and the one number that actually changes is the only thing left to type. Callers that open the
    /// modal <i>without</i> a real category choice pass false: stealing focus there would raise the mobile keypad over
    /// the category picker the user still has to use.</summary>
    private void OpenAddExpense(Guid categoryId, bool focusAmount = true)
    {
        _categoryId = categoryId; _amount = 0; _note = null;
        _fTagId = null; _newTagName = null; _tagFiledTo = null;
        _expenseDate = _dayView ?? DateOnly.FromDateTime(DateTime.Today);
        // Stamp the clock only when the form really is about today — the Expenses tab can open this on a day the
        // user is browsing, and "now" would be a fact about the wrong day. See Expense.Time.
        _expenseTime = _expenseDate == State.TodayDate ? TimeOnly.FromDateTime(DateTime.Now) : null;
        _expenseHadTime = false;
        _fundId = DefaultFundForCategory(categoryId); _modal = Modal.AddExpense;
        _expShowCategory = false; _expShowDate = false; _expShowNote = false; _tagNewOpen = false;
        _focusAmount = focusAmount;
        _expTripId = State.ActiveTrip?.Id ?? Guid.Empty;   // trip mode: default it, don't enforce it
        _expTripAccountId = Guid.Empty;
        // ★ And take the trip's category with it. Applying this only when a trip CHIP is tapped meant the form
        // opened on the running trip while still showing the last-used everyday category — the setting looked
        // broken precisely for the person who never touches the trip row because it is already correct.
        ApplyTripCategoryDefault();
    }

    /// <summary>Point the category at the trip's. Safe to call from any path that assigns <c>_expTripId</c>.
    /// <para>★ A trip saved before one-category filing existed carries no category of its own; rather than leaving
    /// the form on whatever everyday category was last used — which is how a Roman hotel ended up in Rent — it
    /// resolves to the same guess a new trip would get. The user can still change it on the form; what it must not
    /// do is silently file trip spending into the household budgets.</para></summary>
    private void ApplyTripCategoryDefault()
    {
        if (State.FindTrip(_expTripId) is not { } trip) return;
        var cat = trip.CategoryId ?? TripCategoryGuess();
        if (cat != Guid.Empty) _categoryId = cat;
    }

