    /// <summary>Open Transfer without a fund already in hand — the Home button and the FAB reach it from nowhere in
    /// particular, so the biggest root fund is the from-side (it's the one a transfer most often leaves).</summary>
    private Task OpenTransferFromDefaultFund()
    {
        var from = State.RootFunds.OrderByDescending(f => State.FundBalance(f.Id).Amount).FirstOrDefault()
                ?? State.RootFunds.FirstOrDefault();
        return from is null ? Task.CompletedTask : OpenTransferFromFund(from.Id);
    }


    // Multi-expense: a locally-staged list of expenses the user is building; the ✓ saves them all at once. Each draft
    // is a snapshot of the editor fields at the moment "Add another expense" was pressed.
    // Amount is stored ALREADY CONVERTED (see ExpenseAmountToLog), so a draft never carries a foreign figure —
    // the trip id rides along only to attach the row, never to re-convert it.
    // TypedAmount is the pre-conversion figure; ForeignCurrency names what it was typed in (null on an ordinary
    // wallet). Both ride the draft so a staged row saves with the same "€14.63 · £12.50" pair as a direct one.
    private sealed record ExpenseDraft(Guid CategoryId, decimal Amount, Guid FundId, string? Note, DateOnly Date, Guid? TagId, Guid? TripId, decimal TypedAmount, string? ForeignCurrency,
        // Each staged row keeps the clock it was staged at, so three expenses parked over ten minutes save in the
        // order they happened rather than all sharing the moment ✓ was finally pressed.
        TimeOnly? Time);
    private readonly List<ExpenseDraft> _expenseDrafts = new();

    /// <summary>Park the current editor entry as a staged draft row, then clear the per-item fields (keeping
    /// category/fund/date, and the trip — a staged row is usually one of several from the same day away).</summary>
    private void StageCurrentExpense()
    {
        if (_amount <= 0) return;
        _expenseDrafts.Add(new ExpenseDraft(_categoryId, ExpenseAmountToLog(_amount), _fundId, _note, _expenseDate, _fTagId,
            _expTripId == Guid.Empty ? null : _expTripId, _amount, FormForeignFund?.Currency, _expenseTime));
        _amount = 0; _note = null; _fTagId = null; _newTagName = null; _tagFiledTo = null;
        // The next row in a run is a fresh moment — re-stamp it, but only on a form that is about today.
        if (_expenseDate == State.TodayDate) _expenseTime = TimeOnly.FromDateTime(DateTime.Now);
    }

    /// <summary>Pull a staged draft back into the editor to fix it (removing it from the list). If the editor already
    /// holds a valid entry, stage that first so it isn't lost.</summary>
    private void EditDraft(ExpenseDraft d)
    {
        if (_amount > 0) StageCurrentExpense();
        _expenseDrafts.Remove(d);
        _categoryId = d.CategoryId; _fundId = d.FundId; _note = d.Note; _expenseDate = d.Date;
        _fTagId = d.TagId; _newTagName = null; _tagFiledTo = null;
        _expTripId = d.TripId ?? Guid.Empty;
        _expTripAccountId = Guid.Empty;   // drafts are this account's own; a cross-account link is set on the edit form
        _expenseTime = d.Time;
        // Back into the editor as the figure that was TYPED, not the converted one — otherwise pulling a draft back
        // on a foreign-currency trip re-converts it on the next save and the amount climbs every round trip.
        _amount = d.TypedAmount;
    }

    private void RemoveDraft(ExpenseDraft d) => _expenseDrafts.Remove(d);

    /// <summary>Save everything: the staged drafts plus the in-progress editor entry (if it has an amount).</summary>
    private Task AddExpenseFromModal() => RunModal(async () =>
    {
        if (_amount > 0) StageCurrentExpense();
        if (_expenseDrafts.Count == 0) { CloseModal(); return; }
        var lastDate = _expenseDate;
        foreach (var d in _expenseDrafts)
        {
            await State.AddExpense(d.CategoryId, d.Amount, d.FundId, d.Note, d.Date, tagId: d.TagId, tripId: d.TripId,
                foreignAmount: d.ForeignCurrency is null ? null : d.TypedAmount, foreignCurrency: d.ForeignCurrency, time: d.Time);
            lastDate = d.Date;
        }
        _dayView = ClampToPeriod(lastDate); // keep the Expenses tab on the day just used (feature 6)
        CloseModal();
    });

    // --- Tags: single-select + inline create inside the expense modals ---
    // One tag per expense: picking the selected tag clears it, picking another replaces it.
    private void ToggleTagSel(Guid tagId)
    {
        var clearing = _fTagId == tagId;
        _fTagId = clearing ? null : tagId;
        _tagFiledTo = null;
        // Clearing a tag never un-files: the category stands on its own once chosen.
        if (!clearing) ApplyTagBinding(tagId);
    }

    /// <summary>F2: a bound tag files the expense for you. Only while <b>adding</b> — on an edit the row already has a
    /// category the user chose, and re-filing it off the back of a tap meant for tagging would rewrite a stored entry
    /// (moving spend between budgets) as a side effect of labelling it.</summary>
    private void ApplyTagBinding(Guid tagId)
    {
        // Both the ADD paths — the manual form and the imported-transaction review. Not the edit form: that row
        // already has a category the user chose, and re-filing it off a tap meant for labelling would move stored
        // spend between budgets as a side effect.
        if (_modal is not (Modal.AddExpense or Modal.BankConfirm)) return;
        // ★ On a trip the TRIP owns the filing, so its labels tag without re-filing — every label on the trip lands
        // in the trip's one category. Letting the binding fire would undo that on every tap: pick "Stay" and the
        // expense jumps out of the trip's category into Housing, which is exactly the spread this replaced.
        // Note this is now "on any trip", not "on a trip that files into one": a trip saved before the setting
        // existed has no category of its own, and scattering ITS labels across the household budgets is the
        // original bug, not a preserved option.
        if (_expTripId != Guid.Empty) return;
        if (State.TagCategory(tagId) is not { } cat || cat == _categoryId) return;
        _categoryId = cat;
        _tagFiledTo = cat;   // so the swap is announced, not silent
    }

    /// <summary>Picking a trip on the expense form. When that trip collects into one category, the category follows
    /// it — the setting exists to stop the user filing each trip expense by hand, so applying it only at save time
    /// would leave the form showing something other than what it is about to do.</summary>
    private void OnExpenseTripPicked(Guid tripId)
    {
        // "Not a trip" is the detach and is never gated — a lapsed subscriber has to be able to undo a wrong link.
        // Attaching goes through MayLogAgainstTrip: free on a running journey, Pro on a finished one.
        if (tripId != Guid.Empty && !MayLogAgainstTrip(tripId)) return;
        _expTripId = tripId;
        _expTripAccountId = Guid.Empty;   // picking one of OUR trips clears any cross-account link (D1)
        // Arming the rule and THEN picking a trip must not leave a rule armed that the form has stopped offering
        // (see BankRuleOffered). Cleared unconditionally rather than only under Modal.BankConfirm: _bcRemember is
        // read nowhere else, so clearing it on the add/edit forms costs nothing, and a condition here would be one
        // more thing to keep in step with the predicate.
        if (tripId != Guid.Empty) _bcRemember = false;
        // The category follows the trip on the two paths that are CREATING an expense. On the edit form it must not:
        // re-filing a stored row because someone attached it to a trip would move money between budgets.
        if (_modal is not (Modal.AddExpense or Modal.BankConfirm)) return;
        if (tripId == Guid.Empty) return;   // "Not a trip" leaves the category alone — see the note on clearing
        ApplyTripCategoryDefault();
        _tagFiledTo = null;   // not a tag's doing, so the "filed under" note would misattribute it
    }

    // F2: set when picking a tag just changed the category, so the modal can say so. Cleared on the next tag action.
    private Guid? _tagFiledTo;

    /// <summary>Create the tag typed in the modal's "new tag" box and select it (so it's attached on save).</summary>
    private Task AddTagFromModal() => RunModal(async () =>
    {
        var name = _newTagName?.Trim();
        if (string.IsNullOrWhiteSpace(name)) return;
        // Creating a tag refetches the whole account snapshot (new Fund/Category instances), which resets the bound
        // Category/Fund <select> back to their first option — the "dropdown switches when I add a tag" bug. Snapshot
        // the modal's in-flight picks and restore them after, so an inline tag-create never disturbs the form.
        var keepCat = _categoryId; var keepFund = _fundId;
        // If a tag by that name already exists (active or archived), just select it rather than erroring.
        var existing = State.AllTags.FirstOrDefault(t => string.Equals(t.Name, name, StringComparison.CurrentCultureIgnoreCase));
        // ★ A tag created while filing against a trip is born a TRIP label. The trip picker shows only trip labels,
        // so an everyday tag made here was created, selected, and immediately invisible — which read as "you can't
        // add your own labels on a trip". The six seeded ones are a starting point, not the whole vocabulary:
        // "Diving", "Gifts home", "That one restaurant" are exactly what a real trip wants to split by.
        var id = existing?.Id ?? await State.AddTag(name, isTripTag: _expTripId != Guid.Empty);
        if (id != Guid.Empty) _fTagId = id;
        _newTagName = null;
        _tagNewOpen = false;   // made it — the box folds away rather than sitting open for a second one
        _categoryId = keepCat; _fundId = keepFund;
        // Restore first, then let F2 have its say: a brand-new tag is unbound (no-op), but typing the name of an
        // existing bound tag selects that tag, and it should file exactly as tapping its chip would.
        _tagFiledTo = null;
        if (id != Guid.Empty) ApplyTagBinding(id);
    });

    private async Task TagNewKey(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" && !string.IsNullOrWhiteSpace(_newTagName)) await AddTagFromModal();
    }

