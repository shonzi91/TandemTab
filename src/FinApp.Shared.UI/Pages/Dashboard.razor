    private Guid _projBucketId;                 // bucket the payoff/goal-date modal is showing
    private string? _openTip;                   // which info-tip caption is expanded (null = none)
    private decimal _payoffExtra;               // payoff modal: extra /mo ON TOP of the installment (defaults to pace)
    private decimal _invExtra;                  // investment growth modal: extra /mo invested (defaults to pace)
    private decimal _planExtra;                 // multi-debt planner: shared extra /period
    private FinApp.Domain.Forecasting.LoanForecast.Strategy _planStrategy = FinApp.Domain.Forecasting.LoanForecast.Strategy.Avalanche;

    // The multi-debt plan (reads the debt buckets), and its "installments only" baseline for the savings figure.
    private FinApp.Domain.Forecasting.LoanForecast.StrategyPlan? DebtPlan =>
        FinApp.Domain.Forecasting.LoanForecast.PlanPayoff(State.DebtLoanInputs, _planExtra, _planStrategy);
    private FinApp.Domain.Forecasting.LoanForecast.StrategyPlan? DebtBaseline =>
        FinApp.Domain.Forecasting.LoanForecast.PlanPayoff(State.DebtLoanInputs, 0m, _planStrategy);

    /// <summary>Months until every debt bucket is cleared, projecting each at its installment + the pace/plan the user
    /// actually sets aside (<see cref="BudgetingState.EffectiveSavingPace"/>) — mirroring the payoff modal's
    /// "installment + extra on top" line so the Home "Debt-free" date agrees with the per-debt modal. Null when there
    /// are no debts, or a debt never clears at that amount (no honest date to promise).</summary>
    private int? DebtFreeMonthsAtPace()
    {
        var debts = State.SavingBuckets
            .Where(x => x.Bucket.IsDebt && !x.Bucket.IsArchived && x.Bucket.DebtBalance > 0m)
            .Select(x => x.Bucket).ToList();
        if (debts.Count == 0) return null;
        var months = 0;
        foreach (var d in debts)
        {
            var pace = State.EffectiveSavingPace(d.Id)?.Amount ?? 0m;
            if (FinApp.Domain.Forecasting.LoanForecast.PayOff(d.DebtBalance, d.DebtAnnualRatePercent, d.DebtInstallment + pace) is not { } p)
                return null;   // one debt never clears at this amount → no debt-free date to show
            months = Math.Max(months, p.Months);
        }
        return months;
    }

