    // Currency formatting. Two entry points during the Money→decimal migration (Path B, docs/DOMAIN-REMOVAL.md):
    // Fmt(decimal) formats in the account currency (the common case — the whole account is single-currency), while
    // Fmt(Money) honours the value's own currency (needed for cross-currency figures like settlement amounts). Both
    // share one core, so the rendered string is byte-identical however a figure is sourced.
    private static string FmtCurrency(decimal amount, string currency)
    {
        // The three-symbol switch that used to live here moved to CurrencyInfo, which knows the ~35 a traveller is
        // likely to meet and keeps the same "CODE " fallback for everything else.
        return $"{CurrencyInfo.Symbol(currency)}{amount:N2}";
    }

    private string Fmt(decimal amount) => FmtCurrency(amount, State.Currency);

    private static string Fmt(Money m) => FmtCurrency(m.Amount, m.Currency);

    // Render the domain's language-independent insight messages (code + args) into the active UI language.
    private string MoneyN(decimal amount) => Fmt(new Money(amount, State.Currency));
    private string N(InsightMessage m) => InsightNarrator.Render(m, Loc, MoneyN);
    private string N(IReadOnlyList<InsightMessage> parts) => InsightNarrator.Render(parts, Loc, MoneyN);

