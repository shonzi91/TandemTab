    /// <summary>One line on the Home "on track for" card: an emoji, a name, and either a projected month or "reached".</summary>
    private readonly record struct HomeTarget(string Icon, string Name, int Months, bool Reached);

    /// <summary>Read-only "when will it happen" summary for the Home card: the all-debts debt-free date (paying just
    /// the installments — the honest baseline) plus each savings goal's date at its current pace. Reuses the same
    /// projection math as the drill-in modals. Empty when there's nothing to project yet, so the card stays hidden.</summary>
    private List<HomeTarget> HomeTargets()
    {
        var list = new List<HomeTarget>();
        // Debt-free date across every debt bucket, projecting each at its installment + the pace/plan you actually set
        // aside — the same "installment + extra on top" math as the payoff modal, so the two agree. You're debt-free
        // when the last one clears, hence the latest month wins.
        if (DebtFreeMonthsAtPace() is { } dfMonths)
            list.Add(new HomeTarget("flag", Loc["Debt-free"], dfMonths, false));
        // Each ordinary savings goal, dated at the pace the user actually sets aside (mirrors the goal-projection modal).
        foreach (var x in State.SavingBuckets.Where(b => !b.Bucket.IsDebt && !b.Bucket.IsArchived && b.Bucket.HasGoal))
        {
            if (x.Bucket.GoalAmount is not { } goal) continue;
            var saved = State.SavingBucketSaved(x.Bucket.Id).Amount;
            if (saved >= goal) { list.Add(new HomeTarget(State.SavingBucketIcon(x.Bucket.Id), x.Bucket.Name, 0, true)); continue; }
            if (State.EffectiveSavingPace(x.Bucket.Id) is { Amount: > 0m } pace)
                list.Add(new HomeTarget(State.SavingBucketIcon(x.Bucket.Id), x.Bucket.Name,
                    (int)Math.Ceiling((double)((goal - saved) / pace.Amount)), false));
        }
        return list;
    }

    // --- Notifications bell — aggregates the transient Home prompts into one dropdown by the account controls -----
    private bool _bellOpen;
    private sealed record Notification(string Icon, string Text, string? Desc, string? ActionLabel, Action? Act,
        Action? Rotate, Action? Dismiss, bool Urgent);

    // Notification/reminder rows carry a mixed "icon" stream: mostly our chrome icon names (rendered as <Icon>), but
    // a few are user data — a bucket's or recurring item's own emoji — which have no sprite symbol and must render as
    // the raw emoji. IconOrEmoji picks per value so the data rows don't break on a missing <use href>.
    private static readonly HashSet<string> IconNames = new(StringComparer.Ordinal)
    {
        "import","repeat","bank","bell","shield","alert","receipt","note","target","pulse","sliders","pencil","trash",
        "check","x","plus","tag","archive","coins","swap","trending","bulb","pin","link","list","share","info","rotate",
        "calendar","card","chart","users","logout","arrow-right","scale","calculator","bookmark","trophy",
    };
    private RenderFragment IconOrEmoji(string icon) => builder =>
    {
        if (IconNames.Contains(icon) || CategoryIcons.Names.Contains(icon))
        {
            builder.OpenComponent<Icon>(0);
            builder.AddAttribute(1, "Name", icon);
            builder.CloseComponent();
        }
        else
        {
            builder.AddContent(2, icon);
        }
    };

    /// <summary>Everything that used to stack on Home: the budget/savings reminders, the spare→debt and over-budget
    /// tips (rotating + dismissible), and the "needs attention" warning signals — collected for the bell dropdown.</summary>
    private IReadOnlyList<Notification> HomeNotifications(FinancialHealthReport ov)
    {
        var list = new List<Notification>();

        // Overspent into the savings earmark — the single most urgent state, so it leads and shows inline on Home
        // (it used to sit only on the Wallets tab, out of sight of the tab you land on).
        if (State.Deficit.Amount > 0m)
            list.Add(new Notification("scale", Loc["Off balance — overspent by"] + " " + Fmt(State.Deficit) + ".",
                Loc["Expenses ate into your savings earmark. This will need to be covered next period (from a savings bucket or fresh contributions)."],
                null, null, null, null, true));

        // Recurring items posted automatically this session — surfaced so the money move is never silent.
        foreach (var ap in _autoPostedNotices)
        {
            var notice = ap;
            list.Add(new Notification("check", string.Format(Loc["{0} ({1}) was posted automatically."], ap.Name, Fmt(ap.Amount)), null,
                Loc["Review"], () => { _autoPostedNotices.Remove(notice); if (ap.Kind == RecurringKind.Income) _tab = Tab.Account; else ShowExpensesTab(); },
                null, () => _autoPostedNotices.Remove(notice), false));
        }

        foreach (var r in HomeReminders(ov))
            list.Add(new Notification(r.Icon, r.Text, null, r.ActionLabel, r.Act, null, null, r.Urgent));

        // Recurring items that have come due this period — confirm the real amount (posts a normal expense/deposit).
        foreach (var due in State.DueRecurring())
        {
            var id = due.Id;
            var text = due.AmountMode == RecurringAmountMode.ReminderOnly
                ? string.Format(Loc["{0} is due — enter the amount."], due.Name)
                : string.Format(Loc["{0} is due (about {1}) — confirm it."], due.Name, Fmt(due.ExpectedAmount));
            list.Add(new Notification(due.Icon ?? (due.Kind == RecurringKind.Income ? "note" : "repeat"), text, null,
                Loc["Confirm"], () => OpenConfirmRecurring(id), null, () => SkipRecurringFromBell(id), false));
        }

        // Recurring items coming up soon (not due yet) — a gentle heads-up so nothing sneaks up on you. Deliberately
        // NO Confirm here: an item isn't confirmable until its due date arrives (then it moves to the DueRecurring
        // block above, which carries Confirm). This stays a pure reminder — dismissable via skip, but not postable early.
        foreach (var soon in State.UpcomingRecurring())
        {
            var id = soon.Id;
            var days = State.RecurringDaysUntilDue(soon);
            var whenText = days <= 1 ? Loc["tomorrow"] : string.Format(Loc["in {0} days"], days);
            var text = soon.HasKnownAmount
                ? string.Format(Loc["{0} (about {1}) is due {2}."], soon.Name, Fmt(soon.ExpectedAmount), whenText)
                : string.Format(Loc["{0} is due {1}."], soon.Name, whenText);
            list.Add(new Notification("calendar", text, null, null, null, null, () => SkipRecurringFromBell(id), false));
        }

        // "Move it" reallocates for real (trims the budget + sets aside toward the debt), so the whole tip is gated
        // on free cash existing. Showing "you have spare in Groceries — put it on the loan" while the free balance
        // is already negative describes spare money that isn't there: the budget has room, the account doesn't.
        if (State.MaxAdditionalSavings.Amount > 0m && LoanNudge() is { } tip)
        {
            Action? rotate = State.DiscretionaryLeftovers().Count(c => !_dismissedNudges.Contains(c.Id)) > 1 ? () => _nudgeIndex++ : null;
            var moveable = Math.Min(tip.Amount, State.MaxAdditionalSavings.Amount);
            var (label, act) = State.IsPeriodOpen && moveable > 0m
                ? (Loc["Move it to the loan"], (Action)(() => OpenReallocate(tip.BudgetId, tip.DebtId, moveable, tip.BudgetName, tip.DebtName)))
                : (null, (Action?)null);
            list.Add(new Notification("bulb", tip.Title, tip.Desc, label, act, rotate, () => DismissNudge(tip.BudgetId), false));
        }
        if (OverBudgetTip() is { } ob)
        {
            Action? rotate = OverBudgetCandidates().Count > 1 ? () => _overIndex++ : null;
            list.Add(new Notification("alert", ob.Title, ob.Desc, Loc["Review"], () => OpenCategoryDetail(ob.CatId), rotate, () => DismissOverBudget(ob.CatId), true));
        }
        // Pace reminders: at most one per off-track debt/goal, with the payoff-date slip and a "set aside" action.
        list.AddRange(PaceReminders());

        if (ov.HasData)
            foreach (var s in ov.Signals.Where(s => s.Kind == SignalKind.Warn))
                list.Add(new Notification("alert", N(s.Title), N(s.Desc), null, null, null, null, true));
        return list;
    }

    // --- Home reminders (#10) — contextual, in-app, actionable local prompts (no push) --------------
    private sealed record HomeReminder(string Icon, string Text, string? ActionLabel, Action? Act, bool Urgent);

    /// <summary>Up-to-three timely prompts for the active period: an over/near-cap budget, and a savings nudge when
    /// you're short of your rate this period. Each carries a one-tap action. Empty for closed/past periods.</summary>
    private IReadOnlyList<HomeReminder> HomeReminders(FinancialHealthReport ov)
    {
        var list = new List<HomeReminder>();
        if (!State.IsReady || !State.HasAccounts || !State.IsPeriodOpen) return list;

        // Fresh period with no income logged yet — prompt to add it so budgets/insights reflect real money.
        if (State.TotalContributed.Amount <= 0m)
            list.Add(new HomeReminder("import", Loc["No income added this period yet — log it so your plan reflects real money."],
                Loc["Add income"], OpenDeposit, false));

        // Budgets plan to spend more than there is free cash to cover. Budgets are advisory, so nothing is broken
        // yet — but the plan can't all be funded, and until now this only whispered as an amber sub-line in the
        // header. Reserving money into a bucket is a common way to land here, and from the Spending tab the cause
        // isn't visible. Urgent, so it surfaces on Home rather than waiting in the bell: a plan that outruns the
        // money is the same family as a deficit, not a tip.
        var planFree = State.DisplayFreeToAllocate(_bankStatus?.Balance, _bankStatus?.BalanceCurrency);
        var planLeft = State.TotalBudgeted - State.TotalSpent;
        if (planLeft.Amount > 0m && planLeft.Amount > planFree.Amount)
            list.Add(new HomeReminder("calculator",
                string.Format(Loc["Your budgets still plan {0} but only {1} is free — trim a budget or add income."],
                    Fmt(planLeft), Fmt(planFree)),
                Loc["Adjust budgets"], ShowExpensesTab, true));

        // The budget closest to its cap but not yet over (≥80%). Over-budget cases are handled separately by the
        // rotating, non-essential OverBudgetTip, so we don't double up here.
        (Guid CatId, string Name, decimal Remaining, decimal Ratio)? near = null;
        foreach (var b in State.Period.Budgets)
        {
            if (b.Allocated.Amount <= 0m) continue;
            var cov = State.Coverage(b.CategoryId);
            if (cov.Spent.Amount > cov.Allocated.Amount) continue;   // over-budget → OverBudgetTip
            var ratio = cov.Spent.Amount / cov.Allocated.Amount;
            if (ratio >= 0.8m && (near is null || ratio > near.Value.Ratio))
                near = (b.CategoryId, State.CategoryName(b.CategoryId), cov.Remaining.Amount, ratio);
        }
        if (near is { } n)
            list.Add(new HomeReminder("info", string.Format(Loc["You're {0} from your {1} budget."], Fmt(n.Remaining), n.Name),
                Loc["Review"], () => OpenCategoryDetail(n.CatId), false));

        // Sinking-fund nudge: a bucket with listed future costs hasn't had this month's set-aside put in yet.
        // Deliberately separate from the savings-rate nudge below and worded differently — that one is about hitting
        // a rate you chose, this one is about covering a bill that is already coming. Same reason the action says
        // "Reserve for upcoming costs" rather than reusing "Move to savings": they are not the same instruction.
        foreach (var (bucket, owed) in State.SinkingFundsShortThisPeriod().Take(1))
        {
            var bucketId = bucket.Id;
            // One tap does it — the message already names the bucket and the amount, so an "Add to savings" modal
            // would only ask again for what it just told you. Capped at free cash (same guard as the loan nudge):
            // reserving past what you hold would push the account into the over-earmarked state on a single click.
            var reservable = Math.Min(owed, State.MaxAdditionalSavings.Amount);
            var (label, act) = State.IsPeriodOpen && reservable > 0m
                ? (Loc["Reserve for upcoming costs"], (Action)(() => ReserveForCosts(bucketId, reservable)))
                : (null, (Action?)null);
            list.Add(new HomeReminder("calendar",
                string.Format(Loc["{0} needs {1} set aside this period to stay ahead of its costs."],
                    bucket.Name, Fmt(owed)),
                label, act, false));
        }

        // Savings nudge: below your rate target this period (reuses the Insights shortfall), or nothing saved yet.
        // Both branches are gated on there actually being spare cash. Urging someone to set more aside while their
        // free balance is already negative — i.e. what's earmarked exceeds what they hold — is asking them to dig
        // the hole deeper, and it's the moment the app has least business nagging.
        if (HasSavingsBucket && State.MaxAdditionalSavings.Amount > 0m)
        {
            // Only ever suggest what the user can actually earmark right now — cash not already set aside.
            var suggest = ov.SavingsShortfall is { } gap
                ? State.Money(Math.Min(gap.Amount, State.MaxAdditionalSavings.Amount)) : (Money?)null;
            if (suggest is { Amount: > 0m } s)
                list.Add(new HomeReminder("coins", string.Format(Loc["Set aside {0} more to hit your {1} savings goal this period."], Fmt(s), PctText(ov.SavingsTarget)),
                    Loc["Move to savings"], OpenMoveToSavings, false));
            else if (State.SavingsThisPeriod.Amount <= 0m && State.TotalContributed.Amount > 0m)
                list.Add(new HomeReminder("coins", Loc["Money came in this period — move some into savings while it's here."],
                    Loc["Move to savings"], OpenMoveToSavings, false));
        }

        return list.Take(3).ToList();
    }

    private bool HasSavingsBucket => State.SavingBuckets.Any(b => !b.Bucket.IsArchived);
    // Any archived fund / category / bucket — gates the "Archived items" entry in the account-actions menu.
    private bool HasArchivedItems => State.ArchivedFunds.Any() || State.ArchivedCategories.Any() || State.SavingBuckets.Any(b => b.Bucket.IsArchived);

    /// <summary>Open "Add to savings" on the best-fit bucket (a live goal bucket first), or fall back to the Savings tab.</summary>
    private void OpenMoveToSavings()
    {
        var bucket = State.SavingBuckets.FirstOrDefault(b => !b.Bucket.IsArchived && !b.Bucket.IsDebt).Bucket
                  ?? State.SavingBuckets.FirstOrDefault(b => !b.Bucket.IsArchived).Bucket;
        if (bucket is not null) OpenAddSaving(bucket.Id);
        else _tab = Tab.Savings;
    }

    // A random-ish starting pick so the tip feels fresh each session; the "↻ another" button advances it. Stable
    // across re-renders (no flicker) — it only moves when the user cycles it or the underlying budgets change.
    private int _nudgeIndex = Random.Shared.Next(0, 997);

    /// <summary>A gentle, dismissible Home-tab suggestion tied to <b>one specific</b> discretionary budget that has
    /// spare this period, proposing it toward the debt it helps most (showing interest/time saved). Read-only — moves
    /// no money. Rotates through the candidates via <see cref="_nudgeIndex"/>; a dismissed budget drops out for the
    /// rest of the period (see <see cref="_dismissedNudges"/>). Null when there's nothing left worth showing.</summary>
    private (Guid BudgetId, Guid DebtId, decimal Amount, string BudgetName, string DebtName, string Title, string Desc)? LoanNudge()
    {
        // Dismissals are per-period: forget them the moment the active period changes.
        if (_nudgeDismissPeriod != State.PeriodNumber) { _nudgeDismissPeriod = State.PeriodNumber; _dismissedNudges.Clear(); }

        // The debt where extra helps most (highest rate), and its baseline payoff at the installment.
        var debt = State.SavingBuckets.Where(x => x.Bucket.IsDebt && x.Bucket.DebtBalance > 0m)
            .OrderByDescending(x => x.Bucket.DebtAnnualRatePercent).Select(x => x.Bucket).FirstOrDefault();
        if (debt is null) return null;
        if (FinApp.Forecasting.LoanForecast.PayOff(debt.DebtBalance, debt.DebtAnnualRatePercent, debt.DebtInstallment) is not { } b) return null;

        // Specific discretionary budgets with spare (up to 10) that would actually move the payoff — minus any the
        // user has already dismissed this period, so a handled/ignored suggestion never re-nags.
        var usable = NudgeCandidates(debt, b);
        if (usable.Count == 0) return null;

        var pick = usable[_nudgeIndex % usable.Count];
        var f2 = pick.Fast!.Value;
        return (
            pick.Id, debt.Id, pick.Amount, pick.Name, debt.Name,
            string.Format(Loc["Your {0} budget has about {1} to spare"], pick.Name, Fmt(pick.Amount)),
            string.Format(Loc["Put it toward {0} every period and you'd clear it {1} sooner and save around {2} in interest. Budgets vary, so treat it as a what-if — essential budgets are never counted."],
                debt.Name, MonthsText(b.Months - f2.Months), Fmt(Math.Max(0m, b.TotalInterest - f2.TotalInterest))));
    }

    /// <summary>Discretionary budgets with spare that would speed up <paramref name="debt"/>, excluding ones dismissed
    /// this period. Shared by the nudge and the "↻ another" affordance so both agree on what's left to show.</summary>
    private List<(Guid Id, string Name, decimal Amount, FinApp.Forecasting.LoanForecast.Payoff? Fast)> NudgeCandidates(
        SavingCategory debt, FinApp.Forecasting.LoanForecast.Payoff b) =>
        State.DiscretionaryLeftovers().Where(c => !_dismissedNudges.Contains(c.Id)).Take(10)
            .Select(c => (c.Id, c.Name, c.Amount, Fast: FinApp.Forecasting.LoanForecast.PayOff(debt.DebtBalance, debt.DebtAnnualRatePercent, debt.DebtInstallment + c.Amount)))
            .Where(c => c.Fast is { } f && (b.Months > f.Months || b.TotalInterest > f.TotalInterest))
            .ToList();

    /// <summary>Hide this budget's suggestion for the rest of the period and jump the rotation to the next candidate.</summary>
    private void DismissNudge(Guid budgetId) { _dismissedNudges.Add(budgetId); _nudgeIndex++; }

    // --- Pace reminders (#1): a calm heads-up when a debt/goal's demonstrated pace is slipping behind the plan the
    // user set, with the payoff/goal date it drifts to if that pace continues. Dismissible for the period.
    private int _paceDismissPeriod = -1;
    private void DismissPace(Guid bucketId) => _dismissedPace.Add(bucketId);

    /// <summary>For each active bucket with a planned monthly contribution, compare the demonstrated pace (average set
    /// aside per period) to the plan. When it's meaningfully behind, surface how much later the payoff/goal date drifts
    /// and how much to add to stay on track. Nothing fires when there's no plan, no history yet, or you're keeping up —
    /// so it never nags a user who is on pace.</summary>
    private IEnumerable<Notification> PaceReminders()
    {
        if (!State.IsPeriodOpen) yield break;
        if (_paceDismissPeriod != State.PeriodNumber) { _paceDismissPeriod = State.PeriodNumber; _dismissedPace.Clear(); }

        foreach (var x in State.SavingBuckets)
        {
            var b = x.Bucket;
            if (b.IsArchived || b.IsInvestment) continue;
            if (_dismissedPace.Contains(b.Id)) continue;
            if (State.SavingBucketPlannedContribution(b.Id) is not { } planned || planned <= 0m) continue;
            // Demonstrated pace (needs prior periods); skip if unknown or you're keeping up with the plan.
            if (State.SavingBucketPace(b.Id) is not { Amount: > 0m } paceMoney) continue;
            var pace = paceMoney.Amount;
            if (pace >= planned) continue;
            var shortfall = planned - pace;

            int? monthsPlanned, monthsPace;
            if (b.IsDebt)
            {
                if (b.DebtBalance <= 0m) continue;
                monthsPlanned = FinApp.Forecasting.LoanForecast.PayOff(b.DebtBalance, b.DebtAnnualRatePercent, planned)?.Months;
                monthsPace = FinApp.Forecasting.LoanForecast.PayOff(b.DebtBalance, b.DebtAnnualRatePercent, pace)?.Months;
            }
            else
            {
                if (b.GoalAmount is not { } goal) continue;
                var remaining = goal - State.SavingBucketSaved(b.Id).Amount;
                if (remaining <= 0m) continue;
                monthsPlanned = (int)Math.Ceiling((double)(remaining / planned));
                monthsPace = (int)Math.Ceiling((double)(remaining / pace));
            }
            if (monthsPlanned is not { } mp) continue;   // even the plan never clears → not a pace problem

            var bid = b.Id;
            string desc;
            if (monthsPace is { } ms && ms > mp)
                desc = string.Format(Loc["Planned {0}/mo reaches {1}. At your recent {2}/mo it slips to {3} — about {4} later. Set aside {5} more this month to stay on track."],
                    Fmt(planned), PayoffDate(mp), Fmt(pace), PayoffDate(ms), MonthsText(ms - mp), Fmt(shortfall));
            else if (monthsPace is null)
                desc = string.Format(Loc["Planned {0}/mo reaches {1}, but your recent {2}/mo won't get there. Set aside {3} more this month to stay on track."],
                    Fmt(planned), PayoffDate(mp), Fmt(pace), Fmt(shortfall));
            else
                continue;   // slower pace isn't actually later → nothing worth saying

            yield return new Notification(State.SavingBucketIcon(bid),
                string.Format(Loc[b.IsDebt ? "Keep up your {0} payments" : "Keep up your {0} pace"], b.Name), desc,
                Loc["Set aside"], () => OpenAddSaving(bid), null, () => DismissPace(bid), false);
        }
    }

    // "Move it to the loan" reallocation (#14): trims the spare off a discretionary budget and sets it aside toward the
    // debt, in one confirmed step — the coherent version of the reverted one-tap. Closes the loop so the nudge stops.
    private Guid _reallocBudgetId, _reallocDebtId;
    private decimal _reallocAmount, _reallocNewBudget;
    private string _reallocBudgetName = "", _reallocDebtName = "";
    private void OpenReallocate(Guid budgetId, Guid debtId, decimal amount, string budgetName, string debtName)
    {
        _reallocBudgetId = budgetId; _reallocDebtId = debtId; _reallocAmount = amount;
        _reallocBudgetName = budgetName; _reallocDebtName = debtName;
        _reallocNewBudget = Math.Max(0m, (State.BudgetFor(budgetId)?.Allocated.Amount ?? amount) - amount);
        _bellOpen = false;
        _modal = Modal.Reallocate;
    }
    private Task DoReallocate() => RunModal(async () =>
    {
        if (_reallocAmount <= 0m) return;
        var b = State.BudgetFor(_reallocBudgetId);
        await State.ReallocateBudgetToSaving(_reallocBudgetId, _reallocNewBudget,
            (b?.AlertThreshold ?? 0.8m) * 100m, b?.NotifyOnEveryExpense ?? false, _reallocDebtId, _reallocAmount);
        CloseModal();
    });

    // --- Recurring items (BACKLOG #13, phase 1) ------------------------------------------------------
    private Guid _recEditId;                 // Guid.Empty = adding a new one
    private string _recName = "";
    private string? _recIcon;
    private RecurringKind _recKind = RecurringKind.Expense;
    private RecurringAmountMode _recMode = RecurringAmountMode.Fixed;
    private decimal _recAmount;
    private int _recDay = 1;
    private Guid _recCategoryId, _recFundId;
    private bool _recAutoPost;
    private Guid _recConfirmId;
    private decimal _recConfirmAmount;
    // Recurring items auto-posted this session — shown once in the bell so the money move isn't silent.
    private readonly List<(string Name, Money Amount, RecurringKind Kind)> _autoPostedNotices = new();

    private void OpenRecurring() { _acctMenuOpen = false; _modal = Modal.Recurring; }

    private void OpenAddRecurring()
    {
        _recEditId = Guid.Empty; _recName = ""; _recIcon = null; _recKind = RecurringKind.Expense;
        _recMode = RecurringAmountMode.Fixed; _recAmount = 0; _recDay = 1; _recAutoPost = false;
        _recFundId = State.SelectableFunds.FirstOrDefault()?.Id ?? State.RootFunds.FirstOrDefault()?.Id ?? Guid.Empty;
        ResetRecurringCategory();
        _modal = Modal.RecurringEdit;
    }

    private void OpenEditRecurring(Guid id)
    {
        if (State.RecurringItems.FirstOrDefault(r => r.Id == id) is not { } r) return;
        _recEditId = r.Id; _recName = r.Name; _recIcon = r.Icon; _recKind = r.Kind; _recMode = r.AmountMode;
        _recAmount = r.ExpectedAmount; _recDay = r.DayOfMonth; _recCategoryId = r.CategoryId; _recFundId = r.FundId; _recAutoPost = r.AutoPost;
        _modal = Modal.RecurringEdit;
    }

    // When switching income/expense, point the category at a valid one for that kind.
    private void SetRecurringKind(RecurringKind kind) { _recKind = kind; ResetRecurringCategory(); }
    private void ResetRecurringCategory() =>
        _recCategoryId = _recKind == RecurringKind.Income
            ? State.ContributionCategories.FirstOrDefault()?.Id ?? Guid.Empty
            : State.AllCategories.FirstOrDefault()?.Id ?? Guid.Empty;

    private Task SaveRecurring() => RunModal(async () =>
    {
        if (string.IsNullOrWhiteSpace(_recName) || _recCategoryId == Guid.Empty || _recFundId == Guid.Empty) return;
        if (_recEditId == Guid.Empty)
            await State.AddRecurring(_recName, _recKind, _recMode, _recAmount, _recDay, _recCategoryId, _recFundId, _recIcon, _recAutoPost);
        else
            await State.UpdateRecurring(_recEditId, _recName, _recMode, _recAmount, _recDay, _recCategoryId, _recFundId, _recIcon, _recAutoPost);
        _modal = Modal.Recurring;
    });

    private Task RemoveRecurringItem(Guid id) => RunModal(() => State.RemoveRecurring(id));

    private void OpenConfirmRecurring(Guid id)
    {
        if (State.RecurringItems.FirstOrDefault(r => r.Id == id) is not { } r) return;
        _recConfirmId = r.Id;
        _recConfirmAmount = r.AmountMode == RecurringAmountMode.ReminderOnly ? 0m : r.ExpectedAmount;
        _bellOpen = false;
        _modal = Modal.RecurringConfirm;
    }

    private Task DoConfirmRecurring() => RunModal(async () =>
    {
        if (_recConfirmAmount <= 0m) return;
        await State.ConfirmRecurring(_recConfirmId, _recConfirmAmount);
        CloseModal();
    });

    private Task DoSkipRecurring() => RunModal(async () => { await State.SkipRecurring(_recConfirmId); CloseModal(); });

    // Dismissing a due-recurring notification from the bell skips it for this period (so it won't re-nag).
    private void SkipRecurringFromBell(Guid id) => _ = InvokeAsync(async () => { await State.SkipRecurring(id); StateHasChanged(); });

    /// <summary>Set aside this period's sinking-fund shortfall in one tap. Nothing is remembered about having done
    /// it: the nudge is derived from what the bucket actually holds, so deleting the deposit — or spending against
    /// the bucket — brings it straight back.</summary>
    private void ReserveForCosts(Guid bucketId, decimal amount) =>
        _ = InvokeAsync(async () =>
        {
            await State.AllocateSaving(bucketId, amount, Loc["Reserved for upcoming costs"]);
            StateHasChanged();
        });

    // --- Statement file import (CSV/OFX/QIF) — parsed client-side, reviewed, then posted as real expenses/income. ---
    private enum ImportStep { Upload, MapCsv, Review }
    private ImportStep _importStep;
    private string? _importError;
    private IReadOnlyList<string> _csvHeaders = [];
    private IReadOnlyList<IReadOnlyList<string>> _csvRows = [];
    private int _csvDate, _csvDesc, _csvAmount, _csvDebit = -1, _csvCredit = -1;
    // Some banks (e.g. DAIS/DSK) put money-out and money-in in separate columns. Auto-detected — no manual toggle.
    private bool CsvHasSplit => _csvDebit >= 0 && _csvCredit >= 0;
    private Guid _importFund;
    private int _importSkipped;   // transactions dated outside the current period, left out of the review
    private readonly List<ImportRow> _importRows = new();

    private sealed class ImportRow
    {
        public ImportedTransaction Tx { get; init; }
        public bool Include { get; set; }
        public Guid CategoryId { get; set; }
        public bool Duplicate { get; init; }
