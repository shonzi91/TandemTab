    private Guid _disburseBucketId;
    private Guid _disburseFundId;
    private decimal _disburseAmount;
    private string? _disburseNote;
    // Which of the two outcomes the payment buys. False = keep the installment and finish sooner, which needs no
    // write at all; true = keep the end date and re-price the payment. Reset whenever the modal opens.
    private bool _disburseKeepEndDate;

    private void OpenDisburseSaving(Guid bucketId)
    {
        _disburseBucketId = bucketId;
        // Default to the fund the bucket is earmarked in; else the synced (bank) fund; else the first fund.
        _disburseFundId = State.SavingBucketFundId(bucketId)
            ?? (State.HasSyncedFund ? State.SyncedFundId : State.RootFunds.FirstOrDefault()?.Id ?? Guid.Empty);
        _disburseAmount = 0;
        _disburseNote = null;
        _disburseKeepEndDate = false;   // every payment is its own decision; last time's must not carry over
        _modal = Modal.DisburseSaving;
    }

    /// <summary>What the amount currently typed into "Make a payment" would do to the loan, or null when the bucket
    /// isn't a debt / has no schedule to compare against / nothing is typed yet. Recomputed per render off the pure
    /// forecast, so it can't drift from what the payment actually does.</summary>
    private FinApp.Forecasting.LoanForecast.LumpSum? LumpSumOutcome()
    {
        if (_disburseAmount <= 0m) return null;
        if (State.FindSavingBucket(_disburseBucketId) is not { IsDebt: true } debt) return null;
        return FinApp.Forecasting.LoanForecast.PayLumpSum(
            debt.DebtBalanceOn(DateOnly.FromDateTime(DateTime.Today)), debt.DebtAnnualRatePercent,
            debt.DebtInstallment, _disburseAmount);
    }

    /// <summary>How much this bucket holds (accumulated across periods) — the cap for a disbursement.</summary>
    private Money DisburseBucketBalance() =>
        State.SavingBuckets.FirstOrDefault(b => b.Bucket.Id == _disburseBucketId).Total is { } t && t.Currency is not null
            ? t : State.Money(0);

    private Task DisburseSavingFromModal() => RunModal(async () =>
    {
        if (_disburseAmount <= 0 || _disburseAmount > DisburseBucketBalance().Amount || _disburseFundId == Guid.Empty) return;
        // Captured BEFORE the payment lands: afterwards the balance has already moved, so the same call would
        // report what the NEXT payment of this size would save, not the one just made.
        var outcome = LumpSumOutcome();
        var name = State.SavingBucketName(_disburseBucketId);
        var bucketId = _disburseBucketId;
        var keepEndDate = _disburseKeepEndDate;
        await State.DisburseSaving(bucketId, _disburseFundId, _disburseAmount, _disburseNote);
        // "Keep the end date" is a SECOND write, deliberately after the payment rather than folded into it: the
        // money moving is the thing that must not be lost, and re-pricing the schedule is a preference about what
        // that money bought. Folded together, a failure here would have to roll back cash that has already left.
        if (keepEndDate && outcome is { LoweredInstallment: { } lowered } && lowered > 0m)
            await State.SetDebtInstallment(bucketId, lowered);
        _disburseAmount = 0; _disburseNote = null; _disburseKeepEndDate = false;
        _paydownResult = outcome is { } o ? (name, o) : null;
        CloseModal();
    });

