        _recCategoryId = _recKind == RecurringKind.Income
            ? State.ContributionCategories.FirstOrDefault()?.Id ?? Guid.Empty
            : State.AllCategories.FirstOrDefault()?.Id ?? Guid.Empty;

    private Task SaveRecurring() => RunModal(async () =>
    {
        if (string.IsNullOrWhiteSpace(_recName) || _recCategoryId == Guid.Empty || _recFundId == Guid.Empty) return;
        // Only an expense can service a loan; switching the kind to income drops any stale link rather than sending it.
        Guid? debtId = _recKind == RecurringKind.Expense && _recDebtId != Guid.Empty ? _recDebtId : null;
        if (_recEditId == Guid.Empty)
            await State.AddRecurring(_recName, _recKind, _recMode, _recAmount, _recDay, _recCategoryId, _recFundId, _recIcon, _recAutoPost, debtId);
        else
            await State.UpdateRecurring(_recEditId, _recName, _recMode, _recAmount, _recDay, _recCategoryId, _recFundId, _recIcon, _recAutoPost, debtId);
        _modal = Modal.Recurring;
