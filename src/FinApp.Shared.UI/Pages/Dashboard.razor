    // Per-fund reconciliation gaps (entered opening − computed closing) surfaced at rollover; null = not shown.
    private List<(Guid FundId, decimal Gap)>? _reconcileGaps;

    /// <summary>Non-synced funds whose entered real opening differs from what the ledger computed — i.e. a
    /// transaction wasn't logged. Synced funds are excluded (bank sync accounts for those).</summary>
    private List<(Guid FundId, decimal Gap)> ComputeReconcileGaps()
    {
        var gaps = new List<(Guid, decimal)>();
        foreach (var f in State.SelectableFunds)   // SelectableFunds already excludes the synced fund
        {
            var entered = _realOpenings.TryGetValue(f.Id, out var v) ? v : 0m;
            var gap = Math.Round(entered - State.FundBalance(f.Id).Amount, 2);
            if (Math.Abs(gap) >= 0.01m) gaps.Add((f.Id, gap));
        }
        return gaps;
    }

    private Task StartNextMonth() => RunModal(async () =>
    {
        var gaps = ComputeReconcileGaps();
        if (gaps.Count > 0) { _reconcileGaps = gaps; return; }   // warn first — the user picks what to do
        await DoRolloverAsync();
    });

    private Task RolloverIgnoringGaps() => RunModal(DoRolloverAsync);

    private Task RolloverWithAdjustments() => RunModal(async () =>
    {
        // Log the drift as recategorizable "Adjustment" entries in the closing period, so its books reconcile.
        if (_reconcileGaps is { } gaps)
            await State.RecordReconciliationAdjustments(gaps, State.Period.To);
        await DoRolloverAsync();
    });

    private async Task DoRolloverAsync()
    {
        // Prefer the balance recorded at the closing period's month-end (from sync history) so a late rollover
        // doesn't leak next-month activity in; fall back to the live balance if there's no snapshot that old.
        decimal? syncedClose = null;
        if (State.HasSyncedFund)
        {
            try { syncedClose = (await Api.GetBankBalanceAtAsync(State.CurrentAccountId, State.Period.To)).Balance; } catch { /* fall back */ }
            syncedClose ??= _bankStatus?.Balance;
        }
        await State.StartNextPeriod(_copyBudgets, _realOpenings, _adjustBudgets, syncedClose);
        _reconcileGaps = null;
        CloseModal();
    }

