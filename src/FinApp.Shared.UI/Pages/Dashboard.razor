                        </select>
                    }
                    <button class="exp-edit" title="@Loc["Save"]" @onclick="SaveRuleEdit" disabled="@_bankBusy"><Icon Name="check" /></button>
                    <button class="exp-edit" title="@Loc["Cancel"]" @onclick="CancelRuleEdit" disabled="@_bankBusy"><Icon Name="x" /></button>
                </span>
            }
            else
            {
                <span class="row-actions">
                    <button class="exp-edit" title="@Loc["Edit rule: where it files and which words match"]" @onclick="() => BeginRuleEdit(ctx.Key)" disabled="@_bankBusy"><Icon Name="pencil" /></button>
                    <button class="exp-edit" title="@Loc["Remove"]" @onclick="() => RemoveBankRuleKey(ctx.Key)" disabled="@_bankBusy"><Icon Name="trash" /></button>
                </span>
            }
        </li>;

    private Guid RowCat(string id) => _bankRowCat.TryGetValue(id, out var v) ? v : Guid.Empty;
    private Guid RowFund(string id) => _bankRowFund.TryGetValue(id, out var v) ? v : Guid.Empty;
    private string RowCredit(string id) => _bankRowCredit.TryGetValue(id, out var v) ? v : "";

    /// <summary>Linking requires bank-link consent first (recorded each time — re-consent on relink).</summary>
    private void LinkBankAsync() => RequestBankConsent("bank_link",
        Loc["Connect your bank"],
        Loc["You authorize TandemTab to connect to your bank through our regulated provider (Enable Banking) and to read your account details and transactions on a read-only basis, to show them here. No payments are ever made. You can withdraw this at any time by disconnecting. Your email must be verified to connect a bank, and — because this brings real financial data into the account, visible to everyone you share it with — we strongly recommend turning on two-factor authentication first (Profile → Two-factor)."],
        DoLinkBankAsync);

    private async Task DoLinkBankAsync()
    {
        _bankBusy = true; _bankError = null;
        try
        {
            var banks = await State.GetBankInstitutions();
            if (banks.FirstOrDefault() is not { } revolut)
            {
                _bankError = Loc["No Revolut connection is available for your country yet."];
                return;
            }
            var url = await State.StartBankLink(revolut.Name, revolut.Country, revolut.Logo);
            await JS.InvokeVoidAsync("finappNavigate", url);   // full-page hop to the bank's consent page
        }
        catch (Exception ex) { _bankError = ex.Message; }
        finally { _bankBusy = false; }
    }

    private async Task SyncBankAsync()
    {
        _bankBusy = true; _bankError = null;
        try
        {
            await State.SyncBank();
            _bankPending = await State.GetPendingBankTransactions();
            DefaultBankPickers();
            await AutoHandleMappedDebitsAsync();
        }
        catch (Exception ex) { _bankError = ex.Message; }
        finally { _bankBusy = false; }
    }

    /// <summary>Auto-file expenses for merchants already mapped to a category, once a fund is synced (feature 2.3
    /// auto-handling). They post to the synced fund and drop out of the review list until the rule is removed.</summary>
    private async Task AutoHandleMappedDebitsAsync()
    {
        if (!State.HasSyncedFund || !State.IsPeriodOpen) return;
        // Only auto-file transactions that fall inside the current period. The sync window is ~90 days, so
        // _bankPending also holds prior-period rows; filing those here would clamp their date onto this period's
        // first day and dump a whole prior month into the current category. They stay pending for their own period.
        foreach (var tx in BankDebits())
        {
            if (MappingFor(tx.Description) is not { Kind: "category" } m) continue;
            if (!State.CategoryOptions.Any(c => c.Category.Id == m.TargetId)) continue;
            // Don't auto-post over a likely duplicate (a recurring-posted or already-imported expense of the same
            // amount): leave it pending so the review screen surfaces the "you already logged this" suggestion.
            if (State.HasLikelyDuplicateExpense(tx.Amount, tx.Date)) continue;
            try
            {
                await State.ConfirmBankTransaction(tx.ExternalId, m.TargetId, Math.Abs(tx.Amount), State.SyncedFundId, tx.Description, ClampToPeriod(tx.Date), autoFiled: true);
                _bankPending.RemoveAll(p => p.ExternalId == tx.ExternalId);
            }
            catch { /* leave it in the list for manual handling */ }
        }
        await AutoHandleMappedCreditsAsync();
    }

    /// <summary>Auto-apply money-in whose merchant is mapped to a source fund (Kind "fund"): create the transfer
    /// from that fund into the synced fund, marked auto-filed, so the user doesn't confirm each one by hand.</summary>
    private async Task AutoHandleMappedCreditsAsync()
    {
        if (!State.HasSyncedFund || !State.IsPeriodOpen) return;
        // Current-period rows only — see the note in AutoHandleMappedDebitsAsync (prior-period rows would be
        // clamped onto this period's first day). They stay pending until their own period is viewed.
        foreach (var tx in BankCredits())
        {
            if (MappingFor(tx.Description) is not { Kind: "fund" } m) continue;
            if (m.TargetId == State.SyncedFundId) continue;                        // source can't be the synced fund itself
            if (!State.SelectableFunds.Any(f => f.Id == m.TargetId)) continue;     // rule points at a fund that's gone
            try
            {
                await State.ConfirmBankMoneyIn(tx.ExternalId, $"fund:{m.TargetId}", tx.Amount, tx.Description, ClampToPeriod(tx.Date), autoFiled: true);
                _bankPending.RemoveAll(p => p.ExternalId == tx.ExternalId);
            }
            catch { /* leave it in the list for manual handling */ }
        }
    }

    private async Task DisconnectBankAsync()
    {
        _bankBusy = true; _bankError = null;
        try
        {
            await State.DisconnectBank();
            _bankPending = [];
            await LoadBankAsync();   // refresh status → panel returns to the "Link Revolut" state
        }
        catch (Exception ex) { _bankError = ex.Message; }
        finally { _bankBusy = false; }
    }

    // Bank de-duplication: suggestions for the current debits, and the set the user chose to "keep both" on.
    private readonly HashSet<string> _dupDismissed = new();
    // Rows whose confirm is in flight — the dup-hint is suppressed for them so it can't flash against the
    // expense they're in the middle of posting (which isn't removed from the pending list until the await returns).
    private readonly HashSet<string> _rowSaving = new();
    private IReadOnlyDictionary<string, BudgetingState.DuplicateSuggestion> DupSuggestions =>
        State.BankDuplicateSuggestions(BankDebits());

    /// <summary>Replace a manual entry with the incoming bank transaction (drops the duplicate, keeps the bank one).</summary>
    private async Task ReplaceDupRow(PendingBankTransactionDto tx, BudgetingState.DuplicateSuggestion dup)
    {
        _bankBusy = true; _bankError = null;
        try
        {
            await State.ReplaceWithBankTransaction(tx.ExternalId, dup.ExpenseId, Math.Abs(tx.Amount), ClampToPeriod(tx.Date), tx.Description);
            _bankPending.RemoveAll(p => p.ExternalId == tx.ExternalId);
            _dupDismissed.Remove(tx.ExternalId);
        }
        catch (Exception ex) { _bankError = ex.Message; }
        finally { _bankBusy = false; }
    }

    private async Task ConfirmBankRow(PendingBankTransactionDto tx)
    {
        var cat = RowCat(tx.ExternalId);
        // Bank expenses come from the linked account, so they always post to the synced fund (which isn't
        // debited — the real bank balance handles it). Fall back to the row's fund only if no fund is synced yet.
        var fund = State.HasSyncedFund ? State.SyncedFundId : RowFund(tx.ExternalId);
        if (cat == Guid.Empty || fund == Guid.Empty) { _bankError = Loc["Pick a category first."]; return; }
        _bankBusy = true; _bankError = null; _rowSaving.Add(tx.ExternalId);
        try
        {
            await State.ConfirmBankTransaction(tx.ExternalId, cat, Math.Abs(tx.Amount), fund, tx.Description, ClampToPeriod(tx.Date));
            _bankPending.RemoveAll(p => p.ExternalId == tx.ExternalId);
        }
        catch (Exception ex) { _bankError = ex.Message; }
        finally { _bankBusy = false; _rowSaving.Remove(tx.ExternalId); }
    }

    private PendingBankTransactionDto? _bankXferTx;   // the money-out row being routed as a transfer (Modal.BankTransfer)

    /// <summary>Open the "record this money-out as a transfer" modal for a debit row, defaulting the destination to
    /// the first non-synced fund (reuses the shared destination picker: this account's funds + other accounts).</summary>
    private async Task OpenBankTransfer(PendingBankTransactionDto tx)
    {
        _bankXferTx = tx;
        _mTransferFromId = State.SyncedFundId;
        _mTransferDestId = State.RootFunds.FirstOrDefault(f => f.Id != State.SyncedFundId)?.Id
            ?? State.TransferableAccounts.FirstOrDefault()?.Id ?? Guid.Empty;
        _mTransferDestFundId = Guid.Empty;
        _modal = Modal.BankTransfer;
        if (MTransferDestIsAccount) await OnModalDestChanged();
    }

    private Task ConfirmBankTransferRow() => RunModal(async () =>
    {
        if (_bankXferTx is not { } tx) return;
        if (_mTransferDestId == Guid.Empty || _mTransferDestId == State.SyncedFundId) return;
        var destination = MTransferDestIsAccount
            ? $"acct:{_mTransferDestId}:{_mTransferDestFundId}"
            : $"fund:{_mTransferDestId}";
        await State.ConfirmBankMoneyOutAsTransfer(tx.ExternalId, destination, Math.Abs(tx.Amount), tx.Description, ClampToPeriod(tx.Date));
        _bankPending.RemoveAll(p => p.ExternalId == tx.ExternalId);
        _bankXferTx = null;
        CloseModal();
        await LoadBankAsync();
    });

    /// <summary>Turn a bank money-in into a movement into the synced fund (source picked/mapped).</summary>
    private async Task ConfirmMoneyInRow(PendingBankTransactionDto tx)
    {
        var source = RowCredit(tx.ExternalId);
        if (string.IsNullOrEmpty(source)) { _bankError = Loc["Pick where this money came from first."]; return; }
        _bankBusy = true; _bankError = null;
        try
        {
            await State.ConfirmBankMoneyIn(tx.ExternalId, source, tx.Amount, tx.Description, ClampToPeriod(tx.Date));
            _bankPending.RemoveAll(p => p.ExternalId == tx.ExternalId);
        }
        catch (Exception ex) { _bankError = ex.Message; }
        finally { _bankBusy = false; }
    }

    private async Task DismissBankRow(PendingBankTransactionDto tx)
    {
        _bankBusy = true; _bankError = null;
        try
        {
            await State.DismissBankTransaction(tx.ExternalId);
