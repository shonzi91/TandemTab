        // A repeat is a NEW purchase happening now — deliberately not the old row's time, which would date the
        // fresh entry to whenever the original one was bought.
        _expenseTime = _expenseDate == State.TodayDate ? TimeOnly.FromDateTime(DateTime.Now) : null;
        _expenseHadTime = false;
