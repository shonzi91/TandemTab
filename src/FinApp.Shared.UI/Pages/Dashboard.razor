    // Rotating over-budget alert: like the spare→debt nudge, but for NON-essential categories that are over budget.
    private int _overIndex = Random.Shared.Next(0, 997);

    /// <summary>One rotating, dismissible over-budget alert for a <b>non-essential</b> category (essentials like rent
    /// aren't actionable, so they're never nagged). Rotate with ↻, dismiss for the period. Null when none apply.</summary>
    private (Guid CatId, string Title, string Desc)? OverBudgetTip()
    {
        if (!State.IsPeriodOpen) return null;
        if (_nudgeDismissPeriod != State.PeriodNumber) { _nudgeDismissPeriod = State.PeriodNumber; _dismissedNudges.Clear(); }
        var over = OverBudgetCandidates();
        if (over.Count == 0) return null;
        var pick = over[_overIndex % over.Count];
        return (pick.CatId,
            string.Format(Loc["You're {0} over your {1} budget"], Fmt(pick.Over), pick.Name),
            Loc["A non-essential category — easing off here frees up cash for savings or debt."]);
    }

    /// <summary>Non-essential categories currently over their budget (biggest overspend first), minus period dismissals.</summary>
    private List<(Guid CatId, string Name, decimal Over)> OverBudgetCandidates() =>
        State.CategoryOptions
            .Where(c => !c.Category.IsEssential && State.HasBudget(c.Category.Id) && !_dismissedNudges.Contains(c.Category.Id))
            .Select(c => { var cov = State.Coverage(c.Category.Id); return (c.Category.Id, c.Category.Name, Over: cov.Spent.Amount - cov.Allocated.Amount); })
            .Where(c => c.Over > 0m)
            .OrderByDescending(c => c.Over).ToList();

    private void DismissOverBudget(Guid catId) { _dismissedNudges.Add(catId); _overIndex++; }

