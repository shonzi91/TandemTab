    /// <summary>Linking requires bank-link consent first (recorded each time — re-consent on relink).</summary>
    private void LinkBankAsync() => RequestBankConsent("bank_link",
        Loc["Connect your bank"],
        Loc["You authorize TandemTab to connect to your bank through our regulated provider (Enable Banking) and to read your account details and transactions on a read-only basis, to show them here. No payments are ever made. You can withdraw this at any time by disconnecting. Your email must be verified to connect a bank, and — because this brings real financial data into the account, visible to everyone you share it with — we strongly recommend turning on two-factor authentication first (Profile → Two-factor)."],
        DoLinkBankAsync);

    private async Task DoLinkBankAsync()
    {
        _bankBusy = true; _bankError = null;
        try
        {
            var banks = await State.GetBankInstitutions();
            if (banks.FirstOrDefault() is not { } revolut)
            {
                _bankError = Loc["No Revolut connection is available for your country yet."];
                return;
            }
            var url = await State.StartBankLink(revolut.Name, revolut.Country, revolut.Logo);
            await JS.InvokeVoidAsync("finappNavigate", url);   // full-page hop to the bank's consent page
        }
        catch (Exception ex) { _bankError = ex.Message; }
        finally { _bankBusy = false; }
    }

    private async Task SyncBankAsync()
    {
        _bankBusy = true; _bankError = null;
        try
        {
            await State.SyncBank();
            _bankPending = await State.GetPendingBankTransactions();
            DefaultBankPickers();
            await AutoHandleMappedDebitsAsync();
            await LoadDupDismissedAsync();
        }
        catch (Exception ex) { _bankError = ex.Message; }
        finally { _bankBusy = false; }
    }

    /// <summary>Auto-file expenses for merchants already mapped to a category, once a fund is synced (feature 2.3
    /// auto-handling). They post to the synced fund and drop out of the review list until the rule is removed.</summary>
    private async Task AutoHandleMappedDebitsAsync()
    {
        if (!State.HasSyncedFund || !State.IsPeriodOpen) return;
        // Only auto-file transactions that fall inside the current period. The sync window is ~90 days, so
        // _bankPending also holds prior-period rows; filing those here would clamp their date onto this period's
        // first day and dump a whole prior month into the current category. They stay pending for their own period.
        foreach (var tx in BankDebits())
        {
            if (MappingFor(tx.Description) is not { Kind: "category" } m) continue;
            if (!State.CategoryOptions.Any(c => c.Category.Id == m.TargetId)) continue;
            // Don't auto-post over a likely duplicate (a recurring-posted or already-imported expense of the same
            // amount): leave it pending so the review screen surfaces the "you already logged this" suggestion.
            // ★ On the tight window now, and reading the merchant text — a rule that stops firing for four days
            // after each charge looks broken, and the user never learns why. See HasLikelyDuplicateExpense.
            if (State.HasLikelyDuplicateExpense(tx.Amount, tx.Date, tx.Description)) continue;
            // The rule's label, if it still exists — a tag deleted since the rule was written just doesn't apply.
            var ruleTag = m.TagId is { } rt && State.AllTags.Any(t => t.Id == rt) ? rt : (Guid?)null;
            try
            {
                await State.ConfirmBankTransaction(tx.ExternalId, m.TargetId, Math.Abs(tx.Amount), State.SyncedFundId, tx.Description, ClampToPeriod(tx.Date), autoFiled: true, tagId: ruleTag);
                _bankPending.RemoveAll(p => p.ExternalId == tx.ExternalId);
            }
            catch { /* leave it in the list for manual handling */ }
        }
        await AutoHandleMappedCreditsAsync();
    }

    /// <summary>Auto-apply money-in whose merchant is mapped to a source fund (Kind "fund"): create the transfer
    /// from that fund into the synced fund, marked auto-filed, so the user doesn't confirm each one by hand.</summary>
    private async Task AutoHandleMappedCreditsAsync()
    {
        if (!State.HasSyncedFund || !State.IsPeriodOpen) return;
        // Current-period rows only — see the note in AutoHandleMappedDebitsAsync (prior-period rows would be
        // clamped onto this period's first day). They stay pending until their own period is viewed.
        foreach (var tx in BankCredits())
        {
            if (MappingFor(tx.Description) is not { Kind: "fund" } m) continue;
            if (m.TargetId == State.SyncedFundId) continue;                        // source can't be the synced fund itself
            if (!State.SelectableFunds.Any(f => f.Id == m.TargetId)) continue;     // rule points at a fund that's gone
            try
            {
                await State.ConfirmBankMoneyIn(tx.ExternalId, $"fund:{m.TargetId}", tx.Amount, tx.Description, ClampToPeriod(tx.Date), autoFiled: true);
                _bankPending.RemoveAll(p => p.ExternalId == tx.ExternalId);
            }
            catch { /* leave it in the list for manual handling */ }
        }
    }

    private async Task DisconnectBankAsync()
    {
        _bankBusy = true; _bankError = null;
        try
        {
            await State.DisconnectBank();
            _bankPending = [];
            await LoadBankAsync();   // refresh status → panel returns to the "Link Revolut" state
        }
        catch (Exception ex) { _bankError = ex.Message; }
        finally { _bankBusy = false; }
    }

    // Bank de-duplication: suggestions for the current debits, and the set the user has answered "not a duplicate"
    // on. ★ That answer is kept in localStorage per account (below): the hint is a guess about rows that stay
    // pending for days, and a guess the user has already corrected must not come back every time the app loads.
    private readonly HashSet<string> _dupDismissed = new();
    private IReadOnlyDictionary<string, BudgetingState.DuplicateSuggestion> DupSuggestions =>
        State.BankDuplicateSuggestions(BankDebits());

    private string BankDupKey() => $"finapp_bankdup_{State.CurrentAccountId}";

    /// <summary>"Not a duplicate" — hide the hint for this row and remember that, across reloads.</summary>
    private async Task DismissDupRow(string externalId)
    {
        _dupDismissed.Add(externalId);
        await SaveDupDismissedAsync();
    }

    private async Task SaveDupDismissedAsync()
    {
        try { await JS.InvokeVoidAsync("localStorage.setItem", BankDupKey(), string.Join('\n', _dupDismissed)); }
        catch { /* no storage — the dismissal still holds for this session */ }
    }

    /// <summary>Restore the "not a duplicate" answers for this account, dropping any whose transaction is no longer
    /// pending — otherwise the list would grow for ever on ids nothing will ever ask about again.</summary>
    private async Task LoadDupDismissedAsync()
    {
        _dupDismissed.Clear();
        string? raw = null;
        try { raw = await JS.InvokeAsync<string?>("localStorage.getItem", BankDupKey()); } catch { /* no storage */ }
        foreach (var xid in (raw ?? "").Split('\n', StringSplitOptions.RemoveEmptyEntries)) _dupDismissed.Add(xid);
        if (_dupDismissed.RemoveWhere(xid => !_bankPending.Any(p => p.ExternalId == xid)) > 0)
            await SaveDupDismissedAsync();
    }

    /// <summary>Replace a manual entry with the incoming bank transaction (drops the duplicate, keeps the bank one).</summary>
    private async Task ReplaceDupRow(PendingBankTransactionDto tx, BudgetingState.DuplicateSuggestion dup)
    {
        _bankBusy = true; _bankError = null;
        try
        {
            await State.ReplaceWithBankTransaction(tx.ExternalId, dup.ExpenseId, Math.Abs(tx.Amount), ClampToPeriod(tx.Date), tx.Description);
            _bankPending.RemoveAll(p => p.ExternalId == tx.ExternalId);
            if (_dupDismissed.Remove(tx.ExternalId)) await SaveDupDismissedAsync();
        }
        catch (Exception ex) { _bankError = ex.Message; }
        finally { _bankBusy = false; }
    }

    /// <summary>
    /// ✓ on a review row: file this debit as an expense, here, without opening anything. The row already carries
    /// every answer the app needs — the category (from the merchant's rule or the select beside it), the wallet, the
    /// merchant as the note, and the bank's own date and time.
    /// <para>★ The trip is attached the same way the review form attaches it — from the <b>transaction's</b> date,
    /// not today's. Card charges are reviewed after you are home, and an inline ✓ that quietly dropped the holiday
    /// off every charge would be a worse answer than the modal it replaces, not a faster one.</para>
    /// </summary>
    private async Task AcceptBankRow(PendingBankTransactionDto tx)
    {
        var category = RowCat(tx.ExternalId);
        if (category == Guid.Empty) { _bankError = Loc["Pick a category first."]; return; }
        var fund = State.HasSyncedFund ? State.SyncedFundId : RowFund(tx.ExternalId);
        if (fund == Guid.Empty) { _bankError = Loc["Pick a wallet first."]; return; }
        var trip = State.AllTrips.FirstOrDefault(tr => tx.Date >= tr.From && tx.Date <= tr.To)?.Id;
        // A rule that also names a label applies it here too, exactly as it does when auto-filing (O2b).
        var tag = MappingFor(tx.Description) is { Kind: "category" } m && m.TagId is { } rt && State.AllTags.Any(t => t.Id == rt) ? rt : (Guid?)null;

        _bankBusy = true; _bankError = null;
        try
        {
            await State.ConfirmBankTransaction(tx.ExternalId, category, Math.Abs(tx.Amount), fund, tx.Description,
                ClampToPeriod(tx.Date), tagId: tag, tripId: trip, time: tx.Time);
            _bankPending.RemoveAll(p => p.ExternalId == tx.ExternalId);
        }
        catch (Exception ex) { _bankError = ex.Message; }
        finally { _bankBusy = false; }
    }

    // --- Confirming an imported debit: the full review modal (Modal.BankConfirm) -----------------
    private PendingBankTransactionDto? _bcTx;   // the row being reviewed
    private bool _bcRemember;                   // write an auto-file rule for this merchant on confirm

    /// <summary>Whether the "always file this merchant here" rule may be offered at all.
    /// <para>
    /// ★ <b>Never on a trip.</b> Picking a trip settles the category (<see cref="ApplyTripCategoryDefault"/>) and
    /// swaps the tag chips to the trip labels, so a rule written from this form would remember the <i>trip's</i>
    /// category and a <i>trip</i> tag — and then file next month's supermarket run under "Travel / Tickets &amp;
    /// tours". The trip id itself never leaked (auto-filing passes none, see
    /// <see cref="AutoHandleMappedDebitsAsync"/>); its influence did, through the two fields the rule copies.
    /// </para>
    /// <para>
    /// The reverse need is already served and needs nothing here: an expense that auto-filed and then turns out to
    /// belong to a journey is attached from the trip's own screen (<see cref="OpenAttachToTrip"/>).
    /// </para>
    /// <para>One predicate, read by both the markup and <see cref="ConfirmBankFromModal"/>, so the two cannot
    /// drift into disagreeing about when a rule gets written.</para></summary>
    private bool BankRuleOffered => _expTripId == Guid.Empty;

    /// <summary>
    /// Open the review modal for a pending debit, pre-answered as far as the app honestly can: the merchant's saved
    /// rule (or the row's pick) chooses the category, and the trip is the one running <b>on the transaction's own
    /// date</b>.
    /// <para>
    /// ★ That date, not today, is the whole point. Card charges are reviewed days after they are made — usually once
    /// you are home — so defaulting from "is a trip active now" answers a question nobody asked and leaves every
    /// holiday card payment un-attachable without knowing that the trip card has its own attach door.
    /// </para>
    /// </summary>
    private void OpenBankConfirm(PendingBankTransactionDto tx)
    {
        _bcTx = tx;
        _bcRemember = false;
        _bankError = null; _modalError = null;
        var mapped = MappingFor(tx.Description);
        _categoryId = mapped is { Kind: "category" } m && State.CategoryOptions.Any(c => c.Category.Id == m.TargetId)
            ? m.TargetId
            : RowCat(tx.ExternalId);
        _note = tx.Description;
        _expenseDate = ClampToPeriod(tx.Date);
        _expenseTime = tx.Time;   // only when the bank stated one — see Expense.Time
        _fTagId = null; _newTagName = null; _tagFiledTo = null; _tagNewOpen = false;
        // Defaulted, never enforced: the weekly shop still happens on the day you fly home, so "Not a trip" is one tap.
        _expTripId = State.AllTrips.FirstOrDefault(t => tx.Date >= t.From && tx.Date <= t.To)?.Id ?? Guid.Empty;
        _expTripAccountId = Guid.Empty;   // the bank form never reaches across accounts — see OnForeignTripPicked
        ApplyTripCategoryDefault();
        // Pre-load the rule's word chooser so flipping the switch has something to show immediately.
        _pinTokens = BudgetingState.BankTokens(tx.Description).ToList();
        _pinOn = _pinTokens.ToHashSet(StringComparer.Ordinal);
        _modalBack.Push(() => _modal = Modal.BankReview);   // Cancel returns to the list, not out of the review
        _modal = Modal.BankConfirm;
    }

    /// <summary>Back to the review list after handling one row — a statement is read a transaction at a time, and
    /// dropping the user out of the list after each one would make them re-open it for every charge.</summary>
    private void BackToBankReview()
    {
        _bcTx = null;
        _modalError = null;
        _modalBack.Clear();
        _expenseDrafts.Clear();
        _modal = Modal.BankReview;
    }

    private void OnBankRememberChanged(bool on) => _bcRemember = on;

    /// <summary>Save the reviewed transaction as a real expense — with its label, its trip and (optionally) the
    /// auto-file rule that stops the next one asking.</summary>
    private Task ConfirmBankFromModal() => RunModal(async () =>
    {
        if (_bcTx is not { } tx) return;
        // Bank expenses come from the linked account, so they always post to the synced fund (which isn't debited —
        // the real bank balance handles it). Fall back to the row's fund only if no fund is synced yet.
        var fund = State.HasSyncedFund ? State.SyncedFundId : RowFund(tx.ExternalId);
        if (_categoryId == Guid.Empty || fund == Guid.Empty) { _modalError = Loc["Pick a category first."]; return; }

        // The invariant, not a second copy of the UI's condition: whatever the form happened to show, a row filed
        // to a trip never teaches the merchant rule anything. See BankRuleOffered for why.
        var writeRule = _bcRemember && BankRuleOffered;

        // The rule goes first: writing it after the confirm would have nothing left to match, and if the rule write
        // fails the expense should still not be posted twice by a retry.
        if (writeRule)
        {
            var key = string.Join(' ', _pinTokens.Where(_pinOn.Contains));
            if (key.Length == 0) key = string.Join(' ', _pinTokens);
            // ★ The rule remembers the label as well as the category (O2b). Nothing extra is asked for it: the tag
            // picker is right there in this form, and "always file this merchant here" plainly means *here* — the
            // category and the label the user just chose. A merchant filed under Food and labelled "Weekly shop"
            // stops needing the second half typed out every week.
            await State.SetBankMapping(key, "category", _categoryId, _fTagId);
            _bankMappings[key] = ("category", _categoryId, _fTagId);
        }

        await State.ConfirmBankTransaction(tx.ExternalId, _categoryId, Math.Abs(tx.Amount), fund, _note,
            _expenseDate, tagId: _fTagId, tripId: _expTripId == Guid.Empty ? null : _expTripId, time: _expenseTime);
        _bankPending.RemoveAll(p => p.ExternalId == tx.ExternalId);
        // A new rule usually covers other rows waiting in the same review list — clear those rather than making the
        // user confirm the same merchant five more times.
        if (writeRule) await AutoHandleMappedDebitsAsync();
        BackToBankReview();
    });

    /// <summary>"Not an expense" from inside the modal — the same dismissal the ✗ on the row does.</summary>
    private Task DismissFromBankConfirm() => RunModal(async () =>
    {
        if (_bcTx is not { } tx) return;
        await State.DismissBankTransaction(tx.ExternalId);
        _bankPending.RemoveAll(p => p.ExternalId == tx.ExternalId);
        BackToBankReview();
    });

    private PendingBankTransactionDto? _bankXferTx;   // the money-out row being routed as a transfer (Modal.BankTransfer)

    /// <summary>Open the "record this money-out as a transfer" modal for a debit row, defaulting the destination to
    /// the first non-synced fund (reuses the shared destination picker: this account's funds + other accounts).</summary>
    private async Task OpenBankTransfer(PendingBankTransactionDto tx)
    {
        _bankXferTx = tx;
        _mTransferFromId = State.SyncedFundId;
        _mTransferDestId = State.RootFunds.FirstOrDefault(f => f.Id != State.SyncedFundId)?.Id
            ?? State.TransferableAccounts.FirstOrDefault()?.Id ?? Guid.Empty;
        _mTransferDestFundId = Guid.Empty;
        _modal = Modal.BankTransfer;
        if (MTransferDestIsAccount) await OnModalDestChanged();
    }

    private Task ConfirmBankTransferRow() => RunModal(async () =>
    {
        if (_bankXferTx is not { } tx) return;
        if (_mTransferDestId == Guid.Empty || _mTransferDestId == State.SyncedFundId) return;
        var destination = MTransferDestIsAccount
            ? $"acct:{_mTransferDestId}:{_mTransferDestFundId}"
            : $"fund:{_mTransferDestId}";
        await State.ConfirmBankMoneyOutAsTransfer(tx.ExternalId, destination, Math.Abs(tx.Amount), tx.Description, ClampToPeriod(tx.Date));
        _bankPending.RemoveAll(p => p.ExternalId == tx.ExternalId);
        _bankXferTx = null;
        CloseModal();
        await LoadBankAsync();
    });

    /// <summary>Turn a bank money-in into a movement into the synced fund (source picked/mapped).</summary>
    private async Task ConfirmMoneyInRow(PendingBankTransactionDto tx)
    {
        var source = RowCredit(tx.ExternalId);
        if (string.IsNullOrEmpty(source)) { _bankError = Loc["Pick where this money came from first."]; return; }
        _bankBusy = true; _bankError = null;
        try
        {
            await State.ConfirmBankMoneyIn(tx.ExternalId, source, tx.Amount, tx.Description, ClampToPeriod(tx.Date));
            _bankPending.RemoveAll(p => p.ExternalId == tx.ExternalId);
        }
        catch (Exception ex) { _bankError = ex.Message; }
        finally { _bankBusy = false; }
    }

    private async Task DismissBankRow(PendingBankTransactionDto tx)
    {
        _bankBusy = true; _bankError = null;
        try
        {
            await State.DismissBankTransaction(tx.ExternalId);
            _bankPending.RemoveAll(p => p.ExternalId == tx.ExternalId);
        }
        catch (Exception ex) { _bankError = ex.Message; }
        finally { _bankBusy = false; }
    }

    // --- Merchant mapping (feature 2.3) -----------------------------------
    /// <summary>The pin toggle: if this merchant already has a rule, clear it; otherwise open the inline word-chooser
    /// so the user picks which words identify the merchant before the auto-file rule is saved.</summary>
    private Task TogglePin(PendingBankTransactionDto tx)
    {
        if (MappingFor(tx.Description) is not null) return ForgetMapping(tx);   // pinned → unpin
        BeginPinEdit(tx);   // not pinned → choose the matching words, then SavePinEdit
        return Task.CompletedTask;
    }

    // Pin word-chooser state: which review row is choosing its rule tokens, the tokens, and which are selected.
    private string? _pinEditId;
    private List<string> _pinTokens = [];
    private HashSet<string> _pinOn = new(StringComparer.Ordinal);

    private void BeginPinEdit(PendingBankTransactionDto tx)
    {
        _pinEditId = tx.ExternalId;
        _pinTokens = BudgetingState.BankTokens(tx.Description).ToList();
        _pinOn = _pinTokens.ToHashSet(StringComparer.Ordinal);   // start with every word on (most specific)
        _bankError = null;
    }

    private void TogglePinToken(string token)
    {
        if (!_pinOn.Remove(token)) _pinOn.Add(token);
        if (_pinOn.Count == 0) _pinOn.Add(token);   // keep at least one word selected
    }

    /// <summary>Save the auto-file rule from the pin chooser: key = the selected words, target = the row's current
    /// category (debit) or fund/contributor (credit). Then auto-file this merchant's matching pending rows.</summary>
    private async Task SavePinEdit(PendingBankTransactionDto tx)
    {
        var newKey = string.Join(' ', _pinTokens.Where(_pinOn.Contains));
        if (newKey.Length == 0) newKey = string.Join(' ', _pinTokens);
        string kind; Guid target;
        if (tx.Amount < 0) { kind = "category"; target = RowCat(tx.ExternalId); }
        else { var (k, t) = ParseCredit(RowCredit(tx.ExternalId)); kind = k; target = t; }
        // A refund points at one expense, so it can never be a standing rule: the next credit from this merchant
        // would deduct from a charge that has nothing to do with it. Refuse rather than save a rule that misfires.
        if (kind == "refund") { _bankError = Loc["A refund is tied to one expense, so it can't become a merchant rule."]; return; }
        if (target == Guid.Empty) { _bankError = Loc["Pick something to map to first."]; return; }

        _bankBusy = true; _bankError = null;
        try
        {
            await State.SetBankMapping(newKey, kind, target);
            _bankMappings[newKey] = (kind, target, null);
            _pinEditId = null;
            // The new rule covers this merchant's pending rows in the current period — auto-file those so the review
            // list clears itself. Prior-period rows stay pending until their own period is viewed.
            await AutoHandleMappedDebitsAsync();
            await AutoHandleMappedCreditsAsync();
        }
        catch (Exception ex) { _bankError = ex.Message; }
        finally { _bankBusy = false; }
    }

    private async Task ForgetMapping(PendingBankTransactionDto tx)
    {
        _bankBusy = true; _bankError = null;
        try
        {
            await State.RemoveBankMapping(tx.Description);
            _bankMappings.Remove(BudgetingState.BankMatchKey(tx.Description));
        }
        catch (Exception ex) { _bankError = ex.Message; }
        finally { _bankBusy = false; }
    }

    private static (string Kind, Guid Target) ParseCredit(string v) =>
        v.Split(':') is [{ } k, { } g] && Guid.TryParse(g, out var id) ? (k, id) : ("fund", Guid.Empty);

    /// <summary>The friendly name of a saved mapping's target (for the chip), or null if none.</summary>
    private string? MappedLabel(string description)
    {
        if (MappingFor(description) is not { } m) return null;
        var target = m.Kind switch
        {
            "category" => State.CategoryName(m.TargetId),
            "fund" => State.FundName(m.TargetId),
            "contributor" => State.MemberName(m.TargetId),
            _ => null,
        };
        // A rule that also labels says so wherever it names itself — otherwise the tag it applies arrives on the
        // expense with nothing on screen accounting for it.
        if (target is not null && m.TagId is { } tag && State.AllTags.FirstOrDefault(t => t.Id == tag) is { } tagRow)
            target = $"{target} · {tagRow.Name}";
        return target;
    }

    /// <summary>Tooltip for the 🏦 auto-filed badge: names the responsible rule if it still exists.</summary>
    private string AutoFiledTitle(FinApp.Domain.Budgeting.Expense e) =>
        !string.IsNullOrEmpty(e.Note) && MappedLabel(e.Note!) is { } target
            ? $"{Loc["Auto-filed from a saved bank rule"]}: {e.Note} → {target}"
            : Loc["Filed automatically from your bank"];

    /// <summary>Tooltip for an auto-filed fund transfer: names the responsible money-in rule if it still exists.</summary>
    private string AutoFiledTransferTitle(string? note) =>
        !string.IsNullOrEmpty(note) && MappingFor(note!) is { Kind: "fund" } m
            ? $"{Loc["Auto-filed from a saved money-in rule"]}: {note} → {State.FundName(m.TargetId)}"
            : Loc["Filed automatically from your bank"];

    /// <summary>Saved money-in rules (merchant match-keys) that auto-file into a transfer from this fund.</summary>
    private IEnumerable<string> FundRulesFor(Guid fundId) =>
        _bankMappings.Where(kv => kv.Value.Kind == "fund" && kv.Value.TargetId == fundId).Select(kv => kv.Key);

    /// <summary>Remove a saved bank rule by its merchant match-key, after a confirmation prompt. Used wherever
    /// auto-file rules are listed (category-, fund-, expense- and transfer-edit views).</summary>
    private async Task RemoveBankRuleKey(string matchKey)
    {
        bool ok;
        try { ok = await JS.InvokeAsync<bool>("finappConfirm", Loc["Remove this auto-file rule? Transactions from this merchant will no longer be filed automatically. Existing entries stay."]); }
        catch { ok = true; }   // host without the helper — don't block the action
        if (!ok) return;
        if (_ruleEditKey == matchKey) _ruleEditKey = null;
        _bankBusy = true;
        try { await State.RemoveBankMapping(matchKey); _bankMappings.Remove(matchKey); _editCatVendors.Remove(matchKey); }
        catch { /* ignore — best effort */ }
        finally { _bankBusy = false; }
    }

    // --- Inline rule editing (change where a merchant's imports file + which tokens match) --------
    private string? _ruleEditKey;   // the match-key being edited (null = none)
    private Guid _ruleEditTarget;
    private List<string> _ruleEditTokens = [];   // the rule's tokens, in order; a subset is "on" (selected) for matching
    private HashSet<string> _ruleEditOn = new(StringComparer.Ordinal);

    private void BeginRuleEdit(string matchKey)
    {
        _ruleEditKey = matchKey;
        _ruleEditTarget = _bankMappings.TryGetValue(matchKey, out var m) ? m.TargetId : Guid.Empty;
        _ruleEditTokens = BudgetingState.BankTokens(matchKey).ToList();
        _ruleEditOn = _ruleEditTokens.ToHashSet(StringComparer.Ordinal);   // start with every token on
    }

    private void ToggleRuleToken(string token)
    {
        if (!_ruleEditOn.Remove(token)) _ruleEditOn.Add(token);   // keep at least one token selected
        if (_ruleEditOn.Count == 0) _ruleEditOn.Add(token);
    }

    private void CancelRuleEdit() => _ruleEditKey = null;

    /// <summary>Persist edits to the rule being edited: a new target (category/fund) and/or a narrowed set of match
    /// tokens. Narrowing tokens re-keys the rule (remove old key, add the new token-key) so it matches on just the
    /// merchant words the user kept.</summary>
    private async Task SaveRuleEdit()
    {
        if (_ruleEditKey is not { } key || !_bankMappings.TryGetValue(key, out var existing))
        {
            _ruleEditKey = null;
            return;
        }
        var target = _ruleEditTarget == Guid.Empty ? existing.TargetId : _ruleEditTarget;
        var newKey = string.Join(' ', _ruleEditTokens.Where(_ruleEditOn.Contains));
        if (newKey.Length == 0) newKey = key;
        if (newKey == key && target == existing.TargetId) { _ruleEditKey = null; return; }   // nothing changed

        _bankBusy = true; _bankError = null;
        try
        {
            if (newKey != key)
            {
                await State.RemoveBankMapping(key);
                _bankMappings.Remove(key);
                var idx = _editCatVendors.IndexOf(key);
                if (idx >= 0) _editCatVendors[idx] = newKey;
            }
            // The rule's label is not editable here (this row edits where it files and which words match), so it is
            // carried across rather than dropped — SetBankMapping writes the rule whole, and an omitted tag clears it.
            await State.SetBankMapping(newKey, existing.Kind, target, existing.TagId);
            _bankMappings[newKey] = (existing.Kind, target, existing.TagId);
            // A category rule re-pointed elsewhere no longer belongs to the category being edited.
            if (existing.Kind == "category" && _modal == Modal.EditCat && target != _modalCatId)
                _editCatVendors.Remove(newKey);
            _ruleEditKey = null;
        }
        catch (Exception ex) { _bankError = ex.Message; }
        finally { _bankBusy = false; }
    }

    /// <summary>Open the Spending tab on the full grouped expenses list (the default view).</summary>
    private void ShowExpensesTab()
    {
        _tab = Tab.Budgets;
        _calendar = false;
        _dayView = null;   // default to the grouped all-dates list, not a single day
    }

    /// <summary>
    /// Open the Spending tab on <b>By budgets</b> — where budgets are actually adjusted.
    /// <para>Used by every route whose next step is "now change a budget": the "trim a budget" link in the
    /// over-planned alert, and the end of a period rollover. Landing those on the By-date ledger (the tab's
    /// default) drops the user one tap short of the thing they just agreed to do, on a view that can't do it.</para>
    /// </summary>
    private void ShowBudgetsTab()
    {
        ShowExpensesTab();
        SwitchToByBudgets();
    }

    /// <summary>Open the Spending tab on <b>Trips</b> with one trip's recap already expanded.
    /// <para>Where the Home trip banner and the bell's departure nudge both land: "tell me more" about a trip means
    /// its recap, not the ledger — and the ledger is scoped to one period, which is the one view that cannot answer
    /// a question about a trip.</para></summary>
    private void ShowTripsTab(Guid tripId)
    {
        ShowExpensesTab();
        _spendView = SpendView.Trips;
        _expandedTripId = tripId;
        _ = LoadForeignTripsAsync();
    }

    /// <summary>Open the Trips view and gather any spend other accounts hold against these trips (D1).
    /// <para>★ Fired on OPEN, not per render: the recaps are read from markup and cannot be async, so the fetch has
    /// to happen before them. The view renders immediately from what this account knows and re-renders when the
    /// rest lands — which is also why the foreign share is its own visible line rather than a total that grows
    /// under the reader a second after they read it.</para>
    /// <para>Costs nothing at all on an account nobody has shared a trip into: the load is bounded by each trip's
    /// own source-account directory, and almost every trip's is empty.</para></summary>
    private void ShowTripsView()
    {
        _spendView = SpendView.Trips;
        _ = LoadForeignTripsAsync();
    }

    private async Task LoadForeignTripsAsync()
    {
        try { await State.LoadForeignTripExpensesAsync(); }
        catch { /* the trips still render with what this account can see — see the method's own note */ }
        StateHasChanged();
    }

    private DateOnly ClampToPeriod(DateOnly d) =>
        d < State.Period.From ? State.Period.From : d > State.Period.To ? State.Period.To : d;

    private void OnChanged()
    {
        ResetPickers();
        // Account switched (e.g. via the account switcher) → refresh the per-account bank connection. Swap straight to
        // the NEW account's last-known bank figures (cached, or null if never loaded) so the previous account's values
        // can't bleed onto it AND there's no blank flash while the network call runs — then refresh in the background.
        // Claim the account id up front so a repeat OnChanged before the reload finishes can't re-fire it.
        if (_bankStatus is not null && _bankAccountId != State.CurrentAccountId)
        {
            _bankAccountId = State.CurrentAccountId;
            _bankStatus = _bankStatusByAccount.GetValueOrDefault(_bankAccountId);
            _ = ReloadBankOnAccountChangeAsync();
        }
        InvokeAsync(StateHasChanged);
    }

    private async Task ReloadBankOnAccountChangeAsync()
    {
        await LoadBankAsync();
        if (_modal == Modal.ExternalAccounts && _bankStatus?.Enabled != true) _modal = Modal.None;   // vanished for this account
        await SyncOnOpenAsync();   // opening/switching to this account fetches fresh transactions (throttled)
        await InvokeAsync(StateHasChanged);
    }
