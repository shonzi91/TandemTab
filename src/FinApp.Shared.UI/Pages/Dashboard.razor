    private void OpenAddTrip()
    {
        // ★ Trips are Pro, whole (owner's call). The old rule gave Free one LIVE trip and charged for planning a
        // second alongside it; the gate is on the first one now. The server enforces the same (POST /trips), and
        // reading, detaching and deleting stay free there so a downgrade never traps anything.
        if (!Gate.Require(PlanFeatures.Trips)) return;
