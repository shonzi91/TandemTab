    protected override async Task OnInitializedAsync()
    {
        State.Changed += OnChanged;
        Loc.Changed += OnLocChanged;
        await State.InitializeAsync();
        ResetPickers();

        // On phones, open the Expenses tab first so adding an expense is one tap away.
        try { if (await JS.InvokeAsync<int>("finappViewportWidth") is > 0 and <= 720) ShowExpensesTab(); }
        catch { /* host without the helper (e.g. MAUI) — stay on Account */ }

        await LoadBankAsync();
        await SyncOnOpenAsync();          // pull fresh bank transactions on entry (throttled; no-op mid bank-link return)
        await HandleBankReturnAsync();
        await MaybePromptOnEntryAsync();
    }

    // Stamp any newly-earned achievement with today's date after each render. Only persists when something changed
    // (see StampAchievementsAsync), so it converges and doesn't loop.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (State.IsReady && State.HasAccounts)
        {
            await State.StampAchievementsAsync(_achievements, Fmt, Loc.T);
            // Auto-post any due Fixed items opted into it. Converges (items are marked handled synchronously), so this
            // runs at most once per due item; the returned notice surfaces the move in the bell (never silent).
            var posted = await State.AutoPostDueRecurringAsync();
            if (posted.Count > 0) { _autoPostedNotices.AddRange(posted); StateHasChanged(); }
        }
    }

    /// <summary>The compact Home strip: your most-recent earned milestones (with their dates) plus the single closest
    /// locked one to chase. The full catalogue lives in the Achievements modal.</summary>
    private IReadOnlyList<(Achievement A, DateOnly? On)> HomeMilestones()
    {
        var log = State.Account.AchievementLog;
        var catalog = _achievements.Build(State.Account, Fmt, Loc.T);
        var result = catalog.Where(a => a.Earned)
            .Select(a => (A: a, On: log.TryGetValue(a.Key, out var d) ? (DateOnly?)d : null))
            .OrderByDescending(x => x.On ?? DateOnly.MinValue).Take(3).ToList();
        var next = catalog.Where(a => !a.Earned).OrderByDescending(a => a.Percent ?? 0).FirstOrDefault();
        if (next is not null) result.Add((next, null));
        return result;
    }

    /// <summary>How long a bank connection stays "fresh" after a sync before we'll call the provider again on
    /// open/switch. Keeps the opened account current without a live call every time, and because the last-sync
    /// time is stored server-side, a sync on one device counts for every device.</summary>
    private static readonly TimeSpan BankSyncFreshFor = TimeSpan.FromMinutes(15);

    /// <summary>True when the current connection is linked but hasn't been synced within the freshness window.</summary>
    private bool BankSyncDue =>
        _bankStatus?.Connected == true &&
        (_bankStatus.LastSyncedAt is not { } last || DateTimeOffset.UtcNow - last > BankSyncFreshFor);

    /// <summary>Pull fresh transactions from the linked bank when an account is opened or switched — but only if
    /// the last sync (tracked server-side, so it counts across devices) is older than <see cref="BankSyncFreshFor"/>.
    /// This keeps the account current on open without firing a provider call every time it's reopened. Silent when
    /// off/unconnected, not yet due, mid bank-link return (that flow syncs itself), or the fetch fails.</summary>
    private async Task SyncOnOpenAsync()
    {
        if (!BankSyncDue) return;
        if (new Uri(Nav.Uri).Query.Contains("bank=", StringComparison.Ordinal)) return;
        try
        {
            await State.SyncBank();
            _bankStatus = await State.GetBankStatus();   // refresh LastSyncedAt (restarts the cooldown) + balance
            _bankPending = await State.GetPendingBankTransactions();
            DefaultBankPickers();
            await AutoHandleMappedDebitsAsync();
        }
        catch { /* offline / rate-limited — leave staged rows as-is; the manual 🔄 Refresh still works */ }
    }

    /// <summary>On entry: if there's more than one account, ask which to work in; then (or for a single account)
    /// auto-open the bank-review modal when there are unreviewed imports.</summary>
    private async Task MaybePromptOnEntryAsync()
    {
        if (_modal != Modal.None) return;   // don't override a modal opened by e.g. the bank-consent return
        if (State.Accounts.Count > 1 && !_entryAccountPicked)
        {
            _modal = Modal.PickAccount;
            return;   // the review check runs once they've picked (PickAccountOnEntry)
        }
        await MaybeOpenBankReviewAsync();
    }

    private async Task PickAccountOnEntry(Guid accountId)
    {
        _entryAccountPicked = true;
        if (accountId != State.CurrentAccountId)
        {
            await State.SwitchAccount(accountId);
            await LoadBankAsync();
        }
        await SyncOnOpenAsync();   // fetch fresh transactions for the picked account (throttled)
        CloseModal();
        await MaybeOpenBankReviewAsync();
    }

    /// <summary>Auto-open the bank-review modal when the current account has a synced bank with unreviewed
    /// transactions the user hasn't already dismissed — re-prompting only once a newer transaction arrives.</summary>
    private async Task MaybeOpenBankReviewAsync()
    {
        if (_modal != Modal.None || _bankStatus?.Connected != true) return;
        var pending = BankRowsForPeriod();
        if (pending.Count == 0) return;
        var newest = NewestPendingId(pending);
        string? dismissed = null;
        try { dismissed = await JS.InvokeAsync<string?>("localStorage.getItem", BankReviewKey()); } catch { /* no storage */ }
        if (dismissed == newest) return;   // already dismissed, and nothing newer has arrived since
        _modal = Modal.BankReview;
        StateHasChanged();
    }

    /// <summary>Close the review modal and remember the newest transaction, so we don't nag until a newer one lands.</summary>
    private async Task DismissBankReview()
    {
        var pending = BankRowsForPeriod();
        if (pending.Count > 0)
            try { await JS.InvokeVoidAsync("localStorage.setItem", BankReviewKey(), NewestPendingId(pending)); } catch { /* no storage */ }
        CloseModal();
    }

    private static string NewestPendingId(List<PendingBankTransactionDto> pending) =>
        pending.OrderByDescending(t => t.Date).ThenBy(t => t.ExternalId).First().ExternalId;
    private string BankReviewKey() => $"finapp_bankreview_{State.CurrentAccountId}";

    /// <summary>What to show for a synced fund's balance: the live bank figure on the current open period, the
    /// balance captured when a closed period rolled over otherwise (falling back to live, then the computed balance).</summary>
    private (Money Amount, string Title) SyncedFundDisplay(Guid fid)
    {
        if (State.IsPeriodOpen && _bankStatus?.Balance is { } live)
            return (new Money(live, _bankStatus.BalanceCurrency ?? State.Currency), Loc["Live bank balance"]);
        if (!State.IsPeriodOpen && State.SyncedFundClosingBalance(fid) is { } closed)
            return (closed, Loc["Balance when this period closed"]);
        if (_bankStatus?.Balance is { } live2)
            return (new Money(live2, _bankStatus.BalanceCurrency ?? State.Currency), Loc["Live bank balance"]);
        return (State.FundBalance(fid), string.Empty);
    }

    // --- Bank sync (Open Banking) ----------------------------------------
    /// <summary>Fetch the account's bank-sync status and any staged transactions (silent if the feature is off).</summary>
    private async Task LoadBankAsync()
    {
        if (!State.HasAccounts) return;
        _bankAccountId = State.CurrentAccountId;   // the account this status/pending belongs to
        _bankAccounts = []; _bankAccountsOpen = false;   // reset per-account so a switch doesn't reuse another account's list
        _bankSharedAckKnown = false;
        // Unverified users can't touch the bank endpoints (they'd 403); the tab shows a "verify first" prompt instead.
        if (Auth.CurrentUser is { EmailVerified: false }) { _bankStatus = null; return; }
        try
        {
            _bankStatus = await State.GetBankStatus();
            if (_bankStatus.Connected)
            {
                _bankPending = await State.GetPendingBankTransactions();
                _bankMappings = (await State.GetBankMappings()).ToDictionary(m => m.MatchKey, m => (m.Kind, m.TargetId));
                DefaultBankPickers();
                await AutoHandleMappedDebitsAsync();
                // Invited members see one-time "this shows real bank data" acknowledgment until they confirm it.
                if (!State.IsOwnerOfCurrent)
                {
                    try { _bankSharedAck = (await Api.GetConsentAsync("bank_shared", _bankAccountId)).Active; }
                    catch { _bankSharedAck = true; }   // don't nag if the consent check is unreachable
                    _bankSharedAckKnown = true;
                }
            }
            else { _bankPending = []; _bankMappings = new(); DefaultBankPickers(); }
        }
        catch { _bankStatus = null; } // unreachable/unconfigured — hide the panel/tab entirely
    }

    private async Task ResendVerificationFromBank()
    {
        _resendBusy = true;
        try { await Api.ResendVerificationAsync(); _resendOk = true; }
        catch { /* surfaced by the generic banner elsewhere; keep the tab calm */ }
        finally { _resendBusy = false; }
    }

    private async Task AckBankShared()
    {
        _bankBusy = true;
        try { await State.RecordConsent("bank_shared", _bankAccountId); _bankSharedAck = true; }
        catch (Exception ex) { _bankError = ex.Message; }
        finally { _bankBusy = false; }
    }

