    private Task SaveTripForm() => RunModal(async () =>
    {
        var name = _tripName?.Trim();
        if (string.IsNullOrWhiteSpace(name) || _tripTo < _tripFrom) return;
        var bucket = _tripBucketId == Guid.Empty ? (Guid?)null : _tripBucketId;
        var tripCat = _tripCategoryId == Guid.Empty ? (Guid?)null : _tripCategoryId;
        if (_tripId == Guid.Empty)
        {
            // Create then save the rest: AddTrip covers the identity fields, and everything else (budget, bucket,
            // category, rate) is one full-replace edit — the same call the edit form makes, one code path.
            var id = await State.AddTrip(name, _tripFrom, _tripTo, _tripDestination, _tripIcon);
            if (id != Guid.Empty && (bucket is not null || tripCat is not null || _tripBudget is not null || _tripRate is not null))
                await State.SaveTrip(id, name, _tripFrom, _tripTo, _tripDestination, _tripIcon, bucket, _tripBudget, _tripCurrency, _tripRate, tripCat);
            // Seed the trip labels on the first trip only — EnsureTripTags is a no-op afterwards.
            if (State.TripTags.Count == 0) await State.EnsureTripTags(TripTagSeeds());
            _spendView = SpendView.Trips;
            if (id != Guid.Empty) _expandedTripId = id;
        }
        else
        {
            await State.SaveTrip(_tripId, name, _tripFrom, _tripTo, _tripDestination, _tripIcon, bucket, _tripBudget, _tripCurrency, _tripRate, tripCat);
        }
        Back();
    });

