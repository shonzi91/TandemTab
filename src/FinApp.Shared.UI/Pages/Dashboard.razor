        // Default the destination to the first bucket so switching the step on is one tap, not two.
        _fRoundUpBucketId = State.RoundUpBucketId
            ?? State.SavingBuckets.FirstOrDefault(b => !b.Bucket.IsArchived).Bucket?.Id
            ?? Guid.Empty;
        _fHourlyRate = State.HourlyRate;
        _fWorkDays = State.WorkingDaysPerMonth;
        _fWorkHours = State.WorkingHoursPerDay;
        // A typed rate wins in the domain, so it decides the mode here too; otherwise a working pattern means
        // From-my-income, and neither means off.
        _fTimeCostMode = State.HourlyRate is > 0m ? TimeCostMode.Manual
            : State.WorkingDaysPerMonth is > 0 && State.WorkingHoursPerDay is > 0m ? TimeCostMode.FromIncome
            : TimeCostMode.Off;
