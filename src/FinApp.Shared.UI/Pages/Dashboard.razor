    private readonly InsightsService _insights = new();
    private readonly AchievementsService _achievements = new();

    // Memoized health/insights report. Build(...) is O(periods × categories × expenses) and used to run on every
    // render — including UI-only re-renders (opening a modal, the bell, switching tabs) that change no data. Cache
    // it keyed by the data that actually feeds it: the account, its change revision, and the selected period. The
    // report is now language-independent (narrative travels as coded messages localized at render), so culture no
    // longer keys it — a language switch re-renders (re-localizes) without recomputing.
    private FinancialHealthReport? _reportCache;
    private (Guid acct, long rev, int period)? _reportKey;

    private FinancialHealthReport CurrentReport()
    {
        var key = (State.CurrentAccountId, State.Revision, State.PeriodNumber);
        if (_reportKey != key)
        {
            _reportCache = _insights.Build(State.Account, State.PeriodNumber - 1);
            _reportKey = key;
        }
        return _reportCache!;
    }

    // Same memoization for the achievements catalog (Build loops periods × achievements). Keyed by account, change
    // revision, and culture; period is irrelevant (the catalog spans all periods).
    private IReadOnlyList<Achievement>? _achCache;
    private (Guid acct, long rev, string culture)? _achKey;

    // --- F7: weekly recap -------------------------------------------------------------------------------
    // The Monday of the last week whose recap has been dismissed on THIS device. Stored per account in localStorage
    // rather than on the account, for the same reason as the celebration seen-set: "have I read this" is a fact about
    // a person, and one member dismissing the recap must not clear it out from under the other.
    private DateOnly? _recapDismissed;
    private Guid _recapDismissedFor;
    private bool _recapLoaded;
    private string RecapKey() => $"finapp_weekrecap_{State.CurrentAccountId}";

    /// <summary>The recap to render, or null: nothing to report, already dismissed for this week, or not loaded yet.
    /// <b>Strictly weekly</b> — the covered week is the last completed one, so this is the same card all week and
    /// dismissing it retires it until next Monday.</summary>
    private WeeklyRecap? WeekRecapToShow()
    {
        if (!_recapLoaded || !State.IsReady || !State.HasAccounts) return null;
        if (State.WeeklyRecap() is not { IsEmpty: false } recap) return null;
        return _recapDismissed == recap.From ? null : recap;
    }

    /// <summary>Read this account's last-dismissed week once. Until it lands the card stays hidden, so it can't flash
    /// on screen and then vanish when storage says it was already dismissed.</summary>
    private async Task LoadRecapDismissalAsync()
    {
        if (!State.IsReady || !State.HasAccounts) return;
        if (_recapLoaded && _recapDismissedFor == State.CurrentAccountId) return;
        string? stored = null;
        try { stored = await JS.InvokeAsync<string?>("localStorage.getItem", RecapKey()); } catch { /* no storage */ }
        _recapDismissed = DateOnly.TryParse(stored, System.Globalization.CultureInfo.InvariantCulture, out var d) ? d : null;
        _recapDismissedFor = State.CurrentAccountId;
        _recapLoaded = true;
        StateHasChanged();
    }

    private async Task DismissWeekRecap()
    {
        if (State.WeeklyRecap() is not { } recap) return;
        _recapDismissed = recap.From;
        try { await JS.InvokeVoidAsync("localStorage.setItem", RecapKey(), recap.From.ToString("yyyy-MM-dd")); }
        catch { /* no storage — it'll be back next load, which is the harmless direction */ }
    }

    /// <summary>A bar's width as a whole percent of the largest bar, floored at 2 so a tiny-but-real slice still
    /// draws something rather than vanishing into the track.</summary>
    private static int WeekBarPct(decimal value, decimal max) =>
        max <= 0m ? 0 : Math.Max(2, (int)Math.Round(value / max * 100m));

    // --- F6: shared-goal celebration ------------------------------------------------------------------
    // Which per-bucket milestones THIS DEVICE has already shown. Kept in localStorage, not in the account: the
    // achievement log is shared, so whoever opens the app first would otherwise consume the moment for everyone.
    private Achievement? _celebrating;
    private HashSet<string>? _celebrated;      // null until loaded for the current account
    private Guid _celebratedFor;               // which account _celebrated belongs to
    private string CelebrationsKey() => $"finapp_celebrated_{State.CurrentAccountId}";
    // Achievement keys are goal_{guid} / debt_{tier}_{guid}, so a comma can never appear inside one.
    private const char CelebratedSep = ',';

    /// <summary>
    /// Queue the next unseen bucket milestone for its moment. On the <b>first</b> run for an account the whole
    /// current set is marked seen and nothing is shown — an established account would otherwise open into a stack of
    /// celebrations for goals reached months ago, which is confusing rather than pleasant.
    /// </summary>
    private async Task CheckCelebrationsAsync()
    {
        if (!State.IsReady || !State.HasAccounts || _celebrating is not null) return;

        if (_celebrated is null || _celebratedFor != State.CurrentAccountId)
        {
            string? stored = null;
            try { stored = await JS.InvokeAsync<string?>("localStorage.getItem", CelebrationsKey()); } catch { /* no storage */ }
            _celebrated = string.IsNullOrEmpty(stored)
                ? new HashSet<string>(StringComparer.Ordinal)
                : stored.Split(CelebratedSep, StringSplitOptions.RemoveEmptyEntries).ToHashSet(StringComparer.Ordinal);
            _celebratedFor = State.CurrentAccountId;

            // ⚠️ First run for this account: adopt whatever is already earned as "seen" and write the marker
            // IMMEDIATELY — even when the set is empty. An established account must not open into a stack of
            // celebrations for goals reached months ago; but the marker has to exist from the very first load, or a
            // brand-new account (nothing earned, so nothing written) would still look like a first run when its first
            // milestone finally lands — and swallow the one celebration the feature exists for.
            if (stored is null)
            {
                foreach (var a in BudgetingState.BucketMilestones(CurrentAchievements())) _celebrated.Add(a.Key);
                await SaveCelebratedAsync();
                return;
            }
        }

        var unseen = BudgetingState.BucketMilestones(CurrentAchievements())
            .Where(a => !_celebrated.Contains(a.Key)).ToList();
        if (unseen.Count == 0) return;

        foreach (var a in unseen) _celebrated.Add(a.Key);
        await SaveCelebratedAsync();

        // One at a time. Reaching two milestones between renders is rare, and stacking them would turn a moment
        // into a queue to dismiss; the rest are already recorded in the Achievements modal.
        _celebrating = unseen[0];
        StateHasChanged();
    }

    /// <summary>Persist the seen-set. An empty set is still written — the marker's <i>presence</i> is what says
