    private Task SaveEditAccount() => RunModal(async () =>
    {
        if (string.IsNullOrWhiteSpace(_fName)) return;
        if (_fName!.Trim() != State.Account.Name)
            await State.RenameAccount(_fName!);
        var target = Math.Clamp(_fSavingsTarget, 0, 100) / 100m;
        if (target != State.SavingsRateTarget)
            await State.SetSavingsRateTarget(target);
        // F4: only write when something actually changed — this is a whole-snapshot push, not a field update.
        if (_fRoundUpTo != State.RoundUpTo || (_fRoundUpTo > 0m && _fRoundUpBucketId != State.RoundUpBucketId))
            await State.ConfigureRoundUps(_fRoundUpTo, _fRoundUpTo > 0m ? _fRoundUpBucketId : null);
        // Time cost. Only the TYPED rate is mode-dependent: clearing it is what makes "From my income" actually
        // derive (the domain prefers a typed rate, so a leftover one would silently outrank the pattern the user
        // just chose). The working pattern is kept in both modes — under Manual it doesn't price anything, it
        // powers the "what your hours really paid" check.
        var (wantRate, wantDays, wantHours) = _fTimeCostMode switch
        {
            TimeCostMode.Manual => (_fHourlyRate, _fWorkDays, _fWorkHours),
            TimeCostMode.FromIncome => ((decimal?)null, _fWorkDays, _fWorkHours),
            _ => (null, null, null),
        };
        // Same rule as round-ups: only write when something actually changed — this is a whole-snapshot push.
        if (wantRate != State.HourlyRate)
            await State.SetHourlyRate(wantRate);
        if (wantDays != State.WorkingDaysPerMonth || wantHours != State.WorkingHoursPerDay)
            await State.SetWorkingPattern(wantDays, wantHours);
        CloseModal();
    });

