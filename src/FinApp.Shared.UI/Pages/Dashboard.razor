    /// <summary>Save the fund, but if we're about to bind it to the bank (turning sync on), require sync consent first.</summary>
    private Task SaveFundGated()
    {
        if (_modal == Modal.EditFund && _fSynced && !State.FundIsSynced(_modalFundId))
        {
            RequestBankConsent("bank_sync",
                Loc["Sync this fund with your bank"],
                Loc["You authorize TandemTab to treat this fund as a mirror of your linked bank account: imported transactions post here and its balance follows the real account instead of your manual entries. You can withdraw this at any time by unsyncing the fund."],
