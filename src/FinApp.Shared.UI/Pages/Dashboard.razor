    /// <summary>Save the fund, but if we're about to bind it to the bank (turning sync on), require sync consent first.</summary>
    private Task SaveFundGated()
    {
        if (_modal == Modal.EditFund && _fSynced && !State.FundIsSynced(_modalFundId))
        {
            RequestBankConsent("bank_sync",
                Loc["Sync this fund with your bank"],
                Loc["You authorize TandemTab to treat this fund as a mirror of your linked bank account: imported transactions post here and its balance follows the real account instead of your manual entries. You can withdraw this at any time by unsyncing the fund."],
                SaveFund);
            return Task.CompletedTask;
        }
        return SaveFund();
    }

    private Task SaveFund() => RunModal(async () =>
    {
        if (string.IsNullOrWhiteSpace(_fName)) return;
        var newId = _modalFundId;
        if (_modal == Modal.AddFund)
        {
            newId = await State.AddFund(_fName!, _fundNote, _fIcon);
            if (_openingAmount > 0)
                await State.SetFundOpeningBalance(newId, _openingAmount);
            // A wallet created as foreign cash carries its currency from the start. The rate may legitimately be
            // blank here — the transfer that loads it will derive one — so only the currency is required.
            if (newId != Guid.Empty && !string.IsNullOrWhiteSpace(_fundCurrency))
                await State.SetFundCurrency(newId, _fundCurrency!.Trim().ToUpperInvariant(), _fundRate is > 0m ? _fundRate : null);
        }
        else
        {
            await State.RenameFund(_modalFundId, _fName!);
            await State.SetFundNote(_modalFundId, _fundNote);
            await State.SetFundIcon(_modalFundId, _fIcon);
            // The wallet's currency + rate ride their own endpoint (see SetFundCurrencyRequest), so a rename can't
            // wipe them. Only written when they actually changed — the endpoint is Pro-gated on SETTING a currency,
            // and a Free user renaming an ordinary wallet must not trip that gate.
            var fxNow = State.Account.FindFund(_modalFundId);
            var wantCcy = string.IsNullOrWhiteSpace(_fundCurrency) ? null : _fundCurrency!.Trim().ToUpperInvariant();
            var wantRate = _fundRate is > 0m ? _fundRate : null;
            if (fxNow?.Currency != wantCcy || fxNow?.Rate != wantRate)
                await State.SetFundCurrency(_modalFundId, wantCcy, wantRate);
            if (!_fSynced)   // a synced fund's opening balance is bank-managed, not user-set
                await State.SetFundOpeningBalance(_modalFundId, _openingAmount);
            // Bind/unbind this fund to the live bank connection (writes the binding server-side too).
            if (_bankStatus?.Connected == true && _fSynced != State.FundIsSynced(_modalFundId))
            {
                if (_fSynced) await State.BindFundToBank(_modalFundId, _fBankAccountRef);
                else await State.UnbindFundFromBank(_modalFundId);
                await LoadBankAsync();
            }
        }
        var after = _afterCreate; _afterCreate = null;
        Back();
        after?.Invoke(newId);
    });

