    private Task SaveBucket() => RunModal(async () =>
    {
        if (string.IsNullOrWhiteSpace(_fName)) return;
        decimal? goal = _goalAmount > 0 ? _goalAmount : null;
        decimal? planned = null;   // planned-contribution field retired; add/edit clears any legacy value
        var isDebt = _bucketKind == SavingKind.Debt;
        var isInv = _bucketKind == SavingKind.Investment;
        var isExpenses = _bucketKind == SavingKind.Expenses;
        if (isExpenses && ValidCostRows().Count == 0) return;   // the cost list is the point of this kind
        // Only an expenses fund carries a cost list; the other kinds clear it rather than keeping an orphaned
        // list alive behind a form that no longer shows it.
        var costs = isExpenses ? ValidCostRows() : [];
        // Debt input mode: "original + already paid" derives what's owed and sends the original as the baseline; the
        // plain mode sends what's owed and lets the original default to it. Due-day/start-date only apply to a debt.
        var debtBal = isDebt && _debtEnterInitial ? Math.Max(0m, _debtOriginal - _debtPaidPrincipal) : _debtBalance;
        decimal? debtOrig = isDebt && _debtEnterInitial ? _debtOriginal : null;
        int? debtDay = isDebt ? _debtDay : null;
        DateOnly? debtStart = isDebt ? _debtStart : null;
        var debtPayDriven = isDebt && _debtPayDriven;
        // Only an ordinary or sinking bucket can be the cushion — a debt or an investment is not one.
        var emergency = _fEmergency && !isDebt && !isInv;
        if (_modal == Modal.AddBucket)
            await State.AddSavingBucket(_fName!, goal, _fThreshold, _fNotify, _initialSavings, _fIcon, isDebt, debtBal, _debtRate, _debtInstallment, planned, isInv, _invRate, _invTermYears, _invCompounds, _bucketFundId, costs, isExpenses, debtOrig, debtDay, debtStart, debtPayDriven, emergency, isDebt ? _debtResidual : 0m);
        else
            await State.SaveSavingBucket(_modalBucketId, _fName!, goal, _fThreshold, _fNotify, _initialSavings, _fIcon, isDebt, debtBal, _debtRate, _debtInstallment, planned, isInv, _invRate, _invTermYears, _invCompounds, _bucketFundId, costs, isExpenses, debtOrig, debtDay, debtStart, debtPayDriven, emergency, isDebt ? _debtResidual : 0m);
        CloseModal();
    });

