                }
                <span class="bank-tx-icons">
                    <button class="icon-btn pin @(mappedLabel is not null ? "on" : "")" title="@pinTitle" @onclick="() => TogglePin(t)" disabled="@_bankBusy"><Icon Name="pin" /></button>
                    @if (isDebit)
                    {
                        @if (State.HasSyncedFund)
                        {
                            <button class="icon-btn" title="@Loc["Record as a transfer to another fund/account"]" @onclick="() => OpenBankTransfer(t)" disabled="@_bankBusy">⇄</button>
