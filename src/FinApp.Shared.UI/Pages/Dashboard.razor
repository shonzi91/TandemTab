                            @if (_rowMenuId == cid)
                            {
                                <div class="row-menu-backdrop" @onclick="() => _rowMenuId = Guid.Empty"></div>
                                <div class="row-menu">
                                    <button @onclick="() => RowAct(() => OpenEditDeposit(cid))">✏️ @Loc["Edit"]</button>
                                    <button class="danger" @onclick="() => RowAct(() => OpenDeleteDeposit(cid))">🗑️ @Loc["Remove"]</button>
                                </div>
                            }
                        </li>
                    }
                    @if (!State.ContributionsThisPeriod.Any())
                    {
                        <li><em>@Loc["Nothing on the tab yet — add a contribution."]</em></li>
                    }
                </ul>
            </section>

            <section class="panel people-panel">
                <div class="spending-head">
                    <h2>@Loc["People"]</h2>
                    <button class="fund-add" @onclick="OpenInvite">＋ @Loc["Invite"]</button>
                </div>
                <div class="people-row">
                    @foreach (var m in State.RealUsers)
                    {
                        var mid = m.UserId;
                        <span class="person">
                            <Avatar Name="@m.DisplayName" Picture="@State.MemberAvatar(mid)" Size="26" /> @m.DisplayName
                            @if (mid == State.MyUserId) { <span class="person-tag">@Loc["you"]</span> }
                            else if (mid == State.CurrentOwnerId) { <span class="person-tag">@Loc["owner"]</span> }
                            @if (State.IsOwnerOfCurrent && mid != State.MyUserId)
                            {
                                <button class="person-x" title="@Loc["Remove from account"]" @onclick="() => OpenRemoveMember(mid, m.DisplayName)">×</button>
                            }
                        </span>
                    }
                </div>
            </section>

        </div>
        <div class="tabpanel" hidden="@(_tab != Tab.Budgets)">
            <section class="panel">
                <div class="spending-head">
                    <span class="insight-h">@Loc["This month's budgets"]</span>
                    <button class="fund-add" @onclick="OpenAddBudget">＋ @Loc["Add budget"]</button>
                    <button class="fund-add" @onclick="OpenRecurring">🔁 @Loc["Recurring"]</button>
                    @* Only the spent figure takes the heat — it carries the verdict; the cap it's measured against
                       stays quiet. Same ramp as the Home "Spent" tile and the rings below, so one fact reads one way. *@
                    <span class="spending-sub"><strong class="spend-heat" style="color:hsl(@SpendHeatHue() 72% 56%)">@Fmt(State.TotalSpent)</strong> @Loc["of"] @Fmt(State.TotalBudgeted) @Loc["spent"]</span>
                </div>
                @{
                    var _bnFree = State.DisplayFreeToAllocate(_bankStatus?.Balance, _bankStatus?.BalanceCurrency);
                    var _bnRemaining = State.TotalBudgeted - State.TotalSpent;
                    var overPlanned = _bnRemaining - _bnFree;
                }
                @if (overPlanned.Amount > 0m)
                {
                    <p class="budget-over-note">💡 @string.Format(Loc["Your remaining budgets ({0}) are {1} more than you have left ({2}) — budgets are plans, not commitments, so trim one or top up when you can."], Fmt(_bnRemaining), Fmt(overPlanned), Fmt(_bnFree))</p>
                }
                @{
                    // Top-level categories only — sub-categories roll up into their parent's ring.
                    var budgeted = State.CategoryOptions.Where(c => c.Depth == 0 && State.HasBudget(c.Category.Id)).ToList();
                    var unbudgeted = State.CategoryOptions
                        .Where(c => c.Depth == 0
                                    && !State.HasBudget(c.Category.Id)
                                    && State.SpentInCategory(c.Category.Id).Amount > 0
                                    && !State.ChildrenOf(c.Category.Id).Any(ch => State.HasBudget(ch.Id)))
                        .ToList();
                }
                <div class="ring-grid">
                    @foreach (var (cat, _) in budgeted)
                    {
                        var cov = State.Coverage(cat.Id);
                        var cls = cov.IsOverBudget ? "over" : cov.ThresholdReached ? "warn" : "ok";
                        var catId = cat.Id;
                        <div class="ring-card ring-card-lg@(State.ChildrenOf(catId).Any() ? " has-subs" : "")">
                            <ProgressRing Percent="@((double)(cov.Percent ?? 0))" Class="@cls" Ramp="spend">
                                <button class="ring-ico-big" title="@Loc["Actions"]" @onclick="() => ToggleBudgetMenu(catId)">@State.CategoryIcon(catId)</button>
                                <button class="ring-name" title="@Loc["Actions"]" @onclick="() => ToggleBudgetMenu(catId)">@cat.Name</button>
                            </ProgressRing>
                            <div class="ring-label"><span>@Fmt(cov.Spent) / @Fmt(cov.Allocated)</span></div>
                            @if (_budgetMenuId == catId) { @BudgetCircleMenu(catId) }
                        </div>
                    }
                    @foreach (var (cat, _) in unbudgeted)
                    {
                        var catId = cat.Id;
                        <div class="ring-card ring-card-lg@(State.ChildrenOf(catId).Any() ? " has-subs" : "")">
                            <ProgressRing Percent="0" Class="mint" Dashed="true">
                                <button class="ring-ico-big" title="@Loc["Actions"]" @onclick="() => ToggleBudgetMenu(catId)">@State.CategoryIcon(catId)</button>
                                <button class="ring-name" title="@Loc["Actions"]" @onclick="() => ToggleBudgetMenu(catId)">@cat.Name</button>
                            </ProgressRing>
                            <div class="ring-label"><span class="amt">@Fmt(State.SpentInCategory(catId))</span> <span class="ring-muted">@Loc["no budget"]</span></div>
                            @if (_budgetMenuId == catId) { @BudgetCircleMenu(catId) }
                        </div>
                    }
                </div>
            </section>

            <section class="panel">
                <div class="panel-head">
                    @if (_calendar)
                    {
                        <h2>@State.Period.From.ToString("MMMM yyyy")</h2>
                    }
                    else if (_dayView is { } dv)
                    {
                        <span class="day-nav">
                            <button class="exp-edit" title="@Loc["Previous day"]" @onclick="PrevDay" disabled="@(dv <= State.Period.From)">◀</button>
                            <input type="date" @bind:get="dv" @bind:set="GoToDay" min="@State.Period.From.ToString("yyyy-MM-dd")" max="@State.Period.To.ToString("yyyy-MM-dd")" />
                            <button class="exp-edit" title="@Loc["Next day"]" @onclick="NextDay" disabled="@(dv >= State.Period.To)">▶</button>
                        </span>
                    }
                    else
                    {
                        <h2>@Loc["All expenses"]</h2>
                    }
                    <span class="view-toggle">
                        <button class="view-btn @(_calendar ? "" : "active")" title="@Loc["List"]" @onclick="ShowDayList">☰</button>
                        <button class="view-btn @(_calendar ? "active" : "")" title="@Loc["Calendar"]" @onclick="ShowCalendarView">📅</button>
                    </span>
                </div>
                @{
                    RenderFragment<FinApp.Domain.Budgeting.Expense> row = e =>
                        @<li>
                            <span class="row-main">
                                <span class="cat-ico">@State.CategoryIcon(e.CategoryId)</span> @State.CategoryName(e.CategoryId) <span class="exp-arrow">⟵</span> <span class="cat-ico">@State.FundIcon(e.FundId)</span> @State.FundName(e.FundId)@(e.IsFromSavings ? " · 💰saving" : "")@(string.IsNullOrEmpty(e.Note) ? "" : $" · {e.Note}")
                                @if (e.IsSettlementSource)
                                {
                                    <span class="settle-tag" title="@Loc["Settled onto another account"]">🤝 @Fmt(e.SettledMoney) → @State.AccountName(e.SettledToAccountId!.Value)</span>
                                }
                                else if (e.IsSettlementDestination)
                                {
                                    <span class="settle-tag" title="@Loc["Settled from another account"]">↩ @Loc["from"] @State.AccountName(e.SettledFromAccountId!.Value)</span>
                                }
                                @if (e.AutoFiled)
                                {
                                    <span class="row-note" title="@AutoFiledTitle(e)">🏦</span>
                                }
                            </span>
                            <span class="amt">@Fmt(e.Amount)</span>
                            <span class="row-actions">
                                @if (State.IsPeriodOpen)
                                {
                                    <button class="exp-edit" title="@Loc["Edit expense"]" @onclick="() => OpenEditExpense(e.Id)">✏️</button>
                                    <button class="exp-edit" title="@Loc["Remove expense"]" @onclick="() => OpenDeleteExpense(e.Id)">🗑️</button>
                                }
                            </span>
                        </li>;
                    var shown = _dayView is { } dvf
                        ? State.AllExpenses.Where(e => e.Date == dvf).ToList()
                        : State.AllExpenses.ToList();
                    var byDay = State.AllExpenses.GroupBy(e => e.Date)
                        .ToDictionary(g => g.Key, g => (Count: g.Count(), Total: g.Aggregate(0m, (s, e) => s + e.Amount.Amount)));
                    var calToday = DateOnly.FromDateTime(DateTime.Today);
                }
                @if (_calendar)
                {
                    <div class="cal-dow">
                        @foreach (var dow in new[] { "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun" })
                        {
                            <span>@dow</span>
                        }
                    </div>
                    <div class="cal-grid">
                        @foreach (var d in CalendarDays())
                        {
                            var inRange = d >= State.Period.From && d <= State.Period.To;
                            byDay.TryGetValue(d, out var info);
                            var cls = "cal-cell"
                                + (inRange ? "" : " cal-out")
                                + (d == calToday ? " cal-today" : "")
                                + (_dayView == d ? " cal-sel" : "");
                            var day = d;
                            <div class="@cls" @onclick="() => OpenDayFromCalendar(day)">
                                <span class="cal-top">
                                    <span class="cal-num">@d.Day</span>
                                    @if (inRange && State.IsPeriodOpen)
                                    {
                                        <button class="cal-add" title="@Loc["Add expense"]" @onclick:stopPropagation="true" @onclick="() => OpenAddExpenseOn(day)">🧾</button>
                                    }
                                </span>
                                @if (inRange && info.Count > 0)
                                {
                                    <span class="cal-total">@Fmt(State.Money(info.Total))</span>
                                }
                            </div>
                        }
                    </div>
                }
                else if (!shown.Any())
                {
                    <ul class="list"><li><em>@Loc["Nothing’s perched here yet — add your first expense."]</em></li></ul>
                }
                else if (_dayView is not null)
                {
                    <ul class="list list-even">@foreach (var e in shown) { @row(e) }</ul>
                }
                else
                {
                    @foreach (var grp in shown.GroupBy(e => e.Date).OrderByDescending(g => g.Key))
                    {
                        <button class="date-sep" @onclick="() => GoToDay(grp.Key)">@grp.Key.ToString("dddd, dd MMM yyyy")</button>
                        <ul class="list list-even">@foreach (var e in grp) { @row(e) }</ul>
                    }
                }
            </section>

            @if (_bankStatus is { Enabled: true, Connected: true } && BankDebits() is { Count: > 0 } bankExpenses)
            {
                <section class="panel">
                    <div class="panel-head">
                        <h2>💳 @Loc["From your bank"] <span class="bank-group-count">@bankExpenses.Count</span></h2>
                    </div>
                    @if (!State.HasSyncedFund)
                    {
                        <div class="alert warn-bg"><span>@Loc["Mark a fund as synced to this bank (a fund → Edit) so imports file automatically."]</span></div>
                    }
                    @foreach (var grp in bankExpenses.GroupBy(t => t.Date).OrderByDescending(g => g.Key))
                    {
                        <div class="date-sep">@grp.Key.ToString("dddd, dd MMM yyyy")</div>
                        <ul class="list bank-pending">@foreach (var t in grp) { @BankTxRow(t) }</ul>
                    }
                    @if (_bankError is not null)
                    {
                        <div class="alert warn-bg"><span>@_bankError</span><button class="alert-x" title="@Loc["Dismiss"]" @onclick="() => _bankError = null">×</button></div>
                    }
                </section>
            }
        </div>
        <div class="tabpanel" hidden="@(_tab != Tab.Savings)">
            @{
                var debtBuckets = State.SavingBuckets.Where(x => x.Bucket.IsDebt && !x.Bucket.IsArchived).ToList();
                var investmentBuckets = State.SavingBuckets.Where(x => x.Bucket.IsInvestment && !x.Bucket.IsArchived).ToList();
                var plainBuckets = State.SavingBuckets.Where(x => !x.Bucket.IsDebt && !x.Bucket.IsInvestment && !x.Bucket.IsArchived).ToList();

                // One card, reused in the Debts and Savings sections. Debt cards show "set aside" + what's still owed;
                // ordinary cards show saved / goal. All bucket actions live in the ⋯ menu (same pattern as elsewhere).
                RenderFragment<(SavingCategory Bucket, Money Total)> bucketCard = ctx =>
                @<div class="ring-card ring-card-lg">
                    @{
                        var bucketId = ctx.Bucket.Id;
                        var isDebt = ctx.Bucket.IsDebt;
                        var isInvestment = ctx.Bucket.IsInvestment;
                        var g = (!isDebt && !isInvestment && ctx.Bucket.HasGoal) ? State.SavingGoal(bucketId) : (SavingGoalProgress?)null;
                        var pct = (double)(g?.Percent ?? 0);
                        var cls = g is null ? "mint" : g.ThresholdReached && !g.GoalReached ? "warn" : "ok";
                        // Debt: the ring is the original loan. A green arc is how much you've already paid off; a second
                        // indigo segment past it is money set aside but not yet applied — staged, not gone. The rest of
                        // the track is what's still owed and unfunded.
                        var debtOwed = isDebt ? State.SavingBucketDebtBalance(bucketId) : 0m;
                        var debtOrig = isDebt ? State.SavingBucketDebtOriginal(bucketId) : 0m;
                        var debtPaid = isDebt ? State.SavingBucketDebtPaidOff(bucketId) : 0m;
                        var debtScale = debtOrig > 0m ? debtOrig : debtOwed;   // fall back to owed for a debt with no baseline
                        var paidPct = (isDebt && debtScale > 0m) ? (double)(debtPaid / debtScale) * 100.0 : 0.0;
                        var stagedPct = (isDebt && debtScale > 0m) ? (double)(ctx.Total.Amount / debtScale) * 100.0 : 0.0;
                        var ringPct = isDebt ? paidPct : (g is null ? 0 : pct);
                        var ringCls = isInvestment ? "invest" : isDebt ? "ok" : cls;
                        var ringDashed = !isDebt && g is null;
                        // Goal progress shades pink→green (green = reached); investments keep their gold ring; debt now
                        // uses the two solid segments above, so it opts out of the ramp.
                        var ringRamp = (!isInvestment && !isDebt && !ringDashed) ? "goal" : null;
                        // Lifecycle: a debt with nothing left owed, or a goal that's been reached, is "done".
                        var done = isDebt ? ctx.Bucket.IsDebtCleared : (g is not null && g.GoalReached);
                    }
                    <ProgressRing Percent="@ringPct" Percent2="@(isDebt ? stagedPct : 0)" Class="@ringCls" Class2="staged" Dashed="@ringDashed" Ramp="@ringRamp">
                        <button class="ring-ico-big" title="@Loc["Actions"]" @onclick="() => ToggleRowMenu(bucketId)">@State.SavingBucketIcon(bucketId)</button>
                        <button class="ring-name" title="@Loc["Actions"]" @onclick="() => ToggleRowMenu(bucketId)">@ctx.Bucket.Name</button>
                        @if (done)
                        {
                            <span class="ring-done">🎉</span>
                        }
                    </ProgressRing>
                    @if (_rowMenuId == bucketId)
                    {
                        <div class="row-menu-backdrop" @onclick="() => _rowMenuId = Guid.Empty"></div>
                        <div class="row-menu">
                            @if (!done)
                            {
                                @if (isDebt)
                                {
                                    <button @onclick="() => RowAct(() => OpenPayoffProjection(bucketId))">📈 @Loc["Payoff projection"]</button>
                                }
                                else if (isInvestment)
                                {
                                    <button @onclick="() => RowAct(() => OpenInvestmentProjection(bucketId))">📈 @Loc["Growth projection"]</button>
                                }
                                else
                                {
                                    <button @onclick="() => RowAct(() => OpenGoalProjection(bucketId))">📅 @Loc["Goal projection"]</button>
                                }
                            }
                            @if (State.IsPeriodOpen)
                            {
                                <button @onclick="() => RowAct(() => OpenAddSaving(bucketId))">💰 @Loc["Add to savings"]</button>
                                <button @onclick="() => RowAct(() => OpenDisburseSaving(bucketId))">🎯 @(isDebt ? Loc["Make a payment"] : isInvestment ? Loc["Withdraw"] : Loc["Apply to a goal"])</button>
                                <button @onclick="() => RowAct(() => OpenBudgetSaving(bucketId))">➡️ @Loc["Budget savings"]</button>
                                <button @onclick="() => RowAct(() => OpenSpendSaving(bucketId))">💸 @Loc["Spend savings"]</button>
                            }
                            <button @onclick="() => RowAct(() => OpenEditBucket(bucketId))">✏️ @Loc["Edit"]</button>
                            <button @onclick="() => ArchiveBucket(bucketId)">📦 @Loc["Archive"]</button>
                            <button class="danger" @onclick="() => RowAct(() => OpenDeleteBucket(bucketId))">🗑️ @Loc["Remove"]</button>
                        </div>
                    }
                    <div class="ring-label">
                        @if (done)
                        {
                            <span class="amt good-text">@(isDebt ? Loc["🎉 Paid off!"] : Loc["🎉 Goal reached!"])</span>
                            <div class="ring-sub"><button class="link" @onclick="() => ArchiveBucket(bucketId)">📦 @Loc["Archive it"]</button></div>
                        }
                        else if (isDebt)
                        {
                            <span class="amt save">@Fmt(ctx.Total)</span> <span class="ring-muted">@Loc["set aside"]</span>
                            <div class="ring-sub">@Fmt(State.Money(State.SavingBucketDebtBalance(bucketId))) @Loc["owed"] · @State.SavingBucketDebtRate(bucketId)% · @Fmt(State.Money(State.SavingBucketDebtInstallment(bucketId)))/@Loc["mo"]</div>
                            var dPaid = State.SavingBucketDebtPaidOff(bucketId);
                            var dOrig = State.SavingBucketDebtOriginal(bucketId);
                            var dProg = State.SavingBucketDebtProgress(bucketId);
                            var dSpark = State.SavingBucketDebtHistory(bucketId);
                            @* "Ahead of the installment plan" used to sit here; it's a pace projection that reads as a
                               result of your last payment and confused people. The Payoff projection modal owns that
                               answer now. *@
                            if (dProg is { } pr && dPaid > 0m)
                            {
                                <div class="debt-progress">
                                    <span class="debt-prog-txt">@string.Format(Loc["Paid off {0} of {1} ({2}%)"], Fmt(State.Money(dPaid)), Fmt(State.Money(dOrig)), (int)Math.Round((double)pr * 100))</span>
                                    @DebtSparkline(dSpark)
                                </div>
                            }
                        }
                        else if (isInvestment)
                        {
                            <span class="amt save">@Fmt(ctx.Total)</span> <span class="ring-muted">@Loc["invested"]</span>
                            var invProj = State.ProjectInvestment(bucketId, State.EffectiveSavingPace(bucketId)?.Amount ?? 0m);
                            <div class="ring-sub">@State.SavingBucketInvestmentRate(bucketId)% · @State.SavingBucketInvestmentTermYears(bucketId).ToString("0.#")@Loc["y"]@(invProj is { Months: > 0 } ip ? $" → ~{Fmt(State.Money(ip.FutureValue))}" : "")</div>
                        }
                        else if (g is null)
                        {
                            <span class="amt save">@Fmt(ctx.Total)</span> <span class="ring-muted">@Loc["saved"]</span>
                        }
                        else
                        {
                            <span class="amt save">@Fmt(ctx.Total)</span> <span class="ring-muted">/ @Fmt(g.Goal!.Value)</span>
                        }
                        @* A sinking fund's headline number is the monthly set-aside, not the balance — the balance
                           only tells you where you are, this tells you what to do. One line, no extra section. *@
                        @if (State.BucketMonthlySetAside(bucketId) is { } setAside and > 0m)
                        {
                            <div class="ring-sub ring-setaside">🗓️ @Fmt(State.Money(setAside))/@Loc["mo"] @Loc["to stay covered"]</div>
                        }
                        @if (State.SavingBucketFundId(bucketId) is { } heldFund)
                        {
                            <div class="ring-sub ring-muted">🏦 @Loc["in"] @State.FundName(heldFund)</div>
                        }
                    </div>
                </div>;
            }
            @{
                // One grid for every goal, filtered by kind — rather than a section per SavingKind, which is the axis
                // that made this tab a wall of near-identical blocks (the same bucketCard rendered three times). Kind
                // stays readable without the split: the ring colour and each card's sub-line already say which it is.
                var goalBuckets = _goalFilter switch
                {
                    GoalFilter.Debts => debtBuckets,
                    GoalFilter.Savings => plainBuckets,
                    GoalFilter.Investments => investmentBuckets,
                    _ => debtBuckets.Concat(plainBuckets).Concat(investmentBuckets).ToList(),
                };
                var goalTotal = debtBuckets.Count + plainBuckets.Count + investmentBuckets.Count;
            }
            <section class="panel">
                <div class="spending-head">
                    <span class="insight-h">🎯 @Loc["Your goals"]</span>
                    <button class="fund-add" @onclick="AddGoalForFilter">＋ @Loc["Add goal"]</button>
                    <span class="spending-sub">@Fmt(State.SavingsAccumulated) @Loc["saved"] · @Fmt(State.SavingsThisPeriod) @Loc["this period"]</span>
                </div>
                <div class="goal-filters" role="group">
                    <button type="button" class="chip @(_goalFilter == GoalFilter.All ? "on" : "")" @onclick="() => _goalFilter = GoalFilter.All">@Loc["All"] <span class="chip-n">@goalTotal</span></button>
                    <button type="button" class="chip @(_goalFilter == GoalFilter.Debts ? "on" : "")" @onclick="() => _goalFilter = GoalFilter.Debts">💳 @Loc["Debts"] <span class="chip-n">@debtBuckets.Count</span></button>
                    <button type="button" class="chip @(_goalFilter == GoalFilter.Savings ? "on" : "")" @onclick="() => _goalFilter = GoalFilter.Savings">🐷 @Loc["Savings"] <span class="chip-n">@plainBuckets.Count</span></button>
                    <button type="button" class="chip @(_goalFilter == GoalFilter.Investments ? "on" : "")" @onclick="() => _goalFilter = GoalFilter.Investments">📈 @Loc["Investments"] <span class="chip-n">@investmentBuckets.Count</span></button>
                </div>
                @if (goalBuckets.Count == 0)
                {
                    <p class="hint">
                        @(_goalFilter switch
                        {
                            GoalFilter.Debts => Loc["Track a loan or debt: set money aside toward it, then pay the bank. Figures here are projections — they don't move real money."],
                            GoalFilter.Investments => Loc["Track an investment: fund it with 💰, set an expected return, and project its growth. Figures here are projections — they don't move real money."],
                            _ => Loc["Nothing here yet — add a goal to start putting money aside."],
                        })
                    </p>
                }
                <div class="ring-grid">
                    @foreach (var b in goalBuckets) { @bucketCard(b) }
                </div>
            </section>
            @if (debtBuckets.Count >= 2)
            {
                <section class="panel">
                    <div class="panel-head"><h2>🎯 @Loc["Payoff plan"] @infoTip(("plan-how", Loc["One spare amount is thrown at your debts each month on top of every installment. As each debt clears, its installment rolls onto the next one."]))</h2></div>
                    <div class="plan-controls">
                        <label>@Loc["Extra /mo across all debts"] <input type="number" step="10" min="0" @bind="_planExtra" @bind:event="oninput" /></label>
                        <div class="plan-toggle" role="group">
                            <button type="button" class="chip @(_planStrategy == FinApp.Domain.Forecasting.LoanForecast.Strategy.Avalanche ? "on" : "")" @onclick="() => _planStrategy = FinApp.Domain.Forecasting.LoanForecast.Strategy.Avalanche" title="@Loc["Highest interest rate first — cheapest overall."]">🏔️ @Loc["Avalanche"]</button>
                            <button type="button" class="chip @(_planStrategy == FinApp.Domain.Forecasting.LoanForecast.Strategy.Snowball ? "on" : "")" @onclick="() => _planStrategy = FinApp.Domain.Forecasting.LoanForecast.Strategy.Snowball" title="@Loc["Smallest balance first — quickest wins."]">⛄ @Loc["Snowball"]</button>
                            @infoTip(("plan-strat", Loc["Avalanche pays the highest-rate debt first (least interest overall). Snowball pays the smallest balance first (a quicker first win)."]))
                        </div>
                    </div>
                    <p class="hint plan-strat-note">@(_planStrategy == FinApp.Domain.Forecasting.LoanForecast.Strategy.Avalanche ? Loc["🏔️ Attacking the highest-rate debt first — least interest overall."] : Loc["⛄ Attacking the smallest balance first — a quicker first win."])</p>
                    @if (DebtPlan is { } plan)
                    {
                        <div class="plan-summary">
                            <span class="plan-big">🏁 @Loc["Debt-free"] @PayoffDate(plan.Months)</span>
                            <span class="spending-sub">@string.Format(Loc["{0} · total interest {1}"], MonthsText(plan.Months), Fmt(State.Money(plan.TotalInterest)))</span>
                        </div>
                        @if (_planExtra > 0 && DebtBaseline is { } baseNoExtra && (baseNoExtra.Months > plan.Months || baseNoExtra.TotalInterest > plan.TotalInterest))
                        {
                            <p class="hint good-text">➡️ @string.Format(Loc["That extra clears you {0} sooner and saves {1} in interest."], MonthsText(baseNoExtra.Months - plan.Months), Fmt(State.Money(Math.Max(0m, baseNoExtra.TotalInterest - plan.TotalInterest))))</p>
                        }
                        <ol class="plan-order">
                            @for (var oi = 0; oi < plan.Order.Count; oi++)
                            {
                                var step = plan.Order[oi];
                                <li class="@(oi == 0 ? "first" : "")"><span class="plan-order-name">@step.Name</span> <span class="pm-hint">@Loc["clear"] @PayoffDate(step.ClearedInMonth) · @MonthsText(step.ClearedInMonth)</span></li>
                            }
                        </ol>
                    }
                    else
                    {
                        <p class="hint warn-text">@Loc["At these installments the stack never clears — the minimums don't cover the interest. Add an extra amount."]</p>
                    }
                </section>
            }
            @if (State.SavingDepositsThisPeriod.Any() || State.SavingMovementsThisPeriod.Any())
            {
                <section class="panel">
                    <h2>@Loc["Goals activity"]</h2>
                    <ul class="list">
                        @foreach (var d in State.SavingDepositsThisPeriod)
                        {
                            <li>
                                <span class="row-lead">
                                    @if (State.IsPeriodOpen)
                                    {
                                        <button class="exp-edit" title="@Loc["Edit"]" @onclick="() => OpenEditSavingDeposit(d.Id)">✏️</button>
                                        <button class="exp-edit" title="@Loc["Remove"]" @onclick="() => OpenDeleteSavingDeposit(d.Id)">🗑️</button>
                                    }
                                    <span>@d.Date.ToString("dd MMM") · 💰 @State.SavingBucketName(d.SavingCategoryId)</span>
                                </span>
                                <span class="amt save">@Fmt(d.Amount)</span>
                            </li>
                        }
                        @foreach (var m in State.SavingMovementsThisPeriod)
                        {
                            <li>
                                <span class="row-lead">
                                    @if (State.IsPeriodOpen)
                                    {
                                        @if (!m.IsDisbursement)
                                        {
                                            <button class="exp-edit" title="@Loc["Edit"]" @onclick="() => OpenEditSavingMovement(m.Id)">✏️</button>
                                        }
                                        <button class="exp-edit" title="@Loc["Remove"]" @onclick="() => OpenDeleteSavingMovement(m.Id)">🗑️</button>
                                    }
                                    <span>@m.Date.ToString("dd MMM") · @MovementIcon(m) @State.SavingMovementTarget(m)</span>
                                </span>
                                <span class="amt save">@Fmt(State.Money(-m.Amount.Amount))</span>
                            </li>
                        }
                    </ul>
                </section>
            }
        </div>
    </div>
</div>

@if (_modal != Modal.None)
{
    <div class="modal-backdrop">
        @* Review modals hold rows of data rather than a column of fields, so they get the wider box. *@
        <div class="modal @(_modal is Modal.BankReview or Modal.Import ? "modal-wide" : "")">
            @if (_modalError is not null)
            {
                <div class="modal-error">@_modalError</div>
            }
            @switch (_modal)
            {
                case Modal.PickAccount:
                    <h3>@Loc["Which account?"]</h3>
                    <p class="hint">@Loc["Pick the account you want to work in. You can switch anytime from the top bar."]</p>
                    <div class="acct-pick-list">
                        @foreach (var a in State.Accounts)
                        {
                            var accId = a.Id;
                            <button class="acct-pick-btn" @onclick="() => PickAccountOnEntry(accId)">
                                <span class="acct-pick-name">🏦 @a.Name</span>
                                <span class="acct-pick-cur">@a.Currency ›</span>
                            </button>
                        }
                    </div>
                    break;

                case Modal.BankReview:
                    var reviewDebits = BankDebits();
                    var reviewCredits = BankCredits();
                    <h3>🏦 @Loc["Review bank transactions"]</h3>
                    <p class="hint">@string.Format(Loc["{0} imported from {1} need a quick review."], reviewDebits.Count + reviewCredits.Count, _bankStatus?.InstitutionName ?? Loc["your bank"])</p>
                    @if (reviewDebits.Count > 0)
                    {
                        <h4 class="detail-sub">@Loc["Expenses"] <span class="pm-hint">· @reviewDebits.Count</span></h4>
                        <ul class="list bank-tx-list">@foreach (var t in reviewDebits) { @BankTxRow(t) }</ul>
                    }
                    @if (reviewCredits.Count > 0)
                    {
                        <h4 class="detail-sub">@Loc["Money in"] <span class="pm-hint">· @reviewCredits.Count</span></h4>
                        <ul class="list bank-tx-list">@foreach (var t in reviewCredits) { @BankTxRow(t) }</ul>
                    }
                    @if (reviewDebits.Count == 0 && reviewCredits.Count == 0)
                    {
                        <p class="hint">@Loc["All caught up — nothing left to review."]</p>
                    }
                    <div class="modal-actions">
                        <button class="ghost" @onclick="DismissBankReview">@Loc["Close"]</button>
                    </div>
                    break;

                case Modal.BankConsent:
                    <h3>@_consentTitle</h3>
                    <p class="hint">@_consentBody</p>
                    <p class="hint"><a href="@PrivacyUrl" target="_blank" rel="noopener">@Loc["Privacy"]</a> · <a href="@TermsUrl" target="_blank" rel="noopener">@Loc["Terms"]</a></p>
                    <label class="check"><input type="checkbox" @bind="_consentChecked" /> @Loc["I understand and consent."]</label>
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                        <button @onclick="ConfirmBankConsent" disabled="@(!_consentChecked || _bankBusy)">@Loc["Consent & continue"]</button>
                    </div>
                    break;

                case Modal.AddCat:
                    <h3>@Loc["Add category"] @(_addParentId is {} p ? $"under {State.CategoryName(p)}" : "(top level)")</h3>
                    <div class="name-icon-row">
                        @iconButton
                        <label class="grow">@Loc["Name"] <input type="text" @bind="_fName" @bind:after="() => _fEssential = BudgetingState.GuessEssential(_fName)" /></label>
                    </div>
                    @iconGrid
                    <label>@Loc["Budget for this period (optional)"] <input type="number" step="0.01" min="0" @bind="_fBudget" /></label>
                    <small class="hint">@Loc["Available to budget:"] <strong>@Fmt(State.MaxBudgetFor(Guid.Empty))</strong></small>
                    <label class="check"><input type="checkbox" @bind="_fEssential" /> @Loc["Essential spend (rent, groceries, health…)"]</label>
                    <small class="hint">@Loc["Essential budgets are never suggested for redirecting toward a debt."]</small>
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                        <button @onclick="SaveAddCat" disabled="@(string.IsNullOrWhiteSpace(_fName))">@Loc["Add"]</button>
                    </div>
                    break;

                case Modal.AddBudget:
                    <h3>@Loc["Add budget"]</h3>
                    // Only categories that don't have a budget yet can get one here.
                    var withoutBudget = State.CategoryOptions.Where(c => !State.HasBudget(c.Category.Id)).ToList();
                    @if (withoutBudget.Count == 0)
                    {
                        <p class="hint">@Loc["Every category already has a budget. Add a new category to budget for it."]</p>
                        <div class="modal-actions">
                            <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                            <button @onclick="BudgetAddCategory">@Loc["Add category"]</button>
                        </div>
                    }
                    else
                    {
                        <label><span class="lbl-row">@Loc["Category"] <button type="button" class="lbl-add" title="@Loc["Add category"]" @onclick="BudgetAddCategory">+</button></span>
                            <select @bind="_budgetCatId">
                                @foreach (var (cat, depth) in withoutBudget)
                                {
                                    <option value="@cat.Id">@CatOption(cat.Id, cat.Name, depth)</option>
                                }
                            </select>
                        </label>
                        <label>@Loc["Budget amount"] <input type="number" step="0.01" min="0" @bind="_fBudget" /></label>
                        <div class="modal-actions">
                            <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                            <button @onclick="SaveAddBudget" disabled="@(_budgetCatId == Guid.Empty || _fBudget <= 0)">@Loc["Add"]</button>
                        </div>
                    }
                    break;

                case Modal.EditCat:
                    @* Cancel/Save live in the head, not at the foot: this modal has its own sticky header, so the
                       floating ✕/✓ would land on top of it. Same ✕/✓ language as every other modal. *@
                    <div class="modal-head">
                        <h3>@State.CategoryIcon(_modalCatId) @Loc["Edit"] @State.CategoryName(_modalCatId)</h3>
                        <span class="modal-head-actions">
                            <button class="exp-edit" title="@Loc["Delete"]" @onclick="EditDeleteSelf">🗑️</button>
                            <button class="exp-edit" title="@Loc["Cancel"]" @onclick="Back">✕</button>
                            <button class="exp-edit head-ok" title="@Loc["Save"]" @onclick="SaveEditCat" disabled="@(string.IsNullOrWhiteSpace(_fName))">✓</button>
                        </span>
                    </div>
                    <div class="name-icon-row">
                        @iconButton
                        <label class="grow">@Loc["Name"] <input type="text" @bind="_fName" /></label>
                    </div>
                    @iconGrid
                    <label>@Loc["Budget amount"] <input type="number" step="0.01" min="0" @bind="_fBudget" /></label>
                    <small class="hint">@Loc["Available to budget:"] <strong>@Fmt(State.MaxBudgetFor(_modalCatId))</strong></small>
                    <label>@Loc["Alert at %"] <input type="number" step="1" min="0" max="100" @bind="_fThreshold" /></label>
                    <label class="check"><input type="checkbox" @bind="_fNotify" /> @Loc["Notify on every expense"]</label>
                    <label class="check"><input type="checkbox" @bind="_fEssential" /> @Loc["Essential spend (rent, groceries, health…)"]</label>
                    var subs = State.ChildrenOf(_modalCatId).ToList();
                    <div class="detail-sub-head">
                        <h4 class="detail-sub">@Loc["Sub-categories"]</h4>
                        <button class="lbl-add" title="@Loc["Sub-category"]" @onclick="EditAddSub">+</button>
                    </div>
                    @if (subs.Count > 0)
                    {
                        <ul class="list">
                            @foreach (var sub in subs)
                            {
                                var subId = sub.Id;
                                <li>
                                    <span class="row-main"><span class="cat-ico">@State.CategoryIcon(subId)</span> @sub.Name</span>
                                    <span class="row-actions">
                                        <button class="exp-edit" title="@Loc["Edit"]" @onclick="() => EditEditSub(subId)">✏️</button>
                                        <button class="exp-edit" title="@Loc["Remove"]" @onclick="() => EditDeleteSub(subId)">🗑️</button>
                                    </span>
                                </li>
                            }
                        </ul>
                    }
                    @if (_editCatVendors.Count > 0)
                    {
                        <h4 class="detail-sub">@Loc["Auto-categorized merchants"]</h4>
                        <small class="hint">@Loc["Imported transactions from these are filed here automatically. Unmapping only stops future auto-filing."]</small>
                        <ul class="list">
                            @foreach (var v in _editCatVendors)
                            {
                                @BankRuleRow((v, "category", "🔖"))
                            }
                        </ul>
                    }
                    break;

                case Modal.DeleteCat:
                    <h3>@Loc["Delete"] @State.CategoryName(_modalCatId)?</h3>
                    @if (State.CategoryRemovalBlocker(_modalCatId) is {} blocker)
                    {
                        <p class="hint">@Loc["Can’t delete —"] @blocker. @Loc["Remove those first."]</p>
                        <div class="modal-actions"><button class="ghost" @onclick="Back">@Loc["Close"]</button></div>
                    }
                    else
                    {
                        <p class="hint">@Loc["This removes the category permanently."]</p>
                        <div class="modal-actions">
                            <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                            <button class="danger-btn" @onclick="ConfirmDelete">@Loc["Delete"]</button>
                        </div>
                    }
                    break;

                case Modal.CategoryDetail:
                    <div class="modal-head">
                        <h3>@State.CategoryIcon(_modalCatId) @State.CategoryName(_modalCatId)</h3>
                        <span class="modal-head-actions">
                            <button class="exp-edit" title="@Loc["Edit / budget"]" @onclick="DetailEdit">✏️</button>
                            <button class="exp-edit" title="@Loc["Delete"]" @onclick="DetailDelete">🗑️</button>
                            <button class="exp-edit" title="@Loc["Close"]" @onclick="Back">✕</button>
                        </span>
                    </div>
                    @if (State.BudgetFor(_modalCatId) is { } cb)
                    {
                        <p class="hint">@Fmt(State.Coverage(_modalCatId).Spent) @Loc["spent of"] @Fmt(cb.Allocated) @Loc["budgeted"].</p>
                    }
                    else
                    {
                        <p class="hint">@Loc["No budget set for this category."]</p>
                    }
                    RenderFragment<FinApp.Domain.Budgeting.Expense> detailRow = e =>
                        @<li>
                            <span class="row-lead">
                                @if (State.IsPeriodOpen)
                                {
                                    <button class="exp-edit" title="@Loc["Edit"]" @onclick="() => DetailEditExpense(e.Id)">✏️</button>
                                    <button class="exp-edit" title="@Loc["Remove"]" @onclick="() => DetailDeleteExpense(e.Id)">🗑️</button>
                                }
                                <span>@e.Date.ToString("dd MMM") · <span class="cat-ico">@State.FundIcon(e.FundId)</span> @State.FundName(e.FundId)@(string.IsNullOrEmpty(e.Note) ? "" : $" · {e.Note}")</span>
                            </span>
                            <span class="amt">@Fmt(e.Amount)</span>
                        </li>;
                    // Parent's own expenses, then one labelled block per sub-category that has any — so the whole
                    // tree reads at a glance without drilling into each sub-category.
                    var ownExpenses = State.ExpensesFor(_modalCatId);
                    var childSections = State.ChildrenOf(_modalCatId)
                        .Select(c => (Cat: c, Items: State.ExpensesFor(c.Id)))
                        .Where(x => x.Items.Count > 0).ToList();
                    <h4 class="detail-sub">@Loc["Expenses"]</h4>
                    <ul class="list">
                        @foreach (var e in ownExpenses) { @detailRow(e) }
                        @if (ownExpenses.Count == 0 && childSections.Count == 0)
                        {
                            <li><em>@Loc["No expenses in this category yet."]</em></li>
                        }
                    </ul>
                    @foreach (var (sub, items) in childSections)
                    {
                        <h5 class="detail-subcat"><span class="cat-ico">@State.CategoryIcon(sub.Id)</span> @sub.Name <span class="detail-subcat-sum">@Fmt(items.Aggregate(State.Money(0m), (s, e) => s + e.Amount))</span></h5>
                        <ul class="list">
                            @foreach (var e in items) { @detailRow(e) }
                        </ul>
                    }
                    break;

                case Modal.Achievements:
                    <div class="modal-head">
                        <h3>🏆 @Loc["Achievements"]</h3>
                        <span class="modal-head-actions">
                            <button class="exp-edit" title="@Loc["Close"]" @onclick="Back">✕</button>
                        </span>
                    </div>
                    var achLog = State.Account.AchievementLog;
                    var achAll = CurrentAchievements();
                    var achEarned = achAll.Where(a => a.Earned).ToList();
                    var achLocked = achAll.Where(a => !a.Earned).OrderByDescending(a => a.Percent ?? 0).ToList();
                    <p class="hint">@string.Format(Loc["{0} of {1} earned"], achEarned.Count, achAll.Count)</p>
                    <div class="ring-grid ach-ring-grid">
                        @foreach (var a in achEarned)
                        {
                            <div class="ring-card">
                                @AchievementBadge(a)
                                <div class="ring-label ach-ring-label">
                                    <span class="ach-ring-title">@a.Title</span>
                                    <span class="ach-ring-desc">@a.Desc</span>
                                    @if (achLog.TryGetValue(a.Key, out var earnedOn))
                                    {
                                        <span class="ach-ring-sub">@earnedOn.ToString("dd MMM yyyy")</span>
                                    }
                                </div>
                            </div>
                        }
                        @foreach (var a in achLocked)
                        {
                            <div class="ring-card">
                                @AchievementBadge(a)
                                <div class="ring-label ach-ring-label">
                                    <span class="ach-ring-title ach-locked-title">@a.Title</span>
                                    <span class="ach-ring-desc">@a.Desc</span>
                                    @if (a.Percent is { } pct)
                                    {
                                        <span class="ach-ring-sub">@pct%</span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                    break;

                case Modal.AddAccount:
                    <h3>@Loc["New account"]</h3>
                    <label>@Loc["Name"] <input type="text" @bind="_fName" /></label>
                    <label>@Loc["Currency"] <input type="text" maxlength="3" @bind="_fCurrency" /></label>
                    @SavingsTargetField
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                        <button @onclick="SaveAddAccount" disabled="@(string.IsNullOrWhiteSpace(_fName))">@Loc["Create"]</button>
                    </div>
                    break;

                case Modal.EditAccount:
                    <h3>@Loc["Edit account"]</h3>
                    <label>@Loc["Name"] <input type="text" @bind="_fName" /></label>
                    @SavingsTargetField
                    <p class="hint">@Loc["Your monthly savings goal — drives the Insights score."] @Loc["Currency"] (@State.Currency) @Loc["can't be changed once an account exists."]</p>
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                        <button @onclick="SaveEditAccount" disabled="@(string.IsNullOrWhiteSpace(_fName))">@Loc["Save"]</button>
                    </div>
                    break;

                case Modal.Archived:
                    <div class="modal-head">
                        <h3>📦 @Loc["Archived items"]</h3>
                        <span class="modal-head-actions">
                            <button class="exp-edit" title="@Loc["Close"]" @onclick="Back">✕</button>
                        </span>
                    </div>
                    var arFunds = State.ArchivedFunds;
                    var arCats = State.ArchivedCategories;
                    var arBuckets = State.SavingBuckets.Where(x => x.Bucket.IsArchived).ToList();
                    @if (arFunds.Any() || arCats.Any() || arBuckets.Count > 0)
                    {
                        <p class="hint">@Loc["Archived items keep their history and stay out of the way. Restore one to use it again."]</p>
                    }
                    @if (arFunds.Any())
                    {
                        <h4 class="archived-h">💰 @Loc["Funds"]</h4>
                        <ul class="list">
                            @foreach (var f in arFunds)
                            {
                                var fid = f.Id;
                                <li class="row-menu-host">
                                    <span class="row-main"><span class="cat-ico">@State.FundIcon(fid)</span> @f.Name</span>
                                    <span class="row-actions"><button class="exp-edit" title="@Loc["Restore"]" @onclick="() => State.RestoreFund(fid)">♻️</button></span>
                                </li>
                            }
                        </ul>
                    }
                    @if (arCats.Any())
                    {
                        <h4 class="archived-h">🍽️ @Loc["Spending categories"]</h4>
                        <ul class="list">
                            @foreach (var c in arCats)
                            {
                                <li class="row-menu-host">
                                    <span class="row-main"><span class="cat-ico">@State.CategoryIcon(c.Id)</span> @c.Name</span>
                                    <span class="row-actions"><button class="exp-edit" title="@Loc["Restore"]" @onclick="() => State.RestoreCategory(c.Id)">♻️</button></span>
                                </li>
                            }
                        </ul>
                    }
                    @if (arBuckets.Count > 0)
                    {
                        <h4 class="archived-h">🎯 @Loc["Debts & savings"]</h4>
                        <ul class="list">
                            @foreach (var a in arBuckets)
                            {
                                var aid = a.Bucket.Id;
                                <li>
                                    <span class="row-lead"><span class="cat-ico">@State.SavingBucketIcon(aid)</span> @a.Bucket.Name <span class="row-note">· @(a.Bucket.IsDebt ? Loc["debt"] : Loc["savings"])</span></span>
                                    <span class="row-actions">
                                        <button class="exp-edit" title="@Loc["Restore"]" @onclick="() => RestoreBucket(aid)">↩️</button>
                                        <button class="exp-edit" title="@Loc["Remove"]" @onclick="() => OpenDeleteBucket(aid)">🗑️</button>
                                    </span>
                                </li>
                            }
                        </ul>
                    }
                    @if (!arFunds.Any() && !arCats.Any() && arBuckets.Count == 0)
                    {
                        <p class="hint">@Loc["Nothing archived."]</p>
                    }
                    break;

                case Modal.DeleteAccount:
                    <h3>@Loc["Delete"] @State.Account.Name?</h3>
                    <p class="hint">@Loc["The account is archived and hidden for 30 days — you can restore it from your profile — then it and"] <strong>@Loc["all its periods, budgets, expenses and savings"]</strong> @Loc["are permanently deleted."]</p>
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                        <button class="danger-btn" @onclick="ConfirmDeleteAccount">@Loc["Delete account"]</button>
                    </div>
                    break;

                case Modal.RemoveMember:
                    <h3>@Loc["Remove"] @_removeMemberName?</h3>
                    <p class="hint">@string.Format(Loc["{0} will lose access to this account. Their recorded contributions and expenses stay."], _removeMemberName)</p>
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                        <button class="danger-btn" @onclick="ConfirmRemoveMember">@Loc["Remove from account"]</button>
                    </div>
                    break;

                case Modal.LeaveAccount:
                    <h3>@Loc["Leave"] @State.Account.Name?</h3>
                    @if (State.RealUsers.Count <= 1)
                    {
                        <p class="hint">@Loc["You're the only person here, so the account will be archived for 30 days. You can restore it from your profile before then; after that it's deleted."]</p>
                    }
                    else if (State.CurrentOwnerId == State.MyUserId)
                    {
                        <p class="hint">@Loc["You own this account, so hand it to another member before you go."]</p>
                        <label>@Loc["New owner"]
                            <select @bind="_leaveNewOwnerId">
                                <option value="@Guid.Empty">@Loc["Choose a member…"]</option>
                                @foreach (var m in State.OtherMembers)
                                {
                                    <option value="@m.UserId">@m.DisplayName</option>
                                }
                            </select>
                        </label>
                    }
                    else
                    {
                        <p class="hint">@Loc["You'll lose access to this account. Your recorded contributions and expenses stay for the others."]</p>
                    }
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                        <button class="danger-btn" @onclick="ConfirmLeaveAccount"
                                disabled="@(State.RealUsers.Count > 1 && State.CurrentOwnerId == State.MyUserId && _leaveNewOwnerId == Guid.Empty)">
                            @(State.RealUsers.Count <= 1 ? Loc["Archive account"] : Loc["Leave account"])
                        </button>
                    </div>
                    break;

                case Modal.Invite:
                    <h3>@Loc["Invite to"] @State.Account.Name</h3>
                    <p class="hint">@Loc["Enter the username of an existing FinApp user. They'll get a prompt to accept; once they do, they can edit everything except deleting the account."]</p>
                    <label>@Loc["Username"] <input type="text" @bind="_inviteUsername" @bind:event="oninput" /></label>
                    @if (_inviteMessage is not null)
                    {
                        <div class="alert">@_inviteMessage</div>
                    }
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Close"]</button>
                        <button @onclick="SendInvite" disabled="@(string.IsNullOrWhiteSpace(_inviteUsername))">Send invite</button>
                    </div>
                    break;

                case Modal.AddExpense:
                    <h3>@Loc["Add expense"]</h3>
                    @if (State.LastExpense is { } lastExp)
                    {
                        <button type="button" class="repeat-last" @onclick="RepeatLastExpense">↻ @Loc["Repeat last"]: <strong>@State.CategoryName(lastExp.CategoryId)</strong> · @Fmt(lastExp.Amount)</button>
                    }
                    var recentMerchants = State.RecentMerchants();
                    @if (recentMerchants.Count > 0)
                    {
                        <div class="merchant-chips">
                            <span class="chips-label">@Loc["Recent"]</span>
                            @foreach (var m in recentMerchants)
                            {
                                <button type="button" class="merchant-chip" @onclick="() => ApplyMerchant(m)" title="@($"{State.CategoryName(m.CategoryId)} · {Fmt(m.Amount)}")">@m.Note</button>
                            }
                        </div>
                    }
                    <label><span class="lbl-row">@Loc["Category"] <button type="button" class="lbl-add" title="@Loc["Add category"]" @onclick="ExpenseAddCategory">+</button></span>
                        <select @bind="_categoryId" @bind:after="OnExpenseCategoryChanged">
                            @foreach (var (cat, depth) in State.CategoryOptions)
                            {
                                <option value="@cat.Id">@CatOption(cat.Id, cat.Name, depth)</option>
                            }
                        </select>
                    </label>
                    <label>@Loc["Amount"] <input type="number" step="0.01" min="0" @bind="_amount" @bind:event="oninput" /></label>
                    @if (_amount < 0)
                    {
                        <small class="hint warn-text">@Loc["Amount can't be negative — enter what you spent."]</small>
                    }
                    <label>@Loc["Date"] <input type="date" @bind="_expenseDate" min="@State.Period.From.ToString("yyyy-MM-dd")" max="@State.Period.To.ToString("yyyy-MM-dd")" /></label>
                    <label><span class="lbl-row">@Loc["Fund"] <button type="button" class="lbl-add" title="@Loc["New fund"]" @onclick="ExpenseAddFund">+</button></span>
                        <select @bind="_fundId">
                            @foreach (var f in State.SelectableFunds)
                            {
                                <option value="@f.Id">@f.Name</option>
                            }
                        </select>
                    </label>
                    <label>@Loc["Note (optional)"] <input type="text" @bind="_note" /></label>
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                        <button @onclick="AddExpenseFromModal" disabled="@(_amount <= 0)">@Loc["Add"]</button>
                    </div>
                    break;

                case Modal.RemovePeriod:
                    <h3>@Loc["Remove this period?"]</h3>
                    <p class="hint">@Loc["This deletes period"] @State.PeriodNumber (@State.Period.From.ToString("dd MMM") – @State.Period.To.ToString("dd MMM yyyy")) @Loc["and everything in it, then re-opens the previous period as active."] @Loc["This can't be undone."]</p>
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                        <button class="danger-btn" @onclick="ConfirmRemovePeriod">@Loc["Remove period"]</button>
                    </div>
                    break;

                case Modal.NextPeriod:
                    <h3>@Loc["Start next month"]</h3>
                    <p class="hint">@Loc["Enter what each fund really holds now (previous closing balance:"] <strong>@Fmt(State.Period.ExpectedClosingBalance)</strong>). @Loc["These become the new period's opening balances — that money carries over and is fully available to budget or save."]</p>
                    @foreach (var f in State.SelectableFunds)
                    {
                        <label>@f.Name <input type="text" inputmode="text" @bind:get="RealOpeningText(f.Id)" @bind:set="v => SetRealOpeningText(f.Id, v)" /></label>
                    }
                    <label class="check"><input type="checkbox" @bind="_copyBudgets" /> Copy this period’s budgets forward</label>
                    @if (_copyBudgets)
                    {
                        <label class="check"><input type="checkbox" @bind="_adjustBudgets" /> @Loc["Adjust budgets to this period’s spending"]</label>
                        <small class="hint">@Loc["Each budget moves halfway toward what was actually spent, rounded up to the nearest 10."]</small>
                    }
                    @if (_reconcileGaps is { Count: > 0 } gaps)
                    {
                        <div class="alert warn-bg">
                            <span>@Loc["Some funds don’t match what you logged — that usually means a transaction wasn’t recorded:"]</span>
                            <ul class="list">
                                @foreach (var g in gaps)
                                {
                                    <li>
                                        <span class="row-main">@State.FundName(g.FundId)</span>
                                        <span>@Fmt(State.Money(Math.Abs(g.Gap))) @(g.Gap < 0 ? Loc["less than expected (unlogged spending)"] : Loc["more than expected (unlogged money-in)"])</span>
                                    </li>
                                }
                            </ul>
                        </div>
                        <div class="modal-actions">
                            <button class="ghost" @onclick="() => { _reconcileGaps = null; CloseModal(); }">@Loc["I’ll add it myself"]</button>
                            <button class="ghost" disabled="@_busy" @onclick="RolloverIgnoringGaps">@Loc["Ignore"]</button>
                            <button disabled="@_busy" @onclick="RolloverWithAdjustments">@Loc["Log as adjustment"]</button>
                        </div>
                    }
                    else
                    {
                        <div class="modal-actions">
                            <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                            <button disabled="@_busy" @onclick="StartNextMonth">@Loc["Start next month"] →</button>
                        </div>
                    }
                    break;

                case Modal.EditExpense:
                    <h3>@Loc["Edit expense"]</h3>
                    <label>@Loc["Category"]
                        <select @bind="_categoryId">
                            @foreach (var (cat, depth) in State.CategoryOptions)
                            {
                                <option value="@cat.Id">@CatOption(cat.Id, cat.Name, depth)</option>
                            }
                        </select>
                    </label>
                    <label>@Loc["Amount"] <input type="number" step="0.01" min="0" @bind="_amount" /></label>
                    <label>@Loc["Date"] <input type="date" @bind="_expenseDate" /></label>
                    @if (State.FindExpense(_editExpenseId) is { FundSynced: true })
                    {
                        // A bank-synced expense lives in the synced fund (its balance mirrors the real account) — its
                        // fund can't be reassigned without breaking that mirror, so show it read-only.
                        <label>@Loc["Fund"] <input type="text" value="@State.FundName(_fundId) 🏦" disabled /></label>
                    }
                    else
                    {
                        <label>@Loc["Fund"]
                            <select @bind="_fundId">
                                @foreach (var f in State.SelectableFunds)
                                {
                                    <option value="@f.Id">@f.Name</option>
                                }
                            </select>
                        </label>
                    }
                    <label>@Loc["Note (optional)"] <input type="text" @bind="_note" /></label>
                    @if (State.FindExpense(_editExpenseId) is { AutoFiled: true } editExp)
                    {
                        @if (!string.IsNullOrEmpty(editExp.Note) && MappedLabel(editExp.Note!) is { } target)
                        {
                            <p class="hint">🏦 @Loc["Auto-filed from a saved bank rule:"] <strong>@editExp.Note</strong> → <strong>@target</strong></p>
                            <ul class="list">@BankRuleRow((BudgetingState.BankMatchKey(editExp.Note!), "category", "🔖"))</ul>
                        }
                        else
                        {
                            <p class="hint">🏦 @Loc["Filed automatically from your bank."]</p>
                        }
                    }
                    @if (State.FindExpense(_editExpenseId) is { IsSettlementDestination: false } && State.TransferableAccounts.Any())
                    {
                        <button type="button" class="link settle-link" @onclick="() => OpenSettleExpense(_editExpenseId)">🤝 @(State.FindExpense(_editExpenseId)!.IsSettlementSource ? Loc["Edit settlement onto another account"] : Loc["Settle part onto another account"])</button>
                    }
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                        <button @onclick="SaveEditExpense" disabled="@(_amount <= 0)">@Loc["Save"]</button>
                    </div>
                    break;

                case Modal.DeleteExpense:
                    <h3>@Loc["Remove this expense?"]</h3>
                    @if (State.FindExpense(_editExpenseId) is { } ex)
                    {
                        <p class="hint">@ex.Date.ToString("dd MMM") · @State.CategoryName(ex.CategoryId) · @Fmt(ex.Amount)@(ex.IsFromSavings ? " — the savings drawdown will be restored." : "")</p>
                    }
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                        <button class="danger-btn" @onclick="ConfirmDeleteExpense">@Loc["Remove"]</button>
                    </div>
                    break;

                case Modal.SettleExpense:
                    <h3>@Loc["Settle onto another account"]</h3>
                    @if (State.FindExpense(_settleExpenseId) is { } se)
                    {
                        <p class="hint">@se.Date.ToString("dd MMM") · @State.CategoryName(se.CategoryId) · @Loc["Original:"] @Fmt(se.OriginalAmount)</p>
                    }
                    @if (!State.TransferableAccounts.Any())
                    {
                        <p class="hint">@Loc["You have no other same-currency account to settle onto."]</p>
                        <div class="modal-actions"><button class="ghost" @onclick="Back">@Loc["Close"]</button></div>
                    }
                    else
                    {
                        <label>@Loc["Account"]
                            <select @bind="_settleDestId" @bind:after="OnSettleDestChanged">
                                @foreach (var a in State.TransferableAccounts)
                                {
                                    <option value="@a.Id">@a.Name</option>
                                }
                            </select>
                        </label>
                        <label>@Loc["Destination fund"]
                            <select @bind="_settleDestFundId">
                                @foreach (var f in DestFundsFor(_settleDestId))
                                {
                                    <option value="@f.Id">@f.Name</option>
                                }
                            </select>
                        </label>
                        <label>@Loc["Category"]
                            <select @bind="_settleDestCatId">
                                @foreach (var c in DestCatsFor(_settleDestId))
                                {
                                    <option value="@c.Id">@c.Name</option>
                                }
                            </select>
                        </label>
                        <label>@Loc["Amount"] <input type="number" step="0.01" min="0" @bind="_settleAmount" /></label>
                        <label>@Loc["Note (optional)"] <input type="text" @bind="_settleNote" /></label>
                        <small class="hint">@Loc["Records this amount as an expense on the chosen account (in that fund and category) and reduces this expense by the same amount."]</small>
                        <div class="modal-actions">
                            @if (_settleIsEdit)
                            {
                                <button class="ghost danger" @onclick="UnsettleFromModal">@Loc["Unsettle"]</button>
                            }
                            <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                            <button @onclick="ConfirmSettleExpense" disabled="@(_settleAmount <= 0 || _settleDestId == Guid.Empty)">🤝 @(_settleIsEdit ? Loc["Save"] : Loc["Settle"])</button>
                        </div>
                    }
                    break;

                case Modal.AddBucket:
                case Modal.EditBucket:
                    <h3>@(_modal == Modal.AddBucket ? Loc["New savings bucket"] : $"{Loc["Edit"]} {State.FindSavingBucket(_modalBucketId)?.Name}")</h3>
                    <div class="name-icon-row">
                        @iconButton
                        <label class="grow">@Loc["Name"] <input type="text" @bind="_fName" /></label>
                    </div>
                    @iconGrid
                    <label>@Loc["Type"]</label>
                    <div class="plan-toggle bucket-type" role="group">
                        <button type="button" class="chip @(_bucketKind == SavingKind.Common ? "on" : "")" @onclick="() => _bucketKind = SavingKind.Common">💰 @Loc["Savings goal"]</button>
                        <button type="button" class="chip @(_bucketKind == SavingKind.Debt ? "on" : "")" @onclick="() => _bucketKind = SavingKind.Debt">💳 @Loc["Debt payoff"]</button>
                        <button type="button" class="chip @(_bucketKind == SavingKind.Investment ? "on" : "")" @onclick="() => _bucketKind = SavingKind.Investment">📈 @Loc["Investment"]</button>
                    </div>
                    @if (_bucketKind == SavingKind.Debt)
                    {
                        <label>@Loc["Balance owed"] <input type="number" step="0.01" min="0" @bind="_debtBalance" /></label>
                        <label>@Loc["Interest rate (% APR)"] <input type="number" step="0.1" min="0" @bind="_debtRate" /></label>
                        <label>@Loc["Monthly installment"] <input type="number" step="0.01" min="0" @bind="_debtInstallment" /></label>
                        <small class="hint">@Loc["Used only to project your payoff — never changes budgets, savings or balances. Set money aside with 💰, then pay the bank with 🎯."]</small>
                    }
                    else if (_bucketKind == SavingKind.Investment)
                    {
                        <label>@Loc["Expected return (% / year)"] <input type="number" step="0.1" min="0" @bind="_invRate" /></label>
                        <label>@Loc["Horizon (years)"] <input type="number" step="1" min="0" @bind="_invTermYears" /></label>
                        <label>@Loc["Compounding"]
                            <select @bind="_invCompounds">
                                <option value="12">@Loc["Monthly"]</option>
                                <option value="4">@Loc["Quarterly"]</option>
                                <option value="1">@Loc["Yearly"]</option>
                                <option value="365">@Loc["Daily"]</option>
                            </select>
                        </label>
                        <small class="hint">@Loc["Used only to project growth — never changes budgets, savings or balances. Fund it with 💰; the projection grows your accumulated balance at this rate."]</small>
                    }
                    else
                    {
                        @* A goal and a set of costs answer opposite questions, so a bucket should carry one or the
                           other. A goal is a target you finish (0→100%); costs are an obligation that never
                           completes, because next year's insurance follows this year's. Together they make the
                           ring meaningless — is 60% "60% toward my holiday" or "60% of what insurance needs?" —
                           and they'd fight over the same sub-line. So each hides once the other is in use.
                           Deliberately NOT a new SavingKind: "kind is the wrong axis" (the reverted PlannedExpense).
                           A bucket that already has both keeps showing both, with a nudge to split — hiding real
                           data would be worse than the ambiguity it came from. *@
                        var hasCosts = ValidCostRows().Count > 0;
                        var hasGoal = _goalAmount > 0m;
                        if (hasCosts && hasGoal)
                        {
                            <div class="bucket-conflict">
                                ⚠️ @Loc["This bucket has both a goal and costs to cover. They track different things — consider splitting them into two buckets."]
                            </div>
                        }

                        @if (!hasCosts || hasGoal)
                        {
                            <label>@Loc["Goal amount (optional)"] <input type="number" step="0.01" min="0" @bind="_goalAmount" /></label>
                            <label>@Loc["Alert at %"] <input type="number" step="1" min="0" max="100" @bind="_fThreshold" /></label>
                            <label class="check"><input type="checkbox" @bind="_fNotify" /> @Loc["Notify on milestone"]</label>
                        }
                        else
                        {
                            <small class="hint">@Loc["Covering costs, so there's no goal to reach — a sinking fund tops up for good."]</small>
                        }

                        @* Sinking fund: the irregular costs this bucket exists to cover. Deliberately a list inside
                           the bucket, not a section of its own — it's a property of the bucket, like its goal. *@
                        @if (hasGoal && !hasCosts)
                        {
                            <small class="hint">@Loc["Saving toward a goal. To cover repeating costs instead, clear the goal amount."]</small>
                        }
                        else
                        {
                        <div class="cost-head">
                            <label>@Loc["Costs this covers (optional)"]</label>
                            <button type="button" class="fund-add" @onclick="AddCostRow">＋ @Loc["Add a cost"]</button>
                        </div>
                        @foreach (var costRow in _costRows)
                        {
                            <div class="cost-row">
                                <input type="text" class="cost-label" placeholder="@Loc["e.g. Insurance"]" @bind="costRow.Label" />
                                <input type="number" class="cost-amt" step="0.01" min="0" placeholder="0.00" @bind="costRow.Amount" />
                                <select class="cost-cad" @bind="costRow.Cadence">
                                    <option value="@CostCadence.Monthly">@Loc["Monthly"]</option>
                                    <option value="@CostCadence.Quarterly">@Loc["Quarterly"]</option>
                                    <option value="@CostCadence.Yearly">@Loc["Yearly"]</option>
                                    <option value="@CostCadence.OneOff">@Loc["One-off"]</option>
                                </select>
                                @if (costRow.Cadence == CostCadence.OneOff)
                                {
                                    <input type="date" class="cost-due" @bind="costRow.DueDate" />
                                }
                                <button type="button" class="exp-edit cost-del" title="@Loc["Remove"]" @onclick="() => RemoveCostRow(costRow)">🗑️</button>
                            </div>
                        }
                        @if (_costRows.Count > 0)
                        {
                            var setAside = EditingSetAside();
                            var shortfall = PlannedCost.TargetShortfallFor(ValidCostRows(), EditingSaved());
                            <div class="cost-total">
                                <span>@Loc["Set aside"] <strong>@Fmt(State.Money(setAside))</strong> @Loc["/ month"]</span>
                                @if (shortfall > 0m)
                                {
                                    <small class="cost-short">@string.Format(Loc["{0} still to find"], Fmt(State.Money(shortfall)))</small>
                                }
                            </div>
                            <small class="hint">@Loc["An amount to aim for, not a reservation — nothing moves on its own. Repeating costs are averaged over the year; a dated one-off is spread over the months until it's due, less what this bucket already holds."]</small>
                        }
                        }
                    }
                    <label>@Loc["Held in fund (optional)"]
                        <select @bind:get="_bucketFundId?.ToString()" @bind:set="v => _bucketFundId = Guid.TryParse(v, out var g) ? g : (Guid?)null">
                            <option value="">@Loc["— none —"]</option>
                            @foreach (var f in State.SelectableFunds)
                            {
                                <option value="@f.Id">@f.Name</option>
                            }
                        </select>
                    </label>
                    <small class="hint">@Loc["Which fund this bucket's money sits in. It moves no money — it just labels the bucket and picks the fund by default when you pay from it."]</small>
                    @if (State.CanSetInitialSavings)
                    {
                        <label>@Loc["Already saved (starting balance)"] <input type="number" step="0.01" min="0" @bind="_initialSavings" /></label>
                        <small class="hint">@Loc["Money you already had in this bucket before using FinApp. It counts toward the balance and goal, but not toward your savings rate."]</small>
                    }
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                        <button @onclick="SaveBucket" disabled="@(string.IsNullOrWhiteSpace(_fName))">@(_modal == Modal.AddBucket ? "Add" : "Save")</button>
                    </div>
                    break;

                case Modal.Transfer:
                    <h3>@Loc["Transfer from"] @State.FundName(_mTransferFromId)</h3>
                    <label>@Loc["To"]
                        <select @bind="_mTransferDestId" @bind:after="OnModalDestChanged">
                            <optgroup label="@Loc["Wallets"]">
                                @foreach (var f in State.RootFunds.Where(f => f.Id != _mTransferFromId))
                                {
                                    <option value="@f.Id">@f.Name</option>
                                }
                            </optgroup>
                            @if (State.TransferableAccounts.Any())
                            {
                                <optgroup label="@Loc["Other accounts"]">
                                    @foreach (var a in State.TransferableAccounts)
                                    {
                                        <option value="@a.Id">📤 @a.Name</option>
                                    }
                                </optgroup>
                            }
                        </select>
                    </label>
                    @if (MTransferDestIsAccount && DestFundsFor(_mTransferDestId).Count > 0)
                    {
                        <label>@Loc["Destination fund"]
                            <select @bind="_mTransferDestFundId">
                                @foreach (var f in DestFundsFor(_mTransferDestId))
                                {
                                    <option value="@f.Id">@f.Name</option>
                                }
                            </select>
                        </label>
                    }
                    <label>@Loc["Amount"] <input type="number" step="0.01" min="0" @bind="_mTransferAmount" /></label>
                    @if (MTransferDestIsAccount)
                    {
                        <small class="hint @(MTransferDipsSavings ? "warn-text" : "")">@Loc["In this fund:"] <strong>@Fmt(State.FundBalance(_mTransferFromId))</strong>. @(MTransferDipsSavings ? Loc["⚠ This dips into money earmarked for savings."] : "")</small>
                    }
                    else
                    {
                        <small class="hint">@Loc["Available in this fund:"] <strong>@Fmt(State.FundBalance(_mTransferFromId))</strong></small>
                    }
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                        <button @onclick="ConfirmTransfer" disabled="@(_mTransferAmount <= 0 || _mTransferDestId == Guid.Empty || _mTransferDestId == _mTransferFromId || _mTransferAmount > MTransferMax)">🔁 @Loc["Transfer money"]</button>
                    </div>
                    break;

                case Modal.BankTransfer:
                    <h3>⇄ @Loc["Transfer this money-out"]</h3>
                    @if (_bankXferTx is { } bx)
                    {
                        <p class="hint">@string.Format(Loc["{0} left {1} on {2}. Send it to another fund or account instead of logging an expense."], Fmt(new Money(Math.Abs(bx.Amount), State.Currency)), State.SyncedFundName, bx.Date.ToString("dd MMM"))</p>
                    }
                    <label>@Loc["To"]
                        <select @bind="_mTransferDestId" @bind:after="OnModalDestChanged">
                            <optgroup label="@Loc["Wallets"]">
                                @foreach (var f in State.RootFunds.Where(f => f.Id != State.SyncedFundId))
                                {
                                    <option value="@f.Id">@f.Name</option>
                                }
                            </optgroup>
                            @if (State.TransferableAccounts.Any())
                            {
                                <optgroup label="@Loc["Other accounts"]">
                                    @foreach (var a in State.TransferableAccounts)
                                    {
                                        <option value="@a.Id">📤 @a.Name</option>
                                    }
                                </optgroup>
                            }
                        </select>
                    </label>
                    @if (MTransferDestIsAccount && DestFundsFor(_mTransferDestId).Count > 0)
                    {
                        <label>@Loc["Destination fund"]
                            <select @bind="_mTransferDestFundId">
                                @foreach (var f in DestFundsFor(_mTransferDestId))
                                {
                                    <option value="@f.Id">@f.Name</option>
                                }
                            </select>
                        </label>
                    }
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                        <button @onclick="ConfirmBankTransferRow" disabled="@(_bankBusy || _mTransferDestId == Guid.Empty || _mTransferDestId == State.SyncedFundId)">⇄ @Loc["Record transfer"]</button>
                    </div>
                    break;

                case Modal.Deposit:
                    <h3>@Loc["Contribute"]</h3>
                    <label><span class="lbl-row">@Loc["Category"] <button type="button" class="lbl-add" title="@Loc["New contribution category"]" @onclick="DepositAddCategory">+</button></span>
                        <select @bind="_depCategoryId">
                            @foreach (var cc in State.ContributionCategories)
                            {
                                <option value="@cc.Id">@cc.Name</option>
                            }
                        </select>
                    </label>
                    <label><span class="lbl-row">@Loc["Fund"] <button type="button" class="lbl-add" title="@Loc["New fund"]" @onclick="DepositAddFund">+</button></span>
                        <select @bind="_depFundId">
                            @foreach (var f in State.SelectableFunds)
                            {
                                <option value="@f.Id">@f.Name</option>
                            }
                        </select>
                    </label>
                    <label>@Loc["Amount"] <input type="number" step="0.01" min="0" @bind="_depAmount" /></label>
                    <label>@Loc["Date"] <input type="date" @bind="_depDate" min="@State.Period.From.ToString("yyyy-MM-dd")" max="@State.Period.To.ToString("yyyy-MM-dd")" /></label>
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                        <button @onclick="RecordDeposit" disabled="@(_depAmount <= 0)">@Loc["Contribute"]</button>
                    </div>
                    break;

                case Modal.ManageContribCats:
                    <h3>@Loc["Contribution categories"]</h3>
                    <ul class="list">
                        @foreach (var cc in State.ContributionCategories)
                        {
                            <li>
                                <span class="row-lead">
                                    <button class="exp-edit" title="@Loc["Rename"]" @onclick="() => OpenEditContribCat(cc.Id)">✏️</button>
                                    <button class="exp-edit" title="@Loc["Remove"]" @onclick="() => OpenDeleteContribCat(cc.Id)">🗑️</button>
                                    <span><span class="cat-ico">@State.ContributionCategoryIcon(cc.Id)</span> @cc.Name</span>
                                </span>
                            </li>
                        }
                    </ul>
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Close"]</button>
                        <button @onclick="OpenAddContribCat">➕ @Loc["Add category"]</button>
                    </div>
                    break;

                case Modal.AddSaving:
                    <h3>@Loc["Add to savings"]</h3>
                    var saveBuckets = State.SavingBuckets.Where(b => !b.Bucket.IsArchived).ToList();
                    @if (saveBuckets.Count > 1)
                    {
                        <label>@Loc["Bucket"]
                            <select @bind="_savingBucketId">
                                @foreach (var (bucket, _) in saveBuckets)
                                {
                                    <option value="@bucket.Id">@(bucket.Icon ?? (bucket.IsDebt ? "💳" : "🐷")) @bucket.Name</option>
                                }
                            </select>
                        </label>
                    }
                    else
                    {
                        <p class="hint">@State.SavingBucketName(_savingBucketId)</p>
                    }
                    <label>@Loc["Amount"] <input type="number" step="0.01" min="0" @bind="_savingAmount" /></label>
                    <div class="avail-note">@Loc["Available to save:"] <strong>@Fmt(State.AvailableToSaveDisplay(_bankStatus?.Balance, _bankStatus?.BalanceCurrency))</strong> — @Loc["your cash that isn't already set aside for savings"].</div>
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                        <button @onclick="AllocateSaving" disabled="@(_savingAmount <= 0)">💰 @Loc["Add"]</button>
                    </div>
                    break;

                case Modal.Reallocate:
                    <h3>@Loc["Move budget to your debt"]</h3>
                    <p>@string.Format(Loc["Move {0} from your {1} budget toward {2}?"], Fmt(State.Money(_reallocAmount)), _reallocBudgetName, _reallocDebtName)</p>
                    <ul class="realloc-effects">
                        <li>✂️ @string.Format(Loc["{0} budget trimmed to {1}"], _reallocBudgetName, Fmt(State.Money(_reallocNewBudget)))</li>
                        <li>💰 @string.Format(Loc["{0} set aside toward {1}"], Fmt(State.Money(_reallocAmount)), _reallocDebtName)</li>
                    </ul>
                    <small class="hint">@Loc["This moves real money into your debt earmark and lowers this budget. You can change both later."]</small>
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                        <button @onclick="DoReallocate">💪 @Loc["Move it"]</button>
                    </div>
                    break;

                case Modal.Recurring:
                    <div class="modal-head">
                        <h3>🔁 @Loc["Recurring"]</h3>
                        <span class="modal-head-actions">
                            <button class="lbl-add" title="@Loc["Add recurring"]" @onclick="OpenAddRecurring">+</button>
                            <button class="exp-edit" title="@Loc["Close"]" @onclick="Back">✕</button>
                        </span>
                    </div>
                    <p class="hint">@Loc["Bills, salary and standing transfers that repeat monthly. They remind you when due — you confirm the real amount, so bills that vary stay accurate."]</p>
                    @if (State.RecurringItems.Count == 0)
                    {
                        <p class="hint">@Loc["Nothing recurring yet. Add your rent, salary or a monthly bill."]</p>
                    }
                    else
                    {
                        <ul class="list">
                            @foreach (var r in State.RecurringItems)
                            {
                                var rid = r.Id;
                                var amountText = r.AmountMode == RecurringAmountMode.ReminderOnly
                                    ? Loc["reminder only"]
                                    : (r.AmountMode == RecurringAmountMode.Typical ? "~" : "") + Fmt(State.Money(r.ExpectedAmount));
                                <li>
                                    <span class="row-main">
                                        <span class="cat-ico">@(r.Icon ?? (r.Kind == RecurringKind.Income ? "💷" : "🔁"))</span> @r.Name
                                        <span class="row-note">· @amountText · @Loc["day"] @r.DayOfMonth@(r.AutoPost ? " · ⚡" + @Loc["auto"] : "")@(r.Active ? "" : " · " + @Loc["paused"])</span>
                                    </span>
                                    <span class="row-actions">
                                        <button class="exp-edit" title="@Loc["Edit"]" @onclick="() => OpenEditRecurring(rid)">✏️</button>
                                        <button class="exp-edit" title="@Loc["Remove"]" @onclick="() => RemoveRecurringItem(rid)">🗑️</button>
                                    </span>
                                </li>
                            }
                        </ul>
                    }
                    @* Both of these already live in the sticky head (✕ and +), and a second sticky bar would have
                       floated straight on top of it. *@
                    break;

                case Modal.RecurringEdit:
                    <h3>@(_recEditId == Guid.Empty ? Loc["Add recurring"] : Loc["Edit recurring"])</h3>
                    <div class="plan-toggle" role="group">
                        <button type="button" class="chip @(_recKind == RecurringKind.Expense ? "on" : "")" @onclick="() => SetRecurringKind(RecurringKind.Expense)">💸 @Loc["Bill"]</button>
                        <button type="button" class="chip @(_recKind == RecurringKind.Income ? "on" : "")" @onclick="() => SetRecurringKind(RecurringKind.Income)">💷 @Loc["Income"]</button>
                    </div>
                    <label>@Loc["Name"] <input type="text" @bind="_recName" placeholder="@(_recKind == RecurringKind.Income ? "Salary" : "Rent")" /></label>
                    <label>@Loc["Category"]
                        <select @bind="_recCategoryId">
                            @if (_recKind == RecurringKind.Income)
                            {
                                @foreach (var c in State.ContributionCategories) { <option value="@c.Id">@c.Name</option> }
                            }
                            else
                            {
                                @foreach (var (cat, depth) in State.CategoryOptions) { <option value="@cat.Id">@CatOption(cat.Id, cat.Name, depth)</option> }
                            }
                        </select>
                    </label>
                    <label>@Loc["Fund"]
                        <select @bind="_recFundId">
                            @foreach (var f in State.SelectableFunds) { <option value="@f.Id">@f.Name</option> }
                        </select>
                    </label>
                    <label>@Loc["Amount"]</label>
                    <div class="plan-toggle" role="group">
                        <button type="button" class="chip @(_recMode == RecurringAmountMode.Fixed ? "on" : "")" @onclick="() => _recMode = RecurringAmountMode.Fixed">@Loc["Fixed"]</button>
                        <button type="button" class="chip @(_recMode == RecurringAmountMode.Typical ? "on" : "")" @onclick="() => _recMode = RecurringAmountMode.Typical">@Loc["Typical"]</button>
                        <button type="button" class="chip @(_recMode == RecurringAmountMode.ReminderOnly ? "on" : "")" @onclick="() => _recMode = RecurringAmountMode.ReminderOnly">@Loc["Reminder only"]</button>
                    </div>
                    @if (_recMode != RecurringAmountMode.ReminderOnly)
                    {
                        <label>@(_recMode == RecurringAmountMode.Typical ? Loc["Typical amount"] : Loc["Amount"]) <input type="number" step="0.01" min="0" @bind="_recAmount" /></label>
                        <small class="hint">@(_recMode == RecurringAmountMode.Typical ? Loc["An estimate that self-tunes toward what you actually pay."] : Loc["The same amount every month."])</small>
                    }
                    else
                    {
                        <small class="hint">@Loc["No amount — you'll enter the real figure each time it's due (good for a variable salary)."]</small>
                    }
                    <label>@Loc["Day of month"] <input type="number" step="1" min="1" max="28" @bind="_recDay" /></label>
                    @if (_recMode == RecurringAmountMode.Fixed)
                    {
                        <label class="check"><input type="checkbox" @bind="_recAutoPost" /> @Loc["Post automatically when due (don't ask me)"]</label>
                    }
                    <div class="modal-actions">
                        <button class="ghost" @onclick="() => _modal = Modal.Recurring">@Loc["Cancel"]</button>
                        <button @onclick="SaveRecurring" disabled="@(string.IsNullOrWhiteSpace(_recName))">@Loc["Save"]</button>
                    </div>
                    break;

                case Modal.RecurringConfirm:
                    var rc = State.RecurringItems.FirstOrDefault(x => x.Id == _recConfirmId);
                    <h3>@(rc?.Kind == RecurringKind.Income ? Loc["Confirm income"] : Loc["Confirm bill"])@(rc is null ? "" : " — " + rc.Name)</h3>
                    @if (rc is not null)
                    {
                        <p class="hint">@(rc.AmountMode == RecurringAmountMode.ReminderOnly
                            ? Loc["Enter what actually came in or went out."]
                            : string.Format(Loc["Expected about {0}. Adjust to the real amount if it differs."], Fmt(State.Money(rc.ExpectedAmount))))</p>
                    }
                    <label>@Loc["Actual amount"] <input type="number" step="0.01" min="0" @bind="_recConfirmAmount" @bind:event="oninput" /></label>
                    <div class="modal-actions">
                        <button class="ghost" @onclick="DoSkipRecurring">@Loc["Skip this month"]</button>
                        <button @onclick="DoConfirmRecurring" disabled="@(_recConfirmAmount <= 0)">@Loc["Confirm"]</button>
                    </div>
                    break;

                case Modal.AddOrImport:
                    <h3>➕ @Loc["Add a transaction"]</h3>
                    <p class="hint">@Loc["Record a single entry, or import many at once from a bank statement (expenses and income)."]</p>
                    <button class="qa-choice" @onclick="OpenAddExpenseTab">🧾 <span><strong>@Loc["Log an expense"]</strong><small>@Loc["Enter one spend by hand."]</small></span></button>
                    <button class="qa-choice" @onclick="OpenImport">📥 <span><strong>@Loc["Import statement"]</strong><small>@Loc["Bring in many from a bank file."]</small></span></button>
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Close"]</button>
                    </div>
                    break;

                case Modal.Import:
                    <h3>📥 @Loc["Import statement"]</h3>
                    @if (_importError is not null)
                    {
                        <div class="alert warn-bg"><span>@_importError</span></div>
                    }
                    @if (_importStep == ImportStep.Upload)
                    {
                        <p class="hint">@Loc["Export a statement from your bank (Excel, CSV, XML, OFX or QIF) and upload it here. It's parsed on your device — nothing is sent until you confirm the rows."]</p>
                        <p class="hint">@Loc["Tip: if your bank only offers a PDF, look for a \"download/export transactions\" option — it usually also offers Excel or CSV, which import cleanly."]</p>
                        <InputFile OnChange="OnImportFileSelected" accept=".xlsx,.xlsm,.xls,.htm,.html,.csv,.tsv,.txt,.xml,.camt,.ofx,.qfx,.qif" />
                        <div class="modal-actions"><button class="ghost" @onclick="Back">@Loc["Cancel"]</button></div>
                    }
                    else if (_importStep == ImportStep.MapCsv)
                    {
                        <p class="hint">@Loc["Tell us which columns to use."]</p>
                        <label>@Loc["Date"] <select @bind="_csvDate">@foreach (var (h, i) in _csvHeaders.Select((h, i) => (h, i))) { <option value="@i">@h</option> }</select></label>
                        <label>@Loc["Description"] <select @bind="_csvDesc">@foreach (var (h, i) in _csvHeaders.Select((h, i) => (h, i))) { <option value="@i">@h</option> }</select></label>
                        @if (CsvHasSplit)
                        {
                            <label>@Loc["Money out (debit)"] <select @bind="_csvDebit">@foreach (var (h, i) in _csvHeaders.Select((h, i) => (h, i))) { <option value="@i">@h</option> }</select></label>
                            <label>@Loc["Money in (credit)"] <select @bind="_csvCredit">@foreach (var (h, i) in _csvHeaders.Select((h, i) => (h, i))) { <option value="@i">@h</option> }</select></label>
                        }
                        else
                        {
                            <label>@Loc["Amount"] <select @bind="_csvAmount">@foreach (var (h, i) in _csvHeaders.Select((h, i) => (h, i))) { <option value="@i">@h</option> }</select></label>
                            <small class="hint">@Loc["Money out is negative, money in positive."]</small>
                        }
                        <div class="modal-actions">
                            <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                            <button @onclick="ApplyCsvMapping">@Loc["Preview"] →</button>
                        </div>
                    }
                    else
                    {
                        var incl = _importRows.Count(r => r.Include);
                        <p class="hint">@string.Format(Loc["{0} of {1} rows will import into this period. Uncheck anything you don't want."], incl, _importRows.Count)@(_importSkipped > 0 ? " " + string.Format(Loc["({0} dated outside this period were skipped.)"], _importSkipped) : "")</p>
                        <label>@Loc["Fund"] <select @bind="_importFund">@foreach (var f in State.SelectableFunds) { <option value="@f.Id">@f.Name</option> }</select></label>
                        <div class="import-head">
                            <button type="button" class="link" @onclick="() => SetAllImport(true)">@Loc["Select all"]</button>
                            <span>·</span>
                            <button type="button" class="link" @onclick="() => SetAllImport(false)">@Loc["Deselect all"]</button>
                            <span class="import-head-hint">📌 @Loc["pin a merchant to auto-file it (and similar names) here next time"]</span>
                        </div>
                        <ul class="list import-list">
                            @foreach (var imp in _importRows)
                            {
                                var r = imp;
                                var pinned = r.Tx.Amount < 0m && MappingFor(r.Tx.Description) is { Kind: "category" };
                                <li>
                                    <span class="row-lead">
                                        <input type="checkbox" checked="@r.Include" @onchange="e => r.Include = (bool)e.Value!" />
                                        <span class="import-when">@r.Tx.Date.ToString("dd MMM")</span>
                                        <span class="import-desc">@(string.IsNullOrWhiteSpace(r.Tx.Description) ? Loc["(no description)"] : r.Tx.Description)</span>
                                    </span>
                                    <span class="row-ops">
                                        @if (r.Duplicate) { <span class="row-note" title="@Loc["Looks already logged"]">⚠️</span> }
                                        <select @bind="r.CategoryId">
                                            @if (r.Tx.Amount < 0m)
                                            {
                                                @foreach (var (cat, depth) in State.CategoryOptions) { <option value="@cat.Id">@CatOption(cat.Id, cat.Name, depth)</option> }
                                            }
                                            else
                                            {
                                                @foreach (var cc in State.ContributionCategories) { <option value="@cc.Id">@cc.Name</option> }
                                            }
                                        </select>
                                        @if (r.Tx.Amount < 0m && !string.IsNullOrWhiteSpace(r.Tx.Description))
                                        {
                                            <button type="button" class="icon-btn pin @(pinned ? "on" : "")" title="@(pinned ? Loc["Auto-files this merchant here — click to forget"] : Loc["Always file this merchant here in future"])" @onclick="() => ToggleImportPin(r)">📌</button>
                                        }
                                        <span class="amt @(r.Tx.Amount < 0m ? "" : "good-text")">@Fmt(State.Money(r.Tx.Amount))</span>
                                    </span>
                                </li>
                            }
                        </ul>
                        <div class="modal-actions">
                            <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                            <button @onclick="ConfirmImport" disabled="@(incl == 0)">@string.Format(Loc["Import {0}"], incl)</button>
                        </div>
                    }
                    break;

                case Modal.ExternalAccounts:
                    <h3>🏦 @Loc["External accounts"]</h3>
                    @if (Auth.CurrentUser is { EmailVerified: false })
                    {
                        <div class="alert warn-bg"><span>@Loc["Verify your email address before you can link a bank or view its data — bank connections show real financial information."]</span></div>
                        @if (_resendOk)
                        {
                            <p class="hint">✓ @Loc["Verification email sent. Check your inbox."]</p>
                        }
                        <button class="primary" @onclick="ResendVerificationFromBank" disabled="@_resendBusy">@Loc["Resend verification email"]</button>
                    }
                    else if (_bankStatus?.Enabled == true)
                    {
                        @if (!State.IsOwnerOfCurrent && _bankSharedAckKnown && !_bankSharedAck)
                        {
                            <div class="alert warn-bg">
                                <span>@Loc["This shared account shows a linked bank's real balances and transactions. Please keep it confidential; we recommend turning on two-factor authentication."]</span>
                                <button class="link" @onclick="AckBankShared" disabled="@_bankBusy">@Loc["Got it"]</button>
                            </div>
                        }
                        @if (!Auth.CurrentUser!.TwoFactorEnabled && !_2faRecDismissed)
                        {
                            <div class="alert warn-bg">
                                <span>@Loc["We strongly recommend turning on two-factor authentication (Profile → Two-factor) — this account is connected to real financial data."]</span>
                                <button class="alert-x" title="@Loc["Dismiss"]" @onclick="() => _2faRecDismissed = true">×</button>
                            </div>
                        }
                        <p class="pm-who">@State.Account.Name</p>
                        @if (!_bankStatus.Connected)
                        {
                            <p class="hint">@Loc["Link your Revolut account to pull transactions in automatically."] @Loc["Each account links its own bank."]</p>
                            <button class="primary" @onclick="LinkBankAsync" disabled="@_bankBusy">🔗 @Loc["Link Revolut"]</button>
                        }
                        else
                        {
                            <p class="bank-conn">
                                <span>@if (_bankStatus.InstitutionLogo is { } logo) { <img class="bank-logo-img" src="@logo" alt="" /> } else { <text>✅</text> } @_bankStatus.InstitutionName</span>
                                @if (_bankStatus.Balance is { } bal)
                                {
                                    <span class="bank-balance" title="@Loc["Live account balance"]">@Fmt(new Money(bal, _bankStatus.BalanceCurrency ?? State.Currency))</span>
                                }
                                @if (_bankStatus.LastSyncedAt is { } synced)
                                {
                                    <span class="row-note">· @Loc["last synced"] @synced.LocalDateTime.ToString("dd MMM HH:mm")</span>
                                }
                                <button class="link danger bank-disconnect" @onclick="DisconnectBankAsync" disabled="@_bankBusy">@Loc["Disconnect"]</button>
                            </p>
                            <p class="hint">@Loc["Map a fund to one of this bank's accounts by editing the fund and turning on sync."]</p>
                            @if (_bankStatus.ConsentExpiresAt is { } exp && exp <= DateTimeOffset.UtcNow)
                            {
                                <div class="alert warn-bg">
                                    <span>@Loc["Your bank consent has expired (banks require re-approval every 90 days)."]</span>
                                    <button class="link" @onclick="LinkBankAsync" disabled="@_bankBusy">@Loc["Reconnect"]</button>
                                </div>
                            }
                            @if (!State.HasSyncedFund)
                            {
                                <div class="alert warn-bg"><span>@Loc["Mark a fund as synced to this bank (a fund → Edit) so imports file automatically."]</span></div>
                            }
                            <p class="hint">@Loc["Imported expenses are reviewed in the Spending tab; money-in under Funds → Move money."]</p>
                        }
                        @if (_bankError is not null)
                        {
                            <div class="alert warn-bg"><span>@_bankError</span><button class="alert-x" title="@Loc["Dismiss"]" @onclick="() => _bankError = null">×</button></div>
                        }
                    }
                    else
                    {
                        <p class="hint">@Loc["Connecting a bank isn't available on this account."]</p>
                    }
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Close"]</button>
                    </div>
                    break;

                case Modal.BudgetSaving:
                    <h3>@Loc["Budget savings"] — @State.SavingBucketName(_spendBucketId)</h3>
                    <label>@Loc["Destination"]
                        <select @bind="_spendDestId">
                            <optgroup label="@Loc["Budgets"]">
                                @foreach (var (cat, depth) in State.CategoryOptions)
                                {
                                    <option value="@cat.Id">@CatOption(cat.Id, cat.Name, depth)</option>
                                }
                            </optgroup>
                            @if (State.SavingBuckets.Count > 1)
                            {
                                <optgroup label="@Loc["Savings buckets"]">
                                    @foreach (var (bucket, _) in State.SavingBuckets)
                                    {
                                        @if (bucket.Id != _spendBucketId)
                                        {
                                            <option value="@bucket.Id">@bucket.Name</option>
                                        }
                                    }
                                </optgroup>
                            }
                        </select>
                    </label>
                    <label>@Loc["Amount"] <input type="number" step="0.01" min="0" @bind="_spendAmount" /></label>
                    <small class="hint">@Loc["A budget matures the saving into this month's plan; another bucket just shifts it across. The source bucket drops either way."]</small>
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                        <button @onclick="MoveSaving" disabled="@(_spendAmount <= 0 || _spendDestId == Guid.Empty || _spendDestId == _spendBucketId)">➡️ @Loc["Move"]</button>
                    </div>
                    break;

                case Modal.SpendSaving:
                    <h3>@Loc["Spend savings"] — @State.SavingBucketName(_spendExpBucketId)</h3>
                    <label>@Loc["Category"]
                        <select @bind="_spendExpCategoryId">
                            @foreach (var (cat, depth) in State.CategoryOptions)
                            {
                                <option value="@cat.Id">@CatOption(cat.Id, cat.Name, depth)</option>
                            }
                        </select>
                    </label>
                    <label>@Loc["Amount"] <input type="number" step="0.01" min="0" @bind="_spendExpAmount" /></label>
                    <small class="hint">@Loc["Records a real expense paid straight from this bucket (dated today)."]</small>
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                        <button @onclick="SpendBucketAsExpense" disabled="@(_spendExpAmount <= 0 || _spendExpCategoryId == Guid.Empty)">💸 @Loc["Spend"]</button>
                    </div>
                    break;

                case Modal.DisburseSaving:
                    var disBucketBal = DisburseBucketBalance();
                    <h3>🎯 @Loc["Apply to a goal"] — @State.SavingBucketName(_disburseBucketId)</h3>
                    <label>@Loc["Amount"] <input type="number" step="0.01" min="0" @bind="_disburseAmount" /></label>
                    <small class="hint">@Loc["Saved in this bucket:"] <strong>@Fmt(disBucketBal)</strong></small>
                    <label>@Loc["Take the money from"]
                        <select @bind="_disburseFundId">
                            @foreach (var f in State.RootFunds)
                            {
                                <option value="@f.Id">@f.Name@(State.FundIsSynced(f.Id) ? Loc[" (synced)"] : "")</option>
                            }
                        </select>
                    </label>
                    <label>@Loc["What for? (e.g. loan prepayment)"] <input type="text" @bind="_disburseNote" /></label>
                    <small class="hint">@Loc["Money leaves that fund for this goal — it’s not counted as an expense and doesn’t dent your savings figures."]</small>
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                        <button @onclick="DisburseSavingFromModal" disabled="@(_disburseAmount <= 0 || _disburseAmount > disBucketBal.Amount || _disburseFundId == Guid.Empty)">🎯 @Loc["Apply"]</button>
                    </div>
                    break;

                case Modal.HealthScore:
                    var hs = CurrentReport();
                    <h3>💗 @Loc["Health score & trends"] @infoTip(("score-how", Loc["How your score works: four equal parts (25 pts each) — how much you saved vs your target, how well you kept to budget, living within your income, and your spending vs your recent average."]))</h3>
                    @if (!hs.HasData)
                    {
                        <p class="hint">📊 @Loc["Log some income or expenses to see your account overview here."]</p>
                    }
                    else
                    {
                        var hsBand = hs.Band switch { HealthBand.Healthy => "ok", HealthBand.Average => "warn", _ => "bad" };
                        <section class="score-detail">
                            <div class="score-verdict score-@hsBand">@hs.Verdict</div>
                            <p class="score-line">@hs.Summary</p>
                            <div class="score-bar-wrap">
                                <div class="score-bar-track">
                                    <div class="score-bar-needle" style="left:@(Math.Clamp(hs.Score, 2, 98))%"></div>
                                </div>
                                <div class="score-bar-labels">
                                    <span>@Loc["At risk"]</span><span>@Loc["Average"]</span><span>@Loc["Healthy"]</span>
                                </div>
                            </div>
                        </section>

                        @if (hs.QuickWins.Count > 0)
                        {
                            <h4 class="insight-h">@Loc["Quick wins"]</h4>
                            <div class="win-list">
                                @{ var qn = 0; }
                                @foreach (var w in hs.QuickWins)
                                {
                                    qn++;
                                    <div class="win"><div class="win-bullet">@qn</div><div class="win-text">@w.Text</div></div>
                                }
                            </div>
                        }

                        <h4 class="insight-h">@Loc["Savings rate"]</h4>
                        <section class="savings-rate-card">
                            <div class="savings-rate-head">
                                <span class="savings-pct">@PctOrDash(hs.SavingsRate)</span>
                                <span class="savings-target">@Loc["Target:"] <span>@PctText(hs.SavingsTarget)</span></span>
                            </div>
                            @{
                                var rateW = Math.Clamp((double)(hs.SavingsRate ?? 0m) * 100, 0, 100);
                                var goalW = Math.Clamp((double)hs.SavingsTarget * 100, 0, 100);
                            }
                            <div class="savings-track">
                                <div class="savings-fill" style="width:@rateW%"></div>
                                <div class="savings-goal-line" style="left:@goalW%"></div>
                            </div>
                            <div class="savings-footer">
                                <span>0%</span><span class="goal-label">@Loc["Goal"] @PctText(hs.SavingsTarget)</span><span>100%</span>
                            </div>
                            <div class="savings-critique">💡 @hs.SavingsCritique</div>
                        </section>

                        @if (hs.Trend.Count > 1)
                        {
                            <h4 class="insight-h">@Loc["Spending trend"]</h4>
                            <section class="trend-card">
                                <div class="trend-head">
                                    <span>@Loc["Outgoings"] · @Loc["avg"] @Fmt(hs.TrendAverage)</span>
                                    <span class="trend-dir @(hs.TrendUp ? "up" : "down")">@(hs.TrendUp ? "↑" : "↓") @(hs.TrendUp ? Loc["above average"] : Loc["below average"])</span>
                                </div>
                                <div class="trend-plot">
                                    <div class="trend-avg" style="bottom:@((Math.Clamp((double)hs.TrendAvgFraction, 0, 1) * 72).ToString(System.Globalization.CultureInfo.InvariantCulture))px"></div>
                                    @foreach (var t in hs.Trend)
                                    {
                                        <div class="trend-bar @(t.IsCurrent ? "current" : "")" style="height:@(Math.Max(3.0, (double)t.BarFraction * 72).ToString(System.Globalization.CultureInfo.InvariantCulture))px" title="@t.Label: @Fmt(t.Outgoings)"></div>
                                    }
                                </div>
                                <div class="trend-labels">
                                    @foreach (var t in hs.Trend)
                                    {
                                        <span class="@(t.IsCurrent ? "cur" : "")">@t.Label</span>
                                    }
                                </div>
                                <div class="trend-note">@hs.TrendNote</div>
                            </section>
                        }

                        @if (hs.MiniTrends.Count > 0)
                        {
                            <h4 class="insight-h">@Loc["Trends over time"]</h4>
                            <section class="mini-trends">
                                @foreach (var mt in hs.MiniTrends)
                                {
                                    <div class="mini-trend @(mt.Dir == DeltaDir.Up ? "up" : mt.Dir == DeltaDir.Down ? "down" : "flat")">
                                        <div class="mt-head">
                                            <span class="mt-label">@mt.Icon @mt.Label</span>
                                            <span class="mt-cur">@mt.CurrentText</span>
                                        </div>
                                        @TrendSparkline(mt.Points)
                                        <div class="mt-note">@mt.DeltaNote</div>
                                    </div>
                                }
                            </section>
                        }
                    }
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Close"]</button>
                    </div>
                    break;

                case Modal.PayoffProjection:
                    var pjBal = State.SavingBucketDebtBalance(_projBucketId);
                    var pjRate = State.SavingBucketDebtRate(_projBucketId);
                    var pjInst = State.SavingBucketDebtInstallment(_projBucketId);
                    var pjPace = State.EffectiveSavingPace(_projBucketId);
                    var pjPlanned = false;   // planned-contribution field retired — projections always use the demonstrated pace
                    var pjExtra = _payoffExtra > 0m ? _payoffExtra : 0m;
                    var pjTotal = pjInst + pjExtra;                       // installment is always there; extra is on top
                    var pjAtInst = FinApp.Domain.Forecasting.LoanForecast.PayOff(pjBal, pjRate, pjInst);
                    var pjAtTotal = FinApp.Domain.Forecasting.LoanForecast.PayOff(pjBal, pjRate, pjTotal);
                    // What changes the moment you actually pay what's set aside: the balance drops, so you're charged
                    // less interest every period from then on.
                    var pjSetAside = State.SavingBucketSaved(_projBucketId).Amount;
                    var pjPayNow = Math.Min(pjSetAside, pjBal);
                    var pjIntNow = FinApp.Domain.Forecasting.LoanForecast.MonthlyInterest(pjBal, pjRate);
                    var pjIntAfter = FinApp.Domain.Forecasting.LoanForecast.MonthlyInterest(pjBal - pjPayNow, pjRate);
                    // The two ways a lender can apply a lump-sum overpayment. Same money, same rate — the choice is
                    // only whether the saving lands as time or as monthly headroom, so show both and let the numbers
                    // argue. Shorter term always costs less interest; lower installment buys breathing room instead.
                    var pjAfterBal = pjBal - pjPayNow;
                    var pjShorter = FinApp.Domain.Forecasting.LoanForecast.PayOff(pjAfterBal, pjRate, pjInst);
                    var pjKeepMonths = pjAtInst?.Months ?? 0;
                    var pjLowerInst = pjKeepMonths > 0
                        ? FinApp.Domain.Forecasting.LoanForecast.PaymentFor(pjAfterBal, pjRate, pjKeepMonths)
                        : null;
                    <h3>📈 @Loc["Payoff projection"] — @State.SavingBucketName(_projBucketId)</h3>
                    <div class="proj-grid">
                        <span class="proj-k">@Loc["Balance owed"]</span><span class="proj-v">@Fmt(State.Money(pjBal))</span>
                        <span class="proj-k">@Loc["Set aside"]</span><span class="proj-v">@Fmt(State.SavingBucketSaved(_projBucketId))</span>
                        <span class="proj-k">@Loc["Rate"]</span><span class="proj-v">@pjRate% APR</span>
                        <span class="proj-k">@Loc["Installment"]</span><span class="proj-v">@Fmt(State.Money(pjInst))/@Loc["mo"]</span>
                        @* Was its own "At your installment" section; it's really just two more facts about the loan
                           as it stands, so it belongs in the summary rather than in a heading of its own. *@
                        @if (pjAtInst is { } ai)
                        {
                            <span class="proj-k">@Loc["Ends"]</span><span class="proj-v">@PayoffDate(ai.Months) <span class="ring-muted">(@MonthsText(ai.Months))</span></span>
                            <span class="proj-k">@Loc["Total interest"]</span><span class="proj-v">@Fmt(State.Money(ai.TotalInterest))</span>
                        }
                        else
                        {
                            <span class="proj-k">@Loc["Ends"]</span><span class="proj-v warn-text">@Loc["At this installment it never clears — it doesn’t cover the interest."]</span>
                        }
                    </div>
                    @if (pjPayNow > 0m && pjIntNow > 0m)
                    {
                        @* Two questions, deliberately kept apart: this one is "the money I have, once"; the next is
                           "money I'd add every month, forever". They used to read as one because the same set-aside
                           figure defaulted into both — the second then quoted an implausible per-month total. *@
                        <h4 class="detail-sub">💸 @string.Format(Loc["One-off — pay your {0} set aside now"], Fmt(State.Money(pjPayNow)))
                            @infoTip(("pp-partial", Loc["A payment lowers the balance right away, so the interest you're charged each period drops from then on. This is a single payment out of what you've already set aside — not a new monthly commitment."]))</h4>
                        @if (pjShorter is not null || pjLowerInst is not null)
                        {
                            <p class="hint pm-hint">@Loc["Your bank may offer a choice like:"]</p>
                            <table class="payoff-opts">
                                <thead>
                                    <tr>
                                        <th>@Loc["Their offer"]</th>
                                        <th>@Loc["Per month"]</th>
                                        <th>@Loc["Ends"]</th>
                                        <th>@Loc["Total interest"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (pjShorter is { } shorter)
                                    {
                                        <tr>
                                            <td>⏱️ @Loc["Shorter term"]</td>
                                            <td>@Fmt(State.Money(pjInst))</td>
                                            <td>@PayoffDate(shorter.Months)
                                                @if (pjAtInst is { } baseline && baseline.Months > shorter.Months)
                                                {
                                                    <span class="good-text">@string.Format(Loc[" ({0} sooner)"], MonthsText(baseline.Months - shorter.Months))</span>
                                                }
                                            </td>
                                            <td>@Fmt(State.Money(decimal.Round(pjInst * shorter.Months - pjAfterBal, 2)))</td>
                                        </tr>
                                    }
                                    @if (pjLowerInst is { } lower && pjKeepMonths > 0)
                                    {
                                        <tr>
                                            <td>💶 @Loc["Lower installment"]</td>
                                            <td>@Fmt(State.Money(lower)) <span class="good-text">(−@Fmt(State.Money(Math.Max(0m, pjInst - lower))))</span></td>
                                            <td>@PayoffDate(pjKeepMonths) <span class="ring-muted">@Loc["(unchanged)"]</span></td>
                                            <td>@Fmt(State.Money(decimal.Round(lower * pjKeepMonths - pjAfterBal, 2)))</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    }
                    <h4 class="detail-sub">🔁 @Loc["Ongoing — add more every month"]
                        @infoTip(("pp-pace", Loc["A recurring amount you'd pay on top of the installment every month, month after month — separate from the one-off above. Starts from your recent saving pace; change it to see how paying more (or less) moves the date and interest."]))
                        <button type="button" class="info-ico reset-ico" title="@(pjPlanned ? Loc["Reset to your planned contribution"] : Loc["Reset to your saving pace"])" @onclick="() => _payoffExtra = State.EffectiveSavingPace(_projBucketId)?.Amount ?? 0m">↺</button>
                    </h4>
                    <label class="proj-extra">@Loc["Extra on top /mo"] <input type="number" step="10" min="0" @bind="_payoffExtra" @bind:event="oninput" /></label>
                    <p class="hint pm-hint">@string.Format(Loc["{0} installment + {1} extra = {2}/mo"], Fmt(State.Money(pjInst)), Fmt(State.Money(pjExtra)), Fmt(State.Money(pjTotal)))@(pjPace is { } pc && pc.Amount > 0m ? string.Format(pjPlanned ? Loc[" · your plan {0}/period"] : Loc[" · your pace ~{0}/period"], Fmt(pc)) : "")</p>
                    @if (pjAtTotal is { } ap)
                    {
                        <p class="hint">🏁 @string.Format(Loc["Clear in {0} (~{1}) · interest {2}"], MonthsText(ap.Months), PayoffDate(ap.Months), Fmt(State.Money(ap.TotalInterest)))</p>
                        @if (pjAtInst is { } bi && (bi.Months > ap.Months || bi.TotalInterest > ap.TotalInterest))
                        {
                            <p class="hint good-text">➡️ @string.Format(Loc["{0} sooner · {1} less interest than the installment alone"], MonthsText(bi.Months - ap.Months), Fmt(State.Money(Math.Max(0m, bi.TotalInterest - ap.TotalInterest))))</p>
                        }
                    }
                    else
                    {
                        <p class="hint warn-text">@Loc["At this amount it wouldn’t cover the interest."]</p>
                    }
                    <div class="proj-disclaimer">⚠️ @Loc["For planning only — these figures are estimates, not financial advice. Your lender's actual terms (fees, rate changes, payment timing) can differ. For exact numbers, please check with your loan provider."]</div>
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Close"]</button>
                    </div>
                    break;

                case Modal.GoalProjection:
                    var gpSaved = State.SavingBucketSaved(_projBucketId);
                    var gpGoal = State.FindSavingBucket(_projBucketId)?.GoalAmount;
                    var gpPace = State.EffectiveSavingPace(_projBucketId);
                    var gpPlanned = false;   // planned-contribution field retired — see pjPlanned
                    int? gpPeriods = gpPace is { } gpp && gpp.Amount > 0m && gpGoal is { } gpg && gpg > gpSaved.Amount
                        ? (int)Math.Ceiling((double)((gpg - gpSaved.Amount) / gpp.Amount)) : null;
                    <h3>📅 @Loc["Goal projection"] — @State.SavingBucketName(_projBucketId)</h3>
                    <div class="proj-grid">
                        <span class="proj-k">@Loc["Saved so far"]</span><span class="proj-v">@Fmt(gpSaved)</span>
                        <span class="proj-k">@Loc["Goal"]</span><span class="proj-v">@(gpGoal is { } gg ? Fmt(State.Money(gg)) : "—")</span>
                    </div>
                    <h4 class="detail-sub">@(gpPlanned ? Loc["At your planned contribution"] : Loc["At your saving pace"]) @infoTip(("gp-pace", gpPlanned ? Loc["Uses the contribution you planned for this bucket, then counts how many periods until you reach the goal."] : Loc["Uses the average you actually set aside each period, then counts how many periods until you reach the goal."]))</h4>
                    @if (gpPace is { } gpace && gpace.Amount > 0m)
                    {
                        <p class="hint">@string.Format(gpPlanned ? Loc["You plan to set aside {0}/period."] : Loc["You set aside about {0}/period."], Fmt(gpace))</p>
                        @if (gpPeriods is { } gper)
                        {
                            <p class="hint">🏁 @string.Format(Loc["Reach your goal in {0} (~{1})"], MonthsText(gper), PayoffDate(gper))</p>
                        }
                        else if (gpGoal is not null)
                        {
                            <p class="hint good-text">✓ @Loc["Goal already reached."]</p>
                        }
                        else
                        {
                            <p class="hint">@Loc["Set a goal amount on this bucket (Edit) to see a target date."]</p>
                        }
                    }
                    else
                    {
                        <p class="hint">@Loc["Not enough history yet — set money aside a few times and we’ll project a date."]</p>
                    }
                    <small class="hint">@Loc["Projection only — it never changes your budgets, savings or balances."]</small>
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Close"]</button>
                    </div>
                    break;

                case Modal.InvestmentProjection:
                    var ivSaved = State.SavingBucketSaved(_projBucketId);
                    var ivRate = State.SavingBucketInvestmentRate(_projBucketId);
                    var ivTerm = State.SavingBucketInvestmentTermYears(_projBucketId);
                    var ivPace = State.EffectiveSavingPace(_projBucketId);
                    var ivPlanned = false;   // planned-contribution field retired — see pjPlanned
                    var ivExtra = _invExtra > 0m ? _invExtra : 0m;
                    var ivBase = State.ProjectInvestment(_projBucketId, 0m);
                    var ivWith = State.ProjectInvestment(_projBucketId, ivExtra);
                    <h3>📈 @Loc["Growth projection"] — @State.SavingBucketName(_projBucketId)</h3>
                    <div class="proj-grid">
                        <span class="proj-k">@Loc["Invested so far"]</span><span class="proj-v">@Fmt(ivSaved)</span>
                        <span class="proj-k">@Loc["Expected return"]</span><span class="proj-v">@ivRate% / @Loc["yr"]</span>
                        <span class="proj-k">@Loc["Horizon"]</span><span class="proj-v">@ivTerm.ToString("0.#") @Loc["years"]</span>
                    </div>
                    <h4 class="detail-sub">@Loc["Just what's invested now"] @infoTip(("iv-base", Loc["Grows only your current balance at the expected return over the horizon — no further contributions."]))</h4>
                    @if (ivBase is { Months: > 0 } b0)
                    {
                        <p class="hint">🏁 @string.Format(Loc["~{0} in {1} ({2} growth)"], Fmt(State.Money(b0.FutureValue)), MonthsText(b0.Months), Fmt(State.Money(b0.Growth)))</p>
                    }
                    else
                    {
                        <p class="hint">@Loc["Set a horizon (Edit) to project this investment's growth."]</p>
                    }
                    <h4 class="detail-sub">@Loc["Adding more each month"]
                        @infoTip(("iv-extra", Loc["Money you add on top each month. Starts from your saving pace — change it to see how investing more grows the total."]))
                        <button type="button" class="info-ico reset-ico" title="@(ivPlanned ? Loc["Reset to your planned contribution"] : Loc["Reset to your saving pace"])" @onclick="() => _invExtra = State.EffectiveSavingPace(_projBucketId)?.Amount ?? 0m">↺</button>
                    </h4>
                    <label class="proj-extra">@Loc["Extra /mo"] <input type="number" step="10" min="0" @bind="_invExtra" @bind:event="oninput" /></label>
                    @if (ivPace is { } ivp && ivp.Amount > 0m)
                    {
                        <p class="hint pm-hint">@string.Format(ivPlanned ? Loc["Your plan: {0}/period"] : Loc["Your pace: ~{0}/period"], Fmt(ivp))</p>
                    }
                    @if (ivWith is { Months: > 0 } bw)
                    {
                        <p class="hint">🏁 @string.Format(Loc["~{0} in {1} — {2} your contributions, {3} growth"], Fmt(State.Money(bw.FutureValue)), MonthsText(bw.Months), Fmt(State.Money(bw.Contributed)), Fmt(State.Money(bw.Growth)))</p>
                        @if (ivBase is { } b1 && bw.FutureValue > b1.FutureValue)
                        {
                            <p class="hint good-text">➡️ @string.Format(Loc["{0} more than leaving it alone."], Fmt(State.Money(bw.FutureValue - b1.FutureValue)))</p>
                        }
                    }
                    <div class="proj-disclaimer">⚠️ @Loc["For planning only — returns aren't guaranteed and real investments fluctuate. This isn't financial advice."]</div>
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Close"]</button>
                    </div>
                    break;

                case Modal.EditDeposit:
                    <h3>@Loc["Edit contribution"]</h3>
                    <label>@Loc["Category"]
                        <select @bind="_editContribCategoryId">
                            @foreach (var cc in State.ContributionCategories)
                            {
                                <option value="@cc.Id">@cc.Name</option>
                            }
                        </select>
                    </label>
                    <label>@Loc["Fund"]
                        <select @bind="_editContribFundId">
                            @foreach (var f in State.SelectableFunds)
                            {
                                <option value="@f.Id">@f.Name</option>
                            }
                        </select>
                    </label>
                    <label>@Loc["Amount"] <input type="number" step="0.01" min="0" @bind="_editContribAmount" /></label>
                    <label>@Loc["Date"] <input type="date" @bind="_editContribDate" min="@State.Period.From.ToString("yyyy-MM-dd")" max="@State.Period.To.ToString("yyyy-MM-dd")" /></label>
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                        <button @onclick="SaveEditDeposit" disabled="@(_editContribAmount <= 0)">@Loc["Save"]</button>
                    </div>
                    break;

                case Modal.DeleteDeposit:
                    <h3>@Loc["Delete contribution?"]</h3>
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                        <button class="danger-btn" @onclick="ConfirmDeleteDeposit">@Loc["Delete"]</button>
                    </div>
                    break;

                case Modal.ContribCat:
                    <h3>@(_contribCatId == Guid.Empty ? Loc["New contribution category"] : Loc["Rename category"])</h3>
                    <div class="name-icon-row">
                        <button type="button" class="name-icon-btn @(_iconOpen ? "open" : "")" title="@Loc["Choose an icon"]" @onclick="() => _iconOpen = !_iconOpen">@(_fIcon ?? (string.IsNullOrEmpty(_contribCatName) ? "🏷️" : CategoryIcons.Guess(_contribCatName)))</button>
                        <label class="grow">@Loc["Name"] <input type="text" @bind="_contribCatName" /></label>
                    </div>
                    @if (_iconOpen)
                    {
                        <div class="icon-grid">
                            <button type="button" class="icon-opt @(_fIcon is null ? "sel" : "")" title="@Loc["Auto (from name)"]" @onclick="@(() => { _fIcon = null; _iconOpen = false; })">@(string.IsNullOrEmpty(_contribCatName) ? "🏷️" : CategoryIcons.Guess(_contribCatName))</button>
                            @foreach (var ic in CategoryIcons.Palette)
                            {
                                <button type="button" class="icon-opt @(_fIcon == ic ? "sel" : "")" @onclick="@(() => { _fIcon = ic; _iconOpen = false; })">@ic</button>
                            }
                        </div>
                    }
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                        <button @onclick="SaveContribCat" disabled="@(string.IsNullOrWhiteSpace(_contribCatName))">@(_contribCatId == Guid.Empty ? Loc["Add"] : Loc["Save"])</button>
                    </div>
                    break;

                case Modal.DeleteContribCat:
                    <h3>@Loc["Remove category?"]</h3>
                    @if (State.ContributionCategoryRemovalBlocker(_contribCatId) is { } ccBlocker)
                    {
                        <p class="hint">@Loc["Can’t remove —"] @ccBlocker.</p>
                        <div class="modal-actions"><button class="ghost" @onclick="Back">@Loc["Close"]</button></div>
                    }
                    else
                    {
                        <p class="hint">@Loc["This removes the category permanently."]</p>
                        <div class="modal-actions">
                            <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                            <button class="danger-btn" @onclick="ConfirmDeleteContribCat">@Loc["Remove"]</button>
                        </div>
                    }
                    break;

                case Modal.EditSavingDeposit:
                    <h3>@Loc["Edit savings deposit —"] @State.SavingBucketName(_savingDepositBucketId)</h3>
                    <label>@Loc["Amount"] <input type="number" step="0.01" min="0" @bind="_savingDepositAmount" /></label>
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                        <button @onclick="SaveEditSavingDeposit" disabled="@(_savingDepositAmount <= 0)">@Loc["Save"]</button>
                    </div>
                    break;

                case Modal.DeleteSavingDeposit:
                    <h3>@Loc["Remove this savings deposit?"]</h3>
                    @if (State.FindSavingDeposit(_savingDepositId) is { } sd)
                    {
                        <p class="hint">@sd.Date.ToString("dd MMM") · @State.SavingBucketName(sd.SavingCategoryId) · @Fmt(sd.Amount)</p>
                    }
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                        <button class="danger-btn" @onclick="ConfirmDeleteSavingDeposit">@Loc["Remove"]</button>
                    </div>
                    break;

                case Modal.DeleteBucket:
                    <h3>@Loc["Remove"] @State.FindSavingBucket(_modalBucketId)?.Name?</h3>
                    @if (State.SavingBucketRemovalBlocker(_modalBucketId) is {} bucketBlocker)
                    {
                        <p class="hint">@Loc["Can’t remove —"] @bucketBlocker. @Loc["Spend or move its savings first."]</p>
                        <div class="modal-actions"><button class="ghost" @onclick="Back">@Loc["Close"]</button></div>
                    }
                    else
                    {
                        <p class="hint">@Loc["This removes the empty bucket permanently."]</p>
                        <div class="modal-actions">
                            <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                            <button class="danger-btn" @onclick="ConfirmDeleteBucket">@Loc["Remove"]</button>
                        </div>
                    }
                    break;

                case Modal.AddFund:
                    <h3>@Loc["New fund"]</h3>
                    <div class="name-icon-row">
                        @iconButton
                        <label class="grow">@Loc["Name"] <input type="text" @bind="_fName" /></label>
                    </div>
                    @iconGrid
                    <label>@Loc["Note (optional)"] <input type="text" @bind="_fundNote" /></label>
                    <label>@Loc["Opening balance this period (optional)"] <input type="text" inputmode="text" @bind:get="_openingAmount.ToString(System.Globalization.CultureInfo.InvariantCulture)" @bind:set="v => _openingAmount = EvalSum(v)" /></label>
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                        <button @onclick="SaveFund" disabled="@(string.IsNullOrWhiteSpace(_fName))">@Loc["Add"]</button>
                    </div>
                    break;

                case Modal.EditFund:
                    <h3>@State.FundIcon(_modalFundId) @Loc["Edit"] @State.FundName(_modalFundId)</h3>
                    <div class="name-icon-row">
                        @iconButton
                        <label class="grow">@Loc["Name"] <input type="text" @bind="_fName" /></label>
                    </div>
                    @iconGrid
                    <label>@Loc["Note (optional)"] <input type="text" @bind="_fundNote" /></label>
                    @if (!_fSynced)
                    {
                        <label>@Loc["Opening balance this period"] <input type="text" inputmode="text" @bind:get="_openingAmount.ToString(System.Globalization.CultureInfo.InvariantCulture)" @bind:set="v => _openingAmount = EvalSum(v)" /></label>
                    }
                    @* Funds-6: only offer syncing when there's an unsynced bank account to attach — i.e. this fund is
                       already the synced one (so you can unsync), or nothing is synced yet. Hidden when another fund
                       already owns the bank link. *@
                    @if (_bankStatus?.Connected == true && (State.FundIsSynced(_modalFundId) || !State.HasSyncedFund))
                    {
                        <label class="check"><input type="checkbox" @bind="_fSynced" /> @string.Format(Loc["Sync this fund with {0}"], _bankStatus.InstitutionName)</label>
                        @if (_fSynced)
                        {
                            <label>@Loc["Bank account"]
                                <select @bind="_fBankAccountRef">
                                    @if (_bankAccounts.Count == 0)
                                    {
                                        <option value="@(_bankStatus.AccountRef ?? "")">@Loc["Loading…"]</option>
                                    }
                                    @foreach (var a in _bankAccounts)
                                    {
                                        <option value="@a.Ref">@a.Label@(a.Balance is { } b ? $" · {Fmt(new Money(b, a.Currency ?? State.Currency))}" : "")</option>
                                    }
                                </select>
                            </label>
                            <small class="hint">@Loc["Bank imports post here, and its balance mirrors the real account — expenses, transfers and deposits won’t change it (only affects entries created from now on)."]</small>
                        }
                    }
                    else if (_bankStatus?.Enabled == true)
                    {
                        <small class="hint">@Loc["Link a bank first (Money → Bank sync) to sync a fund with it."]</small>
                    }
                    var fundRules = FundRulesFor(_modalFundId).ToList();
                    @if (fundRules.Count > 0)
                    {
                        <h4 class="detail-sub">@Loc["Auto money-in rules"]</h4>
                        <small class="hint">@Loc["Imported money-in from these merchants is auto-filed as a transfer from this fund. Unmapping only stops future auto-filing."]</small>
                        <ul class="list">
                            @foreach (var key in fundRules)
                            {
                                @BankRuleRow((key, "fund", "🏦"))
                            }
                        </ul>
                    }
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                        <button @onclick="SaveFundGated" disabled="@(string.IsNullOrWhiteSpace(_fName))">@Loc["Save"]</button>
                    </div>
                    break;

                case Modal.DeleteFund:
                    <h3>@Loc["Remove"] @State.FundName(_modalFundId)?</h3>
                    @if (State.FundRemovalBlocker(_modalFundId) is {} fundBlocker)
                    {
                        <p class="hint">@Loc["Can’t remove —"] @fundBlocker.</p>
                        <div class="modal-actions"><button class="ghost" @onclick="Back">@Loc["Close"]</button></div>
                    }
                    else
                    {
                        @if (State.FundHasOpeningBalance(_modalFundId))
                        {
                            <p class="hint">@Loc["This fund has an opening balance. Move it to another fund, or remove it as-is (the balance is dropped)."]</p>
                            <label>@Loc["Move balance to"]
                                <select @bind="_moveBalanceToId">
                                    <option value="@Guid.Empty">@Loc["— don’t move —"]</option>
                                    @foreach (var f in State.RootFunds.Where(f => f.Id != _modalFundId))
                                    {
                                        <option value="@f.Id">@f.Name</option>
                                    }
                                </select>
                            </label>
                        }
                        else
                        {
                            <p class="hint">@Loc["This removes the fund permanently."]</p>
                        }
                        <div class="modal-actions">
                            <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                            <button class="danger-btn" @onclick="ConfirmDeleteFund">@Loc["Remove"]</button>
                        </div>
                    }
                    break;

                case Modal.ArchiveFund:
                    <h3>📦 @Loc["Archive"] @State.FundName(_modalFundId)</h3>
                    var _arcBal = State.FundBalance(_modalFundId);
                    @if (_arcBal.Amount > 0m)
                    {
                        <p class="hint">@string.Format(Loc["This fund still holds {0}. Move it to another fund before archiving — its history stays intact and you can restore it anytime."], Fmt(_arcBal))</p>
                        <label>@Loc["Move balance to"]
                            <select @bind="_moveBalanceToId">
                                <option value="@Guid.Empty">@Loc["— choose a fund —"]</option>
                                @foreach (var f in State.RootFunds.Where(f => f.Id != _modalFundId && !State.FundIsSynced(f.Id)))
                                {
                                    <option value="@f.Id">@f.Name</option>
                                }
                            </select>
                        </label>
                    }
                    else
                    {
                        <p class="hint">@Loc["Archiving hides this fund but keeps all of its history. You can restore it anytime."]</p>
                    }
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                        <button class="danger-btn" @onclick="ConfirmArchiveFund" disabled="@(_arcBal.Amount > 0m && _moveBalanceToId == Guid.Empty)">📦 @Loc["Archive"]</button>
                    </div>
                    break;

                case Modal.FundMovements:
                    <h3>@(State.FundIsSynced(_modalFundId) ? "🔗" : State.FundIcon(_modalFundId)) @State.FundName(_modalFundId)</h3>
                    var _fmBal = State.FundIsSynced(_modalFundId) ? SyncedFundDisplay(_modalFundId).Amount : State.FundBalance(_modalFundId);
                    var _fmEarmarks = FundEarmarks(_modalFundId);
                    var _fmEarmarked = _fmEarmarks.Aggregate(State.Money(0), (s, e) => s + e.Total);
                    var _fmMoves = FundMovements(_modalFundId);
                    <div class="fund-move-summary">
                        <span>@Loc["In this fund"]</span><strong class="amt">@Fmt(_fmBal)</strong>
                    </div>
                    @if (State.FundNote(_modalFundId) is { Length: > 0 } _fmNote)
                    {
                        <p class="hint">@_fmNote</p>
                    }
                    @if (_fmEarmarks.Count > 0)
                    {
                        <h4 class="detail-sub">@Loc["Earmarked here"]</h4>
                        <small class="hint">@string.Format(Loc["{0} of this fund is set aside for savings buckets — {1} is free."], Fmt(_fmEarmarked), Fmt(_fmBal - _fmEarmarked))</small>
                        <ul class="list">
                            @foreach (var (bucket, total) in _fmEarmarks)
                            {
                                <li><span class="row-main"><span class="cat-ico">@State.SavingBucketIcon(bucket.Id)</span> @bucket.Name</span><span class="amt">@Fmt(total)</span></li>
                            }
                        </ul>
                    }
                    <h4 class="detail-sub">@Loc["This period"]</h4>
                    @if (_fmMoves.Count == 0)
                    {
                        <p class="hint">@Loc["No movements in or out this period."]</p>
                    }
                    else
                    {
                        <ul class="list">
                            @foreach (var m in _fmMoves)
                            {
                                <li>
                                    <span class="row-main">@m.Date.ToString("dd MMM") · @m.Label</span>
                                    <span class="amt @(m.In ? "credit" : "")">@(m.In ? "+" : "−")@Fmt(m.Amount)</span>
                                </li>
                            }
                        </ul>
                    }
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Close"]</button>
                    </div>
                    break;

                case Modal.EditTransfer:
                    <h3>@Loc["Edit transfer"]</h3>
                    @* A synced (bank) side mirrors the real account — it can't be reassigned, so show it read-only. *@
                    @if (State.FindFundTransfer(_editTransferId) is { FromSynced: true })
                    {
                        <label>@Loc["From"] <input type="text" value="@State.FundName(_editTransferFromId) 🏦" disabled /></label>
                    }
                    else
                    {
                        <label>@Loc["From"]
                            <select @bind="_editTransferFromId">
                                @foreach (var f in State.SelectableFunds)
                                {
                                    <option value="@f.Id">@f.Name</option>
                                }
                            </select>
                        </label>
                    }
                    @if (State.FindFundTransfer(_editTransferId) is { ToSynced: true })
                    {
                        <label>@Loc["To"] <input type="text" value="@State.FundName(_editTransferToId) 🏦" disabled /></label>
                    }
                    else
                    {
                        <label>@Loc["To"]
                            <select @bind="_editTransferToId">
                                @foreach (var f in State.SelectableFunds)
                                {
                                    <option value="@f.Id">@f.Name</option>
                                }
                            </select>
                        </label>
                    }
                    <label>@Loc["Amount"] <input type="number" step="0.01" min="0" @bind="_editTransferAmount" /></label>
                    <label>@Loc["Note (optional)"] <input type="text" @bind="_editTransferNote" /></label>
                    @if (State.FindFundTransfer(_editTransferId) is { AutoFiled: true } autoTr)
                    {
                        @if (!string.IsNullOrEmpty(autoTr.Note) && MappingFor(autoTr.Note!) is { Kind: "fund" })
                        {
                            <p class="hint">🏦 @Loc["Auto-filed from a saved money-in rule:"] <strong>@autoTr.Note</strong> → <strong>@State.FundName(autoTr.FromFundId)</strong></p>
                            <ul class="list">@BankRuleRow((BudgetingState.BankMatchKey(autoTr.Note!), "fund", "🏦"))</ul>
                        }
                        else
                        {
                            <p class="hint">🏦 @Loc["Filed automatically from your bank."]</p>
                        }
                    }
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                        <button @onclick="SaveEditTransfer" disabled="@(_editTransferAmount <= 0 || _editTransferFromId == _editTransferToId)">@Loc["Save"]</button>
                    </div>
                    break;

                case Modal.DeleteTransfer:
                    <h3>@Loc["Remove this transfer?"]</h3>
                    @if (State.FindFundTransfer(_editTransferId) is { } tr)
                    {
                        <p class="hint">@tr.Date.ToString("dd MMM") · @State.FundName(tr.FromFundId) → @State.FundName(tr.ToFundId) · @Fmt(tr.Amount)</p>
                    }
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                        <button class="danger-btn" @onclick="ConfirmDeleteTransfer">@Loc["Remove"]</button>
                    </div>
                    break;

                case Modal.EditPeriod:
                    <h3>@Loc["Edit period dates"]</h3>
                    <label>@Loc["From"] <input type="date" @bind="_periodFrom" /></label>
                    <label>@Loc["To"] <input type="date" @bind="_periodTo" /></label>
                    <p class="hint">@Loc["Later periods shift to stay contiguous, keeping their own lengths."]</p>
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                        <button @onclick="SaveEditPeriod" disabled="@(_periodTo < _periodFrom)">@Loc["Save"]</button>
                    </div>
                    break;

                case Modal.EditSavingMovement:
                    <h3>@Loc["Edit savings movement"]</h3>
                    @if (State.FindSavingMovement(_savingMovementId) is { } mv)
                    {
                        <p class="hint">@State.SavingMovementTarget(mv)</p>
                    }
                    <label>@Loc["Amount"] <input type="number" step="0.01" min="0" @bind="_savingMovementAmount" /></label>
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                        <button @onclick="SaveEditSavingMovement" disabled="@(_savingMovementAmount <= 0)">@Loc["Save"]</button>
                    </div>
                    break;

                case Modal.DeleteSavingMovement:
                    <h3>@Loc["Undo this savings movement?"]</h3>
                    @if (State.FindSavingMovement(_savingMovementId) is { } mvd)
                    {
                        <p class="hint">@mvd.Date.ToString("dd MMM") · @State.SavingMovementTarget(mvd) · @Fmt(State.Money(-mvd.Amount.Amount)). @(mvd.BudgetCategoryId is not null ? "The funded budget is reduced by this amount." : "Both buckets are restored.")</p>
                    }
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                        <button class="danger-btn" @onclick="ConfirmDeleteSavingMovement">@Loc["Undo"]</button>
                    </div>
                    break;

                case Modal.DeleteExternalTransfer:
                    <h3>@Loc["Remove this outgoing transfer?"]</h3>
                    @if (State.FindExternalTransfer(_extTransferId) is { } et)
                    {
                        <p class="hint">@et.Date.ToString("dd MMM") · @State.FundName(et.FundId) → @State.AccountName(et.ToAccountId ?? Guid.Empty) · @Fmt(et.Amount)</p>
                    }
                    <p class="hint warn-text">This only removes the outflow on this side. It does not reverse the deposit already recorded in the other account.</p>
                    <div class="modal-actions">
                        <button class="ghost" @onclick="Back">@Loc["Cancel"]</button>
                        <button class="danger-btn" @onclick="ConfirmDeleteExternalTransfer">@Loc["Remove"]</button>
                    </div>
                    break;
            }
        </div>
    </div>
}
}

@code {
    private enum Modal { None, PickAccount, BankReview, BankConsent, AddCat, AddBudget, DisburseSaving, PayoffProjection, GoalProjection, InvestmentProjection, BankTransfer, ExternalAccounts, HealthScore, EditCat, DeleteCat, CategoryDetail, AddAccount, EditAccount, DeleteAccount, RemoveMember, LeaveAccount, AddExpense, NextPeriod, RemovePeriod, EditExpense, DeleteExpense, SettleExpense, AddBucket, EditBucket, DeleteBucket, AddFund, EditFund, DeleteFund, Invite, Transfer, Deposit, EditDeposit, DeleteDeposit, ManageContribCats, ContribCat, DeleteContribCat, AddSaving, BudgetSaving, SpendSaving, EditSavingDeposit, DeleteSavingDeposit, EditTransfer, DeleteTransfer, EditPeriod, EditSavingMovement, DeleteSavingMovement, DeleteExternalTransfer, Achievements, Reallocate, Recurring, RecurringEdit, RecurringConfirm, Import, AddOrImport, ArchiveFund, FundMovements, Archived }
    private enum Tab { Overview, Account, Budgets, Savings }

    /// <summary>Which kind of goal the Goals grid is showing. Defaults to All so the filter narrows on request
    /// rather than hiding anything by default.</summary>
    private enum GoalFilter { All, Debts, Savings, Investments }
    private GoalFilter _goalFilter = GoalFilter.All;

    private Tab _tab = Tab.Overview;
    private bool _moveOpen;

    // Per-row "⋯" action menu: the id of the row whose menu is open (Guid.Empty = none).
    private Guid _rowMenuId;
    private void ToggleRowMenu(Guid id) => _rowMenuId = _rowMenuId == id ? Guid.Empty : id;
    private void RowAct(Action a) { _rowMenuId = Guid.Empty; a(); }

    // Budget-circle popover: one action menu per category (edit / expenses / add / sub-categories) so the circles
    // stay clean instead of piling on buttons.
    private Guid _budgetMenuId;
    private void ToggleBudgetMenu(Guid id) => _budgetMenuId = _budgetMenuId == id ? Guid.Empty : id;
    private void BudgetAct(Action a) { _budgetMenuId = Guid.Empty; a(); }

    /// <summary>The click-anywhere-to-close action menu for a budget circle, listing its actions + sub-categories.</summary>
    private RenderFragment<Guid> BudgetCircleMenu => catId =>
        @<text>
            <div class="row-menu-backdrop" @onclick="() => _budgetMenuId = Guid.Empty"></div>
            <div class="row-menu">
                @if (State.IsPeriodOpen)
                {
                    <button @onclick="() => BudgetAct(() => OpenAddExpense(catId))">🧾 @Loc["Add expense"]</button>
                }
                <button @onclick="() => BudgetAct(() => OpenCategoryDetail(catId))">📋 @Loc["Expenses"]</button>
                <button @onclick="() => BudgetAct(() => OpenEdit(catId))">✏️ @Loc["Edit budget"]</button>
                @{
                    var subs = State.ChildrenOf(catId).ToList();
                }
                @if (subs.Count > 0)
                {
                    <div class="row-menu-head">@Loc["Sub-categories"]</div>
                    @foreach (var sub in subs)
                    {
                        var subId = sub.Id;
                        <button class="row-menu-sub" @onclick="() => BudgetAct(() => OpenCategoryDetail(subId))"><span class="cat-ico">@State.CategoryIcon(subId)</span> @sub.Name</button>
                    }
                }
                @if (State.IsPeriodOpen)
                {
                    <button @onclick="() => BudgetAct(() => OpenAddSub(catId))">➕ @Loc["Add sub-category"]</button>
                }
                <button class="danger" @onclick="() => ArchiveCat(catId)">📦 @Loc["Archive"]</button>
            </div>
        </text>;

    // Archive a category (and its sub-tree) — hides it but keeps every expense/budget in history. No reference blocker,
    // so it works even when the category is referenced (unlike delete). Mirrors ArchiveBucket.
    private async Task ArchiveCat(Guid catId) { _budgetMenuId = Guid.Empty; await State.ArchiveCategory(catId); }

    // --- Funds-as-circles: per-fund bubble menu (mirrors BudgetCircleMenu) --------------------------
    // Distinguishable colours for fund donut slices / legend swatches (synced=gold, over=red handled separately).
    private static readonly string[] FundPalette = { "#1d9e75", "#5dcaa5", "#0f6e56", "#37b6a0", "#8fd9c4", "#2a8f6b" };

    private Guid _fundMenuId;
    private void ToggleFundMenu(Guid id) => _fundMenuId = _fundMenuId == id ? Guid.Empty : id;
    private void FundAct(Action a) { _fundMenuId = Guid.Empty; a(); }

    private RenderFragment<Guid> FundCircleMenu => fid =>
        @<text>
            <div class="row-menu-backdrop" @onclick="() => _fundMenuId = Guid.Empty"></div>
            <div class="row-menu">
                <button @onclick="() => FundAct(() => OpenFundMovements(fid))">📋 @Loc["Movements"]</button>
                <button @onclick="() => FundAct(() => OpenEditFund(fid))">✏️ @Loc["Edit"]</button>
                @if (!State.FundIsSynced(fid))
                {
                    @if (State.IsPeriodOpen)
                    {
                        @if (CanTransfer)
                        {
                            <button @onclick="() => FundAct(() => OpenTransferFromFund(fid))">🔁 @Loc["Transfer"]</button>
                        }
                        <button @onclick="() => FundAct(() => OpenDepositToFund(fid))">➕ @Loc["Contribute"]</button>
                    }
                    <button class="danger" @onclick="() => FundAct(() => OpenArchiveFund(fid))">📦 @Loc["Archive"]</button>
                }
            </div>
        </text>;

    private void OpenFundMovements(Guid fundId) { _modalFundId = fundId; _modal = Modal.FundMovements; }

    private void OpenArchiveFund(Guid fundId)
    {
        _modalFundId = fundId;
        _moveBalanceToId = State.RootFunds.FirstOrDefault(f => f.Id != fundId && !State.FundIsSynced(f.Id))?.Id ?? Guid.Empty;
        _modal = Modal.ArchiveFund;
    }

    private Task ConfirmArchiveFund() => RunModal(async () =>
    {
        var bal = State.FundBalance(_modalFundId);
        if (bal.Amount > 0m)
        {
            if (_moveBalanceToId == Guid.Empty) return;   // must land the balance somewhere (archiving keeps history)
            await State.ArchiveFund(_modalFundId, _moveBalanceToId, bal.Amount);
        }
        else
        {
            await State.ArchiveFund(_modalFundId, null, 0m);
        }
        CloseModal();
    });

    // Money in/out of a fund this period — the human-readable ledger behind its balance (used by Modal.FundMovements).
    private record FundMove(DateOnly Date, string Label, Money Amount, bool In);
    private IReadOnlyList<FundMove> FundMovements(Guid fundId)
    {
        var p = State.Period;
        var list = new List<FundMove>();
        foreach (var b in p.InitialBalances.Where(b => b.FundId == fundId && b.Amount.Amount != 0m))
            list.Add(new(p.From, Loc["Opening balance"], b.Amount, b.Amount.Amount >= 0m));
        foreach (var c in p.Contributions.Where(c => c.MemberId != FinApp.Domain.Periods.Period.CarryoverSource && c.FundId == fundId))
            list.Add(new(c.Date, State.CategoryName(c.CategoryId) is { Length: > 0 } cn ? $"{Loc["Money in"]} · {cn}" : Loc["Money in"], c.Paid, true));
        foreach (var t in p.FundTransfers.Where(t => t.ToFundId == fundId))
            list.Add(new(t.Date, string.Format(Loc["Transfer from {0}"], State.FundName(t.FromFundId)), t.Amount, true));
        foreach (var t in p.FundTransfers.Where(t => t.FromFundId == fundId))
            list.Add(new(t.Date, string.Format(Loc["Transfer to {0}"], State.FundName(t.ToFundId)), t.Amount, false));
        foreach (var e in p.Expenses.Where(e => e.FundId == fundId))
            list.Add(new(e.Date, string.IsNullOrEmpty(e.Note) ? State.CategoryName(e.CategoryId) : $"{State.CategoryName(e.CategoryId)} · {e.Note}", e.Amount, false));
        foreach (var x in p.ExternalTransfers.Where(x => x.FundId == fundId))
            list.Add(new(x.Date, Loc["Sent to another account"], x.Amount, false));
        return list.OrderByDescending(m => m.Date).ToList();
    }

    // Savings buckets earmarked "held in" this fund (informational: shows how much of the fund is already spoken for).
    private IReadOnlyList<(SavingCategory Bucket, Money Total)> FundEarmarks(Guid fundId) =>
