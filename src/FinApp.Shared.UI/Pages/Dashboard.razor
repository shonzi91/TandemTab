    private async Task Run(Func<Task> action)
    {
        if (_busy) return;                 // ignore re-entrant clicks while a save is already in flight
        _error = null;
        _busy = true;
        StateHasChanged();                 // paint the "Saving…" state before the (networked) round-trip
        await Task.Yield();
        try { await action(); }
        catch (Exception ex) { _error = Describe(ex); }
        // ⚠️ Repaint explicitly rather than relying on Blazor's post-handler render. That render only happens for a
        // handler the framework AWAITS — a caller that fires this and drops the task (an Action-typed callback, e.g.
        // a Notification's, which can't await) leaves the last paint as the one where _busy was still true, and the
        // "Saving…" overlay sits there over a save that already finished. An extra render on the awaited path costs
        // nothing; a missing one on the other path locks the screen.
        finally { _busy = false; StateHasChanged(); }
    }

    /// <summary>Like <see cref="Run"/>, but routes failures to the open modal (<c>_modalError</c>) so the
    /// validation message shows inside the popup and the modal stays open instead of closing.</summary>
    // --- The shared confirm (O10) -------------------------------------------------------------
    private string _confirmTitle = "", _confirmVerb = "";
    private string? _confirmBody;
    private Func<Task>? _confirmAct;

    /// <summary>
    /// Ask before doing something that cannot be undone, then do it. The owner's standing rule is that <b>deletes
    /// always confirm and archive/edit never do</b>, and eight web controls were quietly outside it — including the
    /// two most destructive of the lot, disconnecting the bank (which also drops every staged import) and
    /// dismissing a pending bank row.
    /// </summary>
    /// <para>Cancel returns to whatever was open when it was asked — captured here rather than passed in, so no
    /// call site can forget it. A confirm that costs you your place teaches people to avoid the button rather than
    /// to read the question.</para>
    private void AskConfirm(string title, string? body, string verb, Func<Task> act)
    {
        var cameFrom = _modal;
        _confirmTitle = title;
        _confirmBody = body;
        _confirmVerb = verb;
        _confirmAct = act;
        _modalError = null;
        if (cameFrom != Modal.None) _modalBack.Push(() => _modal = cameFrom);
        _modal = Modal.Confirm;
    }

    /// <summary>Yes: run the action, then go back the way Cancel would. The action is cleared before it runs so a
    /// double-tap on a slow request cannot fire it twice (<see cref="RunModal"/>'s <c>_busy</c> guard covers the
    /// same window, and neither is worth relying on alone for something irreversible).</summary>
    private Task ConfirmAndRun() => RunModal(async () =>
    {
        if (_confirmAct is not { } act) { Back(); return; }
        _confirmAct = null;
        await act();
        Back();
    });

    // The eight web controls that were doing something irreversible on one tap. Each says what will be lost, in
    // its own words — a generic "Are you sure?" is a speed bump, not an answer, and the sentence is the whole point.
    private void ConfirmRemoveTag(Guid tagId) => AskConfirm(
        Loc["Remove this label?"],
        string.Format(Loc["“{0}” comes off every expense that carries it. The expenses themselves are untouched."], State.AllTags.FirstOrDefault(t => t.Id == tagId)?.Name ?? ""),
        Loc["Remove"], () => State.RemoveTag(tagId));

    private void ConfirmRemoveRecurring(Guid id) => AskConfirm(
        Loc["Remove this recurring item?"],
        Loc["It stops reminding you. Anything already logged from it stays where it is."],
        Loc["Remove"], () => State.RemoveRecurring(id));

    private void ConfirmDeleteCost(Guid bucketId, int index) => AskConfirm(
        Loc["Remove this cost?"],
        Loc["It comes off the fund's plan straight away."],
        Loc["Remove"], () => DeleteCost(bucketId, index));

    private void ConfirmUnsettle() => AskConfirm(
        Loc["Unsettle this expense?"],
        Loc["The expense on the other account is removed and this one goes back to its full amount."],
        Loc["Unsettle"], UnsettleFromModal);

    // ★ The two the plan called the most destructive unguarded actions in the app, and they were unguarded on both
    // platforms. Disconnecting takes the staged imports with it; a dismissed transaction does not come back.
    private void ConfirmDisconnectBank() => AskConfirm(
        Loc["Disconnect your bank?"],
        Loc["New transactions stop arriving, and anything still waiting to be reviewed is discarded. Your logged expenses are untouched. You can reconnect later — you'll be asked to consent again."],
        Loc["Disconnect"], DisconnectBankAsync);

