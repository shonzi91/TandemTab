            <div class="bank-tx-top">
                <span class="bank-tx-desc" title="@t.Description"><span class="vendor-badge" style="background:@VendorColor(t.Description)">@VendorInitial(t.Description)</span>@t.Description</span>
                <span class="amt @(isDebit ? "" : "credit")">@(isDebit ? "−" : "+")@Fmt(new Money(Math.Abs(t.Amount), State.Currency))</span>
