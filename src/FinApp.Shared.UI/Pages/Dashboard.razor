    // These three are the "actually, let me change that" escapes — reset every time the modal opens, because a
    // form that stayed expanded from last time would defeat the point on the next expense.
    private bool _expShowCategory, _expShowDate, _expShowNote;
    // The inline "new tag" box, behind its ＋ until asked for. Closed again once a tag is created.
    private bool _tagNewOpen;

