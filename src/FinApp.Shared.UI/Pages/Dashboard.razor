    // Money in/out of a fund this period — the human-readable ledger behind its balance (used by Modal.FundMovements).
    private record FundMove(DateOnly Date, string Label, Money Amount, bool In);
    private IReadOnlyList<FundMove> FundMovements(Guid fundId)
    {
        var p = State.Period;
        var list = new List<FundMove>();
        foreach (var b in p.InitialBalances.Where(b => b.FundId == fundId && b.Amount.Amount != 0m))
            list.Add(new(p.From, Loc["Opening balance"], b.Amount, b.Amount.Amount >= 0m));
        foreach (var c in p.Contributions.Where(c => c.MemberId != FinApp.Domain.Periods.Period.CarryoverSource && c.FundId == fundId))
            list.Add(new(c.Date, State.CategoryName(c.CategoryId) is { Length: > 0 } cn ? $"{Loc["Money in"]} · {cn}" : Loc["Money in"], c.Paid, true));
        foreach (var t in p.FundTransfers.Where(t => t.ToFundId == fundId))
            list.Add(new(t.Date, string.Format(Loc["Transfer from {0}"], State.FundName(t.FromFundId)), t.Amount, true));
        foreach (var t in p.FundTransfers.Where(t => t.FromFundId == fundId))
            list.Add(new(t.Date, string.Format(Loc["Transfer to {0}"], State.FundName(t.ToFundId)), t.Amount, false));
        foreach (var e in p.Expenses.Where(e => e.FundId == fundId))
            list.Add(new(e.Date, string.IsNullOrEmpty(e.Note) ? State.CategoryName(e.CategoryId) : $"{State.CategoryName(e.CategoryId)} · {e.Note}", e.Amount, false));
        foreach (var x in p.ExternalTransfers.Where(x => x.FundId == fundId))
            list.Add(new(x.Date, Loc["Sent to another account"], x.Amount, false));
        return list.OrderByDescending(m => m.Date).ToList();
    }

