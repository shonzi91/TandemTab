                        <button class="chip on" @onclick="() => ReplaceDupRow(t, dup)" disabled="@_bankBusy">@Loc["Same — replace"]</button>
                        <button class="chip" @onclick="() => { _dupDismissed.Add(id); }">@Loc["Keep both"]</button>
                    </span>
                </div>
            }
            <div class="bank-tx-row">
                <span class="bank-tx-date">@t.Date.ToString("dd MMM")</span>
