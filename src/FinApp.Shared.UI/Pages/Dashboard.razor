    // --- Settle expense onto another account (feature 1) -----------------
    private async Task OpenSettleExpense(Guid expenseId)
    {
        if (State.FindExpense(expenseId) is not { } e) return;
        _settleExpenseId = expenseId;
        _settleNote = null;
        if (e.IsSettlementSource)
        {
            _settleIsEdit = true;
            _settleAmount = e.SettledAmount;
            _settleDestId = e.SettledToAccountId!.Value;
        }
        else
        {
            _settleIsEdit = false;
            _settleAmount = e.OriginalAmount.Amount;
            _settleDestId = State.TransferableAccounts.FirstOrDefault()?.Id ?? Guid.Empty;
        }
        _modal = Modal.SettleExpense;
        await OnSettleDestChanged();
    }

    private async Task OnSettleDestChanged()
    {
        await EnsureDestStructure(_settleDestId);
        _settleDestFundId = DestFundsFor(_settleDestId).FirstOrDefault()?.Id ?? Guid.Empty;
        _settleDestCatId = DestCatsFor(_settleDestId).FirstOrDefault()?.Id ?? Guid.Empty;
    }

    private IReadOnlyList<FinApp.Domain.Budgeting.Category> DestCatsFor(Guid accountId) =>
        _destCats.TryGetValue(accountId, out var cats) ? cats : [];

    private async Task EnsureDestStructure(Guid accountId)
    {
        if (accountId == Guid.Empty || (_destFunds.ContainsKey(accountId) && _destCats.ContainsKey(accountId))) return;
        try
        {
            var (funds, cats) = await State.LoadAccountStructureAsync(accountId);
            _destFunds[accountId] = funds;
            _destCats[accountId] = cats;
        }
        catch { _destFunds[accountId] = []; _destCats[accountId] = []; }
        StateHasChanged();
    }

    private Task ConfirmSettleExpense() => RunModal(async () =>
    {
        if (_settleAmount <= 0 || _settleDestId == Guid.Empty) return;
        await State.SettleExpenseToAccount(_settleExpenseId, _settleDestId, _settleDestFundId, _settleDestCatId, _settleAmount, _settleNote);
        CloseModal();
    });

    private Task UnsettleFromModal() => RunModal(async () =>
    {
        await State.UnsettleExpense(_settleExpenseId);
        CloseModal();
    });

    // Tag-only editing of an expense in a CLOSED period. Its own id and its own selection field rather than
