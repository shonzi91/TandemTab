    // --- Statement file import (CSV/OFX/QIF) — parsed client-side, reviewed, then posted as real expenses/income. ---
    private enum ImportStep { Upload, MapCsv, Review }
    private ImportStep _importStep;
    private string? _importError;
    private IReadOnlyList<string> _csvHeaders = [];
    private IReadOnlyList<IReadOnlyList<string>> _csvRows = [];
    private int _csvDate, _csvDesc, _csvAmount, _csvDebit = -1, _csvCredit = -1;
    // Some banks (e.g. DAIS/DSK) put money-out and money-in in separate columns. Auto-detected — no manual toggle.
    private bool CsvHasSplit => _csvDebit >= 0 && _csvCredit >= 0;
    private Guid _importFund;
    private int _importSkipped;   // transactions dated outside the current period, left out of the review
    private readonly List<ImportRow> _importRows = new();

    private sealed class ImportRow
    {
        public ImportedTransaction Tx { get; init; }
        public bool Include { get; set; }
        public Guid CategoryId { get; set; }
        public bool Duplicate { get; init; }
        public bool OutOfPeriod { get; init; }
    }

    /// <summary>Small chooser: log a single expense by hand, or import many from a statement (income + spend).</summary>
    private void OpenAddOrImport() => _modal = Modal.AddOrImport;

    private async Task OpenImport()
    {
        if (!Gate.Require(PlanFeatures.Import)) return;   // Pro: statement import (P4)
        _importStep = ImportStep.Upload;
        _importError = null;
        _importSkipped = 0;
        _importRows.Clear();
        _csvHeaders = []; _csvRows = [];
        _importFund = State.SelectableFunds.FirstOrDefault()?.Id ?? State.RootFunds.FirstOrDefault()?.Id ?? Guid.Empty;
        _modal = Modal.Import;
        // Load saved merchant→category rules so imports can auto-map (and the 📌 pin reflects existing rules).
        try { _bankMappings = (await State.GetBankMappings()).ToDictionary(m => m.MatchKey, m => (m.Kind, m.TargetId, m.TagId)); }
        catch { /* mappings are a nicety for import auto-map; ignore if unavailable */ }
    }

    private async Task OnImportFileSelected(InputFileChangeEventArgs e)
    {
        _importError = null;
        try
        {
            var name = e.File.Name.ToLowerInvariant();
            if (name.EndsWith(".xlsx") || name.EndsWith(".xlsm"))
            {
                // Excel is binary — copy to a seekable stream so the zip can be read, then use the same CSV mapper.
                using var ms = new MemoryStream();
                await e.File.OpenReadStream(8 * 1024 * 1024).CopyToAsync(ms);
                ms.Position = 0;
                (_csvHeaders, _csvRows) = XlsxReader.Read(ms);
                if (_csvHeaders.Count == 0) { _importError = Loc["That file looks empty."]; return; }
                GuessCsvColumns();
                _importStep = ImportStep.MapCsv;
                return;
            }
            using var reader = new StreamReader(e.File.OpenReadStream(8 * 1024 * 1024));
            var text = await reader.ReadToEndAsync();
            switch (BankFileParser.Detect(e.File.Name, text))
            {
                case BankFileParser.Format.Ofx: BuildReview(BankFileParser.ParseOfx(text)); break;
                case BankFileParser.Format.Qif: BuildReview(BankFileParser.ParseQif(text)); break;
                case BankFileParser.Format.Xml: BuildReview(BankFileParser.ParseXml(text)); break;
                case BankFileParser.Format.Csv:
                    (_csvHeaders, _csvRows) = BankFileParser.ReadCsv(text);
                    if (_csvHeaders.Count == 0) { _importError = Loc["That file looks empty."]; break; }
                    GuessCsvColumns();
                    _importStep = ImportStep.MapCsv;
                    break;
                case BankFileParser.Format.Html:
                    // Some banks export a .xls / .htm that's really an HTML <table>.
                    (_csvHeaders, _csvRows) = BankFileParser.ReadHtmlTable(text);
                    if (_csvHeaders.Count == 0) { _importError = Loc["Couldn't find a table in that file."]; break; }
                    GuessCsvColumns();
                    _importStep = ImportStep.MapCsv;
                    break;
                default: _importError = Loc["Couldn't recognise that file. Use a CSV, Excel, XML, OFX or QIF export."]; break;
            }
        }
        catch { _importError = Loc["Couldn't read that file."]; }
    }

    // Best-guess which CSV columns hold the date/description/amount from their header names. Keys are tried in order,
    // so a more specific header (e.g. "Completed Date") wins over a generic one ("Started Date"). Covers common
    // English and Bulgarian statement headers; the user can still adjust any of them in the mapper.
    private void GuessCsvColumns()
    {
        int Find(params string[] keys)
        {
            foreach (var k in keys)
                for (var i = 0; i < _csvHeaders.Count; i++)
                    if (_csvHeaders[i].ToLowerInvariant().Contains(k)) return i;
            return -1;
        }
        _csvDate = Math.Max(0, Find("completed date", "value date", "book", "posted", "дата на осчетоводяване", "дата", "value", "date"));
        _csvDesc = Math.Max(0, Find("основание", "description", "narrat", "reference", "payee", "detail", "memo", "получател", "контрагент", "описание", "reason", "name"));
        // Separate money-out / money-in columns (used by DAIS/DSK etc.). When present, they win over a single Amount.
        _csvDebit = Find("дебит", "debit", "paid out", "withdraw", "money out");
        _csvCredit = Find("кредит", "credit", "paid in", "money in");
        // Single signed-amount column — avoid an empty "amount in transfer currency" column when a debit/credit split exists.
        _csvAmount = CsvHasSplit ? -1 : Math.Max(0, Find("amount eur", "amount", "value", "сума"));
    }

    private void ApplyCsvMapping() => BuildReview(CsvHasSplit
        ? BankFileParser.ParseCsv(_csvRows, _csvDate, _csvDesc, -1, _csvDebit, _csvCredit)
        : BankFileParser.ParseCsv(_csvRows, _csvDate, _csvDesc, Math.Max(0, _csvAmount), null, null));

    private void BuildReview(IReadOnlyList<ImportedTransaction> txns)
    {
        _importRows.Clear();
        var defaultExpense = State.AllCategories.FirstOrDefault()?.Id ?? Guid.Empty;
        var defaultIncome = State.ContributionCategories.FirstOrDefault()?.Id ?? Guid.Empty;
        // Load only the current period's transactions (#9). Anything dated outside it is skipped, with a count shown.
        var inPeriod = txns.Where(t => State.ImportInPeriod(t.Date)).OrderBy(t => t.Date).ToList();
        _importSkipped = txns.Count - inPeriod.Count;
        foreach (var tx in inPeriod)
        {
            var dup = State.ImportLooksDuplicate(tx.Date, tx.Amount);
            // Auto-map an expense to a saved merchant→category rule, else the category a matching merchant used before.
            var category = tx.Amount < 0m
                ? (MappingFor(tx.Description) is { Kind: "category" } m ? m.TargetId : (State.SuggestExpenseCategory(tx.Description) ?? defaultExpense))
                : defaultIncome;
            _importRows.Add(new ImportRow { Tx = tx, CategoryId = category, Duplicate = dup, Include = !dup });
        }
        if (_importRows.Count == 0)
            _importError = _importSkipped > 0
                ? string.Format(Loc["All {0} transactions are dated outside this period — nothing to import here."], _importSkipped)
                : Loc["No transactions found in that file."];
        _importStep = ImportStep.Review;
    }

    private void SetAllImport(bool include) { foreach (var r in _importRows) r.Include = include; }

    /// <summary>Pin/unpin this merchant to the row's category so future imports (and bank syncs) auto-file it there (#9).</summary>
    private async Task ToggleImportPin(ImportRow r)
    {
        if (string.IsNullOrWhiteSpace(r.Tx.Description) || r.Tx.Amount >= 0m) return;   // expense merchants only
        var key = BudgetingState.BankMatchKey(r.Tx.Description);
        try
        {
            if (_bankMappings.ContainsKey(key)) { _bankMappings.Remove(key); await State.RemoveBankMapping(r.Tx.Description); }
            else { _bankMappings[key] = ("category", r.CategoryId, null); await State.SetBankMapping(r.Tx.Description, "category", r.CategoryId); }
        }
        catch (Exception ex) { _importError = Describe(ex); }
    }

    private Task ConfirmImport() => RunModal(async () =>
    {
        var rows = _importRows
            .Where(r => r.Include && r.CategoryId != Guid.Empty)
            .Select(r => (r.Tx.Amount, r.Tx.Date, r.CategoryId, _importFund, r.Tx.Description))
            .ToList();
        if (rows.Count == 0) return;
        await State.ImportTransactions(rows);
        CloseModal();
    });

