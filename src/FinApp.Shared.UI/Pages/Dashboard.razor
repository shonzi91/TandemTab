            else
            {
                <span class="row-main">@ctx.Icon @ctx.Key</span>
            }
            @if (_ruleEditKey == ctx.Key)
            {
                <span class="row-actions rule-edit">
                    @if (ctx.Kind == "category")
                    {
                        <select class="bank-sel" value="@_ruleEditTarget" @onchange="e => _ruleEditTarget = Guid.TryParse(e.Value?.ToString(), out var g) ? g : Guid.Empty">
                            @foreach (var (cat, depth) in State.CategoryOptions)
                            {
                                <option value="@cat.Id">@CatOption(cat.Id, cat.Name, depth)</option>
                            }
                        </select>
                    }
                    else
                    {
                        <select class="bank-sel" value="@_ruleEditTarget" @onchange="e => _ruleEditTarget = Guid.TryParse(e.Value?.ToString(), out var g) ? g : Guid.Empty">
                            @foreach (var f in State.RootFunds.Where(f => f.Id != State.SyncedFundId))
                            {
                                <option value="@f.Id">@f.Name</option>
                            }
                        </select>
                    }
                    <button class="exp-edit" title="@Loc["Save"]" @onclick="SaveRuleEdit" disabled="@_bankBusy">✓</button>
                    <button class="exp-edit" title="@Loc["Cancel"]" @onclick="CancelRuleEdit" disabled="@_bankBusy">✕</button>
                </span>
            }
            else
            {
                <span class="row-actions">
                    <button class="exp-edit" title="@Loc["Edit rule: where it files and which words match"]" @onclick="() => BeginRuleEdit(ctx.Key)" disabled="@_bankBusy">✏️</button>
                    <button class="exp-edit" title="@Loc["Remove"]" @onclick="() => RemoveBankRuleKey(ctx.Key)" disabled="@_bankBusy">🗑️</button>
