    private decimal _payoffExtra;               // payoff modal: extra /mo ON TOP of the installment (defaults to pace)
    private decimal _invExtra;                  // investment growth modal: extra /mo invested (defaults to pace)
    private decimal _planExtra;                 // multi-debt planner: shared extra /period
    private FinApp.Forecasting.LoanForecast.Strategy _planStrategy = FinApp.Forecasting.LoanForecast.Strategy.Avalanche;

    // The multi-debt plan (reads the debt buckets), and its "installments only" baseline for the savings figure.
    private FinApp.Forecasting.LoanForecast.StrategyPlan? DebtPlan =>
        FinApp.Forecasting.LoanForecast.PlanPayoff(State.DebtLoanInputs, _planExtra, _planStrategy);
    private FinApp.Forecasting.LoanForecast.StrategyPlan? DebtBaseline =>
        FinApp.Forecasting.LoanForecast.PlanPayoff(State.DebtLoanInputs, 0m, _planStrategy);

    /// <summary>Months until every debt bucket is cleared, projecting each at its installment + the pace/plan the user
    /// actually sets aside (<see cref="BudgetingState.EffectiveSavingPace"/>) — mirroring the payoff modal's
    /// "installment + extra on top" line so the Home "Debt-free" date agrees with the per-debt modal. Null when there
    /// are no debts, or a debt never clears at that amount (no honest date to promise).</summary>
    private int? DebtFreeMonthsAtPace()
    {
        var debts = State.SavingBuckets
            .Where(x => x.Bucket.IsDebt && !x.Bucket.IsArchived && x.Bucket.DebtBalance > 0m)
            .Select(x => x.Bucket).ToList();
        if (debts.Count == 0) return null;
        var months = 0;
        foreach (var d in debts)
        {
            var pace = State.EffectiveSavingPace(d.Id)?.Amount ?? 0m;
            if (FinApp.Forecasting.LoanForecast.PayOff(d.DebtBalance, d.DebtAnnualRatePercent, d.DebtInstallment + pace) is not { } p)
                return null;   // one debt never clears at this amount → no debt-free date to show
            months = Math.Max(months, p.Months);
        }
        return months;
    }

    /// <summary>Total interest the current pace saves across every debt bucket — each debt's installment-only interest
    /// less its interest at installment + the pace you actually set aside (<see cref="LoanForecast.SimulateExtra"/>).
    /// Zero when no extra is being paid, so the "on track for Debt-free" line only claims a saving when there is one.</summary>
    private decimal DebtInterestSavedAtPace()
    {
        var debts = State.SavingBuckets
            .Where(x => x.Bucket.IsDebt && !x.Bucket.IsArchived && x.Bucket.DebtBalance > 0m)
            .Select(x => x.Bucket).ToList();
        var saved = 0m;
        foreach (var d in debts)
        {
            var pace = State.EffectiveSavingPace(d.Id)?.Amount ?? 0m;
            if (pace <= 0m) continue;
            if (FinApp.Forecasting.LoanForecast.SimulateExtra(d.DebtBalance, d.DebtAnnualRatePercent, d.DebtInstallment, pace) is { } sim)
                saved += sim.InterestSaved;
        }
        return decimal.Round(saved, 2);
    }

