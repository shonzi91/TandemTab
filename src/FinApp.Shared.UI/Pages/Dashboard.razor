    private void OpenEditCost(Guid bucketId, int index)
    {
        _costBucketId = bucketId;
        var costs = State.SavingBucketCosts(bucketId);
        _editCost = index >= 0 && index < costs.Count ? CostRow.From(costs[index]) : new CostRow();
        _editCostIndex = index; _goalMoreId = Guid.Empty; _modal = Modal.EditCost;
    }

    private Task SaveCost() => RunModal(async () =>
    {
        var nc = _editCost.ToCost();
        if (string.IsNullOrWhiteSpace(nc.Label) || nc.Amount <= 0m) return;
        var costs = State.SavingBucketCosts(_costBucketId).ToList();
        if (_editCostIndex >= 0 && _editCostIndex < costs.Count) costs[_editCostIndex] = nc; else costs.Add(nc);
        await State.SaveSavingBucketCosts(_costBucketId, costs);
        CloseModal();
    });

    private async Task DeleteCost(Guid bucketId, int index)
    {
        var costs = State.SavingBucketCosts(bucketId).ToList();
        if (index >= 0 && index < costs.Count) costs.RemoveAt(index);
        await State.SaveSavingBucketCosts(bucketId, costs);
        if (_modal == Modal.EditCost) CloseModal();
    }

