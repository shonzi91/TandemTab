    private Task SaveEditExpense() => RunModal(async () =>
    {
        if (_amount <= 0) return;
        var expenseId = _editExpenseId;
        // ★ The trip goes FIRST, on the id we still hold. EditExpense is append-only — it mints a new id and carries
        // the stored trip across — so setting the trip afterwards would be aimed at an expense that no longer exists.
        // Doing it first means the edit copies the link the user just chose, and one refetch settles both.
        var storedExpense = State.FindExpense(expenseId);
        if ((storedExpense?.TripId ?? Guid.Empty) != _expTripId
            || (storedExpense?.TripAccountId ?? Guid.Empty) != _expTripAccountId)
            await State.SetExpenseTrip(expenseId, _expTripId == Guid.Empty ? null : _expTripId,
                _expTripAccountId == Guid.Empty ? null : _expTripAccountId);
        // A blanked box means "clear it" only if there was something to clear; otherwise it is simply saying nothing.
        await State.EditExpense(expenseId, _categoryId, _amount, _fundId, _note, _expenseDate, tagId: _fTagId,
            time: _expenseTime, clearTime: _expenseTime is null && _expenseHadTime,
            clearTag: _fTagId is null && _expenseHadTag);   // same rule as the time, deliberately — see EditExpenseRequest
        CloseModal();
    });

