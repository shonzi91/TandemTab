    private static readonly Guid OtherKey = new("00000000-0000-0000-0000-0000000000fe");
    private const int MaxSlices = 8;
    private const string OtherColor = "#9aa5b1";
    // Money sent to another account is outflow too, so it gets its own slice at the top category level (its own
    // sentinel + a distinct slate colour). Skipped in tag/drill views — transfers carry no category or tag.
    private static readonly Guid TransfersKey = new("00000000-0000-0000-0000-0000000000fd");
    private const string TransfersColor = "#7c8a99";
    // ★★ THE RING IS SPENDING. Neither savings nor goal payouts are slices, and both exclusions are deliberate.
    //
    // Savings, because they never left the account — money set aside is still yours, sitting there. (This is where
    // O6b's "where the money that came in went" wedge used to be. It made the donut's total disagree with the
    // "Spent" figure beside it by exactly that wedge, with nothing on screen reconciling them.)
    //
    // Payouts, because a pie is a COMPOSITION chart: it answers "of this whole, what share is each part", which
    // only works when the parts are the same kind of thing at comparable scale. Deploying a year of savings at a
    // loan is neither — a €12,000 one-off against €30 of groceries. Drawn as a wedge it took 93% of the ring and
    // squeezed every category the reader can actually act on into the remainder, and it made the total swing
    // €900 / €900 / €12,900 so no two months could be compared at a glance. The month a payout lands is exactly
    // the month the Breakdown must still work as a breakdown.
    //
    // ⚠️ Neither is hidden. Both are stated as figures in the summary line — signed "Set aside", and "Paid to
    // goals" naming its buckets — where a number can be negative, lumpy or huge without distorting anything. The
    // payout also has a ledger row of its own, and TRENDS is where its effect on the balance belongs: a time axis
