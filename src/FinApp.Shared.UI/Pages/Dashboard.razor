        _amount = 0; _note = null;
        _expenseDate = _dayView ?? DateOnly.FromDateTime(DateTime.Today);
    });

    private void OpenDeposit()
    {
        _depCategoryId = State.ContributionCategories.FirstOrDefault()?.Id ?? Guid.Empty;
        _depFundId = State.SelectableFunds.FirstOrDefault()?.Id ?? Guid.Empty;
