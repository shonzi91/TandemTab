@page "/thin-recurring"
@using FinApp.Contracts
@using FinApp.Shared.UI.Services
@using FinApp.Shared.UI.Components.Thin
@inject FinAppApiClient Api
@inject AuthState Auth

<div class="tr">
    <p class="tr-tag">Path-B preview · thin Recurring (due state computed server-side)</p>

    @if (!Auth.IsAuthenticated) { <p>Please sign in on the main app first.</p> }
    else if (_error is { } err) { <p class="tr-err">@err</p> }
    else if (_accountId is { } id) { <ThinRecurringSection AccountId="id" /> }
    else { <p>Loading…</p> }
</div>

@code {
    private Guid? _accountId;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsAuthenticated) return;
        try
        {
            var accounts = await Api.GetAccountsAsync();
            if (accounts.Count == 0) { _error = "No accounts on this user."; return; }
            _accountId = accounts[0].Id;
        }
        catch (Exception ex) { _error = ex.Message; }
    }
}

<style>
    .tr { max-width: 720px; margin: 1rem auto; padding: 0 1rem; }
    .tr-tag { font-size: .75rem; opacity: .7; margin: 0 0 1rem; }
    .tr-err { color: #ff7a59; }
</style>
