@page "/thin-spending"
@using FinApp.Contracts
@using FinApp.Shared.UI.Services
@using FinApp.Shared.UI.Components.Thin
@inject FinAppApiClient Api
@inject AuthState Auth

<div class="thin-spending">
    <p class="ts-tag">Path-B preview · thin client (no on-device domain)</p>

    @if (!Auth.IsAuthenticated)
    {
        <p>Please sign in on the main app first, then return to this page.</p>
    }
    else if (_error is { } err)
    {
        <p class="ts-err">@err</p>
    }
    else if (_accountId is { } id)
    {
        <ThinSpendingSection AccountId="id" />
    }
    else
    {
        <p>Loading…</p>
    }
</div>

@code {
    private Guid? _accountId;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsAuthenticated) return;
        try
        {
            var accounts = await Api.GetAccountsAsync();
            if (accounts.Count == 0) { _error = "No accounts on this user."; return; }
            _accountId = accounts[0].Id;
        }
        catch (Exception ex) { _error = ex.Message; }
    }
}

<style>
    .thin-spending { max-width: 720px; margin: 1rem auto; padding: 0 1rem; font-family: inherit; }
    .ts-tag { font-size: .75rem; opacity: .7; letter-spacing: .02em; margin: 0 0 1rem; }
    .ts-err { color: #ff7a59; }
</style>
