{
  // This file exists to BE FETCHABLE, not to configure anything — the value below is the same fallback
  // Program.cs already applies when ApiBaseUrl is blank (one-origin hosting: the API is this app's own origin).
  //
  // The host stamps the client's environment, so the deployed app asks for appsettings.Production.json at
  // boot. Without this file that request is a 404 online — harmless — and offline it is a FAILED FETCH, which
  // the config loader does not survive: the app stops at "Loading…" with the error bar. Measured, not assumed.
  // Delete it and the PWA stops opening offline. See service-worker.published.js.
  "ApiBaseUrl": ""
}
