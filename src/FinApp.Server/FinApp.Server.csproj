<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>963d1897-4759-4eda-b7af-6a251bde9544</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FinApp.Domain\FinApp.Domain.csproj" />
    <ProjectReference Include="..\FinApp.Persistence\FinApp.Persistence.csproj" />
    <ProjectReference Include="..\FinApp.Contracts\FinApp.Contracts.csproj" />
    <!-- One-origin hosting: bundle the Blazor WASM client into the server's wwwroot. -->
    <ProjectReference Include="..\FinApp.App.Web\FinApp.App.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <!-- Envelope-encrypt the account snapshot at rest: a per-write data key wrapped by a Cloud KMS key. -->
    <PackageReference Include="Google.Cloud.Kms.V1" Version="3.26.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.18" />
    <!-- QR image for 2FA enrollment (PngByteQRCode is System.Drawing-free, so it works on Linux/Cloud Run). -->
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="9.0.18" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.4" />
  </ItemGroup>

</Project>
