{
  "Urls": "http://localhost:5179",
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5080" ]
  },
  "Admin": {
    // Local only, and fake by construction. `admin@test.local` is the convention to register with when you need
    // to see the admin panels; the real allowlist is a Cloud Run env var and never lives in this (public) repo.
    "Emails": "strangerwalk@example.com,admin@test.local"
  },
  "Beta": {
    // Test-account exclusion, exercised locally: anything at test.local is stamped the "test" cohort, so it
    // neither consumes a capped beta seat nor gets grandfathered to Pro — which makes it the way to see Free.
    "TestEmailPatterns": "@test.local,+test@"
  },
  "Monetization": {
    "Enabled": true
  },
  "BankSync": {
    // Local only, and fake by construction — EnableBankingClient.IsEnabled checks only that these two are
    // non-empty, and nothing here can reach a real bank: any outbound call fails on the bogus key. What it DOES
    // unlock is the review list, which is served entirely from local SQLite, so the whole
    // sync → review → confirm flow can be driven on this machine. Without it /bank/status reports
    // enabled:false and the review UI never appears, which is why that flow once shipped unverified.
    // ⚠️ This repo is PUBLIC. Never put a real ApplicationId or PEM here — production reads Cloud Run env vars.
    "EnableBanking": {
      "ApplicationId": "local-dev-not-a-real-application-id",
      "PrivateKey": "local-dev-not-a-real-private-key"
    }
  }
}
