{
  "Urls": "http://localhost:5179",
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5080" ]
  },
  "Admin": {
    // Local only, and fake by construction. `admin@test.local` is the convention to register with when you need
    // to see the admin panels; the real allowlist is a Cloud Run env var and never lives in this (public) repo.
    "Emails": "strangerwalk@example.com,admin@test.local"
  },
  "Beta": {
    // Test-account exclusion, exercised locally: anything at test.local is stamped the "test" cohort, so it
    // neither consumes a capped beta seat nor gets grandfathered to Pro — which makes it the way to see Free.
    "TestEmailPatterns": "@test.local,+test@"
  },
  "Monetization": {
    "Enabled": true
  }
}
